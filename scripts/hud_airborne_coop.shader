// HZM coop - Airborne-style HUD shaders (compass + health only). Textures from the Airborne HUD mod
// (re-created MoH:Airborne HUD). Used by ui/hud_compass.urc (top) and ui/hud_health.urc (bottom).
hud_compass_in  { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_compass_in.tga  blendFunc blend alphaGen oneMinusVertex } }
hud_compass_out { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_compass_out.tga blendFunc blend alphaGen oneMinusVertex } }
hud_compass_arrow { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_compass_arrow.tga blendFunc blend alphaGen oneMinusVertex } }
hud_compass_hit { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_compass_hit.tga blendFunc blend alphaGen oneMinusVertex } }
hud_health_frame { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_health_frame.tga blendFunc blend alphaGen oneMinusVertex } }
hud_health_icon  { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_health_icon.tga  blendFunc blend alphaGen oneMinusVertex } }
hud_health_in    { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_health_in.tga    blendFunc blend alphaGen oneMinusVertex } }
hud_health_out   { surfaceparm nolightmap nomipmaps nopicmip { clampmap textures/hud/hud_health_out.tga   blendFunc blend alphaGen oneMinusVertex } }
