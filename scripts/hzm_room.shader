// HZM remastered main-menu room (3D rebuild).  GENERATED by docs/proposals/menu_redesign_2026-09-28/remaster_test/
// scripts/cut_assets.py - do not hand-edit.  Every shader mirrors the retail mohmenu.shader idiom (nomipmaps,
// nopicmip, clampMap, blend).  Drawn only when ui_menuRoom is non-zero (see ui/main.urc).

hzm_room_a
{
   nomipmaps
   nopicmip
   cull none
   force32bit
   surfaceparm nolightmap
   {
      clampMap textures/mohmenu/hzm_room/room_a.jpg
      rgbgen global
      blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
   }
}

