// HZM hi-DPI font shaders: @3x glyph sheets need the same explicit
// shader bodies the vanilla fonts get in scripts/gfx.shader, otherwise
// the renderer builds a default opaque shader -> solid black text.
gfx/fonts/verdana-12@3x
{
	nopicmip
	nomipmaps
	{
		map gfx/fonts/verdana-12@3x.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen identity
	}
}

gfx/fonts/verdana-14@3x
{
	nopicmip
	nomipmaps
	{
		map gfx/fonts/verdana-14@3x.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen identity
		nodepthtest
	}
}

