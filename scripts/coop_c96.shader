// [user 2026-08-17] East's Mauser C96, imported as an ADDITION.
// Shader names are all prefixed c96_ and the textures moved to textures/coop_c96/.
// His originals were blade / hammer2 / barrel96 etc. in textures/models/East/ - generic
// enough to be claimed by another pak, and a contested shader name loses silently and
// renders the gun untextured. Model/skin/anims by East (moh-db.com/mods/13664).

c96_grip
{
	qer_editorimage textures/coop_c96/grip.tga
	{
		map textures/coop_c96/grip.tga
		rgbGen lightingSpherical
	}
}

