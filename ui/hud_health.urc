// HZM coop - Airborne-style HEALTH BAR (bottom-left). Replaces the stock health HUD. Frame + icon + a
// horizontal health bar driven by playerstat 0 (health) / maxplayerstat 1 (max health, so it scales to
// coop_health). Textures/shaders from the Airborne HUD mod (scripts/hud_airborne_coop.shader). Ammo stays
// stock at bottom-right, so no overlap.
menu "hud_health" 288 384 NONE 1
bgcolor 0 0 0 0
fgcolor 1 1 1 1
align left bottom

// [user 2026-09-09, bug-2555] The "healthframe" Label that used to live here has MOVED TO CGAME
// (CG_DrawStaminaArc, cg_drawtools.cpp). The white outline arc is now a STAMINA GAUGE: it is drawn
// twice, dim across its whole length and bright across the fraction of stamina remaining, which a
// URC Label cannot do - 'statbar horizontal' SCALES its shader rather than clipping it, so the arc
// would compress instead of drain.
// Everything below is unchanged and now draws ON TOP of the cgame-drawn frame, which is the correct
// stacking. Placement of the moved frame is coop_staminaArc{X,Y,W,H}.

resource
Label
{
name "healthicon"
rect 50 292 64 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_health_icon
}

resource
Label
{
name "healthbar"
rect 121 312 128 32
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
playerstat 0
maxplayerstat 1
statbar horizontal
statbar_tileshader textures/hud/hud_health_in
}

resource
Label
{
name "healthout"
rect 121 312 128 32
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_health_out
}

end.
