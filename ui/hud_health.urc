// HZM coop - Airborne-style HEALTH BAR (bottom-left). Replaces the stock health HUD. Frame + icon + a
// horizontal health bar driven by playerstat 0 (health) / maxplayerstat 1 (max health, so it scales to
// coop_health). Textures/shaders from the Airborne HUD mod (scripts/hud_airborne_coop.shader). Ammo stays
// stock at bottom-right, so no overlap.
menu "hud_health" 288 384 NONE 1
bgcolor 0 0 0 0
fgcolor 1 1 1 1
align left bottom

resource
Label
{
name "healthframe"
rect 32 289 256 60
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_health_frame
}

resource
Label
{
name "healthicon"
rect 50 292 64 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_health_icon
}

resource
Label
{
name "healthbar"
rect 121 312 128 32
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
playerstat 0
maxplayerstat 1
statbar horizontal
statbar_tileshader textures/hud/hud_health_in
}

resource
Label
{
name "healthout"
rect 121 312 128 32
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_health_out
}

end.
