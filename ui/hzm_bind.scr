// GENERATED by docs/tools/gen_menu_theme.py - DO NOT HAND-EDIT. The War Room CONTROLS tab's bind list
// (ui/hzm_options.inc, widget wrC_bindlist). The bind items are ui/BIND.SCR's. RETAIL KEYWORDS ONLY: the
// loader throws on any other and the game does not start. Cells: fg colour tints the strip, bg colour is the text.
header 1 "Action"
header 2 "Primary"
header 3 "Alternate"

bind_width 352
bind_height 272
bind_fillwidth 3
bind_commandwidth 142
bind_commandheight 18
bind_primarykeywidth 64
bind_primarykeyheight 18
bind_alternatekeywidth 124
bind_alternatekeyheight 18

align centerx centery

titleforegroundcolor 0.30 0.22 0.12 1
titlebackgroundcolor 0.93 0.88 0.74 1
activebordercolor 0.98 0.78 0.28 1
activeforegroundcolor 0.98 0.78 0.28 1
activebackgroundcolor 0.16 0.09 0.03 1
inactiveforegroundcolor 0.90 0.84 0.66 1
inactivebackgroundcolor 0.16 0.09 0.03 1
highlightforegroundcolor 0.98 0.86 0.55 1
highlightbackgroundcolor 0.16 0.09 0.03 1
selectforegroundcolor 0.42 0.22 0.06 1
selectbackgroundcolor 0.98 0.93 0.80 1

changesound sound/null.wav
activesound sound/menu/scroll.wav
entersound  sound/menu/apply.wav

binditem "Coop Objectives"					"vstr coop_obj"
binditem "Coop Suicide"						"kill"
binditem "Coop Third Person"				"append name ,7tp"
binditem "Toggle Crosshair"					"toggle ui_crosshair"	//[bug-3299] same cvar as Options - Advanced - Crosshair - saved per player, unbound by default
binditem "Coop Medkit"						"append name ,8mk"
binditem "Coop Cover"						"append name ,9cv"
binditem "Coop Quick Grenade"				"+coopnade"		//[user 2026-08-26] the G default lives in autoexec.cfg; without this line players could not REBIND it, and the only grenade row in this menu was the vanilla "useweaponclass grenade" (the equip-then-throw path)
binditem "Quick Draw Sidearm (hold)"		"+coopsidearm"		//[user 2026-09-04] the H default lives in autoexec.cfg; this row is the only way to rebind it
binditem "Coop: Take Cover"				"append name ,c1x"
binditem "Service Record"    				"append name ,chx"
binditem "Coop Ammo Box"					"append name ,abx"
binditem "Primary Attack"					"+attackprimary"
binditem "Aim Down Sights"					"+button13"
binditem "Secondary Attack (Bash)"			"+attacksecondary"
binditem "Move Forward"						"+forward"
binditem "Move Backward"					"+back"
binditem "Lean Left"						"+leanleft"
binditem "Stick Peek (hold)"		"+peek"
binditem "Lean Right"						"+leanright"
