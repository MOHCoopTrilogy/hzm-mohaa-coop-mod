// ============================================================================================
// MOH Trilogy Coop - PROTOTYPE C, PAGE 1 of 2: "MINIMAL" MAIN MENU.
//
// THIS IS A PROTOTYPE, NOT THE SHIPPING MAIN MENU.  It is a new file under ui/proto/; no
// shipped menu was modified.  Nothing under ui/proto/ is auto-loaded, because the startup
// sweep is FS_ListFiles("ui/", "urc", qfalse, ...) and wantSubs=qfalse drops any path whose
// depth is not 1 (client/cl_ui.cpp:5634 -> qcommon/files.cpp:2426).  So this file is inert
// until you deliberately load it, and it cannot shadow anything.
//
// HOW TO OPEN - paste these three lines into the console (~):
//     loadmenu proto/coop_proto_c_main
//     loadmenu proto/coop_proto_c_play
//     pushmenu coop_proto_c_main
// Both pages must be loaded first: the CAMPAIGN row pushes page 2 by name, and pushmenu on a
// name that was never loaded just prints a not-found line.
//
// pushmenu, NOT showmenu.  UI_ShowMenu_f (cl_ui.cpp:5528) skips the focus call that turns the
// mouse cursor on, which gives you a menu you cannot click; UI_PushMenu_f (:5523) does not.
// Because it is PUSHED, the real main menu is still on the stack underneath and the chrome
// BACK button (popmenu 0 - cl_ui.cpp:2901-2909, arg 0 = do not restore cvars) returns to it.
//
// THE IDEA
// --------
// The smallest menu that still reads as a menu: one wordmark, one title, one hairline, four
// words, one status line.  No panels, no plates, no boxes, no borders, no art.  Everything
// that is not those six things is whitespace.  The affordance is the type itself - a row
// lights up under the cursor and the status line explains it - so there is nothing to draw
// and therefore nothing that can fail to resolve.
//
// The hover lift is `shader "menu_button_trans"` + `hovershader "menu_button_glow"`, the
// retail idiom this mod already uses (ui/coop_start.urc:396-397).  Both are $whiteimage with
// blendfunc alphaadd in Pak0.pk3:scripts/mohmenu.shader - trans at alphagen constant 0.0
// (an invisible base) and glow at 0.2 (a flat additive wash).  A 1x1 white source has no
// aspect ratio, so the fact that `shader` art is always STRETCHED to the widget rect
// (uiwidget.cpp:2104-2107) cannot distort it at any row size.  The wash is tinted by fgcolor,
// because the hover material is drawn with the colour left set by the base-material block
// (uiwidget.cpp:2098-2117) - which is why every row here carries fgcolor alpha 1.00.
//
// WHY THIS IS "EASIER TO BUILD ONTO"
// ----------------------------------
// Two includes carry the whole design.  ui/proto/coop_proto_c_play.urc is the proof: it is the
// same header, the same two includes, then four Button blocks and two Labels, and it needs no
// knowledge of the frame at all.  Adding a page is: copy the header, change the title, change
// four titles and four commands.
//
// fullscreen 1, DELIBERATELY.  A non-fullscreen container composites over the live 3D world
// (cl_ui.cpp:1993-1997 - a fullscreen menu calls view3d->setShow(false) and Com_FakePause()),
// which the mod does use for coop_settings, coop_loadout, coop_sr, coop_whatsnew and
// coop_report.  It is wrong here for two reasons.  Design: a menu made of nothing but thin
// type has no plate to seat it on, so a moving world behind it destroys the only contrast it
// has.  Safety: this is a main menu, and if it is opened mid-game the fullscreen path pauses
// the server instead of leaving the player standing in a live coop match looking at a mock-up.
//
// virtualres 1 is declared BEFORE the first resource because it is copied to each widget at
// creation time (uilayout.cpp:152-156); declared later it would apply to nothing.
// ============================================================================================

menu "coop_proto_c_main" 640 480 NONE 0
bgcolor 0 0 0 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1

// The shared frame: full-bleed ground, scrim, footer rule, credit line, prototype notice, BACK.
include "ui/proto/coop_proto_chrome.inc"
// The shared Minimal look: quiets the chrome brass title plate, adds the wordmark strip and
// the one hairline.  See that file for why it paints over the chrome and for the slot geometry.
include "ui/proto/coop_proto_c_stack.inc"


// --- page title ----------------------------------------------------------------------------
// The theme slot at y 130.  facfont-20 is ~8.5 px/char for caps, so 16 chars is about 136px in
// a 640px rect.  One of the three faces proven in this mod (facfont-20, verdana-12,
// courier-16); an unloadable font name is Com_Error(ERR_DROP) at uilib/uifont.cpp:295-299.
resource
Label
{
	name "coop_proto_c_main_title"
	title "MOH TRILOGY COOP"
	rect 0 130 640 24
	fgcolor 0.94 0.88 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	dontlocalize
}


// --- the stack -------------------------------------------------------------------------------
// Four rows, rect x 160 w 320 h 28, pitch 36.  ordernumber is arrow-key FOCUS order only, never
// z-order (m_ordernum, uiwidget.cpp:1508, read at :2717/2732/2746/2761 and never in a draw
// path); the chrome BACK takes 1, so the stack starts at 2.
//
// Each row is one command, or two joined by a semicolon - the UI stuffs the string straight
// into the console buffer (UIButtonBase::Action, uilib/uibutton.cpp:171-182), and the console
// splits on the semicolon.  Values are single tokens on purpose: a quote inside a quoted
// stuffcommand gets truncated on the wire (bug-758), so the picked-item cvar takes a one-word
// token instead of a phrase.  Nothing here starts, stops, loads or disconnects anything - the
// three non-navigating rows only move two cvars in this prototype own namespace.

// CAMPAIGN -> the second prototype page.  The only navigating row.
resource
Button
{
	name "coop_proto_c_row1"
	title "CAMPAIGN"
	rect 160 200 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint 1"
	mouseawaycommand "set coop_protoHint 0"
	stuffcommand "pushmenu coop_proto_c_play"
	ordernumber 2
}
resource
Button
{
	name "coop_proto_c_row2"
	title "SINGLE MISSION"
	rect 160 236 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint 2"
	mouseawaycommand "set coop_protoHint 0"
	stuffcommand "set coop_protoHint 12;set coop_protoPick MISSION"
	ordernumber 3
}
resource
Button
{
	name "coop_proto_c_row3"
	title "SETTINGS"
	rect 160 272 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint 3"
	mouseawaycommand "set coop_protoHint 0"
	stuffcommand "set coop_protoHint 13;set coop_protoPick SETTINGS"
	ordernumber 4
}
resource
Button
{
	name "coop_proto_c_row4"
	title "SERVICE RECORD"
	rect 160 308 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint 4"
	mouseawaycommand "set coop_protoHint 0"
	stuffcommand "set coop_protoHint 14;set coop_protoPick RECORD"
	ordernumber 5
}


// --- status line -----------------------------------------------------------------------------
// One Label that says what the cursor is on, and what the last click did.  This is `linkstring`,
// a real UILabel feature (uilib/uilabel.cpp:25-34, matched by string in FindLinkString at :146)
// that maps a cvar VALUE to a display STRING.  It is the way to get a whole sentence out of a
// button: the .urc tokenizer parses a quoted run once, so a multi-word linkstring is safe,
// whereas a multi-word value pushed through stuffcommand would be re-parsed by the console and
// truncated.
//
// `linkcvar` must be declared BEFORE `initdata` - LayoutInitData is a no-op unless m_cvarname is
// already set (uiwidget.cpp:1431-1436).  With no linkstring match the Label falls back to
// printing the raw cvar value, and an unset cvar reads empty and draws nothing
// (uilabel.cpp:245-284).  Page 2 uses its own cvar rather than sharing this one, so neither
// page can ever show the other page ids.
resource
Label
{
	name "coop_proto_c_main_hint"
	rect 60 384 520 13
	fgcolor 0.80 0.76 0.66 0.62
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	linkcvar "coop_protoHint"
	initdata "0"
	linkstring 0 "Hover a line for detail. Nothing on this page starts a real game."
	linkstring 1 "Play the trilogy end to end, up to four players."
	linkstring 2 "Drop straight into any single map from the three games."
	linkstring 3 "Difficulty, respawns, revives, HUD and audio."
	linkstring 4 "Career totals, medals and challenge progress."
	linkstring 12 "SINGLE MISSION picked - prototype only, a cvar moved and nothing launched."
	linkstring 13 "SETTINGS picked - prototype only, a cvar moved and nothing launched."
	linkstring 14 "SERVICE RECORD picked - prototype only, a cvar moved and nothing launched."
	dontlocalize
}

end.
