// ============================================================================================
// MOH Trilogy Coop - PROTOTYPE C, PAGE 2 of 2: "MINIMAL" DIFFICULTY PAGE.
//
// THIS IS A PROTOTYPE.  New file under ui/proto/; no shipped menu was modified, and nothing
// under ui/proto/ is auto-loaded (the startup sweep is non-recursive - cl_ui.cpp:5634).
//
// HOW TO OPEN - either reach it from page 1 by clicking CAMPAIGN, or push it directly:
//     loadmenu proto/coop_proto_c_play
//     pushmenu coop_proto_c_play
// pushmenu, never showmenu (showmenu skips the focus call that turns the mouse on).  BACK is
// the chrome popmenu 0, which returns to page 1 - or to the real main menu if you pushed this
// page on its own.
//
// ------------------------------------------------------------------------------------------
// THIS FILE IS THE POINT OF PROTOTYPE C.
//
// Everything visual - the ground, the scrim, the wordmark, the hairline, the footer rule, the
// credit line, the prototype notice and the BACK button - arrives in the two include lines
// below.  This page contributes six resource blocks and knows nothing about the frame:
//
//     6 container lines
//     2 include lines
//     1 title Label        (change one string)
//     4 Button blocks      (change three fields each: title, hovercommand id, stuffcommand)
//     1 status Label       (one linkstring line per row)
//
// The rects are not invented here either - they are the slots the theme fixes, listed at the
// top of ui/proto/coop_proto_c_stack.inc: title at y 130, rows at y 200/236/272/308 with
// rect x 160 w 320 h 28, status line at y 384.  A third page is this file with different
// strings.
//
// That is only possible because `include` is processed INLINE and may repeat: ProcessCommands
// pushes the current script, recurses through Load(), and pops (uilib/uilayout.cpp:117-121).
// (`postinclude` is the one that cannot repeat - it is a single str at :106, overwritten at
// :123, so a file with two of them silently keeps only the last.)
//
// fullscreen 1 for the same reasons as page 1: thin type has no plate to seat it on, so the
// live 3D world behind it would eat the contrast, and the fullscreen path pauses a running
// server (cl_ui.cpp:1993-1997) rather than leaving a player exposed behind a mock-up.
// virtualres 1 must precede the first resource - it is copied to each widget at creation
// (uilayout.cpp:152-156).
// ============================================================================================

menu "coop_proto_c_play" 640 480 NONE 0
bgcolor 0 0 0 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1

include "ui/proto/coop_proto_chrome.inc"
include "ui/proto/coop_proto_c_stack.inc"


// --- page title (theme slot: y 130) ----------------------------------------------------------
resource
Label
{
	name "coop_proto_c_play_title"
	title "CHOOSE DIFFICULTY"
	rect 0 130 640 24
	fgcolor 0.94 0.88 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	dontlocalize
}


// --- the stack (theme slots: y 200 / 236 / 272 / 308, rect x 160 w 320 h 28) -------------------
// Same four fields differ per row and nothing else: title, the two hover ids, the click command.
// Every row sets cvars only.  Nothing here launches a map, changes a real difficulty cvar,
// disconnects or quits.  ordernumber starts at 2 because the chrome BACK owns 1.
resource
Button
{
	name "coop_proto_c_play_row1"
	title "RECRUIT"
	rect 160 200 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint2 1"
	mouseawaycommand "set coop_protoHint2 0"
	stuffcommand "set coop_protoHint2 11;set coop_protoPick RECRUIT"
	ordernumber 2
}
resource
Button
{
	name "coop_proto_c_play_row2"
	title "REGULAR"
	rect 160 236 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint2 2"
	mouseawaycommand "set coop_protoHint2 0"
	stuffcommand "set coop_protoHint2 12;set coop_protoPick REGULAR"
	ordernumber 3
}
resource
Button
{
	name "coop_proto_c_play_row3"
	title "VETERAN"
	rect 160 272 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint2 3"
	mouseawaycommand "set coop_protoHint2 0"
	stuffcommand "set coop_protoHint2 13;set coop_protoPick VETERAN"
	ordernumber 4
}
resource
Button
{
	name "coop_proto_c_play_row4"
	title "AUTHENTIC"
	rect 160 308 320 28
	fgcolor 0.86 0.84 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	shader "menu_button_trans"
	hovershader "menu_button_glow"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoHint2 4"
	mouseawaycommand "set coop_protoHint2 0"
	stuffcommand "set coop_protoHint2 14;set coop_protoPick AUTHENTIC"
	ordernumber 5
}


// --- status line (theme slot: y 384) ----------------------------------------------------------
// Own cvar, not page 1 cvar, so an id left behind by the other page can never leak in here.
// linkcvar before initdata - LayoutInitData does nothing unless m_cvarname is already set
// (uiwidget.cpp:1431-1436).
resource
Label
{
	name "coop_proto_c_play_hint"
	rect 60 384 520 13
	fgcolor 0.80 0.76 0.66 0.62
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	linkcvar "coop_protoHint2"
	initdata "0"
	linkstring 0 "Hover a line for detail. BACK returns to the previous menu."
	linkstring 1 "Fewer enemies, slower fire, generous revives. For a first run."
	linkstring 2 "The intended co-op balance across all three games."
	linkstring 3 "More enemies, tighter revive window, less forgiving AI."
	linkstring 4 "One life per mission. No revives, no respawns."
	linkstring 11 "RECRUIT picked - prototype only, a cvar moved and nothing launched."
	linkstring 12 "REGULAR picked - prototype only, a cvar moved and nothing launched."
	linkstring 13 "VETERAN picked - prototype only, a cvar moved and nothing launched."
	linkstring 14 "AUTHENTIC picked - prototype only, a cvar moved and nothing launched."
	dontlocalize
}

end.
