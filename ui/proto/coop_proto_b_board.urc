Label
{
	name "bb_title"
	title "OPERATIONS BOARD"
	rect 90 16 460 24
	fgcolor 0.94 0.88 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	textalign centery
	dontlocalize
