// The preview is SQUARE because the source art is: every textures/mohmenu/dmloading
// tile is 512x512 or 1024x1024, and `shader` art is always drawn stretched to the
// widget rect (uiwidget.cpp:2104-2107) - a 150x86 rect would squash it by a third.
// Backing plate, then hint, then the art: declaration order is draw order, so the
// art covers the hint when the map has a tile, and the hint stands when it does not
// (an unresolvable name sets no material at all - uilabel.cpp:271-275).
resource
Widget
{
	name "bb_c_shotframe"
	rect 482 120 150 150
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.045 0.050 0.038 1.00
	borderstyle "NONE"
}
