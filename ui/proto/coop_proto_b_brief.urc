	name "bf_deploy"
	title "DEPLOY  -  prototype, deliberately inert"
	rect 306 396 326 26
	fgcolor 0.900 0.912 0.830 1.00
	bgcolor 0.152 0.166 0.128 1.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	textalign centery
	shader "menu_button_trans"
	hovershader "textures/mohmenu/m_buttonhighlight"
	clicksound "sound/menu/apply.wav"
	stuffcommand "set coop_protoBord 1"
	ordernumber 3
	dontlocalize
}

