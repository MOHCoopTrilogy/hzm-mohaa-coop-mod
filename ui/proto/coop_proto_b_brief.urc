}
resource
Label
{
	name "bf_l_hdr"
	title "LAST ORDER FROM THE BOARD"
	rect 8 346 288 16
	fgcolor 0.980 0.945 0.830 1.00
	bgcolor 0.430 0.352 0.155 1.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	textalign centery
	dontlocalize
}
