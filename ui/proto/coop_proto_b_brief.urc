// STATIC TEXT on purpose. A linkcvar pointed at a real game cvar is written back
// by Menu::RestoreCVars (uimenu.cpp) when ESC pops the menu (cl_ui.cpp:3127), and
// a cvar that was NOT registered at push time gets created EMPTY - the bug-1669
// failure mode, arriving through the UI instead of through a script getcvar.
resource
Label
{
	name "bf_roe"
	title "Player health        750       coop_health\nLast Man Standing    off       coop_lmsLives 0\nDown But Not Out     on        coop_dbno 1\nDev features         off       coop_dev 0\n\nPrinted, not read live: see the note above this block in\nthe file. A prototype should not be able to damage a cvar."
	rect 312 295 314 88
	fgcolor 0.800 0.820 0.720 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	textalign left
	textalign top
	dontlocalize
}
