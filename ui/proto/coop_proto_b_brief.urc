	linkstring 2 "Join a server"
	linkstring 3 "Armory / loadout"
	linkstring 4 "Service record"
	linkstring 5 "Coop settings"
	linkstring 6 "What is new"
	linkstring 7 "Controls"
	linkstring 8 "Map tester"
	linkstring 9 "Report a bug"
	linkstring 10 "Credits"
