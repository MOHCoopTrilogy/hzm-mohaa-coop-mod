// ============================================================================================
// MOH Trilogy Coop - PROTOTYPE B, page two: "MISSION BRIEFING".
//
// WHAT THIS IS.  The page coop_proto_b_board pushes to, so the prototype shows a real
// page-to-page flow instead of a single static mock.  It is a PROTOTYPE: it deploys nothing and
// writes only coop_protoB* cvars.
//
// HOW TO OPEN IT.  Normally you do not - you click OPEN MISSION BRIEFING on the board, or
// HOST A MISSION on its ORDERS rail.  Directly:
//
//     loadmenu proto/coop_proto_b_brief
//     pushmenu coop_proto_b_brief
//
// or  exec ui/proto/coop_proto_b_open.cfg , which registers both pages and opens the board.
//
// It reads coop_protoBsel / coop_protoBshot / coop_protoBord - the three cvars the board sets -
// so the map you clicked over there is the map described here.  Nothing else is shared.
//
// BACK TO THE BOARD is popmenu 0.  The argument is required (cl_ui.cpp:2814) and 0 means "do
// not restore cvars".  MenuManager::PopMenu re-shows the menu underneath, which is the board,
// because PushMenu hid it rather than closing it.
//
// fullscreen 0 for the same reason as the board: fullscreen would hide the 3D view and
// Com_FakePause a running server (cl_ui.cpp:1993-1996), and the chrome's opaque full-bleed
// ground already covers whatever is behind.
//
// Same rules as the board: flat widgets, explicit borderstyle on every one, only facfont-20 /
// verdana-12 / courier-16, only retail art, every line break literal because this UI does not
// wrap (uilib/uifont.cpp:388-428), and every rect measured against the 640x480 canvas.
// ============================================================================================
menu "coop_proto_b_brief" 640 480 NONE 0
bgcolor 0 0 0 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 0
virtualres 1
include "ui/proto/coop_proto_chrome.inc"

resource
Label
{
	name "bf_title"
	title "MISSION BRIEFING"
	rect 90 16 460 24
	fgcolor 0.94 0.88 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign centerx
	textalign centery
	dontlocalize
}
resource
Label
{
	name "bf_sub"
	title "page two of the prototype - opened from the board, BACK returns to it"
	rect 90 42 460 15
	fgcolor 0.78 0.70 0.52 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	textalign centery
	dontlocalize
}

// ==== LEFT - the map the board handed over =================================
// Photo mount, then hint, then a SQUARE preview centred on it. The dmloading tiles
// are 1:1 and `shader` art is stretched to the rect (uiwidget.cpp:2104-2107), so a
// 288x216 rect would squash the picture; 216x216 shows it as authored.
resource
Widget
{
	name "bf_shotmount"
	rect 8 78 288 216
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.075 0.082 0.065 1.00
	borderstyle "NONE"
}
resource
Widget
{
	name "bf_shotwell"
