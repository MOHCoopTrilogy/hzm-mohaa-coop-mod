Button
{
	name "bf_back"
	title "BACK TO THE BOARD"
	rect 8 396 288 26
	fgcolor 1.000 0.955 0.780 1.00
	bgcolor 0.360 0.298 0.128 1.00
	borderstyle "NONE"
	font "verdana-12"
	textalign centerx
	textalign centery
	shader "menu_button_trans"
	hovershader "textures/mohmenu/m_buttonhighlight"
	clicksound "sound/menu/back.wav"
	stuffcommand "popmenu 0"
	ordernumber 2
	dontlocalize
}

