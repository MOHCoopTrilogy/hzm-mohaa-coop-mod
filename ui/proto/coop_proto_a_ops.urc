// ============================================================================================
// MOH Trilogy Coop - PROTOTYPE A "CINEMATIC" - operations page.  PROTOTYPE. NOT A SHIPPING MENU.
//
// WHAT THIS IS
//   The second page of prototype A, and the reason the first page's primary items lead
//   somewhere real instead of nowhere.  Same language as coop_proto_a_main: the same
//   full-bleed plate on the same y band, the same letterbox mattes, the same left column -
//   only the column's contents change.  That continuity is the point of the study: a
//   cinematic menu earns its calm by never re-arranging the frame between pages.
//
//   It shares the backdrop cvar (coop_protoAArt) with the main page on purpose, so moving
//   between the two does not flash a different image.
//
// HOW TO OPEN IT
//   Normally: open coop_proto_a_main and click CONTINUE or OPERATIONS.
//   Directly, from the console (~):
//     loadmenu proto/coop_proto_a_ops
//     pushmenu coop_proto_a_ops
//   BACK (bottom left, from the shared chrome) is popmenu 0 - back to whatever is underneath.
//
// THIS PAGE IS INERT BY DESIGN
//   The four campaign rows only ever do "set coop_protoAPick <name>", and the page shows that
//   value back to you under SELECTED so a click is visibly doing something.  There is no
//   Apply, no ui_startdmmap, no map load, no gametype change and no writeconfig anywhere in
//   this file.  A prototype that can start a server is a prototype that can wreck a session.
//
// SEE coop_proto_a_main.urc for the full engine-rules header (flat widget tree, declaration
// order = draw order and reverse click priority, "stretch horizontal" as the ultrawide bleed,
// textalign taking only its first argument, enabledcvar gating draw AND hit-test, the
// no-wrapping text budget, and the confirmed font/shader/sound palette).  The same rules
// govern this file; they are not repeated here.
//
// CONTAINER: fullscreen 1, for the same reason as the main page - the shared chrome paints an
// opaque full-screen ground (coop_proto_bleed, stretch both, bgcolor alpha 1.00; painted at
// uilib/uiwidget.cpp:2056), so fullscreen 0 would render a 3D world that nothing could see.
// ============================================================================================

menu "coop_proto_a_ops" 640 480 NONE 0
bgcolor 0 0 0 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1

include "ui/proto/coop_proto_chrome.inc"


// --- the plate: same widget, same band, same cvar as the main page --------------------------
resource
Label
{
	name "coop_proto_a_ops_backplate"
	rect 0 72 640 360
	stretch horizontal
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.070 0.078 0.068 1.00
	borderstyle "NONE"
	linkcvar "coop_protoAArt"
	linkcvartoshader
}

// --- gradient off the left edge, one step wider than the main page because the rows here
// --- carry longer names and a longer caption line.
resource
Widget
{
	name "coop_proto_a_ops_grad1"
	rect 0 72 340 360
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.015 0.017 0.014 0.78
	borderstyle "NONE"
}
resource
Widget
{
	name "coop_proto_a_ops_grad2"
	rect 340 72 90 360
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.015 0.017 0.014 0.50
	borderstyle "NONE"
}
resource
Widget
{
	name "coop_proto_a_ops_grad3"
	rect 430 72 70 360
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.015 0.017 0.014 0.22
	borderstyle "NONE"
}

// --- letterbox mattes, identical to the main page so the frame does not move -----------------
resource
Widget
{
	name "coop_proto_a_ops_matte_top"
	rect 0 72 640 18
	stretch horizontal
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.010 0.010 0.010 0.62
	borderstyle "NONE"
}
resource
Widget
{
	name "coop_proto_a_ops_matte_bot"
	rect 0 414 640 18
	stretch horizontal
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.010 0.010 0.010 0.62
	borderstyle "NONE"
}


