// ============================================================================================
// THE COLUMN.  Four rows, 50 px apart, 36 px tall.  Mark then Button, same as the main page.
// "BREAKTHROUGH" is the widest title here: 12 caps at facfont-20 is about 102 px (132 px if
// every glyph were a W) inside a 300 px rect, so nothing can clip - there is no wrapping to
// fall back on.
// ============================================================================================

// --- 1. ALLIED ASSAULT ----------------------------------------------------------------------
resource
Widget
{
	name "coop_proto_a_ops_mark1"
	rect 22 122 3 36
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.86 0.70 0.36 1.00
	borderstyle "NONE"
	enabledcvar "coop_protoBH1"
}
resource
Button
{
	name "coop_proto_a_ops_item1"
	title "ALLIED ASSAULT"
	rect 36 122 300 36
	fgcolor 0.94 0.90 0.78 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
	textalign left
	textalign centery
	shader "menu_button_trans"
	hovershader "textures/mohmenu/m_buttonhighlight"
	clicksound "sound/menu/apply.wav"
	hovercommand "set coop_protoBH1 1; set coop_protoACap \"the m-series - Normandy to the Siegfried Line\""
	mouseawaycommand "set coop_protoBH1 0; set coop_protoACap \"\""
	stuffcommand "set coop_protoAPick allied-assault"
	ordernumber 2
	dontlocalize
}

