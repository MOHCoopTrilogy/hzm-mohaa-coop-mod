resource
Label
{
title "Texture Filter"
name "Default"
rect 68 336 128 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/blank2"
linkcvar "r_texturemode"
linkstring gl_linear_mipmap_nearest "Bilinear"
linkstring gl_linear_mipmap_linear "Trilinear"
// HZM coop [2026-09-27] linkstring matching is CASE-SENSITIVE (UILabel::FindLinkString -> str == -> strcmp) and
// coop_defaults.cfg seeds the upper-case name, so this readout printed the raw "GL_LINEAR_MIPMAP_LINEAR".
linkstring GL_LINEAR_MIPMAP_NEAREST "Bilinear"
linkstring GL_LINEAR_MIPMAP_LINEAR "Trilinear"

}
