resource
Button
{
name "apply"
rect 280 448 96 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "3D_BORDER"
shader "textures/mohmenu/apply"
hovershader "textures/mohmenu/apply_h"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_checkrestart; popmenu 0"
ordernumber 1

}
// HZM coop [2026-09-27 bug-3115] DEFAULT restores the SHIPPED look (generated coop_videodefaults.cfg, from
// coop_defaults.cfg), not ui_resetcvars' engine defaults, which turned the HD textures off and halved texture size.
// Resolution, display mode and field of view are never reset.
resource
Button
{
name "Default Settings"
rect 536 448 96 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/default"
hovershader "textures/mohmenu/default_h"
clicksound "sound/menu/back.wav"
stuffcommand "exec coop_mod/cfg/coop_videodefaults.cfg"
ordernumber 2

}
