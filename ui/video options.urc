// HZM coop [2026-09-27 graphics menu Phase 1, bug-3118] COLOR DEPTH and TEXTURE COLOR DEPTH are fixed at 32 bit.
// Their only other choice, 16 bit, bands the HDR picture (and forces a short farclip); 0 and 32 are the same on
// gl2. Both cvars are PINNED in docs/tools/gen_menu_graphics.py: the DEFAULT cfg and the one-time repair
// (coop_mod/cfg/coop_gfxfix1.cfg) hold them at 32. The knobs stay as art only; the readouts say it is fixed.
resource
Label
{
title "32 bit (always)"
name "Default"
rect 68 132 128 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/blank2"

}
// HZM coop - RESOLUTION picker modernized (bug-753). The vanilla list only offered the engine's
// fixed r_mode table (2..9 = 4:3 up to 1600x1200), so a widescreen player literally could not pick
// his monitor's resolution, and the shipped default r_mode -1 had no readout linkstring at all.
// The list now writes the SAME cvar set the coop_defaults.cfg DISPLAY seeds use (r_mode -1 +
// r_customwidth/r_customheight, all CVAR_ARCHIVE|CVAR_LATCH) so a pick is archived and STICKS
// across restarts, and the readout shows the live r_customwidth x r_customheight values. The two
// value labels double as Menu::CheckRestart watchers (menu snapshots the value on open; a latched
// change -> vid_restart on Apply), same trick as the display-mode watchers below.
resource
Label
{
title "plate"
name "resplate"
rect 68 64 128 16
fgcolor 0.00 0.00 0.00 0.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/blank2"

}
resource
Label
{
name "resw"
rect 68 64 56 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
textalign right
linkcvar "r_customwidth"

}
resource
Label
{
title "x"
name "resx"
rect 124 64 12 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"

}
resource
Label
{
name "resh"
rect 136 64 56 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
textalign left
linkcvar "r_customheight"

}
