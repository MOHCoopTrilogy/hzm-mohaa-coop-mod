addpopup "MENU" "1280 x 720" command "set r_mode -1; set r_customwidth 1280; set r_customheight 720"
addpopup "MENU" "1366 x 768" command "set r_mode -1; set r_customwidth 1366; set r_customheight 768"
addpopup "MENU" "1600 x 900" command "set r_mode -1; set r_customwidth 1600; set r_customheight 900"
addpopup "MENU" "1600 x 1200" command "set r_mode -1; set r_customwidth 1600; set r_customheight 1200"
addpopup "MENU" "1920 x 1080" command "set r_mode -1; set r_customwidth 1920; set r_customheight 1080"
addpopup "MENU" "1920 x 1200" command "set r_mode -1; set r_customwidth 1920; set r_customheight 1200"
addpopup "MENU" "2560 x 1080" command "set r_mode -1; set r_customwidth 2560; set r_customheight 1080"
addpopup "MENU" "2560 x 1440" command "set r_mode -1; set r_customwidth 2560; set r_customheight 1440"
addpopup "MENU" "3440 x 1440" command "set r_mode -1; set r_customwidth 3440; set r_customheight 1440"
addpopup "MENU" "3840 x 2160" command "set r_mode -1; set r_customwidth 3840; set r_customheight 2160"

