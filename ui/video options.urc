resource
Slider
{
title "Brightness Slider"
name "Default"
rect 220 264 192 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/slider"
linkcvar "r_gamma"
slidertype float
setrange 0.5 3
stepsize 0.1

}
// HZM coop - FIELD OF VIEW slider. Links the native "fov" userinfo cvar (engine clamps 80-160
// server-side and re-applies it on every userinfo change, so uniform swaps can't reset it).
// Archived - persists across restarts; applies live. Styled to mirror the BRIGHTNESS row
// (beveled plaque + slider, no numeric readout) and mounted over the dead calibration dial.
resource
Label
{
title "FIELD OF VIEW"
name "fovlabel"
rect 412 64 140 20
fgcolor 0.12 0.14 0.12 1.00
bgcolor 0.62 0.64 0.62 1.00
borderstyle "3D_BORDER"
font "facfont-20"

}
resource
Slider
{
title "Field Of View Slider"
name "fovslider"
rect 412 90 140 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/slider"
linkcvar "fov"
slidertype integer
setrange 80 160
stepsize 2
}
// HZM coop - DISPLAY MODE selector (Windowed / Borderless Window / Exclusive Fullscreen). The engraved
// "DISPLAY MODE" plaque is baked into the panel art (video_a, re-lettered from the old VIDEO OPTIONS title)
// so it matches RESOLUTION/COLOR DEPTH exactly. Only the value readout + an invisible click-region overlay
// live here. Clicking the readout opens the pulldown, which sets r_fullscreen + r_desktopfullscreen (engine
// sdl_glimp reads r_desktopfullscreen: 1 = FULLSCREEN_DESKTOP borderless, 0 = FULLSCREEN exclusive). Both are
// CVAR_LATCH so it applies on Apply (ui_checkrestart -> vid_restart); the two hidden watchers below let
// Menu::CheckRestart notice the change.
// value readout - same black plate ("blank2") as the RESOLUTION / COLOR DEPTH readouts, tucked in the gap
// between the baked plaque and the calibration dial.
resource
Label
{
title "mode"
name "dispmodeval"
rect 252 62 128 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/blank2"
linkcvar "ui_displaymode"
linkstring 0 "Windowed"
linkstring 1 "Borderless Window"
linkstring 2 "Exclusive Fullscreen"

}
// invisible click-region over the readout (menu_button_trans = transparent, same trick the main menu uses
// for its baked-art buttons) - clicking the readout opens the mode list. No stretched pulldown-arrow icon.
resource
PulldownMenuContainer
{
title "list"
name "dispmodelist"
rect 252 62 128 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
menushader "MENU" "menu_button_trans"
selmenushader "MENU" "menu_button_trans"
addpopup "MENU" "Windowed" command "seta ui_displaymode 0; set r_fullscreen 0; set r_noborder 0"
addpopup "MENU" "Borderless Window" command "seta ui_displaymode 1; set r_fullscreen 1; set r_desktopfullscreen 1"
addpopup "MENU" "Exclusive Fullscreen" command "seta ui_displaymode 2; set r_fullscreen 1; set r_desktopfullscreen 0"

}
