// HZM coop [2026-09-27 graphics menu Phase 1, bug-3118] TEXTURE COMPRESSION is always on. On gl2 it is the switch
// that loads .dds files at all (renderergl2/tr_image.c:2488): off, every HD texture pack silently stopped loading.
// PINNED in gen_menu_graphics.py (DEFAULT cfg + one-time repair). A fixed tick where the checkbox drew its glyph
// (UICheckBox: indent 8, 14x14, centred: uicheckbox.cpp:76-100) and one plain line under the plaque.
resource
Label
{
name "texcompFixed"
rect 216 353 14 14
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/menu/checkbox_checked"

}
resource
Label
{
title "Always on: the HD textures need it"
name "texcompNote"
rect 240 372 300 12
fgcolor 0.02 0.02 0.03 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
textalign left

