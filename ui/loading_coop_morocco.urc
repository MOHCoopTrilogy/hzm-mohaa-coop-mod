menu "test_morocco" 640 481 NONE 0
// HZM coop [2026-09-26] NOT dead code - keep it. test_morocco is 1337Smithy's community map (2019): see the
// header of ubersound/coop_morocco_ubersound.scr and global/ai.scr (dropgun support). The map does not ship
// with the mod, so this screen only appears for players who install it; the test_morocco shader comes
// from that map's own pk3. Renaming the menu would detach it from the map. (research.md section 9.2)
bgcolor 0 0 0 1 
borderstyle NONE
bgfill 0 0 0 1 
fullscreen 1
//vidmode 3
//fadein 0.5
virtualres 1
postinclude ui/loadingbar.txt

