// HZM coop - REPORT A BUG menu. The player types a one-line description into a Field (linkcvar
// coop_reportText, same editable-Field mechanism the Join-Internet-Game menu uses for the IP box), then
// SEND runs the engine command `coop_sendreport` which POSTs the text + auto-context (version, map,
// maxclients, fps) to the mod team's Discord webhook (cvar coop_reportWebhook, seeded on the user's
// machine from updater.ini). coop_reportResult reports success/failure back into the menu.
menu "coop_report" 640 480 NONE 0
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
name "dim"
rect 0 0 640 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0.80
borderstyle "NONE"
shader "textures/mohmenu/black.tga"

}
resource
Label
{
name "panel"
rect 96 96 448 288
fgcolor 0.90 0.85 0.70 1.00
bgcolor 0.10 0.09 0.06 0.98
borderstyle "3D_BORDER"

}
resource
Label
{
title "REPORT A BUG"
name "title"
rect 116 110 408 26
fgcolor 0.95 0.85 0.45 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "facfont-20"

}
resource
Label
{
title "What broke? Tell us what you were doing,"
name "instr1"
rect 116 148 408 16
fgcolor 0.86 0.86 0.80 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"

}
resource
Label
{
title "which weapon or map, and what you expected."
name "instr2"
rect 116 166 408 16
fgcolor 0.86 0.86 0.80 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"

}
resource
Label
{
title "Sent to our Discord with your version and map."
name "instr3"
rect 116 184 408 16
fgcolor 0.80 0.80 0.72 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"

}
resource
Label
{
title "Your report (one line):"
name "fieldlabel"
rect 116 214 408 16
fgcolor 0.80 0.80 0.72 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"

}
resource
Field
{
title "reporttext"
name "reportfield"
rect 116 234 408 26
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.02 0.02 0.02 0.90
borderstyle "3D_BORDER"
linkcvar "coop_reportText"
font "verdana-12"

}
resource
Label
{
title ""
name "result"
rect 116 258 408 26
fgcolor 0.55 1.00 0.55 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "facfont-20"
linkcvar "coop_reportResult"
linkstring 1 "REPORT SENT - THANK YOU!"
linkstring 0 "NOT SENT - ENTER A DESCRIPTION FIRST"

}
resource
Button
{
name "send"
title "SEND REPORT"
rect 116 300 190 30
fgcolor 0.95 0.90 0.65 1.00
bgcolor 0.16 0.11 0.06 0.94
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "coop_sendreport"

}
resource
Button
{
name "back"
title "BACK"
rect 334 300 190 30
fgcolor 0.90 0.84 0.66 1.00
bgcolor 0.14 0.10 0.06 0.94
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/back.wav"
stuffcommand "seta coop_reportResult \"\"; popmenu 0"

}
end.
