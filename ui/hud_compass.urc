// HZM coop - Airborne-style COMPASS, re-homed to TOP-LEFT (Airborne stacks it bottom-left; we keep it where
// MOHAA's compass normally sits). North ring (playerstat 16) + frame + objective-direction arrow (playerstat
// 19) + a damage-direction flash on the ring (playerstat 29). Coop teammate radar kept in the centre.
// Textures/shaders from scripts/hud_airborne_coop.shader. virtualres 0 + scalecvar keep it crisp/scalable.
menu "hud_compass" 160 160 NONE 1
bgcolor 0 0 0 0
fgcolor 1 1 1 1
align left top
virtualres 0
scalecvar ui_compass_scale

//==================================================
// Rotating compass ring (north)
resource
Label
{
name "compassring"
rect 0 0 160 160
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
statbar compass
playerstat 16
statbar_shader hud_compass_in
}

//==================================================
// Coop teammate radar (kept from the stock coop compass), centred inside the ring
resource
Radar
{
rect 30 30 100 100
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
}

//==================================================
// Damage-direction flash on the ring (invisible until hit)
resource
Label
{
name "compasspain"
rect 0 0 160 160
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
statbar headingspinner 0 3600
statbar_endangles -180 180
playerstat 29
statbar_shader textures/hud/compasspainblank
statbar_shader_flash hud_compass_hit
}

//==================================================
// Objective-direction arrow
resource
Label
{
name "compassobj"
rect 0 0 160 160
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
playerstat 19
statbar spinner 0 3600
statbar_endangles -180 180
statbar_shader hud_compass_arrow
}

//==================================================
// Static frame overlay (drawn last, on top)
resource
Label
{
name "compassframe"
rect 0 0 160 160
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader hud_compass_out
}

end.
