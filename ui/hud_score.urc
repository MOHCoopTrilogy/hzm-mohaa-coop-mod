menu "hud_score" 168 24 NONE 1
bgcolor 0 0 0 0
fgcolor 1 1 1 1
align right top

// HZM coop [user 2026-10-11, bug-3485] "we need to remove Score: 0 (0) at the top right too for coop, you can see
// that if you hold Tab". The retail file, unchanged except that every label is gated on cg_hudScore, a neutral
// client cvar that cgame keeps at 1 in a multiplayer (PvP) session and 0 otherwise (cg_coopfeed.c
// CG_CoopScoreHudMirror) - this file is shared by both modes, so it may not name a multiplayer cvar itself
// (docs/tools/check_mp_isolation.py clause 7). Gone in coop, exactly as before in multiplayer.
resource
Label
{
title "Score:"
name "Default"
rect 0 0 64 24
fgcolor 0.69 0.69 0.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
font facfont-20
textalign right
outlinedtext 1
enabledcvar "cg_hudScore"
}

