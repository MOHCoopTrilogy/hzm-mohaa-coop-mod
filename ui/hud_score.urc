menu "hud_score" 168 24 NONE 1
bgcolor 0 0 0 0
fgcolor 1 1 1 1
align right top

// HZM coop [user 2026-10-11, bug-3485] "we need to remove Score: 0 (0) at the top right too for coop, you can see
// that if you hold Tab". The retail file, unchanged except that every label is gated on coop_mp_session: cgame
// zeroes that client cvar on every connect and coop_mod/mp.scr sets it to 1 for a multiplayer (PvP) session, so the
// readout is gone in coop and exactly as before in multiplayer.
resource
Label
{
title "Score:"
name "Default"
rect 0 0 64 24
fgcolor 0.69 0.69 0.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
font facfont-20
textalign right
outlinedtext 1
enabledcvar "coop_mp_session"
}

resource
Label
{
title "score display"
name "Default"
rect 64 0 32 24
fgcolor 0.69 0.69 0.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
playerstat "21"
font facfont-20
textalign right
outlinedtext 1
enabledcvar "coop_mp_session"
}

