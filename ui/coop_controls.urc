// HZM coop - CONTROLLER SETUP. Opened from Options > Controls (options_main.urc points the Controls
// button here). Enable a gamepad, toggle the coop-only aim assist, set look speed, read the default
// button map, or jump to the classic key/button rebind screen. Hand-authored (not generated). No pad
// image yet (artwork pending) - the layout is plain text so it renders at any resolution. The ON/OFF and
// LOOK status labels use the extended enabledcvar (uiwidget.cpp: a bool cvar or '!cvar').
menu "coop_controls" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 50
	name "bg"
	rect 0 0 640 480
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.05 0.06 0.08 1.00
	borderstyle "NONE"
}
resource
Label
{
	name "title"
	title "CONTROLLER SETUP"
	rect 245 18 160 16
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}

// ---- GAMEPAD ENABLE ----
resource
Label
{
	name "capEnable"
	title "GAMEPAD"
	rect 40 52 200 14
	fgcolor 0.55 0.60 0.66 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Button
{
	name "btnEnable"
	title "ENABLE"
	rect 40 70 150 18
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.90
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/apply.wav"
	stuffcommand "in_joystick 1 ; in_joystickUseAnalog 1 ; in_restart"
}
resource
Button
{
	name "btnDisable"
	title "DISABLE"
	rect 200 70 150 18
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.90
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/back.wav"
	stuffcommand "in_joystick 0 ; in_restart"
}
resource
Label
{
	name "noteEnable"
	title "Plug in your pad first, then Enable (does a quick input restart)."
	rect 40 92 460 14
	fgcolor 0.60 0.58 0.52 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}

// ---- AIM ASSIST (coop only) ----
resource
Label
{
	name "capAA"
	title "AIM ASSIST  (coop only - never in multiplayer)"
	rect 40 124 400 14
	fgcolor 0.55 0.60 0.66 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Label
{
	name "aaOn"
	title "Currently: ON"
	rect 40 144 150 14
	fgcolor 0.45 0.80 0.45 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	enabledcvar "coop_aimAssist"
}
resource
Label
{
	name "aaOff"
	title "Currently: OFF"
	rect 40 144 150 14
	fgcolor 0.70 0.55 0.45 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
	enabledcvar "!coop_aimAssist"
}
resource
Button
{
	name "btnAAOn"
	title "ON"
	rect 200 142 70 18
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.90
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/apply.wav"
	stuffcommand "seta coop_aimAssist 1"
}
resource
Button
{
	name "btnAAOff"
	title "OFF"
	rect 280 142 70 18
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.90
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/back.wav"
	stuffcommand "seta coop_aimAssist 0"
}

