// ---- FOOTER ----
resource
Button
{
	name "btnRebind"
	title "REBIND KEYS / BUTTONS"
	rect 40 430 220 20
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.90
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/apply.wav"
	stuffcommand "pushmenu controls"
}
resource
Button
{
	name "btnBack"
	title "BACK"
	rect 470 430 120 20
	fgcolor 0.88 0.83 0.66 1.00
	bgcolor 0.16 0.12 0.08 0.92
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/back.wav"
	stuffcommand "popmenu 0"
}
end.
