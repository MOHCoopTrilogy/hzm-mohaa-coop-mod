// HZM coop [user 2026-10-05] LAST MISSION - the debrief of the last coop mission, on demand from the main menu.
// Same declassified G-3 report plate as the WHAT'S NEW card (coop_whatsnew.urc, textures/mohmenu/coop_fieldreport.tga).
// The lines are archived client cvars coop_lm0..coop_lm9, written by the event feed (cgame/cg_coopfeed.c, category 6)
// when the server's debrief card plays (coop_mod/feed.scr::feed_lastMission): mission, XP + rank, promotion, then
// what was earned (unlocks, challenges, medals). Empty until the first debrief seen with a feed-capable cgame.
// NOTE: each resource field on its own line - single-line resource blocks silently drop.
menu "coop_lastmission" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 30
	name "document"
	rect 155 20 330 440
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "textures/mohmenu/coop_fieldreport.tga"
}
resource
Label
{
	ordernumber 0
	name "title"
	title "LAST MISSION - FIELD REPORT"
	rect 175 216 290 20
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "facfont-20"
}
resource
Label
{
	ordernumber 0
	name "lm0"
	rect 175 240 290 15
	fgcolor 0.40 0.30 0.18 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
	linkcvar "coop_lm0"
	dontlocalize
}
