// DEFAULTS = restore the shipping look | CANCEL = revert to the values from when this menu opened |
// APPLY = keep current values (they're archived cvars, so they persist across restarts) + close.
resource
Button
{
	title "DEFAULTS"
	name "defaultsButton"
	rect 335 414 82 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "exec coop_mod/cfg/coop_fxdefaults.cfg"
	font courier-16
	clicksound sound/menu/apply.wav
}
resource
Button
{
	title "CANCEL"
	name "cancelButton"
	rect 421 414 76 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "exec configs/coop_fxsession.cfg ; popmenu 0"
	font courier-16
	clicksound sound/menu/back.wav
}
resource
Button
{
	title "APPLY"
	name "applyButton"
	rect 501 414 89 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0"
	font courier-16
	clicksound sound/menu/apply.wav
}
end.
