//HZM coop - Post-Processing Effects control menu (gl1 GLSL post-FX).
//Toggles/sliders bind directly to the renderer cvars (live), like the base Brightness->r_gamma slider.
//Two columns: left = Bloom + Ambient Occlusion, right = Depth of Field (+ room for future effects).
menu "coop_postfx" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Widget
{
	ordernumber 10
	name "background"
	rect 40 70 560 406
	bgcolor 0 0 0 0.85
}
resource
Label
{
	ordernumber 0
	name "title"
	title "POST-PROCESSING EFFECTS"
	rect 40 76 560 22
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.30
	font courier-16
}

//================= LEFT COLUMN: master + bloom + ssao =================

//---- master on/off ----
resource
Label
{
	name "lblMaster"
	title "Post-Processing"
	rect 55 106 230 20
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
CheckBox
{
	name "cbMaster"
	rect 295 104 24 24
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	linkcvar "r_postProcess"
	checked_shader "textures/menu/checkbox_checked"
	unchecked_shader "textures/menu/checkbox_unchecked"
}

