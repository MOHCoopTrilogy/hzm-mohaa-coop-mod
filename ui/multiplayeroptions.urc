menu "mpoptions" 640 479 NONE 0
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
//vidmode 3
//fadein 0.5
virtualres 1
include "ui/multiplayerback.inc"








// HZM coop [user 2026-10-11, bug-3489] "all players should be playing with the highest possible internet speed
// settings ... that shouldn't be changeable for anyone". The retail file, minus its connection-speed list (28.8k modem
// .. LAN = rate 2500 .. 30000). The host now gives every player full data rate and every server frame whatever the
// client asks for (server/sv_client.c sv_hzmClientRate), and autoexec.cfg sets the client side to the maximum at
// every launch. The readout stays, as a fixed label.
resource
Label
{
title "German Player Model display"
name "Default"
rect 272 136 368 344
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "INDENT_BORDER"
linkcvar "ui_disp_playergermanmodel"
rendermodel 1
modeloffset "60 -8 0"
modelrotateoffset "0 0 0"
modelangles "10 180 0"
modelscale 1.0
modelanim germanselectionidle

}
resource
Label
{
title "Allies Player Model display"
name "Default"
rect 0 136 368 344
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "INDENT_BORDER"
linkcvar "ui_disp_playermodel"
rendermodel 1
modeloffset "60 8 0"
modelrotateoffset "0 0 0"
modelangles "10 180 0"
modelscale 1.0
modelanim americanselectionidle

}
resource
Label
{
name "Default"
rect 384 0 256 256
fgcolor 0.29 0.29 0.29 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "RAISED"
shader "modelselect_b"
}
resource
Label
{
name "Default"
rect 0 0 512 256
fgcolor 0.29 0.29 0.29 1.00
bgcolor 0.50 0.50 0.50 0.00
