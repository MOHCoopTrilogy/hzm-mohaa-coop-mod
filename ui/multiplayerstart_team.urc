// ui/multiplayerstart_team.urc - HZM MOD OVERRIDE of the base-game menu (same id; coop pak mounts last).
// COOP-classified: every coop_mp* SET / armory open routes through ui/coop_mpmenu/*.cfg (only legal coop_mp* token
// here is "coop_mpmenu"); readouts read ui_mp* mirrors (or engine-default titles). GameSpy removed. Stock Start
// names no coop_mp* and reads the on-screen ui_* fields; coop_mpMode (set by the mode button) persists to map load.
// Shared by standard Team Match and the gt2 HZM modes (KOTH/LMS/Freeze Tag/Push); mode-specific rows gated on ui_mpIs*. ASCII only; one resource field per line.
menu "multiplayerstart_team" 640 480 NONE 0
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
//vidmode 3
//fadein 0.5
virtualres 1
include "ui/serverback.inc"


