// HZM coop - ARMORY v2 'slot-first' loadout screen (GENERATED by scratchpad/gen_loadout2.py).
// Interaction: slot card click = activate slot (s<n>sel.cfg); weapon click = inspect +
// equip into the active slot (t<id>.cfg = exec p<id>.cfg then vstr coop_loCcur, where
// coop_loCcur redirects to the staged coop_loC<n> assign - wrong category = deny sound).
// Same open.cfg entry, same name-bus tokens, same server side as v1.
menu "coop_loadout" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
ordernumber 50
name "bg"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/coop_lo_bg2.tga"
}

resource
Button
{
name "closeBtn"
title "DONE"
rect 560 8 72 16
fgcolor 0.85 0.83 0.78 1.00
bgcolor 0.08 0.09 0.11 0.94
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/back.wav"
stuffcommand "popmenu 0 ; append name ,w0x"
}

resource
Label
{
ordernumber 20
name "charRender"
rect 12 46 134 374
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
linkcvar "coop_loChar"
rendermodel 1
modeloffset "78 0 -18"
modelrotateoffset "0 0 0"
modelangles "0 200 0"
modelscale 1.0
modelanim coop_loadout_idle
}

