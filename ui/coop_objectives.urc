/////////////////////////////////////////////////////////////
//SECONDARY OBJECTIVES (coop side objectives). Dedicated cvars coop_so1/coop_so2,
//anchored BELOW the 8 primary two-line rows so map objectives (coop_o1..coop_o8)
//can never overlap or collide with them.
//  coop_soNd = line visible, coop_soNa = active(white) text, coop_soNs = checkbox.
/////////////////////////////////////////////////////////////
resource
Label
{
title "Secondary Objectives:"
name "coop_MiObjSecHdr"
rect 10 366 640 16
fgcolor 0.8 0.9 1.0 1
bgcolor 0 0 0 0
borderstyle "NONE"
font courier-16
textalign left
enabledcvar "coop_so1d"
}
