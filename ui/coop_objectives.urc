//created for mohaa coop by chrissstrahl on 1th Februaray 2015
//updated 18th Feburary 2015 - change width of the background from 450 to 550
//updated 2026-07-12 (HZM coop) - WORD-WRAP: rows re-pitched to 40px with a second text line per
//objective (linkcvar coop_oNb, grey plate gated on coop_oNw). Long objective text is split
//server-side in global/objectives.scr::coop_objectivesSendPlayer (UILabel cannot wrap on width).
menu "coop_objectives" 640 480 FROM_LEFT 0.25
align left centery
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 0
virtualres 0

/////////////////////////////////////////////////////////////
//Objective title text, and its shadow, plus background
/////////////////////////////////////////////////////////////
resource
Widget
{
rect 10 20 550 26
bgcolor 0.2 0.2 0.2 0.8
borderstyle "NONE"
}

resource
Label
{
title "Mission Objectives:"
name "coop_MiObjTitle"
rect 11 21 640 22
fgcolor 0 0 0 1
bgcolor 0 0 0 0
borderstyle "NONE"
font courier-16
textalign left
}

resource
Label
{
title "Mission Objectives:"
name "coop_MiObjTitle"
rect 10 20 640 22
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
font courier-16
textalign left
}

resource
Label
{
title "__________________________________________________"
name "coop_MiObjLineS"
rect 11 25 640 20
fgcolor 0 0 0 1
bgcolor 0 0 0 0.0
borderstyle "NONE"
font courier-16
textalign left
}
resource
Label
{
title "__________________________________________________"
name "coop_MiObjLine"
rect 10 24 640 20
fgcolor 1 1 1 1
bgcolor 0 0 0 0.0
borderstyle "NONE"
font courier-16
textalign left
}
/////////////////////////////////////////////////////////////
//Objective Number 1, two-line row (line2 = coop_o1b, shown only when wrapped)
