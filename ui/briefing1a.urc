virtualres 1
include "ui/missionbriefingback.inc"














resource
Label
{
name "Default"
rect 96 74 456 344
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "briefing1a"
}

// ===========================================================================================
// HZM coop READY-UP OVERLAY - appended as the LAST widgets of each briefing slide menu (in-menu file order = draw order, so it renders ABOVE the slide image + bgfill).
// All elements gated by enabledcvar "coop_gate_active" (0/unset in SP -> hidden). coop_mod/readygate.scr
// pushes live values via `set coop_gate_*` per client. Draw order (not position) keeps it visible; positions unchanged.
// ===========================================================================================
resource
Label
{
name "coopgate_prompt"
title "Press  F  ( [Use] )  to Ready Up"
rect 120 12 400 18
fgcolor 1.00 1.00 0.55 1.00
bgcolor 0 0 0 0
borderstyle "NONE"
font "verdana-12"
enabledcvar "coop_gate_active"
}
resource
Label
{
name "coopgate_tally"
rect 120 31 400 16
fgcolor 0.85 0.85 0.85 1.00
bgcolor 0 0 0 0
borderstyle "NONE"
font "verdana-12"
linkcvar "coop_gate_tally"
enabledcvar "coop_gate_active"
}
resource
Label
{
name "coopgate_r1"
rect 8 420 12 12
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
linkcvar "coop_gate_p1r"
linkcvartoshader
enabledcvar "coop_gate_p1on"
}
resource
Label
{
name "coopgate_n1"
rect 23 421 140 14
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
font "verdana-12"
textalign left
linkcvar "coop_gate_p1"
enabledcvar "coop_gate_p1on"
}
resource
Label
{
name "coopgate_c1"
rect 166 420 11 11
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
shader "textures/hud/coop_ready_check"
enabledcvar "coop_gate_p1c"
}
