binditem "Objectives/Scores"				"+scores"
binditem "QuickSave"						"savegame quick"
binditem "Load QuickSave"					"loadgame quick"
binditem "DM Drop Weapon"					"weapdrop"
binditem "DM Select Team"					"pushmenu_teamselect"
binditem "DM Select Primary Weapon"			"pickweapon"
binditem "DM Quick Message"					"say"
