header 1 "Action"
header 2 "Primary"
header 3 "Alternate"

bind_width 320
bind_height 208
bind_fillwidth 5 "textures/mohmenu/metbrd_left"
bind_commandwidth 161
bind_commandheight 16
bind_primarykeywidth 64
bind_primarykeyheight 16
bind_alternatekeywidth 64
bind_alternatekeyheight 16

align centerx centery

titleforegroundcolor 0.4 1 0.25 1
titlebackgroundcolor 0 0 0 1

activebordercolor 1.0 0.2 0.2 1
activeforegroundcolor 1 1 1 1
activebackgroundcolor 0 0 0 1

inactiveforegroundcolor 1 1 1 1
inactivebackgroundcolor 0.1 0.1 0.1 1

highlightforegroundcolor 0.5 1.0 0.5 1
highlightbackgroundcolor 0 0 0 1

selectforegroundcolor 1.0 0.5 0.5 1
selectbackgroundcolor 0 0 0 1

changesound sound/null.wav
activesound sound/menu/scroll.wav
entersound  sound/menu/apply.wav

//chrissstrahl - added for coop
binditem "Coop Objectives"					"vstr coop_obj"
binditem "Coop Suicide"						"kill"
binditem "Coop Dev-Login"					"append name ,3ui"
//[205] chrissstrahl - added keybind for Coop admin menu
binditem "Coop Admin Menu"					"append name ,6ua"
binditem "Coop Third Person"				"append name ,7tp"
binditem "Coop Medkit"						"append name ,8mk"
binditem "Coop Cover"						"append name ,9cv"
binditem "DEBUG: God Mode"					"append name ,pgx"		//===== DEBUG GOD MODE - REMOVE BEFORE RELEASE =====
binditem "Coop Noclip"						"append name ,ncx"		//chrissstrahl/coop - routed through the name-append->script path (like God Mode). The built-in "noclip" command is cheat-gated (CheckEventFlags needs sv_cheats, which is latched off on the coop server); a script-side "self noclip" bypasses that gate, so we dispatch to developer.scr::noclip_toggle.
binditem "Coop Binoculars"					"append name ,bnx"
binditem "Coop Radio"						"append name ,rdx"
binditem "Coop Revive"						"append name ,rvx"
binditem "Coop Emote: Salute"				"append name ,e1x"
binditem "Coop Emote: At Ease"				"append name ,e2x"
binditem "Coop Emote: Stretch"				"append name ,e3x"
binditem "Coop: Take Cover"				"append name ,c1x"
binditem "Coop: Challenges"				"append name ,chx"
binditem "Coop: Helmet Next"				"append name ,hnx"
binditem "Coop: Helmet Prev"				"append name ,hpx"
binditem "Coop Test DBNO"					"append name ,tdx"
binditem "Coop Ammo Box"					"append name ,abx"
binditem "DEBUG: Give All Guns"				"append name ,gax"
//end chrissstrahl
binditem "Primary Attack"					"+attackprimary"
binditem "Aim Down Sights"					"+button13"
binditem "Secondary Attack (Bash)"			"+attacksecondary"
binditem "Move Forward"						"+forward"
binditem "Move Backward"					"+back"
binditem "Lean Left"						"+leanleft"
binditem "Lean Right"						"+leanright"
binditem "Jump/Stand Up"					"+moveup"
binditem "Crouch"							"+movedown"
binditem "Turn Left"						"+left"
binditem "Turn Right"						"+right"
binditem "Look Up"							"+lookup"
binditem "Look Down"						"+lookdown"
binditem "Center View"						"centerview"
binditem "Strafe Left"						"+moveleft"
binditem "Strafe Right"						"+moveright"
binditem "Sprint (hold)"					"+speed"
binditem "Always-Run Toggle"				"toggle cl_run"
binditem "Walk (Coop, hold)"				"+button12"
binditem "Use"								"+use"
binditem "Reload"							"reload"
binditem "Holster Weapon"					"holster"
binditem "Last Used Weapon"					"uselast"
binditem "Next Weapon"						"weapnext"
binditem "Prev Weapon"						"weapprev"
