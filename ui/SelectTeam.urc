// HZM coop/MP - MODERN TEAM SELECT (overrides the stock SelectTeam). Reached by pushmenu_teamselect
// (engine auto-open on join, the "DM Select Team" bind, and the in-game/pause "Select Team" button all
// route here via CG_PushMenuTeamSelect_f -> pushmenu SelectTeam). Two faction panels + a Spectator button.
// Picking Allies/Axis runs join_team, which spawns the player -> the E5 UserSelectWeapon redirect opens the
// side armory (loadout) exactly as before. Coop force-teams players, so this never appears in a coop game.
// Uses only engine commands (join_team/spectator) - no coop_mp* token.
//
// [user 2026-09-21] WHOLE-LAYOUT REDESIGN: a full-screen designed backdrop (coop_ts_bg) + two gradient
// faction panels (coop_ts_panel_*) with large 256px emblems, instead of the old flat-colour boxes. Assets
// come from docs/tools/gen_teamselect_icons.py. ordernumber: LOWER draws in FRONT, so bg=60 (back),
// panels=30, click buttons=20, emblems=8, faction text=6, title=10.
menu "SelectTeam" 640 480 NONE 0
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

// ---- full-screen backdrop ----
resource
Label
{
	ordernumber 60
	name "bg"
	rect 0 0 640 480
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "coop_ts_bg"
}

// ---- title ----
resource
Label
{
	ordernumber 10
	name "title"
	title "CHOOSE YOUR SIDE"
	rect 120 26 400 30
	fgcolor 0.93 0.90 0.80 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
}
resource
Label
{
	ordernumber 10
	name "subtitle"
	title "Select your faction - then set your loadout"
	rect 120 60 400 16
	fgcolor 0.58 0.62 0.66 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}

// ==== ALLIES (left) ====
resource
Label
{
	ordernumber 30
	name "panelAllies"
	rect 54 92 244 300
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "coop_ts_panel_allies"
}
resource
Label
{
	ordernumber 8
	name "icoAllies"
	rect 121 118 110 110
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "coop_ts_allies_emblem"
}
resource
Label
{
	ordernumber 6
	name "lblAllies"
	title "ALLIES"
	rect 54 240 244 26
	fgcolor 0.88 0.92 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
}
resource
Label
{
	ordernumber 6
	name "alliesSub"
	title "US   UK   SOVIET"
	rect 54 274 244 16
	fgcolor 0.66 0.74 0.86 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Button
{
	ordernumber 20
	name "btnAllies"
	title ""
	rect 54 92 244 300
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.40 0.58 0.85 0.001
	borderstyle "NONE"
	clicksound "sound/menu/apply.wav"
	stuffcommand "popmenu 0 ; join_team allies"
}

