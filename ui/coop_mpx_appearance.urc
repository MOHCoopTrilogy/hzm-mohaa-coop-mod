// HZM MP AXIS APPEARANCE APPEARANCE - GENERATED by docs/tools/gen_mp_armory.py - DO NOT HAND-EDIT.
// Skin/helmet/glove picks commit via the ,q name-bus (mp_armory.scr::applyMarker), applied at
// spawn by mp_cosmetics.scr. No vstr; names only coop_mp* cvars (isolation clauses 12/13/18).
menu "coop_mpx_appearance" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

