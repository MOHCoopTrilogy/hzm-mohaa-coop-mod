resource
Button
{
name "back"
rect 8 448 96 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/back"
hovershader "textures/mohmenu/back_h"
clicksound "sound/menu/back.wav"
stuffcommand "popmenu 0"
}
resource
Button
{
name "audio button"
rect 286 246 164 62
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "menu_button_trans"
hovershader "textures/mohmenu/options_audio_h"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu audio_options"
hovercommand "set ui_optionshader textures/mohmenu/options_audio"
mouseawaycommand "set ui_optionshader 0"

}
resource
Button
{
name "controls button"
rect 166 304 134 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "menu_button_trans"
hovershader "textures/mohmenu/options_controls_h"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu controls"
hovercommand "set ui_optionshader textures/mohmenu/options_controls"
mouseawaycommand "set ui_optionshader 0"

}
resource
Button
{
name "video button"
rect 434 306 142 74
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "menu_button_trans"
hovershader "textures/mohmenu/options_video_h"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu video_options"
hovercommand "set ui_optionshader textures/mohmenu/options_video"
mouseawaycommand "set ui_optionshader 0"

}
resource
Label
{
name "Default"
rect 568 0 64 16
fgcolor 0.00 0.00 0.00 1.00
bgcolor 1.00 1.00 1.00 0.00
borderstyle "RAISED"
linkcvar "shortversion"
}
resource
Button
{
name "advanced options"
// rect 275 63 192 88
rect 276 62 194 92
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "menu_button_trans"
hovershader "textures/mohmenu/options_advanced_h"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu advancedoptions"
hovercommand "set ui_optionshader textures/mohmenu/options_advanced"
mouseawaycommand "set ui_optionshader 0"

}
resource
Label
{
name "Default"
rect 79 46 169 47
// rect 96 52 128 32
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
tileshader 0
borderstyle "NONE"
linkcvar "ui_optionshader"
linkcvartoshader

}

// ===== HZM coop - COOP OPTIONS =====
// White "Coop Options" sign on the chalkboard (same spot as the other category signs), shown only while the
// documents are hovered (gated by ui_coopOptSign, which the documents Button sets).
resource
Label
{
name "coop_options_sign"
title "Coop Options"
rect 79 46 169 47
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "facfont-20"
enabledcvar "ui_coopOptSign"
}

// The DOCUMENTS / folder on the right of the table = the coop options entry. Rect is an EYEBALLED estimate
// over the yellow folder in the options bg art - nudge if the click area is off.
resource
Button
{
name "coop_options_docs"
rect 350 386 140 58
fgcolor 1.00 1.00 1.00 1.00
bgcolor 1.00 1.00 1.00 0.00
borderstyle "NONE"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu coop_settings"
hovercommand "set ui_coopOptSign 1"
mouseawaycommand "set ui_coopOptSign 0"
}
// Hover highlight: a warm translucent glow over the documents while hovered (no documents-glow texture
// exists, so this stand-in makes it obviously clickable, like the radio lighting up). Gated by ui_coopOptSign.
resource
Widget
{
name "coop_options_docs_hi"
rect 350 386 140 58
bgcolor 1.00 0.93 0.55 0.22
enabledcvar "ui_coopOptSign"
}
end.
