resource
Button
{
	title "< BACK"
	name "backButton"
	rect 55 414 100 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0"
	font courier-16
	clicksound sound/menu/back.wav
}
// PAGE 3 = the new (non-gl1) additions: underwater/frost screen effects, chromatic aberration,
// film grain. These have no gl1 counterpart, so they live past everything ported today.
resource
Button
{
	title "MORE >"
	name "moreButton2"
	rect 260 414 100 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "pushmenu coop_postfx3"
	font courier-16
	clicksound sound/menu/apply.wav
}
resource
Button
{
	title "APPLY"
	name "applyButton"
	rect 501 414 89 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0;popmenu 0"
	font courier-16
	clicksound sound/menu/apply.wav
}
end.
