resource
Label
{
	name "note2"
	title "Sun Shadows/Rays need APPLY (vid_restart) to take effect. DEFAULTS is on page 1."
	rect 55 378 535 20
	fgcolor 0.70 0.70 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
