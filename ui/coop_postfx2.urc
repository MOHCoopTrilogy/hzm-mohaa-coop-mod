//HZM coop - Post-Processing Effects, PAGE 2. Page 1 (ui/coop_postfx.urc) filled up: its rows run
//to y=444 with the button strip at 414, so these controls live here instead. Reached by the
//"MORE >" button on page 1; "< BACK" returns.
//Everything here binds directly to the renderer cvars, live, exactly like page 1. All of these
//already existed but were CONSOLE-ONLY on both renderers - they had no menu row anywhere.
//DEFAULTS on page 1 (coop_mod/cfg/coop_fxdefaults.cfg) already covers every cvar on this page.
menu "coop_postfx2" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Widget
{
	ordernumber 10
	name "background"
	rect 40 70 560 406
	bgcolor 0 0 0 0.85
}
resource
Label
{
	ordernumber 0
	name "title"
	title "POST-PROCESSING EFFECTS  (2 of 2)"
	rect 40 76 560 22
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.30
	font courier-16
}

//================= LEFT COLUMN: image sharpening + rain =================

//---- sharpen on/off ----
resource
Label
{
	name "lblSharp"
	title "Sharpen"
	rect 55 116 230 20
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
CheckBox
{
	name "cbSharp"
	rect 295 114 24 24
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	linkcvar "r_ppSharpen"
	checked_shader "textures/menu/checkbox_checked"
	unchecked_shader "textures/menu/checkbox_unchecked"
}

//---- sharpen amount ----
resource
Label
{
	name "lblSharpAmt"
	title "Sharpen Amt"
	rect 55 148 145 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
Slider
{
	name "slSharpAmt"
	rect 205 148 105 16
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.50 0.50 0.50 0.00
	borderstyle "NONE"
	shader "textures/menu/slider"
	linkcvar "r_ppSharpenAmount"
	slidertype float
	setrange 0 1
	stepsize 0.05
}

