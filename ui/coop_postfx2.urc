//================= RIGHT COLUMN: muzzle heat + low health tuning =================
// HZM fix: this used to have a "Muzzle Heat" strength slider linked to r_ppMuzzleHeat - that
// cvar is NOT a setting, it's cgame's live per-frame decaying gunfire-heat intensity
// (cg_view.c publishes it every frame), so dragging the slider got overwritten the very next
// frame and looked stuck/unresponsive. Overall muzzle-heat strength is already covered by
// "Heat Haze Amt" above (r_ppHeatAmount multiplies both the ambient haze and muzzle heat -
// tr_postprocess.c: muzHeat = r_ppMuzzleHeat * r_ppHeatAmount). Only the hot-spot's SIZE
// (r_ppMuzzleRadius) is a real, independent, user-adjustable setting.

//---- muzzle hot-spot radius ----
resource
Label
{
	name "lblMuzR"
	title "Muzzle Radius"
	rect 335 188 145 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
Slider
{
	name "slMuzR"
	rect 485 188 105 16
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.50 0.50 0.50 0.00
	borderstyle "NONE"
	shader "textures/menu/slider"
	linkcvar "r_ppMuzzleRadius"
	slidertype float
	setrange 0.02 0.6
	stepsize 0.02
}

