//HZM coop - ADVANCED GRAPHICS menu. Exposes built-in renderergl1 quality cvars that the vanilla video
//menu does NOT (anisotropic filtering, MSAA, overbright lighting, curve smoothing, etc.). These are stock
//engine knobs, separate from the coop post-FX (that's the COOP SETTINGS -> Post-Processing page).
//Latched cvars (aniso, MSAA, overbright, subdivisions) apply on APPLY, which runs ui_checkrestart -> the
//engine auto-issues vid_restart when any linked latched cvar changed. Live cvars (draw sun, flares, vsync,
//intensity) apply instantly. Reached from the Video Options menu's "ADVANCED GFX" button.
menu "advanced_graphics" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Widget
{
	ordernumber 10
	name "background"
	rect 40 70 560 406
	bgcolor 0 0 0 0.85
}
resource
Label
{
	ordernumber 0
	name "title"
	title "ADVANCED GRAPHICS"
	rect 40 76 560 22
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.30
	font courier-16
}

