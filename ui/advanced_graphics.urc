resource
PulldownMenuContainer
{
	title "list"
	name "pdFps"
	rect 174 290 136 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	menushader "MENU" "textures/mohmenu/trans_click"
	selmenushader "MENU" "textures/mohmenu/trans_click"
	addpopup "MENU" "62 fps" command "seta com_maxfps 62 ; alias coop_fpsRestore seta com_maxfps 62"
	addpopup "MENU" "125 fps" command "seta com_maxfps 125 ; alias coop_fpsRestore seta com_maxfps 125"
	addpopup "MENU" "142 fps" command "seta com_maxfps 142 ; alias coop_fpsRestore seta com_maxfps 142"
	addpopup "MENU" "166 fps" command "seta com_maxfps 166 ; alias coop_fpsRestore seta com_maxfps 166"
	addpopup "MENU" "200 fps" command "seta com_maxfps 200 ; alias coop_fpsRestore seta com_maxfps 200"
	addpopup "MENU" "250 fps" command "seta com_maxfps 250 ; alias coop_fpsRestore seta com_maxfps 250"
	addpopup "MENU" "Unlimited" command "seta com_maxfps 0 ; alias coop_fpsRestore seta com_maxfps 0"
}
