// APPLY runs ui_checkrestart so the engine auto vid_restarts when a latched knob (aniso/MSAA/overbright/
// subdivisions) changed; live cvars already applied. BACK just closes.
resource
Button
{
	title "BACK"
	name "backButton"
	rect 120 440 90 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0"
	font courier-16
	clicksound sound/menu/back.wav
}
resource
Button
{
	title "APPLY"
	name "applyButton"
	rect 430 440 110 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "ui_checkrestart ; popmenu 0"
	font courier-16
	clicksound sound/menu/apply.wav
}
