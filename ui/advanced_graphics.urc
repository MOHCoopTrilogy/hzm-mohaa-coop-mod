//================= RIGHT COLUMN: geometry & display =================

//---- Anti-Aliasing (MSAA): discrete Off / 2x / 4x / 8x. ONE control drives BOTH renderers -
//---- r_ext_multisample (renderergl1 MSAA) AND r_ext_framebuffer_multisample (renderergl2/opengl2
//---- FBO MSAA, resolved in tr_fbo.c). A compact trans_click pulldown (bug-756 recipe: whole rect
//---- is clickable + invisible) sits over a blank2 value plate that shows the current level via
//---- linkstring. Both cvars are CVAR_ARCHIVE|CVAR_LATCH and are each linked to a widget in this
//---- menu, so APPLY's ui_checkrestart (Menu::CheckRestart) sees the latched change on whichever
//---- cvar the active renderer registered and auto-issues vid_restart.
resource
Label
{
	name "lblAA"
	title "Anti-Aliasing (MSAA)"
	rect 335 140 155 20
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
Label
{
	name "aadisplay"
	rect 495 140 95 16
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.50 0.50 0.50 0.00
	borderstyle "NONE"
	shader "textures/menu/blank2"
	//[HZM 2026-07-28 bug-1152] READ THE FBO CVAR, NOT r_ext_multisample. Under renderergl2 the
	//engine clamps r_ext_multisample to a MAX OF 4 (renderergl2/tr_init.c:1389
	//ri.Cvar_CheckRange(r_ext_multisample, 0, 4, qtrue); the qconsole log shows
	//"WARNING: cvar 'r_ext_multisample' out of range (max 4), setting to 4"). Picking 8x therefore
	//set r_ext_multisample 8 -> instantly clamped back to 4, so this label snapped straight back to
	//"4x" and the selector looked broken - the user-visible "I can't adjust MSAA from 4x to 8x".
	//The pulldown sets BOTH cvars to the same value on every pick, and
	//r_ext_framebuffer_multisample is NEVER clamped (gl2 bounds it against GL_MAX_SAMPLES in
	//tr_fbo.c, which is 32 on modern cards), so it is the honest record of what was chosen and
	//displays correctly under BOTH renderers.
	//[user 2026-08-21] MSAA WAS genuinely off, but NOT for the reason first recorded here. The
	//session assumed the mod had reverted to renderergl1; the log says otherwise
	//(cl_renderer "opengl2", "Trying to load renderer_opengl2.dll", GL_VERSION 3.2.0), so the
	//bug-1152 reasoning above is LIVE, not historical, and this label must keep reading the FBO
	//cvar. The real cause was the SAVED CONFIG: it carried r_ext_multisample 0 AND
	//r_ext_framebuffer_multisample 0 - the fossil of the bug-1298 gl2 mitigation - and the saved
	//config loads AFTER coop_defaults.cfg, so that 0 beat the 8 in defaults every boot. Both are
	//now 8. r_ext_framebuffer_multisample is also registered in renderergl1 now, so this label
	//resolves under EITHER renderer instead of silently reading an unregistered cvar.
	linkcvar "r_ext_framebuffer_multisample"
	linkstring 0 "Off"
	linkstring 2 "2x"
	linkstring 4 "4x"
	linkstring 8 "8x"
	font courier-16
}
resource
PulldownMenuContainer
{
	title "list"
	name "aalist"
	rect 493 138 99 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.50 0.50 0.50 0.00
	borderstyle "NONE"
	menushader "MENU" "textures/mohmenu/trans_click"
	selmenushader "MENU" "textures/mohmenu/trans_click"
	addpopup "MENU" "Off" command "seta r_ext_multisample 0 ; seta r_ext_framebuffer_multisample 0"
	addpopup "MENU" "2x" command "seta r_ext_multisample 2 ; seta r_ext_framebuffer_multisample 2"
	addpopup "MENU" "4x" command "seta r_ext_multisample 4 ; seta r_ext_framebuffer_multisample 4"
	addpopup "MENU" "8x" command "seta r_ext_multisample 8 ; seta r_ext_framebuffer_multisample 8"
}
resource
Label
{
	name "aa_fbo_watch"
	rect 0 0 1 1
	fgcolor 0.00 0.00 0.00 0.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	linkcvar "r_ext_framebuffer_multisample"
}

