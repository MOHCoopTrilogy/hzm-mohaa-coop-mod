// HZM coop/MP - MODERN TEAM SELECT for OBJECTIVE gametypes (overrides the stock ObjSelectTeam). Identical
// to SelectTeam.urc - CG_PushMenuTeamSelect_f routes GT_OBJECTIVE here instead of the default SelectTeam.
// Two faction panels + Spectator; join_team spawns and the E5 redirect opens the loadout. No coop_mp* token.
menu "ObjSelectTeam" 640 480 NONE 0
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 50
	name "bg"
	rect 0 0 640 480
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.04 0.05 0.07 1.00
	borderstyle "NONE"
}
resource
Label
{
	name "title"
	title "CHOOSE YOUR SIDE"
	rect 170 36 300 24
	fgcolor 0.88 0.84 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "facfont-20"
}
resource
Label
{
	name "subtitle"
	title "Pick a side to deploy - then set your loadout"
	rect 170 66 300 14
	fgcolor 0.55 0.58 0.60 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Label
{
	ordernumber 4
	name "icoAllies"
	rect 148 142 66 66
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "textures/mohmenu/coop_ts_allies.tga"
}
resource
Label
{
	ordernumber 4
	name "icoAxis"
	rect 426 142 66 66
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "textures/mohmenu/coop_ts_axis.tga"
}
resource
Button
{
	ordernumber 20
	name "btnAllies"
	title "ALLIES"
	rect 66 104 230 250
	fgcolor 0.86 0.90 0.98 1.00
	bgcolor 0.10 0.15 0.24 0.94
	borderstyle "3D_BORDER"
	font "facfont-20"
	clicksound "sound/menu/apply.wav"
	stuffcommand "popmenu 0 ; join_team allies"
}
resource
Label
{
	ordernumber 5
	name "alliesSub"
	title "US  -  UK  -  SOVIET"
	rect 66 316 230 16
	fgcolor 0.62 0.70 0.82 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Button
{
	ordernumber 20
	name "btnAxis"
	title "AXIS"
	rect 344 104 230 250
	fgcolor 0.98 0.88 0.84 1.00
	bgcolor 0.22 0.11 0.10 0.94
	borderstyle "3D_BORDER"
	font "facfont-20"
	clicksound "sound/menu/apply.wav"
	stuffcommand "popmenu 0 ; join_team axis"
}
resource
Label
{
	ordernumber 5
	name "axisSub"
	title "GERMANY  -  ITALY"
	rect 344 316 230 16
	fgcolor 0.82 0.66 0.62 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	font "verdana-12"
}
resource
Label
{
	ordernumber 4
	name "icoSpec"
	rect 240 393 20 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "textures/mohmenu/coop_ts_spec.tga"
}
resource
Button
{
	name "btnSpectate"
	title "SPECTATE"
	rect 220 388 200 30
	fgcolor 0.84 0.82 0.76 1.00
	bgcolor 0.09 0.10 0.13 0.92
	borderstyle "3D_BORDER"
	font "verdana-12"
	clicksound "sound/menu/back.wav"
	stuffcommand "popmenu 0 ; spectator"
}
end.
