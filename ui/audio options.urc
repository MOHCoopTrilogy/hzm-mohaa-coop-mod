resource
Label
{
name "outputdevice_sign"
rect 408 254 144 22
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/coop_output_device_sign"
}

resource
Label
{
title " "
name "outputdevice_value"
rect 384 288 192 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/menu/blank2"
linkcvar "s_openaldevice"
linkstring "" "System Default"
linkstring "OpenAL Soft on Speakers (Logitech G560 Gaming Speaker)" "Logitech G560 Speakers"
linkstring "OpenAL Soft on Headphones (Oculus Virtual Audio Device)" "Oculus Virtual Headphones"
linkstring "OpenAL Soft on Speakers (Steam Streaming Speakers)" "Steam Streaming Speakers"
linkstring "OpenAL Soft on Speakers (Steam Streaming Microphone)" "Steam Streaming Microphone"
linkstring "OpenAL Soft on Headphones (Arctis Nova Pro Wireless)" "Arctis Nova Pro Wireless"
linkstring "OpenAL Soft on Speakers (Bigscreen Audio Stream 1.2)" "Bigscreen Audio Stream"
}

resource
PulldownMenuContainer
{
title "list"
name "outputdevicelist"
rect 336 264 64 64
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "System Default" command "s_setdevice -1"
addpopup "MENU" "Logitech G560 Speakers" command "s_setdevice 0"
addpopup "MENU" "Oculus Virtual Headphones" command "s_setdevice 1"
addpopup "MENU" "Steam Streaming Speakers" command "s_setdevice 2"
addpopup "MENU" "Steam Streaming Microphone" command "s_setdevice 3"
addpopup "MENU" "Arctis Nova Pro Wireless" command "s_setdevice 4"
addpopup "MENU" "Bigscreen Audio Stream" command "s_setdevice 5"
}

// HZM coop - full audio control: SFX + ambience + dialogue sliders.
// s_sfxvolume (HZM engine cvar) scales every effect channel except dialog/menu,
// s_ambientvolume scales every looping sound incl. the coop ambience beds,
// s_dialogscale scales the CHAN_DIALOG voice-over channels.

resource
Label
{
name "sfxvolume_sign"
rect 88 240 144 22
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/coop_sfx_volume_sign"
}

resource
Slider
{
title "SFX Volume Slider"
name "Default"
rect 64 264 192 16
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/menu/slider"
linkcvar "s_sfxvolume"
slidertype float
setrange 0 2
stepsize 0.1
}

resource
Label
{
name "ambvolume_sign"
rect 88 284 144 22
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/coop_ambience_volume_sign"
}

