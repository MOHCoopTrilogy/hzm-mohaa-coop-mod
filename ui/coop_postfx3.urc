//---- note ----
//---- HZM coop [user 08-02] ON-HIT BLOOD ------------------------------------------------
// Requested with the suppression work: a distinct cue for the instant a round LANDS on you,
// separate from the sustained under-fire suppression pass. Placed on page 3 because pages 1
// and 2 are full (page 1 runs to y=444). Left column, rows 196 and 228, which were free.
// Per the user's standing preference, every visual FX gets a menu control rather than being
// console-only.
resource
Label
{
	name "lblHitBlood"
	title "On-Hit Blood"
	rect 55 196 230 20
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
CheckBox
{
	name "cbHitBlood"
	rect 295 194 24 24
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
