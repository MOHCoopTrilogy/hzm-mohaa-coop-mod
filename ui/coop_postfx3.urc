//HZM coop - Post-Processing Effects, PAGE 3. These four are NEW additions with no gl1
//counterpart (not ports): underwater/slime/lava screen distortion, frost-on-lens while it snows,
//chromatic aberration, film grain. Underwater and frost are driven by real cgame-side detection
//(the same water-contents/precip signals the game already uses for its FOV-warp and rain-on-lens)
//so they trigger automatically; chromatic aberration and film grain are pure image-grade look
//toggles, off by default, for anyone who wants the cinematic look.
menu "coop_postfx3" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Widget
{
	ordernumber 10
	name "background"
	rect 40 70 560 406
	bgcolor 0 0 0 0.85
}
resource
Label
{
	ordernumber 0
	name "title"
	title "POST-PROCESSING EFFECTS  (3 of 3)"
	rect 40 76 560 22
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.30
	font courier-16
}

//================= LEFT COLUMN: environmental (automatic) =================

//---- underwater distortion on/off ----
resource
Label
{
	name "lblUw"
	title "Underwater FX"
	rect 55 116 230 20
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
CheckBox
{
	name "cbUw"
	rect 295 114 24 24
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	linkcvar "r_ppUnderwaterFx"
	checked_shader "textures/menu/checkbox_checked"
	unchecked_shader "textures/menu/checkbox_unchecked"
}

//---- frost-on-lens (snow) on/off ----
resource
Label
{
	name "lblFrost"
	title "Frost On Lens (Snow)"
	rect 55 156 230 20
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}
resource
CheckBox
{
	name "cbFrost"
	rect 295 154 24 24
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	linkcvar "r_ppFrost"
	checked_shader "textures/menu/checkbox_checked"
	unchecked_shader "textures/menu/checkbox_unchecked"
}

