{
	name "note3"
	title "Underwater/Frost trigger automatically. Chromatic Ab./Grain are off by default."
	rect 55 260 535 20
	fgcolor 0.70 0.70 0.70 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font courier-16
	textalign left
}

resource
Button
{
	title "< BACK"
	name "backButton"
	rect 55 414 100 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0"
	font courier-16
	clicksound sound/menu/back.wav
}
resource
Button
{
	title "APPLY"
	name "applyButton"
	rect 501 414 89 22
	fgcolor 0.99 0.80 0.20 1.00
	bgcolor 1.00 1.00 1.00 0.20
	borderstyle "NONE"
	stuffcommand "popmenu 0;popmenu 0;popmenu 0"
	font courier-16
