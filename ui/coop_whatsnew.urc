// HZM coop - WHAT'S NEW card, shown once at the main menu after the auto-updater applies a
// patch. Trigger: the updater writes home/maintt/whatsnew_pending.cfg (wait + pushmenu) which
// autoexec.cfg execs every launch; the next up-to-date launch rewrites that cfg empty, so the
// card shows exactly once per update. fullscreen 0 + a CLOSE button: it never captures the
// screen, never blocks the auto-opened console, and ESC pops it like any menu.
// NOTE: each resource field on its own line - the URC parser silently drops single-line blocks.
// CHANGELOG LINES ARE BAKED PER RELEASE - update this file as part of every publish.
menu "coop_whatsnew" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 20
	name "card"
	rect 140 92 360 320
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.10 0.11 0.09 0.92
	borderstyle "3D_BORDER"
}
resource
Label
{
	ordernumber 10
	name "titlebar"
	rect 152 102 336 26
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.30 0.20 0.10 0.95
	borderstyle "3D_BORDER"
}
resource
Label
{
	ordernumber 0
	name "title"
	title "UPDATED TO v1.1.33"
	rect 152 104 336 22
	fgcolor 0.95 0.90 0.75 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "facfont-20"
}
resource
Label
{
	ordernumber 0
	name "line1"
	title "- Spawn protection: 8s safety after every spawn"
	rect 156 140 328 18
	fgcolor 0.90 0.88 0.80 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
