// HZM coop - WHAT'S NEW card, shown once at the main menu after the auto-updater applies a
// patch. Styled as the manila FIELD REPORT folder (same visual language as coop_settings.urc:
// colour fills only - texture refs are unreliable for menu Labels). Trigger: updater writes
// home/maintt/whatsnew_pending.cfg (wait + pushmenu), autoexec execs it every launch, next
// up-to-date launch blanks it = shown once per update. fullscreen 0: never blocks the console.
// NOTE: each resource field on its own line - single-line resource blocks silently drop.
// CHANGELOG IS BAKED PER RELEASE - update as part of every publish. Labels render centered.
menu "coop_whatsnew" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 30
	name "folder"
	rect 96 60 448 396
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.58 0.47 0.29 1.00
	borderstyle "3D_BORDER"
}
resource
