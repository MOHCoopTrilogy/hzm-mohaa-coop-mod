// HZM coop - WHAT'S NEW card, shown once at the main menu after the auto-updater applies a
// patch. [218] Restyled as a REAL declassified G-3 report cover (user reference photo): the whole
// document - aged paper, punch holes, NR scrawl, DECLASSIFIED stamps, signature, stripes - is
// BAKED into textures/mohmenu/coop_fieldreport.tga (generator: scratchpad gen_fieldreport.py,
// 2048 POT strict TGA); release notes overlay the document's clear middle band. Direct-TGA
// shader refs on Labels are the same pattern vanilla ui/controls.urc uses.
// Trigger: updater writes home/maintt/whatsnew_pending.cfg (wait + pushmenu), autoexec execs it
// every launch, next up-to-date launch blanks it = shown once per update. fullscreen 0.
// NOTE: each resource field on its own line - single-line resource blocks silently drop.
// CHANGELOG IS BAKED PER RELEASE - update the title + note lines as part of every publish.
menu "coop_whatsnew" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
	ordernumber 30
	name "document"
	rect 155 20 330 440
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.00 0.00 0.00 0.00
	borderstyle "NONE"
	shader "textures/mohmenu/coop_fieldreport.tga"
}
resource
Label
{
	ordernumber 0
	name "title"
	title "UPDATE v1.3.0 - FIELD REPORT"
	rect 175 216 290 20
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "facfont-20"
}
resource
Label
{
	ordernumber 0
	name "subtitle"
	title "declassified squad bulletin - read and pass along"
	rect 175 240 290 13
	fgcolor 0.40 0.30 0.18 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f1"
	title "NEW: Nebelwerfer Hunt now briefs you objective by objective"
	rect 175 262 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f2"
	title "NEW: Squad lobby between every campaign mission"
	rect 175 279 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f3"
	title "FIX: Manned MG42 nests now fire back - and can miss"
	rect 175 296 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f4"
	title "FIX: Halftrack gunner no longer aims at your head"
	rect 175 313 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f5"
	title "FIX: Enemies no longer freeze and stare instead of fighting"
	rect 175 330 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Label
{
	ordernumber 0
	name "f6"
	title "FIX: Ground no longer vanishes past the churchyard wall"
	rect 175 347 290 15
	fgcolor 0.16 0.10 0.05 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "verdana-12"
}
resource
Button
{
	name "closeBtn"
	title "FILE AWAY"
	rect 175 428 110 20
	fgcolor 0.88 0.83 0.66 1.00
	bgcolor 0.16 0.12 0.08 0.92
	borderstyle "3D_BORDER"
	font "facfont-20"
	clicksound "sound/menu/back.wav"
	stuffcommand "popmenu 0"
}
end.
