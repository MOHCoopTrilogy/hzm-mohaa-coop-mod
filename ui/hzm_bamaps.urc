// HZM - Base Assault CAMPAIGN MAP picker. The 5 SP campaign maps UberMod's Base Assault shipped on live
// in maps/ root (not maps/dm or maps/obj), so the stock Select Map browser never lists them. Reached from
// the BASE ASSAULT-only "Campaign Maps" button on the team setup board. Each button arms the one-shot
// engine arena gate sv_mpForceArena and sets ui_dmmap. Neutral name; sets only ui_dmmap + sv_mpForceArena,
// so it is isolation-clean.
menu "hzm_bamaps" 640 480 NONE 0
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
include "ui/multiplayerback.inc"

resource
Label
{
name "bg_panel"
rect 120 70 400 300
fgcolor 0.84 0.82 0.76 1.00
bgcolor 0.05 0.06 0.08 1.00
borderstyle "RAISED"
}
resource
Label
{
name "caption"
title "BASE ASSAULT CAMPAIGN MAPS"
rect 120 80 400 22
fgcolor 0.86 0.74 0.44 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "facfont-20"
textalign xcenter
}
resource
Label
{
name "sub"
title "Converted single-player maps (Base Assault mode)"
rect 120 108 400 16
fgcolor 0.55 0.60 0.66 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
textalign xcenter
}
resource
Button
{
name "sp1"
title "Mission 1-3a"
rect 136 140 168 28
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set sv_mpForceArena 1 ; set ui_dmmap m1l3a ; popmenu 0"
}
resource
Button
{
name "sp2"
title "Mission 1-3b"
rect 300 140 168 28
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set sv_mpForceArena 1 ; set ui_dmmap m1l3b ; popmenu 0"
}
resource
Button
{
name "sp3"
title "Mission 4-1"
rect 136 176 168 28
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set sv_mpForceArena 1 ; set ui_dmmap m4l1 ; popmenu 0"
}
resource
Button
{
name "sp4"
title "Mission 5-2a"
rect 300 176 168 28
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set sv_mpForceArena 1 ; set ui_dmmap m5l2a ; popmenu 0"
}
resource
Button
{
name "sp5"
title "Mission 5-3"
rect 136 212 168 28
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set sv_mpForceArena 1 ; set ui_dmmap m5l3 ; popmenu 0"
}
resource
Label
{
name "hint"
title "Pick a campaign map, then Start Game."
rect 120 320 400 16
fgcolor 0.55 0.60 0.66 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
textalign xcenter
}
resource
Button
{
name "back"
rect 8 448 96 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "3D_BORDER"
shader "textures/mohmenu/back"
hovershader "textures/mohmenu/back_h"
clicksound "sound/menu/back.wav"
stuffcommand "Popmenu 0"
}

end.
