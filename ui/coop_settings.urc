resource
Button
{
	name "postfxBtn"
	title "POST-FX EFFECTS"
	// HZM 07-28 (user layout pass): moved to the Graphics board (ui/video options.urc);
	// parked off-screen here to avoid a duplicate entry point. Board = FIELD tab of the
	// Coop Options folder now; future tabs slot beside the foldertab label.
	rect -300 454 220 24
	fgcolor 0.90 0.85 0.69 1.00
	bgcolor 0.30 0.20 0.10 0.90
	borderstyle "3D_BORDER"
	font "facfont-20"
	clicksound "sound/menu/apply.wav"
	// snapshot the current post-FX cvars before opening so the menu's CANCEL can revert to here
	stuffcommand "writeconfig coop_fxsession ; pushmenu coop_postfx"
}
resource
Button
{
	name "closeBtn"
	title "CLOSE"
	rect 372 454 130 24
	fgcolor 0.90 0.85 0.69 1.00
	bgcolor 0.30 0.20 0.10 0.90
	borderstyle "3D_BORDER"
	font "facfont-20"
	clicksound "sound/menu/back.wav"
	stuffcommand "popmenu 0"
}
end.
