// HZM coop - COOP SETTINGS, styled as an open manila FOLDER with a printed settings sheet. Opened from the
// Options workbench by clicking the desk DOCUMENTS (ui/options_main.urc). Toggles bind directly to their
// cvars (live; archived = autosaved - no Apply button needed). NOTE: each resource field MUST be on its own
// line - the URC parser silently drops single-line resource blocks (that was the "empty menu" bug). Font is
// facfont-20 (the game's menu font) to match the rest of the UI.
menu "coop_settings" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

// Folder + paper drawn as solid colour fills (always render, regardless of the UI texture system). The
// manila folder sits behind a cream "printed sheet" that holds the toggles. (An earlier attempt used a
// shader/texture here, but raw-JPG shader refs don't resolve for menu Labels -> the panel went invisible
// = the "folder not there" report. Colour fills are reliable.)
resource
Label
{
	ordernumber 20
	name "folder"
	rect 96 66 448 404
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.58 0.47 0.29 1.00
	borderstyle "3D_BORDER"
}
resource
Label
{
	ordernumber 19
	name "foldertab"
	rect 110 54 150 16
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.64 0.53 0.33 1.00
	borderstyle "3D_BORDER"
}
resource
Label
{
	ordernumber 10
	name "paper"
	rect 112 80 416 378
	fgcolor 1.00 1.00 1.00 1.00
	bgcolor 0.90 0.86 0.74 1.00
	borderstyle "3D_BORDER"
}

resource
Label
{
	ordernumber 0
	name "title"
	title "COOP - FIELD SETTINGS"
	rect 112 90 416 24
	fgcolor 0.18 0.10 0.04 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "facfont-20"
}
resource
Label
{
	name "subtitle"
	title "checked = enabled"
	rect 132 120 360 18
	fgcolor 0.32 0.22 0.12 1.00
	bgcolor 0.00 0.00 0.00 0.00
	font "facfont-20"
	textalign left
}

