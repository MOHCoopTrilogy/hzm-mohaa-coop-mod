menu "multiplayerstart" 640 479 NONE 0
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
//vidmode 3
//fadein 0.5
//include "ui/common.inc"
virtualres 1
include "ui/serverback.inc"

//=====================================================================================================
// [HZM MP slice 9] SELECT GAME TYPE - a single readable LIST of every mode as its own button. COMPACTED
// (user 2026-09-17, screenshot: the new Domination/Countdown/Assassination row + the STANDARD block ran
// off the bottom of the wooden board). Row pitch tightened 30->28, master row 40->32, headers pulled up,
// so the whole grid now ends at y423 - inside the board interior - with BACK still at y456. HZM modes are
// a 3-column grid (x56 / x245 / x434, width 180, right edge 614); the stock modes stay 2-column
// (x56 / x328, width 256). MOH Coop Trilogy (HZM) is the MASTER row across the top.
//
// ISOLATION (this is a COOP-classified file - check_mp_isolation clause 7): the ONLY coop_mp* token a
// coop file may name is the literal "coop_mpmenu" (checker special-case). So each HZM mode button execs
// an MP-OWNED cfg under ui/coop_mpmenu/ (that path's only coop_mp* token IS "coop_mpmenu") - the cfg,
// not this file, sets coop_mpMode + the launch-gametype flag and pushes the shared setup menu. This file
// names no coop_mpMode / coop_mpsetup / coop_mpPreset token directly. Verified against the checker.
// A pure push per button (bug-461: never popmenu+pushmenu in one command).
//=====================================================================================================

/////////////////////////////////////SELECT-GAME-TYPE HEADER ART (wooden board banner, y 0..128)
resource
Label
{
name "Default"
rect 384 0 256 128
fgcolor 0.00 0.00 0.00 1.00
bgcolor 0.50 0.50 0.50 1.00
borderstyle "RAISED"
shader "selectgame_b"
}

resource
Label
{
name "Default"
rect 0 0 512 128
fgcolor 0.00 0.00 0.00 1.00
bgcolor 0.50 0.50 0.50 1.00
borderstyle "RAISED"
shader "selectgame_a"
}

resource
Label
{
name "Default"
rect 0 0 256 128
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/mohmenu/voodoo/selectgame_a"
enabledcvar "ui_voodoo"
}

resource
Label
{
name "Default"
rect 256 0 256 128
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
shader "textures/mohmenu/voodoo/selectgame_c"
enabledcvar "ui_voodoo"
}

/////////////////////////////////////MASTER: MOH COOP TRILOGY (HZM) (over all others)
//chrissstrahl - coop mod button. Prominent full-width master row.
resource
Button
{
	title "MOH Coop Trilogy (HZM)"
	name "coopmodstart"
	rect 56 128 528 32
	fgcolor 0.98 0.86 0.30 1.00
	bgcolor 0.50 0.50 0.50 0.10
	shader "textures/mohmenu/weapon_sign"
	hovershader "textures/mohmenu/m_buttonhighlight"
	clicksound "sound/menu/apply.wav"
	stuffcommand "set ui_dmmap nomap;pushmenu coop_start"
	font facfont-20
	textalign center
}

