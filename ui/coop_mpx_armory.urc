// HZM MP AXIS ARMORY - GENERATED by docs/tools/gen_mp_armory.py - DO NOT HAND-EDIT.
// Client-origin design: every pick execs a static cfg that archives the pick and appends one
// ,q name-bus marker.
// No vstr; names no coop armory cvar or tree (isolation clauses 12/13/18).
menu "coop_mpx_armory" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

