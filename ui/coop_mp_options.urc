// HZM MP side picker - replaces ui/multiplayeroptions.urc.
// menu "mpoptions" is pushed from ui/multiplayer.urc (Options button) and from dm_main (in-match ESC).
// Each side button seeds the defaults view and pushes the defaults armory screen.
menu "mpoptions" 640 479 NONE 0
bgcolor 1 1 1 1
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
include "ui/multiplayerback.inc"

resource
Label
{
name "bg_panel"
rect 168 130 304 220
fgcolor 0.84 0.82 0.76 1.00
bgcolor 0.05 0.06 0.08 1.00
borderstyle "RAISED"
}

resource
Label
{
name "caption"
title "SELECT SIDE"
rect 168 148 304 24
fgcolor 0.84 0.82 0.76 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "facfont-20"
textalign xcenter
}

resource
Button
{
name "allied"
title "ALLIED"
rect 208 200 96 28
fgcolor 0.90 0.84 0.66 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "facfont-20"
clicksound "sound/menu/apply.wav"
stuffcommand "exec ui/coop_mpa_armory/dopen.cfg"
}

resource
Button
{
name "axis"
title "AXIS"
rect 336 200 96 28
fgcolor 0.90 0.84 0.66 1.00
bgcolor 0.09 0.10 0.13 0.90
borderstyle "3D_BORDER"
font "facfont-20"
clicksound "sound/menu/apply.wav"
stuffcommand "exec ui/coop_mpx_armory/dopen.cfg"
}

resource
Button
{
name "mprecord"
title "MP SERVICE RECORD"
rect 208 234 224 22
fgcolor 0.90 0.84 0.66 1.00
bgcolor 0.14 0.10 0.06 0.94
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/apply.wav"
stuffcommand "set coop_mpSrP0 1;set coop_mpSrP1 0;set coop_mpSrP2 0;set coop_mpSrP3 0;set coop_mpSrP4 0;set coop_mpSrP5 0;pushmenu coop_mp_record"
}

resource
Label
{
name "hint"
title "Coop armory: F7"
rect 168 268 304 16
fgcolor 0.55 0.60 0.66 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
textalign xcenter
}

resource
Label
{
name "nameLabel"
title "Name"
rect 168 300 48 20
fgcolor 0.84 0.82 0.76 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
}

resource
Field
{
title "nameentry"
name "nameField"
rect 220 298 248 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "INDENT_BORDER"
clicksound "sound/menu/scroll.wav"
linkcvar "ui_name"
font facfont-20
textalign left
SetMaxChars 20
}

resource
Button
{
name "back"
rect 8 448 96 24
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "3D_BORDER"
shader "textures/mohmenu/back"
hovershader "textures/mohmenu/back_h"
clicksound "sound/menu/back.wav"
stuffcommand "Popmenu 1"
}

end.
