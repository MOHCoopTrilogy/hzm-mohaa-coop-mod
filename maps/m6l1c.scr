soldierwalk1:{
//============================================================================
	level.soldier1 exec global/walkto.scr $soldier1spot1
	level.soldier1 waittill movedone
	level.soldier1 exec global/turnto.scr level.soldier2
}end

//============================================================================
soldierwalk2:{
//============================================================================
	level.soldier2 exec global/walkto.scr $soldier2spot1
	level.soldier2 waittill movedone
	level.soldier2 exec global/turnto.scr level.soldier1
}end

//============================================================================
papers2pickup:{
//============================================================================
	$papers2 playsound pickup_papers
	$papers2 remove

	if(level.papers == 1){
		waitthread global/items.scr::remove_item "papers_level1"
	}
	waitthread global/items.scr::add_item "papers_level2"
}end

//============================================================================
guygo local.spot:{
//============================================================================
	self exec global/walkto.scr $(self + "spot" + local.spot)
}end

//============================================================================
sciencechatsequence:{
//============================================================================
//							local.talker    local.talker2     local.word      local.word2
//	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_SNT1 den_m6l1_SLD1
	level.scientist1 anim den_m6l1_SNT1
	level.soldier4 anim den_m6l1_SLD1

	$sciencechat waittill trigger
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_600f den_m6l1_SLD1
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_601q den_m6l1_SNT1
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_602f den_m6l1_SLD1
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_603f den_m6l1_SNT1
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_604q den_m6l1_SLD1
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_605f den_m6l1_SNT1
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_606q den_m6l1_SLD1
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_607f den_m6l1_SNT1
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_608q den_m6l1_SLD1
	
	//[user 08-08] bug-1579 - was a bare `.thinkstate` read on a maybe-NULL/dead actor. local.sldanim
	//records whether the anim was actually ISSUED, because the `waittill animdone` further down used
	//to re-test the condition instead of the fact: an actor that was attacking here and had calmed by
	//then passed the second test with no anim running, and waited for an animdone that never came.
	local.sldanim = 0
	if(level.soldier4 != NULL && isalive level.soldier4 && level.soldier4.thinkstate == idle){
		level.soldier4 anim den_m6l1_SLD2
		level.soldier4 anim den_m6l1_609f
		local.sldanim = 1
	}

	if(level.scientist1 != NULL && isalive level.scientist1 && level.scientist1.thinkstate != attack){	//[user 08-08] bug-1579 - NULL/dead read
		level.scientist1 anim den_m6l1_SNT1
	}

	if(local.sldanim == 1 && level.soldier4 != NULL && isalive level.soldier4){	//[user 08-08] bug-1579 - wait only on an anim we issued
		level.soldier4 waittill animdone
	}

	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_610q den_m6l1_SLD2
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_611f den_m6l1_SNT1
	waitthread sciencesayto level.scientist1 level.soldier4 den_m6l1_612q den_m6l1_SLD2
	level.soldier4 anim den_m6l1_SLD3
	
	waitthread sciencesayto level.soldier4 level.scientist1 den_m6l1_613f den_m6l1_SNT1
	level.soldier4 anim den_m6l1_SLD3
	wait 2

	level.soldier4 type_disguise "salute"
	level.scientist1 type_disguise "salute"
}end

//============================================================================
sciencesayto local.talker local.talker2 local.word local.word2:{
//============================================================================
	//[user 08-08] bug-1579 conversation-guard sweep - THE worst line in this map. The tail
	//`waittill animdone` sat OUTSIDE both guards: when the talker was dead, removed or alerted no anim
	//was ever started, so nothing could ever fire animdone and the WHOLE sciencechatsequence stranded
	//here - taking its tail with it (type_disguise "salute" at :515-516 is what hands both actors back).
	//Only ever wait on an actor we actually animated. NULL is tested first and separately because
	//isalive on NULL throws, and a thrown statement is skipped - taking the guard with it.
	//"not attacking" is not "idle": a CURIOUS actor runs its own think and overrides the scripted anim.
	local.said = 0
	local.said2 = 0
	if(local.talker != NULL && (isalive local.talker) && local.talker.thinkstate == idle){
		local.talker anim local.word
		local.said = 1
	}

	if(local.talker2 != NULL && (isalive local.talker2) && local.talker2.thinkstate == idle){
		local.talker2 anim local.word2
		local.said2 = 1
	}
	if(local.said == 1){
		local.talker waittill animdone
	}
	else{
		//keep the pacing when only the second actor spoke, instead of returning in the same frame
		if(local.said2 == 1){ local.talker2 waittill animdone }
	}
}end	

//============================================================================
soldierchatsequence:{
//============================================================================
	$soldierchat waittill trigger
	waitthread global/objectives.scr::add_objectives 1 3 "Infiltrate the base (Loud or Disguised)." level.coop_m6Door
	//inside the base: objectives 2 and 3 are parallel, so both are revealed together.
	waitthread global/objectives.scr::add_objectives 2 2 "Steal blueprints for StG44." $blueprints.origin
	waitthread global/objectives.scr::add_objectives 3 2 "Steal an StG44." $weapon.origin
	waitthread global/objectives.scr::current_objectives 2

	level.soldier1.type_disguise = "none"
	level.soldier2.type_disguise = "none"

	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_614r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_615b" 
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_616r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_617b"
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_618r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_619b"
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_620r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_621b"
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_622r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_623b"
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_624r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_625b"  
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_626r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_627b"
	waitthread soldiersayto level.soldier1 level.soldier2 $soldier2spot1 "den_m6l1_628r"
	waitthread soldiersayto level.soldier2 level.soldier1 $soldier1spot1 "den_m6l1_629b"
	wait 2

	level.soldier1.type_disguise = "salute"
	level.soldier2.type_disguise = "salute"
	wait 2
}end

//============================================================================
soldiersayto local.talker local.listener local.spot local.word:{
//============================================================================
	//[user 08-08] bug-1579 conversation-guard sweep. Two faults: (a) isalive was called on an entity
	//that may be NULL (a removed actor) - that statement THROWS and a thrown statement is SKIPPED, so
	//the guard vanishes and the say + `waittill saydone` below run anyway; (b) "not attacking" is not
	//the same as "idle" - a CURIOUS/GRENADE/PAIN actor runs its own think, which overrides the scripted
	//idle line, and the saydone may then never arrive. thinkstate stays "idle" for the whole scripted
	//say (SetThinkIdle, actor.cpp:10819), so gating on idle does not silence a normal exchange.
	//Silence the LINE, never the thread: the listener walkto below is this helper's release and still runs.
	if(local.talker != NULL && (isalive local.talker) && local.talker.thinkstate == idle){
		//local.talker idlesay local.word 										//[200] Smithy
		local.talker thread coop_mod/replace.scr::say_wait local.word "idle" 	//[200] Smithy - coop compatible
		local.talker waittill saydone
	}
	//was `if(local.listener)` - a truthiness test, not a liveness test (bug-1579)
	if(local.listener != NULL && isalive local.listener){
		local.listener exec global/walkto.scr local.spot
	}
}end	

//============================================================================
setusupthebomb:{
//============================================================================
	$explosiveplacementplaced hide
	$explosiveplacement show
	
	bombdeny:
	wait 1
	$setusupthebomb waittill trigger
	if(level.obj2complete != 1){
		iprintlnbold "You have not completed the objective."
		goto bombdeny
	}
	
	$explosiveplacementplaced playsound plantbomb
	//$player loopsound bombtick					// Criminal
	exec coop_mod/replace.scr::loopsound bombtick	// Criminal - coop compabitility
 	$explosiveplacementplaced show
	$explosiveplacement hide

	iprintlnbold "5 seconds to clear the room"
	//$player stopwatch 5					// Criminal
	exec coop_mod/replace.scr::stopwatch 5	// Criminal - coop compabitility
	wait 5

	waitthread global/objectives.scr::add_objectives 4 3 "Destroy the weapons stockpile." $obj2.origin
	//stockpile down - the way out becomes the objective.
	waitthread global/objectives.scr::add_objectives 5 2 "Exfiltrate the base." $endmissiontrig.origin
	waitthread global/objectives.scr::current_objectives 5

	if (level.thebombhasexploded != 1){
		thread blowstuffup
	}
}end

//============================================================================
blowstuffup:{
//============================================================================
	//[user 2026-08-11] CHALLENGE: The Storm Rises - sample the stealth state HERE, before the
	//escape below raises the alarm itself. Sampling any later would always read 'blown'.
	thread coop_mod/challenges.scr::chal_storm_snapshot
	thread healthsave
	//[user 2026-08-11] "Feels weak after you blow up the StG44 - should be a fight to the death
	//to escape." This is why: removeguysforescape deletes every ai_alarm actor except soldier4 and
	//scientist1, so the escape was quiet BY DESIGN. Skipping it leaves the existing cast alive and
	//in position - no new spawns needed for the fight to have teeth, and they are already placed
	//by the level designer rather than by us guessing.
	//coop_escapeCull 1 restores the vanilla cull if this turns out to be too much.
	if( getcvar "coop_escapeCull" == "1" ){ thread removeguysforescape }
	level.thebombhasexploded = 1
	thread global/exploder.scr::explode 1
	thread removeguns 

	//$player stoploopsound 					// Criminal 
	exec coop_mod/replace.scr::stoploopsound 	// Criminal - coop compabitility.

	$explosiveplacementplaced hide
	$explosiveplacementplaced playsound m6l1c_stock_explode
	
	//chrissstrahl - reduce the number or error messages we get while debugging this script
	if(level.scientist1 != NULL){ level.scientist1 attackplayer }
	if(level.soldier4 != NULL){ level.soldier4 attackplayer }

	//	centerprint ("player is in bombroom " + level.playerisinbombroom)
	if(level.gametype == 0){ //chrissstrahl - do in sp only
		if(level.playerisinbombroom == 1){
			radiusdamage $player.origin 2000 800 
		}
	}
	//chrissstrahl - multi player - kill players which are inside the room (radius)
	else{
		//radiusdamage (4790 2777 -550) (level.coop_health * 2) 580 //chrissstrahl
		radiusdamage (4790 2777 -550) (level.coop_health * 2) 680
	}

	//[user 2026-08-11] AFTER the blast has actually landed - the radiusdamage above kills anyone
	//inside 680u, so the squad is moved in only once it has been dealt. Four user-picked spots in
	//the room; a fifth+ player cycles back through them.
	thread coop_escapeRegroup
}end

//============================================================================
coop_escapeRegroup:{
//============================================================================
	waitframe
	level.coop_escapeSpot[1] = ( 5149 2905 -542 )
	level.coop_escapeSpot[2] = ( 4694 2543 -537 )
	level.coop_escapeSpot[3] = ( 4470 2876 -537 )
	level.coop_escapeSpot[4] = ( 4520 2502 -540 )
	level.coop_escapeAng[1] = 116
	level.coop_escapeAng[2] = 65
	level.coop_escapeAng[3] = 33
	level.coop_escapeAng[4] = 39

	local.n = 0
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		if( !isAlive local.p ){ continue }
		local.n++
		local.slot = local.n
		while( local.slot > 4 ){ local.slot = local.slot - 4 }
		//playersWarpto puts the WHOLE squad on ONE point, and these are four separate spots, so its
		//body is reproduced rather than the wrapper called (main.scr:636-655). The +1z then
		//droptofloor is its trick for not landing inside geometry, and playerMakeSolidAsap is what
		//keeps players from being stuck inside one another when several land at once.
		local.p origin ( level.coop_escapeSpot[local.slot] + ( 0 0 1 ) )
		local.p droptofloor
		local.p thread coop_mod/main.scr::playerFace ( 0 level.coop_escapeAng[local.slot] 0 )
		thread coop_mod/main.scr::playerMakeSolidAsap local.i
	}

	//[user 2026-08-11] the base knows. Raising the alarm here does three things at once: every
	//disguise dies at the engine level (player.cpp:5522 gates on !level.m_bAlarm), coop_armOnBlown
	//hands weapons back, and every actor left alive is free to engage. Guarded because the master
	//alarm thread is a TOGGLE - triggering it while the alarm is already up would switch it OFF
	//(global/alarm_system.scr:688), which is the opposite of what this wants.
	if( level.alarm != 1 ){
		if( $waittrigger_alarm_master != NULL ){ trigger $waittrigger_alarm_master }
		else{ waitthread coop_mod/itemhandler.scr::takeAllDisguises }
	}
	//[user 2026-08-11] THE ALARM ALONE DOES NOT HUNT YOU.
	thread coop_escapeHunt
	//[user 2026-08-11] "teleported me but I have papers stuck on my gun". coop_armOnBlown already
	//fights this - itemhandler.scr:1646 documents the same symptom and uses spawnWeaponAssert to
	//beat the papers still being the in-hand item. But that assert only covers ~5 frames plus one
	//late check at 0.8s, and this label teleports every player inside exactly that window, so the
	//raise loses. Re-assert once the dust has settled and nothing else is moving anybody.
	thread coop_escapeFixHands
	println( "^~^~^ ESCAPE regrouped " + local.n + " player(s), alarm=" + level.alarm )

	thread global/exploder.scr::explode 2
	waitthread alarmall2

	for(local.i = 1; local.i <= $alarm_switch_trigger.size; local.i++){
		$alarm_switch_trigger[local.i] thread switchesnottriggerable
	}

	thread exfiltrate
	wait 1
	if(level.gametype==0){//Criminal - Singleplayer.
		exec global/autosave.scr 1
	}
}end

//============================================================================
switchesnottriggerable:{
//============================================================================
	while(1){
		waitframe
		self waittill trigger
		//self nottriggerable
		wait 3

		if(level.gametype==0){ //Criminal - Singleplayer.
     		if(level.alarm != 1){
        	  	$alarm_switch_trigger[1] douse $player
        	  }
		}else{ //Criminal - Multiplayer.
			for (local.i = 1; local.i <= $player.size; local.i++) {
				local.player = $player[local.i]
				if(local.player != NULL && local.player.dmteam != "spectator" &&
				   local.player.health > 0 && level.alarm!= 1){
					$alarm_switch_trigger[1] douse local.player
					break //chrissstrahl - exit the for loop, or we will have another player activating the switch again
				}
			}
		}
	}
}end

