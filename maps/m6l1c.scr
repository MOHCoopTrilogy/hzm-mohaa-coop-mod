	// blueprint  aerialphoto3.tik
	thread coop_mod/collectible.scr::coop_bp_place ( 4664.766 4669.895 -631.875 ) ( 0 60 0 ) "models/animate/aerialphoto3.tik" 1.0
	// blueprint  naxosplans1.tik
	thread coop_mod/collectible.scr::coop_bp_place ( 3148.110 751.107 0.125 ) ( 0 60 0 ) "models/items/naxosplans1.tik" 1.0
