		wait .25
	}
	$frontturret thread global/mg42_active.scr::enable
}end

//============================================================================
alarmthread:{
//============================================================================
	println "***********"
	println self " has bad alarmthread"
	println "*************"
}end

//============================================================================
snowmitter:{
//============================================================================
	for (local.i = 1; local.i <= $snowmitter.size; local.i++){
		$snowmitter[local.i] anim start
	}
}end

//============================================================================
unholsterthread:{
//============================================================================
//for people who are holstered and get alarmed	
	self unholster
	//exec global/runto.scr $player 		// Criminal.
	exec coop_mod/replace.scr::runtoClosest // Criminal - coop compabitility.
}end

//============================================================================
endmission:{
//============================================================================
	$endmissiontrig waittill trigger
	//[user 2026-08-11] CHALLENGE: The Storm Rises pays out at the exfil, since the mission has to
	//be completed and not merely survived. waitthread so the bump lands before missioncomplete
	//tears the level down.
	waitthread coop_mod/challenges.scr::chal_storm_done
	waitthread global/objectives.scr::add_objectives 5 3 "Exfiltrate the base." $endmissiontrig.origin
	setcvar "g_m6l1" "1"
	exec global/missioncomplete.scr m6l2a 1
}end

//============================================================================
giveobjectives:{
//============================================================================
	//[user 2026-08-11] PROGRESSIVE OBJECTIVES. This map registered all five at status 2
	//(in progress) at load, so the whole mission plan was on screen before the first door and
	//nothing ever announced itself. Status 1 is the registered-but-hidden state every other
	//map uses at load (global/objectives.scr:40; m1l1 registers 16 hidden against 6 active) -
	//re-adding at status 2 later is what fires the New Objective toast, keyed per index so a
	//repeat call updates quietly instead of re-announcing. Only objective 1 starts visible.
	waitthread global/objectives.scr::add_objectives 1 2 "Infiltrate the base (Loud or Disguised)." level.coop_m6Door
	waitthread global/objectives.scr::add_objectives 2 1 "Steal blueprints for StG44." $blueprints.origin
	waitthread global/objectives.scr::add_objectives 3 1 "Steal an StG44." $weapon.origin
	waitthread global/objectives.scr::add_objectives 4 1 "Destroy the weapons stockpile." $obj2.origin
	waitthread global/objectives.scr::add_objectives 5 1 "Exfiltrate the base." $endmissiontrig.origin
	waitthread global/objectives.scr::current_objectives 1
}end

//============================================================================
suitpickup:{
//============================================================================
 //triggered by setthread
	//$player stufftext "tmstartloop sound/music/mus_schmerzen_01a.mp3"			// Criminal.
	exec coop_mod/replace.scr::tmstartloop "sound/music/mus_schmerzen_01a.mp3"	// Criminal.

	//[user 2026-08-11] INTERIOR UNIFORM REMOVED - the truck cache is now the single source of
	//the disguise. Granting it twice let a player hold two uniforms and re-entered the whole
	//giveUniformToAll -> giveDisguiseToAll path while already disguised and already armed,
	//which is the exact shape of bug-1701. One source, one grant, one code path.
	//The scene below (soldierwalk1/2) is retail and unrelated, so it stays.
	$suit playsound pickup_uniform
	$suit remove
	
	//[200] chrissstrahl - lets see if it works in mp as well
	//exec coop_mod/replace.scr::has_disguise 1 [200] Smithy - not needed now

	thread soldierwalk1
	thread soldierwalk2
}end

