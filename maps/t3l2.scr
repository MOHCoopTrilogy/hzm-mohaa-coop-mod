	local.guy anim tanktrip
	
     
	local.guy waittill animdone
	local.runspot = $(local.tripspot.target)
	local.runspot droptofloor
	local.guy exec global/runto.scr local.runspot
end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// OBJECTIVES <begin>
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// initialize the objective list
// - NOTE: there may not be a 1-to-1 correlation between objective thread names and objective numbers
// - Here is the correlation map:
//
//   Objective #:	runs thread:
//		1			objective1
//		2			objective2
//		3			objective3
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
initobjectives:

	waitthread global/objectives.scr::add_objectives 1 1 "Destroy the South Bridge" $beacon_bridge.origin
	waitthread global/objectives.scr::add_objectives 2 2 "Return to the Soviet Recon Group" $beacon_soviets.origin
	waitthread global/objectives.scr::add_objectives 3 1 "Defend the Bridge Until Air Support Arrives"

	// set initial objective
	waitthread global/objectives.scr::current_objectives 2

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// modify objectives to reflect new status
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
modifyobjective1:

	// enable objective
	waitthread global/objectives.scr::add_objectives 1 2
	waitthread global/objectives.scr::current_objectives 1

	level.bridge_ready = 1

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 1 completion
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective1:

	waitthread global/objectives.scr::add_objectives 1 3
	waitthread global/objectives.scr::current_objectives 2
	thread objective2

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 2 completion
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective2:
	$objective2trigger waittill trigger
	$cheaterkiller triggerable
	thread spawnerleaderinit
	thread captainmonroe_say3
	thread T34friends

	waitthread global/objectives.scr::add_objectives 2 3
	waitthread global/objectives.scr::add_objectives 3 2
	waitthread global/objectives.scr::current_objectives 3

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// modify objectives to reflect new status
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
modifyobjective3:

	waitthread global/objectives.scr::add_objectives 3 3
	// MJG: don't cue end of level based on this timing scheme
//	wait 26
//	thread endleveltrigger

end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// OBJECTIVES <end>
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


//----------------------------------------------------------------------
bridgecollapsetrigger:
//
// modified exploder trigger for bridge collapse
//
//----------------------------------------------------------------------

	//HZM coop - the SP check only let the host's tank shell (parm.owner == $player)
	//collapse the bridge. parm.owner is the projectile owner, so in coop accept the
	//shell from the tank itself, from the current tank driver (level.coop_playerTank),
	//or from ANY active allied player. validateTriggerActivator checks parm.other (the
	//toucher), not parm.owner, so we validate the owner explicitly here.
	local.bridgeReady = 0
	if( level.bridge_ready == 1 ){
		local.bridgeReady = 1
	}

	local.validOwner = 0
	if( level.gametype == 0 ){
		if( parm.owner == $player ){ local.validOwner = 1 }
	}else{
		local.owner = parm.owner
		if( local.owner != NULL ){
			if( local.owner == $playertank ){ local.validOwner = 1 }
			if( level.coop_playerTank != NULL && local.owner == level.coop_playerTank ){ local.validOwner = 1 }
			for( local.i = 1; local.i <= $player.size; local.i++ ){
				local.pl = $player[local.i]
				if( local.pl != NULL && local.owner == local.pl && local.pl.dmteam != "spectator" ){
					local.validOwner = 1
				}
			}
		}
	}

	if ( local.validOwner == 1 && local.bridgeReady == 1)
	{
		local.set = self.set
		self remove
		wait 0.25
		thread global/exploder.scr::explode local.set
		wait 0.25
		thread bridgefloorcollapse
		wait 3.0
		thread objective1
	}

end


//----------------------------------------------------------------------
drive_path local.path local.speed local.remove:
//----------------------------------------------------------------------
// drive Vector position, speed, acceleration, reach_distance, look_ahead
//println "z:              " local.path
//println "z:              " local.speed
self.driving = 1
self drive local.path local.speed 30 200 level.lookahead
//self modifydrive level.fastspeed 50 level.lookahead
self waitTill drive
if (self)
{
	self stop
	self.driving = 0
	if (local.remove == "remove")
		self remove
}
end

//----------------------------------------------------------------------
//HZM coop - optional auto-drive fallback for the player T-34.
//If no human boards within a grace window, the tank drives itself along its
//path so objectives can still advance. The moment a human takes the driver
//slot (coop_setDriverForTank sets level.coop_playerTank to that player),
//this thread yields control. We only ever auto-drive while the tank itself
//is still the registered driver (level.coop_playerTank == $playertank).
//----------------------------------------------------------------------
coop_autoDriveTankFallback:
	if( level.gametype == 0 ){ end }

	//grace period: let a player walk up and press USE to board first.
	//coop_selectDriverForTank uses level.coop_playerTank == NULL to mean "free";
	//when a human boards it becomes that player, so a non-NULL value means a driver
	//is present and we must NOT auto-drive.
	local.waited = 0
	while( local.waited < 20 ){
		if( level.coop_playerTank != NULL ){ end }
		wait 1
		local.waited += 1
	}

	//still nobody driving -> claim the tank for itself so the boarding loop stops
	//offering it (it would fight the scripted drive), set it as the activator so the
	//bridge validator accepts the tank's own shells, then auto-drive the path.
	if( level.coop_playerTank != NULL ){ end }

	level.coop_playerTank = $playertank
	println "coop_autoDriveTankFallback: no human driver, auto-driving T-34"
	$playertank thread drive_path $playertank_trigger level.slowspeed
end

get_random_entry local.entries:
	local.n = randomint (local.entries.size)
	//println "XXX:" local.n
	local.entry = 0
get_random_entry_loop:
	local.result = local.entries[local.entry]
	if (local.result == NIL)
	{
		local.entry++
		goto get_random_entry_loop
	}
	if (local.n)
	{
		local.n--
		local.entry++
		goto get_random_entry_loop
	}
	
	println "result: " local.result

local.entries[local.entry] = NIL
end local.result

