	thread truckpush "right"
end

//----------------------------------------------------------------------
truckpush local.side:
//----------------------------------------------------------------------
	if(level.truckpushed != 1)
	{
		level.truckpushed = 1
		if(local.side == "left")
		{
			$truck followpath $truckrotateleft
			exec coop_mod/replace.scr::playsound king_vehicle_crash	// HZM coop - broadcast to all players
		}
		if(local.side == "right")
		{
			$truck followpath $truckrotateright
			exec coop_mod/replace.scr::playsound king_vehicle_crash	// HZM coop - broadcast to all players
		}
		$truck waitmove
	}
end

