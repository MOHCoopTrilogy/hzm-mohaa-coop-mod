//==========================================================================================================//
// LEVEL:       co_lobby7.bsp   (a copy of m2l2c.bsp)
// TITLE:       HZM Coop - Post-Mission Lobby #7 (m2l2 U-boat pens staging area)
// FLOW:        ... m2l2b  ->  co_lobby7  ->  m2l2c
// NOTE:        m2l2c's own mission script (objectives, scripted spawns, enemy actors) is NOT run here -
//              co_lobby7.scr only keeps the world geometry, then hands off to the shared coop_mod/lobby.scr.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby7.scr"
	level.coop_aaMap = 1							// AA-side level
	level.coop_lobbyMap = 1							// marks this as a lobby (gates mission behaviors)

	// --- per-lobby framing for the SHARED lobby framework (coop_mod/lobby.scr reads these) ---
	// captured viewpos (EYE height) in m2l2c: 4 player anchors, the static camera, and the next map.
	// yaws normalized to positive (recorded -2/-3/-148 -> 358/357/212) to avoid the bare-negative parse rule.
	level.coop_lobbySlotOrg[1] = ( 2717 -2750 -545 )
	level.coop_lobbySlotYaw[1] = 358
	level.coop_lobbySlotOrg[2] = ( 2728 -2550 -545 )
	level.coop_lobbySlotYaw[2] = 357
	level.coop_lobbySlotOrg[3] = ( 2736 -2403 -545 )
	level.coop_lobbySlotYaw[3] = 357
	level.coop_lobbySlotOrg[4] = ( 2746 -2206 -545 )
	level.coop_lobbySlotYaw[4] = 357
	level.coop_lobbyCamOrg = ( 3088 -2220 -539 )
	level.coop_lobbyCamYaw = 212
	level.coop_lobbyNextMap = "m2l2c"				// completing this lobby launches m2l2c
	level.coop_lobbySkipProps = 1					// bare staging area - no training props (add baked scene later via build mode)

	waitthread coop_mod/main.scr::main				// MUST be first
	level.coop_weatherTheme = "none"				// no dynamic precip in the lobby

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain			// camera, auto-spawn, roster, ready, skins, music, launch
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end
