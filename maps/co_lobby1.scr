//==========================================================================================================//
// LEVEL:       co_lobby1.bsp   (a copy of training.bsp)
// TITLE:       HZM Coop - Pre-Mission Lobby #1 (staging area)
// NOTE:        The vanilla training range / radio-instruction scripts are intentionally NOT run here.
//              This map only keeps the world + ambience, then hands off to coop_mod/lobby.scr.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby1.scr"
	level.coop_aaMap = 1							// AA-side level (Frontline briefing1 -> m1l1)
	level.coop_lobbyMap = 1							// marks this as a lobby (gates mission behaviors)
	// NOTE: do NOT disable the spawn warper here - it is what warps players onto the
	// coop_spawn1-4origin slot points defined in spawnlocations.scr::co_lobby1 (bug-355..359 chain).
	waitthread coop_mod/main.scr::main				// MUST be first, no waits before this
	level.coop_weatherTheme = "none"				// no dynamic precip in the lobby

	// lock every player to the static camera the instant they spawn / respawn (dispatched to the
	// labels below by main.scr::startMapCallback). This is the reliable moment - a poll races the spawn.
	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn

	drawhud 0										// hide the compass + gameplay HUD over the cinematic camera
	exec global/ambient.scr training				// KEEP the original training ambience beds

	// props, static camera, auto-spawn, ready-up, skins, music and launch all live in the lobby module
	thread coop_mod/lobby.scr::lobbyMapMain
}end

//=========================================================================
// Per-(re)spawn callbacks - hand the freshly spawned player to the lobby so it can seat them on the
// camera and lock them. parm.other is the player (main.scr::startMapCallback passes it that way).
//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end
