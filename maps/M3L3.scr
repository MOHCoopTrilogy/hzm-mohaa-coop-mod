		if ((level.scene6_mgspawn3_currentalive + 1) <= level.scene6_mgspawn3_currentalivemax && level.scene6_mgspawn3_deactivator == 0 && level.scene6_mgspawn3_teamvalue < level.scene6_mgspawn3_teamlimitmax){
