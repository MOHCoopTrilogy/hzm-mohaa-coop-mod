$world farplane 13000
$world farplane_color (.03 .05 .07)
$world farplane_bias 500

	level.script = "maps/t3l1.scr"
	level.music  = "t3l1"

	exec global/auto.scr

	waitthread coop_mod/main.scr::main         //HZM coop - start coop mod extensions (first frame, before prespawn)
	level.coop_weatherTheme = "rain"		//HZM coop - dynamic weather: Berlin spring 1945 (map bakes rain)
	//[207] opt-in to per-map optional callbacks (guarded dispatch)
	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustLeft"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1
	level.coop_disableSpawnWarper = game.true		//[207] chrissstrahl - disable respawn warper

level waittill prespawn

	level.rain_width = "0.4"
	level.rain_min_dist = 512
	level.rain_density = 5
	level.startedrainsound2 = 1

	level.enemytruckspeed = 175
	level.lookahead = 256
	level.playertanktarget = 0 // HZM coop - 0 makes enemy-tank think-loops wait; set to a live player after spawn via coop_trackTankTarget (was: $player array would break .origin/.centroid)
	level.aipronechance = 0
	
	level.fastspeed = 300
	level.slowspeed = 160

	level.raindensity = game.raindensity
	level.rainvolume = game.rainvolume
	level.thundertime = game.thundertime
	setcvar "cg_rain_slant" (local.raindensity)
	setcvar "cg_rain_density" (level.raindensity)

	// lock down player
	// HZM coop - removed singular $player.angles/.origin capture (array at prespawn; intro no longer repositions a single host)
	//*** fade out
	fadeout .001 0 0 0 1

	// Turn off the hud.
	drawhud 0

//level waittill spawn - HZM coop
waitthread coop_mod/replace.scr::waitForPlayer // HZM coop - coop-safe spawn gate


	// HZM coop - Soviet loadout to ALL players via replace.scr shims (was singular $player ...)
	exec coop_mod/replace.scr::takeAll

	exec coop_mod/replace.scr::item weapons/Nagant_revolver.tik
	exec coop_mod/replace.scr::item weapons/Mosin_Nagant_Rifle.tik
	exec coop_mod/replace.scr::item weapons/ppsh_smg.tik
	exec coop_mod/replace.scr::item weapons/svt_rifle.tik
	exec coop_mod/replace.scr::item weapons/Russian_F1_grenade.tik
	exec coop_mod/replace.scr::item weapons/RDG-1_Smoke_grenade.tik

	exec coop_mod/replace.scr::ammo pistol 28
	exec coop_mod/replace.scr::ammo smg 225
	exec coop_mod/replace.scr::ammo rifle 80
	exec coop_mod/replace.scr::ammo smokegrenade 3
	exec coop_mod/replace.scr::ammo grenade 3


	setcvar g_mission 3
	exec coop_mod/replace.scr::fullheal // HZM coop - heal all players (SP-only in shim; coop spawns full health)

	// HZM coop - keep the enemy-tank aim target pointed at a live player
	thread coop_trackTankTarget

//	exec gags/t3l1_fourrussians.scr
//	exec global/pocketlight.scr::PocketLightsInit


	//////////////////////
	// Stickybomb setup
	//////////////////////

//	waitthread global/items.scr::add_item "stickybomb" noprint // Show stickybomb inventory icon
	level.stickybombs = 2
	
//	thread sky_smoke
	$rubblesmoke anim start
	$new_fire anim stop
	$new_fire_1 anim stop

	$s10_truck hide
	$s10_truck notsolid
	$s10_truck immune bash
