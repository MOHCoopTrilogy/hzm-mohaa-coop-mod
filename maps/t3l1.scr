	$startingsoldier1 gun "ppsh"
	$startingsoldier2 gun "nagant rifle"
	$startingsoldier3 gun "nagant rifle"
	$startingsoldier4 gun "ppsh"
	$startingsolidier6 gun "nagant rifle"
	$startingsolidier7 gun "nagant rifle"

	// [user 2026-08-02] "give the other 4 russians a bit more HP at the beginning so they dont die
	// so easily". These four are the recon team that walks and talks you through the opening; losing
	// one early costs dialogue and makes the sequence read as broken. They sit on the authored 100 hp
	// because the soviet-ally exemption (aihandler.scr::initialisePainVars) keeps allies OFF the coop
	// damage buffer - correct, but it also means they are as fragile as a stock SP actor while facing
	// coop-scaled opposition. 250 makes them meaningfully tougher without making them invulnerable.
	// Deliberately NOT applied to solidier6/7: those two are scripted to die to the mortar (bug-1282).
	$startingsoldier1.health = 250
	$startingsoldier2.health = 250
	$startingsoldier3.health = 250
	$startingsoldier4.health = 250

//-------------------------------------------------------------------

/////	self waitthread global/vehicles_thinkers.scr::truck_INIT

	// put the T-34 tank guard soldiers into a level array
	level.tankguard[1] = waitthread global/spawner.scr::spawner_create $tankguard1[1]
	level.tankguard[2] = waitthread global/spawner.scr::spawner_create $tankguard2[1]
	level.tankguard[3] = waitthread global/spawner.scr::spawner_create $tankguard3[1]

	exec gags/t3l1_germantankguys.scr

	// initialize the enemyspawner gag thread
	exec gags/t3l1_enemyspawn.scr

	exec gags/t3l1_soldiers_balcony.scr



	// SAFE initialize safe variables
	level.safe = $safe
	level.safestate = 0
	// turn off the trigger outside door in which safe is located
	$explodertrigger nottriggerable
	// make the safe solid
	level.safe solid

	thread intro_fade_in

	// Awkward script to make sure the player's weapon is holstered.

//	$player physics_on
//	wait 0.75
//	$player safeholster 1



end

MakeImmune:
	self immune bullet
	self immune fast_bullet
	self immune grenade
//	self immune explosion
//	self immune rocket
	end



//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// Intro to level
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
intro_fade_in:

	// Start the four russian recon team members talking.
//	exec gags/t3l1_fourrussians.scr::russian_startdialog
	thread gags/t3l1_fourrussians.scr::DoRussians

	// HZM coop - per-player intro freeze (was global freezeplayer + singular $player physics_off/viewangles/origin)
	waitthread coop_introFreeze "0 0 0"

 	wait 0.75

	showmenu t3l1_1
	hidemouse

	wait 1.5
	showmenu t3l1_2
	hidemouse

	wait 2.25
	showmenu t3l1_3
	hidemouse

	wait 3

	fadein 3.5 0 0 0 1
	exec coop_mod/replace.scr::viewangles "0 -90 0" // HZM coop - face all players (was: $player.viewangles)

	wait 2
	hidemenu t3l1_1
	hidemenu t3l1_2
	hidemenu t3l1_3
	hidemouse

	wait 1
	// [user 2026-08-02] bug-1289 - "you should be frozen until that open truck gets destroyed".
	// The title cards finish 10.5s in, but the Opel truck is not hit until later, so the authored
	// release handed control back mid-scene. Hold the lock until the blast instead. Safe to wait
	// on: DoSanta is entirely time-driven (aim -> wait 1.0 -> shoot), so it never depends on the
	// player doing anything, and the guard below caps the wait regardless.
	waitthread coop_introWaitTruck

	// HZM coop - per-player release (was global releaseplayer + singular viewangles)
	waitthread coop_introRelease "0 -90 0"



end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// HZM coop - per-player intro freeze helpers (replace global freezeplayer/cuecamera)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
coop_introFreeze local.ang:
	exec coop_mod/replace.scr::physics_off
	if ( local.ang != NIL )
		exec coop_mod/replace.scr::viewangles local.ang
	for ( local.i = 1; local.i <= $player.size; local.i++ )
	{
		local.player = $player[local.i]
		if ( local.player.dmteam != "spectator" )
			local.player freezecontrols 1
	}
	// [2026-08-02] bug-1286 - a ONE-SHOT freezecontrols does not hold in coop. The probe that
	// preceded this reported players=1 froze=1, i.e. the freeze WAS applied and the player could
	// still walk: the engine's m_bFrozen is cleared again by the coop spawn/respawn churn that runs
	// right after the intro starts. This is known and already solved twice in this mod the same way -
	// coop_mod/lobby.scr::lobbyLockWatch and the xp.scr debrief both re-assert the lock on a loop -
	// so copy that recipe rather than invent one. The watchdog also covers a player who finishes
	// spawning AFTER this ran, which the plain loop above cannot.
	level.coop_introLock = 1
	thread coop_introLockWatch
	println "^~^~^ INTROLOCK on at t="
	println level.time
end

//=========================================================================
// Hold the intro until the Opel truck is destroyed (bug-1289). The flag is set by
// gags/t3l1_enemyspawn.scr::JeepExplosion once the explosion model is up.
// The 60s guard is a deliberate safety net, NOT an expected path: if the gag ever fails to
// fire, the player must still get control back rather than be frozen for the whole map.
//=========================================================================
coop_introWaitTruck:
	local.guard = 0
	while ( level.coop_introTruckBlown != 1 && local.guard < 600 )
	{
		local.guard = local.guard + 1
		wait 0.1
	}
	println "^~^~^ INTROLOCK truck-wait ended, blown="
	if ( level.coop_introTruckBlown != NIL )
		println level.coop_introTruckBlown
	println "^~^~^ INTROLOCK truck-wait ticks="
	println local.guard
end

//=========================================================================
// Re-assert the intro movement lock every frame until coop_introRelease clears it (bug-1286).
//=========================================================================
coop_introLockWatch:
	local.beat = 0
	while ( level.coop_introLock == 1 )
	{
		for ( local.i = 1; local.i <= $player.size; local.i++ )
		{
			local.player = $player[local.i]
			if ( local.player != NULL && local.player.dmteam != "spectator" )
				local.player freezecontrols 1
		}
		// heartbeat roughly once a second so the log shows whether this loop is alive at the
		// moment the player reports being able to walk (safe probe: separate single-value printlns)
		local.beat = local.beat + 1
		if ( local.beat >= 20 )
		{
			local.beat = 0
			println "^~^~^ INTROLOCK alive t="
			println level.time
		}
		waitframe
	}
	println "^~^~^ INTROLOCK loop exited at t="
	println level.time
end

coop_introRelease local.ang:
	// [2026-08-02] bug-1286 - clear the lock FIRST. The watchdog re-asserts freezecontrols 1 every
	// frame, so unfreezing while it still runs would just be undone on the next frame.
	level.coop_introLock = 0
	println "^~^~^ INTROLOCK released at t="
	println level.time
	waitframe

	for ( local.i = 1; local.i <= $player.size; local.i++ )
	{
		local.player = $player[local.i]
		if ( local.player.dmteam != "spectator" )
			local.player freezecontrols 0
	}
	exec coop_mod/replace.scr::physics_on
	if ( local.ang != NIL )
		exec coop_mod/replace.scr::viewangles local.ang
end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// HZM coop - keep enemy-tank aim target on a live player (replaces SP level.playertanktarget = $player)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
coop_trackTankTarget:
	while ( 1 )
	{
		local.p = exec coop_mod/replace.scr::player_anyValid
		if ( local.p != NULL && local.p != NIL )
			level.playertanktarget = local.p
		else
			// HZM coop [user 08-02]: clear to the 0 sentinel when no player is valid.
			// Without this else the var kept a STALE entity reference (e.g. a player who
			// just disconnected or is mid-respawn), and the tank/flak thinkers deref it.
			// The consumers guard on "== 0 || == NIL" (global/vehicles_thinkers.scr:1038),
			// so 0 is the value they expect. This is the fix bug-1054 made for t2l2 and
			// which was never copied here.
			level.playertanktarget = 0
		wait 1
	}
end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// OBJECTIVES <begin>
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// initialize the objective list
// - NOTE: there is not a 1-to-1 correlation between objective thread names and objective numbers
// - Here is the correlation map:
//
//   Objective #:	runs thread:
//		1			objective1
//		2			objective2
//		3			objective3
//		4			objective4
//		5			objective5
//		6			objective6
//		7			objective7
//
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
initobjectives:

	waitthread global/objectives.scr::add_objectives 1 1 "Cross the Bridge and Enter Berlin" $beacon_bridge.origin
	waitthread global/objectives.scr::add_objectives 2 1 "Locate Downed Aircraft and Map to Chancellery" $beacon_piperplane.origin
	waitthread global/objectives.scr::add_objectives 3 1 "Locate the Chancellery Building" $beacon_safe.origin
	waitthread global/objectives.scr::add_objectives 4 1 "Locate the Safe Containing List of Double-Agents" $beacon_safe.origin
	waitthread global/objectives.scr::add_objectives 5 1 "Locate the Combination to the Safe" $beacon_combination.origin
	waitthread global/objectives.scr::add_objectives 6 1 "Use Combination to Open the Safe" $beacon_safe.origin
	waitthread global/objectives.scr::add_objectives 7 1 "Eliminate Enemies and Commandeer a Tank" $beacon_t34tank.origin

	level.safelocated = 0
	level.combination = 0
	level.usetrigger5 = 0

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 1 completion
// - Cross the bridge and enter the city
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective1:

	// enable objective
	waitthread global/objectives.scr::add_objectives 1 2
	waitthread global/objectives.scr::current_objectives 1
	//[user 2026-08-09] every status-2 flip on this map is BARE (no text), so the
	//add_objectives coop toast hook forwards NIL and no New Objective card ever fires.
	//Announce with the text registered in initobjectives (m2l2a recipe).
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 1 "Cross the Bridge and Enter Berlin" }

	// wait for the trigger to be encroached
	$new_fire anim start
	$objective1trigger waittill trigger

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 1 3

	// start the thread that waits for next objective
	thread objective2

	// autosave position 1
	exec global/autosave.scr 1

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 2 completion
// - Locate your instructions at the downed aircraft
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective2:

	// enable objective
	waitthread global/objectives.scr::add_objectives 2 2
	waitthread global/objectives.scr::current_objectives 2
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 2 "Locate Downed Aircraft and Map to Chancellery" }

	// wait for the trigger to be encroached
	$objective8trigger waittill trigger

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 2 3

	// start the thread that waits for next objective
	thread objective3

	// autosave position 2
	exec global/autosave.scr 2

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 3 completion
// - Locate the Chancellery Building
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective3:

	// enable objective
	waitthread global/objectives.scr::add_objectives 3 2
	waitthread global/objectives.scr::current_objectives 3
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 3 "Locate the Chancellery Building" }

	// wait for the trigger to be encroached
	$objective2trigger waittill trigger

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 3 3

	// start the thread that waits for next objective
	thread objective4

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 4 completion
// - Locate the safe
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective4:

	// enable objective
	waitthread global/objectives.scr::add_objectives 4 2
	waitthread global/objectives.scr::current_objectives 4
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 4 "Locate the Safe Containing List of Double-Agents" }

	// wait for the trigger to be encroached
	$objective4trigger waittill trigger

	level.safelocated = 1

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 4 3

	// start the thread that waits for next objective
	thread objective5

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 5 completion
// - Locate the combination to the safe
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective5:

	// enable objective
	waitthread global/objectives.scr::add_objectives 5 2
	waitthread global/objectives.scr::current_objectives 5
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 5 "Locate the Combination to the Safe" }

	// wait for the combination to be picked up
	while ( level.combination == 0 )
	{
		waitframe
	}

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 5 3

	// start the thread that waits for next objective
	thread objective6

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that runs on the use trigger for the safe
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
usetrigger5:

	if ( level.combination == 1 )
	{
		// player has located the combination
		if ( level.safestate == 0 )
		{
			// swap the safe model
			level.safestate = 1

			local.ent = spawn script_model model models/animate/safe.tik
			local.ent.origin = level.safe.origin
			local.ent.angles = level.safe.angles
			level.safe remove
			level.safe = local.ent

			// play the opening animation
			level.safe anim open
			wait 1.5
			level.safe anim pickup_portfolio

			// flag that the safe was opened
			level.usetrigger5 = 1
		}
	}
	else
	{
		// player doesn't have the combination
		level.safe anim locked
		wait 0.5
		level.safe anim idle
	}

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 6 completion
// - Use the combination to open the safe
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective6:
	
	// enable objective
	waitthread global/objectives.scr::add_objectives 6 2
	waitthread global/objectives.scr::current_objectives 6
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 6 "Use Combination to Open the Safe" }

	while ( level.usetrigger5 == 0 )
	{
		waitframe
	}

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 6 3

	// start the thread that waits for next objective
	thread objective7
end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that runs on the tankguards when they respawn
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
activatetankguard local.ent:

	local.ent forceactivate
	local.ent thread global/ai.scr::enemyspawned
	local.ent thread global/ai.scr::deathcheck

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// thread that waits for objective 7 completion
// - Eliminate Enemies and Commandeer a Tank
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
objective7:

	// enable objective
	waitthread global/objectives.scr::add_objectives 7 2
	waitthread global/objectives.scr::current_objectives 7
	//[user 2026-08-09] announce the bare flip above (text from initobjectives)
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 7 "Eliminate Enemies and Commandeer a Tank" }

	wait 1

	$explodertrigger triggerable
	thread t34_drive
	// spawn the tank guards
	level.tankguard[1] = waitthread global/spawner.scr::spawner_activate_targetname level.tankguard[1]
	level.tankguard[2] = waitthread global/spawner.scr::spawner_activate_targetname level.tankguard[2]
	level.tankguard[3] = waitthread global/spawner.scr::spawner_activate_targetname level.tankguard[3]

	exec gags/t3l1_germantankguys.scr::three_germans_at_tank_init

	wait 1

	while ( (isAlive $tankguard1) || (isAlive $tankguard2) || (isAlive $tankguard3) )
	{
		waitframe
	}
	// wait for the trigger to be encroached
	$objective7trigger waittill trigger

	// mark objective as complete
	waitthread global/objectives.scr::add_objectives 7 3

	// transition to next level
	exec coop_mod/replace.scr::takeAll // HZM coop - clear all players' weapons at transition (was: $player takeall)
	wait 0.1
	exec global/missioncomplete.scr t3l2 1

end

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// OBJECTIVES <end>
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~



sky_smoke:
    	for(local.i = 1;local.i <= $skysmoke.size; local.i ++)
	{
        //	$skysmoke[local.i].origin = ($skysmoke[local.i].origin + ( 0 0 -64 ))
        	$skysmoke[local.i] forceactivate
        	$skysmoke[local.i] anim start
        //	$skysmoke[local.i] svflags "+broadcast"		
        	wait .2
	}
end

pole_fall:

	local.ent = self.target

	local.ent playsound lightpole_fall_start
	local.ent notsolid

	// HZM coop - fall away from the nearest player (was bare $player.origin)
	local.pp = exec coop_mod/replace.scr::player_closestTo self
	if ( local.pp == NULL )
		local.pp = exec coop_mod/replace.scr::player_anyValid
	if ( local.pp != NULL && local.pp != NIL )
	{
		local.angles = (vector_toangles (local.pp.origin - self.origin))
		local.ent.angles = (0 (local.angles[1] + 90) 0)
	}

	self remove

	if ( local.ent.fangle == NIL )
		local.fallangle = 80
	else
		local.fallangle = local.ent.fangle

	local.rotate = 25
	local.current = local.rotate
	local.time = 0.5

	while (local.current < local.fallangle)
	{
		local.ent time local.time
		local.ent rotatezdown local.rotate
		local.ent waitmove
		local.time = local.time * 0.5
		local.current += local.rotate
	}
	local.current -= local.rotate

	local.ent time local.time
	local.ent rotatezdown (local.fallangle - local.current)
	local.ent waitmove

	local.ent playsound lightpole_fall_end

end

bench_smash:
	if(self.smashed != 1)
	{
        	self.smashed = 1
        	local.bench = $(self.target)
        	local.thing = spawn script_model model "animate/fx_cratedebris_0.tik"
        	local.thing2 = spawn script_model model "animate/fx_cratedebris_0.tik"
        	local.org = angles_toforward ((local.bench.angles) + ( 0 90 0 ))
        	local.org = ((local.org * 35) + ((local.bench.origin)) + ( 0 0 45 ))	
        	local.thing.origin = local.org
        	local.thing anim start
        	local.org = angles_toforward ((local.bench.angles) + ( 0 -90 0 ) )
        	local.org = ((local.org * 35) + ((local.bench.origin)) + ( 0 0 45 ) )
        	local.thing2.origin = local.org
        	local.thing2 anim start
		local.bench remove
	}
end

