InitFogger: {
//=========================================================================
	level.k4fogplane = 3100
	level.farclipoverride = 3100
	level.defaultfogplane = $world.farplane
	level.fogbias = $world.farplane_bias
	level.fogcolor = $world.farplane_color
	level.fogging = 0
}end

// stub handlers - called by coop framework on player events (silences "Could not find label" spam)
coop_playerJustSpawned:
end

coop_playerJustLeft:
end

coop_playerJustRespawned local.player:
	//[user 2026-08-05] bug-1436 - while the AB41 convoy rolls, a respawner rejoins the ride on a
	//HULL seat (never a turret - fighting a live gunner's slot risks ejecting them; the hull glue
	//is the mount block's own [209] recipe). DBNO is already disabled for the ride.
	if( level.coop_ab41Ride != 1 ){ end }
	if( local.player == NULL || local.player == NIL ){ end }
	if( $AB41 == NULL ){ end }
	wait 0.5
	if( local.player == NULL || local.player == NIL ){ end }
	if( !(isAlive local.player) ){ end }
	local.seat = spawn script_model model "models/fx/dummy.tik" targetname "ab41seat_respawn" notsolid 1
	waitframe
	local.seat.origin = $AB41.origin + ( -125 0 96 )
	local.seat glue $AB41
	local.player notsolid
	local.player origin local.seat.origin
	local.player.velocity = ( 0 0 0 )
	local.player forcelegsstate CROUCH_IDLE
	local.player glue local.seat
	local.player.flags["coop_inAB41"] = game.true
	local.player iprint "Back aboard the AB41!" 1
end

//[208] HZM coop - respawn an addon Opel truck marker as a native driveable vehicle
//=========================================================================
coop_spawnOpel local.old local.org local.ang local.name local.crew: {
//=========================================================================
	if (local.old != NULL) {
		local.org = local.old.origin
		local.ang = local.old.angles
		local.old remove
	}
	//spawn by the tik-declared class (drivablevehicle) exactly like the BSP fallback that
	//produced working vehicles; bare script_vehicle skipped the tik's wheel/speed init
	local.t = spawn drivablevehicle model "vehicles/opeltruck.tik"
	local.t.origin = local.org
	local.t.angles = local.ang
	local.t.nolights = 1 //[208] parked convoy sits dark and silent until it rolls
	local.t soundset "opeltruck_" //[208] engine plays m_sSoundSet+snd_run/idle - without the prefix the trucks played the WRONG (generic) aliases = the drive-sound glitch
	local.t targetname local.name
	local.t target "dastruck_collide" //truck_INIT wires self.collisionent from the target key (vanilla BSP convention)
	//crew via the vanilla loader (driver + passengers, wehrmacht per the BSP keys);
	//truck_unload later spills the passengers out to fight - as BT intended
	if (local.crew != NIL && local.crew > 0) {
		local.t waitthread global/vehicles_thinkers.scr::truck_load local.crew "models/human/german_wehrmact_soldier.tik"
	}
}end
