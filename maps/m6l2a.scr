// LEVEL: 			M6L2A														
// CAMPAIGN: 		Germany															
// TITLE:			"The Communications Blackout"										
// GEOMETRY/DESIGN: 	Benson Russell, Adam Bellefeuil, Keith Bell						
// SCRIPTING:		Steve Fukuda														
//============================================================================
main:{
//============================================================================
	level.coop_aaMap = 1					//Pasted by Criminal for coop comp. - let global scripts know this is a AA level
	level.coop_debugSpawn = 0 				//Pasted by Criminal for coop comp. - enable spawnpoint debug (make visible)
	//[user 2026-08-11] MUST be set BEFORE coop_mod/main.scr::main - that is what threads
	//officer.scr::coop_officer_init (main.scr:165). Set after it, as this first was, the officer
	//boss-wave system has already started and the opt-out never fires. No coop officer waves here:
	//the map reinforces itself from its own ~15 alarm_spawndetector entities via global/alarmer.scr.
	//[user 2026-08-12] STEALTH-NATIVE MODE - the only map in the game that sets this.
	//level.stealthnative is a Level field (Level::m_bStealthNative), not a cvar, and Level::Init()
	//zeroes it on EVERY map load - so it cannot leak into m6l2b, or into m2l2a via a console `map`,
	//or survive a crash or a dedicated restart, all of which a cvar would outlive. It is also
	//unreachable from console, config and autoexec: only this line turns it on.
	//What it currently buys, both in fgame:
	//  E1 weapon.cpp - gunfire is heard at SP's 1500u instead of OPM's world-scaled up-to-8000u
	//  E3 player.cpp - the alarm LATCHES: once blown, cover stays blown for the mission
	level.stealthnative = 1

	//[user 2026-08-12] "a saluter here MAY become a live checker later". Set at MAP LOAD, not at
	//cache pickup, because coop_apply_personality rolls ~1s after actor spawn and would otherwise
	//have already re-personalitied and proned the whole cast. See officer.scr::coop_isProtectedActor.
	level.coop_stealthCapable = 1
	//set-2's radio pulls a SENTRY (alarm2_officer_patroller), so the contain must accept one here
	level.coop_bustAllowSentry = 1
	//[user 2026-08-12] any isolated german can be contained here; the witnesses and the body
	//watch are what make it risky, not the target's rank.
	level.coop_bustAnyone = 1
	//you have to be genuinely on top of him. The default 112 reaches about as far as a doorway,
	//and USE is the same key as every door on the map.
	level.coop_bustUseRangeMap = 64
	thread coop_mod/bust.scr::coop_bustAnyoneWatch

	level.coop_noOfficerWaves = 1
	waitthread coop_mod/main.scr::main		//Pasted by Criminal for coop comp. - start coop mod extensions
	level.coop_weatherTheme = "snow"		//HZM coop - dynamic weather: snowy Germany (comms blackout)

	exec global/loadout.scr maps/m6l2a.scr

	//[user 2026-08-11] SPAWN CAMP (user build-mode placement, build_m6l2a.dat). A German camp at
	//the player spawn holding a uniform and papers - the disguise for this map comes from here
	//rather than from a pickup deep in the town, the same shape as m6l1c's truck cache.
	thread coop_m6l2aCamp
	thread coop_m6l2aSpawns
	thread coop_m6l2aOfficers
	thread coop_m6l2aAlarmBridge
	thread coop_m6l2aBrief
	thread coop_m6l2aRadios
	thread coop_m6l2aSabotage
	thread coop_baked_0814_bp
	thread coop_m6l2aDressing
	thread coop_m6l2aGuards
	thread coop_m6l2aSchedule
	thread coop_m6l2aPatrolWatchdog
	thread coop_m6l2aPapersChain
	//objectives 2 and 3 EXIST now, so they block for real - coop_m6l2aBombGate only defaults them
	//to 1 when they are still NIL, i.e. when nothing can ever set them.
	level.coop_m6ObjTransmit = 0
	thread coop_m6l2aSignals

	//*** INITIALIZE ALARM SYSTEM
	exec global/alarmer.scr 

	//*** INITIALIZE SPOTLIGHT SYSTEM
	exec global/spotlight.scr

	level waitTill prespawn

	level.script = maps/m6l2a.scr

	//*** INITIALIZE AMBIENT SOUND SYSTEM
	exec global/ambient.scr m6l2a

	//*** INITIALIZE ANY "JACK IN THE BOX" CABINETS IN BUILDINGS
	exec global/cabinet.scr

	//*** STOP ANY PREVIOUSLY PLAYING MUSIC
	//$player stufftext "tmstop"			//Criminal.
	waitthread coop_mod/replace.scr::tmstop //Criminal-coop comp. //[200] chrissstrahl - changed to waitthread

	//*** MACKEY'S SPOTLIGHT DEBUGGER
	//level.debug = 1

	//*** INITIALIZE BACKGROUND MUSIC
	soundtrack music/m6l2a.mus

	//*** INITIALIZE DOOR LOCKING SYSTEM
	exec global/door_locked.scr::lock

	//*** INITIALIZE FOG DISTANCE AND COLOR
	level.farplaneswitching = 0 	//initialize checking variable
	level.farplane = 1600
	level.farplane_color = ".1 .1 .2"

	$world farplane level.farplane
	$world farplane_color level.farplane_color

	//*** INITIALIZE WEATHER EFFECTS (SNOW)
	/*
	setcvar "cg_rain_shader" "textures/snow"
	setcvar "cg_rain_numshaders" "12"
	setcvar "cg_rain_speed" "240"
	setcvar "cg_rain_speed_vary" "100"
	setcvar "cg_rain_min_dist" "3072"
	setcvar "cg_rain_length" "2"
	setcvar "cg_rain_width" "2"
	setcvar "cg_rain_density" ".4"
	setcvar "cg_rain_slant" "300"
	*/
	//setcvar "cg_rain" "1"

	//*** INITIALIZE EXPLODING BUILDINGS
	thread global/exploder.scr::main

	//*** PAUSE ALL FX ANIMATIONS
	$objective1_fireball1 anim stop
	$objective1_fireball2 anim stop
	$objective1_fireball3 anim stop
	$objective1_fireball4 anim stop
	$objective1_fireball5 anim stop
	$objective1_fireball6 anim stop
	$objective1_fireball7 anim stop

	//*** INITIALIZE SPAWNERS AFTER RADIO COMM SHACKS ARE DESTROYED
	level.scene3_spawner_started = 0	

	//*** INITIALIZE THE NUMBER OF ALARMS IN THE LEVEL
	level.alarmpopulation = 8

	//*** INITIALIZE THE ALARMS TO BE IN THE OFF STATE
	level.alarmactive = 0

	//***	Find out what skill the player is using for difficulty checking 
	level.skill = getcvar (skill)
	
	thread coop_fixBlindSnipers //[202][hotfix] Smithy

//	level waitTill spawn //chrissstrahl
	waitthread coop_mod/replace.scr::waitForPlayer //chrissstrahl - coop compabitility

	waitthread global/items.scr::add_item "explosives" nomessage

	println "STEVEFU: MARKER 1" 

	//*** SET SPECIAL ITEMS
	waitthread global/items.scr::add_item "radio_explosives"	// Show radio_explosives inventory icon

	//*** CHECK TO SEE IF THE PLAYER IS ALLOWED TO EXIT THE LEVEL
	thread objective1_donecheck

	//*** INITIALIZE OBJECTIVES
	//[user 2026-08-12] the three new objectives sit AHEAD of the charges - the user's order, and
	//the reason the transmission is worth doing: reinforcements diverted before the shooting.
	waitthread global/objectives.scr::add_objectives 1 2 "Steal the train schedule from the Reichsbahn Officer's quarters, on the north side of town." ( -2972 -2328 57 )
	println "^~^~^ M6L2A objective 1 registered (slot 1 = schedule)"
	thread coop_m6l2aObjDump
	//[user 2026-08-12] STATUS 1 = HIDDEN. The charges are not an objective until the three that
	//precede them are done - the user's own note that objectives should update as you complete
	//them, and it also removes any question of which line sits at the top of the list at spawn:
	//at spawn there is exactly one. coop_m6l2aBombGateCheck flips this to 2 when the gate opens,
	//which is the same moment the charges physically become plantable.
	waitthread global/objectives.scr::add_objectives 4 1 "Plant explosives in the radio command post, in the northeast corner of the town. [6 remaining]" $cp1_bomb1.origin
	//waitthread global/objectives.scr::add_objectives 5 1 "Escape through the Commandant's residence on the south side of town." $exitnode.origin

	thread global/objectives.scr::current_objectives 1

	//*** START THE MACHINE GUNS
	thread defense_mg42

	//*** START THE RADIO OPERATORS AT THEIR STATIONS IN THE COMMAND POST
	//	$radio1_operator thread radio_operator_setup 
	//	$radio2_operator thread radio_operator_setup 	// this one's an alarm guy
	//	$radio3_operator thread radio_operator_setup 	// this one's an alarm guy
	//	$radio4_operator thread radio_operator_setup

	//*** START THE FAR AWAY GUYS ON THEIR PATROLS
	thread patrol_ai_forceactivate
	thread coop_coma_watch		//[user 2026-08-07] PREVENT COMA AFTER 60 SECONDS challenge

	//*** START SOME SUSPENSEFUL MUSIC AS A ONE SHOT
	//$player stufftext "tmstart sound/music/mus_01a_suspense.mp3"			//Criminal.
	exec coop_mod/replace.scr::tmstart "sound/music/mus_01a_suspense.mp3"	//Criminal - coop comp.
	
	//*** INITIALIZE OBJECTIVE 1 
	level.objective1_completed = 0
	thread objective1_donecheck
	thread initialize_bombsites
}end

//============================================================================
alarm_player_reset:{
//============================================================================
	thread global/alarmer.scr::alarm_player_reset
}end

//OBJECTIVE 1 SUPPORT THREADS
//============================================================================
objective1_donecheck:{
//============================================================================
//*** If the player hasn't destroyed the radio command post, he can't get through the amazing invisible blocker brush at the exit.

	while !(level.objective1_completed == 1){
		if(exec coop_mod/replace.scr::istouching $levelchange_blocker){ //chrissstrahl - handle in sp/mp
			iprintlnbold "You have not completed all of your objectives yet."
			wait 3
		}
		waitframe //infinite loop warning protection
	}
}end

//OBJECTIVE 1 BOMB PLANTING THREADS (Plant Explosives in the Radio Command Post)
//============================================================================
initialize_bombsites:{
//============================================================================
//*** Initialize values used in tracking bomb plant objective status, and cloak the preattached explosive models
	level.objective1_bombcount = 6
	//	$cp1_bomb1 hide
	level.cp1_bomb1_status = 0	
	//	$cp1_bomb2 hide
	level.cp1_bomb2_status = 0	
	//	$cp1_bomb3 hide
	level.cp1_bomb3_status = 0	
	//	$cp2_bomb1 hide
	level.cp2_bomb1_status = 0	
	//	$cp2_bomb2 hide
	level.cp2_bomb2_status = 0	
	//	$cp2_bomb3 hide
	level.cp2_bomb3_status = 0	
}end

//============================================================================
cp1_bombplant1:{
//============================================================================
	//[user 2026-08-12] ORDERING GATE. FIRST statement in the label on purpose: everything below
	//mutates state (model swap, bombcount--, status flag) and none of it is cleanly undoable.
	//[bug-1748] RETIRED - interior site, replaced by an exterior sabotage target.
	waitthread coop_m6l2aSabRefuse
	end
	if( waitthread coop_m6l2aBombGate "cp1_bombplant1" ( -3777 -709 60 ) 1 ){ end }
//*** Trigger_useonce in bsp
	$cp1_bomb1 model "animate//radiobomb.tik"
	$cp1_bomb1 playsound radiobomb

	level.objective1_bombcount --
	level.cp1_bomb1_status = 1
	
	thread objective1_bombtracker
	thread objective1_locationcheck
}end

