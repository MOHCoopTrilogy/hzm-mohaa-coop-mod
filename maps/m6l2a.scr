cello:{
//============================================================================
	$cellospeaker playsound moh_cello
	thread coop_mod/challenges.scr::chal_respite_play "cello"
	$cellospeaker ai_event "misc" 700
	println "^~^~^ M6L2A cello played - ai_event misc 700"
}end

