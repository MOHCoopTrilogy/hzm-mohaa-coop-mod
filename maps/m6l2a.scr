		level.scene3_spawn1_deactivator = 1
	}
}end

//MISCELLANEOUS ESSENTIAL SUPPORT THREADS				
//*** These threads are called by trigger_multiples in the bsp, one trigger per thread
//============================================================================
farplane_near:{
//============================================================================
	level.farplaneswitching = 1	
	
	while (level.farplane > 1600 && level.farplaneswitching == 1){
		level.farplane = level.farplane - 10
		//println level.farplane //[202] chrissstrahl - stop spamming the console
		$world farplane level.farplane
		wait .1
	}
}end

//============================================================================
farplane_far:{
//============================================================================
	level.farplaneswitching = 2

	while (level.farplane < 2400 && level.farplaneswitching == 2){
		level.farplane = level.farplane + 10
		//println level.farplane //[202] chrissstrahl - stop spamming the console
		$world farplane level.farplane
		wait .1
	}
}end

//MISCELLANEOUS SOUND SUPPORT THREADS
//*** Player tries to play the piano
//============================================================================
piano:{
//============================================================================	
	$pianospeaker playsound moh_piano
	thread coop_mod/challenges.scr::chal_respite_play "piano"
	//[user 2026-08-12] THE PIANO IS A DISTRACTION. `ai_event <type> <radius>` (entity.cpp:772) is
	//script-callable on any entity and makes every german inside the radius CURIOUS - actor.cpp
	//routes a heard event to CuriousSound, so they walk to the noise rather than to you.
	//"misc" rather than a voice type: a voice from a german is treated as friendly chatter and
	//gets the softer NoticeVoice path, while misc is an unexplained noise worth looking at.
	//700u is deliberately smaller than the 1500 default - this should pull the man in the next
	//room, not the whole street.
	$pianospeaker ai_event "misc" 700
	println "^~^~^ M6L2A piano played - ai_event misc 700"
}end

