//============================================================================
// Build mode saves a scale on some props and coop_m6l2aProp has no scale argument, so these go
// through here rather than losing it silently.
//============================================================================
coop_m6l2aScaled local.mdl local.pos local.ang local.sc:{
//============================================================================
	local.m = spawn script_model
	local.m model local.mdl
	local.m.origin = local.pos
	local.m.angles = local.ang
	local.m.scale = local.sc
	local.m solid
}end
