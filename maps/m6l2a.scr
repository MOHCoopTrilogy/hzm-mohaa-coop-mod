	waitthread coop_m6l2aProp "models/static/static_us-helmet_ltnt.tik" ( -299.675 -1897.866 -121.875 ) ( 0 280 0 ) 0
	waitthread coop_m6l2aProp "models/static/static_us-helmet_medic.tik" ( -295.062 -1875.772 -121.875 ) ( 0 280 0 ) 0
	waitthread coop_m6l2aProp "models/static/static_us-helmet_captain.tik" ( -297.796 -1856.020 -121.875 ) ( 0 280 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_blank_capt.tik" ( -428.6 -2516.8 -234.0 ) ( 359 272 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_blank.tik" ( -449.9 -2518.2 -238.9 ) ( 359 272 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_captain.tik" ( -128.3 -2762.0 -182.6 ) ( 359 272 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_engineer02.tik" ( -157.1 -2775.9 -180.6 ) ( 359 272 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_engineer01.tik" ( -187.9 -2770.9 -184.5 ) ( 359 272 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_ltnt.tik" ( 113.4 -2155.9 -123.5 ) ( 0 5 0 ) 0
	waitthread coop_m6l2aProp "models/equipment/ushelmet_ltnt.tik" ( -27.8 -2409.5 -122.9 ) ( 11 5 0 ) 0
	waitthread coop_m6l2aProp "models/animate/body_2nd-ranger-engineer3.tik" ( 38.6 -2584.4 -42.1 ) ( 1 216 0 ) 0
	waitthread coop_m6l2aScaled "models/static/ballpeen_hammer.tik" ( 115.6 -2386.3 -37.3 ) ( 1 216 0 ) 0.6
