//[user 2026-08-04] bug-1378 - ARENA BUILD MODE. 'coop_buildmap 1' before the map loads turns this
//into an authoring session: Ritual's own skip switches below jump the whole campaign, so you spawn
//ON FOOT with no jeep sequence, free to walk the level and lay out a holdout arena. There is no
//separate .bsp - the engine binds maps/<bspname>.scr, so a build VARIANT has to be a branch in
//this same script rather than a second file.
//[bug-1427] level.coop_buildmap is set by coop_mod/main.scr::main (ONE-SHOT: it consumes and
//clears the cvar every load). Re-reading the cvar here would see the cleared 0 and break an
//intentional build session - so this file no longer touches it.

level.hackskipbunker1							= 0  //bunker1
level.hackskipbunker2							= 0  //bunker 2
level.hackskipbunker3							= 0  //bunker 3
level.hackskipbunker4							= 0  //bunker 4
level.hackskipcastle							= 0  //Castle
level.hackskiptower								= 0  //Tower 
level.hackskipdefendtower						= 0  //Tower 
level.hackskipcallinairstrike					= 0  //Dont have to call in airstrike
level.hackescape								= 0
level.allowplayeroffjeep						= 0
//[bug-1379] the hackskip* flags are deliberately NOT set for build mode - they only make each
//section return early, which fast-forwards the mission into the outro. maps/e3l4.scr ends its
//objective chain instead.
