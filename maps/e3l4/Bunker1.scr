//=========================================================================
InitBunker1:
//=========================================================================
{
	$jeepdriver 	nodamage
	$jeeppassenger 	nodamage
	$jeepdriver 	gun "none"
	$jeeppassenger 	gun "none"

	$startjeep setcollisionentity $jeepcollisionfull
	
	$startjeep.turret = $startjeep queryturretslotentity 0
	$startjeep lock		//MiaCosa @chrissstrahl
	$startjeep.turret lock
	$startjeep.speed = 400
	$startjeep nodamage
	$startjeep vehicleanim idlelights
	
	$destroyedgmc notsolid
	$destroyedgmc hide
	$deaddriver notsolid
	$deaddriver hide

	$startplane notsolid
	$startplane.shooting = 1
	$startplane.speed 	 = 1500
	$startplane.accel 	 = 8000
	
	$startplane02 notsolid
	$startplane02.shooting 	= 0
	$startplane02.speed 	= 1800
	$startplane02.accel 	= 8000
	
	$startplane03 notsolid
	$startplane03.shooting 	= 0
	$startplane03.speed 	= 1700
	$startplane03.accel 	= 8000
	
	//	$player threatbias 305
	$bunker1mg1 thread SetupMG
	$bunker1mg2 thread SetupMG
	$bunker1mg3 thread SetupMG
}end

//=========================================================================
SetupMG:
//=========================================================================
{
	self burstfiresettings 1 3 1.5 3
	self convergetime 0.25
	self aibulletspread 450 275
}end

//=========================================================================
SetupMGBadass:
//=========================================================================
{
	self burstfiresettings 5 6 0.5 1
	self convergetime 0.01
	self aibulletspread 10 10
}end

//=========================================================================
PlayerGetOffJeepHack:
//=========================================================================
{
	while (level.playeronjeep == 1){
		local.anyheld = 0
		local.jk = 1
		while (local.jk <= $player.size){
			if ($player[local.jk].useheld){ local.anyheld = 1 }
			local.jk++
		}
		if (local.anyheld == 1){		//MiaCosa @chrissstrahl - check all players
			waitthread PlayerGetOffJeepTurret
		}

		waitframe
	}
}end

//=========================================================================
DoIntro:
//=========================================================================
{
	if (level.hackskipbunker1 == 1){
		end
	}

	$startjeep.turret = $startjeep queryturretslotentity 0
	$startjeep.turret setAimTarget $starttruck

	level.playeronjeep = 0
	waitthread maps/e3l4/Bunker1.scr::PlayerGetOnJeepTurret
	$startjeep.turret psetviewangles ( 0 340 0 )

	if (level.allowplayeroffjeep == 1){
		thread PlayerGetOffJeepHack
	}
	
	$jeepdriver thread global/LoopAnim.scr::LoopUpperAnim A_34_driver_idle
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_jeepPass_idle

	for (local.i = 1; local.i <= $bunker1supplies.size; local.i++){
		$bunker1supplies[local.i] hide	
	}
	wait 2

	thread maps/e3l4.scr::startMusic_e3l4_main
	wait 1

	//	waitthread maps/e2l1/fog.scr::setFog 4000
	$jeepdriver say A_34_jeepDriver_1 	//Keep your eyes open.  Those Krauts are gonna be here any minute.
	$jeepdriver waittill saydone		//MiaCosa @Chrissstrahl
	wait .5
	
	$jeeppassenger waitthread global/LoopAnim.scr::LoopUpperAnimStop
	$jeeppassenger upperanim A_34_jeepPass_1	//Yeah, but where is that supply truck?
	$jeeppassenger waittill upperanimdone
	//	$jeeppassenger say A_34_jeepPass_1		//Yeah, but where is that supply truck?
	//	$jeeppassenger waittill saydone
	
	$jeeppassenger say A_34_jeepPass_2	//The whole line is running out of ammo.
	$jeeppassenger waittill saydone		//MiaCosa @Chrissstrahl
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_jeepPass_idle2
	wait 3

	thread doTruck
	wait 3

	thread IntroConversation
	wait 0.5

	/*
	local.startplanetrigger02 = waitthread global/FindTrigger.scr::FindTrigger "startplanetrigger02"
	trigger local.startplanetrigger02
	local.startplanetrigger03 = waitthread global/FindTrigger.scr::FindTrigger "startplanetrigger03"
	trigger local.startplanetrigger03
	*/	
	wait 3

	local.startplanetrigger = waitthread global/FindTrigger.scr::FindTrigger "startplanetrigger"
	trigger local.startplanetrigger
	wait 2

	local.startplanetrigger02 = waitthread global/FindTrigger.scr::FindTrigger "startplanetrigger02"
	trigger local.startplanetrigger02
	
	local.startplanetrigger03 = waitthread global/FindTrigger.scr::FindTrigger "startplanetrigger03"
	trigger local.startplanetrigger03
	
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnimStop
	$jeeppassenger say A_34_jeepPass_5		// Look out!
	$jeeppassenger waittill saydone		//MiaCosa @Chrissstrahl
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_jeepPass_idle3
	wait 3

	$pgenBunker01 turnon
	$collectsuppliesparademanager thread global/parade.scr::RunParade
	$deliversuppliesbunker1parademanager thread global/parade.scr::RunParade
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnimStop
	waitframe

	$jeeppassenger say A_34_jeepPass_6	// Dammit!  Our guys need that stuff.
	$jeeppassenger waittill saydone		//MiaCosa @Chrissstrahl
	$jeeppassenger say A_34_jeepPass_7	// C'mon Sarge, let's move!
	$jeeppassenger waittill saydone
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_Getin_jeepidle_danger
	
	$bunker1mg1 thread global/mg42init.scr::AttachGuyToMG42 $bunker1mgguy1 NIL 1
	$bunker1mg2 thread global/mg42init.scr::AttachGuyToMG42 $bunker1mgguy2 NIL 1
	$bunker1mg3 thread global/mg42init.scr::AttachGuyToMG42 $bunker1mgguy3 NIL 1
	thread startSirens
	
	//	waitthread maps/e2l1/fog.scr::setFog 3000
}end

//=========================================================================
JeepIdle:
//=========================================================================
{
	//	self waitthread LoopAnimStop
	if ( $jeeppassenger.loop_upperanim_thread!=NULL && $jeeppassenger.loop_upperanim_thread!=NIL){
		$jeeppassenger.loop_upperanim_thread delete
		$jeeppassenger.loop_upperanim_thread = NULL
	}

	$jeeppassenger.loop_upperanim_thread = local

	while (1){
		$jeeppassenger upperanim A_34_Getin_jeepidle_danger
		$jeeppassenger waittill upperanimdone
	}
}end

//=========================================================================
IntroConversation:
//=========================================================================
{
	$jeeppassenger waitthread global/LoopAnim.scr::LoopUpperAnimStop
	$jeeppassenger say A_34_jeepPass_3	//There it is!
	$jeeppassenger waittill saydone		//MiaCosa @Chrissstrahl
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_jeepPass_idle2
	wait 1

	$jeeppassenger waitthread global/LoopAnim.scr::LoopUpperAnimStop
	$jeeppassenger say A_34_jeepPass_4	// Man, ain't she a sight for sore eyes?"
	$jeeppassenger waittill saydone
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_jeepPass_idle
}end

//=========================================================================
doTruck:
//=========================================================================
{
	$starttruck.takedamage = 0
	$starttruck nodamage
	$starttruck show

	exec global/spotlight.scr::corona $starttruck "Box01" ( 40 60 250 )
	exec global/spotlight.scr::corona $starttruck "Box01" ( -40 60 250 )
	$starttruck drive $starttruck.target 175 175 200 256
	wait 9.5

	$starttruck thread truckExplode
}end	 

//=========================================================================
SupplyTruckSwap:
//=========================================================================
{
	$supplytruckswaptrigger waittill trigger
	
	level.destroyedTruck remove
	$destroyedgmc solid
	$destroyedgmc show
	$deaddriver solid
	$deaddriver show
}end

//=========================================================================
ObjectiveDeliverSuppliesBunker1:
//=========================================================================
{
	if (level.hackskipbunker1 == 1){		
		waitthread PlayerGetOffJeepTurret
		//[user 08-02] TRAPS T5: bare $player is an ARRAY with 2+ players and throws on cast.
		for (local.tp = 1; local.tp <= $player.size; local.tp++){
			if ($player[local.tp] != NULL){ $player[local.tp].origin = $bunker2deliverytrigger.origin }
		}
		end
	}

	//   Player gets on the jeep
	$startjeep.target = $pickupsuppliespath
	thread SupplyTruckSwap
	exec global/autosave.scr 2 // Able Bunker
	
	//   Jeep drives out to pick up supplies	
	//	dprintln "DEBUG:  jeep loaded"
	$jeepdriver waitthread global/LoopAnim.scr::LoopUpperAnimStop
	$startjeep setcollisionentity $jeepcollision	

	thread JeepSteering1
	$startjeep drive $startjeep.target 300 200 200 256
	wait 2

	$startjeep setcollisionentity $jeepcollisionfull
	$startjeep waittill drive
	$startjeep fullstop
	$startjeep setcollisionentity $jeepcollision
	
	//   Guys do their thing
	$jeepdriver thread doSupplyRunD
	$jeeppassenger say A_34_JeepPass_Talk_02  // Keep 'em off our backs while we go get the supplies!
	$jeeppassenger waittill saydone		//MiaCosa @Chrissstrahl
	$jeeppassenger anim A_31_GetIn_jeepidle
	level.gotSupplies = 0

	$startjeep disconnect_paths
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnimStop
	$jeeppassenger thread doSupplyRunP
	wait 3

	$startjeep setcollisionentity $jeepcollisionfull

	//[user 2026-08-04] bug-1362 - SOFT-LOCK FAILSAFE. getSupplies is a long chain of
	//'waittill movedone / turndone / animdone' plus a distance loop; if either actor cannot
	//path to a crate, cannot turn, or its crate_* anim never reports done, gotSupplies never
	//reaches 2 and the jeep NEVER leaves - the mission is unfinishable (user: 'the allied actor
	//that gets out of the jeep to pick up the supplies cant complete what he needs to do').
	//Retail could rely on a solo scripted path; coop adds players who body-block the route.
	//After 45s we simply declare the supplies loaded and put the crew back in the jeep - the
	//same failsafe shape used for the truck unload and the AB41 death (bugs 1315/1318).
	local.wait = 0
	while (level.gotSupplies < 2 && local.wait < 22){
		wait 0.5
		local.wait = local.wait + 0.5
	}
	if (level.gotSupplies < 2){
		println( "^~^~^ E3L4 SUPPLY FAILSAFE: gotSupplies stuck at " + level.gotSupplies + " - forcing" )
		//Kill the parked run thread BEFORE seating. Left alive, the stuck actor keeps re-issuing
		//its runto after being seated and fights the recovery.
		if ( level.e3l4_supplyThrD != NULL && level.e3l4_supplyThrD != NIL ){
			level.e3l4_supplyThrD delete
			level.e3l4_supplyThrD = NULL
		}
		//Kill the parked run thread BEFORE seating. Left alive, the stuck actor keeps re-issuing
		//its runto after being seated and fights the recovery.
		if ( level.e3l4_supplyThrP != NULL && level.e3l4_supplyThrP != NIL ){
			level.e3l4_supplyThrP delete
			level.e3l4_supplyThrP = NULL
		}
		//hide any crate a half-finished pickup left visible, so none float at the truck
		local.hb = 1
		while (local.hb <= $bunker1supplies.size){
			$bunker1supplies[local.hb] hide
			local.hb++
		}
		//[user 2026-08-04] bug-1366 - do NOT call DriverGetInJeep / PassengerGetInJeep here.
		//Both OPEN with 'runto <enter tag>' + 'waittill movedone' (global/jeepanim.scr), which is
		//the exact class of wait this failsafe exists to escape: the live log showed the passenger
		//frozen at (1283 -6082 285) spamming "Path not found in Actor::MoveToPatrolCurrentNode"
		//every 5s, so movedone never fired, the waitthread hung, gotSupplies=2 below never ran and
		//the jeep never departed - the failsafe MOVED the soft-lock instead of removing it.
		//Use only the TAIL of the vanilla routines (everything after the runto/walkto): seat the
		//actor by origin + attach. Same recipe, zero movement, cannot block.
		waitthread forceCrewIntoJeep $jeepdriver     "driver_enter"      "driver"     A_22_driver_idle
		waitthread forceCrewIntoJeep $jeeppassenger  "passenger_enter"   "passenger0" A_31_GetIn_jeepidle
		level.gotSupplies = 2
	}

	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_Getin_jeepidle_danger

	//   go go go
	thread JeepSteering2
	$startjeep thread dirtFromTheTires
	$startjeep drive $dropoffpath 300 100 200 256
	$startjeep waittill drive
	$startjeep fullstop

	$deliversuppliesmanager thread global/parade.scr::RunParade
	$collectsuppliesparademanager thread global/parade.scr::DeleteParade 4000

	$jeeppassenger say A_34_Andyboy_01
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnimStop

	// Guys get out and deliver the supplied to the bunkers
	waitthread deliverSupplies $jeepdriver $jeeppassenger
	$jeeppassenger thread global/LoopAnim.scr::LoopUpperAnim A_34_Getin_jeepidle_danger
	wait 1
}end

//=========================================================================
//[user 2026-08-04] bug-1366. Seat one crewman in the jeep with NO movement and NO waits that can
//hang. This is deliberately the tail of global/jeepanim.scr::DriverGetInJeep / PassengerGetInJeep,
//copied verbatim from the point AFTER their runto/walkto pair - the vanilla recipe minus the walk.
//It is only ever called from the supply failsafe, i.e. when an actor has already proven it cannot
//path, so popping into the seat is correct: the alternative is an unfinishable mission. The
//anim_noclip + 'waittill animdone' step is dropped too - anim_noclip only translates the origin,
//which the explicit origin assignment already does, and any waittill here would reintroduce the
//exact hang this exists to avoid.
//=========================================================================
//[user 2026-08-04] bug-1369. global/jeepanim.scr::PassengerGetInJeep CANNOT be used on this map.
//Its first executable line is:
//        local.dest = local.jeep gettagposition "passenger_enter0 1"
//That tag exists on the Allied Assault jeep (models/vehicles/jeep/jeep.skd) but NOT on the willys
//this map drives - $startjeep is vehicles/willys_playerturret.tik -> models/vehicles/willys/
//baseframe.skd, whose tags are driver_enter / passenger_enter / passenger0..2 / *_seat.
//Entity::GetTagPosition raises a ScriptError when the tag is missing (fgame/entity.cpp:5413), and a
//ScriptError is UNCATCHABLE from script - so the very next line's 'if (!local.dest)' fallback is
//dead code, and the thread is torn down before it issues a single command. That is the whole
//driver/passenger asymmetry: DriverGetInJeep asks for "driver_enter", which the willys HAS.
//This is a faithful copy of the vanilla routine with the correct tag, so the walk-in animation is
//preserved (unlike forceCrewIntoJeep, which teleports and is only for the failsafe path).
//NOTE: no 'waittill turndone' anywhere in here, deliberately - see bug-1368 at the box2 pickup.
//'waittill movedone' IS safe even when the path fails: Actor::CheckUnregister (actor.cpp:7793)
//unregisters MOVEDONE on parm.movefail.
//=========================================================================
passengerGetInWillys local.jeep local.passenger:
//=========================================================================
{
	if (!local.passenger) end
	if (!local.jeep) end

	local.passenger holster
	local.dest = local.jeep gettagposition "passenger_enter"

	if (vector_length(local.passenger.origin - local.dest) > 70){
		local.passenger.movedoneradius = 70
		local.passenger runto local.dest
		local.passenger waittill movedone
	}
	if (vector_length(local.passenger.origin - local.dest) > 20){
		local.passenger.movedoneradius = 20
		local.passenger walkto local.dest
		local.passenger waittill movedone
	}
	local.passenger notsolid
	local.passenger nodamage

	local.passenger waitexec global/disable_ai.scr
	local.passenger turnto NULL
	local.passenger lookat NULL
	local.passenger.origin = local.dest
	local.passenger.angles = local.jeep.angles
	local.passenger anim_noclip A_31_GetIn_jeep
	local.passenger waittill animdone

	local.passenger.angles = (0 0 0)
	local.passenger attach local.jeep passenger0 1
	local.passenger thread global/LoopAnim.scr::LoopAnim A_31_GetIn_jeepidle
	local.passenger physics_off
	println( "^~^~^ E3L4P " + local.passenger.targetname + " boarded (willys tag)" )
}end

//=========================================================================
forceCrewIntoJeep local.actor local.entertag local.seattag local.idleanim:
//=========================================================================
{
	if (!local.actor) end

	local.actor thread global/LoopAnim.scr::LoopAnimStop
	local.actor thread global/LoopAnim.scr::LoopUpperAnimStop

	local.dest = $startjeep gettagposition local.entertag
	if (!local.dest) local.dest = $startjeep.origin

	local.actor notsolid
	local.actor nodamage
	local.actor waitexec global/disable_ai.scr
	local.actor turnto NULL
	local.actor lookat NULL
	local.actor.origin = local.dest
	local.actor.angles = (0 0 0)
	local.actor attach $startjeep local.seattag 1
	local.actor thread global/LoopAnim.scr::LoopAnim local.idleanim
	local.actor physics_off
	println( "^~^~^ E3L4 SUPPLY FAILSAFE: seated " + local.seattag + " at " + local.dest )
}end

//=========================================================================
JeepSteering1:
//=========================================================================
{
	$jeepdriver anim A_22_driver_turnleft
	$jeepdriver waittill animdone
	$jeepdriver anim A_22_driver_turnstraight_fromleft
	$jeepdriver waittill animdone
	$jeepdriver anim A_22_driver_turnright
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driver_turnright_idle
	wait 2

	$jeepdriver thread global/LoopAnim.scr::LoopAnimStop
	$jeepdriver anim A_22_driver_turnstraight_fromright
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driving_idle
}end

//=========================================================================
JeepSteering2:
//=========================================================================
{
	$jeepdriver anim A_22_driver_turnleft
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driver_turnleft_idle
	wait 2

	$jeepdriver thread global/LoopAnim.scr::LoopAnimStop
	$jeepdriver anim A_22_driver_turnstraight_fromleft
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driving_idle
	wait 2.3

	$jeepdriver thread global/LoopAnim.scr::LoopAnimStop
	$jeepdriver anim A_22_driver_turnleft
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driver_turnleft_idle
	wait 1.8

	$jeepdriver thread global/LoopAnim.scr::LoopAnimStop
	$jeepdriver anim A_22_driver_turnstraight_fromleft
	$jeepdriver waittill animdone
	$jeepdriver thread global/LoopAnim.scr::LoopAnim A_22_driving_idle
}end

//=========================================================================
doSupplyRunD:
//=========================================================================
{
	//[user 2026-08-04] bug-1366 - publish this thread so the failsafe can DELETE it. 'local' is
	//the running thread object; deleting it kills a thread parked on ANY waittill, which is the
	//only recovery that works without knowing which of the 12 blocking calls below is stuck.
	//Same mechanism global/LoopAnim.scr uses via .loop_upperanim_thread (see JeepIdle above).
	level.e3l4_supplyThrD = local
	waitthread global/jeepanim.scr::DriverGetOutJeep $startjeep self
	self waitthread getSupplies 3 1 "spare_tire" // was dummy09
	waitthread global/jeepanim.scr::DriverGetInJeep $startjeep self
	level.e3l4_supplyThrD = NULL
	level.gotSupplies++
}end

//=========================================================================
doSupplyRunP:
//=========================================================================
{
	level.e3l4_supplyThrP = local	//[user 2026-08-04] bug-1366 - see doSupplyRunD
	println( "^~^~^ E3L4P " + self.targetname + " P1-getout" )
	waitthread global/jeepanim.scr::PassengerGetOutJeep $startjeep self
	wait 1

	println( "^~^~^ E3L4P " + self.targetname + " P2-supplies-start" )
	self waitthread getSupplies 4 2 "spare_tire"

	local.jeepback 	= -250 * (angles_toforward $startjeep.angles)
	local.jeepright = -200 * (angles_toleft $startjeep.angles)
	local.runto 	= $startjeep.origin + local.jeepback + local.jeepright
	self runto local.runto

	//[user 2026-08-04] bug-1368 - bounded; an unpathable 'runto' never converges here.
	local.aq1 = 0
	while (vector_length(self.origin - local.runto) > 30 && local.aq1 < 12){
		wait 0.1
		local.aq1 = local.aq1 + 0.1
	}
	if (local.aq1 >= 12){ println( "^~^~^ E3L4P reposition timed out - continuing" ) }

	local.jeepback  = -250 * (angles_toforward $startjeep.angles)
	local.jeepright =  200 * (angles_toleft $startjeep.angles)
	local.runto 	= $startjeep.origin + local.jeepback + local.jeepright
	self runto local.runto

	//[user 2026-08-04] bug-1368 - bounded; an unpathable 'runto' never converges here.
	local.aq2 = 0
	while (vector_length(self.origin - local.runto) > 30 && local.aq2 < 12){
		wait 0.1
		local.aq2 = local.aq2 + 0.1
	}
	if (local.aq2 >= 12){ println( "^~^~^ E3L4P reposition timed out - continuing" ) }

	println( "^~^~^ E3L4P " + self.targetname + " P4-getin" )
	waitthread passengerGetInWillys $startjeep self	//[user 2026-08-04] bug-1369 - vanilla asks for a tag the willys lacks
	wait 1

	println( "^~^~^ E3L4P " + self.targetname + " P5-DONE" )
	level.e3l4_supplyThrP = NULL
	level.gotSupplies++
}end

//=========================================================================
getSupplies local.box1 local.box2 local.deliveryPosName:
//=========================================================================
{
	local.moveradius 	= self.movedoneradius
	self.movedoneradius = 120
	local.deliveryPos 	= $startjeep gettagposition local.deliveryPosName
	
	println( "^~^~^ E3L4P " + self.targetname + " A-runto-box1" )
	self runto $bunker1supplies[local.box1]
	println( "^~^~^ E3L4P " + self.targetname + " B-movedone-box1" )
	self waittill movedone
	self turnto $bunker1supplies[local.box1]
	wait 0.5

	//	self waittill turndone

	println( "^~^~^ E3L4P " + self.targetname + " C-pickup1" )
	self anim crate_pickup2
	$bunker1supplies[local.box1] hide
	self waittill animdone

	println( "^~^~^ E3L4P " + self.targetname + " D-carry1" )
	self turnto local.deliveryPos
	self waittill turndone
	self anim crate_walk

	//[user 2026-08-04] bug-1368 - bounded. The carry is driven by the crate_walk anim's own
	//motion; if the actor is body-blocked (coop players stand where retail had nobody) it never
	//closes to 150 and spins forever. 15s is far longer than the real walk.
	local.cw1 = 0
	while (vector_length (self.origin - $startjeep.origin) > 150 && local.cw1 < 15){
		wait 0.1
		local.cw1 = local.cw1 + 0.1
	}
	if (local.cw1 >= 15){ println( "^~^~^ E3L4P " + self.targetname + " carry timed out - continuing" ) }

	println( "^~^~^ E3L4P " + self.targetname + " E-putdown1" )
	self anim crate_putdown2
	self waittill animdone
	self turnto NULL
	wait .5
	
	println( "^~^~^ E3L4P " + self.targetname + " F-runto-box2" )
	self runto $bunker1supplies[local.box2]
	println( "^~^~^ E3L4P " + self.targetname + " G-movedone-box2" )
	self waittill movedone
	self turnto $bunker1supplies[local.box2]
	//[user 2026-08-04] bug-1368 - THE HANG. Was 'self waittill turndone'.
	//Unregister(STRING_TURNDONE) exists in exactly ONE place in the engine, actor.cpp:5032, inside
	//Actor::IdleTurn - and IdleTurn is only ever called from Think_Anim (actor_anim.cpp:67) and
	//Think_Idle (actor_idle.cpp:82/86). It is NEVER called from a runner think. A failed path leaves
	//the actor pinned in THINK_RUNNER (actor.cpp:6469 returns without clearing m_patrolCurrentNode),
	//so turndone can never fire and this line blocks forever - which is why the passenger froze at
	//the crate while the driver, whose crates were reachable, sailed through.
	//The fix is Ritual's own: they hit this at the box1 site 30 lines up and replaced turndone with
	//a fixed wait (see the commented-out 'self waittill turndone' there) - and left this twin live.
	//The two turndones that follow a crate_* anim are SAFE and stay: an anim puts the actor in
	//THINK_ANIM, where IdleTurn does run.
	wait 0.5
	self anim crate_pickup2

	$bunker1supplies[local.box2] hide

	self waittill animdone
	self turnto local.deliveryPos
	self waittill turndone
	self anim crate_walk

	//[user 2026-08-04] bug-1368 - bounded. The carry is driven by the crate_walk anim's own
	//motion; if the actor is body-blocked (coop players stand where retail had nobody) it never
	//closes to 150 and spins forever. 15s is far longer than the real walk.
	local.cw2 = 0
	while (vector_length (self.origin - $startjeep.origin) > 150 && local.cw2 < 15){
		wait 0.1
		local.cw2 = local.cw2 + 0.1
	}
	if (local.cw2 >= 15){ println( "^~^~^ E3L4P " + self.targetname + " carry timed out - continuing" ) }

	self anim crate_putdown2
	self waittill animdone
	self turnto NULL
	println( "^~^~^ E3L4P " + self.targetname + " Z-getSupplies-DONE" )
	self.movedoneradius = local.moveradius
}end

//=========================================================================
dirtFromTheTires:
//=========================================================================
{
	for (local.i = 1; local.i <= 2; local.i++){
		local.temp[local.i] = spawn script_model model models/emitters/JS_wheel_dirt_plume.tik
		local.temp[local.i] notsolid
	}
		
	local.temp[1] attach self "tire_spew_back_left"
	local.temp[2] attach self "tire_spew_back_right"
	
	for (local.i = 1; local.i <= 2; local.i++){
		local.temp[local.i] anim start
		local.temp[local.i] notsolid
	}
	wait 2
	
	for (local.i = 1; local.i <= 2; local.i++){
		local.temp[local.i] remove
	}
}end

//=========================================================================
deliverSupplies:
//=========================================================================
{
	level.driverdonedelivery	= 0
	level.passengerdonedelivery = 0
	$startjeep setcollisionentity $jeepcollision
	
	thread Bunker1CrateDeliveryDriver
	thread Bunker1CrateDeliveryPassenger
	wait 3

	//[user 2026-08-04] bug-1376 - do NOT restore the FULL hull here. The small $jeepcollision is
	//set above precisely so the crew can walk their crate paths past the vehicle; putting the full
	//hull back 3 seconds in re-solidifies the jeep while they are still carrying crates around it,
	//and a crate carrier that walks into it treads in place forever (see the bounded loop in
	//crateDeliver). Retail got away with the 3s because nothing slowed the crew down; coop players
	//body-block them earlier in the sequence, so they are still en route. Restore the full hull
	//AFTER both done-flags, just before the jeep needs to drive again.
		
	//[user 2026-08-04] bug-1366 - SECOND SOFT-LOCK, same shape as the supply one above. Both
	//Bunker1CrateDelivery* threads contain 'runto' + an UNBOUNDED 'while (vector_length(...) > 30)'
	//distance loop, a 'waittill turndone', and a closing DriverGetInJeep/PassengerGetInJeep (which
	//itself opens with runto + waittill movedone). An actor that cannot path never satisfies any of
	//them, so its done-flag never sets and this loop spins forever with the players trapped at the
	//bunker. Bound it, then force the crew back into the jeep by seating them directly.
	local.dwait = 0
	while (( level.driverdonedelivery == 0 || level.passengerdonedelivery == 0) && local.dwait < 30){
		wait 0.5
		local.dwait = local.dwait + 0.5
	}
	if ( level.driverdonedelivery == 0 || level.passengerdonedelivery == 0){
		println( "^~^~^ E3L4 DELIVERY FAILSAFE: driver=" + level.driverdonedelivery + " passenger=" + level.passengerdonedelivery + " - forcing" )
		//Kill the parked run thread BEFORE seating. Left alive, the stuck actor keeps re-issuing
		//its runto after being seated and fights the recovery.
		if ( level.e3l4_delThrD != NULL && level.e3l4_delThrD != NIL ){
			level.e3l4_delThrD delete
			level.e3l4_delThrD = NULL
		}
		//Kill the parked run thread BEFORE seating. Left alive, the stuck actor keeps re-issuing
		//its runto after being seated and fights the recovery.
		if ( level.e3l4_delThrP != NULL && level.e3l4_delThrP != NIL ){
			level.e3l4_delThrP delete
			level.e3l4_delThrP = NULL
		}
		if ( level.driverdonedelivery == 0){
			waitthread forceCrewIntoJeep $jeepdriver    "driver_enter"    "driver"     A_22_driver_idle
			level.driverdonedelivery = 1
		}
		if ( level.passengerdonedelivery == 0){
			waitthread forceCrewIntoJeep $jeeppassenger "passenger_enter" "passenger0" A_31_GetIn_jeepidle
			level.passengerdonedelivery = 1
		}
	}

	//[bug-1376] both crew are done walking - safe to be a solid vehicle again before it drives
	$startjeep setcollisionentity $jeepcollisionfull
}end

//=========================================================================
Bunker1CrateDeliveryDriver:
//=========================================================================
{
	level.e3l4_delThrD = local	//[user 2026-08-04] bug-1366 - killable by the delivery failsafe
	waitthread global/jeepanim.scr::DriverGetOutJeep $startjeep $jeepdriver

	local.jeeprear = -130 * (angles_toforward $startjeep.angles)
	local.jeepleft = -100 * (angles_toleft $startjeep.angles)
	local.runto    = $startjeep.origin + local.jeeprear + local.jeepleft
	$jeepdriver runto local.runto

	//[user 2026-08-04] bug-1368 - bounded. A failed 'runto' pins the actor in THINK_RUNNER, so
	//BOTH of the original waits here are unbounded: this distance loop never converges, and the
	//'waittill turndone' that followed could never fire (Unregister(STRING_TURNDONE) lives only
	//in Actor::IdleTurn, which no runner think calls). Cap the approach and use the fixed wait
	//Ritual themselves substituted at the box1 pickup instead of the turndone.
	local.ap = 0
	while (vector_length($jeepdriver.origin - local.runto) > 30 && local.ap < 12){
		wait 0.1
		local.ap = local.ap + 0.1
	}
	if (local.ap >= 12){
		println( "^~^~^ E3L4P jeepdriver approach timed out - continuing" )
	}

	$jeepdriver turnto $startjeep
	wait 0.5
	$jeepdriver waitthread crateDeliver $cratepath2 $bunker1drivernode 0 "driver_enter"
	waitthread global/jeepanim.scr::DriverGetInJeep $startjeep $jeepdriver 
	level.e3l4_delThrD = NULL
	level.driverdonedelivery = 1
}end

//=========================================================================
Bunker1CrateDeliveryPassenger:
//=========================================================================
{
	level.e3l4_delThrP = local	//[user 2026-08-04] bug-1366 - killable by the delivery failsafe
	waitthread global/jeepanim.scr::PassengerGetOutJeep $startjeep $jeeppassenger

	local.jeeprear 	= -130 * (angles_toforward $startjeep.angles)
	local.jeepright =  100 * (angles_toleft $startjeep.angles)
	local.runto 	= $startjeep.origin + local.jeeprear + local.jeepright
	$jeeppassenger runto local.runto

	//[user 2026-08-04] bug-1368 - bounded. A failed 'runto' pins the actor in THINK_RUNNER, so
	//BOTH of the original waits here are unbounded: this distance loop never converges, and the
	//'waittill turndone' that followed could never fire (Unregister(STRING_TURNDONE) lives only
	//in Actor::IdleTurn, which no runner think calls). Cap the approach and use the fixed wait
	//Ritual themselves substituted at the box1 pickup instead of the turndone.
	local.ap = 0
	while (vector_length($jeeppassenger.origin - local.runto) > 30 && local.ap < 12){
		wait 0.1
		local.ap = local.ap + 0.1
	}
	if (local.ap >= 12){
		println( "^~^~^ E3L4P jeeppassenger approach timed out - continuing" )
	}

	$jeeppassenger turnto $startjeep
	wait 0.5
	$jeeppassenger waitthread crateDeliver $cratepath $bunker1passengernode 0 "passenger_enter0 1"

	local.jeepfront = -180 * (angles_toforward $startjeep.angles)
	local.jeepright =  180 * (angles_toleft $startjeep.angles)
	local.runto 	= $startjeep.origin + local.jeepfront + local.jeepright
	$jeeppassenger runto local.runto

	//[user 2026-08-04] bug-1368 - bounded; an unpathable 'runto' never converges here.
	local.aq3 = 0
	while (vector_length($jeeppassenger.origin - local.runto) > 30 && local.aq3 < 12){
		wait 0.1
		local.aq3 = local.aq3 + 0.1
	}
	if (local.aq3 >= 12){ println( "^~^~^ E3L4P reposition timed out - continuing" ) }

	waitthread passengerGetInWillys $startjeep $jeeppassenger	//[user 2026-08-04] bug-1369
	level.e3l4_delThrP = NULL
	level.passengerdonedelivery = 1
}end

//=========================================================================
crateDeliver local.path local.pathcomplete local.doneDelay local.tag:
//=========================================================================
{
	self anim crate_pickup2
	self waittill animdone
	
	local.nextNode 		= local.path
	local.pathComplete 	= 0
	
	while (local.pathComplete == 0){
		self turnto local.nextNode
		self waittill turndone

		//[user 2026-08-04] bug-1376 - BOUNDED. This is the loop the player actually got stuck on:
		//'the passenger with his box is stuck walking into the willys jeep'. crate_walk is an ANIM,
		//so the actor advances only by animation motion - walk him into a solid vehicle and he
		//treads on the spot forever, never closing to 20 units, so pathComplete never sets, his
		//done-flag never sets, and the jeep never departs. The earlier sweep bounded the N=30 and
		//N=150 loops but MISSED this N=20 one. On timeout, give up on this node and move to the
		//next so the delivery still finishes.
		local.cw = 0
		while (vector_length (self.origin - local.nextNode.origin) > 20 && local.cw < 12){
			self anim crate_walk
			wait 0.1
			local.cw = local.cw + 0.1
		}
		if (local.cw >= 12){
			println( "^~^~^ E3L4P " + self.targetname + " crate node blocked - skipping to next" )
		}
		
		if (local.nextNode.targetname == local.pathcomplete.targetname){
			local.pathComplete = 1
			// dprintln ( self.targetname + " at target" )
		}
		local.nextNode = local.nextNode.target
	}	
	
	self anim crate_putdown2
	self waittill animdone
	
	// dprintln ( self.targetname + " put down the crate" )
	wait local.doneDelay		
}end

//=========================================================================
PlayerGetOnJeepTurret:
//=========================================================================
{
	if (level.playeronjeep == 0){
		//[user 08-02] REWRITTEN - this is why players were ejected from the jeep .30cal at map start.
		//The retail call was "$startjeep doUse $player[N]", which lands in Vehicle::DriverUse
		//(fgame/vehicle.cpp). That function picks the nearest slot and then does:
		//    if (g_gametype->integer == GT_SINGLE_PLAYER || min_type == 2) { switch (min_type) ... }
		//so in coop (gametype 2) ONLY min_type 2 (the DRIVER slot) is honoured - turret (1) and
		//passenger (0) are skipped ENTIRELY, with no error printed. Because the line above teleported
		//the player onto the turret origin first, min_type resolved to 1 every time, the switch was
		//skipped, and the player stood unattached on the MG until the first "$startjeep drive" slid
		//the vehicle out from under them.
		//attachturretslot has no gametype gate, so use the shipped recipe from maps/m1l3b.scr
		//(unlock -> attachturretslot -> perferredweapon -> lock -> forcelegsstate). The
		//forcelegsstate is REQUIRED: the slot attach sets no player-side turret state (bug-309) and
		//the gunner T-poses without it.
		//Also: the old loop teleported EVERY player to the SAME origin, which is a telefrag waiting
		//to happen. Only the gunner moves now; everyone else stays put.
		$startjeep.turret = $startjeep queryturretslotentity 0
		$startjeep unlock		//MiaCosa @Chrissstrahl
		$startjeep.turret unlock

		local.gunner = NULL
		local.ji = 1
		while (local.ji <= $player.size){
			if ($player[local.ji] != NULL && isAlive $player[local.ji]){
				local.gunner = $player[local.ji]
				local.ji = $player.size + 1
			} else {
				local.ji++
			}
		}

		if (local.gunner != NULL){
			local.gunner notsolid
			local.gunner.origin = $startjeep.turret.origin
			$startjeep attachturretslot 0 local.gunner
			local.gunner perferredweapon ".30cal Machine Gun"
			local.gunner forcelegsstate COOP_TURRET_MAN_F
			level.coop_e3l4JeepGunner = local.gunner
		}

		$startjeep lock
		$startjeep.turret lock
	}
	level.playeronjeep = 1
}end

//=========================================================================
PlayerGetOffJeepTurret:
//=========================================================================
{
	if (level.playeronjeep == 1){
		//unlock the jeep and turret
		$startjeep.turret = $startjeep queryturretslotentity 0
		$startjeep unlock		//MiaCosa @Chrissstrahl
		$startjeep.turret unlock

		//[user 08-02] dismount via detachturretslot with an EXPLICIT exit position - "doUse" cannot
		//release a turret occupant in coop for the same gametype reason as the mount above, and
		//detachturretslot must never be handed vec_zero (that is the crew-eject path).
		if (level.coop_e3l4JeepGunner != NULL && level.coop_e3l4JeepGunner != NIL){
			//[user 2026-08-04] bug-1367 - EXIT BESIDE THE JEEP, NOT ON TOP OF IT.
			//This used to be ( $startjeep.origin + (0 0 80) ), copied from maps/t2l2.scr:1468. That
			//is 80 units straight UP, i.e. onto the jeep's roof. It is survivable in t2l2 because
			//that ride is OVER - the player drops off the stationary jeep onto the ground. Here at
			//Bunker2 the very next line threads JeepDriveAwayToBunker3, so the jeep departs with the
			//player marooned on its roof: "I get detached from the jeep, and now im stuck standing
			//on it". Step out to the RIGHT of the hood at near-ground height instead, and set the
			//origin explicitly afterwards so the dismount cannot leave the player parented above.
			//[user 2026-08-04] bug-1370 - exit on the AUTHORED dismount tag, not an invented offset.
			//v1 used ( origin + (0 0 80) ) = the jeep's roof (bug-1367). v2 used a 96-unit lateral
			//offset, which is an arbitrary guess about free space: at the Bunker2 stop it can drop
			//the player inside the bunker wall, hence "i get dropped off and the jeep drives off,
			//but im stuck standing here" - released correctly (VDETACH fired, GUNNERPROBE stopped)
			//yet wedged in geometry. "passenger_enter" is the spot the artist placed for getting in
			//and out of this exact vehicle, is guaranteed walkable, and is the same tag
			//passengerGetInWillys boards on. Verified present on models/vehicles/willys/baseframe.skd.
			local.jexit = $startjeep gettagposition "passenger_enter"
			if (!local.jexit){
				local.jexit = $startjeep.origin - ( 96 * ( angles_toleft $startjeep.angles ) )
			}
			local.jexit = local.jexit + (0 0 8)
			$startjeep detachturretslot 0 local.jexit
			level.coop_e3l4JeepGunner solid
			level.coop_e3l4JeepGunner forcelegsstate STAND	//[221] release the forced manning pose
			level.coop_e3l4JeepGunner.origin = local.jexit
			println( "^~^~^ E3L4 JEEP DISMOUNT: gunner placed at " + local.jexit )
			level.coop_e3l4JeepGunner = NULL
		}

		$startjeep lock
		$startjeep.turret lock

		local.jangles 	= $startjeep.angles
		local.jangles[0] = 0
		local.jangles[2] = 0
		local.jv = 1
		while (local.jv <= $player.size){
			$player[local.jv].viewangles = local.jangles		//MiaCosa - set all players' viewangles
			local.jv++
		}
	}
	level.playeronjeep = 0
}end

//=========================================================================
handlePlayerExit:
//=========================================================================
{
	$startjeep unlock		//MiaCosa @Chrissstrahl
	$startjeep.turret unlock
	$startjeep doUse player
	$startjeep.turret lock
	$startjeep lock
	//[user 08-02] TRAPS T5: bare $player is an ARRAY with 2+ players and throws on cast.
	for (local.va = 1; local.va <= $player.size; local.va++){
		if ($player[local.va] != NULL){ $player[local.va].viewangles = "0 0 0" }
	}
}end

//=========================================================================
truckExplode:
//=========================================================================
{
	local.vel  = self.velocity
	local.type = "green"

	self show
	self playsound explode_truck
	exec global/earthquake.scr .2 4 0 0	

	local.explosion1 		= spawn script_model model models/fx/fx_truck_explosion.tik
	local.explosion1.origin = self.origin + (0 0 100)
	local.explosion1.angles = self.angles
	local.explosion1 scale 0.5
	local.explosion1 anim start
	local.explosion1 notsolid
	wait .4
			
	self playsound explode_truck
	exec global/earthquake.scr .2 4 0 0	

	local.explosion2 		= spawn script_model model models/fx/fx_truck_explosion.tik
	local.explosion2.origin = self.origin + (0 0 100)
	local.explosion2.angles = self.angles
	local.explosion2 anim start
	local.explosion2 notsolid

	if (self.collisionent != NULL){
		self.collisionent disconnect_paths
	}

	local.name 	 = self
	local.angles = self.angles
	local.origin = self.origin
	self remove
	
	level.destroyedTruck = thread spawn_damaged_new models/vehicles/gmctruck.tik local.angles local.origin
	level.destroyedTruck notsolid
	level.destroyedTruck waitthread newToss
	thread smokingWreckage
	
	//	wait 0.1
	local.explosion1 remove
	local.explosion2 remove
}end 

//=========================================================================
newToss:
//=========================================================================
{
	//	self setcollisionentity $gmccollision
	self physics_on
	self.velocity 	= (000 000 600)  
	local.avelocity = (0 120 60)
		
	self RotateX local.avelocity[0]
	self RotateY local.avelocity[1]
	self RotateZ local.avelocity[2]

	self thread ditchSupplies
	self playsound explode_truck
	exec global/earthquake.scr .2 4 0 0	

	local.explosion1 		= spawn script_model model models/fx/fx_truck_explosion.tik
	local.explosion1.origin = self.origin + (0 0 100)
	local.explosion1.angles = self.angles
	local.explosion1 anim start
	local.explosion1 notsolid
	wait .75

	local.explosion1 remove
	
	for (local.i = 1; local.i <= 4; local.i++){
		$bunker1supplies[local.i] solid
	}
		
	self solid
	//	self RotateX 0
	wait .5

	self RotateY 0
	self RotateZ 0 
}end

//=========================================================================
smokingWreckage:
//=========================================================================
{
	level.gmcsmoke = spawn "models/emitters/linger_smoke.tik"
	level.gmcsmoke.origin = $gmcsmoke.origin
	level.gmcsmoke notsolid
	level.gmcsmoke anim start
}end

//=========================================================================
ditchSupplies:
//=========================================================================
{
	wait .25
	
	$bunker1supplies[1] waitthread tossSupplies self ( -200 300 400 ) self.origin
	$bunker1supplies[2] waitthread tossSupplies self ( -400 400 300 ) ( self.origin + ( 50 0 0 ) )
	$bunker1supplies[3] waitthread tossSupplies self ( -100 500 300 ) (self.origin + ( -50 0 0 ) )
	$bunker1supplies[4] waitthread tossSupplies self ( -400 150 400 ) (self.origin + ( 0 50 0 ) )
}end

//=========================================================================
tossSupplies local.truck local.vel local.startpos:
//=========================================================================
{
	self show
	self physics_on
	self.origin = local.startpos
	self.velocity = local.vel	
}end

//=========================================================================
spawn_damaged_new local.model local.angles local.origin:
//=========================================================================
{
	local.damaged 		 = spawn script_model model local.model
	local.damaged.origin = local.origin
	local.damaged.angles = local.angles
}end local.damaged

//=========================================================================
startSirens:
//=========================================================================
{
	for (local.i = 1; local.i <= $siren.size; local.i++){
		$siren[local.i] thread PlayAlarmSound
	}
}end

//=========================================================================
PlayAlarmSound: 
//=========================================================================
{
	while(1) {
		//$player playsound den_m2l2_258b		//MiaCosa
		exec coop_mod/replace.scr::playsound den_m2l2_258b			

		local.mgbp = exec coop_mod/replace.scr::player_closestTo self
		if (local.mgbp == NULL){ local.mgbp = exec coop_mod/replace.scr::player_anyValid }
		if(local.mgbp != NULL && (vector_length (local.mgbp.origin - self.origin) < 1024)) {		//MiaCosa @chrissstrahl
			self playsound den_m2l2_258p 
		} 
		wait 1 
	} 
}end

