//////////////////////////////////PLAYER HALFTRACK/////////////////////////////////////////

PLAYER_JEEP_Drive:
// drive Vector position, Float speed, Float acceleration, Float reach_distance, Float look_ahead, [ Vector alternate_position ]

//half track first path then pausing on cliff

	wait 6
	//HZM coop - don't drive off until a gunner has boarded (or a short grace period
	//elapses, so the ride still starts even if nobody mounts). coop_setup/coop_playerSpawned
	//set level.coop_inJeep when a player takes the turret.
	if( level.gametype != 0 ){
		local.coopWaitFrames = 0
		while( (level.coop_inJeep == NIL || level.coop_inJeep == 0) && local.coopWaitFrames < 600 ){
			waitframe
			local.coopWaitFrames += 1
		}
	}
	waitthread coop_seatShield 2 6		//HZM coop: shield halftrack passengers across the launch
	self drive $jeepfirstpath 250
	self modifydrive 250 100 256
	self waitTill drive
	self stop
	
	//HACk
	self health 10000

	//dprintln "PAUSING ON CLIFF**************"
	self moveanim 22P100_Hafltrack_wobble
	//wait 5
	self waittill animdone
	wait 10
	


	
//we's about to have ourselves an accident... 
	
	exec coop_mod/replace.scr::playsound halftrack_bounce03 // HZM coop - broadcast to all players
	waitthread coop_seatShield 2 6		//HZM coop: the big downhill launch (900/700) - shield passengers hard
	self drive $halfdownhill
	self modifydrive 900 700 256
	self waittill drive
	self stop
	wait 2

	
//reverse drive	
	//dprintln "go in reverse******************"
	waitthread coop_seatShield 2 6		//HZM coop: shield across the reverse launch
	self drive $halfpath2 level.reversespeed 150 200 256 //-200 -100 256
	self waittill drive
	self stop
	wait 7

//forward again
	//dprintln "path GOING FORWARD"
	self drive $halfpath3 250 
	self modifydrive 255 100 256
	self waittill drive
	self stop
end

//triggered explosions

triggerexplode:
	self waittill trigger
	//dprintln "********triggerexplode got triggered"
	//HZM coop - SP only fired these route ambience explosions when the host ($player)
	//touched. In coop accept ANY active player OR the player halftrack as the toucher.
	local.validToucher = 0
	if( level.gametype == 0 ){
		if( parm.other == $player ){ local.validToucher = 1 }
	}else{
		local.toucher = parm.other
		if( local.toucher != NULL ){
			if( level.playerjeep != NULL && local.toucher == level.playerjeep ){ local.validToucher = 1 }
			for( local.i = 1; local.i <= $player.size; local.i++ ){
				local.pl = $player[local.i]
				if( local.pl != NULL && local.toucher == local.pl && local.pl.dmteam != "spectator" ){
					local.validToucher = 1
				}
			}
		}
	}

	if (local.validToucher == 1)
	{
		if (self.target != NIL)
		{
			exec global/model.scr self.target.origin self.target.model
		}
	}
	else
	{
		println "**** by non-player"
	}
end

/////////////////////////////////The supply truck takin' it////////////////////////////////////////

check_truck_death:


        if (isalive $s1_truck1)
	$s1_truck1 waittill death 
	//22a222_DeathTruck
	local.offset = $s1_truck1.origin
	local.offset[2]+=128
	radiusdamage local.offset 200 200
	iprintln "The Supply Truck has been Destroyed - Mission Failed."
	wait 3
	exec coop_mod/replace.scr::missionfailed // HZM coop - coop-safe mission fail

end

//=========================================================================
// HZM coop - halftrack (player ride + spawn point) loss = Mission Failed -> clean restartMap, mirroring
// the supply-truck fail (check_truck_death). jeep_death_watch = truck-style 'waittill death' (fires if the
// halftrack is ever solid+damageable and destroyed); jeep_gone_watch = fires if it is removed/vanishes
// (level.playerjeep -> NULL). Either way we restart cleanly instead of stranding players on orphaned seats.
// jeep_fail has a once-guard so the two watchers can't double-restart.
//=========================================================================
check_jeep_death:
	thread jeep_death_watch
	thread jeep_gone_watch
end

jeep_death_watch:
	if (isalive $s1_jeep1)
	$s1_jeep1 waittill death
	thread jeep_fail
end

jeep_gone_watch:
	while( level.playerjeep != NULL ){ wait 0.5 }
	thread jeep_fail
end

jeep_fail:
	if( level.coop_jeepFail == 1 ){ end }
	level.coop_jeepFail = 1
	if( level.playerjeep != NULL ){
		local.offset = level.playerjeep.origin
		local.offset[2] += 128
		radiusdamage local.offset 200 200
	}
	iprintln "The Halftrack has been Destroyed - Mission Failed."
	wait 3
	exec coop_mod/replace.scr::missionfailed // HZM coop - coop-safe mission fail -> restart
end

nolight:
	wait 1.5
	$s1_truck1 vehicleanim idlenolights
	$s1_truck1.corona = 0
end

endlevel:
	//HZM coop - coop-safe END CUTSCENE + mission end. Unglue everyone (so missioncomplete's transition is
	//clean), then put ALL players' views on the closing camera (cuecamera broadcasts to every client), hide
	//their bodies, hold, fade, and complete. Was: SP fadeout + missioncomplete only (no all-player cutscene).
	if( level.gametype != 0 ){
		waitthread coop_releaseAllFromJeep
	}
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.dmteam != "spectator" ){
			local.p freezecontrols 1
			local.p hide
		}
	}
	if( $watchcamerab != NULL && $t2l2camerab != NULL ){
		$watchcamerab movetopos $t2l2camerab.origin
		$watchcamerab watch $lookatb 0
		$watchcamerab cut
		cuecamera $watchcamerab
	}
	waitthread global/objectives.scr::add_objectives 1 3
	wait 7
	fadeout 9 0 0 0 1
	exec global/missioncomplete.scr t2l3 1
end

//later...

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// HZM COOP - PATTERN B HALFTRACK SEATING (ported/adapted from m1l3b.scr 1140-1336)
// $s1_jeep1 / level.playerjeep is the driveable halftrack. One player mans the
// turret (slot 0); extra players are glued to passenger-dummy script_models.
// Seat list extended from m1l3b's 8 to 16 (playerAttach2..16).
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

//=========================================================================
coop_setup:
//=========================================================================
	//HZM coop - FIX: seat the players who are ALREADY present. waitForPlayer spawned them BEFORE this
	//thread started, so the initial 'playerspawn' was missed and nobody manned the cannon (halftrack drove
	//empty). Wait for coop_setupAttach to finish spawning the passenger dummies, then do an initial seat.
	println "^~^~^ T2L2 coop_setup: reached (main passed waitForPlayer) - seating begins"
	if( level.playerjeep == NULL ){
		println "^~^~^ T2L2 coop_setup: ABORT - halftrack (level.playerjeep) is NULL"
		end
	}
	level.coop_seatCount = 16		//seat 1 = cannon; 2-6 = halftrack bed; 7-16 = truck bed
	//Spawn the passenger dummies on BOTH vehicles first (needs seat count + both vehicles), then the cannon.
	//The game.dll DropToFloor fix runs PlaceTurret for this post-level turret so the STOCK eye-bone camera
	//is correct (down the barrel). coop_playerSpawned mounts player 1 on it.
	waitthread coop_setupAttach
	level.playerjeep spawnturret 0 "vehicles/PzB41_turret.tik"
	println ("^~^~^ T2L2 coop_setup: jeep=" + level.playerjeep + " turretSlot0=" + (level.playerjeep queryturretslotentity 0))
	wait 1
	//HZM coop - give the script-spawned cannon the auto-name the map's cutscenes expect ($s1_jeep1_turret0).
	//The tik 'spawnturret' (which would auto-name it) nulls the vehicle in MP, so we script-spawn + name it here;
	//without the name the map's turret camera-posing (savethread/triggercamera) hits a NULL listener + errors.
	local.t0 = level.playerjeep queryturretslotentity 0
	if( local.t0 != NULL ){ local.t0.targetname = "s1_jeep1_turret0" }
	thread coop_playerSpawned
	//re-seat on every (re)spawn so respawners land back in THEIR seat + late joiners get one
	while (1){
		level waittill playerspawn
		thread coop_playerSpawned
	}
end

//=========================================================================
coop_setupAttach:
//=========================================================================
	//Seat table (F5-tunable). Seat 1 = halftrack cannon (turret slot 0). Seats 2-6 = HALFTRACK bed,
	//seats 7-16 = TRUCK bed. Each seat stores its vehicle + tag + offset so the initial attach, the F5
	//re-attach, and the save-dump all read ONE source. Seats 2-4 ride the halftrack passenger1/2/3 tags,
	//seats 5-6 are the two EXTRA halftrack seats off passenger1/2, seats 7-16 ride the truck's passenger0.
	//ALL offsets below are BAKED from live F5 tuning; F5 + numpad can still re-tune any bed seat (2-16).
	for( local.i = 2; local.i <= level.coop_seatCount; local.i++ ){
		local.ent = spawn script_model model "models/fx/dummy.tik" targetname ("playerAttach"+local.i) notsolid 1
		waitframe
		if( local.i <= 6 ){
			level.coop_seatVeh[local.i] = level.playerjeep
			if( local.i == 2 ){
				level.coop_seatTag[local.i] = "passenger1"
				level.coop_seatOff[local.i] = ( 28 -20 -20 )
			}else if( local.i == 3 ){
				level.coop_seatTag[local.i] = "passenger2"
				level.coop_seatOff[local.i] = ( 60 16 -20 )
			}else if( local.i == 4 ){
				level.coop_seatTag[local.i] = "passenger3"
				level.coop_seatOff[local.i] = ( -4 16 -24 )
			}else if( local.i == 5 ){
				level.coop_seatTag[local.i] = "passenger1"
				level.coop_seatOff[local.i] = ( -40 -20 -24 )
			}else{
				level.coop_seatTag[local.i] = "passenger2"
				level.coop_seatOff[local.i] = ( -84 16 -20 )
			}
		}else{
			level.coop_seatVeh[local.i] = level.truck
			level.coop_seatTag[local.i] = "passenger0"
			//fallback grid (safety net); baked per-seat positions below override 7-16
			local.j = local.i - 7
			local.row = int( local.j / 3 )
			local.col = local.j % 3
			local.back = 0 - ( local.row * 40 )
			local.side = -40 + ( local.col * 40 )
			local.up = 0
			level.coop_seatOff[local.i] = ( (local.back) (local.side) (local.up) )
			if( local.i == 7 ){ level.coop_seatOff[local.i] = ( 12 4 -28 ) }
			else if( local.i == 8 ){ level.coop_seatOff[local.i] = ( -24 -20 -4 ) }
			else if( local.i == 9 ){ level.coop_seatOff[local.i] = ( -68 -20 0 ) }
			else if( local.i == 10 ){ level.coop_seatOff[local.i] = ( -44 12 12 ) }
			else if( local.i == 11 ){ level.coop_seatOff[local.i] = ( -116 -8 0 ) }
			else if( local.i == 12 ){ level.coop_seatOff[local.i] = ( -148 8 0 ) }
			else if( local.i == 13 ){ level.coop_seatOff[local.i] = ( -148 56 8 ) }
			else if( local.i == 14 ){ level.coop_seatOff[local.i] = ( -80 12 16 ) }
			else if( local.i == 15 ){ level.coop_seatOff[local.i] = ( -188 48 0 ) }
			else if( local.i == 16 ){ level.coop_seatOff[local.i] = ( -32 36 4 ) }
		}
		if( level.coop_seatVeh[local.i] != NULL ){
			local.ent attach level.coop_seatVeh[local.i] level.coop_seatTag[local.i] 0 ( level.coop_seatOff[local.i] )
		}
	}
end

//=========================================================================
coop_jeepNotOccupied:
//=========================================================================
	//mark turret free; offer "press USE to enter" to any nearby player until one boards
	if( level.playerjeep == NULL ){ end }	//HZM coop - no vehicle: don't loop on a NULL jeep (was spamming 'Cannot cast none' every frame)
	level.coop_inJeep = 0
	while(!level.coop_inJeep){
		for(local.i=1;local.i <= $player.size;local.i++){
			local.player = $player[local.i]
			if(isAlive local.player && !local.player.isSpectator){
				if(vector_within level.playerjeep.origin local.player.origin 1500){
					if(local.player.useheld){
						thread coop_playerForceToJeep local.player
						goto stopJeepHud
					}else if( local.player.flags["coop_hudPeTeJ"] == NIL){
						local.player.flags["coop_hudPeTeJ"] = 1
						local.player stufftext "ui_addhud coop_jeepEnter"
					}
				}else{
					if(local.player && local.player.flags["coop_hudPeTeJ"] != NIL){
						local.player stufftext "ui_removehud coop_jeepEnter"
						local.player.flags["coop_hudPeTeJ"] = NIL
					}
				}
			}
		}
		waitframe
	}
stopJeepHud:
	for(local.i=1;local.i <= $player.size;local.i++){
		local.player = $player[local.i]
		if(local.player && local.player.flags["coop_hudPeTeJ"] != NIL){
			local.player stufftext "ui_removehud coop_jeepEnter"
			local.player.flags["coop_hudPeTeJ"] = NIL
		}
	}
end

//=========================================================================
coop_playerJustDied:
//=========================================================================
	//KEEP the player's seat (coop_seatTaken/coop_seatIdx) so they respawn back into it via coop_playerSpawned.
	//Just unglue the corpse (so the death body isn't stuck to the moving vehicle) + clear the cannon flag so
	//the gunner re-mounts on respawn.
	local.player = parm.other
	if( local.player == NULL || local.player.targetname == "world" ){ end }
	if( local.player.flags["coop_inJeep"] ){ local.player.flags["coop_inJeep"] = game.false }
	local.player unglue
end

//=========================================================================
coop_playerJustLeft:
//=========================================================================
	//free the seat of the player who left (parm.other) so a late-joiner can claim it
	local.gone = parm.other
	if( local.gone != NULL && local.gone.flags["coop_seatIdx"] != NIL ){
		level.coop_seatTaken[ local.gone.flags["coop_seatIdx"] ] = NIL
		local.gone.flags["coop_seatIdx"] = NIL
	}
end

//=========================================================================
coop_playerForceToJeep local.player:
//=========================================================================
	//put a player on the halftrack turret (slot 0)
	level.coop_inJeep = 1
	if(!local.player.flags["coop_inJeep"]){
		local.player.flags["coop_inJeep"] = game.true

		local.player notsolid

		local.vturretent = level.playerjeep queryturretslotentity 0
		local.vturretent unlock
		level.playerjeep attachturretslot 0 local.player    // Attach the player to the halftrack gun
		local.player perferredweapon ".30cal Machine Gun"
		local.vturretent lock
	}
end

//=========================================================================
coop_playerSpawned:
//=========================================================================
	//HZM coop - player 1 mans the halftrack CANNON (turret slot 0, .30cal MG, engine-driven = fully
	//functional); players 2+ glue into the SUPPLY TRUCK BED (stuck but free to aim/fire/CROUCH). Runs on the
	//initial seat + every (re)spawn; coop_playerJustDied clears the gunner flag so player 1 re-mounts on respawn.
	if( level.playerjeep == NULL ){
		println "^~^~^ T2L2 coop_playerSpawned: ABORT - halftrack (level.playerjeep) is NULL"
		end
	}
	level.coop_inJeep = 1
	level.playerjeep notsolid
	//HZM coop - truck NOT forced notsolid anymore: its $opelcollision proxy (set in main) already excludes the bed, so passengers don't collide with it while it stays shootable by enemies.
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.player = $player[local.i]
		if( !isAlive local.player || local.player.isSpectator ){ continue }
		local.player notsolid
		//assign a PERSISTENT seat if this player has none yet (lowest free seat; seat 1 = cannon to first claimer)
		if( local.player.flags["coop_seatIdx"] == NIL ){
			for( local.s = 1; local.s <= level.coop_seatCount; local.s++ ){
				if( level.coop_seatTaken[local.s] == NIL ){
					level.coop_seatTaken[local.s] = local.player
					local.player.flags["coop_seatIdx"] = local.s
					local.s = level.coop_seatCount + 1		//break: seat claimed
				}
			}
		}
		local.seat = local.player.flags["coop_seatIdx"]
		if( local.seat == NIL ){ continue }		//overflow: more players than seats
		//SEAT 1 = CANNON (turret slot 0, .30cal, engine-driven)
		if( local.seat == 1 ){
			if( !local.player.flags["coop_inJeep"] ){
				local.player.flags["coop_inJeep"] = game.true
				local.vturretent = level.playerjeep queryturretslotentity 0
				println ("^~^~^ T2L2 seat1 cannon: turretSlot0=" + local.vturretent)
				if( local.vturretent != NULL ){
					local.vturretent unlock
					level.playerjeep attachturretslot 0 local.player
					local.player perferredweapon ".30cal Machine Gun"
					local.vturretent lock
				}else{
					local.player origin ( level.playerjeep.origin + ( 0 0 60 ) )
					local.player glue level.playerjeep
				}
			}
		}
		//SEATS 2..16 = BED. duckableglue (not plain glue) so passengers can CROUCH while pinned to the seat -
		//engine gates crouch-while-glued on the duckable flag (Entity::glue can_duck / Player::CondCrouch).
		else{
			local.attach = $("playerAttach" + local.seat)
			if( local.attach != NULL ){
				local.player origin local.attach.origin
				local.player.velocity = local.attach.velocity
				local.player duckableglue local.attach
				local.player notsolid		//HZM coop: riders stay NOTSOLID (protected cargo). Solid riders die to ride/world physics while glued to a fast scripted vehicle - reverted.
			}else{
				println ("^~^~^ T2L2 seat" + local.seat + ": dummy playerAttach" + local.seat + " missing")
			}
		}
	}
end

//=========================================================================
coop_releaseAllFromJeep:
//=========================================================================
	//unglue passengers and detach the gunner at the end of the ride
	level.coop_inJeep = 0
	local.vturretent = level.playerjeep queryturretslotentity 0
	if( local.vturretent != NULL ){
		local.vturretent unlock
		level.playerjeep detachturretslot 0 ( level.playerjeep.origin + (0 0 80) )
	}
	for(local.i=1;local.i <= $player.size;local.i++){
		local.player = $player[local.i]
		if(local.player != NULL){
			if(local.player.flags["coop_inJeep"]){
				local.player.flags["coop_inJeep"] = game.false
			}
			local.player unglue
			local.player solid
		}
	}
end

//=========================================================================
coop_giveAmmo:
//=========================================================================
	//keep the gunner and any armed passengers topped up
	while(1){
		//backup: free any seat whose occupant disconnected (SafePtr went NULL) so a late-joiner can claim it
		if( level.coop_seatCount != NIL ){
			for( local.s = 1; local.s <= level.coop_seatCount; local.s++ ){
				if( level.coop_seatTaken[local.s] != NIL ){
					if( level.coop_seatTaken[local.s] == NULL ){
						level.coop_seatTaken[local.s] = NIL
					}
				}
			}
		}
		for(local.i=1;local.i <= $player.size;local.i++){
			local.player = $player[local.i]
			if( local.player != NULL && local.player.dmteam != "spectator" && local.player.health > 0 ){
				local.player ammo rifle 100
				local.player ammo mg 100
				local.player ammo smg 100
				local.player ammo pistol 100
				local.player ammo heavy 100
				local.player ammo grenade 100
			}
		}
		wait 30
	}
end

// stub handlers - called by coop framework on player events (player passed as parm.other)
coop_playerJustSpawned:
	local.player = parm.other
	if( local.player == NULL || local.player.targetname == "world" ){ end }
	local.player.flags["coop_medkits"] = 3		//HZM coop - t2l2: start every player with 3 usable health packs
end

coop_playerJustRespawned:
	local.player = parm.other
	if( local.player == NULL || local.player.targetname == "world" ){ end }
	local.player.flags["coop_medkits"] = 3		//HZM coop - t2l2: refill to 3 health packs on respawn
end

