	//dprintln "TRUCK speed 255 100 256"
	wait 9
	waitthread coop_seatShield 7 16		//HZM coop: shield truck passengers across the launch (snap-to-path + hard accel)
	self drive $truckpath1
	self modifydrive 255 100 256
	self waitTill drive
	//self stop
	//dprintln "The truck has stopped**************"
	//wait 3



//truck switch to path2
	
