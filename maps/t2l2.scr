//=========================================================================
// HZM coop - reusable "seat shield": a glued SOLID passenger can be telefragged when its vehicle SNAPS to a
// path / hard-accelerates (truck + halftrack are both scripted rails). Call `waitthread coop_seatShield <lo>
// <hi>` right BEFORE each vehicle drive/launch to make those seats notsolid across the lurch; it auto-restores
// them ~3s later (steady driving never crushes, so passengers are damageable the rest of the time).
coop_seatShield local.lo local.hi:
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_seatIdx"] != NIL ){
			local.s = local.p.flags["coop_seatIdx"]
			if( local.s >= local.lo && local.s <= local.hi ){ local.p notsolid }
		}
	}
	thread coop_seatUnshield local.lo local.hi
end

coop_seatUnshield local.lo local.hi:
	local.stamp = level.time
	level.coop_shieldStamp[local.lo] = local.stamp
	wait 3		//re-solid after the lurch settles, unless a newer shield for this seat-group superseded us
	if( level.coop_shieldStamp[local.lo] == local.stamp ){
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p != NULL && local.p.flags["coop_seatIdx"] != NIL && local.p.health > 0 ){
				local.s = local.p.flags["coop_seatIdx"]
				if( local.s >= local.lo && local.s <= local.hi ){ local.p notsolid }
			}
		}
	}
end

