debughealth:
	local.hack = 0
	local.health = self.health
	//println ( "debughealth: " + local.health)
	while (isalive self)
	{
		if (local.health != self.health)
		{
			//dprintlnbold "tank got hit"
			//println ( "panzer health: " + self.health)
			local.health = self.health
			if (local.hack == 0)
			{
				local.hack = 1
				self.health = self.start_health
			}
		}
		waitframe
	}
	//dprintlnbold ("panzer1 just died")
	//println ("get out is: " + $self.get_out )	
end

//panzer1/////

panzer1:
	//dprintln "STARTING panzer 1"
	$panzer1.start_health = 800
	$panzer1.health = $panzer1.start_health
	//$panzer1.get_out = 0
	$panzer1.accuracy = 50
	$panzer1 thread global/vehicles_thinkers.scr::enemy_tank_think2 0 empty_panzer_winter
	$panzer1.get_out = 0
	$panzer1 thread debughealth
	//println ( "panzer1 health: " + $panzer1.health)
	// HZM coop - $player is an array; target closest player to the panzer
	local.pt = exec coop_mod/replace.scr::player_closestTo $panzer1
	if (local.pt != NULL) { level.playertanktarget = local.pt }
	else { level.playertanktarget = exec coop_mod/replace.scr::player_anyValid } //[DEGRADED-6] fix: any valid player
	$panzer1 thread coop_mod/replace.scr::coop_trackTankTarget // HZM coop - continuous target update
	$panzer1 drive $panzer1path 20 50 256
	$panzer1 waittill drive
	$panzer1 stop
end

