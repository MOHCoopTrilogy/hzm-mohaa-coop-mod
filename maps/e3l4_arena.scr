//=========================================================================
ho_arena_spawn:
//=========================================================================
{
	wait 1
	if( level.coop_ho_arenaN == NIL || level.coop_ho_arenaN < 1 ){
		println( "^~^~^ E3L4_ARENA: no checkpoint authored yet - spawning at the map default" )
		end
	}
	//[user 2026-08-05] bug-1400 - PIN the spawn slots; do NOT teleport anyone. Requested: the arena
	//load-in should behave exactly like coop does today.
	//
	//This used to call main.scr::playersWarpto, whose placement loop (main.scr:619-627) walks EVERY
	//$player and does 'origin' + 'droptofloor' with no spectator check. One second after map start
	//most players are still spectators who have not pressed fire yet, so it dragged their SPECTATOR
	//camera to the checkpoint and dropped it there - the free-floating view the host reported. No
	//coop campaign map warps at map start: you stay a spectator until the fire-click
	//(player.scr:858), then manageAliveSpawning -> playerPlaceAtSpawn places you from spawnlocations.
	//
	//So keep only the half that mattered - playersWarpto's setSpawn branch (main.scr:609-617) - and
	//let the stock coop path do the placing. Pinning is still required because the spawnlocations
	//label is hardcoded to the ORIGINAL checkpoint; re-authoring one with F5 must move the spawn.
	//[bug-1389] coop_ho_ang is a float yaw, so build the vector from a plain local first.
	local.yaw = level.coop_ho_ang[1]
	local.ang = ( 0 local.yaw 0 )
	local.pos = level.coop_ho_pos[1]
	for( local.i = 1; local.i <= 8; local.i++ ){
		level.flags["coop_spawn"+local.i+"angles"] = ( local.ang )
		level.flags["coop_spawn"+local.i+"origin"] = ( local.pos )
	}
	println( "^~^~^ E3L4_ARENA: 8 spawn slots pinned to checkpoint 1 @ " + local.pos )
	println( "^~^~^ E3L4_ARENA arena ready - author with arena_tools.cfg" )
}end

//=========================================================================
// REMOVE EVERY CAMPAIGN ACTOR.                        [user 2026-08-05] bug-1394
// The Init* threads above ai_off/hide the actors each SECTION knows about, but plenty of allied and
// axis AI are spawned by the map itself and simply stand around - the user reported them still
// standing there after the Init sweep. An arena wants an empty stage - the holdout director supplies
// enemies - so sweep the entity table and delete every Actor.
//
// getentbyentnum + .classname is the mod's established runtime scan (coop_mod/wounded.scr:262).
// getentarray is NOT used: it misses whole entity families in this engine (maptest_waypoints.scr:36).
//
// Removing rather than hiding is deliberate: every actor deleted is an entity slot back, and the
// entity pool is the holdout director's primary risk (bugs 914-927 were pool exhaustion).
// Runs AFTER the Init* threads so nothing re-shows a corpse we already dropped.
//=========================================================================
arena_clearActors:{
	wait 2
	local.maxent = int( getcvar "maxentities" )
	if( local.maxent <= 0 ){ local.maxent = 1024 }

	local.gone = 0
	local.ei = 0
	while( local.ei < local.maxent ){
		local.e = getentbyentnum local.ei
		if( local.e != NULL && local.e != NIL ){
			if( local.e.classname == "Actor" ){
				local.e ai_off
				local.e notsolid
				local.e hide
				local.e remove
				local.gone++
			}
		}
		local.ei++
	}
	println( "^~^~^ E3L4_ARENA: removed " + local.gone + " campaign actor(s) - stage is clear" )
}end

//=========================================================================
// UNLOCK EVERY DOOR.                                  [user 2026-08-05] bug-1396
// The Init* threads this script runs LOCK doors for the campaign - Castle.scr locks frontdoor2,
// librarybackdoor and armoireroomdoor, Bunker2 locks jeepgate2 - because the mission gates progress
// on them. In an arena that is just an obstacle: "can we at least make the door open/close?".
//
// Unlocking beats deleting. A removed door leaves a hole and cost a crash to discover; an unlocked
// one still reads as architecture and you can shut it behind you during a wave.
//
// Runtime classnames come from fgame/doors.cpp: SlidingDoor "func_door", RotatingDoor
// "func_rotatingdoor", ScriptDoor "script_door", base Door "NormalDoor". Scanned by entity number
// because these are BRUSH entities and getentarray misses those (maptest_waypoints.scr:36).
//=========================================================================
arena_unlockDoors:{
	wait 3
	//[user 2026-08-05] bug-1396 - OFF BY DEFAULT, and it never could have fixed the door that
	//prompted it. The BSP entity lump has 28 door/gate entities in the whole of e3l4; the nearest one
	//to the arena checkpoint is 'jeepgate' at 1170u (removed), then nothing until 2843u. No entity in
	//the map uses a door MODEL either. The .30cal-room door is therefore baked WORLD brushwork - which
	//is exactly why BACKSPACE reported entity 2046 and why 'unlock' does nothing to it.
	//Kept, because the Init* threads DO lock frontdoor2 / librarybackdoor / armoireroomdoor /
	//jeepgate2, and an arena built in the castle later would be walled in by them.
	//Enable then with:  seta coop_arenaUnlockDoors 1
	if( int( getcvar "coop_arenaUnlockDoors" ) != 1 ){ end }

	local.maxent = int( getcvar "maxentities" )
	if( local.maxent <= 0 ){ local.maxent = 2048 }
	//never touch the world / none slots - removing entity 2046 crashed the game once already (bug-1395)
	local.top = local.maxent - 2

	local.n = 0
	local.ei = 1
	while( local.ei < local.top ){
		local.e = getentbyentnum local.ei
		if( local.e != NULL && local.e != NIL ){
			local.cn = local.e.classname
			if( local.cn == "func_door" || local.cn == "func_rotatingdoor" || local.cn == "script_door" || local.cn == "NormalDoor" ){
				local.e unlock
				local.n++
			}
		}
		local.ei++
	}
	println( "^~^~^ E3L4_ARENA: unlocked " + local.n + " door(s)" )
}end

//=========================================================================
// CAMPAIGN LEFTOVER CLEANUP.                            [user 2026-08-05] bug-1426
// With Tunnel.scr unthreaded its two weapon props have no pickup triggers armed, so they would
// sit in the tunnel as dead scenery pretending to be pickups. Remove them.
//=========================================================================
arena_muteCampaign:
{
	if( $wpnTunnelSTG != NULL )
	{
		$wpnTunnelSTG remove
	}
	if( $wpnTunnelShotgun != NULL )
	{
		$wpnTunnelShotgun remove
	}
}end
