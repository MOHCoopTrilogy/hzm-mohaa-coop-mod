//=========================================================================
// HOLDOUT ARENA - MONTE BATTAGLIA (map name e3l4_arena)
//
// NAMED e3l4_arena, NOT ho_battaglia, and the prefix is load-bearing: every sound alias carries a
// maps "m e t dm obj train" filter, and a map whose name matches none of those tokens loads
// almost NO sounds - the first build was called ho_battaglia and had no footsteps and no
// ambience at all ("coop_amb_forest_night needs an alias in ubersound.scr"). Starting with 'e'
// matches the same token every other Breakthrough map uses.          [user 2026-08-04] bug-1385
//
// A DEDICATED arena map, modelled on the lobby maps (co_lobby1..8): its own name, its own script,
// its own save files. The geometry is a copy of e3l4's BSP shipped as loose files
// (maintt/maps/e3l4_arena.bsp / _sml.bsp / .pth) rather than through build.ps1, so the 32 MB
// never enters the code pk3 that repacks on every deploy.
//
// WHY A SEPARATE MAP AT ALL
//   e3l4 is a campaign mission. While the arena shared its name, every arena save was keyed to
//   "e3l4" - so a normal campaign run loaded 176 invisible barriers and 109 props and deleted the
//   doors the arena had removed (bug-1384). That was patched with a coop_buildmap gate, but a gate
//   is a promise you have to keep re-making. A separate map name makes the collision impossible:
//   walls_e3l4_arena.dat simply is not walls_e3l4.dat.
//
// NO CAMPAIGN RUNS HERE
//   None of e3l4's objective chain, bunkers, jeep sequence, castle or tower is threaded. The level
//   is terrain plus its static entities, and the holdout director supplies all the enemies.
//
// FIVE BAKED SCRIPT REFERENCES survive inside the copied BSP - two door-lock triggers, the chapel
// bong and two battle-zone ambient triggers, all pointing at maps/e3l4/*.scr. They are trigger_use
// entities, so they are inert until touched; delete any that misbehave with the BACKSPACE tool.
//=========================================================================
main:
{
	level.coop_aaMap = 0
	level.coop_btMap = 1
	waitthread coop_mod/main.scr::main		//HZM coop - MUST be first, no waits before it

	//ARENA IDENTITY. Read by wallgun/props/weather/ambience instead of the old coop_buildmap cvar,
	//so arena behaviour follows the MAP rather than a setting the player has to remember to unset.
	level.coop_arenaMap = 1

	//No precipitation: rain leaks through the roofs of the interiors an arena gets built in, because
	//cg_nature's per-drop SURF_SKY gate sees sky above them (bug-1383). coop_arenaAmb picks the bed
	//that replaces the rain - wind | country | forest_night | night_calm | surf.
	level.coop_weatherTheme = "none"

	//WORLD SETUP. These Init* threads are what put the level into its correct pre-mission state -
	//they hide the destroyed/late-mission variants, lock doors, and ai_off every campaign actor. The
	//first build of this script threaded NONE of them, so the map rendered in its raw BSP state
	//(user: "spawns me in a random place looking at the castle that is destroyed at the end").
	//They are pure setup: hide / lock / ai_off, no sequence is started and no objective runs.
	//Turning the campaign AI off is exactly what an arena wants - holdout supplies its own enemies.

	level waittill prespawn

	//[user 2026-08-05] bug-1391 - these run AFTER prespawn. Threading them earlier produced
	//"Script Error : Cannot lock door before level prespawn" x5 from InitCastle's frontdoor
	//locks - the engine refuses door state changes until prespawn has passed.
	thread maps/e3l4/Bunker1.scr::InitBunker1
	thread maps/e3l4/Bunker2.scr::InitBunker2
	thread maps/e3l4/Bunker3.scr::InitBunker3
	thread maps/e3l4/Bunker4.scr::InitBunker4
	//[user 2026-08-05] bug-1426 - Tunnel.scr::Tunnel is NOT threaded. It does no world
	//setup at all - it only arms SP watcher threads: TunnelAutoSave (touch trigger -> SP
	//autosave + the campaign tunnel music the user heard leak in), STG/shotgun pickups
	//($player item on the array) and fake-explosion watchers ($player waittill sounddone
	//on the array). The track itself was promoted to the holdout wave theme instead
	//(holdout.scr::holdout_music). arena_muteCampaign below removes the orphaned props.
	thread maps/e3l4/Castle.scr::InitCastle
	thread maps/e3l4/Tower.scr::InitTower
	thread maps/e3l4/Escape.scr::InitEscape
	thread maps/e3l4/Outro.scr::InitOutro
	thread maps/e3l4/CastleAmbient.scr::InitCastleAmbient

	level waittill spawn

	//SPAWN AT THE ARENA, not wherever the BSP's default player start happens to be. If a checkpoint
	//has been authored, put the squad on it and RE-PIN respawns there (the 1) so dying does not throw
	//anyone back across the map - the same call holdout_run uses when it advances a checkpoint.
	thread ho_arena_spawn
	thread arena_clearActors
	thread arena_muteCampaign
	thread arena_unlockDoors
	thread arena_spawnSounds
	thread arena_curtain
	thread arena_clearGateClips
}end

//=========================================================================
// GATE CLIP BRUSHES.                                   [user 2026-08-05] bug-1405
// Deleting a gate leaves an invisible wall behind, because the gate is TWO things: the visible
// func_rotatingdoor pair, and a separate player-clip brush entity that stops you walking through
// while the door is shut. In the campaign, Bunker2.scr:416 removes that clip
// ($clipB2Gate remove) at the moment the gate opens - a beat inside the objective chain, which
// the arena deliberately never runs. So the doors go and the clip stays.
//
// clipB2Gate is a script_object at (-4368 3432 1176), 151u from the jeepgate2 leaves - and Point
// Baker sits ~500u away, so it is squarely inside the new outpost.
//
// Guarded on BOTH NULL and NIL: a targetname that matches nothing yields NIL, not NULL, and only
// checking one of them is a known way to throw here (see mohaa_script_notes).
//=========================================================================
arena_clearGateClips:{
	wait 1
	if( $clipB2Gate != NULL && $clipB2Gate != NIL ){
		$clipB2Gate remove
		println( "^~^~^ E3L4_ARENA: removed clipB2Gate (invisible wall behind jeepgate2)" )
	}
	else{
		println( "^~^~^ E3L4_ARENA: clipB2Gate not present" )
	}
}end

//=========================================================================
// DEPLOY CURTAIN.                                      [user 2026-08-05] bug-1401
// Black the screen until the player fire-clicks to deploy.
//
// Correction to what I told the user earlier: I said coop has no black screen and that the free
// camera is just MOHAA's native spectator. The spectator part is right - player.scr:858 gates the
// deploy on primaryfireheld and nothing else - but the OBSERVED difference is real. A campaign map
// puts the waiting spectator somewhere unremarkable; e3l4_arena has no MP spawn, so the engine
// falls back to the intermission camera and you sit over the burning castle, free to fly around.
// So rather than chase where the camera sits, cover it: with the screen black it does not matter
// where the camera is or that it can drift, and the load-in reads the way the host expects.
//
// Slots 95/96. NOT 88-90 as the slot map claims are free - fogmode.scr actually holds 88-94, and
// _research/hud_slot_map.md is out of date. A census of every ihuddraw call is the authority.
// Draw pattern copied verbatim from challenges.scr:1746 (shader + virtualsize + align + rect +
// color + alpha), which is the confirmed-working full-screen dim.
//
// TWO deliberate safety choices:
//  * NO freezeplayer. bug-370: freezing before the deploy pinned PMF_FROZEN while the player was
//    still in the spawn crouch and PM_CheckDuck never stood him up - a permanent crouch. The black
//    screen already hides any camera drift, so the freeze buys nothing and risks that.
//  * A HARD 25s failsafe per player. A curtain that fails to lift leaves someone blind with no way
//    to diagnose it, which is far worse than seeing the castle. After 25s it drops for good.
//=========================================================================
arena_curtain:{
	//let the client HUD initialise first - ihuddraw on a just-connected client throws
	//"Failed execution" (player.scr:786-789 documents the same hazard).
	wait 2

	while( 1 ){
		wait 0.2
		local.i = 1
		while( local.i <= $player.size ){
			local.p = $player[local.i]
			if( local.p != NULL ){
				local.wants = 0
				if( local.p.dmteam == "spectator" ){ local.wants = 1 }
				//[user 2026-08-05] bug-1406 - ONLY on the initial join, never on a later spectator
				//transition. The 15:38 log shows exactly why: the idle-spectate feature moved an
				//AFK builder to spectator, this loop dutifully blacked their screen, and only the
				//25s failsafe let them see again. Going idle must not blind you. coop_everActive is
				//set once a player has spawned fully active (player.scr:790 uses it the same way),
				//so it is the clean "has deployed before" test.
				if( local.p.flags["coop_everActive"] == 1 ){ local.wants = 0 }
				if( local.p.flags["coop_arenaCurtainOff"] == 1 ){ local.wants = 0 }

				if( local.wants == 1 && local.p.flags["coop_arenaCurtain"] != 1 ){
					local.p.flags["coop_arenaCurtain"] = 1
					local.p.flags["coop_arenaCurtainT"] = level.time
					ihuddraw_shader      local.p 95 "textures/mohmenu/black.tga"
					ihuddraw_virtualsize local.p 95 1
					ihuddraw_align       local.p 95 left top
					ihuddraw_rect        local.p 95 0 0 640 480
					ihuddraw_color       local.p 95 0 0 0
					ihuddraw_alpha       local.p 95 1

					ihuddraw_virtualsize local.p 96 1
					ihuddraw_align       local.p 96 left top
					ihuddraw_font        local.p 96 "facfont-20"
					ihuddraw_color       local.p 96 1 0.92 0.72
					ihuddraw_rect        local.p 96 252 252 0 0
					ihuddraw_string      local.p 96 "CLICK TO DEPLOY"
					ihuddraw_alpha       local.p 96 1
					println( "^~^~^ E3L4_ARENA curtain UP for " + local.p.netname )
				}
				else if( local.wants == 1 ){
					local.held = level.time - local.p.flags["coop_arenaCurtainT"]
					if( local.held > 25 ){
						local.p.flags["coop_arenaCurtainOff"] = 1
						waitthread arena_curtainDown local.p
						println( "^~^~^ E3L4_ARENA curtain FAILSAFE - 25s, dropping" )
					}
				}
				else if( local.p.flags["coop_arenaCurtain"] == 1 ){
					waitthread arena_curtainDown local.p
					println( "^~^~^ E3L4_ARENA curtain DOWN - deployed" )
				}
			}
			local.i++
		}
	}
}end

//=========================================================================
arena_curtainDown local.p:{
	if( local.p == NULL ){ end }
	local.p.flags["coop_arenaCurtain"] = NIL
	ihuddraw_alpha  local.p 95 0
	ihuddraw_alpha  local.p 96 0
	ihuddraw_string local.p 96 ""
}end

//=========================================================================
// AMBIENT SOUND BED.                                   [user 2026-08-05] bug-1398
// Baked from coop_mod/save/snd_e3l4_arena.dat - 11 emitters the host placed in SOUND build mode.
//
// This bake is REQUIRED, not a convenience. snd_<map>.dat is written as paste-ready script text and
// nothing in the mod ever reads it back: place-and-save leaves the emitters alive only for the rest
// of that session, and the next map load comes up silent. Same recipe as the confirmed-working
// maps/co_lobby4.scr:59 (spawnLobby4Objects), which was itself baked from snd_m1l3c.dat.
//
// 'fx/dummy.tik' resolves to models/fx/dummy.tik in Pak0 - a real but empty model, so the emitter is
// a position with no mesh. That is why nothing is visible at these points; the speaker box the host
// sees while authoring is the SOUND-mode aim ghost (buildmode_sounds.scr:154), never a placed entity.
//
// Weather is off for the arena (level.coop_weatherTheme "none"), so this bed is what replaces the
// rain: wind in the treeline, a light breeze in the low ground, crickets through the bunker area.
// After placing MORE sounds in build mode, re-bake this label from the .dat - it will not reload.
//=========================================================================
arena_spawnSounds:{
	//[user 2026-08-05] REBAKED from save/snd_e3l4_arena.dat - 24 emitters: 22 loops (crickets,
	//wind, small fires) + 2 distant-artillery oneshots. The dat is authoritative;
	//regenerate this whole label from it after every sound-placement session.
	// coop_build SOUND #1 coop_snd_wind_trees  (Wind in Trees, loop vol 0.400 min 528)
	local.m = spawn script_model
	local.m model "fx/dummy.tik"
	local.m.origin = ( -418.705 -4278.151 872.112 )
	local.m notsolid
	local.m loopsound "coop_snd_wind_trees" 0.400 528

	// coop_build SOUND #2 coop_snd_wind_trees  (Wind in Trees, loop vol 0.300 min 400)
