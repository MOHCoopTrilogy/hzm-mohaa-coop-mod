//==========================================================================================================//
// LEVEL:       co_lobby8.bsp   (a copy of e1l4.bsp - Breakthrough "Bizerte Harbor")
// TITLE:       HZM Coop - Post-Mission Lobby #8 (harbor staging between chapter 2 and chapter 3)
// FLOW:        ... m2l3  ->  co_lobby8  ->  briefing/briefing3
// NOTE:        e1l4's own mission script is NOT run here - co_lobby8.scr only keeps the world geometry,
//              then hands off to the shared coop_mod/lobby.scr. Objects/actors below are BAKED from the
//              build-mode capture build_e1l4.dat (25 placements: Higgins boats, cargo netting, Sherman,
//              mortar, bazooka + 14 animated allied soldiers).
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby8.scr"
	level.coop_btMap = 1							// Breakthrough-side level (e-series)
	level.coop_lobbyMap = 1							// marks this as a lobby (gates mission behaviors)

	// --- per-lobby framing for the SHARED lobby framework (coop_mod/lobby.scr reads these) ---
	// captured viewpos (EYE height) in e1l4: 4 player anchors, the static camera, and the next map.
	// yaws normalized mod 360 to positive (recorded 3922/3775/3779/3757/3731 = accumulated spin).
	level.coop_lobbySlotOrg[1] = ( -4305 5943 114 )
	level.coop_lobbySlotYaw[1] = 175
	level.coop_lobbySlotOrg[2] = ( -4302 5763 114 )
	level.coop_lobbySlotYaw[2] = 179
	level.coop_lobbySlotOrg[3] = ( -4356 5568 114 )
	level.coop_lobbySlotYaw[3] = 157
	level.coop_lobbySlotOrg[4] = ( -4380 5394 114 )
	level.coop_lobbySlotYaw[4] = 131
	level.coop_lobbyCamOrg = ( -4529 5976 114 )
	level.coop_lobbyCamYaw = 322
	level.coop_lobbyNextMap = "briefing/briefing3"	// completing this lobby launches the chapter 3 briefing
	level.coop_lobbyMusicTrack = "sound/music/dogs_of_war_main_title.mp3"	// Operation Overlord chapter theme (D-Day/Omaha)
	level.coop_lobbySkipProps = 1					// use OUR baked scene, not the training props

	waitthread coop_mod/main.scr::main				// MUST be first
	level.coop_weatherTheme = "none"				// no dynamic precip in the lobby

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain			// camera, auto-spawn, roster, ready, skins, music, launch
	thread spawnLobby8Objects						// baked build-mode scene
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_e1l4.dat (build-mode capture). 11 static props/vehicles + 14 animated allied actors.
// Origins are e1l4 world coords, so they land exactly where you placed them.
//=========================================================================
