//==========================================================================================================//
// LEVEL:       co_lobby5.bsp   (a copy of m2l1.bsp)
// TITLE:       HZM Coop - Chapter 2 staging lobby (NIGHT, heavy snowstorm) before the first mission
// FLOW:        ... m1l3c -> briefing2 -> co_lobby5 -> m2l1
// NOTE:        m2l1's own mission script (objectives, scripted spawns) is NOT run here; co_lobby5.scr keeps
//              the geometry + hands off to coop_mod/lobby.scr. Baked axis AI were stripped from the bsp.
// MOOD:        NIGHT + pinned heavy blizzard (coop_weatherPin 3) + dark fog; a fire-lit winter camp.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby5.scr"
	level.coop_aaMap = 1
	level.coop_lobbyMap = 1

	// --- per-lobby framing (viewpos grab 2026-07-09; this batch had the CAMERA as the LAST coord) ---
	level.coop_lobbySlotOrg[1] = ( -5356 -1901 982 )
	level.coop_lobbySlotYaw[1] = 281
	level.coop_lobbySlotOrg[2] = ( -5182 -1902 978 )
	level.coop_lobbySlotYaw[2] = 263
	level.coop_lobbySlotOrg[3] = ( -4951 -1897 986 )
	level.coop_lobbySlotYaw[3] = 262
	level.coop_lobbySlotOrg[4] = ( -4793 -1909 957 )
	level.coop_lobbySlotYaw[4] = 252
	level.coop_lobbyCamOrg = ( -5122 -2617 881 )		// LAST coord = camera
	level.coop_lobbyCamYaw = 94
	level.coop_lobbyNextMap = "m2l1"					// completing this lobby launches m2l1
	level.coop_lobbySkipProps = 1

	waitthread coop_mod/main.scr::main

	// NIGHT HEAVY SNOWSTORM (other lobbies use "none"): pinned blizzard. The pin is a cvar; lobby.scr
	// clears it at launch so m2l1 keeps its own weather. coop_weather_snowLook drives the flake look.
	level.coop_weatherTheme = "snow"
	setcvar "coop_weatherPin" "3"						// hold intensity 3 = blizzard (no fluid random walk)

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	// NIGHT look via dark, short-range fog (baked lightmaps are day, so fog + the camp's fire/lantern
	// carry the night mood). Tunable live: $world farplane <dist> / farplane_color ( r g b ).
	$world farplane 1500
	$world farplane_color ( 0.05 0.06 0.10 )
	$world farplane_bias 0.4

	thread coop_mod/lobby.scr::lobbyMapMain
	thread spawnLobby5Objects
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_m2l1.dat - THIS SESSION only (qconsole: this launch = counts 1-13). A fire-lit winter
// camp: tents, crates, campfire + fire emitter, truck, logstack, springfield, mug. Earlier 14-obj segment
// (a prior session) deliberately excluded.
//=========================================================================
