//=========================================================================
// HZM coop - MAP TOUR STUB: BOB: NORMANDY - night village, balcony
// [user 2026-08-05] Holdout-candidate tour (ModDB download, quarantine-extracted). Overrides any
// packaged MP/bot script so the coop framework boots and the map is walkable with our tools.
// The jv_bot bot system was deliberately NOT shipped - only the BSP and its assets.
//=========================================================================
main:
{
	level.coop_btMap = 1
	waitthread coop_mod/main.scr::main		//HZM coop - MUST be first

	level.coop_arenaMap = 1
	level.coop_weatherTheme = "none"

	level waittill prespawn
	level waittill spawn

	println( "^~^~^ MAPTOUR: bobobjaa02 up - walk it; press ] for the next candidate" )
	iprintlnbold_noloc( "TOUR: BOB: NORMANDY - night village, balcony" )
}end
