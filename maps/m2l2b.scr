coop_enigmaProp:
	waitframe
	if( $enigma == NULL ){ end }
	//[user 2026-08-09] START OPEN, END CLOSED (user-inverted): she sits open and working on the
	//shelf, types through the decrypt, and the case snaps shut when the contents are taken.
	$enigma.model = "animate/enigmaopen.tik"
	//[user 2026-08-08] SCALE + GLOW. The model renders correctly but is an accurate real-world
	//Enigma - about 40x31x18 units, briefcase-sized - and unlit in a dark U-boat, so it reads as
	//nothing at all. clipboard_pulse was visible only because its shader self-illuminates.
	//2.2x makes it a piece of set dressing you can actually pick out; the glow is what tells you
	//it is interactive, which is the job the pulse model used to do.
	//[user 2026-08-09] SMALLER - 2.2 read as oversized in play. coop_enigmaScale tunes it live
	//(set + re-enter the map), same pattern as coop_enigmaYaw below.
	local.scl = float( getcvar "coop_enigmaScale" )
	if( local.scl <= 0 ){ local.scl = 1.4 }
	$enigma scale local.scl
	$enigma rendereffects "+coopboss"
	//[user 2026-08-08] START THE ANIMATION. enigmaclosed.tik declares `classname animate` and ships
	//an idle .skc, and the BSP entity carried a testanim key - an animate model swapped in at
	//runtime sits on frame nothing until its anim is started, which renders as an invisible
	//entity. The log confirmed it was being SUBMITTED (SKELDRAW rc=141) while nothing appeared on
	//screen, which is exactly that shape.
	//[user 2026-08-09] FACING. The BSP entity ships `angle 270` - it faces -Y - and the machine
	//opened away from the player, who comes down the boat from the +X end (spawn is 5056 -6704,
	//the machine 3598 -6829). Flipped 180 to face back up the corridor. Exposed as a cvar because
	//the right yaw is something you can only judge standing in front of it: set coop_enigmaYaw and
	//re-enter the map rather than rebuilding to try each number. 0 is not selectable - use 360.
	local.yaw = float( getcvar "coop_enigmaYaw" )
	if( local.yaw == 0 ){ local.yaw = 90 }
	$enigma.angles = ( 0 local.yaw 0 )
	$enigma anim idle
	$enigma show
	println( "^~^~^ ENIGMA prop at " + $enigma.origin + " model " + $enigma.model )

	//[user 2026-08-08] ANNOUNCE THE FIRST OBJECTIVE ONCE SOMEONE IS THERE TO SEE IT. This map
	//posts every objective early in main: - the retail comment says "add them before players are
	//on the server" to avoid start-of-map spam - so coop_obj_toast_all early-exits on
	//$player.size < 1 and the "New Objective" card is shown to nobody. Every other coop map
	//assigns objectives as it goes, which is why it only misbehaves here.
	waitthread coop_mod/replace.scr::waitForPlayer
	wait 2
	waitthread coop_mod/objectives.scr::coop_obj_toast_all 1 "Decrypt the Enigma."
end
