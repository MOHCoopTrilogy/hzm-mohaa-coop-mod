//////   Breaking guys
//////////////////////////////
//"wrencherattack"
wrencherattack:
	self.interupted = 1
end

firechain:
	local.fire = self
	while(local.fire)
	{
		local.firespawned = spawn animate/adam-hallfire2.tik
		local.firespawned.origin = local.fire.origin
		local.firespawned thread flameage
		local.fire volumedamage 2000
		
		//[205] chrissstrahl - fix NULL
		if(local.fire.target){ local.fire.target volumedamage 2000 }
		
//		local.fire playsound something
		local.fire = local.fire.target
		wait .75
	}
end

flameage:
	self anim start 
	wait 1
	self anim stop
end

enigmamedal:
	$enigmatrig waittill trigger
	//[user 2026-08-08] THE DECRYPT. The prop sits as a CLOSED Enigma machine (dressed at prespawn by
	//coop_enigmaProp); using it runs a timed decrypt with the machine typing throughout, and only
	//then does it open and give up its contents.
	//
	//Retail had this as a one-frame grab - a pulsing clipboard that vanished on touch, with the
	//swap to enigmaopen.tik commented out. Every asset ships unused: enigmaopen.skd,
	//enigmaclosed.skd, static variants, .map sources, a 786 KB texture and a 262 KB enigmatext.tga
	//for the rotor lettering.
	if( level.coop_enigmaBusy == 1 ){ end }
	level.coop_enigmaBusy = 1

	local.secs = int( getcvar "coop_enigmaDecrypt" )
	if( local.secs <= 0 ){ local.secs = 10 }

	iprintlnbold "Decrypting Enigma traffic..."
	exec coop_mod/replace.scr::stopwatch local.secs
	thread coop_enigmaTyping local.secs

	wait local.secs

	//the case snaps shut - the contents are yours, the machine stays on the shelf
	$enigma.model = "animate/enigmaclosed.tik"
	$enigma anim idle
	$enigma rendereffects "-coopboss"
	$enigma playsound pickup_papers
	waitthread global/objectives.scr::add_objectives 1 3 "Decrypt the Enigma." ( 3598 -6829 39 )
	waitthread global/objectives.scr::current_objectives 2
	//[user 2026-08-08] EXPLICIT TOAST. This map adds every objective at map start (retail does it
	//"before players are on the server" to avoid spam), so the only thing that changes later is
	//which one is CURRENT - and current_objectives announces nothing. add_objectives is what fires
	//the New Objective card, and it already fired for all of them into an empty server.
	waitthread coop_mod/objectives.scr::coop_obj_toast_all 2 "Steal the Enigma contents."
	wait 1.5

	setcvar g_medal4 "1"
	//[user 2026-08-09] no hide any more - the shut case stays as set dressing, which is the whole
	//point of ending closed. The glow is already off (-coopboss above), so it reads as done.
	iprintlnbold "Manifest stolen"
	//a real objective now, and it GATES the charges - no sense blowing the boat before you have
	//what you came aboard for.
	level.coop_manifestTaken = 1
	waitthread global/objectives.scr::add_objectives 2 3 "Steal the Enigma contents." ( 3598 -6829 39 )
	waitthread global/objectives.scr::current_objectives 3
	waitthread coop_mod/objectives.scr::coop_obj_toast_all 3 "Plant the bombs."
	//[user 2026-08-08] bug-1596 group A - was defined in v1.2.1 and never bumped.
	thread coop_mod/challenges.scr::chal_team_bump "obj_the_manifest" 1
end


//=========================================================================
// [user 2026-08-08] The machine working. Uses the mod's OWN typewriter samples - six key variants
// plus a carriage return, built from MOHAA's objective-text typing assets and already tuned to
// sound like a typist rather than a metronome (bug-1357: a fixed gap on one sample reads as a
// machine). Played on the ENTITY, not locally, so it has a position in the room and you have to be
// at the desk to hear it working.
//=========================================================================
coop_enigmaTyping local.secs:{
	local.t = 0
	while( local.t < local.secs && $enigma != NULL ){
		local.k = randomint( 6 ) + 1
		if( local.k == 1 ){ $enigma playsound coop_type_key1 }
		else if( local.k == 2 ){ $enigma playsound coop_type_key2 }
		else if( local.k == 3 ){ $enigma playsound coop_type_key3 }
		else if( local.k == 4 ){ $enigma playsound coop_type_key4 }
		else if( local.k == 5 ){ $enigma playsound coop_type_key5 }
		else { $enigma playsound coop_type_key6 }

		//uneven gaps, with an occasional hesitation - the same shape chal_typewriter uses
		local.g = 0.09 + ( randomint 9 ) * 0.012
		if( randomint 7 == 0 ){ local.g = local.g + 0.22 }
		local.t = local.t + local.g
		wait local.g

		//carriage return every so often, for the line breaks
		if( randomint 14 == 0 && $enigma != NULL ){
			$enigma playsound coop_type_return
			local.t = local.t + 0.35
			wait 0.35
		}
	}
}end

exitthesub:
	$exit waittill trigger
	
	//chrissstrahl allow ubot exit only once
	if(level.ubotausstiegausgeloest != NIL ){
		end
	}
	level.ubotausstiegausgeloest = 1
	
	
	//chrissstrahl - do only in sp
	if(level.gametype == 0){
		level.playerisnotinsub = 1
		fadeout 1.5 0 0 0 1
		$world northyaw 0
		wait .5
	
		$player unattachfromladder
		wait 1.1
		$player.origin = $haxtteleportlocation1.origin	
	}else{
		$coop_exit triggerable
	}
	
	for(local.i = 1; local.i <= $counterguys.size; local.i++){
		$counterguys exec coop_mod/replace.scr::turnto	//chrissstrahl - coop compatibility
	}
	
	thread playalarmsound
	
	//chrissstrahl - do only in sp
	if(level.gametype == 0){
		fadein 2 0 0 0 1
	}
	
	waitthread global/objectives.scr::add_objectives 4 2 "Escape the U-Boat." $endlevel.origin	
	thread attacknowthing
end

//coop exit sub
//=========================================================================
coop_updateSpawn:{
//=========================================================================
	thread coop_mod/spawnlocations.scr::m2l2b_update1
}end

//coop exit sub
//=========================================================================
coop_exitthesub:{
//=========================================================================
	//[user 2026-08-08] EXFILTRATE is raised HERE - the moment you are off the boat - not in
	//objective2. objective2 runs at the very END of coop_sub_finale, after the sink and the fade,
	//so it announced a brand-new objective seconds before mission complete. Guarded so four
	//players climbing out do not each re-announce it.
	if( level.coop_exfilObj != 1 ){
		level.coop_exfilObj = 1
		waitthread global/objectives.scr::add_objectives 4 3 "Escape the U-Boat." $endlevel.origin
		waitthread global/objectives.scr::add_objectives 5 2 "Eliminate the enemies and Exfiltrate." $endlevel.origin
		waitthread global/objectives.scr::current_objectives 5
		waitthread coop_mod/objectives.scr::coop_obj_toast_all 5 "Eliminate the enemies and Exfiltrate."
	}
	//[user 2026-08-11] CHALLENGE: All Hands on Deck - the deck fight starts the moment the first
	//player is off the ladder, which is the same moment the Eliminate-and-Exfiltrate objective is
	//raised above. Self-guarded, so four players climbing out do not restart the watch.
	//[user 2026-08-11] the ONE way off her, from two user viewpos readings 35u apart
	//((-2575 -4790 -448) and (-2605 -4788 -431)); this is their midpoint. The user confirmed the
	//gangway is narrow and cannot be vaulted, so a touch trigger on it is both simpler and
	//stricter than any geometric 'are you near the hull' test - and it leaves the ladder hatch
	//alone, since a teleport below decks does not cross it.
	level.coop_chal_deckCross = ( -2590 -4789 -440 )
	thread coop_mod/challenges.scr::chal_all_hands_start
	parm.other unattachfromladder
	parm.other.origin = $haxtteleportlocation1.origin
	thread coop_mod/main.scr::playerMakeSolidAsap (waitexec coop_mod/main.scr::getPlayerId parm.other)
	wait 2
}end




