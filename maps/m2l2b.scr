//chrissstrahl - fix
//the sub has some weapon models and antena models missing, but the clip does still exist for them, respawn these models and align them in place


//=========================================================================
main:{
//=========================================================================
	level.coop_aaMap = 1					//chrissstrahl - let global scripts know this is a AA level
	//level.coop_playerHasDisguise = 1		//chrissstrahl - 
	level.coop_disableSpawnWarper = game.true	//chrissstrahl - disable respawning at where players spawned
	waitthread coop_mod/main.scr::main 		//chrissstrahl - start coop mod extensions
	thread coop_baked_0808
	level.coop_weatherTheme = "none"		//HZM coop - dynamic weather: U-boat pens interior (no precip)

	level.coop_enableDisguises = game.true //[200] Smithy - this map has disguises on load
	//[user 2026-08-11] SILENCED PISTOL IN ADDITION TO THE PLAYER'S OWN LOADOUT. This map lists it
	//in its default kit (coop_mod/loadout.scr), but armory picks REPLACE that kit - and since every
	//new player is now seeded with picks (bug-1675/1678), the quiet weapon a disguise mission
	//depends on was being dropped for exactly the players who need it. Additive, so you keep your
	//own sidearm as well: a pistol is never refused by the one-primary pickup guard
	//(WEAPON_CLASS_SECONDARY short-circuits it, bug-1204) and the bare give bypasses that guard.
	level.coop_silencedOnSpawn = 1
	
	//chrissstrahl - setup stuff that is needed
	if(level.gametype != 0){
		//chrissstrahl - add them now only in mp, to avoid the spam at start add them before players are on the server - sp see further below
		//[user 2026-08-08] LITERAL origin, not $enigma.origin. This block runs early in main:, before
		//the BSP entities exist, so dereferencing $enigma threw - and a thrown statement is SKIPPED
		//silently, which is why objective 1 never appeared at mission start. Coordinates are the
		//entity`s own, read from the m2l2b BSP entity lump.
		waitthread global/objectives.scr::add_objectives 1 2 "Decrypt the Enigma." ( 3598 -6829 39 )
		waitthread global/objectives.scr::add_objectives 2 2 "Steal the Enigma contents." ( 3598 -6829 39 )
		waitthread global/objectives.scr::add_objectives 3 2 "Plant the bombs [2 left]." level.bombtoplant
		waitthread global/objectives.scr::add_objectives 4 2 "Escape." $exit.origin
		waitthread global/objectives.scr::current_objectives 1
		
		spawn trigger_multiple targetname coop_exit setthread coop_exitthesub origin (5030 -6714 183)
	}

	exec global/loadout.scr maps/m2l2b.scr
//[user 2026-08-06] bug-1462 - runtime-confirmed by the sweep detector (invalid waittill prespawn).
waitthread coop_mod/replace.scr::waitTillPrespawn
//[user 2026-08-08] dress the manifest prop as what it actually is. The BSP ships $enigma with
//model animate/clipboard_pulse.tik - a placeholder - so the player picks up a glowing clipboard
//and is told they stole an Enigma manifest. enigmaopen.tik is the real machine, open and working;
//it snaps SHUT in enigmamedal when the contents are taken (user-inverted 2026-08-09). Done at
//prespawn because the entity does not exist before it.
thread coop_enigmaProp
//	exec global/alarmlight.scr

	exec global/ambient.scr m2l2b
	level.subspawned1 = waitthread global/spawner.scr::spawner_create $subspawned1
	level.subspawned2 = waitthread global/spawner.scr::spawner_create $subspawned2
//[user 2026-08-08] Same class as the bug-1462 prespawn fix at :34. Raw `level waittill spawn` is
//SP-only - in MP it throws "invalid waittill spawn for 'Level'" (seen in the 23:35:42 playtest log),
//and a thrown statement is SKIPPED, so the wait never happened and everything below ran early.
waitthread coop_mod/replace.scr::waitTillSpawn
	$world northyaw -90
	level.skillz = getcvar(skill)
	thread musicstuff
	level.alarmlights = 0	
	level.alarm = 0
	level.bombtoplant = $bombplanted
	
	if(level.gametype == 0){ //chrissstrahl - do now in sp, in mp we do it before any player is on server
		//[user 2026-08-08] LITERAL origin, not $enigma.origin. This block runs early in main:, before
		//the BSP entities exist, so dereferencing $enigma threw - and a thrown statement is SKIPPED
		//silently, which is why objective 1 never appeared at mission start. Coordinates are the
		//entity`s own, read from the m2l2b BSP entity lump.
		waitthread global/objectives.scr::add_objectives 1 2 "Decrypt the Enigma." ( 3598 -6829 39 )
		waitthread global/objectives.scr::add_objectives 2 2 "Steal the Enigma contents." ( 3598 -6829 39 )
		waitthread global/objectives.scr::add_objectives 3 2 "Plant the bombs [2 left]." level.bombtoplant
		waitthread global/objectives.scr::add_objectives 4 2 "Escape." $exit.origin
		waitthread global/objectives.scr::current_objectives 1
	}
	
	$exit nottriggerable
	thread exitthesub
	thread endlevelthread
	thread wavesounds
	thread enigmamedal
	level.bombcount = 0
	waitframe	//chrissstrahl - make sure this works in mp

	$bombplanted hide
	$bomb2planted hide
	$subback hide
	$subfront hide
	$subback notsolid
	$subfront notsolid
	$bridgebroken hide
	$bridgebroken notsolid
	$bridgeclip notsolid
	
	
	$waterplode1.model = animate/fx_explosion_tank.tik
	$waterplode2.model = animate/fx_explosion_tank.tik
	thread denyexit
	thread gatesound
	waitthread global/items.scr::add_item "explosives"
	waitframe	//chrissstrahl - make sure this works in mp

	$subguy2 type_attack "alarm"
	$subguy1 type_attack "alarm"
	$wrenchman1 exec coop_mod/replace.scr::holster	//chrissstrahl - make this work in coop

//   $wrenchman1 type_attack "alarm"
	thread cometolife
	level.gatecount = 0
	for(local.i = 1; local.i <= $counterguys.size; local.i ++)
	{
		$counterguys[local.i] thread countdeaths
		$counterguys[local.i] noticescale 200
	}
	if(isalive $welderguy2)
	{
		//[user 07-12 retail bugfix] was 'thread countdeaths3' - a label that has NEVER existed (shipped
		//typo, present in retail too). Threading it threw a runtime ScriptException that killed this init
		//thread whenever the welder survived m2l2a (the common path), dropping him from the exit-gate
		//counter and skipping everything after this block.
		$welderguy2 thread countdeaths
		$welderguy2 noticescale 200
	}
	if(isalive $wrenchman1)
	{
		$wrenchman1 thread countdeaths
		$wrenchman1 noticescale 200
	}
	waitthread global/items.scr::add_item "papers_level1" 1
	waitthread global/items.scr::add_item "uniform" 1
	
	$coop_exit setsize ( -10 -10 -10 ) ( 10 10 10 )	//chrissstrahl - spawn coop exit trigger to handle each player
	$coop_exit nottriggerable	//chrissstrahl - do not allow triggering until 
	
//remove
//$player stufftext "notarget"
//$player stufftext "noclip"
//$player.origin = "-2400 -4140 -485" //at the end
//$player.origin = "-3760 -805 -495" //start of pens (outside)
//$player.origin = "-2683 -3616 -511" //just outside of sub
//$player.origin = $waterplode1.origin
//wait 2
//thread blowhshtuffup

//	$player.has_disguise = 1
}end

easyskill:
	if(level.skillz != "0")
	end
	if(self.health > 50)
		self.health = (self.health / 2)
//	println self.targetname "'s health is " self.health
	self noticescale 1000
//	println self.targetname "'s noticescale is " self.noticescale
	self accuracy (self.accuracy / 3)
end

musicstuff:
	waitframe
	//[200] chrissstrahl - tmstartloop stops old solg automatically //exec coop_mod/replace.scr::tmstop	//chrissstrahl - coop compatibility
	exec coop_mod/replace.scr::tmstart "sound/music/mus_17a_mystery.mp3"	//chrissstrahl - coop compatibility
end

countdeaths:
	level.gatecount++
	self thread easyskill
	self waittill death
	level.gatecount--
	if(level.gatecount == 0)
		thread gateopen
end
gatesound:
	waitframe
	$gatenlocked waittill trigger
	$gatenlocked playsound gate_metal_locked_clue
	wait 1
	goto gatesound
end

gateopen:
	//[user 2026-08-11] CHALLENGE: All Hands on Deck pays out here - gateopen only runs when
	//level.gatecount reaches 0, i.e. every counted defender (including the 14 exfil
	//reinforcements, which thread countdeaths) is dead. That IS 'the battle is won'.
	thread coop_mod/challenges.scr::chal_all_hands_done
	$gatenlocked nottriggerable
	level.gate2hasopened = 1 
	$gaten playsound fence_roll_open
	$gaten movesouth 240
	$gaten waitmove
	wait 1
//	$gaten connect_paths
end

cometolife:
	if(game.m2l2welderdead == 0)
		$welderguy2 thread welding
	else
	{
		spawn script_model model "models/miscobj/welding_tank.tik" targetname "weldertank"
		"weldertank" notsolid
		$weldertank.origin = $welderguy2.origin
		$weldertank.angles = $welderguy2.angles
		$weldertank anim tank_death 
		$welderguy2 remove
	}
	if(game.m2l2sledgedead == 0)
		thread hammerguy1
	else
		$sledgehammerguy remove
	if(game.m2l2wrenchdead == 0)
		$wrenchman1 thread wrenchman1
	else
		$wrenchman1 remove
/*
                         sledgehammercarry:
                         	game.m2l2sledgedead = 0
                         	self waittill death
                         	game.m2l2sledgedead = 1	
                         end
                         
                         wrenchycarry:
                         	game.m2l2wrenchdead = 0                  <-------- code from previous level
                         	self waittill death
                         	game.m2l2wrenchdead = 1	
                         end
                         
                         weldercarry:
                         	game.m2l2welderdead = 0
                         	self waittill death
                         	game.m2l2welderdead = 1	
                         end
*/
end

wrenchman1:
	local.wrenchspot = spawn script_origin
	local.wrenchspot.origin = ($wrench1spot1.origin + ( -18 0 0)) 
	while(level.alarm != 1 && isalive $wrenchman1)
	{
		$wrenchman1 waitthread global/wrenching.scr::wrench local.wrenchspot wrench1look1
	}
end
wavesounds:
	for(local.i = 1;local.i <= $wavelaps.size;local.i++)
     	{
			$wavelaps[local.i] loopsound wave_laps .1
		}
end




/////////////////////////////////
///////////SETUSUPTHEBOMB////////
/////////////////////////////////


plantthebomb:
	//[user 2026-08-09] bug-1620 - the charges cannot go in until the manifest is aboard, and the
	//bug-1608 re-arm NEVER WORKED, for two independent reasons proven in the 11:05 playtest:
	//(1) `$bombplant` is the bomb PROP (script_model) - the BSP trigger_useonce carries NO
	//    targetname at all (map_entities/m2l2b_entities.txt), so `triggerable` re-armed the wrong
	//    entity; and
	//(2) it could not have worked anyway: TriggerUseOnce has count=1 and the engine REMOVES the
	//    trigger when count hits 0 (trigger.cpp:565-577) regardless of what this thread decides.
	//    No command can resurrect a removed entity.
	//So on first refusal, spawn a PERSISTENT replacement trigger_use (count -1, never consumed)
	//at the BSP trigger origin with the same setthread - the same inline-spawn recipe
	//coop_exit uses at :30. The success path below removes it once the bomb is really planted.
	if( level.coop_manifestTaken != 1 ){
		iprintlnbold "Recover the Enigma manifest first."
		if( level.coop_bombTrig1Respawn != 1 ){
			level.coop_bombTrig1Respawn = 1
			spawn trigger_use targetname "coop_bombtrig1" setthread plantthebomb origin ( 6558 -6822 54 )
			$coop_bombtrig1 setsize ( -48 -48 -24 ) ( 48 48 48 )
		}
		end
	}
	if(level.bombPlanted1 != NIL){ end } //chrissstrahl - bugfix
	level.bombPlanted1 = 1 //chrissstrahl - bugfix
	
	level.bombtoplant = $bomb2planted
	thread bombcount
	$bombplanted show
	$bombplanted playsound plantbomb //chrissstrahl - made coop compatible
	if(level.playerticking != 1)
	{
		$bombplanted loopsound bombtick
		level.playerticking = 1
	}
	$bombplant remove
	if( $coop_bombtrig1 != NULL ){ $coop_bombtrig1 remove }
	local.theguy = waitthread global/spawner.scr::spawner_activate level.subspawned1
end

plantthebomb2:
	//[user 2026-08-09] bug-1620 - same two-part failure as plantthebomb above: $bomb2plant is the
	//prop, the real trigger_useonce is nameless, and the engine removes it after one use anyway.
	//Same persistent-replacement recipe; BSP trigger origin 4135 -6671 46.
	if( level.coop_manifestTaken != 1 ){
		iprintlnbold "Recover the Enigma manifest first."
		if( level.coop_bombTrig2Respawn != 1 ){
			level.coop_bombTrig2Respawn = 1
			spawn trigger_use targetname "coop_bombtrig2" setthread plantthebomb2 origin ( 4135 -6671 46 )
			$coop_bombtrig2 setsize ( -48 -48 -24 ) ( 48 48 48 )
		}
		end
	}
	if(level.bombPlanted2 != NIL){ end } //chrissstrahl - bugfix
	level.bombPlanted2 = 1 //chrissstrahl - bugfix
	
	level.bombtoplant = $bombplanted
	thread bombcount
	$bomb2planted show
	$bomb2planted playsound plantbomb
	if(level.playerticking != 1)
	{
		$bombplanted loopsound bombtick //chrissstrahl - made coop compatible
		level.playerticking = 1
	}
	$bomb2plant remove
	if( $coop_bombtrig2 != NULL ){ $coop_bombtrig2 remove }
	local.theguy = waitthread global/spawner.scr::spawner_activate level.subspawned2

end
bombcount:
	level.bombcount++
	if(level.bombcount == 1)
	{
      	waitthread global/objectives.scr::add_objectives 3 2 "Plant the bombs [1 left]." level.bombtoplant.origin
     	waitthread global/objectives.scr::current_objectives 3
		if(level.gametype == 0){//chrissstrahl - sp only
			$player.has_disguise = 0
		}
     	waitthread global/items.scr::remove_item "papers_level1"
     	waitthread global/items.scr::remove_item "uniform"
     	wait 1
     	iprintlnbold "Your cover has been blown."
		//[user 2026-08-08] coop_subEscape: long fuse - she does not blow while you are aboard.
		//The mission becomes escape-then-watch. Verified safe: level.blownup is read nowhere else,
		//the exit is opened by subtrap on bombcount==2 (not by the blast), and blowhshtuffup
		//DESTROYS the bridge - skipping it leaves the way out intact rather than blocked.
		if( getcvar "coop_subEscape" == "1" ){
			//[user 2026-08-08] STOP THE TICK. $bombplanted loopsound bombtick starts at :237/:254 and
			//is stopped ONLY inside blowhshtuffup - which this route skips, so it ticked forever.
			$bombplanted stoploopsound
			//[user 2026-08-08] NO print here. This block runs at bombcount == 1 - ONE bomb down, one
			//still to plant - so "get off this boat" was both premature and a duplicate of what the
			//objective list already says. The objectives are posted as they come now and are the only
			//thing that should be telling the player what to do.
			end
		}
		if(level.skillz == "0")
		{
     		iprintlnbold "75 seconds to escape the sub"			
			wait 20
		}
		exec coop_mod/replace.scr::stopwatch 55
		wait 55
		thread blowhshtuffup
	}
	if(level.bombcount == 2)
	{
		//[user 2026-08-09] the dock garrison musters NOW - both charges set, klaxons going - so the
		//fight is waiting when the players climb OUT of the boat. They are killed BEFORE the ship
		//explodes (the gate counts them via countdeaths); the finale only plays after the docks are
		//cleared and the endlevel gate is reached. Was wrongly hooked to the blast itself.
		if( level.gametype != 0 ){ thread coop_exfilReinforce }
		thread subtrap
		thread objective1
	}
end

objective1:
 	waitthread global/objectives.scr::add_objectives 3 3 "Plant the bombs." level.bombtoplant.origin
	waitthread global/objectives.scr::current_objectives 4
	waitthread coop_mod/objectives.scr::coop_obj_toast_all 4 "Escape the U-Boat."
	waitthread global/items.scr::remove_item "explosives" nomessage

end
objective2:
	//[user 2026-08-08] TWO steps, not one. Objective 2 is the fight out of the boat; 3 is the
	//exfil itself, raised only once 2 is done, so the last thing on screen is where to go rather
	//than a single line covering both.
	//[user 2026-08-08] close them out only - both were raised at the sub exit. Announcing a NEW
	//objective here meant "New Objective: Exfiltrate" popped up after the boat had already gone.
	waitthread global/objectives.scr::add_objectives 4 3 "Escape the U-Boat." $endlevel.origin
	waitthread global/objectives.scr::add_objectives 5 3 "Eliminate the enemies and Exfiltrate." $endlevel.origin
	exec global/missioncomplete.scr m2l2c 1

end
subtrap:
	$exitdeny nottriggerable
	$exit triggerable
	thread coop_updateSpawn
end

denyexit:
	$exitdeny waittill trigger
	iprintln "You have not completed the objective."
	wait 3
	goto denyexit
end

attacknowthing:
	
end


playalarmsound:
	level.alarmlights = 1
	for(local.i = 1;local.i <= $alarm_sound.size;local.i++)
	{
		$alarm_sound[local.i] loopsound m2l2_alarm
	}	
end

blowhshtuffup:
	if(level.blownup != 1)
	{
		$bombplanted stoploopsound	//chrissstrahl - coop compatible
     	level.blownup = 1
		$bridgefatty hide
		thread blowuptheinside
//		thread playalarmsound
//		$subfront show
//		$subback show
		$subfront remove
		$subback remove
//		$bridge notsolid
//		$bridge hide
		$bridgekill volumedamage 2000						
		$bridgebroken show
		$bridgebroken solid
		$bridgebroken thread breakbridge
		//[user 2026-08-08] "Mit den Fischen schlafen" - the charges just went. Anyone still aboard
		//dies to subkill's volumedamage, which is the point: the feat is letting the sea do it.
		//Flag set BEFORE the award so the kill hook stops disqualifying from this moment on.
		level.coop_m2l2b_blown = 1
		if( level.coop_m2l2b_handKill != 1 ){
			thread coop_mod/challenges.scr::chal_team_bump "cc_fischen" 1
		}
		thread subkill
		
		thread coop_resetPlayerSpawnsIfDead //[200] Smithy - reset spawns if players are dead at this point, stop players respawning in water/boat
		
		$bridgeclip solid
     	exec global/earthquake.scr .5 1 0 0
     	$waterplode1 anim start
     	$waterplode1 playsound explode_sub
     	$spray1 thread spraychain
     //	$tankeffect1 anim start
     	wait .1
     	$spray2 thread spraychain
     	$waterplode2 anim start
     	$waterplode2 playsound explode_water
		wait 1
     	$waterplode3 anim start
     	$waterplode3 playsound explode_water
		wait 1
     	$waterplode2 anim start
     	$waterplode2 playsound explode_water
     	wait 1
     	$waterplode3 anim start
     	$waterplode3 playsound explode_water
		level.alarmlights = 1
		
		//chrissstrahl - allow players now to respan at their death pos
		//was off to prevent players from respawning on the blowing boat
		wait 3
		level.coop_disableSpawnWarper = game.false
		

	}
end

//[200] Smithy - reset player spawns if you die on boat
coop_resetPlayerSpawnsIfDead:{
	if (!level.gametype){ end }
	waitframe
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.player =  $player[local.i]						
		if(!isAlive local.player || local.player.isSpectator){
			thread coop_mod/main.scr::resetSpawn local.player 	//[200] Smithy - reset their spawns if they died on boat
		}
	}
}end

subkill:
	while(1)
	{
		$subdamage volumedamage 2000
		wait 1
	}
end
breakbridge:
 	self time .1
	self followpath $bridgepath 
	self move
	wait 2.3
	$bridgesplash2 anim start
	$bridgesplash1 anim start
	wait .5
	$bridgesplash2 anim stop
	$bridgesplash1 anim stop
	
end


blowuptheinside:
	if(level.playerisnotinsub != 1)
	{
     	$firechain1 thread firechain
     	$firechain2 thread firechain
     	$firechain3 thread firechain
	}
end
spraychain:
local.spray = self.targetname
while(local.spray)
{
	local.spray thread spray
	local.spray = local.spray.target
	wait .22
}
end

spray:
	self anim start
	wait 1 
	self anim stop
end

guygo local.spot:
	self exec global/walkto.scr $(self + "spot" + local.spot)
end

endlevelthread:
	$endlevel waittill trigger
	if(level.gametype == 0){//chrissstrahl - only do this in sp, in mp we don't need that kind of precision to the spawn
		game.m2l2position = $player.origin
	}
	//[user 2026-08-08] on the escape route the mission does not end at the exit - you watch her
	//go first. coop_sub_finale calls objective2 itself once the boat is gone.
	if( getcvar "coop_subEscape" == "1" ){
		thread coop_sub_finale
		end
	}
	thread objective2

end

//=========================================================================
// [user 2026-08-08] THE FINALE. The boat you escaped is worldspawn brushwork and cannot be
// moved, so the one that sinks is a staged upper hull in the EMPTY neighbouring pen, framed by
// a camera that never has the original in shot. Both positions captured in-game.
//=========================================================================
coop_sub_finale:
	if( level.coop_subFinale == 1 ){ end }
	level.coop_subFinale = 1

	//[user 2026-08-09] coop_subCruise 0 = the original static in-pen sink, kept whole as a fallback.
	if( getcvar "coop_subCruise" == "0" ){
		thread coop_sub_finale_pen
		end
	}

	//[user 2026-08-09] THE SORTIE FINALE, three acts. She gets underway and sails the harbor along
	//waypoints the user authored in-game with build mode (hull centers, headings, settle depths from
	//build_m2l2b.dat), a blizzard builds over the water, the camera cuts to the ticking charge as
	//she nears open water, and cuts back the instant the timer runs out. All timing is cvar-tunable
	//live: coop_subCruiseSpeed / coop_subTurnRate / coop_subYawFlip / coop_subCruiseZoff /
	//coop_subInsertLen / coop_subInsertFov / coop_subBlizzard.
	//[user 2026-08-09] BLACK COVERS THE HANDOFF. The player standing at the endlevel gate could
	//see the hull pop into existence and get under way in first person for a split second before
	//the camera took over. Dip to black, do ALL the staging under it, and return with her already
	//making way on camera.
	fadeout 0.35 0 0 0 1
	wait 0.45
	//[user 2026-08-09] no crosshair on the picture - restored under the final fade
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] stufftext ( "ui_crosshair 0" ) }
	}
	level.coop_subWpN = 3
	level.coop_subWpO[1] = ( -978.355 -2424.665 -774.379 )
	level.coop_subWpO[2] = ( -562.874 1610.839 -765.100 )
	level.coop_subWpO[3] = ( 472.854 5676.325 -831.875 )

	//stage yaw is the DISPLAY yaw: travel bearing 89 + the model flip (the lowerhull renders
	//backwards along its forward axis - user-observed). Same cvar logic as the cruise so the two
	//can never disagree.
	if( getcvar "coop_subYawFlip" == "" ){ local.flip = 180 }
	else{ local.flip = float( getcvar "coop_subYawFlip" ) }
	//[user 2026-08-09] she stages coop_subStartAdvance units (default 1000) already down her course
	//- the full berth-to-kill drive read too long even at speed, and act 1 loses nothing: she is
	//still ahead of and below the camera, already under way.
	//[user 2026-08-09] v4: advance 2400 along the TRUE bearing to the kill point (79.845 deg,
	//berth -> final marker), so the advanced start sits ON the straight course. Less time at sea,
	//more time on the sinking - the user's cut.
	if( getcvar "coop_subStartAdvance" == "" ){ local.adv = 2400 }
	else{ local.adv = float( getcvar "coop_subStartAdvance" ) }
	local.sfwd = angles_toforward ( 0 79.845 0 )
	local.spos = ( -978.355 -2424.665 -774.379 ) + ( local.sfwd * local.adv )
	waitthread coop_mod/subsink.scr::coop_sub_stage local.spos ( 79.845 + local.flip ) "models/static/upperhull3.tik" 1.0

	//ACT 1 - the wide: a LOCKED-OFF camera, exactly as the user composed it (pos -1315 -1326 -293,
	//yaw 68). The first cut tracked her with `watch` and the pan both broke the composition and
	//swung into unbrushed map - the shot is MEANT to be static, with her entering from the side of
	//frame and shrinking into the storm. The look marker sits ~4000u down the authored sight line
	//and is NOT registered with the cruise, so nothing ever moves the aim.
	//(bug-360: Camera ignores .origin= - place with movetopos, aim with watch at a marker.)
	//[user 2026-08-09] composition v2 (their capture 11:56): perched just above her berth, looking
	//due north straight down her course - she emerges beneath the camera and sails away into the
	//storm. Locked off; the aim point sits 4000u down the yaw-92 sight line, tilted to the water.
	local.look = spawn script_origin targetname "coop_subLook"
	local.look.origin = ( -1131 1631 -650 )
	local.cam = spawn Camera targetname "coop_subCam"
	local.cam movetopos ( -991 -2367 -225 )
	local.cam watch local.look 0
	local.cam fov 80

	thread coop_sub_blizzard
	//[user 2026-08-09] SHE IS ALREADY UNDER WAY WHEN WE CUT. The cruise starts BEFORE the camera:
	//she visibly waited for the director before moving, which was jarring. By the time the cut
	//lands she has ~1.2s of way on and the start bark is already rolling.
	thread coop_mod/subsink.scr::coop_sub_cruise
	//[user 2026-08-09] THE BASE IS STILL SCREAMING BEHIND YOU. The bust that sent you running
	//raised the alarm, and the cutscene should not pretend otherwise - a low siren bed runs
	//under the whole scene (levelwide, so every player hears it wherever they stand).
	local.sirens = spawn script_model model "fx/dummy.tik"
	if( $player != NULL && $player[1] != NULL ){ local.sirens.origin = $player[1].origin }
	local.sirens notsolid
	local.sirens loopsound m2l2_alarm2 0.55 "levelwide"	//[user 2026-08-09] the MISSION'S alarm (Mec_Alarm_03, the pen klaxon) - coop_snd_siren was an air-raid siren the map never uses
	level.coop_subSirens = local.sirens
	wait 1.2
	local.cam cut
	cuecamera local.cam
	fadein 1.0 0 0 0 1
	//[user 2026-08-09] one long mournful blast as she clears the pen - U-boats carried a
	//compressed-air signal horn for exactly this, and in a blizzard it is the sound of the scene.
	wait 2.5
	if( level.coop_subStaged != NIL && level.coop_subStaged != NULL ){ level.coop_subStaged playsound coop_sub_horn }
	//belt and braces: the hull playsound was inaudible in two runs - the report recipe (play on
	//each player) is the proven delivery, so the horn rides both.
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] playsound coop_sub_horn }
	}


	//ACT 2 - the insert: when she is coop_subInsertLen seconds from the final point, cut to the
	//charge and push in slowly while it ticks. The tick is played on dummies AT EACH PLAYER because
	//audio renders at the player, not the camera - the bomb itself is thousands of units from their
	//ears and would be silent.
	while( level.coop_subApproach != 1 && level.coop_subCruiseDone != 1 ){ wait 0.1 }
	if( level.coop_subCruiseDone != 1 && level.bombPlanted1 != NIL ){
		local.blook = spawn script_origin targetname "coop_subBombLook"
		local.blook.origin = ( 6558 -6821 39 )
		local.cam2 = spawn Camera targetname "coop_subCam2"
		local.cam2 movetopos ( 6530 -6794 48 )
		local.cam2 watch local.blook 0
		local.cam2 fov 70
		local.cam2 cut
		cuecamera local.cam2
		//[user 2026-08-09] AUDIO POV v2: her diesels fill the closeup. The per-player-dummy version
		//was inaudible in play; the LEVELWIDE loop recipe (proven by the wind and siren beds) is not.
		local.engnear = spawn script_model model "fx/dummy.tik"
		if( $player != NULL && $player[1] != NULL ){ local.engnear.origin = $player[1].origin }
		local.engnear notsolid
		local.engnear loopsound coop_sub_moving 1.2 "levelwide"
		level.coop_subEngNearW = local.engnear
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			if( $player[local.i] != NULL ){
				local.td = spawn script_model model "fx/dummy.tik"
				local.td.origin = $player[local.i].origin
				local.td notsolid
				local.td loopsound bombtick
				level.coop_subTick[local.i] = local.td
			}
		}
		//the push-in: a slow fov tighten across the whole insert, ended by the cruise arriving
		local.insert = float( getcvar "coop_subInsertLen" )
		if( local.insert <= 0 ){ local.insert = 6 }
		local.ffov = float( getcvar "coop_subInsertFov" )
		//[user 2026-08-09] 30 pushed in too close in the first playtest - 45 frames the charge
		//with a little air around it.
		if( local.ffov <= 0 ){ local.ffov = 45 }
		local.f = 70
		while( level.coop_subCruiseDone != 1 && local.f > local.ffov ){
			local.f = local.f - ( ( 70 - local.ffov ) * ( 0.1 / local.insert ) )
			local.cam2 fov local.f 0
			wait 0.1
		}
		while( level.coop_subCruiseDone != 1 ){ wait 0.1 }
		//ACT 3 - cut back EXACTLY as the timer runs out; the death blow starts on this frame
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			if( level.coop_subTick[local.i] != NIL && level.coop_subTick[local.i] != NULL ){
				level.coop_subTick[local.i] delete
				level.coop_subTick[local.i] = NIL
			}
		}
		if( local.cam2 != NULL ){ local.cam2 delete }
		if( local.blook != NULL ){ local.blook delete }
	}else{
		while( level.coop_subCruiseDone != 1 ){ wait 0.1 }
	}

	//ACT 3 - THE DEATH CAM (user capture 11:57): across the water southeast of the kill point,
	//cutting in the frame the charges fire. Close enough that the columns and burning oil actually
	//read, unlike the 7,000u wide. fov 42 punches the last of the distance out.
	//SCENE-SCOPED FOG: the shot looks toward unbrushed map edges, so the farplane closes to 6000
	//with a snow-grey tint for THIS SHOT ONLY - saved first, restored under the fade where the
	//swap is invisible. (weather.scr stores its own copy in level.farplane; we deliberately use
	//separate vars and restore AFTER it, last writer wins under black.)
	level.coop_subFpSave = $world.farplane
	level.coop_subFpColSave = $world.farplane_color
	$world farplane 6000
	//vector literal REQUIRED - three bare floats threw "Cannot cast float to vector" (12:07 run)
	$world farplane_color ( 0.72 0.75 0.80 )
	local.dlook = spawn script_origin targetname "coop_subDeathLook"
	local.dlook.origin = ( 473 5676 -700 )
	local.cam3 = spawn Camera targetname "coop_subCam3"
	//[user 2026-08-09] pulled from 4400u to ~2600u along the same sight line - the scene fog made
	//her hard to read at the original distance. Lens opened 42 -> 50 to compensate.
	local.cam3 movetopos ( 2703 3523 -440 )	//[user 2026-08-09] eased back ~500u - 2600 was a touch tight
	local.cam3 watch local.dlook 0
	local.cam3 fov 50
	//kill the closeup engine bed with the picture
	if( level.coop_subEngNearW != NIL && level.coop_subEngNearW != NULL ){ level.coop_subEngNearW delete }
	//[user 2026-08-09] and the base alarm drops to a distant murmur - we are miles out now
	if( level.coop_subSirens != NIL && level.coop_subSirens != NULL ){ level.coop_subSirens delete }
	local.sirens2 = spawn script_model model "fx/dummy.tik"
	if( $player != NULL && $player[1] != NULL ){ local.sirens2.origin = $player[1].origin }
	local.sirens2 notsolid
	local.sirens2 loopsound m2l2_alarm2 0.18 "levelwide"
	level.coop_subSirens = local.sirens2
	//[user 2026-08-09] the last scene is a WHITEOUT - the storm surges as we cut to her death
	level.rain_density = 16
	local.cam3 cut
	cuecamera local.cam3

	thread coop_sub_report
	thread coop_mod/subsink.scr::coop_sub_sink

	wait 44	//[user 2026-08-09] sink is 28s now - linger on her going down
	//[user 2026-08-08] "The Way it Was" - awarded after the sink completes, not at the exit.
	thread coop_mod/challenges.scr::chal_team_bump "cc_way_it_was" 1
	fadeout 2.5 0 0 0 1
	wait 3
	//give the crosshair back under black (both finale paths end here)
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] stufftext ( "ui_crosshair 1" ) }
	}
	if( level.coop_subWind != NIL && level.coop_subWind != NULL ){ level.coop_subWind delete }
	if( level.coop_subSirens != NIL && level.coop_subSirens != NULL ){ level.coop_subSirens delete }
	//restore the shot fog under black
	if( level.coop_subFpSave != NIL ){
		$world farplane level.coop_subFpSave
		$world farplane_color level.coop_subFpColSave
	}
	if( local.cam != NULL ){ local.cam delete }
	if( local.cam3 != NULL ){ local.cam3 delete }
	if( local.dlook != NULL ){ local.dlook delete }
	if( local.look != NULL ){ local.look delete }
	thread objective2
end

//[user 2026-08-09] the report reaches the players EARS: audio renders at the PLAYER, not the
//camera, and she dies ~10,000u from the dock - without this the whole blast is mute. Delayed as
//if crossing the harbor.
coop_sub_report:
	wait 1.2
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] playsound explode_sub }
	}
	wait 2.4
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] playsound explode_water }
	}
end

//[user 2026-08-09] BLIZZARD OVER THE HARBOR. m2l2b declares weather theme "none" (the pens are
//interior), so the native SP snow system was never started on this map - the finale owns it
//outright. Seed the snow look, hand off to the native renderer, and build 1 -> 2 -> 3 as she
//sails: the renderer smooths every step, so light snow thickens into a whiteout as she reaches
//open water. coop_amb_wind rides levelwide (the ambience recipe) as the storm bed.
coop_sub_blizzard:
	if( getcvar "coop_subBlizzard" == "0" ){ end }
	//[user 2026-08-09] v3 - WHY THERE WAS NEVER SNOW: precipitation only falls inside func_rain
	//BRUSH VOLUMES, and m2l2b (an interior pens map) ships none - density 10 with no volume is
	//still zero flakes (cg_nature.cpp emits per-entity from inlineDrawModel bounds). So the finale
	//spawns its own: func_rain is a registered spawnable class, and inline brush model *66
	//(1032x1008x1048, centered on its own origin - parsed from the BSP models lump) is borrowed as
	//the volume. ET_RAIN never draws the brush geometry, only flakes. A 3x3 grid is laid around
	//each cutscene camera - snow renders within ~1800u of the VIEW, and during the cutscene the
	//view IS the camera, so nowhere else needs coverage.
	waitthread coop_mod/weather.scr::coop_weather_snowLook
	//[user 2026-08-09] v3.1 - NO SNOW INDOORS. The blind 3x3 around cam1 reached back over the
	//covered pen (the camera perch itself is under the roof), and rain volumes ignore world
	//geometry - flakes fell inside. Act-1 boxes now sit ONLY over the open water AHEAD of the
	//camera (a 2-wide x 3-deep strip up the channel, nothing behind the mouth). The death-cam
	//grid is genuinely open water and keeps its 3x3.
	local.gy = 0
	while( local.gy <= 2 ){
		local.gx = 0
		while( local.gx <= 1 ){
			local.r = spawn func_rain
			local.r model "*66"
			local.r.origin = ( ( 0 - 1400 + ( local.gx * 1000 ) ) ( ( 0 - 600 ) + ( local.gy * 1000 ) ) ( 0 - 150 ) )
			local.gx = local.gx + 1
		}
		local.gy = local.gy + 1
	}
	local.gx = 0 - 1
	while( local.gx <= 1 ){
		local.gy = 0 - 1
		while( local.gy <= 1 ){
			local.r2 = spawn func_rain
			local.r2 model "*66"
			local.r2.origin = ( ( 3650 + ( local.gx * 1000 ) ) ( 2609 + ( local.gy * 1000 ) ) ( 0 - 350 ) )
			local.gy = local.gy + 1
		}
		local.gx = local.gx + 1
	}
	local.w = spawn script_model model "fx/dummy.tik"
	if( $player != NULL && $player[1] != NULL ){ local.w.origin = $player[1].origin }
	local.w notsolid
	local.w loopsound coop_amb_wind 0.6 "levelwide"
	level.coop_subWind = local.w
	//[user 2026-08-09] "doesnt last long" - the slow build meant the storm only read as a storm
	//near the end of act 1. It now opens at 5 and is a full 10 within ~8s of the first frame.
	local.dd = 5
	level.rain_density = local.dd
	while( local.dd < 10 ){
		local.dd = local.dd + 0.1
		level.rain_density = local.dd
		wait 0.15
	}
	println( "^~^~^ BLIZZ density=" + level.rain_density )
end




coop_sub_finale_pen:
	if( level.coop_subFinale == 1 ){ end }
	level.coop_subFinale = 1

	waitthread coop_mod/subsink.scr::coop_sub_stage ( -984.657 -3905.494 -590.479 ) 273 "models/static/upperhull3.tik" 0.8

	//A Camera IGNORES .origin= and .angles= (bug-360, same no-op class as moveto on a
	//script_model): it must be placed with movetopos and aimed with watch at a marker.
	local.look = spawn script_origin targetname "coop_subLook"
	local.look.origin = ( -984.657 -3905.494 -590.479 )
	local.cam = spawn Camera targetname "coop_subCam"
	local.cam movetopos ( -1420 -6421 -135 )
	local.cam watch local.look 0
	local.cam fov 80
	local.cam cut
	cuecamera local.cam

	wait 2

	//sound first: at ~2500 units the delay between flash and report is what sells the distance
	local.snd = spawn script_model model "fx/dummy.tik"
	local.snd.origin = ( -984.657 -3905.494 -590.479 )
	local.snd playsound explode_sub
	exec global/earthquake.scr .5 1 0 0
	thread coop_mod/subsink.scr::coop_sub_sink

	wait 22
	//[user 2026-08-08] FADE OUT, do not hand the camera back. Cutting from a burning wreck to the
	//player standing on a dock is the sort of whiplash that undoes the whole shot - and the mission
	//ends here anyway, so there is nothing to come back TO. Fade first, THEN release the camera, or
	//the hand-back is visible during the fade.
	//[user 2026-08-08] "The Way it Was" - awarded HERE, after the sink completes, not at the exit:
	//the feat is having watched her go, and a player who somehow skipped the sequence should not
	//get it.
	thread coop_mod/challenges.scr::chal_team_bump "cc_way_it_was" 1
	fadeout 2.5 0 0 0 1
	wait 3
	//give the crosshair back under black (both finale paths end here)
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL ){ $player[local.i] stufftext ( "ui_crosshair 1" ) }
	}
	if( local.snd != NULL ){ local.snd delete }
	if( local.cam != NULL ){ local.cam delete }
	if( local.look != NULL ){ local.look delete }
	thread objective2
end

officerdead:
	//[user 2026-08-08] the SECOND route into the blast - killing the officer detonates too.
	//Gated with the timer, or she still goes up under you on the escape route.
	if( getcvar "coop_subEscape" == "1" ){ wait 5 ; end }
	thread blowhshtuffup
	wait 5
end

////////////////////////////////////////////////////////////
//////////**********************////////////////////////////
//////////**SLEDGHAMMER GUYS!!!*****////////////////////////
//////////**********************////////////////////////////
////////////////////////////////////////////////////////////

hammerguy1:
	$sledgehammerguy thread sledgehammering
end

sledgehammering:
	self gun "walter p38"
	self  exec coop_mod/replace.scr::holster	//chrissstrahl - make this work in coop
	self type_attack "alarm"
	self anim sledgehammer_init
	self alarmthread sledgecower
	self.health = 1
	wait 5
	while(!self.stophammering)
	{
		self anim sledge_hammer_action
		if(self.stophammering)
			end
		wait (randomint(10))
		self anim sledge_hammer_idle
		self waittill animdone
	}
stophammering:
	self anim sledge_hammer_stop
end

sledgecower:
	self.stophammering = 1
	self exec global/disable_ai.scr
	self waittill animdone
	self anim sledge_hammer_stop
	self exec coop_mod/replace.scr::unholster	//chrissstrahl - make this work in coop
	self exec global/enable_ai.scr
	self attackplayer
end


////////////////////////////////////////////////////////////
//////////**********************////////////////////////////
//////////**WELDING GUYS!!!*****////////////////////////////
//////////**********************////////////////////////////
////////////////////////////////////////////////////////////

welding:
//	self waittill animdone
	self forceactivate
	self thread welderdeath
	self.health = 1
	self exec global/setdeathanim.scr "welding_death"
	self anim welding_init
	self type_attack alarm
	self alarmthread maps/m2l2a.scr::weldinginterupt
	wait 5
	while (level.alarm == 0)
	{
		self anim welding_start
		self waittill animdone
		self anim welding_action
		wait (randomint(10) + 5)
		self anim welding_end
		self waittill animdone
		self anim welding_idle
		wait (randomint(10) + 10)
	}
	self thread weldinginterupt
end

weldinginterupt:
	if(self.inturpupted == 1)
		end
	self thread welderbreak
	self exec global/disable_ai.scr
	self.interupted = 1
	wait .1
	self anim welding_stop
	self waittill animdone
	wait .1
	self gun "walter p38"
	self exec global/enable_ai.scr
end

welderbreak:
	spawn script_model model "models/miscobj/welding_tank.tik" targetname (self.targetname + "big1")
	$(self.targetname + "big1") notsolid
	$(self.targetname + "big1").origin = self.origin
	$(self.targetname + "big1").angles = self.angles
	$(self.targetname + "big1") anim tank_death 
end

welderdeath:
	if(self.ded != 1)
	{
		self waittill death
		self thread welderbreak
	}	
	self.ded = 1
end

