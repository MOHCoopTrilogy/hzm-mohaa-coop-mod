			local.b.origin = local.p + (0 0 90)
			local.b.angles = (0 (randomint 360) 0)
			local.b notsolid
			waitthread coop_placeGround local.b 45
			local.made++

			//every one of them bleeds into the sand
			local.pool = spawn "models/fx/coop_bloodslick.tik"
			if(local.pool != NULL && local.pool != NIL){
