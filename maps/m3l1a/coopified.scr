	local.n++; local.plx[local.n] = 0 - 1153; local.ply[local.n] = 648; local.plz[local.n] = 0 - 467
	local.n++; local.plx[local.n] = 842; local.ply[local.n] = 0 - 963; local.plz[local.n] = 0 - 488
