//chrissstrahl - middle mgs killing player if not in cover - coop version
//=========================================================================
mg42AttackBeach:{
	//[bug-2306] THE GRACE WINDOW MOVED. start_beach is threaded at m3l1a.scr:2675, BEFORE the coop
	//release gate, and it did `wait 2` then opened up with the MG42s - two seconds of grace from the
	//moment the ramp dropped. The cinematic adds 3.8s after that point, which would have turned that
	//grace into a NEGATIVE one: players landing on the sand already under fire, mid-fade. Wait for
	//the set piece to report done, then take the two seconds from there.
	local.w = 0
	while(level.coop_rampCineDone != 1 && local.w < 200){
		wait 0.05
		local.w++
	}
	wait 2

//=========================================================================
	thread coop_inlandShelling		//[user 2026-08-28] cosmetic naval shelling behind the bunkers
	thread coop_farFieldShelling	//[user 2026-08-28] the rest of the beach is being shelled too
	thread coop_beachWrecks			//[user 2026-08-28] knocked-out armour at the waterline (one-shot)
	//[user 2026-08-28] UNDO THE LASER. m3l1a.scr sets `AIbulletspread 2 2` on both beach guns - 2 units
	//at a 4000 unit bulletrange, i.e. a guaranteed hit - and it does that BEFORE branching here, so it
	//overrides coop_mg42AiSpread on the entity itself. That is why tuning the global spread cvar never
	//changed anything on this map. Widened only on the COOP path; single player keeps retail behaviour.
	if(level.coop_beachSpread == NIL){ level.coop_beachSpread = 90 }
	if(level.coop_beachSpread > 0){
		$mg42_middle1 AIbulletspread level.coop_beachSpread level.coop_beachSpread
		$mg42_middle2 AIbulletspread level.coop_beachSpread level.coop_beachSpread
	}

	level.coop_mg42Fiering = 1
	while(level.coop_mg42Fiering){

		local.alivePlayers=0	//chrissstrahl - keep track of players being alive
		local.explosedPlayers=0	//chrissstrahl - keep track of players not in cover

		for(local.pNum = 1;local.pNum<=$player.size;local.pNum++){
			local.player = $player[local.pNum]
			local.playerNotIncover = 1

			//chrissstrahl - skip if player is missing or dead or spec
			//[200] Smithy - local.player.dmteam condition typo fixed
			if(local.player == NULL || local.player.health <= 0 || local.player.dmteam == "spectator" || local.player.flags["coop_isActive"] != 1){
				continue
			}
			//-832.00 3648.00 -344.00
			local.pos = local.player.origin
			if(local.pos[1] > 4000 ){//everything above 4000 make it a little to hard tro reach the captain
				continue
			}

			local.alivePlayers++	//chrissstrahl - keep track of players being alive
			//iprintlnbold_noloc("mg42AttackBeach warning: " + local.pNum)

			// bullet run-up warning
			for (local.i = 4 ; local.i >= 1 ; local.i --){
				local.temp_origin = local.player.origin
				local.temp_origin[1] += (128 * local.i)
				local.temp_origin[2] += level.target_offset

				$player_target.origin = local.temp_origin
				$mg42_middle1 setaimtarget $player_target
				$mg42_middle2 setaimtarget $player_target

				wait 0.3 // was 0.2 might needs better adjustment for coop
			}

			//chrissstrahl - fire at cover or player
			//chrissstrahl - make it a bit harder for the player if playing alone
			//chrissstrahl - otherwise it will be to easy, because the damage is multiplied by players
			//iprintlnbold_noloc("mg42AttackBeach fire: " + local.pNum)
			for (local.j = 1 ; local.j <= 8 ; local.j ++){
				//chrissstrahl - stop if player disconnected or dead
				if(local.player == NULL || local.player.health <= 0 ){
					break
				}

				// set the aim target to be a the player while hitting
				local.temp_origin = local.player.origin
				local.temp_origin[2] += level.target_offset

				$player_target.origin = local.temp_origin

				//chrissstrahl - not in cover
				if!(waitthread isInCover local.player){
					thread mg42_damage_player local.player
					local.explosedPlayers++;
					//[user 2026-08-28] THE MISSING WAIT. Single player spaces these 8 ticks with
					//`wait (randomfloat(0.6) + 0.3)` INSIDE this loop (m3l1a.scr:1861). The coop rewrite
					//dropped it, so all 8 fired in ONE FRAME. normal_damage is a PERCENTAGE of max_health
					//(entity.cpp:6079), so at coop_health 750 each tick is 37.5 HP and the burst was 300 HP
					//- 40 percent of the pool, instantly, with no gap to react in. That is the instakill,
					//and it is why tuning the MG42 weapon never changed anything.
					wait (randomfloat(0.6) + 0.3)
				}
				else{//chrissstrahl - in cover
					local.playerNotIncover = 0
					thread mg42_incover_player local.player.flags["coop_coverTrigger"]
				}
			}
			//play get down/take cover/put your head down... dialogs
			if(local.player != NULL && local.playerNotIncover ){
				local.player playsound warn_player_cover
			}

		}


		//chrissstrahl - keep timing of singleplayer in mp if there is just 1 player
		if(local.alivePlayers < 2){
			wait (randomfloat(0.6) + 0.3)
		}else{
			waitframe
		}

		//chrissstrahl - fire on other targets if there are no players to fire at
		if( local.explosedPlayers == 0){
			//iprintlnbold_noloc("mg42AttackBeach fire: normal targets")
			// set the MG42 turrets to fire at normal targets
			local.index = (randomint 4 + 1)
			$mg42_middle1 setaimtarget $mg42_target_left[local.index]
			$mg42_middle2 setaimtarget $mg42_target_right[local.index]
			wait 4 //was 3
		}
	}
}end


//chrissstrahl - check if this player is behind cover
//=========================================================================
isInCover local.player:{
//=========================================================================
	local.player.flags["coop_coverTrigger"] = NULL
	for(local.cpp=1;local.cpp<=$cover_trigger.size;local.cpp++){
		local.coverTrigger = $cover_trigger[local.cpp]
		if(local.player istouching local.coverTrigger){
			if (local.coverTrigger.stand == 0){
				if(local.player getposition == "crouching"){
					local.player.flags["coop_coverTrigger"] = local.coverTrigger
					end 1
				}
			}else{
				local.player.flags["coop_coverTrigger"] = local.coverTrigger
				end 1
			}
		}
	}

	//[user 2026-08-31] REAL COVER, NOT JUST THE AUTHORED VOLUMES.
	//
	//The user: standing behind the beached Sherman wrecks "does not actually" protect you - and it
	//could not, because nothing on this beach shoots you. mg42_damage_player applies damage DIRECTLY
	//(see the note at :268), and the only thing that ever stopped it was `istouching` one of the map's
	//baked $cover_trigger volumes. Anything not authored in 2002 - our tank wrecks, the beached Higgins
	//hulls, a shell crater lip, even a hedgehog the designer did not wrap in a trigger - counted for
	//nothing. Making the wrecks solid was therefore never going to help, which is why two attempts at
	//that did not move it.
	//
	//So ask the actual question instead: can the guns SEE him? sighttrace returns 1 for a clear line
	//(the map uses it that way at m3l1a.scr, `if (sighttrace ... 1)`), so if every emplacement is
	//blocked, he is behind something real and is in cover. That makes every solid object on the beach
	//work as cover, including the ones we add, without hand-authoring a trigger volume for each.
	//
	//Cost is bounded: the gun list is built ONCE into a level array, and it is at most 6 traces for a
	//player the guns are actively firing at. Chest height both ends so a prone man is not clipped by
	//his own floor.
	if(level.coop_losGunsBuilt != 1){
		level.coop_losGunsBuilt = 1
		level.coop_losN = 0
		if($mg42_leftbunker1 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_leftbunker1 }
		if($mg42_leftbunker2 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_leftbunker2 }
		if($mg42_rightbunker1 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_rightbunker1 }
		if($mg42_rightbunker2 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_rightbunker2 }
		if($mg42_middle1 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_middle1 }
		if($mg42_middle2 != NULL){ level.coop_losN++; level.coop_losGun[level.coop_losN] = $mg42_middle2 }
		println("^~^~^ BEACHLOS guns=" + level.coop_losN)
	}

	if(level.coop_losCoverOn == NIL){ level.coop_losCoverOn = 1 }
	if(level.coop_losCoverOn && level.coop_losN > 0){
		local.eye = local.player.origin + (0 0 40)
		local.seen = 0
		local.smk = 0
		local.gi = 1
		while(local.gi <= level.coop_losN && local.seen == 0){
			local.gun = level.coop_losGun[local.gi]
			if(local.gun != NULL){
				//pass_entities MUST be 0. The engine does `if (arg3) content_mask &= ~MASK_IGNORE_ENTS`,
				//and MASK_IGNORE_ENTS CONTAINS CONTENTS_BBOX - so passing 1 strips entity contents out of
				//the mask and the trace sees world geometry only. With 1 the tank clip was invisible to
				//this test, which is why the wrecks still did not protect anyone.
				//[user 2026-09-06, bug-2497] 'i dont feel like i take any damage at all up until the shingles'.
				//THE TRACE ENDED INSIDE THE PLAYER'S OWN BOX. With arg 0 the mask keeps CONTENTS_BODY/BBOX
				//(scriptthread.cpp:4007, bg_public.h:643) and the end point origin+40 is inside his 72-unit
				//collision box, which the clip reports as a hit (cm_trace.c:1679) - so seen stayed 0 for every
				//SOLID player from every gun, on open sand or not, and mg42_damage_player has not landed a tick
				//on a solid player since bug-2211 (2026-08-31). The one 13:06:35 pass was the glued, notsolid
				//player in the boat. Two traces now: world-only (arg 1) for the bunker wall, then the entity
				//trace (arg 0, which is what sees the tank-wreck boxes bug-2211 wanted) to a point pulled
				//48 units back toward the gun - outside his box in every direction.
				local.gpos = local.gun.origin + (0 0 24)
				local.gs = 0
				if(sighttrace local.gpos local.eye 1){
					local.dv = local.eye - local.gpos
					local.dlen = vector_length local.dv
					if(local.dlen > 64){
						local.inv = 48 / local.dlen
						local.eye2 = local.eye - ( local.dv * local.inv )
						if(sighttrace local.gpos local.eye2 0){ local.gs = 1 }
					}else{
						local.gs = 1
					}
				}
				//[user 2026-09-06, bug-2501] SMOKE IS COVER. 'we can't take damage if we are behind the smoke
				//that gets called in during the drop - it should be stopping them from seeing us.' Each landed
				//column (coop_smokeSignal_round keeps its emitter in level.coop_smokeCloud[slot] for the life of
				//the barrage) is a sphere of level.coop_smokeCoverR at 70 u up its stem; if this gun's line to
				//the player passes inside one, the gun is blind. Probe: BEACHLOS smoke=<n blinded>.
				if(local.gs == 1 && level.coop_smokeUp != NIL && level.coop_smokeUp > 0){
					if(level.coop_smokeCoverR == NIL){ level.coop_smokeCoverR = 200 }
					local.gd = local.eye - local.gpos
					local.gl = vector_length local.gd
					local.k = 1
					while(local.k <= 13 && local.gs == 1 && local.gl > 1){
						local.sc = level.coop_smokeCloud[local.k]
						if(local.sc != NULL && local.sc != NIL){
							local.cc = local.sc.origin + (0 0 70)
							local.sv = local.cc - local.gpos
							local.tt = ( vector_dot local.sv local.gd ) / ( local.gl * local.gl )
							if(local.tt > 0.03 && local.tt < 0.97){
								local.cp = local.gpos + ( local.gd * local.tt )
								local.cd = vector_length ( local.cp - local.cc )
								if(local.cd < level.coop_smokeCoverR){ local.gs = 0; local.smk++ }
							}
						}
						local.k++
					}
				}
				if(local.gs == 1){ local.seen = 1 }
			}
			local.gi++
		}
		//nothing can see him - he is behind something solid
		if(level.coop_losSaid == NIL){ level.coop_losSaid = 0 }
		if(level.time > ( level.coop_losSaid + 4 )){
			level.coop_losSaid = level.time
			println("^~^~^ BEACHLOS seen=" + local.seen + " smoke=" + local.smk + " y=" + int( local.player.origin[1] ) + " hp=" + local.player.health)
		}
		if(local.seen == 0){ end 1 }
	}
}end 0


//chrissstrahl - handles respawns for players
//makes sure they don't have all to start at the beginning again
//saves every 30 sec the player location if the player is in cover
//save also if player made it to the bunker entrance
//=========================================================================
manageRespawns:{
//=========================================================================
	local.runThisLoop = 1
	while(local.runThisLoop){
		for(local.pNum = 1;local.pNum<=$player.size;local.pNum++){
			local.player = $player[local.pNum]
			if(	local.player &&
				local.player.health > 0 &&
				local.player.dmteam != "spectator" &&
				local.player.flags["coop_isActive"] == 1 &&
				local.player.flags["congratsYouMadeit"] == NIL	)
			{
				local.origin = local.player.origin
				// 4832 -432
				if(local.origin[0] > 1540 && local.origin[1] > 4744){//1674 4821 -422
					level.flags["coop_spawn"+local.pNum+"origin"] = (1656 4784 -504)
					level.flags["coop_spawn"+local.pNum+"angles"] = (0 0 0)
					local.player.flags["congratsYouMadeit"] = 1 //this player will not be updated anymore
					//iprintlnbold_noloc("no more spawn updates for you")
				}
				//[203] Chrissstrahl - changed the time a spawnlocation will be saved after respawn to 10sec
				else if((local.player.flags["coverRespawnManageTime"] + 10) < level.time){
					for(local.cpp=1;local.cpp<=$cover_trigger.size;local.cpp++){
						local.coverTrigger = $cover_trigger[local.cpp]
						if(local.player istouching local.coverTrigger){
							if (local.coverTrigger.stand == 0){
								if(local.player getposition == "crouching"){
									level.flags["coop_spawn"+local.pNum+"origin"] = local.player.origin
									local.vec = (0 0 0)
									local.vec[1] = local.player.viewangles[1]
									level.flags["coop_spawn"+local.pNum+"angles"] = local.vec
									local.player.flags["coverRespawnManageTime"] = level.time
								}
							}else{
								level.flags["coop_spawn"+local.pNum+"origin"] = local.player.origin
								local.vec = (0 0 0)
								local.vec[1] = local.player.viewangles[1]
								level.flags["coop_spawn"+local.pNum+"angles"] = local.vec
								local.player.flags["coverRespawnManageTime"] = level.time
							}
						}
					}
				}
			 }
		}
		wait 0.2
		//[203] chrissstrahl - make it quick
		if(level.beachPartyTime){
			local.runThisLoop=0
		}
	}
	//[203] Chrissstrahl - allow players now to spawn near shingle, end loop
	
	println("DEVDEBUG: allow players now to spawn near shingle, end loop")
	
	for(local.pNum = 1;local.pNum<=$player.size;local.pNum++){
		local.player = $player[local.pNum]
		if(	local.player != NULL ){
			level.flags["coop_spawn"+local.pNum+"origin"] = (1656 4784 -504)
			level.flags["coop_spawn"+local.pNum+"angles"] = (0 0 0)
			local.player.flags["congratsYouMadeit"] = 1
		}
	}
}end

//=========================================================================
craters_cover local.player:{
//=========================================================================
	iprintlnbold_noloc("krater koffer")
}end

//=========================================================================
jitter_mg local.player:{
//=========================================================================
	//[user 2026-08-28] THESE WERE EMPTY. The coop rewrite stubbed both jitter labels out and never
	//filled them in, so every MG round that hits you on this beach lands with a perfectly still camera.
	//The engine's universal explosion shake (explosion.cpp:120) does not cover this - the beach guns do
	//not create an Explosion, they call script damage directly.
	//
	//Per-PLAYER, not radius: the stub already receives the exact player being hit, so the man being shot
	//gets the kick and the man behind the seawall does not. earthquake_player (coop_mod/main.scr:1893)
	//spawns a ViewJitter with donedeath, so it removes itself - bounded, and SVF_NOCLIENT so it costs no
	//snapshot.
	if(local.player == NULL || local.player.health <= 0){ end }
	local.player thread coop_mod/main.scr::earthquake_player 0.35 0.9
}end

//=========================================================================
jitter_mg_cover local.trig:{
//=========================================================================
	//Rounds cracking into the cover you are hiding behind. Softer than a hit - it should read as
	//pressure, not damage - but it must not be silent, or cover feels like a safe room.
	if(local.trig == NULL || local.trig == NIL){ end }
	thread coop_mod/main.scr::earthquake_radius local.trig.origin 0.3 0.45 700
}end

// mg42 damage player routine
//chrissstrahl - coop mod variant
//=========================================================================
mg42_damage_player local.player:{
//=========================================================================
	//chrissstrahl - handle for sp
	local.playerCount = $player.size
	if(local.playerCount == NIL){
		end
	}

	//[user 2026-08-28] BEACH LETHALITY BY DISTANCE. Every previous attempt tuned the MG42 WEAPON -
	//spread, AI damage, falloff - and none of it moved the needle, because the beach guns do not kill
	//you with bullets. This function does, directly, and the map aims the guns straight at your origin
	//with AIbulletspread 2 2. So the weapon was never the lever; this line is.
	//
	//The user's own design steer: the run up the open sand should be survivable, and it should get
	//dangerous as you close on the bunkers past the seawall. Y is the beach axis here (the thread above
	//already treats y > 4000 as inland), so damage scales with how far up the beach you are.
	//[user 2026-08-28] MISS CHANCE, ported from m3l1a.scr:1917. That fix was written for exactly this
	//complaint but lives in the SP-only mg42_damage_player, and coop ends the thread at m3l1a.scr:1790
	//before ever reaching it - so it has been inert in coop since it was written.
	//[user 2026-09-04] "whatever the percentage is that we found before adjust it" - this is that
	//percentage, and it is the only one in the beach damage path. 0.40 -> 0.32 takes the landed-round
	//rate from 60 to 68 percent: a flat +13 percent damage at every point on the run. Deliberately the
	//SMALLER of the two levers - the curve base below is what actually fixes the dead lower beach, and
	//stacking two large changes would overshoot "slightly".
	if(level.coop_beachMiss == NIL){ level.coop_beachMiss = 0.32 }
	if(randomfloat(1) < level.coop_beachMiss){
		thread jitter_mg local.player
		end
	}

	//NOTE: normal_damage takes a PERCENT of max_health, not HP - 5 here is 37.5 HP at coop_health 750.
	local.damage = 5
	//[2026-09-06, bug-2497] I WAS WRONG THIS MORNING: `normal_damage` is a PERCENT OF MAX HEALTH
	//(entity.cpp:6248, damage = arg/100 * max_health, and main.scr:584 `health` sets max_health to
	//coop_health), so retail's 5 already scales with the coop pool - 37.5 hp of 750 at full curve.
	//The coop_health/100 multiplier shipped at 09:29 would have been 37.5 PERCENT a tick the moment
	//the line-of-sight veto (isInCover) was fixed. Removed. The felt problem was never magnitude.
	local.py = local.player.origin[1]
	if(local.py < 0){ local.py = 0 }
	if(local.py > 3000){ local.py = 3000 }
	//[user 2026-08-28] 0.10 at the waterline climbing to 1.0 at the seawall - the run-in should be
	//survivable enough to actually play the landing; the danger belongs at the bunkers.
	//[user 2026-09-04] THE FOOT OF THAT CURVE WAS DEAD, AND THAT IS THE WHOLE "the beach is not
	//dangerous" REPORT. `local.damage = 5 * scale` is a PERCENT of max_health (Entity::normal_damage,
	//entity.cpp:6155) and the `if(local.damage < 1){ local.damage = 1 }` three lines below clamps it -
	//so EVERY scale under 0.20 produced the IDENTICAL 7.5 HP at coop_health 750. With a base of 0.10
	//that covered everything below y=333: the wade and the whole lower beach were one flat trivial
	//number, and no amount of retuning the 0.90 slope could reach them, because the clamp ate the
	//result before it ever became damage.
	//
	//0.20 is not a taste pick - 5 * 0.20 = 1.00 lands the foot EXACTLY on that floor. Lower is wasted
	//(clamped away); higher starts making the water itself lethal, which the landing cannot afford.
	//It is the unique value that makes the curve live across its whole domain. Measured, solo and
	//exposed, in time-to-death from 750 HP:
	//    y=0  138s -> 121s     y=500  110s -> 73s     y=1000  69s -> 52s
	//    y=2000  39s -> 33s    y=3000   28s -> 24s
	//The TOP of the curve is deliberately unchanged, so the seawall plays exactly as it does today.
	//
	//WHAT THIS DOES NOT FIX, and it is the bigger number in coop: the warning phase and the eight
	//fire ticks both sit INSIDE the per-player `for` loop in mg42AttackBeach, and there is one shared
	//$player_target that both guns aim at - so the beach services players SEQUENTIALLY and per-player
	//DPS scales as 1/N. At y=1000 with this tuning that is 52s solo but ~189s for a squad of four.
	//Left alone deliberately: it materially rebalances 4-player and deserves its own playtest.
	//
	//Level vars, NOT getcvar - a script getcvar creates the cvar EMPTY and permanently defeats the
	//engine-side default (bug-1669), which is this file's standing convention. coop_beachRise is
	//stored PRE-SUBTRACTED rather than written as ( 1 - base ), to keep a bare negative out of an
	//argument slot.
	//[user 2026-09-06] 0.20/0.80 -> 0.35/0.65: the waterline is where the MGs are aimed, not where they
	//are gentlest. Still 1.0 at y 3000.
	if(level.coop_beachBase == NIL){ level.coop_beachBase = 0.35 }
	if(level.coop_beachRise == NIL){ level.coop_beachRise = 0.65 }
	if(level.coop_beachTuneSaid != 1){
		level.coop_beachTuneSaid = 1
		println("^~^~^ BEACHTUNE base=" + level.coop_beachBase + " rise=" + level.coop_beachRise + " miss=" + level.coop_beachMiss)
	}
	local.scale = level.coop_beachBase + (level.coop_beachRise * (local.py / 3000))
	if(level.coop_beachDmg != NIL && level.coop_beachDmg > 0){
		local.scale = local.scale * level.coop_beachDmg
	}
	local.damage = local.damage * local.scale
	if(local.damage < 1){ local.damage = 1 }

	local.player normal_damage local.damage (0 -1 0)
	if(level.coop_beachHitSaid == NIL){ level.coop_beachHitSaid = 0 }
	if(level.time > ( level.coop_beachHitSaid + 3 )){
		level.coop_beachHitSaid = level.time
		println("^~^~^ BEACHHIT pct=" + local.damage + " y=" + int( local.py ) + " hp=" + local.player.health)
	}
	local.player playsound snd_bh_flesh
	thread jitter_mg local.player
}end

// mg42 player is in cover routine
//=========================================================================
mg42_incover_player local.trig:{
//=========================================================================
	if( local.trig == NULL || local.trig == NIL ){ end }

	thread jitter_mg_cover local.trig

	if ( local.trig.cover_type == "hedgehog"){
	//	println "trigger set: " $cover_trigger[level.cover_index].set
	//	println "trigger sound index: " $cover_trigger[level.cover_index].sound_index
	//	println "sound set: " $cover_sound[$cover_trigger[level.cover_index].sound_index].set
	//	println "OOOOO, just come out from that hedgehog, it won't hurt.......FOR LONG!!!"
		$cover_sound[ local.trig.sound_index] playsound hedgehog_supression
	}
	else if ( local.trig.cover_type == "ramp"){
		$cover_sound[ local.trig.sound_index] playsound ramp_supression
	}
	else if ( local.trig.cover_type == "crater"){
		$cover_sound[local.trig.sound_index] playsound crater_supression
	}
}end

//chrissstrahl - kills player with lots of damage when he comes to close to the level edge
//=========================================================================
warningTriggers local.damage:{
//=========================================================================
	//make sure we fix what was not done right
	if(self == NULL || self.flags["warningTriggers"] != NIL){

		println("DEV: warningTriggers multiple calls prevented!!!")
		end
	}
	self.flags["warningTriggers"] = 1

	while(1){
		//wait for the trigger to activate (by player)
		self waittill trigger
		wait 1.5
		//now handle each player
		for (local.i = 1;local.i <= $player.size;local.i++){
			local.player =  $player[local.i]
			//if existing, touching the trigger and alive
			if( local.player != NULL && local.player istouching self && local.player.health > 0){

				//extra check for coop only (skip if player invalid)
				//skip spectators or players in respawn
				if( level.gametype != 0 ){
					if( local.player.dmteam == "spectator" || local.player.flags["coop_isActive"] != 1 ){
						continue
					}
					//make sure player will not respawn inside killzone
					exec coop_mod/main.scr::resetSpawn local.player
				}

				//hurt player
				local.player exec maps/m3l1a.scr::bhit local.damage
			}
		}
	}
}end

//chrissstrahl -
//=========================================================================
mg42_attack_closest:{
//=========================================================================
	while(level.mg42_attack_closest){
		local.player = exec coop_mod/replace.scr::player_closestTo $mg42_middle2
		//[user 2026-08-31] THIS WAS A SILENT NO-OP. `setAimTarget` is registered EV_NORMAL, not
		//EV_SETTER (fgame/weapturret.cpp), so the property form `$ent.setaimtarget = x` does not reach
		//it - it just wrote a dead script variable, and the middle guns never tracked anyone. The
		//command form is what works, and this same file already uses it correctly at :67 and :126.
		$mg42_middle1 setaimtarget local.player
		$mg42_middle2 setaimtarget local.player
		wait 3
	}
}end

//=========================================================================
sequence_5_medic local.medic local.patient:{
//=========================================================================
	local.inAnim = 0
	while(1){
		wait 1
		local.player = thread medic_closest local.medic
		if( local.player != NULL ){
			local.medic lookat local.player
			local.medic turnto local.player
			local.medic waittill turndone
			wait 1

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(level.m3l1a_sequence == 11){
				break
			}

			if (randomint(100) > 50){ local.medic say medic_heal1 }
			else{ local.medic say medic_heal2 }

			local.inAnim = 1
			local.medic upperanim pass_canteen_start
			local.medic waittill upperanimdone

			while (1){
				wait 0.1
				if(level.m3l1a_sequence == 11){
					break
				}
				//[200] Smithy -  NULL/NIL/DEAD medic check
				if(local.player == NULL || local.player.health <= 0 || !isAlive local.medic || vector_length (local.player.origin - local.medic.origin) < 110){
					break
				}
			}

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(local.player != NULL || local.player.health > 0){
				local.player heal 1
			}

			local.medic upperanim pass_canteen_end
			local.inAnim = 0
			wait 2

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(level.m3l1a_sequence == 11){
				break
			}

			local.medic lookat NULL
			local.medic turnto local.patient
			local.medic.turndoneerror = 10
			local.medic waittill turndone
			wait 1

			if(level.m3l1a_sequence == 11){
				break
			}
			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check
			local.medic turnto NULL
		}
	}
	if(local.inAnim){
		local.medic upperanim pass_canteen_end
	}
}end

//=========================================================================
shingle_medic local.medic:{
//=========================================================================
	local.inAnim = 0
	while(level.m3l1a_sequence != 11){
		wait 1
		if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check
		local.player = thread medic_closest local.medic
		if(local.player != NULL){
			local.medic lookat local.player
			local.medic turnto local.player
			local.medic waittill turndone
			wait 1

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(level.m3l1a_sequence == 11){
				break
			}

			if (randomint(100) > 50){ local.medic say medic_heal1 }
			else{ local.medic say medic_heal2 }

			local.inAnim = 1
			local.medic upperanim pass_canteen_start
			local.medic waittill upperanimdone

			while (1){
				wait 0.1
				if(level.m3l1a_sequence == 11){
					break
				}
				//[200] Smithy - NULL/NIL/DEAD medic check
				if(!isAlive local.medic || local.player == NULL || local.player.health <= 0 || vector_length (local.player.origin - local.medic.origin) < 110){
					break
				}
			}

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(local.player != NULL || local.player.health > 0){
				local.player heal 1
			}

			local.medic upperanim pass_canteen_end
			local.inAnim = 0
			wait 2

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(level.m3l1a_sequence == 11){
				break
			}

			// reset his turnto
			local.medic lookat NULL
			local.medic.turndoneerror = 10
			local.medic turnto $mg42_middle1
			local.medic waittill turndone
			wait 0.5

			if (!isAlive local.medic){ end } //[200] Smithy -  NULL/NIL/DEAD medic check

			if(level.m3l1a_sequence == 11){
				break
			}

			local.medic turnto NULL
			local.medic exec global/prone.scr
		}
	}
	if(local.inAnim){
		local.medic upperanim pass_canteen_end
	}
}end

//=========================================================================
medic_closest local.object:{
//=========================================================================
	local.objectOrigin = ( 0 0 0 )
	local.player = NULL
	local.playerReturn = NULL
	local.playerOrigin = (0 0 0)
	local.closestDistance = 999999

	//make array for 8 players

	if( local.object == NULL ){
		end NULL
	}else{
		local.objectOrigin = local.object.origin
	}

	for (local.i = 1;local.i <= $player.size;local.i++){
		local.player = $player[local.i]
		if( local.player != NULL && local.player.dmteam != "spectator" && local.player.health > 0 && (local.player.health / local.player.max_health) < 1 ){
			if( vector_length( local.player.origin - local.objectOrigin ) < local.closestDistance ){
				local.playerReturn		= local.player
				local.closestDistance	= vector_length( local.player.origin - local.objectOrigin )
			}
		}
	}

	//to far away from medic
	if( local.closestDistance > 512){
		end NULL
	}
}end local.playerReturn

//=========================================================================
//[user 2026-08-28] NAVAL GUNFIRE LANDING INLAND.
//
//Historically the capital ships offshore - Texas and Arkansas at Omaha - shifted to inland targets
//once the landing began, so shells were falling BEHIND the German positions for the whole approach.
//The bunkers on this map sit at Y 5360..5952 (read from the BSP entity lump), so this shells the
//ground beyond them and never near a player.
//
//COSMETIC ONLY, by the user's instruction: no radiusdamage, no Damage call, notsolid. It cannot hurt
//a player or an actor, and it cannot break a scripted AI. That also keeps it off the damage paths that
//caused the beach lethality problem in the first place.
//
//ENTITY COST: one transient script model at a time, removed after its animation. The pool is 2048 and
//an overrun once cost this project a weekend of crashes, so the loop is strictly serial - it never
//spawns a second burst before removing the first.
//=========================================================================
coop_inlandShelling:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_inlandShell == NIL){ level.coop_inlandShell = 1 }
	if(level.coop_bluffShellGap == NIL){ level.coop_bluffShellGap = 2.6 }

	//[user 2026-08-31] REWRITTEN. The 2026-08-28 version never put a single visible burst on the
	//bluff, for two independent reasons, and the user's report was simply "i dont see the bunker
	//areas getting shelled either":
	//
	//  1. It spawned models/fx/explosionartilleryshell.tik and called `anim start`. That TIKI's
	//     animations block contains ONLY `idle` - there is no `start` - and Animate::NewAnim is a
	//     silent no-op when Anim_NumForName returns -1. The call did nothing and said nothing.
	//     models/animate/fx_mortar_dirt.tik has a real `start` anim and is already precached by
	//     m3l1a_precache.scr, so it is the right entity here.
	//
	//  2. It rolled Y as `6200 + (randomint 1600)` = 6200..7800, described in its own comment as
	//     "BEHIND the bunkers". Behind the bunkers is behind the crest, i.e. out of sight from the
	//     beach by construction - and most of that band is past the far edge of the map entirely.
	//     A bombardment the player cannot see is indistinguishable from no bombardment.
	//
	//Now it walks the actual emplacements the player is looking at. Purely cosmetic: fx_mortar_dirt
	//is `classname effectentity` + `notsolid`, its start anim's server block only schedules a return
	//to idle, and NOTHING here calls radiusdamage - so the MG gunners the mission depends on are
	//never touched. The tik plays its own `arty_exp_sand` on the client, so no playsound here either;
	//adding one would double every bang.
	local.n = 0
	if($mg42_left1 != NULL){ local.n++; local.tgt[local.n] = $mg42_left1 }
	if($mg42_left2 != NULL){ local.n++; local.tgt[local.n] = $mg42_left2 }
	if($mg42_leftbunker1 != NULL){ local.n++; local.tgt[local.n] = $mg42_leftbunker1 }
	if($mg42_leftbunker2 != NULL){ local.n++; local.tgt[local.n] = $mg42_leftbunker2 }
	if($mg42_middle1 != NULL){ local.n++; local.tgt[local.n] = $mg42_middle1 }
	if($mg42_middle2 != NULL){ local.n++; local.tgt[local.n] = $mg42_middle2 }
	if($mg42_right1 != NULL){ local.n++; local.tgt[local.n] = $mg42_right1 }
	if($mg42_right2 != NULL){ local.n++; local.tgt[local.n] = $mg42_right2 }
	if($mg42_rightbunker1 != NULL){ local.n++; local.tgt[local.n] = $mg42_rightbunker1 }
	if($mg42_rightbunker2 != NULL){ local.n++; local.tgt[local.n] = $mg42_rightbunker2 }

	if(local.n < 1){
		println("^~^~^ BLUFFSHELL no emplacements found - shelling disabled")
		end
	}
	println("^~^~^ BLUFFSHELL armed targets=" + local.n)

	while(level.coop_inlandShell){
		local.pick = local.tgt[((randomint local.n) + 1)]
		if(local.pick == NULL){
			wait 1
			continue
		}

		//Scatter around the emplacement rather than on it, so rounds walk across the position
		//instead of stacking on one point. Up on the lip, not inside the casemate.
		local.org = local.pick.origin
		local.org[0] = local.org[0] + ((randomint 420) - 210)
		local.org[1] = local.org[1] + ((randomint 420) - 210)
		local.org[2] = local.org[2] + (randomint 80)

		local.burst = spawn "models/animate/fx_mortar_dirt.tik"
		if(local.burst != NULL && local.burst != NIL){			//entity-pool guard
			local.burst.origin = local.org
			local.burst notsolid
			local.burst anim start

			wait 4
			if(local.burst != NULL){ local.burst remove }
		}else{
			wait 4
		}

		//irregular spacing - a metronome reads as a machine, not a bombardment
		wait (randomfloat(level.coop_bluffShellGap) + 0.9)
	}
}end

//=========================================================================
//[user 2026-08-28] FAR-FIELD BOMBARDMENT - the beach is being shelled somewhere OTHER than where you
//are standing. The stock mortar_ambient only ever fires in the zone the player currently occupies, so
//the rest of the beach is dead quiet and the battle feels like it is following you around.
//
//Fires $mortar anchors DIRECTLY with `anim start` and deliberately NOT through mortar_call: that label
//carries `radiusdamage self.origin 1000 192` and a whistle-and-waittill, neither of which belongs on a
//decorative blast a thousand units away. Cosmetic only, like the inland shelling.
//
//ZERO entity cost: the $mortar anchors are BSP entities that already exist and are already in the pool.
//Nothing is spawned here at all.
//=========================================================================
coop_farFieldShelling:{
//=========================================================================
	if(level.gametype == 0){ end }
	if($mortar == NULL || $mortar.size <= 0){ end }
	if(level.coop_farField == NIL){ level.coop_farField = 1 }

	while(level.coop_farField){
		local.pick = $mortar[(randomint $mortar.size) + 1]
		if(local.pick == NULL){
			wait 1
			continue
		}

		//only fire it if it is FAR from every living player - that is the whole point. A near anchor is
		//mortar_ambient's job and it already does damage there.
		local.tooClose = 0
		for(local.i = 1; local.i <= $player.size; local.i++){
			local.pl = $player[local.i]
			if(local.pl == NULL || local.pl.health <= 0){ continue }
			if(vector_length(local.pick.origin - local.pl.origin) < 1400){
				local.tooClose = 1
			}
		}

		if(!local.tooClose){
			local.pick anim start
			local.pick playsound ("arty_exp_sand" + ((randomint 4) + 1))
		}

		wait (randomfloat(2.2) + 0.8)
	}
}end

//=========================================================================
//[user 2026-08-28] KNOCKED-OUT ARMOUR AT THE WATERLINE.
//
//Historically the 743rd Tank Battalion landed Shermans directly onto Dog sector (the DD tanks that
//swam were mostly lost further out), and knocked-out armour on the sand is one of the defining images
//of that beach. There is none on this map.
//
//models/static/vehicle_shermantank_dead.tik ONLY - verified clean: it is in main/Pak0 (always mounted),
//has no init block and no classname, so it carries no vehicle logic, no turret state and no scripting.
//The Breakthrough US_V_Sherman_BustedTread variant was deliberately NOT used: it is maintt-only and
//declares `init { server { classname ScriptSlave } }`, which is a live entity, not scenery.
//
//[user 2026-08-31] NOW SOLID. The original note below argued for notsolid on AI-pathing grounds; the
//user played it and reported walking straight through the hulls, which reads as broken scenery long
//before it reads as considerate pathing. A knocked-out Sherman is also the only hard cover on an
//otherwise open beach, so solid is the better answer twice over. Superseded reasoning kept for the
//record: "A solid box dropped on a beach the AI walks across is a pathing hazard, and this is set
//dressing - it should never block a soldier or absorb a bullet meant for you."
//
//Two things make it safe here. The spots are off the flanks, clear of the scripted run-in lanes the
//rangers use, and the boxes are sized to the hull rather than left at the model default.
//
//YAW IS FIXED, NOT RANDOM, AND THAT IS LOAD-BEARING. A SOLID_BBOX entity is axis-aligned in world
//space - SV_ClipMoveToEntities only feeds angles through CM_TransformedBoxTrace for bmodels, and a
//script_model is not one - so the collision box does NOT rotate with the model. The old
//`(55 + randomint 70)` yaw would have put a 230-long hull at an arbitrary angle inside whatever box
//we picked, giving invisible walls off the bow on some rolls and walk-through flanks on others. Each
//wreck now gets a yaw near an axis and a box matching THAT orientation.
//=========================================================================
coop_beachWrecks:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachWrecksOn == NIL){ level.coop_beachWrecksOn = 1 }
	if(!level.coop_beachWrecksOn){ end }

	//waterline positions, off to the flanks so they frame the run-in rather than block it. Z matches the
	//beach floor the BSP corpses sit on (about -500).
	local.spots[1] = (0 0 0)
	local.spots[1][0] = 0 - 2050
	local.spots[1][1] = 0 - 520
	local.spots[1][2] = 0 - 500
	local.spots[2] = (0 0 0)
	local.spots[2][0] = 2280
	local.spots[2][1] = 0 - 180
	local.spots[2][2] = 0 - 500
	local.spots[3] = (0 0 0)
	local.spots[3][0] = 0 - 380
	local.spots[3][1] = 0 - 900
	local.spots[3][2] = 0 - 500

	//Yaw per spot, each within ~10 degrees of an axis, with the matching hull box below.
	//A Sherman is roughly 230 long, 115 wide, 110 tall in map units (1u ~= 1in).
	local.yaw[1] = 90
	local.yaw[2] = 8
	local.yaw[3] = 82

	for(local.i = 1; local.i <= 3; local.i++){
		local.wreck = spawn script_model model "models/static/vehicle_shermantank_dead.tik"
		if(local.wreck == NULL){ continue }		//entity-pool guard
		local.wreck.origin = local.spots[local.i]
		local.wreck.angles = (0 local.yaw[local.i] 0)

		local.wreck anim idle

		//[user 2026-08-31] COLLISION IS A SEPARATE ENTITY NOW. The user reported twice that standing
		//behind these still did not stop rounds, and two attempts to make the MODEL solid (vector-literal
		//form, then anim/setsize/solid ordering) did not settle it. Rather than guess a third time at why
		//a TIKI-derived bbox is not taking, the hull keeps its visuals and an invisible box does the
		//blocking. That box is ours end to end - explicit setsize, nothing derived from the model.
		//
		//`rendereffects "+dontdraw"` and NOT `hide`: dontdraw still SENDS the entity to the client
		//(entity.cpp:881), so the client's own bullet traces stop on it and you get impact effects on
		//cover. `hide` sets SVF_NOCLIENT, which would stop server damage but let tracers visibly pass
		//straight through - protection that looks broken.
		local.wreck notsolid
		local.clip = spawn script_model model "models/fx/dummy.tik"
		if(local.clip != NULL && local.clip != NIL){			//entity-pool guard
			local.clip.origin = local.spots[local.i]
			local.clip.angles = (0 local.yaw[local.i] 0)
			local.clip rendereffects "+dontdraw"
			//long axis runs along Y for the near-90 yaws, along X for the near-0 one. A SOLID_BBOX is
			//axis-aligned in world space regardless of angles, which is why the yaws are fixed near an
			//axis and the box is matched to each one.
			if(local.yaw[local.i] > 45){
				local.clip setsize ( -58 -115 0) (58 115 112)
			}else{
				local.clip setsize ( -115 -58 0) (115 58 112)
			}
			local.clip solid
		}

		//one of them is still burning - a cold wreck reads as scenery, a burning one reads as recent
		if(local.i == 2){
			local.smoke = spawn script_model model "models/emitters/shermansmoke.tik"
			local.smoke.origin = local.spots[local.i]
			local.smoke notsolid
			local.smoke anim start
		}
	}
}end


//[user 2026-08-31] BEACH SMOKE SIGNAL.
//
//The landing used to open straight into "Get to the shingle". It now opens on a portable field radio at
//the waterline: call the smoke drop, a white screen goes up along the run-in, and THAT releases the rest
//of the mission. Every position is one of the user's own viewpos marks.
//
//OBJECTIVE INDEX 1, which sorts to the TOP of the list - the HUD walks CS_OBJECTIVES..+MAX_OBJECTIVES
//in index order (cg_drawtools.cpp), so the index IS the sort key. Retail owns 2-8 on this map
//(shingle 2 at m3l1a.scr:2347, captain 3 at :5223, bangalores 4 at :5378, bring-back 5 at :3700,
//follow 6 at :5758, trench 7 at :5982, bunker 8 at :3649), which leaves 1 free - and retail must NOT
//be renumbered, because coop_mod/challenges.scr keys its awards off the literal strings "m3l1a:4"
//(challenges.scr:1717), "m3l1a:2" (:1718) and "m3l1a:8" (:1786). Shifting them would silently break
//Finest Hour, Longest Day, Four Abreast and Dog Green Present. Nothing here renumbers anything.
//
//[corrected 2026-09-04] INDEX 0 IS NOT AN OPTION, and the comment that stood here said it was, on
//three counts that were every one of them stale: it claimed index 0 was in use when the code a
//hundred lines below already used 1, and it cited challenge keys "m3l1a:3" and "m3l1a:7" that do not
//exist. Measured, three independent reasons: (a) addobjective is 1-BASED - the engine does
//`index = GetInteger(1) - 1` and its ONLY guard is `index >= MAX_OBJECTIVES` (scriptthread.cpp), so
//`add_objectives 0` would write configstring CS_OBJECTIVES-1, i.e. the LAST precached MODEL slot;
//(b) global/objectives.scr has no `case 0` in any of its four switches, so coopObjective0Text never
//exists and neither the text read-back nor the per-player send ever fires; (c) ui/coop_objectives/
//ships obj_1..obj_8 only, so `exec ui/coop_objectives/obj_0active` names a file that does not exist.
//`current_objectives 0` is separately retail's idiom for "no current objective"
//(SetCurrentObjective(-1) zeroes m_vObjectiveLocation), and m3l1a.scr uses it four times.
//
//SLOT 1 CARRIES UP TO FOUR PUBLISHES on this map: the landing, the rendezvous, and then EITHER the
//body or - when there is no radioman at all - the set on the sand; then the status-3 close. Every
//publish after the first MUST clear flags["coop_objToastSeenm1"] on every connected player first or
//its announcement is silently swallowed (bug-2330), and every one that MOVES the marker must end
//with current_objectives, which is the only call that re-reads the location out of the configstring.
//Nothing may reuse slot 1 after the status-3 at the end of coop_smokeSignal: that sets
//$world.flags["objectiveComplete1"] permanently, and current_objectives bails on a completed index
//before it updates the per-player yellow.
//
//RADIO IS models/items/walkietalkie.tik - the SCR-536 handie-talkie, which is the small portable set.
//The first version used models/miscobj/radio_military.tik, a big static field station.
//
//VIEWPOS REPORTS THE EYE, NOT THE FEET, so every coordinate is lowered by 60 before use.
//
//SP is untouched: the caller only threads this when level.gametype != 0, and
//level.coop_smokeSignalOn 0 restores the retail opening.
//=========================================================================
coop_smokeSignal:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( level.coop_smokeSignalOn == NIL ){ level.coop_smokeSignalOn = 1 }
	if( level.coop_smokeSignalLife == NIL ){ level.coop_smokeSignalLife = 300 }

	//Switched off, or the radio could not be built: fall back to the retail opening so the map is
	//never left without a current objective.
	if( !level.coop_smokeSignalOn ){
		waitthread coop_smokeSignal_releaseShingle
		end
	}

	//[user 2026-09-04] THE RADIOMAN, NOT A RADIO LYING ON THE SAND.
	//
	//"we rendevouz with the radio man, and he does his whole dialogue, and then he gets shot
	//immediately after and dies (scripted) gore and all. Our objective then becomes to interact with
	//his body to call in the support strike (he has a radio on his back) and we just remove our
	//flashing radio object. The rest of the sequence fires as is."
	//
	//THE FICTION WAS ALREADY IN THE MAP AND NOTHING WAS USING IT. $center_radioman is retail's own
	//man, spawned "models/human/dday_29th_private_radio" at m3l1a.scr:6719/:6831/:6917, and that TIK
	//- inside the `case weapon "none"` branch he is actually spawned with - carries radio_backpack.skd
	//plus a `phone` surface: a real set on his back and a real handset, as geometry. His retail line
	//036h is "Shore party... Request additional supporting fire, over!" - he is ALREADY calling for
	//the fire support that never comes. Killing him the moment he finishes IS the reason it never
	//came, which is why this beat invents no dialogue: there is no wav anywhere in m3l1 of him saying
	//it did not get through, and scripting a line with no wav is precisely the moving-mouth-and-
	//silence defect this map has been chasing all week.
	//
	//IT ALSO FIXES A STAGING BUG. The set sat at (297, 312, -479), 344 units from him, while his own
	//speak trigger is 160 - so a player could call the barrage having never heard the line that
	//motivates it. One anchor now serves both.
	//
	//THE PROP IS NOT DELETED, IT IS DEMOTED. coop_smokeSignal_buildProp holds it verbatim and is used
	//when there is no radioman to use (never spawned, or already dead when the landing ends) and when
	//the beat fails to produce an interactable. This objective has a long history of leaving the map
	//unfinishable - bugs 2192, 2322, 2330, 2365 - and the one outcome that must never happen is a
	//current objective nobody can complete.
	//HE DOES NOT EXIST YET, AND ASKING WHETHER HE DOES IS THE BUG.
	//
	//This label is threaded at m3l1a.scr:2390, during the boat run-in. $center_radioman is spawned by
	//the BEACH trigger labels - player_sequence_5_center / _right / _left, m3l1a.scr:6706 / :6818 /
	//:6904 - which do not fire until a player is well up the sand. The first cut of this tested
	//`$center_radioman != NULL` right here and therefore ALWAYS took the fallback: the radioman beat
	//was unreachable code sitting behind a prop that won every time.
	//
	//So the route is a policy decision, not an entity test, and the objective anchors on his SPAWN
	//ORIGIN, which is a literal and is byte-identical in all three of those labels
	//(m3l1a.scr:6721 / :6833 / :6919 all set (192.00 640.00 -456.00)). coop_radiomanBeat then waits
	//for the man himself to appear, which is the only place that wait can correctly live.
	local.useMan = 0
	if( level.coop_radiomanOn == NIL ){ level.coop_radiomanOn = 1 }
	if( level.coop_radiomanOn == 1 ){ local.useMan = 1 }

	local.rpos = (0 0 0)
	local.trig = NULL
	if( local.useMan == 1 ){
		local.rpos[0] = 192
		local.rpos[1] = 640
		local.rpos[2] = 0 - 456
		println("^~^~^ RADIOMAN route on at=" + local.rpos[0] + "," + local.rpos[1])
	}
	else{
		local.rpos[0] = 297
		local.rpos[1] = 312
		local.rpos[2] = 0 - 479
		println("^~^~^ RADIOMAN route off - the set goes on the sand")
		local.trig = waitthread coop_smokeSignal_buildProp local.rpos
		if( local.trig == NULL || local.trig == NIL ){
			waitthread coop_smokeSignal_releaseShingle
			end
		}
	}

	//[user 2026-09-02, bug-2322] "once we land in water it becomes 'Signal the smoke barrage.'"
	//
	//[bug-2330] AND THE TOAST LATCH IS CLEARED FIRST. "the objective menu isnt updating correctly with
	//all new objectives" - coop_obj_toast is one-shot per player, keyed "coop_objToastSeen" + "m" +
	//index (coop_mod/objectives.scr:66-8, 734). Slot 1 is now used TWICE on this map - once for the
	//landing and once for the smoke - so the second announcement was silently swallowed by the latch
	//the first one set. Clearing it per player is what lets one slot carry two objectives.
	//[user 2026-09-02, bug-2365] "Survive objective no longer exists, it starts on the signal
	//objective." Both of these are objective index 1, and coop_smokeSignal is threaded at
	//m3l1a.scr:2375 - FORTY LINES after coop_landingObjective at :2335, i.e. while the boat is
	//still running in. So "Signal the smoke barrage" overwrote "Survive the beach landing" within
	//a second or two of it being set, and the player never saw the first one at all.
	//
	//The user's sequence was explicit: "the first objective should read 'Survive the beach
	//landing'... once we land in water it becomes 'Signal the smoke barrage'". So the swap waits
	//for the landing. coop_rampDone is set by the handoff, and it is also set on the paths where
	//the cinematic is disabled or fails, so this cannot wait forever for a beat that never came.
	local.t = 0
	while(level.coop_rampDone != 1 && local.t < 180){
		wait 0.5
		local.t = local.t + 0.5
	}
	wait 1.5

	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){
			$player[local.i].flags["coop_objToastSeenm1"] = 0
		}
		local.i++
	}
	//[user 2026-09-04] THE RENDEZVOUS IS ITS OWN OBJECTIVE AND IT COMES FIRST. This line used to read
	//"Signal the smoke barrage." - the CALL-BARRAGE wording - while the player was still only being
	//sent to FIND the man, i.e. the two beats read in the wrong order: call the barrage, meet a man,
	//call the barrage. Slot 1 now carries three lines in sequence - Survive the beach landing ->
	//Rendezvous with the radioman -> Use the radioman's set to call the barrage.
	//THE TEXT IS ROUTE-DEPENDENT, because the fallback route has no radioman to meet: with
	//level.coop_radiomanOn 0 the walkietalkie goes on the sand at (297 312 -479) and the old wording
	//is still the correct one.
	local.otext = "Signal the smoke barrage."
	if( local.useMan == 1 ){ local.otext = "Rendezvous with the radioman." }
	waitthread global/objectives.scr::add_objectives 1 1 local.otext local.rpos
	waitthread global/objectives.scr::add_objectives 1 2
	wait .5
	//current_objectives is NOT optional on a republish, and this is the call that makes the ON-SCREEN
	//marker follow the text. SetCurrentObjective is the ONLY place that re-reads the "loc" key out of
	//the objective configstring into level.m_vObjectiveLocation (scriptthread.cpp) - add_objectives
	//writes the loc into the configstring but never into the marker. It is not short-circuited on a
	//repeat index either: setcurrentobjective runs BEFORE both of current_objectives' early-outs
	//(global/objectives.scr), so the location is re-read even when the per-player yellow is skipped.
	waitthread global/objectives.scr::current_objectives 1
	println("^~^~^ RADIOMAN objective rendezvous text=" + local.otext + " at=" + local.rpos[0] + "," + local.rpos[1])

	//[user 2026-09-04] THE OBJECTIVE IS PUBLISHED FIRST, POINTING AT HIM, and only then does the beat
	//run - so the marker is what leads the player into the 160-unit trigger that starts his line. The
	//beat returns the thing the player interacts with; if it cannot produce one (he was never
	//approached, or the entity pool is exhausted) the set goes on the sand at his position instead, so
	//there is always something to use and the marker never moves away from where the player was sent.
	if( local.useMan == 1 ){
		local.trig = waitthread coop_radiomanBeat local.rpos
		if( local.trig == NULL || local.trig == NIL ){
			println("^~^~^ RADIOMAN beat produced no trigger - the set goes on the sand")
			local.trig = waitthread coop_smokeSignal_buildProp local.rpos
			//[user 2026-09-04] AND PUT THE WORDING BACK. The objective standing on screen at this point
			//reads "Rendezvous with the radioman." and there is no radioman to rendezvous with - he never
			//appeared inside the beat's seven-minute window, or the beat could not build an interactable.
			//Re-publish the set-on-the-sand wording so the text, the marker and the thing actually lying
			//there all agree, instead of sending the squad to meet a man who is not coming.
			//THIS BRANCH IS NOW REACHABLE, AND IT WAS NOT BEFORE. coop_radiomanBeat step 4 used to spawn
			//its trigger unconditionally and therefore always returned non-NULL, so the only way here was
			//an exhausted entity pool. Step 4 now returns NULL when there is no radioman, which is what
			//routes the no-man case into this branch and puts a real, lit prop under the marker.
			//[bug-2330] THE TOAST LATCH IS CLEARED FIRST. coop_obj_toast is one-shot per player, keyed
			//"coop_objToastSeen" + "m" + index (coop_mod/objectives.scr), and slot 1 has already been
			//published twice by the time this runs - without the clear this announcement is swallowed in
			//silence and the user sees the text change with no notification at all.
			if( local.trig != NULL && local.trig != NIL ){
				local.j = 1
				while( local.j <= $player.size ){
					if( $player[local.j] != NULL && $player[local.j] != NIL ){
						$player[local.j].flags["coop_objToastSeenm1"] = 0
					}
					local.j++
				}
				waitthread global/objectives.scr::add_objectives 1 1 "Signal the smoke barrage." local.rpos
				waitthread global/objectives.scr::add_objectives 1 2
				wait .5
				waitthread global/objectives.scr::current_objectives 1
				println("^~^~^ RADIOMAN objective fallback on the set at=" + local.rpos[0] + "," + local.rpos[1])
			}
		}
		if( local.trig == NULL || local.trig == NIL ){
			//nothing left to interact with at all. Close the objective rather than leaving it current
			//and impossible, then hand the mission on exactly as the switched-off path does.
			waitthread global/objectives.scr::add_objectives 1 3
			waitthread coop_smokeSignal_releaseShingle
			end
		}
	}

	//Wait for a real player to use it. parm.other is the toucher (objective_drop.scr:143).
	while( 1 ){
		local.trig waittill trigger
		local.user = parm.other
		if( local.user == NULL ){ continue }
		if( local.user.classname != "Player" ){ continue }
		break
	}

	//Setting this stops coop_smokeSignal_beacon on its next tick, so the radio goes dark once used.
	level.coop_smokeSignalDone = 1

	//[user 2026-09-02, bug-2337] the challenge writer. chal_team_bump rather than chal_bump: calling
	//the barrage is a squad beat, not a personal one, and everyone who is on the beach for it gets it.
	//This is the ONLY place cc_bomber_smoke is written, which is what makes it earnable exactly once.
	thread coop_mod/challenges.scr::chal_team_bump "cc_bomber_smoke" 1
	if( level.coop_smokeTrig != NULL ){ level.coop_smokeTrig remove }
	if( level.coop_smokeRadio != NULL ){ level.coop_smokeRadio lightOff }

	//[user 2026-09-05] CALL AND ANSWER - AND THE CALL IS OURS NOW.
	//
	//"And then when WE use the radio, we play this line instead."
	//
	//The generic coop_radio_airstrike_req/_resp pair that used to sit here was a placeholder for
	//exactly this beat, and 036h IS the request, verbatim: "Shore party. Gap teams and assault
	//infantry are pinned down at beach obstacles! Request additional supporting fire, over!"  Keeping
	//both would be the same transmission twice in two different voices, so the placeholder goes.
	//
	//THREADED.  The exchange runs ~13.0s (036h 5.841 + 2.0 of dead air + 045a 4.506 + two squelches)
	//and the barrage, the objective flip and the advance must not queue behind it.  What DOES wait for
	//it is coop_advanceOnSmoke, on level.coop_radiomanTxDone, so the charge call cannot land on top of
	//division's answer.  The flag is stamped 0 here rather than inside the thread because the thread
	//may not get a frame before the advance thread reads it.
	//
	//ORDER.  The toast and the objective go FIRST and the transmission follows them, which is the
	//order the player experiences it in: he keys the set, the objective updates to say the barrage is
	//coming, and then his call goes out over the net.  The old code put the placeholder request BEFORE
	//the toast with a wait 1.6 between the two halves, so the toast landed in the middle of the
	//exchange; add_objectives' own half-second is now the beat between keying the set and the squelch.
	level.coop_radiomanTxDone = 0

	iprintlnbold "Smoke drop called in. Move up under the smoke!"
	waitthread global/objectives.scr::add_objectives 1 3

	thread coop_radiomanTransmit level.coop_smokeRadio

	level.coop_smokeUp = 0
	level.coop_smokeLanded = 0
	thread coop_smokeSignal_drop
	thread coop_advanceOnSmoke

	//[user 2026-09-02, bug-2381] "can we ensure the guy who says go go go after the smoke drops
	//actually waits for the smoke to land before he progresess up on his own".
	//
	//He did not: coop_smokeSignal_drop is THREADED, so it returns immediately and the release fired
	//while the rounds were still in the air. coop_smokeSignal_round sets coop_smokeLanded on the
	//first one that actually arrives, so this waits for the smoke to exist and then gives it three
	//more seconds to build into something worth advancing under. The 25s ceiling means a drop that
	//somehow never lands cannot strand the shingle - the men still go.
	local.t = 0
	while(level.coop_smokeLanded != 1 && local.t < 25){
		wait 0.5
		local.t = local.t + 0.5
	}
	wait 3

	waitthread coop_smokeSignal_releaseShingle
}end

//Slow red pulse on the radio so it can be found on an open beach, and goes dark the moment it is used.
//light/lightRadius/lightOn is the same locator recipe objective_drop.scr:107-113 uses for its pickup
//glow; the only addition is lightOff on the off-beat to make it blink rather than glow steadily.
//=========================================================================
coop_smokeSignal_beacon local.ent:{
//=========================================================================
	if( local.ent == NULL ){ end }
	local.ent light (1 0.12 0.08)
	local.ent lightRadius 110

	while( level.coop_smokeSignalDone != 1 ){
		if( local.ent == NULL ){ end }
		local.ent lightOn
		wait 0.45
		if( local.ent == NULL ){ end }
		local.ent lightOff
		wait 0.35
	}
	if( local.ent != NULL ){ local.ent lightOff }
}end


//THE SET ON THE SAND, kept verbatim from the original beat and demoted to the radioman's fallback.
//Returns the trigger the caller must wait on, or NULL if the entity pool is exhausted (bug-914
//family). The caller owns the release-the-shingle decision, because by the second call site an
//objective is already published and bailing out has to close it first.
//=========================================================================
coop_smokeSignal_buildProp local.rpos:{
//=========================================================================
	local.out = NULL
	//spawn by TIK path, not `spawn script_model` + model: walkietalkie.tik declares its own
	//`classname animate` in its init/server block, and that block only runs on the TIK-spawn path.
	local.radio = spawn "models/items/walkietalkie.tik"
	if( local.radio != NULL && local.radio != NIL ){
		//[user 2026-08-31] SIT IT ON THE SAND - spawn it clear of the ground and let the engine put
		//it down, rather than driving the origin to the viewpos mark, which left it half-sunk.
		local.radio.origin = local.rpos + (0 0 40)
		local.radio.angles = (0 79 0)
		local.radio notsolid
		local.radio droptofloor
		local.radio rendereffects "+fullbright"
		level.coop_smokeRadio = local.radio
		thread coop_smokeSignal_beacon local.radio

		//trigger_use, not trigger_multiple: a solid trigger_multiple never fires on walk-over because
		//G_TouchTriggers skips anything whose solid != SOLID_TRIGGER (objective_drop.scr:85).
		local.trig = spawn trigger_use
		if( local.trig != NULL && local.trig != NIL ){
			local.trig.origin = local.rpos + (0 0 10)
			local.trig solid
			local.trig setsize ( -32 -32 -10) (32 32 72)
			level.coop_smokeTrig = local.trig
			local.out = local.trig
		}
	}
}end local.out


//THE RENDEZVOUS, THE DEATH, AND THE BODY AS THE OBJECTIVE. [user 2026-09-04]
//
//Returns the trigger to interact with, or NULL if it could not build one.
//
//WHY THE DWELL IS SPELLED OUT IN SECONDS. coop_vbSay does NOT wait for a line to finish - it takes
//the bus, calls `say`, and returns on the same frame - so chaining the death onto it would shoot him
//about a second into a four-and-a-half second sentence. The numbers: 036h is 4.6s, and coop_vbRadio
//latches level.coop_vbRadioDone on its FIRST statement and then waits 6s before saying 045a, which
//is 4.51s, so the pair ends 10.51s after 036h starts. One second is long enough for that latch to be
//readable, which is what lets this tell the two cases apart instead of always waiting for the longer.
//
//WHY THE FLAG IS THE RENDEZVOUS. retail's sequence_5_center_radioman sets isinsequence 1 at spawn
//and holds it until a player closes to 160 units, then says his line and clears it. So watching the
//flag fall costs nothing, races nothing, and cannot double-play a line we do not own. If the
//sequence never ran at all the flag is NIL rather than 1 and this falls straight through to the
//death - degraded, but never stuck.
//
//THE KILL IS THE MAP'S OWN RECIPE, not a new one: maps/m3l1a.scr::bhit plus coop_gorechunk,
//coop_blooddrip and coop_bloodslick, exactly as coop_flankCutDown drops the men on the flanks. Two
//staggers and then the round that puts him down, so it reads as being shot rather than as a despawn.
//
//THE FLASHING GOES ON HIM, which was the user's direct question. coop_smokeSignal_beacon only needs
//an entity that answers light/lightRadius/lightOn/lightOff, and a dead actor is still an Entity -
//MOHAA leaves the body in the world. If the corpse HAS gone (gibbed, or coop_corpseLife enabled and
//expired) the beacon moves to the trigger, which sits at the same spot and is ours for the whole
//objective, so the pulse is always somewhere. He is deliberately NOT given rendereffects
//"+fullbright" the way the little walkietalkie was: on a human body it reads as a lit-up mannequin.
//=========================================================================
coop_radiomanBeat local.rpos:{
//=========================================================================
	local.out = NULL

	//0. WAIT FOR HIM TO EXIST AT ALL. He is spawned by a beach trigger label, not at map load, so
	//at the moment this beat starts he is usually still NULL - that is normal, not a failure. Seven
	//minutes is a deliberate over-estimate of how long a squad might take to reach his part of the
	//beach; on timeout the caller drops the set on the sand at his spawn point instead.
	local.t = 0
	while( local.t < 420 ){
		if( $center_radioman != NULL && $center_radioman != NIL ){ break }
		wait 1
		local.t = local.t + 1
	}
	local.man = $center_radioman
	if( local.man == NULL || local.man == NIL ){
		println("^~^~^ RADIOMAN never spawned t=" + local.t)
	}
	else{
		println("^~^~^ RADIOMAN spawned t=" + local.t)
	}

	//1. THE RENDEZVOUS.
	local.t = 0
	local.go = 1
	while( local.go == 1 ){
		if( local.man == NULL || local.man == NIL ){ local.go = 0 }
		else if( !isalive local.man ){ local.go = 0 }
		else if( local.man.isinsequence != 1 ){ local.go = 0 }
		else if( local.t >= 300 ){ local.go = 0 }
		else{
			wait 0.5
			local.t = local.t + 0.5
		}
	}
	println("^~^~^ RADIOMAN rendezvous t=" + local.t)

	//2. THE PAUSE BEFORE THE ROUND. [user 2026-09-05]
	//
	//THERE IS NO LONGER A LINE TO WAIT OUT.  m3l1a.scr::sequence_5_center_radioman no longer says 036h
	//and no longer threads coop_vbRadio (level.coop_radiomanHushOn, default 1); the transmission is the
	//player's now, at the set.  What is left here is a beat long enough to register a live man kneeling
	//over the handset and short enough that the round still reads as "he was shot the moment we reached
	//him" - which is what was asked for.  1.2s: step 1 polls at 0.5s, so the round lands 1.2-1.7s after
	//the player crosses the 160-unit ring.
	//
	//AND THE OLD NUMBER WAS WRONG.  With the hush switched off this restores the previous behaviour,
	//with one measured correction: 036h is 5.841s, NOT 4.6s.  Measured on the shipping wav, twice, on
	//two independent extracted copies (sound-browser/sound_library/radio/comms_voice/ and
	//_hd_staging/.../dialogue/m3l1/a/), both 5.841s at 22050Hz; 045a measures 4.506s against the 4.51
	//already recorded here, which is what validates the extraction.  The old 4.6 therefore shot him
	//1.24s BEFORE his own sentence finished, on every run that took the single-line branch.  The
	//two-line branch is unchanged: coop_vbRadio waits 6s then speaks 4.506s, so the pair ends at 10.51.
	if( local.man != NULL && local.man != NIL ){
		if( isalive local.man ){
			local.hush = 1
			if( level.coop_radiomanHushOn == NIL ){ level.coop_radiomanHushOn = 1 }
			if( !level.coop_radiomanHushOn ){ local.hush = 0 }

			if( local.hush == 1 ){
				if( level.coop_radiomanHushDwell == NIL ){ level.coop_radiomanHushDwell = 1.2 }
				local.dwell = level.coop_radiomanHushDwell
				if( local.dwell < 0.1 ){ local.dwell = 0.1 }
				println("^~^~^ RADIOMAN hush dwell=" + local.dwell)
				wait local.dwell
			}
			else{
				//poll for the latch rather than sampling it once: coop_vbRadio sets coop_vbRadioDone on its
				//first statement, but a single probe would depend on that staying wait-free forever, and
				//reading it too early picks the short dwell and shoots him mid-sentence. The elapsed total is
				//the same either way because the dwell subtracts whatever the poll spent.
				local.w = 0
				while( local.w < 3 && level.coop_vbRadioDone != 1 ){
					wait 0.5
					local.w = local.w + 0.5
				}
				local.dwell = 5.9 - local.w
				if( level.coop_vbRadioDone == 1 ){ local.dwell = 10.6 - local.w }
				if( local.dwell < 0.5 ){ local.dwell = 0.5 }
				println("^~^~^ RADIOMAN dwell=" + local.dwell + " waited=" + local.w)
				wait local.dwell
			}
		}
	}

	//3. AND THEN THEY SHOOT HIM.
	if( local.man != NULL && local.man != NIL ){
		if( isalive local.man ){
			println("^~^~^ RADIOMAN down")
			local.man takedamage
			local.o = local.man.origin + (0 0 44)
			local.man thread maps/m3l1a.scr::bhit 40 -1
			local.b = spawn script_model model "models/fx/coop_gorechunk.tik"
			if( local.b != NULL && local.b != NIL ){
				local.b.origin = local.o
				local.b notsolid
				thread coop_fxCleanup local.b 25
			}
			wait 0.18
			if( local.man != NULL && local.man != NIL ){
				if( isalive local.man ){
					local.o = local.man.origin + (0 0 40)
					local.man thread maps/m3l1a.scr::bhit 1000 -1
					local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
					if( local.sp != NULL && local.sp != NIL ){
						local.sp.origin = local.o
						local.sp notsolid
						local.sp anim start
						thread coop_fxCleanup local.sp 6
					}
					local.g = spawn script_model model "models/fx/coop_bloodslick.tik"
					if( local.g != NULL && local.g != NIL ){
						local.g.origin = local.o - (0 0 40)
						local.g notsolid
						if( waitthread coop_placeGround local.g 170 ){ local.g anim start }
					}
				}
			}
			//5. AND THE HOLE IN HIS HEAD. [user 2026-09-04]
			//A frame after the killing round, so IsDead() is already true and Sentient::ArmorDamage takes
			//its CORPSE branch (CoopGoreCorpseDamage) - no health, no EV_Killed, no pain, nothing that can
			//fail an allied death - while the death animation has barely started, so .angles is still a
			//usable facing. He IS already dead by here: bhit is synchronous (maps/m3l1a.scr::bhit ->
			//`self exec global/bullethit.scr`, which contains no wait), so the 1000-point round has already
			//landed on the frame it was threaded.
			//PLACEMENT, STATED HONESTLY: this sits INSIDE the outer `if( isalive local.man )` that opens
			//block 3, so it runs on the scripted death only. If he was already dead when the beat reached
			//him, block 3 is skipped whole and there is no scripted wound - he will already be carrying
			//whatever gore killed him. An earlier draft of this comment claimed the opposite; the brace
			//depths say otherwise and it was simply measured wrong.
			wait 0.05
			waitthread coop_radiomanHeadWound local.man
			wait 0.6

			//[user 2026-09-05] AND THE ORDER THAT ANSWERS IT. "Just get up the beach!" - dfr_M3L1_300f,
			//finished, voice-acted, subtitled, shipped in Pak0 (uberdialog.scr:552) and spoken by NOTHING
			//in any of the three games.  Its one retail call site is commented out at m3l1a.scr:3932, on
			//the line directly above the 044a that replaced it, so the two are alternates and 044a won.
			//
			//THIS IS THE MOMENT IT BELONGS TO: the man who could have brought fire onto that beach is
			//face-down over his own set, and the only order left is to keep moving.  It is also a window
			//this beat now OWNS end to end - retail's 036h has been taken out of it and coop_vbRadio no
			//longer runs - so it is the one push-order slot on this map with nothing already talking in it.
			//
			//INSIDE the isalive block, so it fires on the scripted death only, exactly like the head wound
			//above it.  THREADED, not waited on: step 4 publishes the objective and must not sit behind a
			//voicebank claim.  See coop_vbBeachPush for the speaker and the kill switch.
			thread coop_vbBeachPush
		}
	}

	//4. HIS BODY BECOMES THE OBJECTIVE.
	local.bpos = local.rpos
	if( local.man != NULL && local.man != NIL ){ local.bpos = local.man.origin }

	//[user 2026-09-04] NO MAN, NO BODY OBJECTIVE - and this is what finally makes the caller's
	//"the set goes on the sand" fallback reachable. This block spawned the trigger UNCONDITIONALLY,
	//outside every `if( local.man != NULL )`, so even when $center_radioman never appeared at all the
	//beat still returned a non-NULL trigger and still published "Use the radioman's set to call the
	//barrage." - pointing at an INVISIBLE trigger_use on bare sand, with the objective beacon pulsing
	//on a model-less entity (local.lit below falls back to the trigger). The player got a marker over
	//nothing and had to guess to press use. Returning NULL instead hands the decision back to
	//coop_smokeSignal, which drops the real walkietalkie at the same spot, lights it, and re-publishes
	//the set-on-the-sand wording. A dead radioman is NOT this case: a corpse is still an entity, and
	//his body is exactly what the objective should sit on.
	local.trig = NULL
	if( local.man != NULL && local.man != NIL ){ local.trig = spawn trigger_use }
	if( local.trig != NULL && local.trig != NIL ){
		local.trig.origin = local.bpos + (0 0 10)
		local.trig solid
		//a shade wider than the set on the sand was: this is a body lying down, not an upright prop,
		//and the player should be able to reach the radio from either side of it.
		local.trig setsize ( -40 -40 -10) (40 40 72)
		level.coop_smokeTrig = local.trig

		local.lit = local.trig
		if( local.man != NULL && local.man != NIL ){ local.lit = local.man }
		level.coop_smokeRadio = local.lit
		thread coop_smokeSignal_beacon local.lit

		//[bug-2330] the toast latch is one-shot per player per index, and index 1 is now used a THIRD
		//time on this map (landing, then signal, now the body). Without this clear the announcement is
		//silently swallowed and the user sees the objective text change with no notification at all.
		local.i = 1
		while( local.i <= $player.size ){
			if( $player[local.i] != NULL && $player[local.i] != NIL ){
				$player[local.i].flags["coop_objToastSeenm1"] = 0
			}
			local.i++
		}
		waitthread global/objectives.scr::add_objectives 1 1 "Use the radioman's set to call the barrage." local.bpos
		waitthread global/objectives.scr::add_objectives 1 2
		wait .5
		waitthread global/objectives.scr::current_objectives 1
		println("^~^~^ RADIOMAN objective on the body at=" + local.bpos[0] + "," + local.bpos[1])
		local.out = local.trig
	}
}end local.out


//THE BULLET WOUND IN HIS HEAD. [user 2026-09-04]
//
//"kinda like what we did with the glider pilot" - and that recipe does NOT transfer. e2l1's
//gliderride.scr::coop_bloodyGliderPilot works by SKIN BITS (`self surface "head*" "+skin1"`), which
//needs authored blood skins on the head. This model had none: dday_29th_private_radio.tik carried a
//bare `surface head shader srg_dirty` - ONE skin, no _blood ladder, even though its pants, jacket
//and hands all have one. A "+skin1" there asks for shader index 1 of 1, and both renderers clamp an
//out-of-range skin index straight back to 0 (renderergl2/tr_model.cpp, renderergl1/tr_model.cpp), so
//it would have silently done nothing at all. (The ladder is now added to that TIK in the same
//change, off the srg_dirty_blood1/2/3 art that was generated on 2026-08-31 and wired to nothing - so
//his FACE goes bloody from the 1040 points of scripted damage, and this label supplies the HOLE.)
//
//THE MOD'S OWN TOOL IS models/fx/coop_wound1.tik - the crossed-quad xbeam patch wearing the
//coop_wound1 shader - which the engine attaches at the hit bone in Sentient::CoopGoreTryWoundProp.
//Already precached here (maps/m3l1a_precache.scr:206), so nothing new ships. It carries no
//init{server{}} block, so none of the bug-2244 set-piece-that-kills-you risk applies, and the engine
//spawns it SOLID_NOT so it can never block a player.
//
//WHY THIS DRIVES THE ENGINE PATH AND NOT attachmodel. attachmodel would work - the offset is its
//TENTH argument (EV_AttachModel "ssFSBFFFFV", all nine preceding args required; helmet.scr:398 is
//the working 10-arg form) - but it attaches with use_angles TRUE, so the offset lands in the head
//bone's LOCAL frame. That frame is the trap this project has already paid for twice: officer.scr
//records that the head bone's axes are not world-up and an attachmodel offset "sat off to the side",
//which is why the faction marker was rewritten as a world follower, and helmet.scr had to expose its
//offset as three tuning cvars. Handing the engine a WORLD point makes it do the conversion itself
//(world delta -> tag axes -> minus the hit-sphere centre -> clamped out onto the 5-unit head sphere
//+ coop_goreWoundProud) and it also applies the xbeam half-length pivot correction the mesh needs,
//which a hand-rolled attachmodel would have to reproduce. No tuning pass, no guessed axis.
//
//WHY fwd*5 AND NOT SOMETHING SMALLER. The bone-local hit-sphere centre is (2.5, 3.5, 0) with the
//long axis running along the bone, so the 3.5 is the FORWARD/BACK term. The engine forms
//fromCenter = (our point in tag axes) - (2.5, 3.5, 0) and pushes the prop out along THAT direction.
//With a 5-unit forward reach the forward term of fromCenter stays 5 - 3.5 = 1.5 the correct side of
//zero, so the patch lands on the FRONT of the skull whichever way the bone's Y axis is signed. Drop
//it to 2 and the term flips to 2 - 3.5 = -1.5 and the wound moves to the BACK of his head. The
//standoff clamp only ever pushes the prop OUT, never in, so this cannot end up inside the mesh
//(bug-735); if it reads as floating, coop_goreWoundProud and coop_goreWoundScale tune it live.
//
//IT SURVIVES THE DEATH ANIMATION AND THE CORPSE SETTLING because it is attached to the BONE, not
//placed in the world - it tracks Bip01 Head every frame. detach_at_death is not a threat: it
//defaults to qtrue and attachmodel sets it, but it is NEVER READ anywhere in this engine, and no
//actor death path detaches children (the same reason CoopGoreTryDripAttach can hang a drip on a
//fresh corpse). It is removed with the body, by the body's own destructor.
//=========================================================================
coop_radiomanHeadWound local.man:{
//=========================================================================
	if( local.man == NULL || local.man == NIL ){ end }

	//gettagposition returns the bone's WORLD position; if the tag is missing the statement is skipped
	//with a Script Error and this stays NIL, which the guard catches - a missing bone degrades to no
	//wound, never to a wrong one.
	local.hp = local.man gettagposition "Bip01 Head"
	if( local.hp == NIL || local.hp == NULL ){ end }

	local.fwd = angles_toforward local.man.angles
	if( local.fwd == NIL ){ end }
	local.wp = local.hp + ( local.fwd * 5 ) + (0 0 2)

	//attacker damage inflictor position direction normal knockback damageflags meansofdeath location
	//- EV_Damage's own format is "eievvviiii", so all ten are required and in that order.
	//
	//16 = DAMAGE_BULLET (g_local.h).
	//
	//18 = MOD_BULLET, AND IT IS NOT 17. This is the one token the whole beat turns on. retail's table
	//- and the `16 17` in global/bullethit.scr that every `bhit` on this map routes through - is off
	//by one from MOD_BEAM onward, because this engine's meansOfDeath_t inserts MOD_GRENADE at 14
	//(bg_public.h): 16 MOD_ROCKET, 17 MOD_IMPACT, 18 MOD_BULLET, 19 MOD_FAST_BULLET. 17 is MOD_IMPACT,
	//and CoopGoreTryWoundProp's first content gate accepts only MOD_BULLET / MOD_FAST_BULLET /
	//MOD_SHOTGUN - so a 17 here returns at that gate, attaches nothing, prints no Script Error, and
	//still lets the println below report success. The corollary is that the map's own bhit calls have
	//never produced a wound prop either, which is why this beat spawns its gore FX by hand.
	//
	//0 = HITLOC_HEAD, and this is the other easy one to get wrong. bullethit.scr's "5 Head" name table
	//and EV_Damage's own help string are retail documentation that does NOT match this engine, where
	//hitloc_t has HITLOC_HEAD 0 and szLocArray[0] is "Bip01 Head". NOT 1 either: he wears a helmet
	//(his TIK's sethelmet "us_helmet"), so HITLOC_HELMET survives CheckHitLocation and the wound code
	//skips helmet hits outright. And bhit could not be used for this even at the right location,
	//because bullethit.scr hard-codes position (0 0 0) and a zero position makes CoopGoreTryWoundProp
	//fall back to the bone-sphere CENTRE, inside the skull - bug-735 verbatim, swallowed by the mesh.
	//
	//Knockback 0 - a corpse must not be shoved, and the corpse path changes no health, so the 12 only
	//ever feeds the gore damage accumulator. ATTACKER STAYS NULL on purpose: it keeps this off every
	//kill-credit, XP and challenge path, and the corpse branch uses the attacker for nothing else.
	local.man damage NULL 12 NULL local.wp local.fwd (0 0 0) 0 16 18 0

	println("^~^~^ RADIOMAN headwound at=" + local.wp[0] + "," + local.wp[1] + "," + local.wp[2])
}end


//THE PLAYER'S TRANSMISSION, AND THE ANSWER THAT COMES BACK TO HIM. [user 2026-09-05]
//
//WHAT MOVED.  036h used to be the radioman's own line, said 344 units from the set, finished before
//the player ever touched it; 045a came back to HIM six seconds later off coop_vbRadio.  He is silent
//now and dead on the sand, so the man on the handset is the player - and BOTH halves move with the
//handset.  The exchange is what it always was, addressed to somebody who is still alive to hear it.
//
//WHY 045a MOVES TOO, RATHER THAN BEING DROPPED.  It is the only thing that makes the beat mean
//anything.  We ask for supporting fire; division answers "Any senior noncom, take the men off the
//beach!" - which is not a promise of fire, it is an order to stop waiting for it.  That is precisely
//why the player then calls his own smoke and why the beach gets up and moves, and it keeps a
//finished, subtitled retail line that has never once played in three games.  Dropping it would leave
//our transmission hanging with no reply, on a radio, which reads as a bug rather than as a beat.
//
//WHO PHYSICALLY SPEAKS IT, AND WHY IT CANNOT BE EITHER OBVIOUS CANDIDATE:
//  THE PLAYER CANNOT.  `say` is EV_Actor_SayAnim (fgame/actor.cpp:537), bound only in Actor's
//    response list.  A Player is not an Actor; the statement would not resolve.
//  THE CORPSE CANNOT.  Actor::EventSayAnim short-circuits on m_ThinkState == THINKSTATE_KILLED
//    (actor.cpp:7758) and never reaches SoundSayAnim, so a `say` on a dead man is not a quiet line -
//    it is NO sound at all, silently.
//  A NEARBY RANGER SHOULD NOT.  It is a radio transmission.  There is no mouth in it, and putting
//    lipsync and a name on it would make some private the author of the player's own call.
//So it is played, once, ON THE RADIO - the corpse carrying radio_backpack.skd and its `phone`
//surface, which is level.coop_smokeRadio, the same entity the objective beacon pulses on.  This is
//the recipe the site already used for coop_radio_airstrike_req/_resp, and officer.scr::coop_radio_all
//is its sibling; the only thing not borrowed from coop_radio_all is its per-player loop, because that
//emits one copy at each player's own origin and two players standing together would hear the line
//twice, phased.  One emitter, one copy.
//
//WHY THE ALIAS IS RE-DECLARED AND WHY THAT IS SAFE HERE.  The retail aliases are `dialog streamed`
//at 200/1500. Streamed means the 2D dialogue path - no 3D start gate (S_OPENAL_StartSound diverts
//streamed before ShouldStart), a LINEAR fade to maxDist, the Dialogue slider, the vox sidechain -
//so the only thing wrong with retail's declaration for this beat is the 1500: a squadmate 2000
//units up the beach hears nothing. coop_radio_m3l1_036h / _045a in ubersound/coop_audio.scr are
//the same two wavs on the same path with the fade widened to 3000. (The first draft declared them
//`voice loaded`, the 3D path, where the alias volume is discarded and barks duck the line - the
//adversarial pass caught it.) The standing rule against re-aliasing ("`say` resolves the lipsync
//anim BY ALIAS NAME and the .skc ships only under the original name") does not reach this: nothing
//here says, everything here plays, and playsound wants no anim. One caveat shared with every
//entity-bound line on this beach: a listener whose snapshot drops the corpse mid-line loses the
//rest of it (Respatialize ends a one-shot whose entity went stale). If that shows up in a 2-player
//test, play the two lines from an origin instead of the body.
//
//WHAT IS LOST, STATED PLAINLY: the subtitle.  In coop the server-side subtitle block is gated on
//g_gametype == GT_SINGLE_PLAYER (fgame/entity.cpp:3803), so the only path that captions anything is
//the client-side one (cgame/cg_commands.cpp:3882), reached only when a dialogue ANIM fires the sound
//from the model.  No actor, no anim, no caption.  That is the price of the line being a radio rather
//than a man, and the beat already carries its own iprintlnbold a moment later.
//
//KILL SWITCHES: level.coop_radiomanTxOn 0 (no transmission at all; the flag is stamped done so the
//advance is never held), level.coop_radiomanReplyOn 0 (our call goes out, nothing answers).
//=========================================================================
coop_radiomanTransmit local.emitter:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( level.coop_radiomanTxOn == NIL ){ level.coop_radiomanTxOn = 1 }
	if( !level.coop_radiomanTxOn ){
		level.coop_radiomanTxDone = 1
		println("^~^~^ RADIOTX off")
		end
	}

	//one shot, claimed before the first wait so two players on the trigger cannot produce two runs.
	if( level.coop_radiomanTxRan == 1 ){ end }
	level.coop_radiomanTxRan = 1
	level.coop_radiomanTxDone = 0

	//THE EMITTER, RESOLVED ONCE AND RE-TESTED BEFORE EVERY USE.  Normally the body; the set on the
	//sand on the fallback route.  If the corpse has gone (gibbed, or coop_corpseLife enabled and
	//expired) fall back to the first player, which is still one emitter rather than N.
	local.e = local.emitter
	if( local.e == NULL || local.e == NIL ){ local.e = level.coop_smokeRadio }
	if( local.e == NULL || local.e == NIL ){
		if( $player.size >= 1 ){ local.e = $player[1] }
	}
	if( local.e == NULL || local.e == NIL ){
		level.coop_radiomanTxDone = 1
		println("^~^~^ RADIOTX skip reason=no_emitter")
		end
	}

	//THE BUS, BEST EFFORT.  This is the payoff of a mission objective, not an opportunistic bark, so
	//it goes out whether or not the bank grants the claim - but when it does grant it, aivoice and
	//every other slot are parked for the whole exchange instead of just the first sentence.
	local.hook = waitthread coop_vbHookOk
	local.claim = 0
	if( local.hook == 1 ){ local.claim = waitthread coop_vbClaim 4 "radiotx" }

	//OUR CALL.  Squelch first: it is the one thing that frames a disembodied voice as a transmission
	//rather than a ghost, and it is the same lead-in officer.scr::coop_radio_all uses.
	if( local.e != NULL && local.e != NIL ){ local.e playsound coop_radio_static }
	wait 0.35
	if( local.claim == 1 ){ waitthread coop_vbHold 7.1 }
	if( local.e != NULL && local.e != NIL ){
		local.e playsound coop_radio_m3l1_036h
		println("^~^~^ RADIOTX call alias=coop_radio_m3l1_036h ent=" + local.e.entnum + " t=" + level.time)
	}
	if( local.claim == 1 ){ waitthread coop_vbWait 5.841 }
	else{ wait 5.841 }

	//THE ANSWER.  Skipped if the radioman already delivered it himself - that is the hush-off path,
	//where coop_vbRadio has run and latched coop_vbRadioDone.  Latching it here is what makes the two
	//paths mutually exclusive in both directions.
	local.reply = 1
	if( level.coop_radiomanReplyOn == NIL ){ level.coop_radiomanReplyOn = 1 }
	if( !level.coop_radiomanReplyOn ){ local.reply = 0 }
	if( level.coop_vbRadioDone == 1 ){ local.reply = 0 }

	if( local.reply == 1 ){
		level.coop_vbRadioDone = 1
		//two seconds of dead air.  Long enough to read as somebody at the other end keying up, short
		//enough that the exchange is over before the smoke is standing and the whistles go.
		if( local.claim == 1 ){ waitthread coop_vbWait 2 }
		else{ wait 2 }
		if( local.e != NULL && local.e != NIL ){ local.e playsound coop_radio_static }
		wait 0.35
		if( local.e != NULL && local.e != NIL ){
			local.e playsound coop_radio_m3l1_045a
			println("^~^~^ RADIOTX reply alias=coop_radio_m3l1_045a t=" + level.time)
		}
		if( local.claim == 1 ){ waitthread coop_vbWait 4.506 }
		else{ wait 4.506 }
	}
	else{
		println("^~^~^ RADIOTX reply skipped reason=already_said")
	}

	if( local.claim == 1 ){ waitthread coop_vbRelease }
	level.coop_radiomanTxDone = 1
	println("^~^~^ RADIOTX done t=" + level.time)
}end


//"Just get up the beach!" - dfr_M3L1_300f. [user 2026-09-05]
//
//THE LINE.  1.055s, measured on the shipping wav.  It is declared in retail's own uberdialog.scr:552
//with a subtitle and a maps filter of "m dm obj", so it loads on m3l1a - and it is spoken by nothing,
//anywhere, in any of the three games.  Its single retail call site is commented out at
//m3l1a.scr:3932, immediately above `$higgins1_ranger10 say streamed_dfr_scripted_M3L1_044a`, which
//tells you what it is: the alternate take of the same order, and 044a is the one that shipped.
//
//WHICH IS ALSO THE ONE RISK, NAMED.  044a - "Get up the beach now! Move, move, c'mon, go!" - is said
//TWICE at the smoke advance (coop_advanceOnSmoke picks the nearest free ranger, coop_advanceWhistles
//says it again ~3.3s later through a second man) with an iprintlnbold of the same words between them.
//So "get up the beach" is already a saturated phrase at that beat, and this line is deliberately NOT
//placed there.  It is placed at the radioman's death instead, which is the previous push moment and
//the one this change has just emptied: retail's 036h has been taken out of it and coop_vbRadio no
//longer runs, so nothing else is speaking.  If it still reads as an echo in play, level.coop_vb300fOn
//0 is the whole of the switch.
//
//IT HAS A MOUTH. [verifier 2026-09-05, correcting the first draft of this note] The say anim exists:
//M3L1_dialogue_US.tik:552 `dfr_M3L1_300f actor_m3l1_300.skc` (22 frames, 1.10s, `first sound`), and
//it is reachable on every ranger here because Generic_dialogue_US.tik:23 `includes test m3l1`
//pulls that pack in for this map. So this plays as a normal lipsynced say, not the SoundSayAnim
//fallback. The one way it is lost is the one every say shares: UpdateSayAnim (actor.cpp:7943)
//drops the request silently for an actor in THINKSTATE_ATTACK/GRENADE, which is why THIS beat's
//pick (coop_vbAnyoneCalm) refuses those candidates and re-tests at the say - only this line needs
//it; the other beach lines have no upper-body channels and start fine mid-fight. In coop the
//caption is still lost (entity.cpp:3803 gates the
//server-side subtitle on single player).
//
//SPOKEN BY A MAN, NOT BY THE RADIO, and therefore through `say` and the retail alias at its retail
//200/1500 - the opposite decision to the transmission above, for the opposite reason: a shouted order
//SHOULD come from a body on the sand and SHOULD fall off with distance (bug-2451 is the whole
//argument).  coop_vbAnyone already refuses any candidate more than 1000 units from the nearest
//player, so it can never be shouted by a man nobody is standing near.
//=========================================================================
coop_vbBeachPush:{
//=========================================================================
	local.hook = waitthread coop_vbHookOk
	if( local.hook != 1 ){ end }
	if( level.coop_vb300fOn == NIL ){ level.coop_vb300fOn = 1 }
	if( !level.coop_vb300fOn ){
		println("^~^~^ VOICEBANK push off")
		end
	}
	if( level.coop_vbPushDone == 1 ){ end }

	//a beat after the body settles, so the order answers the round rather than covering it.
	wait 0.4

	local.m = waitthread coop_vbAnyoneCalm
	if( local.m == NULL || local.m == NIL ){
		println("^~^~^ VOICEBANK push skip reason=no_speaker")
		end
	}

	//patient: this window is ours and nothing is queued behind it, so sitting out a bark that is
	//already running is strictly better than talking over one - twice, then give up out loud.
	//[verifier 2026-09-05] The one-shot latch is taken AFTER a successful claim, not before: a bank
	//busy for the whole 6s used to burn the latch and drop the line for good. AND NEVER OVER THE
	//PLAYER'S OWN TRANSMISSION: if the set has been keyed by the time the bank is ours, the shouted
	//order would land on top of 036h, so it yields to the radio instead.
	local.claim = 0
	local.tries = 0
	while( local.claim != 1 && local.tries < 2 ){
		if( level.coop_radiomanTxRan == 1 ){
			println("^~^~^ VOICEBANK push skip reason=radio_keyed")
			end
		}
		local.claim = waitthread coop_vbClaim 6 "push"
		local.tries++
	}
	if( local.claim != 1 ){
		println("^~^~^ VOICEBANK push skip reason=bank_busy")
		end
	}
	if( level.coop_radiomanTxRan == 1 ){
		waitthread coop_vbRelease
		println("^~^~^ VOICEBANK push skip reason=radio_keyed")
		end
	}
	//[verifier 2026-09-05, rounds 2+3] RE-PICK AT THE SAY, not only at the start: up to 12s can pass
	//in the claim loop, and a man who died, was pulled into a sequence, moved out of range or started
	//fighting in that window would have the line vetoed or dropped silently (this alias HAS upper-body
	//channels, so UpdateSayAnim's ATTACK/GRENADE/PAIN early-return applies to it). coop_vbAnyoneCalm
	//contains no wait, so claim -> pick -> say is atomic.
	local.m = waitthread coop_vbAnyoneCalm
	if( local.m == NULL || local.m == NIL ){
		waitthread coop_vbRelease
		println("^~^~^ VOICEBANK push skip reason=speaker_gone")
		end
	}
	level.coop_vbPushDone = 1
	local.said = waitthread coop_vbSay local.m "dfr_M3L1_300f" 1.06 1100 0
	waitthread coop_vbRelease
	if( local.said != 1 ){
		println("^~^~^ VOICEBANK push skip reason=say_vetoed")
		end
	}
	println("^~^~^ VOICEBANK push done 300f")
}end


//Fires the barrage. Each round is its own thread with its own delay and its own scatter, so they land
//RANDOMLY over about 16 seconds instead of all appearing at once.
//=========================================================================
coop_smokeSignal_drop:{
//=========================================================================
	local.sx[1] = 0 - 865
	local.sy[1] = 1685
	local.sz[1] = 0 - 415
	local.sx[2] = 0 - 464
	local.sy[2] = 1741
	local.sz[2] = 0 - 396
	local.sx[3] = 0 - 181
	local.sy[3] = 1897
	local.sz[3] = 0 - 341
	local.sx[4] = 98
	local.sy[4] = 1792
	local.sz[4] = 0 - 361
	local.sx[5] = 273
	local.sy[5] = 2059
	local.sz[5] = 0 - 341
	local.sx[6] = 492
	local.sy[6] = 2018
	local.sz[6] = 0 - 417
	local.sx[7] = 686
	local.sy[7] = 1920
	local.sz[7] = 0 - 379
	local.sx[8] = 783
	local.sy[8] = 1674
	local.sz[8] = 0 - 362
	local.sx[9] = 964
	local.sy[9] = 1686
	local.sz[9] = 0 - 362
	local.sx[10] = 1190
	local.sy[10] = 1654
	local.sz[10] = 0 - 416
	local.sx[11] = 1548
	local.sy[11] = 1536
	local.sz[11] = 0 - 468
	local.sx[12] = 1455
	local.sy[12] = 1240
	local.sz[12] = 0 - 374
	local.sx[13] = 919
	local.sy[13] = 1035
	local.sz[13] = 0 - 376

	local.i = 1
	while( local.i <= 13 ){
		local.jx = ( randomint 240 ) - 120
		local.jy = ( randomint 240 ) - 120
		local.p = (0 0 0)
		local.p[0] = local.sx[local.i] + local.jx
		local.p[1] = local.sy[local.i] + local.jy
		local.p[2] = local.sz[local.i] - 60
		local.delay = randomfloat 16
		thread coop_smokeSignal_round local.p local.delay local.i
		local.i++
	}
	println( "^~^~^ SMOKESIG barrage n=13 life=" + level.coop_smokeSignalLife )

	//[user 2026-08-31] THE SMOKE ACTUALLY PROTECTS YOU. "once the smoke starts dropping can we ensure
	//that the damage dealt is temporarily extremely low... up until we get to the captain at the
	//sandwall". mg42_damage_player already multiplies its distance curve by level.coop_beachDmg
	//(coopified.scr, the BEACH LETHALITY BY DISTANCE block), so this is the intended lever - no second
	//damage path, and it keeps working if that curve is retuned later.
	//The saved value is restored rather than assumed to be 1, so a server that had already tuned
	//coop_beachDmg gets its own number back.
	if( level.coop_smokeDmgScale == NIL ){ level.coop_smokeDmgScale = 0.12 }
	level.coop_beachDmgSaved = level.coop_beachDmg
	level.coop_beachDmg = level.coop_smokeDmgScale
	println( "^~^~^ SMOKESIG cover ON beachDmg=" + level.coop_beachDmg )

	//[user 2026-08-31] The screen now comes down when the CAPTAIN HAS BEEN MET, not on a bare timer -
	//"After you meet with the captain make the smoke SLOWLY start to fade." Meeting the captain is
	//objective 3 in the renumbered chain (it was 2 before the smoke objective took slot 1), and
	//global/objectives.scr sets $world.flags["objectiveCompleteN"] on completion, so that flag is the
	//signal. The life timer stays as a backstop for anyone who never triggers it.
	local.t = 0
	while( local.t < level.coop_smokeSignalLife ){
		if( $world.flags["objectiveComplete3"] == 1 ){ break }
		wait 2
		local.t = local.t + 2
	}

	//Reaching the captain at the sea wall ends the protection - the run-in was the part that needed
	//to be survivable, not the rest of the mission. Objective 3 is "Meet up with the Captain" in the
	//renumbered chain, and global/objectives.scr sets objectiveCompleteN on completion.
	if( level.coop_beachDmgSaved != NIL ){ level.coop_beachDmg = level.coop_beachDmgSaved }
	else{ level.coop_beachDmg = 1 }
	println( "^~^~^ SMOKESIG cover OFF beachDmg=" + level.coop_beachDmg )

	//SLOWLY: pull one column at a time with a random gap rather than deleting all 13 in a frame, so the
	//screen thins and drifts apart instead of blinking out. Roughly 40-70s end to end.
	local.i = 1
	while( local.i <= 13 ){
		if( level.coop_smokeCloud[local.i] != NIL && level.coop_smokeCloud[local.i] != NULL ){
			level.coop_smokeCloud[local.i] remove
		}
		wait ( 2 + ( randomfloat 3 ) )
		local.i++
	}
	println( "^~^~^ SMOKESIG cleared n=13" )
}end

//One smoke round: whistle in, thump, then the screen stands up.
//=========================================================================
coop_smokeSignal_round local.pos local.delay local.slot:{
//=========================================================================
	wait local.delay

	//A dummy at the impact point carries the sound so it is POSITIONAL - the player hears each round
	//land where it lands rather than on themselves.
	local.mark = spawn script_model
	if(local.mark != NULL && local.mark != NIL){
		local.mark model "models/fx/dummy.tik"
		local.mark.origin = local.pos
		local.mark notsolid

		//coop_arty_leadin_far*, NOT retail arty_leadin: the retail aliases carry maxdist 1600, which in
		//this engine is a HARD START GATE rather than a rolloff, so a shell landing across the beach
		//would simply not play. See the note at ubersound/coop_audio.scr:164.
		local.r = randomint 3
		if( local.r == 0 ){ local.mark playsound coop_arty_leadin_far1 }
		else if( local.r == 1 ){ local.mark playsound coop_arty_leadin_far2 }
		else{ local.mark playsound coop_arty_leadin_far3 }

		//[user 2026-09-02, bug-2333] AND YOU CAN SEE IT COMING DOWN.
		//
		//"is there a way to actually make bombs drop from the sky and land where the white smoke appears
		//to make it look more immersive" - yes, and it costs one entity for the 1.1 seconds the whistle
		//is already running, so the round arrives on the sound instead of the sound arriving on nothing.
		//
		//models/AMMO/us_bomb.tik was checked for an init block first: a TIKI's `init { server { } }` runs
		//even on a plain `spawn script_model model`, which is how fx_tank_explosion once killed the
		//player with a radiusdamage nobody had asked for (bug-2244). us_bomb carries none.
		//models/projectiles/artilleryshellnodamage.tik would have been the obvious pick and is WRONG:
		//its init sets `rendereffects +dontdraw`, so it is invisible by design.
		//
		//ORIGIN-STEPPED, NOT `moveto`. moveto and move silently no-op on a script_model - a standing
		//trap in this project - so the descent is written per frame.
		local.bomb = spawn script_model model "models/AMMO/us_bomb.tik"
		if(local.bomb != NULL && local.bomb != NIL){
			local.bomb notsolid
			local.top = local.pos
			local.top[2] = local.top[2] + 2400
			local.bomb.origin = local.top
			local.bomb.angles = ( 90 ( randomint 360 ) 0 )		//nose down, random spin about it

			local.bt = level.time
			while(1){
				local.bf = ( level.time - local.bt ) / 1.1
				if(local.bf > 1){ local.bf = 1 }
				//accelerating, so it reads as falling rather than descending on a wire
				local.bu = local.bf * local.bf
				local.bp = local.pos
				local.bp[2] = local.bp[2] + ( 2400 * ( 1 - local.bu ) )
				if(local.bomb == NULL || local.bomb == NIL){ break }
				local.bomb.origin = local.bp
				if(local.bf >= 1){ break }
				waitframe
			}
			if(local.bomb != NULL && local.bomb != NIL){ local.bomb remove }
		}else{
			wait 1.1
		}

		local.r = randomint 3
		if( local.r == 0 ){ local.mark playsound coop_ex_close_01 }
		else if( local.r == 1 ){ local.mark playsound coop_ex_close_02 }
		else{ local.mark playsound coop_ex_close_03 }
	}

	local.sm = spawn "models/emitters/coop_smokescreen.tik"
	if(local.sm != NULL && local.sm != NIL){			//entity-pool guard
		local.sm.origin = local.pos
		local.sm notsolid
		local.sm anim start
		//[bug-2381] the first round that actually arrives tells the shingle it may move.
		level.coop_smokeLanded = 1
		level.coop_smokeCloud[local.slot] = local.sm
		level.coop_smokeUp++
	}

	wait 3
	if( local.mark != NULL ){ local.mark remove }
}end

//The retail opening, lifted out so every bail-out path above reaches the same place. This is
//m3l1a.scr:2292-2295 verbatim.
//=========================================================================
//[user 2026-09-02, bug-2322] THE OPENING OBJECTIVE IS THE LANDING.
//
//"I think the first objective should read 'Survive the beach landing' once we land in water it
//becomes 'Signal the smoke barrage.'"
//
//SLOT 1, REUSED - NOT A NEW ONE. global/objectives.scr is a literal switch with cases 1-8 and no
//default, and index 0 UNDERRUNS (EventAddObjective subtracts one with no lower bound, so it would
//write the configstring below the objective block). Retail owns 2-8 on this map; coop owns 1. There
//is no free slot, so the landing objective and the smoke objective are the same slot with the text
//swapped - which is exactly what was asked for anyway.
//
//The marker points at the waterline rather than up the beach, because passing a real location
//matters: with a zero vector the engine falls back to "nearest teammate" on this protocol.
//=========================================================================
coop_landingObjective:{
//=========================================================================
	if(level.gametype == 0){ end }
	local.pos = level.flags["coop_spawn1origin"]
	if(local.pos == NIL){
		if($shingle_objective != NULL && $shingle_objective != NIL){ local.pos = $shingle_objective.origin }
	}
	if(local.pos == NIL){ end }
	//[user 2026-09-02, bug-2349] "the survive objective doesnt appear in the objective menu."
	//
	//I registered it in ONE call at status 2. The smoke-barrage objective, which does appear, uses the
	//map's own two-step: register the TEXT at status 1, then transition the same index to status 2.
	//Copying the sequence that demonstrably works rather than reasoning about why mine should have -
	//which is this project's standing rule, and it exists because of exactly this kind of afternoon.
	waitthread global/objectives.scr::add_objectives 1 1 "Survive the beach landing." local.pos
	waitthread global/objectives.scr::add_objectives 1 2
	wait .5
	waitthread global/objectives.scr::current_objectives 1
}end

//=========================================================================
coop_smokeSignal_releaseShingle:{
//=========================================================================
	//[user 2026-09-02, bug-2322] "Get to the shingle objective should be triggered after the whistles
	//blow after the smoke is done dropping." It used to be handed over the moment the radio was used,
	//which is before the barrage has even landed - so the player was told to move up while the screen
	//he was waiting for was still being built. Wait for coop_advanceWhistles to actually blow.
	//
	//BOUNDED, and it releases anyway on timeout. An objective that never appears is a player with
	//nothing to do and no way to know it; a slightly early one is only a cosmetic miss. So the wait
	//can fail but the objective cannot.
	local.t = 0
	while(level.coop_whistlesBlown != 1 && local.t < 45){
		wait 0.5
		local.t = local.t + 0.5
	}

	waitthread global/objectives.scr::add_objectives 2 2		// get to the shingle, setting to active
	wait .5
	waitthread global/objectives.scr::current_objectives 2	// setting get to shingle as current
}end

//=========================================================================
//[user 2026-08-31] AUTOMATIC ALLIED ADVANCE ON THE SMOKE.
//
//"you reach a certain point and they take off pushing up the beach after some radio man dies, im just
//asking that to be executed automatically once the smoke hits."
//
//That beat is retail sequence tier 7 (m3l1a.scr::player_sequence_7_center): the tier that kills
//$center_radioman with ai_mg_death and hands "move_mg_death"/"move_crouch" to all 13 named higgins
//rangers. Their _path_7 chains end well UP the beach (ranger10: (408 344) -> (712 520) -> (768 872)
//-> (768 1152)), which lands them in the smoke band. Tier 8, the final sprint to the shingle, is
//deliberately left player-driven exactly as retail.
//
//THIS IS NOT A TIER JUMP. The radio sits at (297 312 -479). The tier-6 gate is a continuous
//full-width wall at y 0..128 (brushes x -3584..192 and x 208..3648, a 16-unit seam a 32-unit-wide
//player cannot thread); the tier-7 gate is at y 832..960. Nobody can be holding the radio without
//having already crossed tier 6, so this is an in-order 6 -> 7 advance fired 584 units of beach early.
//It is also a net safety WIN: sequence_7_spawn_shingle is the ONLY place $shingle_ranger1 (the
//captain) is spawned, and sequence 9 does a bare field read on him for "Meet up with the Captain" -
//so a party that walks around the tier-7 brushes soft-locks that chain TODAY.
//
//`trigger $ent` AT STATEMENT LEVEL, never a direct thread call and never `local.x trigger $ent`.
//Statement-level trigger sends EV_Activate with WORLD as the activator and skips NULL entities, and
//Trigger::TriggerStuff exempts world+EV_Activate from its respondTo gate - so a tier that already ran
//is a silent no-op rather than a re-run. The entity form passes self as activator and is then dropped
//silently, with nothing in qconsole.log. Retail precedent: m3l1a.scr:3555.
//=========================================================================
coop_advanceOnSmoke:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( level.coop_beachAdvanceOn == NIL ){ level.coop_beachAdvanceOn = 1 }
	if( !level.coop_beachAdvanceOn ){ end }

	//One shot, claimed BEFORE the first wait so four players cannot produce two runs.
	if( level.coop_beachAdvanceDone == 1 ){ end }
	level.coop_beachAdvanceDone = 1

	//WAIT FOR THE SMOKE TO ACTUALLY STAND UP. Each of the 13 rounds carries its own randomfloat 16
	//delay plus 1.1s of lead-in, so when coop_smokeSignal_drop returns there is no smoke out there at
	//all. Count real clouds rather than guessing a delay - and do NOT wait for all 13: the counter is
	//incremented INSIDE the entity-pool guard, so a slot can legitimately stay empty forever and a
	//"wait for 13" loop would hang, silently never firing the advance.
	//
	//The same loop waits out the radioman. sequence_5_center_radioman holds isinsequence = 1 until a
	//player closes to 160 units, then says his line and clears it. He stands 345 units from the radio,
	//so at the moment the smoke is called he has NOT spoken - and tier 7 would shoot him mid-idle,
	//deleting the very cue the user described. We WAIT for his line; we never say it ourselves, which
	//would race his own parked thread and play it twice.
	//[user 2026-09-04] "the whistles and script to push up the beach do not wait until all smokebombs
	//are dropped anymore" - and that is a regression I caused. This gate had TWO conditions: six
	//clouds standing, AND the radioman having finished his line. The radioman beat now KILLS him, so
	//`isalive` is false by the time this runs and that half is skipped outright - leaving only the
	//smoke count, which with 13 rounds at randomfloat 16 reaches six in about nine seconds. So the
	//advance started firing roughly when it used to only be halfway through waiting.
	//6 -> 11 of 13, and the cap 26 -> 45 to fit it. NOT 13: the counter is incremented INSIDE the
	//entity-pool guard, so a slot can legitimately stay empty forever and a wait-for-all loop would
	//hang and silently never fire the advance - that is why the original said six. Eleven keeps the
	//safety and still means the barrage is visibly out before the whistles go.
	local.t = 0
	local.ready = 0
	while( local.t < 45 && local.ready == 0 ){
		local.ok = 1
		if( level.coop_smokeUp == NIL ){ local.ok = 0 }
		else if( level.coop_smokeUp < 11 ){ local.ok = 0 }
		//[user 2026-09-05] AND THE RADIO EXCHANGE HAS TO FINISH.  coop_radiomanTransmit runs ~13.0s from
		//the moment the set is used, and this thread shouts 044a twice ("Get up the beach now! Move,
		//move, c'mon, go!") plus three whistles plus an iprintlnbold - so without this gate the charge
		//call can start on top of division's answer.  NIL means the transmit never started at all (the
		//feature switched off, or the set-on-the-sand fallback route), which must NOT block: the whole
		//loop is capped at 45s anyway, so this can only ever delay the advance, never strand it.
		if( level.coop_radiomanTxDone != NIL && level.coop_radiomanTxDone != 1 ){ local.ok = 0 }
		if( $center_radioman != NULL ){
			if( isalive $center_radioman ){
				if( $center_radioman.isinsequence == 1 ){ local.ok = 0 }
			}
		}
		if( local.ok == 1 ){ local.ready = 1 }
		else{
			wait 0.5
			local.t = local.t + 0.5
		}
	}

	//SEQUENCE GATE. Tier 6 sets level.m3l1a_sequence = 6 only after clearing its own
	//`while (level.m3l1a_sequence_isupdating == 1)` spin, and tier 5 can hold that lock for ~3.2s, so
	//a fast runner can be at the radio while the variable still reads 5. Wait it out rather than
	//testing one instant and silently giving up.
	local.t = 0
	while( level.m3l1a_sequence != NIL && level.m3l1a_sequence < 6 && local.t < 20 ){
		wait 0.5
		local.t = local.t + 0.5
	}

	if( level.m3l1a_sequence == NIL || level.m3l1a_sequence == NULL ){
		println( "^~^~^ BEACHADV abort reason=sequence_unset" )
		end
	}

	//NEVER FIRE BACKWARDS. level.m3l1a_sequence IS the path index - ai_execute_todo composes
	//$(self.targetname + "_path_" + self.nextsequence[1]) - so re-stamping 7 over an 8 would turn
	//nine rangers around and walk them ~700 units back DOWN the beach.
	if( level.m3l1a_sequence >= 7 ){
		println( "^~^~^ BEACHADV skip reason=already_advanced seq=" + level.m3l1a_sequence )
		end
	}

	//TIER 6 NEVER FIRED. Do NOT force it: sequence_6_spawn_shingle is the only spawner of
	//shingle_wave1-18 and tier 7 hands todos to five of them. Geometrically unreachable, but guarded
	//rather than trusted.
	if( level.m3l1a_sequence < 6 ){
		println( "^~^~^ BEACHADV abort reason=tier6_not_fired seq=" + level.m3l1a_sequence )
		end
	}

	//THE CHARGE CALL - the map's own line, already spoken by this same ranger at m3l1a.scr:3619
	//("get up the beach now....move move...cmon...go"). Skip him if he is mid-todo or mid-set-piece
	//or his own waittill saydone gets stomped; ai_execute_todo owns .isbusy / .isinsequence.
	//[user 2026-09-04, bug-2451] BOTH SPEAKERS ARE CHOSEN HERE, NOW, AND RANKED BY DISTANCE.
	//
	//1. THE SECOND VOICE COULD NEVER FIRE. coop_advanceWhistles used to pick its own speaker three
	//   whistle waits plus 0.9 later - T+2.25 to T+3.30 - and re-tested .isbusy there. But this
	//   thread triggers $player_sequence_7_center at T+0.75, and m3l1a.scr:7170-7184 hands an
	//   ai_add_todo to higgins1_ranger6-10, higgins3_ranger1-5 and higgins5_ranger1/3/5 - which is
	//   every candidate it had. ai_execute_todo latches self.isbusy = 1 one frame after that
	//   trigger (m3l1a.scr:8271-8280), so by the time the second say was evaluated EVERY candidate
	//   failed the guard, on every run. The guards are right - they stop us stomping a man's own
	//   waittill saydone - they were just consulted at the wrong instant. Choose at T+0, while they
	//   still mean something, and hand the choice to the whistle thread.
	//
	//2. NEITHER SPEAKER WAS CHOSEN BY DISTANCE. streamed_dfr_scripted_M3L1_044a is 200/1500
	//   (uberdialog.scr:553) and S_OPENAL_Respatialize rolls a 2D streamed channel linearly to
	//   zero at maxDist, so a man 1000 units away plays at 38% while the whistle beside him
	//   (coop_beach_whistle, 600/9000) plays at 95% - which is exactly "I heard the whistles, I did
	//   not hear the shout". Rank the valid candidates by distance to the nearest player and take
	//   the two closest. With 2-4 players spread up the beach this also stops the order being
	//   shouted by a man nobody is standing near.
	//
	//Do NOT re-alias 044a wider: `say` resolves the lipsync anim BY ALIAS NAME and the .skc ships
	//only under the original name.
	local.cn = 0
	if( $higgins1_ranger10 != NULL && $higgins1_ranger10 != NIL ){ local.cn++; local.cand[local.cn] = $higgins1_ranger10 }
	if( $higgins5_ranger1 != NULL && $higgins5_ranger1 != NIL ){ local.cn++; local.cand[local.cn] = $higgins5_ranger1 }
	if( $higgins3_ranger3 != NULL && $higgins3_ranger3 != NIL ){ local.cn++; local.cand[local.cn] = $higgins3_ranger3 }
	if( $higgins3_ranger4 != NULL && $higgins3_ranger4 != NIL ){ local.cn++; local.cand[local.cn] = $higgins3_ranger4 }
	if( $higgins5_ranger5 != NULL && $higgins5_ranger5 != NIL ){ local.cn++; local.cand[local.cn] = $higgins5_ranger5 }
	if( $higgins5_ranger3 != NULL && $higgins5_ranger3 != NIL ){ local.cn++; local.cand[local.cn] = $higgins5_ranger3 }

	local.pool = 0
	local.j = 1
	while( local.j <= local.cn ){
		local.k = local.cand[local.j]
		if( local.k != NULL && local.k != NIL ){
			if( isalive local.k && local.k.isinsequence != 1 && local.k.isbusy != 1 ){
				local.d = 99999
				local.p = waitthread coop_mod/replace.scr::player_closestTo local.k
				if( local.p != NULL && local.p != NIL ){
					local.d = vector_length ( local.p.origin - local.k.origin )
				}
				local.pool++
				//[2026-09-05] local.okc, NOT local.ok: this label's wait loop above uses local.ok as an INT
				//flag, and `[]` applied to an int throws - so every store here was skipped, both reads
				//below came back none, and the 044a `say` went to NIL on every run since bug-2451
				//(qconsole.log 16:30:43: '[] applied to invalid type' at :1901/:1935, 'say applied to
				//NIL' at :1951). The whistles and the iprintlnbold still fired, so it read as working.
				local.okc[local.pool] = local.k
				local.dst[local.pool] = local.d
			}
		}
		local.j++
	}

	local.b1 = 0
	local.b2 = 0
	local.j = 1
	while( local.j <= local.pool ){
		if( local.b1 == 0 ){
			local.b1 = local.j
		}else{
			if( local.dst[local.j] < local.dst[local.b1] ){ local.b1 = local.j }
		}
		local.j++
	}
	local.j = 1
	while( local.j <= local.pool ){
		if( local.j != local.b1 ){
			if( local.b2 == 0 ){
				local.b2 = local.j
			}else{
				if( local.dst[local.j] < local.dst[local.b2] ){ local.b2 = local.j }
			}
		}
		local.j++
	}

	local.caller = NULL
	local.second = NULL
	local.d1 = 0 - 1
	local.d2 = 0 - 1
	if( local.b1 > 0 ){ local.caller = local.okc[local.b1]; local.d1 = int( local.dst[local.b1] ) }
	if( local.b2 > 0 ){ local.second = local.okc[local.b2]; local.d2 = int( local.dst[local.b2] ) }
	println( "^~^~^ WHISTLES pick cn=" + local.cn + " pool=" + local.pool + " d1=" + local.d1 + " d2=" + local.d2 )
	//[user 2026-09-01] WHISTLES FIRST. "Once the smoke all drops and the actors are triggered to push
	//up the beach, I think we need several loud whistles signaling and someone verbally saying to move
	//up... The whistle exists when the ramp drops on the higgins boat."
	//
	//It does: higgins_whistle, played at m3l1a.scr:2584 off $higgins1_door. Its alias is 200/2000 and
	//`loaded`, and in this engine maxDist is a hard START gate, not a rolloff - so one whistle blown at
	//the seawall is inaudible to anyone still at the waterline. coop_beach_whistle is the same wav
	//re-aliased at 600/9000 in ubersound.scr for exactly this: a signal meant to carry the length of
	//the beach. Three of them, staggered, off three separate points so it reads as several NCOs rather
	//than one man with a very loud whistle.
	thread coop_advanceWhistles local.second

	if( local.caller != NULL ){
		local.caller say streamed_dfr_scripted_M3L1_044a
		println( "^~^~^ WHISTLES say1 ent=" + local.caller.entnum + " dist=" + local.d1 )
	}else{
		//NEVER infer this one from silence again - if no ranger was free, it says so.
		println( "^~^~^ WHISTLES say1 skip reason=no_free_speaker cn=" + local.cn )
	}

	//The alias carries maxDist 1500, and in this engine that is a HARD START GATE rather than a
	//rolloff (see ubersound/coop_audio.scr), so a player already past y 1500 hears nothing. Pair the
	//diegetic line with one print. Do NOT re-declare 044a under a wider coop alias: `say` resolves
	//the lipsync anim BY ALIAS NAME, and the .skc ships only under the original name.
	iprintlnbold "Get up the beach! Move! Move!"

	wait 0.75

	//Re-test: a player can trip the real gate at y 896 during the shout.
	if( level.m3l1a_sequence >= 7 ){
		println( "^~^~^ BEACHADV skip reason=raced_by_player" )
		end
	}

	if( $player_sequence_7_center != NIL && $player_sequence_7_center != NULL ){
		trigger $player_sequence_7_center
		println( "^~^~^ BEACHADV fired tier=7 branch=center smokeUp=" + level.coop_smokeUp )
		thread coop_smokeUrgency		//[user 2026-09-06, bug-2511] the shouting, see the label
	}else{
		println( "^~^~^ BEACHADV skip reason=trigger_gone" )
		end
	}

	//ANTI-REGRESSION SWEEP. Every tier deletes only its OWN three siblings, so a tier that was
	//physically walked around stays live BEHIND the party. Tier 5's brush seams are 40 and 48 units,
	//wider than the 32-unit player, so tiers 2-5 are genuinely skippable by running the seam. If one
	//fires after this it re-stamps level.m3l1a_sequence backwards, the rangers walk back down the
	//beach, and sequence_7_shingle_chatter's `while (level.m3l1a_sequence == 7)` loop ends for good.
	//nottriggerable rather than delete: TriggerStuff early-outs on it, and nothing else in the map
	//addresses these entities. TIER 6 IS DELIBERATELY NOT SWEPT - it has fired by definition of the
	//gate above, and it is the only spawner of shingle_wave1-18.
	local.n = 2
	while( local.n <= 5 ){
		local.e = $( "player_sequence_" + local.n + "_center" )
		if( local.e != NULL ){ local.e nottriggerable }
		local.e = $( "player_sequence_" + local.n + "_right" )
		if( local.e != NULL ){ local.e nottriggerable }
		local.e = $( "player_sequence_" + local.n + "_left" )
		if( local.e != NULL ){ local.e nottriggerable }
		local.n++
	}
	println( "^~^~^ BEACHADV swept tiers=2-5" )
}end

//=========================================================================
//[user 2026-08-31] FLANK MG42s - "they should come out of the bluff once the bangalores are destroyed".
//
//$mg42_left1/2 and $mg42_right1/2 are fully configured turretweapon_german_mg42-fake entities sitting
//on the bluff, and NOTHING has ever told them to fire - not in coop and not in retail. Their entire
//setup block is commented out at m3l1a.scr:788-808 under the author's own note, "are these even used?"
//Only the four bunker guns ever shoot.
//
//They ship `rendereffects "+dontdraw"`, i.e. sent to the client but not drawn - which is exactly why
//"come out of the bluff" works as written: clearing the flag reveals guns that were already there,
//already aimed. $mg42_right2 is even authored at angle 225, pre-yawed to enfilade in from the right.
//
//BALANCE. Deliberately NOT the bunkers' `bulletspread 5 7`. Four more guns at the bunkers' accuracy,
//opening at the moment the party is committed and moving, is a wall rather than an escalation. These
//run a much wider cone and a longer pause between bursts: they are pressure and noise from the flanks,
//not a second kill zone. level.coop_flankMGSpread / level.coop_flankMGGap tune it without a rebuild.
//
//They aim at the map's own $mg42_target_left / _right beaten-zone origins, the same points the bunker
//guns use - never at a player directly, which is what makes them suppressive rather than lethal.
//=========================================================================
//=========================================================================
//[user 2026-09-06, bug-2511] URGENCY AFTER THE SMOKE. "When we push up after the smoke drops I'd like to
//hear more urgency around me, more people saying Move, go go go, push up ... sporadic, not all at the same
//time, only once or twice." Seven shipped m3l1 shouts (uberdialog.scr, dialog streamed = the 2D path, no
//start gate) plus the generic attack pool, from men within earshot: the calm retail rangers through the
//voicebank (coop_vbSay - lipsync, one line at a time, its lease makes them sporadic by construction) and
//the charging crowd through playsound (they are isbusy/isinsequence runners, a say would be dropped).
//Seven shouts, 0.6-2.6 s apart, no man more than twice, starting a second after the advance fires.
//Kill switch level.coop_urgencyOn. Probes: URGENCY say alias= by=, URGENCY done n=.
coop_smokeUrgency:{
	if(level.gametype == 0){ end }
	if(level.coop_urgencyOn == NIL){ level.coop_urgencyOn = 1 }
	if(!level.coop_urgencyOn){ end }
	if(level.coop_urgencyDone == 1){ end }
	level.coop_urgencyDone = 1
	local.n = 0
	local.n++; local.al[local.n] = "dfr_scripted_M3L1_102a_2"; local.sc[local.n] = 1.6
	local.n++; local.al[local.n] = "dfr_scripted_M3L1_105a_1"; local.sc[local.n] = 0.8
	local.n++; local.al[local.n] = "dfr_scripted_M3L1_061d"; local.sc[local.n] = 1.8
	local.n++; local.al[local.n] = "streamed_dfr_scripted_M3L1_021g"; local.sc[local.n] = 2.4
	local.n++; local.al[local.n] = "dfr_scripted_M3L1_017f"; local.sc[local.n] = 1.9
	local.n++; local.al[local.n] = "dfr_M3L1_300f"; local.sc[local.n] = 1.1
	local.n++; local.al[local.n] = "dfr_scripted_M3L1_014a"; local.sc[local.n] = 1.5
	local.k = 1
	while(local.k <= 3){
		local.n++; local.al[local.n] = ( "coop_av_us_attack" + ( ( randomint 7 ) + 1 ) ); local.sc[local.n] = 1.2
		local.k++
	}
	wait 1.0
	local.said = 0
	local.tries = 0
	while(local.said < 7 && local.tries < 16){
		local.tries++
		local.i = ( randomint local.n ) + 1
		local.a = local.al[local.i]
		local.s = local.sc[local.i]
		local.who = NULL
		local.crowd = 0
		//half the time a charging crowd man, if any are alive; else a calm ranger from the retail boats
		if(( randomint 2 ) == 0 && level.coop_hedgeMenN != NIL && level.coop_hedgeMenN > 0){
			local.j = ( randomint level.coop_hedgeMenN ) + 1
			local.m = level.coop_hedgeMen[local.j]
			if(local.m != NULL && local.m != NIL){
				if(isalive local.m){ local.who = local.m; local.crowd = 1 }
			}
		}
		if(local.who == NULL){
			local.r = randomint 3
			if(local.r == 0){ local.who = waitthread coop_vbFind "higgins1_ranger" 6 10 }
			else if(local.r == 1){ local.who = waitthread coop_vbFind "higgins3_ranger" 1 5 }
			else{ local.who = waitthread coop_vbFind "higgins5_ranger" 1 5 }
		}
		if(local.who != NULL && local.who != NIL){
			if(local.who.coop_urgeN == NIL){ local.who.coop_urgeN = 0 }
			if(local.who.coop_urgeN < 2){
				local.ok = 0
				if(local.crowd == 1){
					local.who playsound local.a
					local.ok = 1
				}else{
					local.ok = waitthread coop_vbSay local.who local.a local.s 1100 0
				}
				if(local.ok == 1){
					local.who.coop_urgeN++
					local.said++
					println("^~^~^ URGENCY say alias=" + local.a + " by=" + local.who.entnum + " crowd=" + local.crowd + " n=" + local.said)
					wait ( local.s + 0.6 + ( randomfloat 2.0 ) )
				}
			}
		}else{
			wait 0.4
		}
	}
	println("^~^~^ URGENCY done n=" + local.said + " tries=" + local.tries)
}end


//=========================================================================
//[user 2026-09-06, bug-2508] THE DENSE SEA. Item 8 of docs/proposals/ocean_2026-09-06/README.md.
//
//models/fx/coop_sea.tik is a 32x48-quad TIKI plane over the open-sea patch footprint (1650 verts,
//two travelling waves in scripts/zz_coop_sea.shader that the 8x8 retail patch cannot sample). Every
//byte of it is generated by docs/tools/gen_coop_sea.py, and the two labels below are pasted VERBATIM
//from its recipe docs/proposals/ocean_2026-09-06/seamesh_spawn.scr - edit the generator, not these.
//The mesh REPLACES $ocean_wavy while it is up: the two are coplanar on the seam row (z-fight), and a
//wave crossing a flat sheet shows the sheet in every trough.
//
//HOOKS: coop_seaMeshStart is threaded from m3l1a.scr::higgins1_landing right after its `$ocean_wavy
//show` (the hull has grounded; $ocean_calm is hidden 0.5 s later by the line under it), and
//coop_seaMeshStop runs in coop_rampUnderwater BEFORE the RAMPUW lid sets `$ocean_wavy alpha 0.6`,
//which needs the retail sheet back. m3l1a.scr's `upper_beach` `$ocean_wavy show` is guarded on
//level.coop_seaMesh so the sheet cannot come back under the mesh.
//
//KILL SWITCH: level.coop_seaMeshOn 0 (default 1). PROBE: '^~^~^ SEAMESH on' / '^~^~^ SEAMESH off'.
//ORIGIN and YAW are the mesh's own (pre-rotated for yaw 225, centred on the patch footprint): change
//neither without regenerating the mesh.
//=========================================================================
coop_seaMeshStart:
//=========================================================================
	if(level.coop_seaMeshOn == NIL){ level.coop_seaMeshOn = 1 }
	if(!level.coop_seaMeshOn){ println("^~^~^ SEAMESH off (coop_seaMeshOn 0)"); end }
	//[bug-2520] BOTH sheets go down, and they go down BEFORE the already-up early-out, so a second
	//call (the ride starts it, the landing starts it again) still hides whatever the beat just showed.
	//All three surfaces are coplanar at z -520: exactly one may be visible or they z-fight.
	if($ocean_wavy != NULL && $ocean_wavy != NIL){ $ocean_wavy hide }
	if($ocean_calm != NULL && $ocean_calm != NIL){ $ocean_calm hide; level.coop_seaCalmHid = 1 }
	if(level.coop_seaMesh != NIL && level.coop_seaMesh != NULL){ end }		//already up
	local.m = spawn script_model model "models/fx/coop_sea.tik"
	if(local.m == NULL || local.m == NIL){ println("^~^~^ SEAMESH FAIL spawn returned NULL"); end }		//entity-pool guard
	//[bug-2520] the mesh now spans y -2160..-13312, so its centre moved seaward. This MUST match
	//ORIGIN in docs/tools/gen_coop_sea.py, which the generator prints on every run.
	local.m.origin = ( 64 -7736 -520 )
	//[bug-2519] 225 -> 180, and it MUST match YAW in docs/tools/gen_coop_sea.py, which is what the
	//mesh was pre-rotated for. At 225 the swell travelled exactly shore-normal, so its crests were
	//infinitely long lines parallel to the beach; at 180 it runs shoreward and along-shore in the
	//same sense as the foam drift on the sand strip.
	local.m.angles = ( 0 180 0 )
	local.m notsolid		//T9: after the tik landed, never before
	local.m.targetname = "coop_seamesh"
	level.coop_seaMesh = local.m
	println("^~^~^ SEAMESH on origin=64,-7736,-520 yaw=180")
end

//=========================================================================
//[user 2026-09-07, bug-2521] THE SURF ZONE'S MOVING CREST. "if we could have those happening near the
//shoreline too after we are getting out of the cinematic piece". The shore water there is WORLD
//geometry with THREE rows of vertices across the whole 1408 u band, so it can never be deformed and it
//cannot be hidden from a shader either - so this floats a generated layer 6 u above its plane carrying
//the same break-line texture, on geometry that actually rises and runs up the beach. Additive, no
//depthwrite: it must never occlude the eight tuned stages underneath.
//STARTS at coop_rampHandoff, the single exit from the cinematic on every path.
//KILL SWITCH: level.coop_surfMeshOn 0. PROBE: '^~^~^ SURFMESH on/off'.
coop_surfMeshStart:
//=========================================================================
	if(level.coop_surfMeshOn == NIL){ level.coop_surfMeshOn = 1 }
	if(!level.coop_surfMeshOn){ println("^~^~^ SURFMESH off (coop_surfMeshOn 0)"); end }
	if(level.coop_surfMesh != NIL && level.coop_surfMesh != NULL){ end }		//already up
	local.m = spawn script_model model "models/fx/coop_surf.tik"
	if(local.m == NULL || local.m == NIL){ println("^~^~^ SURFMESH FAIL spawn returned NULL"); end }
	//MUST match ORIGIN and YAW in docs/tools/gen_coop_surf.py - the mesh is pre-rotated for that yaw
	//and the bore's travel direction depends on it. The generator prints both on every run.
	local.m.origin = ( 64 -1490 -520 )
	local.m.angles = ( 0 215 0 )
	local.m notsolid		//T9: after the tik landed, never before
	local.m.targetname = "coop_surfmesh"
	level.coop_surfMesh = local.m
	println("^~^~^ SURFMESH on origin=64,-1490,-520 yaw=215")
end

//=========================================================================
coop_surfMeshStop:
//=========================================================================
	if(level.coop_surfMesh == NIL || level.coop_surfMesh == NULL){ end }
	level.coop_surfMesh remove
	level.coop_surfMesh = NULL
	println("^~^~^ SURFMESH off")
end

//=========================================================================
coop_seaMeshStop:
//=========================================================================
	if(level.coop_seaMesh == NIL || level.coop_seaMesh == NULL){ end }
	level.coop_seaMesh remove
	level.coop_seaMesh = NULL
	//[bug-2520] put back whichever sheet the beat expects. $ocean_calm is the ride's sheet and the
	//landing retires it for good (m3l1a.scr:2564), so it only comes back if that has not happened.
	if($ocean_wavy != NULL && $ocean_wavy != NIL){ $ocean_wavy show }		//the retail sheet (and the bug-2507 lid) come back
	if(level.coop_seaCalmHid == 1 && level.coop_seaCalmDone != 1){
		if($ocean_calm != NULL && $ocean_calm != NIL){ $ocean_calm show }
	}
	println("^~^~^ SEAMESH off")
end


coop_flankMG:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( level.coop_flankMGOn == NIL ){ level.coop_flankMGOn = 1 }
	if( !level.coop_flankMGOn ){ end }
	if( level.coop_flankMGDone == 1 ){ end }		//one shot - three bangalores, one reveal
	level.coop_flankMGDone = 1

	if( level.coop_flankMGSpreadA == NIL ){ level.coop_flankMGSpreadA = 14 }
	if( level.coop_flankMGSpreadB == NIL ){ level.coop_flankMGSpreadB = 18 }
	if( level.coop_flankMGGap == NIL ){ level.coop_flankMGGap = 3 }

	//Left and right are tracked separately so each gun fires into its own side's beaten zone.
	local.ln = 0
	if( $mg42_left1 != NULL ){ local.ln++; local.lg[local.ln] = $mg42_left1 }
	if( $mg42_left2 != NULL ){ local.ln++; local.lg[local.ln] = $mg42_left2 }
	local.rn = 0
	if( $mg42_right1 != NULL ){ local.rn++; local.rg[local.rn] = $mg42_right1 }
	if( $mg42_right2 != NULL ){ local.rn++; local.rg[local.rn] = $mg42_right2 }

	if( local.ln < 1 && local.rn < 1 ){
		println( "^~^~^ FLANKMG no flank guns on this map" )
		end
	}

	//Configure and reveal. This is the commented-out retail block, widened, minus the +dontdraw.
	local.i = 1
	while( local.i <= local.ln ){
		//[user 2026-09-02, bug-2384] "a lot of the mg42's sound like their rate of fire is way
		//slower". They were: retail's own beach guns run firedelay .2 (m3l1a.scr:860, 870) and
		//these were at .5 - less than half the rate - with a .3/.3 pause between bursts on top.
		//An MG42 is the fastest thing on that beach and it has to sound like it. .2 with a short
		//.12 pause matches the retail pair rather than the bunker guns, which were deliberately
		//slowed by a previous author to "stabilise the map".
		local.lg[local.i] burstfiresettings .01 .01 .12 .12
		local.lg[local.i] firedelay .2
		local.lg[local.i] tracerfrequency 1
		local.lg[local.i] maxyawoffset 45
		local.lg[local.i] pitchcaps (0 45 0)
		local.lg[local.i] setplayerusable 0
		local.lg[local.i] bulletspread level.coop_flankMGSpreadA level.coop_flankMGSpreadB
		local.lg[local.i] rendereffects "-dontdraw"
		//[bug-FLANKMG] AND THE SAME VALUES AS FIELDS. Once a crew mounts, global/mg42_active.scr
		//owns this gun, and its opening block re-applies every one of these FROM THE SCRIPT FIELD,
		//substituting its own default when the field is NIL (mg42_active.scr:36-64). Setting them
		//only as commands above meant the cone snapped back to (-15 15 0), the gun became
		//player-usable again and tracers dropped to 1-in-3 the instant the driver started.
		//bunker.scr:412-415 already documents this for pitchcaps alone; it is the whole block.
		local.lg[local.i].pitchcaps = ( 0 45 0 )
		local.lg[local.i].maxyawoffset = 45
		local.lg[local.i].setplayerusable = 0
		local.lg[local.i].tracerfrequency = 1
		local.lg[local.i].turnspeed = 60
		local.i++
	}
	local.i = 1
	while( local.i <= local.rn ){
		local.rg[local.i] burstfiresettings .01 .01 .12 .12
		local.rg[local.i] firedelay .2
		local.rg[local.i] tracerfrequency 1
		local.rg[local.i] maxyawoffset 45
		local.rg[local.i] pitchcaps (0 45 0)
		local.rg[local.i] setplayerusable 0
		local.rg[local.i] bulletspread level.coop_flankMGSpreadA level.coop_flankMGSpreadB
		local.rg[local.i] rendereffects "-dontdraw"
		//see the note on the left battery - mg42_active re-applies these from the FIELDS
		local.rg[local.i].pitchcaps = ( 0 45 0 )
		local.rg[local.i].maxyawoffset = 45
		local.rg[local.i].setplayerusable = 0
		local.rg[local.i].tracerfrequency = 1
		local.rg[local.i].turnspeed = 60
		local.i++
	}

	//[user 2026-09-02, bug-2385] "I never seem to see anyone on the additional mg42 guns we spawned
	//... it looks like they are shooting without an enemy attached."
	//
	//He is right, and it is inherited rather than mine: m3l1a.scr:431-451 runs disable_ai + notsolid
	//+ HIDE on every one of the map's own _gunner actors, with the note "dont use these anymore". So
	//the bunker guns have always fired with nobody visible behind them. The flank guns
	//(mg42_left1/2, right1/2) are worse - they have no _gunner entity in the BSP at all.
	//
	//The hidden ones are already standing in exactly the right place, so showing them costs nothing
	//and puts a man back on each gun. They keep disable_ai and notsolid, so they are scenery: no AI
	//to misbehave, which is presumably why they were hidden in the first place.
	waitthread coop_showGunners

	//[user 2026-09-03] AND A REAL CREW ON THE FOUR FLANK GUNS - the vanilla way, which the user
	//identified: "you can shoot the enemies that are attached and another will respawn and take
	//over". Threaded, not waitthread, so a slow spawn never delays the reveal.
	thread coop_flankCrew

	//[bug-FLANKMG] and the measurement, so the next playtest answers "are they firing"
	//from the log instead of from an offline join. level.coop_flankProbeOn 0 silences it.
	thread coop_flankProbe

	iprintlnbold "Machine guns on the flanks! Keep moving!"
	println( "^~^~^ FLANKMG revealed left=" + local.ln + " right=" + local.rn )

	//Alternating bursts, left battery then right, so the fire sweeps rather than saturating.
	while( level.coop_flankMGOn ){
		local.i = 1
		while( local.i <= local.ln ){
			//SKIP A CREWED GUN. global/mg42_active.scr owns aiming, firing AND the reload cycle
			//for any gun with a live gunner; driving it from here as well would fight it. When the
			//gunner dies the flag clears and this loop takes the gun back, so a gun can never be
			//left silent - which is the failure mode that matters, because TurretGun::m_bHadOwner
			//is a one-way latch (weapturret.cpp:1693 + never cleared) and an unowned, undriven gun
			//falls into ThinkIdle and just droops.
			if( local.lg[local.i] != NULL && $mg42_target_left != NULL && level.coop_flankCrewed[local.lg[local.i].entnum] != 1 ){
				local.lg[local.i] setaimtarget $mg42_target_left[((randomint 4) + 1)]
				local.lg[local.i] startfiring
			}
			local.i++
		}
		wait ( (randomint 3) + 2 )
		local.i = 1
		while( local.i <= local.ln ){
			//[bug-FLANKMG] SKIP A CREWED GUN HERE TOO. This half was ungated while the
			//startfiring half above was gated, so the fallback loop spent every cycle
			//STOPPING the four guns it had just declined to start - clearing
			//TurretGun::m_iFiring (weapturret.cpp:2006) behind mg42_active. A driver that
			//stands down has to stand down on BOTH verbs.
			if( local.lg[local.i] != NULL && level.coop_flankCrewed[local.lg[local.i].entnum] != 1 ){ local.lg[local.i] stopfiring }
			local.i++
		}

		wait ( randomfloat level.coop_flankMGGap )

		local.i = 1
		while( local.i <= local.rn ){
			//SKIP A CREWED GUN. global/mg42_active.scr owns aiming, firing AND the reload cycle
			//for any gun with a live gunner; driving it from here as well would fight it. When the
			//gunner dies the flag clears and this loop takes the gun back, so a gun can never be
			//left silent - which is the failure mode that matters, because TurretGun::m_bHadOwner
			//is a one-way latch (weapturret.cpp:1693 + never cleared) and an unowned, undriven gun
			//falls into ThinkIdle and just droops.
			if( local.rg[local.i] != NULL && $mg42_target_right != NULL && level.coop_flankCrewed[local.rg[local.i].entnum] != 1 ){
				local.rg[local.i] setaimtarget $mg42_target_right[((randomint 4) + 1)]
				local.rg[local.i] startfiring
			}
			local.i++
		}
		wait ( (randomint 3) + 2 )
		local.i = 1
		while( local.i <= local.rn ){
			//see the note on the left battery - stand down on stopfiring as well as startfiring
			if( local.rg[local.i] != NULL && level.coop_flankCrewed[local.rg[local.i].entnum] != 1 ){ local.rg[local.i] stopfiring }
			local.i++
		}

		wait ( randomfloat level.coop_flankMGGap )
	}
}end




//=========================================================================
//[user 2026-08-31] BLOOD ON THE BEACH - a pool under every one of the map's baked-in dead.
//
//The user asked for a bloodier beach. m3l1a ships 43 body_us* static models lying on the sand and not
//one of them has any blood under it, which is most of why the beach reads clean.
//
//The coordinates below are NOT hand-placed: they were read straight out of maps/m3l1a.bsp,
//LUMP_STATICMODELDEF (lump 25, 164-byte dstaticModel_t records), filtered to body_us*. That is why
//they land exactly under the corpses rather than approximately near them.
//
//These are static, permanent and cheap: one plane each, no update loop, no per-frame cost. The
//shader carries polygonOffset, which is what keeps them off the opaque sand without z-fighting.
//
//Blood in the SURF is deliberately NOT done here - it is a stage inside
//scripts/zz_coop_shoreline.shader instead. That surface carries a deformVertexes flap which moves it
//vertically every ~12.5s, and no separate entity can follow a per-vertex deform, so a floating plane
//would sink under the wash and surface through it. A stage inherits the deform for free.
//=========================================================================
coop_beachBlood:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachBloodOn == NIL){ level.coop_beachBloodOn = 1 }
	if(!level.coop_beachBloodOn){ end }

	local.n = 0
	local.n++; local.bx[local.n] = 2600; local.by[local.n] = 5048; local.bz[local.n] = 0 - 538
	local.n++; local.bx[local.n] = 2013; local.by[local.n] = 4612; local.bz[local.n] = 0 - 504
	local.n++; local.bx[local.n] = 2152; local.by[local.n] = 4800; local.bz[local.n] = 0 - 504
	local.n++; local.bx[local.n] = 1901; local.by[local.n] = 4581; local.bz[local.n] = 0 - 504
	local.n++; local.bx[local.n] = 2605; local.by[local.n] = 4797; local.bz[local.n] = 0 - 504
	local.n++; local.bx[local.n] = 2501; local.by[local.n] = 4596; local.bz[local.n] = 0 - 504
	local.n++; local.bx[local.n] = 1087; local.by[local.n] = 0 - 126; local.bz[local.n] = 0 - 470
	local.n++; local.bx[local.n] = 0 - 221; local.by[local.n] = 1162; local.bz[local.n] = 0 - 455
	local.n++; local.bx[local.n] = 311; local.by[local.n] = 1036; local.bz[local.n] = 0 - 458
	local.n++; local.bx[local.n] = 1490; local.by[local.n] = 652; local.bz[local.n] = 0 - 457
	local.n++; local.bx[local.n] = 252; local.by[local.n] = 563; local.bz[local.n] = 0 - 460
	local.n++; local.bx[local.n] = 0 - 1083; local.by[local.n] = 0 - 584; local.bz[local.n] = 0 - 475
	local.n++; local.bx[local.n] = 696; local.by[local.n] = 0 - 242; local.bz[local.n] = 0 - 471
	local.n++; local.bx[local.n] = 0 - 678; local.by[local.n] = 815; local.bz[local.n] = 0 - 459
	local.n++; local.bx[local.n] = 0 - 1274; local.by[local.n] = 1080; local.bz[local.n] = 0 - 453
	local.n++; local.bx[local.n] = 0 - 830; local.by[local.n] = 0 - 1082; local.bz[local.n] = 0 - 507
	local.n++; local.bx[local.n] = 0 - 352; local.by[local.n] = 0 - 985; local.bz[local.n] = 0 - 492
	local.n++; local.bx[local.n] = 43; local.by[local.n] = 0 - 941; local.bz[local.n] = 0 - 496
	local.n++; local.bx[local.n] = 0 - 534; local.by[local.n] = 435; local.bz[local.n] = 0 - 465
	local.n++; local.bx[local.n] = 0 - 1127; local.by[local.n] = 0 - 52; local.bz[local.n] = 0 - 467
	local.n++; local.bx[local.n] = 0 - 390; local.by[local.n] = 0 - 406; local.bz[local.n] = 0 - 470
	local.n++; local.bx[local.n] = 1267; local.by[local.n] = 0 - 858; local.bz[local.n] = 0 - 488
	local.n++; local.bx[local.n] = 0 - 1621; local.by[local.n] = 840; local.bz[local.n] = 0 - 461
	local.n++; local.bx[local.n] = 0 - 905; local.by[local.n] = 1165; local.bz[local.n] = 0 - 454
	local.n++; local.bx[local.n] = 0 - 241; local.by[local.n] = 0 - 31; local.bz[local.n] = 0 - 465
	local.n++; local.bx[local.n] = 1130; local.by[local.n] = 712; local.bz[local.n] = 0 - 459
	local.n++; local.bx[local.n] = 0 - 1309; local.by[local.n] = 321; local.bz[local.n] = 0 - 466
	local.n++; local.bx[local.n] = 0 - 1436; local.by[local.n] = 0 - 316; local.bz[local.n] = 0 - 474
	local.n++; local.bx[local.n] = 825; local.by[local.n] = 979; local.bz[local.n] = 0 - 456
	local.n++; local.bx[local.n] = 497; local.by[local.n] = 0 - 1109; local.bz[local.n] = 0 - 507
	local.n++; local.bx[local.n] = 1578; local.by[local.n] = 0 - 157; local.bz[local.n] = 0 - 468
	local.n++; local.bx[local.n] = 1337; local.by[local.n] = 0 - 531; local.bz[local.n] = 0 - 474
	local.n++; local.bx[local.n] = 907; local.by[local.n] = 0 - 833; local.bz[local.n] = 0 - 480
	local.n++; local.bx[local.n] = 1435; local.by[local.n] = 1129; local.bz[local.n] = 0 - 456
	local.n++; local.bx[local.n] = 415; local.by[local.n] = 218; local.bz[local.n] = 0 - 464
	local.n++; local.bx[local.n] = 0 - 1596; local.by[local.n] = 0; local.bz[local.n] = 0 - 468
	local.n++; local.bx[local.n] = 1459; local.by[local.n] = 251; local.bz[local.n] = 0 - 467
	local.n++; local.bx[local.n] = 0 - 23; local.by[local.n] = 265; local.bz[local.n] = 0 - 463
	local.n++; local.bx[local.n] = 0 - 1445; local.by[local.n] = 1497; local.bz[local.n] = 0 - 453
	local.n++; local.bx[local.n] = 0 - 2019; local.by[local.n] = 1297; local.bz[local.n] = 0 - 447
	local.n++; local.bx[local.n] = 0 - 442; local.by[local.n] = 4602; local.bz[local.n] = 0 - 385
	local.n++; local.bx[local.n] = 170; local.by[local.n] = 0 - 341; local.bz[local.n] = 0 - 472
	local.n++; local.bx[local.n] = 867; local.by[local.n] = 274; local.bz[local.n] = 0 - 467

	local.i = 1
	local.made = 0
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.bx[local.i]
		local.p[1] = local.by[local.i]
		//[bug-2264] THESE WERE NEVER DROPPED. The z came from a hand-authored table and the plane was
		//placed at it and left there - so wherever that guess was above the real sand, the pool hung in
		//the air. That is the "floating blood in areas" the user kept reporting, and it is a different
		//fault from the pools sitting on tank traps: those landed on something, these landed on nothing.
		//Spawn high and let coop_placeGround find the ground and step clear of obstacles.
		local.p[2] = local.bz[local.i] + 120

		local.pool = spawn "models/fx/coop_bloodslick.tik"
		if(local.pool != NULL && local.pool != NIL){			//entity-pool guard
			local.pool.origin = local.p
			local.pool.angles = (0 (randomint 360) 0)
			//the plane is ~293u across at scale 1, far bigger than a man - 0.3..0.5 reads as a pool
			local.pool scale (0.3 + (randomfloat 0.2))
			local.pool notsolid
			if(waitthread coop_placeGround local.pool 170){ local.made++ }
		}
		local.i++
	}
	println("^~^~^ BEACHBLOOD pools=" + local.made + "/" + local.n)
}end

//=========================================================================
//[user 2026-08-31] RUN-IN SHELLING - shells landing in the water around the Higgins boats.
//
//User: "I dont feel like there are any explosions hitting the water while we are boating in on omaha,
//I would expect explosions to be happening at random around the higgins boats with giant explosive
//waves coming up and the sound of water being hit by the bombs." The map had no water FX at all.
//
//PLACEMENT IS PLAYER-RELATIVE, and that is the whole difficulty: the fleet is moving north the entire
//time, so any fixed list of impact points would either trail behind the boats or sit ahead of them.
//Each shell is offset from a living player instead, so the barrage travels with the run-in.
//
//The offsets are biased SOUTH (oy runs about -1360..+560) for two reasons: shells landing behind and
//beside the boat read as the barrage the boat is driving through, and it keeps impacts off the sand
//without needing a hard Y clamp - a clamp would stack the north-thrown shells into a visible straight
//row on the clamp line. The absolute guard below is a safety net, not the mechanism.
//
//Minimum standoff is enforced by pushing each offset away from zero, so a shell can never land on the
//boat the players are riding. NOTHING here calls radiusdamage: the players are on a scripted ride and
//must not be hurt by set dressing. fx_mortar_water.tik is classname effectentity + notsolid and plays
//its own arty_exp_water on the client, so there is no playsound here either - adding one would double
//every impact.
//=========================================================================
coop_runInShelling:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_runInShellOn == NIL){ level.coop_runInShellOn = 1 }
	if(!level.coop_runInShellOn){ end }
	if(level.coop_runInShellGap == NIL){ level.coop_runInShellGap = 1.3 }

	level.coop_runInShelling = 1
	local.elapsed = 0
	println("^~^~^ RUNINSHELL started")

	//[user 2026-08-31] one round lands RIGHT BESIDE the boat, with the concussion wash.
	thread coop_runInShelling_nearMiss
	//[user 2026-09-01] and the sea around the boat is under fire the whole way in
	thread coop_runInWaterFire

	while(level.coop_runInShelling){
		//pick a living player to hang the barrage off
		local.pl = NULL
		if($player != NULL && $player != NIL && $player.size > 0){
			local.try = 0
			while(local.try < 4 && local.pl == NULL){
				local.cand = $player[((randomint $player.size) + 1)]
				if(local.cand != NULL && local.cand.health > 0){ local.pl = local.cand }
				local.try++
			}
		}
		if(local.pl == NULL){
			wait 0.5
			local.elapsed = local.elapsed + 0.5
			if(local.elapsed > 150){ break }
			continue
		}

		local.ox = (randomint 1600) - 800
		local.oy = (randomint 1400) - 1100
		//push off zero so a round can never land on the boat itself
		if(local.ox >= 0){ local.ox = local.ox + 320 }else{ local.ox = local.ox - 320 }
		if(local.oy >= 0){ local.oy = local.oy + 260 }else{ local.oy = local.oy - 260 }

		local.pos = (0 0 0)
		local.pos[0] = local.pl.origin[0] + local.ox
		local.pos[1] = local.pl.origin[1] + local.oy
		//the map author's own water-impact height: every baked mortar-water anchor sits here
		local.pos[2] = 0 - 496
		//safety net only - the southward bias means this practically never fires
		if(local.pos[1] > (0 - 2000)){ local.pos[1] = 0 - 2000 }

		local.sh = spawn "models/animate/fx_mortar_water.tik"
		if(local.sh != NULL && local.sh != NIL){			//entity-pool guard
			local.sh.origin = local.pos
			local.sh notsolid
			local.sh anim start

			//close ones shake the boat. earthquake_radius is the ONLY shake that works here - every
			//jitter_* label in this map early-outs on `if($player.size > 1){ end }`.
			if(local.ox < 700 && local.ox > (0 - 700) && local.oy < 700 && local.oy > (0 - 700)){
				thread coop_mod/main.scr::earthquake_radius local.pos 0.5 0.8 750
			}
			//[user 2026-09-01] and it throws water on the lens
			//[user] wider - the user wants this to fire more often near the water
			thread coop_lensSplashAt local.pos 1500

			wait 3
			if(local.sh != NULL){ local.sh remove }
			local.elapsed = local.elapsed + 3
		}else{
			wait 3
			local.elapsed = local.elapsed + 3
		}

		local.gap = (randomfloat level.coop_runInShellGap) + 0.45
		wait local.gap
		local.elapsed = local.elapsed + local.gap

		//two independent leak guards: the ride can end on a path that skips the stop hook (map
		//restart, everyone disconnects, coop_devTest collapsing the ride to time 1)
		if(local.elapsed > 150){ break }
		if($player == NULL || $player == NIL){ break }
		if($player.size <= 0){ break }
	}

	level.coop_runInShelling = 0
	println("^~^~^ RUNINSHELL stopped t=" + local.elapsed)
}end

//One deliberate near miss during the run-in. The random barrage keeps its distance on purpose - it must
//never land on the boat - so without this the whole ride stays at arm's length and nothing ever makes the
//player flinch. This one is scripted: close enough to soak the screen, still outside the hull.
//
//The shellshock is the mod's own coop_tinnitus_triggerBlast (coop_mod/tinnitus.scr:93), called with
//closeness 1 = point-blank, which plays the ring AND layers the 10s concussion wash and the world-SFX
//duck. It is called on EVERY living player, not just one, because they are all in the same boat.
//=========================================================================
coop_runInShelling_nearMiss:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_nearMissAt == NIL){ level.coop_nearMissAt = 7.5 }
	wait level.coop_nearMissAt
	if(!level.coop_runInShelling){ end }

	local.pl = NULL
	if($player != NULL && $player != NIL && $player.size > 0){
		local.i = 1
		while(local.i <= $player.size && local.pl == NULL){
			if($player[local.i] != NULL && $player[local.i].health > 0){ local.pl = $player[local.i] }
			local.i++
		}
	}
	if(local.pl == NULL){ end }

	//just off the port side and slightly astern - close enough to drench, clear of the hull
	local.pos = (0 0 0)
	local.pos[0] = local.pl.origin[0] - 210
	local.pos[1] = local.pl.origin[1] - 150
	local.pos[2] = 0 - 496

	local.sh = spawn "models/animate/fx_mortar_water.tik"
	if(local.sh != NULL && local.sh != NIL){
		local.sh.origin = local.pos
		local.sh notsolid
		local.sh anim start
	}

	thread coop_mod/main.scr::earthquake_radius local.pos 1.2 1.6 1400
	//[user 2026-09-01] this one drenches the lens - it is the closest water column of the whole ride
	thread coop_lensSplashAt local.pos 1900

	local.i = 1
	while($player != NULL && $player != NIL && local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i].health > 0){
			$player[local.i] thread coop_mod/tinnitus.scr::coop_tinnitus_triggerBlast 1
		}
		local.i++
	}
	//[user 2026-08-31] AND THE MEN IN THE BOAT REACT TO IT.
	//
	//A shell goes up point-blank off the side, it shakes every screen and rings every player's ears -
	//and the ten Rangers standing shoulder to shoulder with you carried on swaying placidly. These two
	//threads are retail's own, already written and already used for six FIXED beats on the run-in
	//(m3l1a.scr:3239-3284); this simply fires them at the shell that actually lands next to you.
	//
	//Costs nothing: no entity, no tempmodel, no thread of our own - ten anim calls on actors that
	//already exist. higgins1_flinch is all `upperanim`, so it layers over the legs and cannot disturb
	//the glue that holds the crew to the boat; higgins1_crouch is a full-body anim, which is why the
	//crouch goes first and the flinch lands on top of it.
	//
	//The 0.35s gap is the point - a duck, then the flinch as it registers, rather than both at once.
	//
	//$higgins1_ranger4 is skipped inside those threads while coop_seasickPlaying is up, so this cannot
	//stomp the seasick man if the two overlap - which they will, since the puke fires at 6-13s and
	//this at 7.5s.
	if(level.coop_crewFlinchOn == NIL){ level.coop_crewFlinchOn = 1 }
	if(level.coop_crewFlinchOn){
		thread maps/m3l1a.scr::higgins1_crouch
		wait 0.35
		thread maps/m3l1a.scr::higgins1_flinch
	}

	println("^~^~^ RUNINSHELL nearmiss")

	wait 4
	if(local.sh != NULL && local.sh != NIL){ local.sh remove }
}end


//=========================================================================
//[user 2026-08-31] OMAHA: MORE BOATS, AND THEY LAND.
//
//User: "place way more higgins boats that are advancing or some already ashore", "a few more of those
//higgins boats also got hit and blew up", "ensure they all end up landing and opening and soldiers
//come out, even if they are scripted to get shot up or blown up upon landing", "some higgins boats on
//fire after they blow up".
//
//WHY THIS IS CHEAP: models/vehicles/higginslite_soldiers.tik is ONE entity containing the hull, three
//soldier groups AND the coxswain. A boat full of men costs a single edict. `anim removeguys` empties
//it - which is how a boat "unloads" here without spawning eight actors and wrecking the entity pool.
//
//POSITIONS WERE RE-SOLVED. The first pass put five of six ashore boats INSIDE beach obstacles, because
//the ground height for each spot had been taken from its NEAREST static model - which guarantees a
//boat sits on top of one. These are chosen for >=460u clearance from any BSP static, with the height
//averaged from statics in the 430-1100u band instead. Verified against LUMP_STATICMODELDEF.
//
//RAMP-DOWN BOATS ARE YAW 90 AND ONLY YAW 90 - the hinge offset is measured in the unrotated frame and
//rotatez is ROLL. `anim removeguys`, never `removesoldiers`: the latter's wildcards nodraw the
//COXSWAIN's head as well, giving a headless boat driver.
//=========================================================================
coop_extraBoats:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_xboatsOn == NIL){ level.coop_xboatsOn = 1 }
	if(!level.coop_xboatsOn){ end }

	//---------------- already ashore: ramp down, emptied, some of them wrecked and burning
	//[user 2026-09-01] SPREAD ACROSS THE WHOLE WIDTH. "Tons of open beach where no one is spawning, no
	//higins boats and no one pushing." Five boats between x -3000 and 3360 left a 4000-unit hole through
	//the middle and both shoulders bare. Nine now.
	//
	//[bug-2256] THE FIRST ATTEMPT AT THE EXTRA FOUR WAS PLACED BY EYE AND THIS COMMENT CLAIMED IT WAS
	//NOT. It said "heights follow the same rule the original five were solved under", implying the same
	//>=460u obstacle clearance. Measured against LUMP_STATICMODELDEF afterwards, the original five clear
	//461/513/540/583/634 units - and the four added by eye cleared 295, 116, 100 and 84. A Higgins hull
	//is ~260 wide, so three of the four were sitting THROUGH a hedgehog or a minepole. Writing a comment
	//that asserts a property nobody measured is worse than writing no comment at all: it stops the next
	//session from checking.
	//
	//These four are SOLVED, not chosen: a grid search over the proven ashore band (y -1200..-2500)
	//maximising distance to the 229 hedgehog/minepole/ramp/barbwire statics, with the height taken as
	//the mean of statics in the 430-1100u ring - the same height rule as the original five. The real
	//clearances are on each row. 377u is the worst of them and is stated rather than rounded up.
	local.n = 0
	local.n++; local.asx[local.n] = 0 - 3000; local.asy[local.n] = 0 - 1240; local.asz[local.n] = 0 - 499	//clear 513u
	local.n++; local.asx[local.n] = 0 - 2820; local.asy[local.n] = 0 - 2500; local.asz[local.n] = 0 - 561	//clear 540u
	local.n++; local.asx[local.n] = 0 - 1620; local.asy[local.n] = 0 - 1600; local.asz[local.n] = 0 - 528	//clear 634u
	local.n++; local.asx[local.n] = 2660; local.asy[local.n] = 0 - 2500; local.asz[local.n] = 0 - 557	//[bug-2515] 2520 -> 2660: retail higgins6 was 17u INSIDE this hull; now +123u. static clear 559u
	local.n++; local.asx[local.n] = 3360; local.asy[local.n] = 0 - 1720; local.asz[local.n] = 0 - 542	//clear 461u
	local.n++; local.asx[local.n] = 0 - 4200; local.asy[local.n] = 0 - 2500; local.asz[local.n] = 0 - 576	//clear 980u
	local.n++; local.asx[local.n] = 0 - 1040; local.asy[local.n] = 0 - 2500; local.asz[local.n] = 0 - 582	//clear 478u
	local.n++; local.asx[local.n] = 0 - 100; local.asy[local.n] = 0 - 2480; local.asz[local.n] = 0 - 583	//clear 377u
	local.n++; local.asx[local.n] = 1480; local.asy[local.n] = 0 - 1700; local.asz[local.n] = 0 - 535	//clear 421u

	local.i = 1
	local.made = 0
	while(local.i <= local.n && local.made < 22){
		local.p = (0 0 0)
		local.p[0] = local.asx[local.i]
		local.p[1] = local.asy[local.i]
		local.p[2] = local.asz[local.i]

		//two of the five are burning wrecks - the damaged hull reads as "this one did not make it"
		local.wrecked = 0
		//[bug-2515] 8 -> 9. Ashore#8's randomised WRECK yaw put it through retail higgins3 on 88.8%
		//of runs, up to 192u deep; upright it clears by 36.87u. #9 takes the third wreck slot and is
		//clear of lane 6 / higgins5 / higgins6 by 148.8 / 746.8 / 838.7u at every roll.
		if(local.i == 2 || local.i == 6 || local.i == 9){ local.wrecked = 1 }

		local.hull = spawn script_model model "models/vehicles/higginslite_soldiers.tik"
		if(local.hull != NULL && local.hull != NIL){			//entity-pool guard
			local.hull.origin = local.p + (0 0 120)
			local.hull.angles = (0 90 0)
			local.hull notsolid
			local.hull droptofloor
			local.hull anim removeguys		//emptied - these men are already on the sand
			local.made++
			if(local.wrecked){
				//[user 2026-09-01] broached, not parked - see the note on the flank wrecks. Pitch and
				//roll are deliberately larger here: these are the ones you walk right past.
				local.hull.angles = ( ( ( randomint 34 ) - 17 ) ( 90 + ( ( randomint 90 ) - 45 ) ) ( ( randomint 60 ) - 30 ) )
				thread coop_boatBurn local.hull.origin		//[bug-2515] the settled hull, not the seed origin - matches :3152 and :4849
			}
			//[user 2026-09-01] ...except the last two out, who are still at the mouth of the ramp when
			//you get there. An "already unloaded" boat with nobody anywhere near it reads as scenery;
			//two stragglers, one of whom does not make it, ties the hull to the bodies around it.
			if(!local.wrecked){ thread coop_disembarkStragglers local.p }

			//[bug-2515] no ramp on a wreck. The hull is yawed +/-45 but the door is pinned to world yaw
			//90 at the pre-droptofloor seed origin, so the ramp lands entirely OUTSIDE its own hull on
			//52.2% of spawns (47/90 measured). coop_flankLandings already does exactly this for its own
			//wrecks. Saves 6 edicts. Re-aiming the hinge cannot fix it: rotatezdown turns about the
			//HINGE's own forward axis, and a bare script_origin faces world +X wherever it is put.
			if(!local.wrecked){
			local.door = spawn script_model model "models/vehicles/higginsdoor.tik"
			if(local.door != NULL && local.door != NIL){
				local.door.origin = local.p
				local.door.angles = (0 90 0)
				local.door notsolid
				//the door mesh sits ~265u forward of its entity origin, so it must hinge off a
				//separate origin or it swings through the hull
				local.hinge = spawn script_origin
				if(local.hinge != NULL && local.hinge != NIL){
					local.hinge.origin = local.p + (0 263 40)
					local.door bind local.hinge
					local.hinge time 0.1
					local.hinge rotatezdown 90
					local.hinge move
				}
			}
			}		//[bug-2515] end of the !wrecked ramp guard
		}
		local.i++
	}

	//---------------- still coming in, bound to the fleet: each one lands, drops its ramp and unloads
	local.n = 0
	local.n++; local.afx[local.n] = 0 - 3400; local.afy[local.n] = 0 - 6400
	local.n++; local.afx[local.n] = 0 - 2600; local.afy[local.n] = 0 - 5600
	local.n++; local.afx[local.n] = 0 - 1500; local.afy[local.n] = 0 - 6150
	local.n++; local.afx[local.n] = 1900; local.afy[local.n] = 0 - 6300
	local.n++; local.afx[local.n] = 3100; local.afy[local.n] = 0 - 5750
	local.n++; local.afx[local.n] = 860; local.afy[local.n] = 0 - 5900	//[bug-2515] 760 -> 860: 157u of this hull sat inside the PLAYER'S boat; now +123u clear

	local.i = 1
	while(local.i <= local.n && local.made < 22){
		local.p = (0 0 0)
		local.p[0] = local.afx[local.i]
		local.p[1] = local.afy[local.i]
		//[2026-09-05] -544 -> -563.7. THE OLD NUMBER WAS READ OFF THE WRONG THING. higgins3_model ships
		//at z -543.72 in the BSP and that is its AUTHORING position, not where it floats: m3l1a.scr:594
		//waitthreads higgins_boat_bind for all six retail boats, and that label ends with
		//`local.higgins_origin movedown 20` (m3l1a.scr:736) on the parent every hull is bound to. Every
		//retail Higgins therefore settles at -563.72, and every coop boat placed at -544 has been
		//floating 20 units proud of the boats beside it. Same failure as bug-2209 and bug-2256, which
		//the header above already records twice: a measurement asserted in a comment without being
		//taken. Hull bounds for reference: keel = origin-1.28, deck top = origin+140.53
		//(higginslite_soldiers.tik skc frame bounds z -2.4688..270.2508 through scale 0.52).
		local.p[2] = 0 - 563.7

		local.hull = spawn script_model model "models/vehicles/higginslite_soldiers.tik"
		if(local.hull != NULL && local.hull != NIL){
			local.hull.origin = local.p
			local.hull.angles = (0 90 0)
			local.hull notsolid
			local.hull anim idle			//troops and coxswain aboard
			if($higgins_fleet != NULL && $higgins_fleet != NIL){ local.hull bind $higgins_fleet }
			local.made++

			local.door = spawn script_model model "models/vehicles/higginsdoor.tik"
			if(local.door != NULL && local.door != NIL){
				local.door.origin = local.p
				local.door.angles = (0 90 0)
				local.door notsolid
				if($higgins_fleet != NULL && $higgins_fleet != NIL){ local.door bind $higgins_fleet }
			}

			//every one of them lands and unloads. Two are hit on the way in and burn - but they still
			//drop the ramp first, because a boat that never opens just reads as scenery.
			local.doomed = 0
			if(local.i == 2 || local.i == 5){ local.doomed = 1 }
			thread coop_boatLand local.hull local.door local.doomed local.i
		}
		local.i++
	}

	println("^~^~^ XBOATS placed=" + local.made)
}end

//One incoming boat: run in with the fleet, drop the ramp, empty out. The doomed ones take a shell on
//the way and burn, but they still open - the user asked for that explicitly.
//=========================================================================
coop_boatLand local.hull local.door local.doomed local.slot:{
//=========================================================================
	if(local.hull == NULL){ end }

	//stagger so they do not all beach in the same second
	wait ( 6 + ( randomfloat 9 ) + ( local.slot * 1.5 ) )
	if(local.hull == NULL){ end }

	if(local.doomed == 1){
		//hit on the run-in: burst, then the hull burns for the rest of the map
		//[user 2026-08-31] THE MAP'S OWN BOAT-DEATH EFFECT, instead of a water splash.
		//
		//models/animate/fx_mortar_higgins.tik is purpose-built for exactly this event - a bang.spr
		//flash at +256, a 30-second volumetric greasefire, two burst clouds and thirty woodsplinter
		//chunks. Retail fires it five times on this map (m3l1a.scr:3100 and the bangalore sites), so
		//it is proven here; the coop-added doomed boats were the odd ones out, dying in a splash that
		//reads as a NEAR MISS while the retail boat beside you gets a fireball. This makes them match.
		//
		//No `angles` set: the tik's own init supplies angles 270 0 0 and all four retail instances
		//run it that way.
		local.hit = local.hull.origin + (0 0 40)
		local.b = spawn "models/animate/fx_mortar_higgins.tik"
		if(local.b != NULL && local.b != NIL){
			local.b.origin = local.hit
			local.b notsolid
			local.b anim start
		}
		//SOUND ON THE HULL, and the long-range alias. exp_higgins is 320/2200 and these boats sit
		//3200-3500 units out, so under AL_LINEAR_DISTANCE_CLAMPED its gain is exactly zero - the
		//player would hear nothing at all. higgins_explosion is 500/5000 off the same wav and is what
		//m3l1a.scr:3101 already plays for this event. The hull also outlives the fx entity, so a 7s
		//report is not cut off by the remove below.
		local.hull playsound higgins_explosion
		thread coop_mod/main.scr::earthquake_radius local.hit 0.8 1.1 1500
		thread coop_boatBurn local.hull.origin
		local.hull model "models/vehicles/higgins_damage.tik"
		local.hull notsolid		//[bug-2496] a .tik `model` swap sets SOLID_BBOX; notsolid must FOLLOW it
		//6s, not 1.2s: at 1.2 the smoke originemitter has barely started (~6 sources) and the
		//standing column never forms. 6s gives it ~30 and still frees the entity long before the
		//tik's own commanddelay 30 emitteroff.
		wait 6
		if(local.b != NULL && local.b != NIL){ local.b remove }
	}

	//ramp down - even the wrecked ones open
	if(local.door != NULL){
		local.hinge = spawn script_origin
		if(local.hinge != NULL && local.hinge != NIL){
			local.hinge.origin = local.door.origin + (0 263 40)
			local.door bind local.hinge
			local.hinge time 0.6
			local.hinge rotatezdown 90
			local.hinge move
		}
	}

	//and the men go out.
	//
	//[user 2026-09-01, bug-2252] REAL ACTORS, NOT JUST `removeguys`. The user: "If we could make more
	//scenes of when the added higgins boats open allied ai leaves and heads to teh beach, some should
	//get instantly slaughtered by MG fire and it should extremely brutal deaths."
	//
	//What this line used to do was empty the boat MODEL - higginslite_soldiers.tik carries its crew as
	//baked geometry, and `anim removeguys` nodraws it. That is how a boat "unloads" for one edict, and
	//as a way to make a distant boat look emptied it is correct. But NOBODY WAS EVER SPAWNED, so there
	//was no disembark to watch: the men simply blinked out of the hull. The requirement is men leaving
	//the boat and being killed on the sand, and that needs actors.
	//
	//ORDER MATTERS: spawn FIRST, then nodraw the baked crew, or you get a frame where both are visible.
	wait ( 2 + ( randomfloat 2 ) )
	if(local.hull != NULL){
		if(local.doomed == 1){
			//[user 2026-09-02, bug-2331] "some of these higgins boats need to get absolutely shotup and
			//everyone killed upon launch." A doomed boat used to simply not unload - it burned with its
			//crew still baked into the hull, so the worst thing on the beach happened off-screen. Now it
			//drops its ramp into the guns and the whole section is cut down in the mouth: count and doom
			//are the same number, so coop_disembarkSquad kills every man it makes.
			waitthread coop_disembarkSquad local.hull 6 6
		}else{
			waitthread coop_disembarkSquad local.hull ( 5 + ( randomint 3 ) ) 2
		}
		if(local.hull != NULL){ local.hull anim removeguys }
	}
}end

//=========================================================================
//[user 2026-09-01] A BOATLOAD COMES DOWN THE RAMP.
//
//local.count men out of the mouth of local.hull; the first local.doom of them are cut down before they
//clear it. Used by coop_boatLand for the incoming fleet and by coop_extraBoats for the boats already on
//the sand.
//
//DIRECTION. Every coop-placed Higgins is yaw 90 and the ramp hinge is measured at (0 263 40) in that
//frame, so the mouth is +Y of the hull origin and +Y is also shoreward. One convention, asserted in one
//place: if a boat is ever placed at another yaw this is what has to change.
//
//BUDGET. A hard mission-wide cap (level.coop_disembarkCap, 26) across every boat, because these are the
//only actors in the Omaha layer that both carry live AI and are spawned from a loop whose length depends
//on how many boats survived. Survivors are removed once they are off the beach, so their edicts come
//back; the ones who die stay as bodies, which is the point of them.
//=========================================================================
coop_disembarkSquad local.hull local.count local.doom:{
//=========================================================================
	if(local.hull == NULL || local.hull == NIL){ end }
	if(level.coop_disembarkOn == NIL){ level.coop_disembarkOn = 1 }
	if(!level.coop_disembarkOn){ end }
	//[user 2026-09-02, bug-2331] 14 -> 34. "More of these higgins boats that weve spawned should ride
	//in with way more actors that hit the beach." The cap was set when the entity pool was exhausting
	//at 2046/2048; that pool is 4096 now (bug-2293) and this is the layer the user most wants spent on.
	if(level.coop_disembarkCap == NIL){ level.coop_disembarkCap = 34 }
	if(level.coop_disembarkMade == NIL){ level.coop_disembarkMade = 0 }

	local.base = local.hull.origin
	local.k = 0
	while(local.k < local.count){
		if(level.coop_disembarkMade >= level.coop_disembarkCap){ break }

		//down the ramp in single file, not abreast - the mouth is one man wide
		local.p = (0 0 0)
		local.p[0] = local.base[0] + ((randomint 90) - 45)
		local.p[1] = local.base[1] + 210 + (local.k * 90)
		local.p[2] = local.base[2] + 40

		local.mdl = "models/human/dday_29th_private"
		if((randomint 2) == 0){ local.mdl = "models/human/dday_ranger_private" }
		local.a = spawn local.mdl gun "m1 garand"
		if(local.a != NULL && local.a != NIL){			//entity-pool guard
			level.coop_disembarkMade++
			local.a.coop_noChatter = 1
			local.a threatbias ignoreme
			local.a notarget 1
			local.a dontdropweapons
			local.a notsolid
			//isinsequence/isbusy keep every coop sweeper and the map's own todo system off them
			local.a.isinsequence = 1
			local.a.isbusy = 1
			local.a.origin = local.p
			if(!waitthread coop_dryGround local.a){
				//the boat grounded somewhere with no dry sand in front of it - no disembark from this
				//one rather than men standing in the sea
				level.coop_disembarkMade--
				local.a = NULL
			}

			if(local.a == NULL || local.a == NIL){ local.k++; continue }
			if(local.k < local.doom){
				//THE BEATEN ZONE IS ON THE RAMP. He gets a stride and a half.
				local.a thread coop_disembarkDeath
			}else{
				local.a thread coop_disembarkRun
			}
		}
		local.k++
		wait ( 0.35 + ( randomfloat 0.5 ) )
	}
}end

//He clears the ramp and the MG finds him. Kill recipe is maps/m3l1a.scr::bhit - retail's own, the same
//one higgins1_disembark_kill uses twenty feet from where the player is standing - so this death looks
//like the deaths the map already shows. NOTE these men are deliberately NOT given `nodamage`: bhit runs
//through global/bullethit.scr and an actor with takedamage DAMAGE_NO would absorb all of it and stand
//there. That is exactly how a "slaughter" ends up as a man walking calmly up a beach.
//=========================================================================
coop_disembarkDeath:{
//=========================================================================
	local.wp = spawn info_waypoint
	if(local.wp != NULL && local.wp != NIL){
		//[bug-2290] ONE SHORT HOP, ROUTED. Two strides off the ramp used to be `self.origin` with y
		//pushed 200-400 and the z copied off the man, which is the buried marker that noclips him
		//through the beach the instant he brushes a hedgehog. coop_advanceLeg picks a corridor that
		//is clear of the traps and sets the marker's z off the GROUND.
		local.g = self.origin
		local.g[1] = local.g[1] + 900
		waitthread coop_advanceLeg self local.wp local.g ( 200 + (randomint 200) ) 34
	}

	wait ( 0.5 + ( randomfloat 1.4 ) )
	if(isalive self){
		local.o = self.origin + (0 0 44)
		self thread maps/m3l1a.scr::bhit 40 -1
		wait 0.14
	}
	if(isalive self){
		self thread maps/m3l1a.scr::bhit 40 -1
		wait 0.16
	}
	if(isalive self){
		local.o = self.origin + (0 0 42)
		self thread maps/m3l1a.scr::bhit 1000 -1

		local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
		if(local.sp != NULL && local.sp != NIL){
			local.sp.origin = local.o
			local.sp notsolid
			local.sp anim start
			thread coop_fxCleanup local.sp 6
		}
		local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
		if(local.g != NULL && local.g != NIL){
			local.g.origin = local.o
			local.g.angles = ((randomint 360) (randomint 360) (randomint 360))
			local.g notsolid
			local.g anim idle
			waitthread coop_placeGround local.g 50
		}
		local.s = spawn "models/fx/coop_bloodslick.tik"
		if(local.s != NULL && local.s != NIL){
			local.s.origin = local.o - (0 0 42)
			local.s.angles = (0 (randomint 360) 0)
			local.s notsolid
			waitthread coop_placeGround local.s 170
		}
	}

	if(local.wp != NULL && local.wp != NIL){ local.wp remove }
}end

//He makes it off the ramp and works up the sand. Removed when he is clear of the beach or when his time
//is up, so the edict comes back - see the budget note on coop_disembarkSquad.
//=========================================================================
coop_disembarkRun:{
//=========================================================================
	local.wp = spawn info_waypoint
	if(local.wp == NULL || local.wp == NIL){ end }

	local.t = 0
	while(isalive self && local.t < 70){
		//[bug-2290] SHORT ROUTED HOPS, MARKER OFF THE GROUND. Was self.origin with y +340..660 and
		//the man's own z, i.e. a marker under the sand aimed straight through the obstacle belt.
		local.g = self.origin
		local.g[0] = local.g[0] + ((randomint 300) - 150)
		local.g[1] = local.g[1] + 1400
		local.moved = waitthread coop_advanceLeg self local.wp local.g 340 34

		local.w = 2 + ( randomfloat 1.5 )
		if(local.moved == 0){ local.w = 0.6 }		//boxed in - stand a beat, then try a new bearing
		wait local.w
		local.t = local.t + local.w

		if(self == NULL || self == NIL){ break }
		waitthread coop_underCheck self
		if(self == NULL || self == NIL){ break }
		if(self.origin[1] > 1600){ break }			//off the sand and into the map proper
	}

	if(local.wp != NULL && local.wp != NIL){ local.wp remove }

	//[bug-2272] HE DOES NOT EVAPORATE EITHER. This used to `remove` a man who made it off the sand,
	//which the user watched happen. He is handed to the same end everyone else on this beach gets.
	if(self != NULL && self != NIL){
		if(isalive self){
			self thread maps/m3l1a.scr::bhit 40 -1
			wait 0.15
			if(isalive self){ self thread maps/m3l1a.scr::bhit 1000 -1 }
			local.s = spawn "models/fx/coop_bloodslick.tik"
			if(local.s != NULL && local.s != NIL){
				local.s.origin = self.origin
				local.s.angles = (0 (randomint 360) 0)
				local.s notsolid
				waitthread coop_placeGround local.s 170
			}
		}
	}
}end


//A burning hull: fire, smoke and a long column, for the rest of the map.
//=========================================================================
coop_boatBurn local.pos:{
//=========================================================================
	if(local.pos == NIL){ end }

	//[user 2026-09-01] "if any higgins boats are getting destroyed they need to be obviously hit and
	//exploded, ideally with fires and bodies and gore." One small fire and one smoke puff read as a
	//boat with an engine problem. A boat that took a shell is on fire in three places, streaming black
	//smoke, and the men who were in it are in the water around it.

	//--- three fires along the hull rather than one at its centre
	//[user 2026-09-01] TWO, NOT THREE. "We can probably chill out on some of the fire on the beach at
	//least." Three fires on every hull plus a superlong column plus linger smoke, times five wrecks, is
	//what turned the waterline into a wall of flame in the user's screenshots.
	local.k = 0
	while(local.k < 2){
		local.f = spawn "models/emitters/tehao_fire.tik"
		if(local.f != NULL && local.f != NIL){			//entity-pool guard
			local.fp = (0 0 0)
			local.fp[0] = local.pos[0] + ((randomint 200) - 100)
			local.fp[1] = local.pos[1] + ((randomint 260) - 130)
			//[user 2026-09-06, bug-2504] +20..80 -> +100..134: local.pos is the hull's origin = its KEEL on the
			//seabed (bounds: deck top = origin+140.53), so the flames sat below the deck floor and, for the hulls
			//in the water, 9 u above the surface - 'fires underwater' from the plunge. Deck height, above the gunwale.
			local.fp[2] = local.pos[2] + 100 + (randomint 34)
			local.f.origin = local.fp
			local.f notsolid
			local.f anim start
			//ONE loop sound between them - three overlapping fire loops on one boat is mush, and
			//there can be several wrecks up at once
			//[user, bug-2313] fire loopsound removed - visual only, and it was holding a channel
		}
		local.k++
	}

	//--- the column. superlong is the tall one; linger_smoke alone barely clears the gunwale.
	local.sm = spawn "models/emitters/tehao_firesmoke_superlong.tik"
	if(local.sm != NULL && local.sm != NIL){
		local.sm.origin = local.pos + (0 0 130)		//[bug-2504] deck height
		local.sm notsolid
		local.sm anim start
	}
	local.sm2 = spawn "models/emitters/linger_smoke.tik"
	if(local.sm2 != NULL && local.sm2 != NIL){
		local.sm2.origin = local.pos + (0 0 150)		//[bug-2504] deck height
		local.sm2 notsolid
		local.sm2 scale 2.4
		local.sm2 anim start
	}

	//--- and the crew, in the water AROUND the hull rather than in it.
	//
	//[user 2026-09-01, bug-2253] TWO, AND THEY STAY DOWN.
	//
	//The first version of this put FOUR men round every wreck and posed them with a bare `anim fallen`.
	//`fallen` is a ONE-SHOT: it plays, ANIMDONE fires, and the actor returns to its idle, which is
	//STANDING. coop_vigKeep exists for exactly this reason and re-triggers the pose on a loop; calling
	//the anim bare produced a squad standing to attention in the surf around every hull, which is what
	//the user saw ("tons of allied actors standing on top of the higgins boats ... just standing there").
	//Five wrecks x four also took the shared vignette budget to 51/56 in the live log, which would have
	//silently starved a later wreck of bodies entirely.
	//
	//So: two per wreck, held down by coop_vigKeep, pushed well clear of the hull, and given their own
	//+2 of budget so they neither crowd the beach nor eat the vignettes' allocation.
	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 2 }

	local.k = 0
	while(local.k < 2){
		//position into a local first - coop_vigSpawn takes a vector ARGUMENT, and an inline
		//parenthesised expression in an argument list is not the same thing as a vector literal.
		//300-560 out, not 0-210: at the old radius they were ON the hull rather than around it.
		local.bp = (0 0 0)
		local.bp[0] = local.pos[0] + (300 + (randomint 260)) - ((randomint 2) * (600 + (randomint 520)))
		local.bp[1] = local.pos[1] + (300 + (randomint 260)) - ((randomint 2) * (600 + (randomint 520)))
		local.bp[2] = local.pos[2] + 60

		local.b = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.bp (randomint 360)
		if(local.b != NULL && local.b != NIL){
			local.b thread coop_vigKeep "fallen"
		}
		local.k++
	}

	//--- gore and a slick, so the water around it is not clean
	local.k = 0
	while(local.k < 5){
		local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
		if(local.g != NULL && local.g != NIL){
			local.gp = (0 0 0)
			local.gp[0] = local.pos[0] + ((randomint 500) - 250)
			local.gp[1] = local.pos[1] + ((randomint 500) - 250)
			local.gp[2] = local.pos[2] + 80
			local.gp = waitthread coop_dropSpot local.gp 50
			if(local.gp == NULL){ local.k++; continue }
			local.g.origin = local.gp
			local.g.angles = ((randomint 360) (randomint 360) (randomint 360))
			local.g scale (0.5 + (randomfloat 0.8))
			local.g notsolid
			local.g anim idle
			local.g droptofloor
		}
		local.k++
	}
	local.s = spawn "models/fx/coop_bloodslick.tik"
	if(local.s != NULL && local.s != NIL){
		local.sp = (0 0 0)
		local.sp[0] = local.pos[0] + ((randomint 240) - 120)
		local.sp[1] = local.pos[1] + ((randomint 240) - 120)
		local.sp[2] = local.pos[2] + 60
		local.sp = waitthread coop_dropSpot local.sp 190
		if(local.sp == NULL){ end }
		local.s.origin = local.sp
		local.s.angles = (0 (randomint 360) 0)
		local.s scale (1.4 + (randomfloat 1.2))
		local.s notsolid
		local.s droptofloor
	}
}end

//=========================================================================
//[user 2026-08-31] THE WIDER INVASION - "we should see allies way outside of the beach area that we
//are on too arriving in higgins boats and mg fire, explosions, etc. all over that area".
//
//Purely to be looked at: everything here sits outside the playable beach (|x| >= 4600), nothing is
//solid, nothing does damage, and no AI is spawned. It is the rest of Omaha happening without you.
//=========================================================================
coop_farBattle:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_farBattleOn == NIL){ level.coop_farBattleOn = 1 }
	if(!level.coop_farBattleOn){ end }

	local.n = 0
	local.n++; local.frx[local.n] = 0 - 4050; local.fry[local.n] = 0 - 4600
	local.n++; local.frx[local.n] = 0 - 3450; local.fry[local.n] = 0 - 5500
	local.n++; local.frx[local.n] = 0 - 2950; local.fry[local.n] = 0 - 3900
	local.n++; local.frx[local.n] = 3450; local.fry[local.n] = 0 - 4400
	local.n++; local.frx[local.n] = 3050; local.fry[local.n] = 0 - 5400
	local.n++; local.frx[local.n] = 2600; local.fry[local.n] = 0 - 3800

	//a landing wave out on both flanks
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.frx[local.i]
		local.p[1] = local.fry[local.i]
		//[user 2026-08-31] REPOSITIONED. These sat at |x| 4600-5600, beyond the map's built extent
		//(statics run x -4419..3854), so they were floating outside the world - which is what the
		//user saw on both flanks. Now on the seaward flanks INSIDE the map, at the retail boat
		//waterline. [2026-09-05] -544 -> -563.7: -543.72 is higgins3_model's BSP AUTHORING z, and
		//higgins_boat_bind drops every retail hull 20 units at map load (m3l1a.scr:736). See the long
		//note at the incoming-fleet block in coop_extraBoats.
		local.p[2] = 0 - 563.7

		local.h = spawn script_model model "models/vehicles/higginslite_soldiers.tik"
		if(local.h != NULL && local.h != NIL){
			local.h.origin = local.p
			local.h.angles = (0 90 0)
			local.h notsolid
			//[user 2026-08-31] EMPTY, and further out. With `anim idle` these carried a full visible
			//boatload, and at that range a line of identical crews reads as duplicated props rather than
			//as a landing. Beached, emptied hulls and burning wrecks read correctly at distance.
			if(local.i == 3 || local.i == 5){
				local.h model "models/vehicles/higgins_damage.tik"
				local.h notsolid		//[bug-2496] a .tik `model` swap sets SOLID_BBOX; notsolid must FOLLOW it
				thread coop_boatBurn local.p
			}else{
				local.h anim removeguys
			}
		}
		local.i++
	}
	println("^~^~^ FARBATTLE boats=" + local.n)

	//and it keeps going: shellfire walking along both flanks for the rest of the map
	local.t = 0
	while(level.coop_farBattleOn){
		local.side = 1
		if((randomint 2) == 0){ local.side = 0 }
		local.p = (0 0 0)
		if(local.side){ local.p[0] = 4400 + (randomint 1600) }
		else{ local.p[0] = 0 - ( 4400 + (randomint 1600) ) }
		local.p[1] = ( 0 - 3600 ) + (randomint 4200)
		local.p[2] = 0 - 500

		local.e = spawn "models/animate/fx_mortar_dirt.tik"
		if(local.e != NULL && local.e != NIL){
			local.e.origin = local.p
			local.e notsolid
			local.e anim start
			wait 3.5
			if(local.e != NULL){ local.e remove }
		}else{
			wait 3.5
		}
		wait ( 2.5 + ( randomfloat 4 ) )
	}
}end

//=========================================================================
//[user 2026-08-31] BEACH AMBIENCE - "this entire beach needs to feel more alive, a bit more random
//events added to non scripted actors", "more fires", "it should look like a warzone".
//
//Cosmetic only: no radiusdamage anywhere in here, so it can never kill a player or a mission-critical
//actor. Everything spawned in the loop carries an entity-pool guard and a removal path.
//=========================================================================
coop_beachWar:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachWarOn == NIL){ level.coop_beachWarOn = 1 }
	if(!level.coop_beachWarOn){ end }
	if(level.coop_beachWarGap == NIL){ level.coop_beachWarGap = 2.2 }

	//standing fires scattered over the sand - lit once, they burn all map
	local.i = 0
	while(local.i < 9){
		local.p = (0 0 0)
		local.p[0] = ( 0 - 3000 ) + (randomint 6200)
		local.p[1] = ( 0 - 2400 ) + (randomint 3000)
		local.p[2] = 0 - 500
		//keep the run-up lane clear so a fire never blocks the player's route
		if(local.p[0] > (0 - 900) && local.p[0] < 1300){ local.p[0] = local.p[0] + 2200 }
		local.f = spawn "models/emitters/tehao_fire.tik"
		if(local.f != NULL && local.f != NIL){
			local.f.origin = local.p
			local.f notsolid
			local.f anim start
			//[user, bug-2313] fire loopsound removed - visual only, and it was holding a channel
		}
		local.sm = spawn "models/emitters/linger_smoke.tik"
		if(local.sm != NULL && local.sm != NIL){
			local.sm.origin = local.p + (0 0 40)
			local.sm notsolid
			local.sm anim start
		}
		local.i++
	}
	println("^~^~^ BEACHWAR fires=9")

	//and a running barrage across the sand for the rest of the map
	while(level.coop_beachWarOn){
		local.p = (0 0 0)
		local.p[0] = ( 0 - 3200 ) + (randomint 6600)
		local.p[1] = ( 0 - 2600 ) + (randomint 3400)
		local.p[2] = 0 - 500

		local.e = spawn "models/animate/fx_mortar_dirt.tik"
		if(local.e != NULL && local.e != NIL){
			local.e.origin = local.p
			local.e notsolid
			local.e anim start
			//close ones shake, but never hurt
			thread coop_mod/main.scr::earthquake_radius local.p 0.5 0.7 850
			wait 3
			if(local.e != NULL){ local.e remove }
		}else{
			wait 3
		}
		wait ( 1.5 + ( randomfloat level.coop_beachWarGap ) )
	}
}end


//=========================================================================
//[user 2026-08-31] THE DEAD, AND THE BLOOD - "more bodies and blood all over the shore too would make
//sense. badly damaged is ideal", "beach is not bloody enough, it should look like a warzone and not
//just be dictated by bodies, think saving private ryan".
//
//Two separate things, deliberately. coop_beachBlood already puts a pool under each of the 43 corpses
//the map ships. This adds MORE dead, AND - the part the user actually asked for - blood that is not
//attached to a body at all, so the sand reads as fought-over rather than as a tidy row of casualties.
//
//Positions were solved against LUMP_STATICMODELDEF, not guessed: >=120u clear of any static for a
//body, >=70u for a pool, with the ground height averaged from statics within 900u. That is the same
//method that had to be applied after five of six Higgins boats were found embedded in beach obstacles.
//
//All notsolid, all static, no threads, no per-frame cost.
//=========================================================================
coop_beachDead:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachDeadOn == NIL){ level.coop_beachDeadOn = 1 }
