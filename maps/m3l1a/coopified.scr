	local.n++; local.plx[local.n] = 0 - 3060; local.ply[local.n] = 0 - 1783; local.plz[local.n] = 0 - 566
	local.n++; local.plx[local.n] = 2907; local.ply[local.n] = 0 - 2175; local.plz[local.n] = 0 - 567
	local.n++; local.plx[local.n] = 0 - 1058; local.ply[local.n] = 0 - 2351; local.plz[local.n] = 0 - 582
	local.n++; local.plx[local.n] = 3270; local.ply[local.n] = 1370; local.plz[local.n] = 0 - 468
	local.n++; local.plx[local.n] = 0 - 1942; local.ply[local.n] = 0 - 1355; local.plz[local.n] = 0 - 519
	local.n++; local.plx[local.n] = 2260; local.ply[local.n] = 0 - 1462; local.plz[local.n] = 0 - 541
	local.n++; local.plx[local.n] = 724; local.ply[local.n] = 0 - 1660; local.plz[local.n] = 0 - 571
	local.n++; local.plx[local.n] = 1859; local.ply[local.n] = 790; local.plz[local.n] = 0 - 462
	local.n++; local.plx[local.n] = 1143; local.ply[local.n] = 0 - 2273; local.plz[local.n] = 0 - 575
	local.n++; local.plx[local.n] = 3082; local.ply[local.n] = 0 - 2169; local.plz[local.n] = 0 - 567
	local.n++; local.plx[local.n] = 0 - 111; local.ply[local.n] = 908; local.plz[local.n] = 0 - 464
	local.n++; local.plx[local.n] = 2197; local.ply[local.n] = 0 - 537; local.plz[local.n] = 0 - 502
	local.n++; local.plx[local.n] = 243; local.ply[local.n] = 0 - 1445; local.plz[local.n] = 0 - 543
	local.n++; local.plx[local.n] = 2974; local.ply[local.n] = 0 - 1752; local.plz[local.n] = 0 - 555
	local.n++; local.plx[local.n] = 2785; local.ply[local.n] = 0 - 800; local.plz[local.n] = 0 - 514

	local.i = 1
	local.np = 0
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.plx[local.i]
		local.p[1] = local.ply[local.i]
		local.p[2] = local.plz[local.i]

		local.s = spawn "models/fx/coop_bloodslick.tik"
		if(local.s != NULL && local.s != NIL){
			local.s.origin = local.p + (0 0 90)
			local.s.angles = (0 (randomint 360) 0)
			local.s droptofloor

			//[user 2026-09-02, bug-2391] "still floating blood all over barbed wire and seawall
			//areas", reported three times. THESE 46 POOLS WERE THE ONE BLOOD SITE WITH NO GUARD AT
			//ALL - a bare droptofloor, no obstacle nudge, no perched test - while every other blood
			//and prop placement on this beach routes through coop_placeGround or coop_wreckDrop.
			//Found by an audit sweep; I had "fixed" floating blood twice by tightening the tolerance
			//in the function these never called.
			//
			//Same measured rule as everywhere else: more than 8 units above the ground datum means
			//it is lying on a tank trap or a wire run, and a missing stain costs nothing next to a
			//stain hanging in the air.
			local.bw = waitthread coop_nearGroundZ local.s.origin[0] local.s.origin[1]
			if(local.bw == NIL){ local.bw = waitthread coop_groundZ local.s.origin[1] }
			if(local.bw != NIL && local.s.origin[2] > ( local.bw + 8 )){
				local.s remove
			}else{
				//wider range than the corpse pools: some are smears, some are wide stains
				local.s scale (0.3 + (randomfloat 0.85))
				local.s notsolid
				local.np++
			}
		}
		local.i++
	}
	println("^~^~^ BEACHDEAD pools=" + local.np)
}end


//=========================================================================
//[user 2026-08-31] INCOMING AND OUTGOING FIRE.
//
//User: "more explosions after the sandwall, more gunshots hitting the water sporadically at random as
//you are getting closer inland and as youre moving through the water, plus gunshots hitting all around
//the hill and bunkers constantly to show return fire happening" and "way more bullets hitting in and
//around the seawall as you are meeting the captain and blowing it with bangalores".
//
//Four separate loops rather than one, because they belong to different moments and want different
//rates - and because each can be switched off on its own if it turns out to be too much.
//
//ALL COSMETIC. Nothing here calls radiusdamage, so none of it can hurt a player or kill a
//mission-critical actor. Every spawn carries an entity-pool guard and a removal path; nothing is
//left standing. fx_mortar_water/fx_mortar_dirt are the map's own effects and are already precached by
//maps/m3l1a_precache.scr, scaled down here so a rifle strike does not read as a mortar round.
//=========================================================================

//Rounds cracking into the water around you while you are still wading in.
//=========================================================================
coop_waterShots:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_waterShotsOn == NIL){ level.coop_waterShotsOn = 1 }
	if(!level.coop_waterShotsOn){ end }

	while(level.coop_waterShotsOn){
		local.pl = NULL
		if($player != NULL && $player != NIL && $player.size > 0){
			local.try = 0
			while(local.try < 4 && local.pl == NULL){
				local.c = $player[((randomint $player.size) + 1)]
				if(local.c != NULL && local.c.health > 0){ local.pl = local.c }
				local.try++
			}
		}
		//only while somebody is still in or near the water - the sand starts around y -1100
		if(local.pl == NULL || local.pl.origin[1] > (0 - 900)){
			wait 1
			continue
		}

		//a short burst of strikes rather than one lonely splash
		local.k = 0
		local.shots = 1 + (randomint 3)
		while(local.k < local.shots){
			local.p = (0 0 0)
			local.p[0] = local.pl.origin[0] + ((randomint 460) - 230)
			local.p[1] = local.pl.origin[1] + ((randomint 460) - 230)
			local.p[2] = 0 - 496
			//[user 2026-08-31] SILENT effect, deliberately. fx_mortar_water plays arty_exp_water on
			//every single spawn - at 2-6 strikes per burst on a loop that turned the run-in into a
			//continuous shell track and made rifle fire sound like artillery. fx_water_spray carries no
			//sound at all and is the right size for a round going into the water.
			local.w = spawn script_model model "models/animate/fx_water_spray.tik"
			if(local.w != NULL && local.w != NIL){			//entity-pool guard
				local.w.origin = local.p
				local.w notsolid
				local.w scale 0.5
				local.w anim start
				thread coop_fxCleanup local.w 1.1
			}
			wait ( 0.14 + ( randomfloat 0.26 ) )
			local.k++
		}
		wait ( 2.2 + ( randomfloat 3.4 ) )
	}
}end

//Allied return fire walking over the bluff and the emplacements, all mission long.
//=========================================================================
coop_returnFire:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_returnFireOn == NIL){ level.coop_returnFireOn = 1 }
	if(!level.coop_returnFireOn){ end }

	//aim at the emplacements themselves so the fire reads as directed, not decorative
	local.n = 0
	if($mg42_leftbunker1 != NULL){ local.n++; local.t[local.n] = $mg42_leftbunker1 }
	if($mg42_leftbunker2 != NULL){ local.n++; local.t[local.n] = $mg42_leftbunker2 }
	if($mg42_rightbunker1 != NULL){ local.n++; local.t[local.n] = $mg42_rightbunker1 }
	if($mg42_rightbunker2 != NULL){ local.n++; local.t[local.n] = $mg42_rightbunker2 }
	if($mg42_middle1 != NULL){ local.n++; local.t[local.n] = $mg42_middle1 }
	if($mg42_middle2 != NULL){ local.n++; local.t[local.n] = $mg42_middle2 }
	if($mg42_left1 != NULL){ local.n++; local.t[local.n] = $mg42_left1 }
	if($mg42_right1 != NULL){ local.n++; local.t[local.n] = $mg42_right1 }
	if(local.n < 1){
		println("^~^~^ RETURNFIRE no emplacements")
		end
	}
	println("^~^~^ RETURNFIRE targets=" + local.n)

	while(level.coop_returnFireOn){
		local.tgt = local.t[((randomint local.n) + 1)]
		if(local.tgt == NULL){
			wait 1
			continue
		}
		//a burst walking across one position
		local.k = 0
		local.shots = 2 + (randomint 3)
		while(local.k < local.shots){
			local.p = local.tgt.origin
			local.p[0] = local.p[0] + ((randomint 300) - 150)
			local.p[1] = local.p[1] + ((randomint 220) - 110)
			local.p[2] = local.p[2] + ((randomint 90) - 20)
			//silent - see the note in coop_waterShots. dudimpact is a round striking dirt and carries
			//no sound, so a hundred of them a minute do not become an artillery barrage.
			local.d = spawn script_model model "models/fx/dudimpact.tik"
			if(local.d != NULL && local.d != NIL){
				local.d.origin = local.p
				local.d notsolid
				local.d anim start
				thread coop_fxCleanup local.d 1.4
			}
			wait ( 0.13 + ( randomfloat 0.22 ) )
			local.k++
		}
		wait ( 2.0 + ( randomfloat 3.0 ) )
	}
}end

//Explosions inland, past the sea wall - the fight carrying on above and behind the bluff.
//=========================================================================
coop_inlandBlasts:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_inlandBlastsOn == NIL){ level.coop_inlandBlastsOn = 1 }
	if(!level.coop_inlandBlastsOn){ end }

	while(level.coop_inlandBlastsOn){
		local.p = (0 0 0)
		//past the shingle (y ~2900) and up onto the rising ground behind it
		local.p[0] = ( 0 - 2600 ) + (randomint 5600)
		local.p[1] = 3100 + (randomint 2400)
		local.p[2] = ( 0 - 380 ) + (randomint 460)

		local.e = spawn "models/animate/fx_mortar_dirt.tik"
		if(local.e != NULL && local.e != NIL){
			local.e.origin = local.p
			local.e notsolid
			local.e anim start
			thread coop_fxCleanup local.e 3.5
		}
		wait ( 2.4 + ( randomfloat 4.0 ) )
	}
}end

//The seawall beat: from the moment the shingle sequences start until the bangalores blow the wire,
//rounds hammer the sand and the shingle itself. This is the loudest, densest loop of the four and it
//is deliberately time-boxed - it ends when the wire goes.
//=========================================================================
coop_seawallFire:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_seawallFireOn == NIL){ level.coop_seawallFireOn = 1 }
	if(!level.coop_seawallFireOn){ end }

	//wait for the shingle sequences (9+) - that is the meet-the-captain beat
	local.t = 0
	while(local.t < 600){
		if(level.m3l1a_sequence != NIL && level.m3l1a_sequence >= 9){ break }
		wait 1
		local.t = local.t + 1
	}
	if(level.m3l1a_sequence == NIL || level.m3l1a_sequence < 9){ end }
	println("^~^~^ SEAWALLFIRE started")

	//...until the bangalores go. coop_flankMGDone is set by the last bangalore explosion.
	while(level.coop_flankMGDone != 1 && level.coop_seawallFireOn){
		local.k = 0
		local.shots = 3 + (randomint 4)
		while(local.k < local.shots){
			local.p = (0 0 0)
			local.p[0] = ( 0 - 1200 ) + (randomint 2200)
			local.p[1] = 2700 + (randomint 420)
			local.p[2] = 0 - 300
			//silent, same reason - this is the densest loop of the four and it runs right next to you.
			local.d = spawn script_model model "models/fx/dudimpact.tik"
			if(local.d != NULL && local.d != NIL){
				local.d.origin = local.p
				local.d notsolid
				local.d anim start
				thread coop_fxCleanup local.d 1.4
			}
			wait ( 0.12 + ( randomfloat 0.20 ) )
			local.k++
		}
		wait ( 1.3 + ( randomfloat 2.0 ) )
	}
	println("^~^~^ SEAWALLFIRE stopped")
}end

//Shared cleanup so none of the four loops leaks an effect entity.
//=========================================================================
coop_fxCleanup local.ent local.life:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end }
	wait local.life
	if(local.ent != NULL && local.ent != NIL){ local.ent remove }
}end


//=========================================================================
//[user 2026-08-31] FIRES UP AT THE BUNKERS - "there should be fires up around the bunkers too, should
//add some cinematic depth, use different types of fires please".
//
//DEPTH IS THE POINT, so the fires are deliberately MIXED and placed at several distances up the bluff
//rather than in one band. Six different emitters, all verified present and all carrying a real `start`
//animation (a TIKI without one is a silent no-op - that is what killed the first bunker-shelling
//attempt, bug-2195):
//    firegood                     bright close fire
//    fireandsmoke                 fire with its own smoke column
//    firesmoke                    smaller, smokier
//    tehao_firesmoke_long         tall column, reads at distance
//    tehao_firesmoke_superlong    the tallest - the far skyline
//    inferno_nosmoke              big flame with no smoke, so a near fire does not grey out the view
//
//Anchored on the real emplacements where possible so the fires sit ON the positions rather than in
//the air near them, then scattered up the bluff behind. Cosmetic: notsolid, no damage, lit once and
//left burning - no per-frame cost at all.
//=========================================================================
coop_bunkerFires:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_bunkerFiresOn == NIL){ level.coop_bunkerFiresOn = 1 }
	if(!level.coop_bunkerFiresOn){ end }

	local.ft[1] = "models/emitters/tehao_fire.tik"
	local.ft[2] = "models/emitters/fireandsmoke.tik"
	local.ft[3] = "models/emitters/firesmoke.tik"
	local.ft[4] = "models/emitters/tehao_firesmoke_long.tik"
	local.ft[5] = "models/emitters/tehao_firesmoke_superlong.tik"
	//[user 2026-09-02, bug-2382] "the fire that you are using on the bunkers looks terrible, change
	//it, and as a matter of fact if you are using that specific fire anywhere, change it as well
	//because its an awful emitter." That was firegood.tik, which was the first entry in this
	//rotation and the flame used by the boat burn and the Higgins wreck - every occurrence is now
	//tehao_fire.
	//
	//inferno_nosmoke goes too, for a separate reason found while checking the others: its `start`
	//animation carries `enter loopsound fire_med` INSIDE the TIKI, so every instance holds a sound
	//channel for as long as it burns. bug-2313 was five held fire channels on this map exhausting
	//the pool, and this would quietly reintroduce it.
	local.ft[6] = "models/emitters/tehao_firesmoke.tik"

	//--- on and around the emplacements themselves
	local.n = 0
	if($mg42_leftbunker1 != NULL){ local.n++; local.a[local.n] = $mg42_leftbunker1 }
	if($mg42_leftbunker2 != NULL){ local.n++; local.a[local.n] = $mg42_leftbunker2 }
	if($mg42_rightbunker1 != NULL){ local.n++; local.a[local.n] = $mg42_rightbunker1 }
	if($mg42_rightbunker2 != NULL){ local.n++; local.a[local.n] = $mg42_rightbunker2 }
	if($mg42_middle1 != NULL){ local.n++; local.a[local.n] = $mg42_middle1 }
	if($mg42_middle2 != NULL){ local.n++; local.a[local.n] = $mg42_middle2 }
	if($mg42_left1 != NULL){ local.n++; local.a[local.n] = $mg42_left1 }
	if($mg42_left2 != NULL){ local.n++; local.a[local.n] = $mg42_left2 }
	if($mg42_right1 != NULL){ local.n++; local.a[local.n] = $mg42_right1 }
	if($mg42_right2 != NULL){ local.n++; local.a[local.n] = $mg42_right2 }

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		if(local.a[local.i] != NULL){
			//[user 2026-09-01] ON TOP AND AROUND, NOT INSIDE. The user: "Instead of fires INSIDE the
			//bunkers maybe have them on top and all around the surrounding mountainous areas". These
			//were anchored to the MG's own origin at z-10 - which is the gun's eye height, inside the
			//embrasure, so every one of them burned in the room the gunner is standing in.
			//
			//Now: a much wider spread, pushed UPHILL (+Y is inland here), lifted 260 above the gun and
			//dropped onto whatever is under that - the casemate roof, the berm behind it, or the slope.
			//droptofloor rather than a guessed height, because the bluff is not flat and each of these
			//ten guns sits at a different elevation.
			//[user 2026-09-02, bug-2383] "that fire on the right bunker is floating by the way, it
			//should probably be either on top or beside of it instead."
			//
			//It was hung 260 units above the MG's own origin - a number picked to clear the gun,
			//which of course leaves it hanging in the air over open sand whenever the scatter lands
			//it off the bunker. Traced now: whatever the ray finds IS where the fire goes, so it
			//burns on the bunker roof when it lands on the roof and on the ground when it lands
			//beside it. Either is what the user asked for; hovering was the one thing that was not.
			local.p = local.a[local.i].origin
			local.p[0] = local.p[0] + ((randomint 900) - 450)
			local.p[1] = local.p[1] + 120 + (randomint 620)
			local.p[2] = local.p[2] + 260

			local.ftop = (0 0 0)
			local.ftop[0] = local.p[0]
			local.ftop[1] = local.p[1]
			local.ftop[2] = local.p[2] + 300
			local.fbot = (0 0 0)
			local.fbot[0] = local.p[0]
			local.fbot[1] = local.p[1]
			local.fbot[2] = local.p[2] - 700
			local.fhit = trace local.ftop local.fbot 1
			if(local.fhit == NIL){ continue }
			local.p[2] = local.fhit[2] + 6

			local.f = spawn local.ft[((randomint 6) + 1)]
			if(local.f != NULL && local.f != NIL){			//entity-pool guard
				local.f.origin = local.p
				local.f notsolid
				local.f droptofloor			//sit it on the roof or the slope, never in mid air
				local.f anim start
				//only the near ones carry a loop sound - ten looping fires up a hillside is mush
				//[user, bug-2313] fire loopsound removed - visual only, and it was holding a channel
				local.made++
			}
		}
		local.i++
	}

	//--- and scattered up the bluff behind them, for depth
	//[user 2026-09-01] "We have so much of the map we are underutilizing here for effects" - 10 -> 16,
	//over a wider band, so the whole face of the bluff is alight rather than a handful of dots. (Was 22
	//for one build; the user then asked to "chill out on some of the fire", and the bluff band is the
	//one that reads from the beach, so it keeps more of the increase than the hulls do.)
	local.k = 0
	while(local.k < 16){
		local.p = (0 0 0)
		//[bug-2383] same fix for the inland fires, which guessed an absolute height instead.
		local.p[0] = ( 0 - 3200 ) + (randomint 7000)
		local.p[1] = 4200 + (randomint 1700)
		local.p[2] = 120 + (randomint 300)
		local.gtop = (0 0 0)
		local.gtop[0] = local.p[0]
		local.gtop[1] = local.p[1]
		local.gtop[2] = local.p[2] + 400
		local.gbot = (0 0 0)
		local.gbot[0] = local.p[0]
		local.gbot[1] = local.p[1]
		local.gbot[2] = local.p[2] - 900
		local.ghit = trace local.gtop local.gbot 1
		if(local.ghit != NIL){ local.p[2] = local.ghit[2] + 6 }

		local.f = spawn local.ft[((randomint 6) + 1)]
		if(local.f != NULL && local.f != NIL){
			local.f.origin = local.p
			local.f notsolid
			local.f droptofloor			//sit them on the hillside, do not guess its height
			local.f anim start
			local.made++
		}
		local.k++
	}

	//--- a couple of tall columns further back still, so the skyline is not empty
	local.k = 0
	while(local.k < 3){
		local.p = (0 0 0)
		local.p[0] = ( 0 - 2600 ) + (randomint 5600)
		local.p[1] = 6200 + (randomint 900)
		local.p[2] = 200 + (randomint 260)
		local.f = spawn "models/emitters/tehao_firesmoke_superlong.tik"
		if(local.f != NULL && local.f != NIL){
			local.f.origin = local.p
			local.f notsolid
			local.f anim start
			local.made++
		}
		local.k++
	}

	println("^~^~^ BUNKERFIRE lit=" + local.made)
}end


//=========================================================================
//[user 2026-08-31] BLOOD ON THE WATER - "will the blood actually appear in the water? kinda like how
//we made the oil and water mix on the uboat explosion mission?"
//
//Yes, and now by BOTH routes, because neither alone does the job:
//
//  1. A blended stage inside scripts/zz_coop_shoreline.shader tints the whole waterline. That is the
//     one that covers everything and moves correctly, because it inherits the surface's own
//     deformVertexes flap - a separate entity cannot follow a per-vertex deform.
//  2. These planes, which are the u-boat recipe exactly: models/fx/coop_bloodslick.tik is a clone of
//     coop_oilslick.tik - same retail waterPlane mesh, same one-surface setup, our own shader over a
//     private texture path. They give discrete slicks with edges, which a flat tint cannot.
//
//WHY THEY SIT WHERE THEY DO. The shoreline's flap moves the water +/-8u at the far end of the band
//and +/-16u at the near end on a ~12.5s cycle, so a plane near shore would sink under the wash and
//surface through it every cycle. These are placed in the SEAWARD half of the band, where the same
//survey puts the deform at about +/-0.08u - small enough that a plane 2u above the surface stays on
//it. Heights come from the measured waterline: z = -520 + 0.0294*(y+2160).
//=========================================================================
coop_waterBlood:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_waterBloodOn == NIL){ level.coop_waterBloodOn = 1 }
	if(!level.coop_waterBloodOn){ end }

	local.n = 0
	local.n++; local.wbx[local.n] = 0 - 2919; local.wby[local.n] = 0 - 1835; local.wbz[local.n] = 0 - 504
	local.n++; local.wbx[local.n] = 175; local.wby[local.n] = 0 - 1553; local.wbz[local.n] = 0 - 496
	local.n++; local.wbx[local.n] = 1989; local.wby[local.n] = 0 - 2033; local.wbz[local.n] = 0 - 510
	local.n++; local.wbx[local.n] = 3181; local.wby[local.n] = 0 - 2012; local.wbz[local.n] = 0 - 510
	local.n++; local.wbx[local.n] = 1228; local.wby[local.n] = 0 - 1963; local.wbz[local.n] = 0 - 508
	local.n++; local.wbx[local.n] = 913; local.wby[local.n] = 0 - 2088; local.wbz[local.n] = 0 - 512
	local.n++; local.wbx[local.n] = 0 - 2296; local.wby[local.n] = 0 - 1691; local.wbz[local.n] = 0 - 500
	local.n++; local.wbx[local.n] = 0 - 165; local.wby[local.n] = 0 - 1455; local.wbz[local.n] = 0 - 493
	local.n++; local.wbx[local.n] = 1420; local.wby[local.n] = 0 - 1777; local.wbz[local.n] = 0 - 503
	local.n++; local.wbx[local.n] = 3160; local.wby[local.n] = 0 - 1916; local.wbz[local.n] = 0 - 507
	local.n++; local.wbx[local.n] = 550; local.wby[local.n] = 0 - 1810; local.wbz[local.n] = 0 - 504
	local.n++; local.wbx[local.n] = 1109; local.wby[local.n] = 0 - 1786; local.wbz[local.n] = 0 - 503
	local.n++; local.wbx[local.n] = 3116; local.wby[local.n] = 0 - 1667; local.wbz[local.n] = 0 - 500
	local.n++; local.wbx[local.n] = 0 - 448; local.wby[local.n] = 0 - 1780; local.wbz[local.n] = 0 - 503
	local.n++; local.wbx[local.n] = 1116; local.wby[local.n] = 0 - 1658; local.wbz[local.n] = 0 - 499
	local.n++; local.wbx[local.n] = 2688; local.wby[local.n] = 0 - 1984; local.wbz[local.n] = 0 - 509
	local.n++; local.wbx[local.n] = 1307; local.wby[local.n] = 0 - 2128; local.wbz[local.n] = 0 - 513
	local.n++; local.wbx[local.n] = 331; local.wby[local.n] = 0 - 2045; local.wbz[local.n] = 0 - 511
	local.n++; local.wbx[local.n] = 0 - 1982; local.wby[local.n] = 0 - 1825; local.wbz[local.n] = 0 - 504
	local.n++; local.wbx[local.n] = 1522; local.wby[local.n] = 0 - 1897; local.wbz[local.n] = 0 - 506
	local.n++; local.wbx[local.n] = 0 - 1248; local.wby[local.n] = 0 - 1974; local.wbz[local.n] = 0 - 509
	local.n++; local.wbx[local.n] = 0 - 2487; local.wby[local.n] = 0 - 1536; local.wbz[local.n] = 0 - 496
	local.n++; local.wbx[local.n] = 0 - 1050; local.wby[local.n] = 0 - 1672; local.wbz[local.n] = 0 - 500
	local.n++; local.wbx[local.n] = 0 - 552; local.wby[local.n] = 0 - 1955; local.wbz[local.n] = 0 - 508

	local.i = 1
	local.made = 0
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.wbx[local.i]
		local.p[1] = local.wby[local.i]
		local.p[2] = local.wbz[local.i]

		local.b = spawn "models/fx/coop_bloodslick.tik"
		if(local.b != NULL && local.b != NIL){			//entity-pool guard
			local.b.origin = local.p
			local.b.angles = (0 (randomint 360) 0)
			//wider than the sand pools - blood spreads on water
			//[user 2026-08-31] 0.6-1.7 was invisible at this range. Blood spreads far on water.
		//[user 2026-08-31] TRIMMED. 44 planes at 1.6-3.8 on top of the shader wash read as a red
		//filter rather than as blood. These now carry only the DISCRETE mid-water slicks; the
		//shoreline shader's own stage handles the water's edge, where it can inherit the deform
		//flap that a separate plane cannot follow.
		local.b scale (1.3 + (randomfloat 1.6))
			local.b notsolid
			local.made++
		}
		local.i++
	}
	println("^~^~^ WATERBLOOD slicks=" + local.made)
}end


//=========================================================================
//[user 2026-08-31] AMBIENT BEACH VIGNETTES - m3l1a only.
//
//User: "add characters that do scripted things along the beaches... what are scripts we can have them
//play out on repeat?" Men doing recognisable human things on loop, so Omaha reads as populated rather
//than merely decorated.
//
//THE TRAP THAT DECIDES EVERY NAME BELOW (tiki_files.cpp:1046-1057): an animation alias flagged
//`random` has its TRAILING DIGITS STRIPPED at load. So shingle_idle01 DOES NOT EXIST at runtime -
//shingle_idle does, and the engine picks one of its six members per actor. Same for
//crouch_beach_idle, stand_beach_idle, stand_water_idle, prone_beach_idle and fallen. Everything NOT
//flagged random keeps its exact name: medic01, patient01, hedge_shake01/02/03, hedge_look01/02,
//hedge_dodge01/02/03, shingle_idle_lookat, shingle_coveridle_bang, radioman, rifle_looking, and all
//the drag_* clips. Get it backwards in either direction and you get a SILENT no-op - the same class
//of failure that made the first bunker shelling invisible (bug-2195).
//
//Everything here is declared in level_m3l1.tik or fallen.tik, both already loaded on this map via
//new_generic_human.tik's `includes m3l1a` block. NO tik edit is required - and nothing here may ever
//be called from shared coop code, because on any other map these aliases do not exist.
//
//NO TARGETNAMES ANYWHERE (bug-2194): every actor is held in a local and never dereferenced by name,
//and every keeper is launched as `local.a thread ...` so it receives the actor as self.
//=========================================================================
coop_beachVignettes:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_vignettesOn == NIL){ level.coop_vignettesOn = 1 }
	if(!level.coop_vignettesOn){ end }
	//exactly one stager, ever - two threads racing over one pair is what froze the retail medic and
	//his patient mid-animation forever (bug-2188)
	if(level.coop_vigDone == 1){ end }
	level.coop_vigDone = 1

	//[user 2026-08-31] 24 -> 30 for the six wounded added at the end of this thread (B5).
	//[user, bug-2269] FEWER. "theres an alarming amount of allies just standing on the beach doing
	//nothing under fire". Between the vignettes, the wreck crews, the flank landings, the pre-spawned
	//shingle rangers and the work party this layer had put roughly eighty allied actors on and around
	//the sand, most of them holding a pose. Posed men are scenery and scenery does not need to be
	//numerous - a dozen good ones read as a battlefield, forty read as a crowd standing about.
	//[user 2026-09-01, bug-2293] 14 -> 26. The live log read VIGNETTES actors=40/40 every boot - the cap
	//was saturated, so any scene added later was silently getting nothing. It was set low because the
	//entity pool was exhausting at 2046/2048; that pool is now 4096, and the user's call was to raise it
	//rather than cut content.
	if(level.coop_vigCap == NIL){ level.coop_vigCap = 26 }
	level.coop_vigMade = 0

	//---------------- A1: the medic who is losing him (LOOP, zero threads)
	local.i = 0
	while(local.i < 2){
		local.p = (0 0 0)
		local.q = (0 0 0)
		if(local.i == 0){
			local.p[0] = 0 - 2840
			local.p[1] = 0 - 448
			local.p[2] = 0 - 488
			local.q[0] = 0 - 2888
			local.q[1] = 0 - 468
			local.q[2] = 0 - 488
		}else{
			local.p[0] = 2232
			local.p[1] = 1048
			local.p[2] = 0 - 455
			local.q[0] = 2184
			local.q[1] = 1028
			local.q[2] = 0 - 455
		}
		local.pat = waitthread coop_vigSpawn "models/human/dday_29th_private_patient" "none" local.p 0
		local.med = waitthread coop_vigSpawn "models/human/dday_ranger_medic" "none" local.q 90
		if(local.pat != NULL && local.pat != NIL && local.med != NULL && local.med != NIL){
			local.pat setsynctime 0
			local.med setsynctime 0
			local.pat thread coop_vigHold "patient01"
			if(local.i == 0){ local.med thread coop_vigHold "medic01" }
			else{ local.med thread coop_vigHold "medic02" }
		}
		local.i++
	}

	//---------------- A2: the line that is not going anywhere (LOOP, zero threads)
	local.n = 0
	local.n++; local.sx[local.n] = 0 - 1396
	local.n++; local.sx[local.n] = 0 - 1576
	local.n++; local.sx[local.n] = 0 - 1756
	local.n++; local.sx[local.n] = 1156
	local.n++; local.sx[local.n] = 1336
	local.n++; local.sx[local.n] = 1516

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.sx[local.i]
		local.p[1] = 2860
		local.p[2] = 0 - 400
		local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "m1 garand" local.p 90
		if(local.a != NULL && local.a != NIL){
			if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.a turnto $mg42_middle1 }
			//shingle_idle is the TRIMMED base of six members, so each man draws a different clip and
			//a different cycle length and the row never syncs up
			if(local.i == 1){ local.a thread coop_vigHold "shingle_idle_lookat" }
			else if(local.i == 4){ local.a thread coop_vigHold "shingle_coveridle_bang" }
			else{ local.a thread coop_vigHold "shingle_idle" }
		}
		local.i++
	}

	//---------------- A3: the ones who stopped - alive, not corpses (LOOP, zero threads)
	local.p = (0 0 0)
	local.p[0] = 0 - 2340
	local.p[1] = 1180
	local.p[2] = 0 - 385
	//[bug-2288] a man holding a firing position needs the rifle the pose assumes
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.p (randomint 360)
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "prone_beach_idle" }

	local.p = (0 0 0)
	local.p[0] = 2110
	local.p[1] = 160
	local.p[2] = 0 - 314
	local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "none" local.p (randomint 360)
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "crouch_beach_idle" }

	local.p = (0 0 0)
	local.p[0] = 0 - 3160
	local.p[1] = 0 - 1230
	local.p[2] = 0 - 510
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p (randomint 360)
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "crouch_beach_idle" }

	//---------------- A4: standing in the surf, not advancing (LOOP, zero threads)
	local.p = (0 0 0)
	local.p[0] = 0 - 2736
	local.p[1] = 0 - 1984
	local.p[2] = 0 - 581
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.p 90
	if(local.a != NULL && local.a != NIL){
		if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.a turnto $mg42_middle1 }
		local.a thread coop_vigHold "crouch_beach_idle"
	}

	local.p = (0 0 0)
	local.p[0] = 2344
	local.p[1] = 0 - 1872
	local.p[2] = 0 - 574
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.p 90
	if(local.a != NULL && local.a != NIL){
		if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.a turnto $mg42_middle1 }
		local.a thread coop_vigHold "crouch_beach_idle"
	}

	//---------------- A5: the man who will not move (LOOP, zero threads)
	local.p = (0 0 0)
	local.p[0] = 0 - 2240
	local.p[1] = 291
	local.p[2] = 0 - 486
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 90
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "hedge_shake03" }

	local.p = (0 0 0)
	local.p[0] = 2534
	local.p[1] = 0 - 200
	local.p[2] = 0 - 486
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 90
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "hedge_shake02" }

	//---------------- B1: peering round the obstacle and flinching back (one keeper)
	local.p = (0 0 0)
	local.p[0] = 2678
	local.p[1] = 944
	local.p[2] = 0 - 478
	local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "m1 garand" local.p 90
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigKeep "hedge" }

	//---------------- B2: the radio operator calling for fire (one keeper)
	//gun "none" is MANDATORY - radio_backpack.skd only attaches under weapon "none"/"colt 45", so with
	//any other loadout there is no radio and the pose reads as nothing. Retail spawns him the same way.
	local.p = (0 0 0)
	local.p[0] = 0 - 2480
	local.p[1] = 820
	local.p[2] = 0 - 430
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private_radio" "none" local.p 45
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigKeep "radio" }

	//---------------- B3: a man watching the bluff, then holding (one keeper)
	local.p = (0 0 0)
	local.p[0] = 2760
	local.p[1] = 1420
	local.p[2] = 0 - 420
	local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "m1 garand" local.p 0
	if(local.a != NULL && local.a != NIL){
		if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.a turnto $mg42_middle1 }
		local.a thread coop_vigKeep "looking"
	}

	//---------------- B4: a man going down to his knees, over and over (one keeper)
	//`fallen` is the trimmed base of fallen01/02/03 and is NOT a loop - it freezes on its last frame,
	//so it MUST be re-issued by a keeper. That is exactly the freeze bug-2188 shipped once already.
	local.p = (0 0 0)
	local.p[0] = 0 - 1980
	local.p[1] = 1760
	local.p[2] = 0 - 400
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p (randomint 360)
	if(local.a != NULL && local.a != NIL){ local.a.coop_vigOwned = 1; local.a thread coop_vigKeep "fallen" }


	//---------------- B5: THE WOUNDED (LOOP, zero threads)
	//[user 2026-08-31] Every stopped man on this beach until now has been standing, crouching or
	//lying still. Nobody was visibly IN PAIN, and an unattended casualty - a man down with no
	//medic working on him - is the one casualty state the beach did not have.
	//
	//unarmed_pain_flooridle and unarmed_pain_kneesidle are declared in human_unarmed.tik and reach
	//this map through new_generic_human.tik's includes. Both .skc carry header flag 0x20, which
	//fgame reads as ANIM_LOOP - so anim.scr takes its pause branch and they loop with NO keeper
	//thread at all. Verified by reading the SKC headers out of the pak, not assumed.
	//
	//DO NOT substitute riflep_flooridle / riflep_kneesidle. Same poses, but their flags word is
	//0x00: they play once and freeze on the last frame, which is the bug-2188 failure exactly.
	//
	//setsynctime IS MANDATORY HERE. Both clips are 26 frames at 0.1s = 2.60s, identical length,
	//so six men spawned in the same frame writhe in perfect unison - and mixing the two clips
	//does not help, because they are the same length. A random phase per man is what breaks it.

	local.p = (0 0 0)
	local.p[0] = 0 - 1180
	local.p[1] = 0 - 430
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 40
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_flooridle"
		local.a setsynctime ( randomfloat 1 )
	}

	local.p = (0 0 0)
	local.p[0] = 610
	local.p[1] = 0 - 980
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 200
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_kneesidle"
		local.a setsynctime ( randomfloat 1 )
	}

	local.p = (0 0 0)
	local.p[0] = 1880
	local.p[1] = 340
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 115
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_flooridle"
		local.a setsynctime ( randomfloat 1 )
	}

	local.p = (0 0 0)
	local.p[0] = 0 - 2010
	local.p[1] = 880
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 300
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_kneesidle"
		local.a setsynctime ( randomfloat 1 )
	}

	local.p = (0 0 0)
	local.p[0] = 120
	local.p[1] = 1460
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 75
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_flooridle"
		local.a setsynctime ( randomfloat 1 )
	}

	local.p = (0 0 0)
	local.p[0] = 2460
	local.p[1] = 0 - 1180
	local.p[2] = 200
	local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.p 250
	if(local.a != NULL && local.a != NIL){
		local.a thread coop_vigHold "unarmed_pain_kneesidle"
		local.a setsynctime ( randomfloat 1 )
	}

	println("^~^~^ VIGNETTES actors=" + level.coop_vigMade + "/" + level.coop_vigCap)
}end

//Spawns one ambient actor: AI off, unshootable, unaggroable, invisible to objectives, dropped onto
//the ground rather than placed at a guessed height. Returns the actor, or NULL if the cap or the
//entity pool says no.
//=========================================================================
coop_vigSpawn local.model local.gun local.pos local.yaw local.job:{
//=========================================================================
	if(level.coop_vigMade >= level.coop_vigCap){ end NULL }

	local.a = spawn local.model gun local.gun
	if(local.a == NULL || local.a == NIL){ end NULL }		//entity-pool guard
	level.coop_vigMade++

	local.a exec global/disable_ai.scr
	local.a.coop_noChatter = 1
	local.a threatbias ignoreme
	local.a notarget 1
	local.a dontdropweapons
	local.a nodamage
	local.a notsolid
	//isinsequence/isbusy keep every coop sweeper and the map's own todo system away from them
	local.a.isinsequence = 1

	//[user 2026-09-03] NEVER STAND UP BETWEEN POSES. This is the mechanism behind six failed
	//attempts at "allies just stand around", and it lives in the engine, not in this script.
	//
	//Actor::FinishedAnimation_Anim (actor_anim.cpp:70-83) runs on EVERY animdone:
	//    if (m_bAnimScriptSet) return;
	//    if (m_bNoIdleAfterAnim) { m_csAnimScript = STRING_ANIM_CONTINUE_LAST_ANIM_SCR; }
	//    else                    { SetThinkIdle(THINK_IDLE); }
	//With no_idle == 0 - which is what every american actor on this beach had, 1126 of 1126 samples,
	//and the string `no_idle` appears NOWHERE in m3l1a.scr or this file - the engine routes the man
	//into anim/idle.scr -> anim/stand.scr, whose first statement is `self.position = stand`. So every
	//ONE-SHOT pose we play ends with the engine standing him up for the gap before the next one, with
	//a 0.5s stand blend. That is bug-2348's report verbatim ("cycling through animations ... pointing
	//and aiming and then going down into the injured stance").
	//
	//Retail gets away with the same bare `anim` idiom because retail's beach poses are overwhelmingly
	//LOOPING aliases that never fire animdone at all. The coop layer added the one-shots and did not
	//add the no_idle that retail's own global/turret.scr:319 and global/cardgame.scr:191 use for
	//exactly this case.
	//
	//SAFE ON THIS POPULATION SPECIFICALLY: no_idle is also read as a "leave this man alone" marker by
	//coop_variantRoll (aihandler.scr:1823) and by the chatter gates (aivoice.scr:315,
	//flchatter.scr:217) - but these actors already carry coop_noChatter = 1 (line 3490 above) and
	//`threatbias ignoreme`, so both were already true for them and nothing new is suppressed.
	//DELIBERATELY NOT APPLIED to the retail-spawned men coop_vigHold borrows - that WOULD newly mute
	//them, and it is a separate decision needing its own playtest.
	local.a.no_idle = 1
	//[user 2026-09-01, bug-2294] AND MARKED AS OURS. This line and coop_vigHold's yield guard were in
	//direct contradiction: we stamp .isbusy to keep retail's ai_execute_todo off our actors, and
	//coop_vigHold reads .isbusy as "the map has claimed him, let go". So every actor this function
	//spawned tripped that guard on coop_vigHold's FIRST loop iteration and ended before reaching
	//`self anim` - the pose never played a single frame. That is why ~40 men stood at attention on the
	//beach no matter how many times the poses themselves were fixed: the general mechanism the whole
	//file was refactored onto (bug-2281) was a no-op on exactly the actors it was written for.
	//
	//coop_vigOwned distinguishes the two cases. Retail-spawned actors ($shingle_wave*, taken by
	//targetname at ~4789) do NOT carry it, so they still yield the moment the map's todo system wants
	//them - which is the only thing the guard was ever protecting.
	local.a.coop_vigOwned = 1

	//[user 2026-09-02, bug-2326] REGISTERED, so the sweeper can find him again. See coop_idleSweeper.
	if(level.coop_actN == NIL){ level.coop_actN = 0 }
	level.coop_actN++
	level.coop_actList[level.coop_actN] = local.a
	local.a.coop_hb = level.time
	local.a.isbusy = 1

	local.ang = (0 0 0)
	local.ang[1] = local.yaw
	local.a.angles = local.ang
	local.a.origin = local.pos + (0 0 90)
	//[user 2026-09-01, bug-2255] dry ground, not just "the floor" - see coop_dryGround. A vignette man
	//standing on the seabed is worse than no vignette man, so a failure here removes him and returns
	//NULL, and the counter is given back so the slot is not wasted.
	if(!waitthread coop_dryGround local.a){
		level.coop_vigMade--
		end NULL
	}

	//[bug-2281] THE DEFAULT IS NOT "STAND". Every posed actor on this beach comes through here, so this
	//is the one place that can guarantee the user's rule. He is started on the beach's default
	//behaviour immediately; a caller with a real job for him just threads over the top, and
	//coop_vigHold marks him owned so the two do not fight.
	//[user 2026-09-01, bug-2305] A CALLER WITH A REAL JOB FOR HIM WINS THE RACE DETERMINISTICALLY.
	//coop_beachBehave was threaded here as this function's LAST act, while a job thread sets
	//coop_behaveOff on ITS own first line - so which of the two ran first was down to the scheduler.
	//coop_beachBehave's guard sits INSIDE its loop, so when it won it picked a branch before ever
	//yielding, and one branch in twelve is `exec global/enable_ai.scr` + coop_chargeRun, which never
	//gives the actor back. Roughly one man in sixteen wandered off his post and died on a charge he
	//was never meant to join - the firing line losing men to nothing, welders abandoning their tank
	//traps. Passing job 1 closes it at the source. Under-supplied args are NIL, so every existing
	//caller is unaffected.
	if(local.job == 1){ local.a.coop_behaveOff = 1 }

	//[user 2026-09-02, bug-2368] "more of the enemies you spawned in that fire back should get
	//killed... ive told you this before." They had, and I had only half-fixed it: I raised the rate
	//on coop_firingLineCutDown, which is attached at exactly TWO call sites. But roughly eight of
	//the beach vignettes spawn a man WITH A RIFLE through here - coopified.scr:3190, 3208, 3230,
	//3240, 3266, 3284 among them - and not one of those had any death path at all. Those are the
	//men firing back that never fall, and no amount of tuning the other two sites could reach them.
	//
	//So the cut-down is attached HERE, where every armed actor on this beach is made, which also
	//means the next one anybody adds is covered without having to remember. A man with no gun is a
	//stretcher-bearer or a casualty and is left alone.
	//
	//coop_vigSpawn hands out `nodamage` above - the right default for a man holding a pose - so it
	//has to be undone here or bhit is absorbed and he just stands there being shot at.
	if(local.gun != "none" && local.gun != NIL){
		if((randomint 2) == 0){
			local.a takedamage
			local.a.coop_cutAnyway = 1
			local.a thread coop_firingLineCutDown
		}
	}

	local.a thread coop_beachBehave
	end local.a
}end

//One keeper thread, self is the actor, and it dies with him. Retail's own shape
//(m3l1a.scr:4470-4481): while(isalive self). Liveness is re-checked after EVERY yield, because a
//yield is where the actor can be removed out from under the thread.
//=========================================================================
coop_vigKeep local.mode:{
//=========================================================================
	while(isalive self){
		if(local.mode == "hedge"){
			//the four hedge clips retail never touches, so this man reads as a different person
			//from the A5 pair standing a few hundred units away
			self anim hedge_look01
			self waittill animdone
			if(!isalive self){ end }
			self anim hedge_dodge01
			self waittill animdone
			if(!isalive self){ end }
			self anim hedge_shake01
			self waittill animdone
			if(!isalive self){ end }
			self anim hedge_dodge02			//LOOP - he settles into a shake
			wait ( ( randomint 6 ) + 6 )
		}
		else if(local.mode == "radio"){
			self anim radioman				//one-shot, 8.42s
			self waittill animdone
			if(!isalive self){ end }
			wait ( 2 + ( randomfloat 3 ) )
		}
		else if(local.mode == "looking"){
			self anim rifle_looking			//one-shot, 10.07s
			self waittill animdone
			if(!isalive self){ end }
			//[user] crouched, not standing - "theres an alarming amount of allies just standing on the
			//beach doing nothing under fire". Same loop, lower silhouette.
			self anim crouch_beach_idle		//LOOP - he holds and watches
			wait ( 6 + ( randomfloat 6 ) )
		}
		else if(local.mode == "fallen"){
			self anim fallen				//trimmed base of fallen01/02/03, NOT a loop
			self waittill animdone
			if(!isalive self){ end }
			wait ( ( randomint 10 ) + 15 )
		}
		else{ end }
	}
}end


//=========================================================================
//[user 2026-08-31] THE FLANKS - "I dont see any guys moving up the far sides of the left and right
//beach (the out of bounds areas for the players)... or higgins boats landed on those sides".
//
//coop_farBattle already put boats on both flanks, but it put them OUT TO SEA (y -3800..-5500), which
//is behind you - you have to turn around and look at the horizon to find them. This is the other
//thing: landings on the same stretch of sand you are on, just past the corridor you can walk.
//
//WHERE. The map's statics run x -4419..3854, and the walkable corridor is roughly x -1400..1900, so
//the flanks are x -4100..-2300 and x 2400..3700 at beach y. Everything here stays inside the built
//extent - the previous flank attempt sat at |x| 4600-5600, outside the world, which is why it
//looked like it was floating in nothing.
//
//WHY THESE MEN USE runto AND THE VIGNETTES DO NOT. coop_vigSpawn calls disable_ai, which is right for
//a man playing one loop on the spot and wrong here: the AI is what moves an actor, so these keep it.
//They are neutered - threatbias ignoreme, notarget, notsolid - so they cannot be shot at, cannot block
//you, and cannot be picked up by any coop sweeper.
//
//[user 2026-09-01, bug-2246] THEY MOVE VIA A WAYPOINT, AND THAT IS THE WHOLE FIX.
//
//The user: "I see tons of our spawned actors just standing around in the higgin boats not doing
//anything at all". They were. The previous note here claimed "runto takes a VECTOR as well as a
//pathnode... over open sand the AI's direct-path check carries them". That is FALSE, and the log said
//so plainly - eighteen lines of
//    ^~^~^ Path not found in 'Actor::MoveToPatrolCurrentNode' for (entnum 1038..1055 ...)
//one per flank man, every leg, forever.
//
//Actor::MoveTo (fgame/actor.cpp:4667) turns a bare vector into a patrol node, and
//MoveToPatrolCurrentNode has TWO branches. The vector branch calls SetPath(), which is a graph search
//over the baked pathnodes - and the out-of-bounds sand carries none, so PathExists() is false and the
//actor is put straight into Anim_Idle. It never took a step. The other branch fires when the target
//IsSubclassOfWaypoint: that one calls SetDest() + ANIM_MODE_DEST, which MoveDest()s straight at the
//point with no graph at all (actor.cpp:3998). So: give each man his own spawned info_waypoint, move
//the waypoint, and runto THAT. No pathnodes needed anywhere - which also answers the user's "let me
//know if we need nodes": we do not, on the flanks or anywhere else this trick is used.
//
//The stuck watchdog below is KEPT even though the cause it was written for is gone - sand is uneven
//and a man can still wedge on a beach obstacle.
//=========================================================================
coop_flankLandings:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_flankLandOn == NIL){ level.coop_flankLandOn = 1 }
	if(!level.coop_flankLandOn){ end }

	//--- boats already ashore on both flanks, ramps down -------------------------------------
	local.n = 0
	local.n++; local.bx[local.n] = 0 - 3850; local.by[local.n] = 0 - 1520; local.bs[local.n] = 0
	local.n++; local.bx[local.n] = 0 - 3150; local.by[local.n] = 0 - 1180; local.bs[local.n] = 1
	local.n++; local.bx[local.n] = 0 - 2560; local.by[local.n] = 0 - 1640; local.bs[local.n] = 0
	local.n++; local.bx[local.n] = 2620; local.by[local.n] = 0 - 1240; local.bs[local.n] = 0
	local.n++; local.bx[local.n] = 3180; local.by[local.n] = 0 - 1600; local.bs[local.n] = 1
	local.n++; local.bx[local.n] = 3620; local.by[local.n] = 0 - 1120; local.bs[local.n] = 0

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.bx[local.i]
		local.p[1] = local.by[local.i]
		//the retail higgins waterline, read off higgins3_model rather than guessed
		local.p[2] = 0 - 544

		local.h = spawn script_model model "models/vehicles/higginslite_soldiers.tik"
		if(local.h != NULL && local.h != NIL){			//entity-pool guard
			local.h.origin = local.p
			local.h.angles = (0 90 0)
			local.h notsolid
			if(local.bs[local.i]){
				//two of the six are wrecks, burning where they grounded
				local.h model "models/vehicles/higgins_damage.tik"
				//[user 2026-09-01] AND THEY LOOK LIKE THEY RAN AGROUND. "Some of these destroyed higgins
				//boats could be angled/flipped, etc like they ran aground if damaged." A wreck sitting
				//dead level on the sand at the same yaw as the intact boats beside it reads as a texture
				//swap; slewed off the beach axis and heeled over, it reads as a hull that broached.
				local.h.angles = ( ( ( randomint 26 ) - 13 ) ( 90 + ( ( randomint 70 ) - 35 ) ) ( ( randomint 46 ) - 23 ) )
				thread coop_boatBurn local.p
			}else{
				//ramp down and empty - the crew is the column walking away from it
				local.h anim removeguys
			}
			local.made++
		}
		local.i++
	}

	//--- and men walking up off them ---------------------------------------------------------
	//Two columns a side. Each man starts near his boat and works up the sand; when he passes the
	//shingle line he is put back at the water, so the flanks never empty out over a long mission.
	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 12 }

	local.men = 0
	local.i = 1
	while(local.i <= local.n){
		local.k = 0
		while(local.k < 2){
			//[user 2026-09-01] IN FRONT OF THE RAMP, NOT IN THE HULL. The old spread was +120..+380
			//on Y with a +/-130 X jitter, which straddles a 260-unit-wide boat - so droptofloor, which
			//stops on the first solid under the feet, was landing men ON THE DECK. The user: "some
			//standing on top of the higgins boats". Start them a clear boat-length ahead of the bow.
			local.p = (0 0 0)
			local.p[0] = local.bx[local.i] + ((randomint 300) - 150)
			local.p[1] = local.by[local.i] + 300 + (randomint 320)
			local.p[2] = 0 - 500

			local.mdl = "models/human/dday_29th_private"
			if((randomint 2) == 0){ local.mdl = "models/human/dday_ranger_private" }

			local.a = spawn local.mdl gun "m1 garand"
			if(local.a != NULL && local.a != NIL){		//entity-pool guard
				//neutered, but AI LEFT ON - see the note above, the AI is what walks them
				local.a.coop_noChatter = 1
				local.a threatbias ignoreme
				local.a notarget 1
				local.a dontdropweapons
				local.a notsolid
				local.a.isinsequence = 1
				local.a.isbusy = 1
				local.a.origin = local.p + (0 0 80)
				if(!waitthread coop_dryGround local.a){ local.a = NULL }

				//[user 2026-09-01] "some should get instantly slaughtered by MG fire and it should be
				//extremely brutal deaths". One in three never makes the shingle. They keep takedamage
				//so the map's OWN kill recipe works on them - see coop_flankCutDown.
				//1 in 4, not 1 in 3 - see the staggering note in coop_flankCutDown. Six deaths spread
				//over three minutes reads as attrition; eight in four seconds read as a bug, which is
				//exactly how the user reported it.
				if(local.a != NULL && local.a != NIL){
					//[bug-2368] 1-in-4 -> 2-in-3. Twelve men rode in on the flanks and three died.
					if((randomint 3) < 2){
						local.a thread coop_flankCutDown
					}else{
						local.a nodamage
						local.a thread coop_flankWalk local.bx[local.i] local.by[local.i]
					}
					local.men++
				}
			}
			local.k++
		}
		local.i++
	}

	println("^~^~^ FLANKLAND boats=" + local.made + " men=" + local.men)
}end

//One man working his way up an out-of-bounds flank, forever. local.hx/local.hy is the boat he came
//off, which is also where he is put back when he reaches the top or gets stuck.
//=========================================================================
coop_flankWalk local.hx local.hy:{
//=========================================================================
	//HIS OWN DESTINATION MARKER. One info_waypoint per man, spawned once and moved - not one per leg,
	//which would be a spawn every three seconds for the whole mission. Waypoint is the class that
	//sends Actor down the direct-move branch (see the note above coop_flankLandings).
	local.wp = spawn info_waypoint
	if(local.wp == NULL || local.wp == NIL){ end }		//entity-pool guard

	local.last = self.origin
	local.stuck = 0

	while(isalive self && level.coop_flankLandOn){
		//a short bound up the beach, not a march to the far end
		//[bug-2290] and it is ROUTED now, with the marker's z read off the ground rather than copied
		//off the man. `local.t[2] = self.origin[2]` was the buried marker in its most explicit form.
		local.g = (0 0 0)
		local.g[0] = self.origin[0] + ((randomint 420) - 210)
		local.g[1] = self.origin[1] + 1200
		local.g[2] = self.origin[2]
		local.moved = waitthread coop_advanceLeg self local.wp local.g ( 260 + (randomint 100) ) 34
		if(local.moved == 0){ wait 0.6 }

		wait ( 2 + ( randomfloat 2 ) )
		if(!isalive self){ break }
		waitthread coop_underCheck self
		if(!isalive self){ break }

		//STUCK CHECK. vector_length of the move since the last leg; two dead legs in a row and he
		//goes back to the water. Sand is uneven and a man can still wedge on a beach obstacle.
		local.moved = vector_length( self.origin - local.last )
		if(local.moved < 24){ local.stuck++ }
		else{ local.stuck = 0 }
		local.last = self.origin

		//past the shingle, or jammed - restart him at his boat
		if(self.origin[1] > 2200 || local.stuck >= 2){
			local.p = (0 0 0)
			local.p[0] = local.hx + ((randomint 300) - 150)
			local.p[1] = local.hy + 300 + (randomint 260)
			local.p[2] = 0 - 500
			self.origin = local.p + (0 0 80)
			//[bug-2264] not a bare droptofloor - this runs every time a man is put back at his boat,
			//and a bare drop is how he ends up standing on a hedgehog or knee deep in the sea
			waitthread coop_placeGround self 45
			local.last = self.origin
			local.stuck = 0
		}
	}

	//never leak the marker - these men outlive nothing, but the loop can exit on death or on the
	//system being switched off mid-mission
	if(local.wp != NULL && local.wp != NIL){ local.wp remove }
}end

//[user 2026-09-01] "some should get instantly slaughtered by MG fire and it should be extremely
//brutal deaths." He gets a few strides off the ramp and then the beaten zone finds him.
//
//THE KILL IS THE MAP'S OWN RECIPE, not an invention: maps/m3l1a.scr::bhit is what retail uses to
//slaughter the rangers on higgins1's ramp (higgins1_disembark_kill at m3l1a.scr:2760) - two 40-point
//hits at a random body location to stagger him, then a 1000 to put him down, each through
//global/bullethit.scr so it plays the proper hit reaction and the flesh impact. Copying it means
//these deaths look exactly like the ones the map already shows you twenty feet away.
//
//The blood and the chunk are the coop layer on top, at the moment of the killing hit.
//=========================================================================
coop_flankCutDown:{
//=========================================================================
	local.wp = spawn info_waypoint
	if(local.wp != NULL && local.wp != NIL){
		//clear of the ramp first. He now waits minutes rather than seconds before he is hit (see
		//below), so he walks the beach like everyone else in the meantime instead of standing on the
		//sand waiting for his cue - which is its own version of the bug this file keeps producing.
		//[bug-2290] routed, and the marker's z off the ground - see coop_advanceLeg
		local.g = self.origin
		local.g[1] = local.g[1] + 900
		waitthread coop_advanceLeg self local.wp local.g ( 220 + (randomint 260) ) 34
		self thread coop_flankWalk self.origin[0] self.origin[1]
	}

	//[user 2026-09-01, bug-2254] NOT AT T=0, AND NOT ALL AT ONCE.
	//
	//This used to fire between 1.2s and 3.8s after level start, for eight men at once. The death-voice
	//system's proximity gate is 1500u near / 3500u far (coop_mod/deathvox.scr:23-28) and these boats sit
	//roughly 3100u from where the player starts in higgins1 - inside the far band - so the user got
	//"a bunch of dead noises instantly" on the loading screen fade, from men he could not even see.
	//
	//Now: nothing dies until the run-in is actually under way, and then they are spread over minutes so
	//each death is a single distant cry rather than a chorus. local.slot is the man's index within his
	//boat, which staggers the boats against each other for free.
	local.t = 0
	while(local.t < 90 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	wait ( 12 + ( randomfloat 150 ) )
	if(!isalive self){
		if(local.wp != NULL && local.wp != NIL){ local.wp remove }
		end
	}
	if(!level.coop_flankLandOn){
		if(local.wp != NULL && local.wp != NIL){ local.wp remove }
		end
	}

	local.o = self.origin + (0 0 44)

	//the stagger
	self thread maps/m3l1a.scr::bhit 40 -1
	local.b = spawn script_model model "models/fx/coop_gorechunk.tik"
	if(local.b != NULL && local.b != NIL){
		local.b.origin = local.o
		local.b notsolid
		thread coop_fxCleanup local.b 25
	}
	wait 0.18
	if(!isalive self){
		if(local.wp != NULL && local.wp != NIL){ local.wp remove }
		end
	}
	self thread maps/m3l1a.scr::bhit 40 -1
	wait 0.22

	//and the one that drops him
	if(isalive self){
		local.o = self.origin + (0 0 40)
		self thread maps/m3l1a.scr::bhit 1000 -1
		local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
		if(local.sp != NULL && local.sp != NIL){
			local.sp.origin = local.o
			local.sp notsolid
			local.sp anim start
			thread coop_fxCleanup local.sp 6
		}
		local.g = spawn script_model model "models/fx/coop_bloodslick.tik"
		if(local.g != NULL && local.g != NIL){
			local.g.origin = local.o - (0 0 40)
			local.g notsolid
			if(waitthread coop_placeGround local.g 170){ local.g anim start }
		}
	}

	if(local.wp != NULL && local.wp != NIL){ local.wp remove }
}end


//=========================================================================
//[user 2026-08-31] SCATTERED GORE - "did we ever figure out anything about bloody limbs being
//scattered around?"
//
//WHAT THE ANSWER TURNED OUT TO BE. _research/limb_dismemberment_plan.md settled this in July and the
//answer is that real severed limbs are not available:
//
//  * The human body mesh is THREE FUSED SURFACES - pants (hips + BOTH legs), tunic (torso + BOTH
//    arms), tunic_c (collar). Verified from the binary skd: numSurfaces 3, numBones 42. The rig has
//    every Bip01 arm and leg bone, but the GEOMETRY is not split along them, so the nodraw trick that
//    makes helmet-pop and decapitation work cannot hide one arm or one leg. It can only remove the
//    whole upper or whole lower body at once.
//  * NO severed-limb model exists in any of the 40 retail paks. The engine's own gib pipeline still
//    references fx_rgib1..5.tik, fx_bspurt.tik and gib1.def - all FAKK/Alice-era leftovers that MOHAA
//    never shipped. Nothing to reuse.
//
//So this is the fallback that same document recommends: "a generic red meat chunk reused N times -
//reads as blown apart at gameplay distance without per-limb modeling." models/fx/coop_gorechunk.tik
//already exists, authored for the decap work - a crossed-quad xbeam wearing the solid #150200 blood
//shader, so it reads as a wet red mass from every angle with no bad silhouette.
//
//Clustered, not sprinkled. Two to four chunks close together with one larger piece reads as one man
//coming apart; the same chunks spread evenly over the sand read as litter.
//
//spawn script_model model "..." NOT spawn "<path>" - coop_gorechunk.tik declares no classname in an
//init block, and a plain spawn of a classname-less TIKI returns 'none' (bug-2215).
//=========================================================================
coop_beachGore:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachGoreOn == NIL){ level.coop_beachGoreOn = 1 }
	if(!level.coop_beachGoreOn){ end }

	local.n = 0
	local.n++; local.gcx[local.n] = 993; local.gcy[local.n] = 317
	local.n++; local.gcx[local.n] = 0 - 2447; local.gcy[local.n] = 0 - 2431
	local.n++; local.gcx[local.n] = 2552; local.gcy[local.n] = 0 - 1406
	local.n++; local.gcx[local.n] = 2703; local.gcy[local.n] = 0 - 1668
	local.n++; local.gcx[local.n] = 0 - 2323; local.gcy[local.n] = 0 - 1698
	local.n++; local.gcx[local.n] = 0 - 1055; local.gcy[local.n] = 0 - 1402
	local.n++; local.gcx[local.n] = 0 - 2158; local.gcy[local.n] = 0 - 2072
	local.n++; local.gcx[local.n] = 0 - 1087; local.gcy[local.n] = 0 - 53
	local.n++; local.gcx[local.n] = 594; local.gcy[local.n] = 0 - 1537
	local.n++; local.gcx[local.n] = 1812; local.gcy[local.n] = 211
	local.n++; local.gcx[local.n] = 1545; local.gcy[local.n] = 163
	local.n++; local.gcx[local.n] = 218; local.gcy[local.n] = 0 - 1054
	local.n++; local.gcx[local.n] = 2083; local.gcy[local.n] = 151
	local.n++; local.gcx[local.n] = 454; local.gcy[local.n] = 246
	local.n++; local.gcx[local.n] = 2585; local.gcy[local.n] = 211
	local.n++; local.gcx[local.n] = 0 - 621; local.gcy[local.n] = 830
	local.n++; local.gcx[local.n] = 2692; local.gcy[local.n] = 1191
	local.n++; local.gcx[local.n] = 0 - 1512; local.gcy[local.n] = 150
	local.n++; local.gcx[local.n] = 1488; local.gcy[local.n] = 0 - 678
	local.n++; local.gcx[local.n] = 0 - 3071; local.gcy[local.n] = 388
	local.n++; local.gcx[local.n] = 0 - 2345; local.gcy[local.n] = 0 - 977
	local.n++; local.gcx[local.n] = 0 - 1721; local.gcy[local.n] = 0 - 1140
	local.n++; local.gcx[local.n] = 1703; local.gcy[local.n] = 0 - 795
	local.n++; local.gcx[local.n] = 1606; local.gcy[local.n] = 0 - 183
	local.n++; local.gcx[local.n] = 2975; local.gcy[local.n] = 948
	local.n++; local.gcx[local.n] = 0 - 965; local.gcy[local.n] = 400

	//[user 2026-09-01, bug-2260] AND UP WHERE THE MISSION IS ACTUALLY DECIDED. Every cluster above was
	//in the landing band (y -2431..1191). The map runs to y 6336, and the trench, the breach and all
	//three bunker interiors - where the fight ends and where the player is at knife range - had no
	//blood, no gore and no dropped kit at all. Twenty more, solved against the 229 obstacle statics with
	//>=130u clearance and >=430u from each other so they read as separate men rather than a carpet.
	local.n++; local.gcx[local.n] = 2737; local.gcy[local.n] = 2271
	local.n++; local.gcx[local.n] = 0 - 69; local.gcy[local.n] = 4540
	local.n++; local.gcx[local.n] = 1951; local.gcy[local.n] = 2174
	local.n++; local.gcx[local.n] = 1966; local.gcy[local.n] = 3850
	local.n++; local.gcx[local.n] = 145; local.gcy[local.n] = 3660
	local.n++; local.gcx[local.n] = 0 - 904; local.gcy[local.n] = 3201
	local.n++; local.gcx[local.n] = 0 - 2163; local.gcy[local.n] = 5019
	local.n++; local.gcx[local.n] = 0 - 1945; local.gcy[local.n] = 4070
	local.n++; local.gcx[local.n] = 0 - 371; local.gcy[local.n] = 5179
	local.n++; local.gcx[local.n] = 1010; local.gcy[local.n] = 3094
	local.n++; local.gcx[local.n] = 0 - 937; local.gcy[local.n] = 3889
	local.n++; local.gcx[local.n] = 0 - 1392; local.gcy[local.n] = 5018
	local.n++; local.gcx[local.n] = 1743; local.gcy[local.n] = 2921
	local.n++; local.gcx[local.n] = 0 - 446; local.gcy[local.n] = 3690
	local.n++; local.gcx[local.n] = 0 - 2785; local.gcy[local.n] = 2125
	local.n++; local.gcx[local.n] = 2795; local.gcy[local.n] = 3447
	local.n++; local.gcx[local.n] = 517; local.gcy[local.n] = 4959
	local.n++; local.gcx[local.n] = 2923; local.gcy[local.n] = 5072
	local.n++; local.gcx[local.n] = 0 - 1640; local.gcy[local.n] = 4510
	local.n++; local.gcx[local.n] = 202; local.gcy[local.n] = 2789

	local.i = 1
	local.made = 0
	while(local.i <= local.n){
		//one cluster = one man. A big piece plus two or three smaller ones around it.
		local.k = 0
		//[bug-2283] 2-4 pieces -> 1-2. Forty-six clusters at up to four pieces each was 230 entities of
		//gore alone, out of a pool that also has to hold 140 actors, 15 boats, 67 blood planes and every
		//effect on the map. The cluster still reads: one big piece, sometimes a second, and a pool.
		local.pieces = 1 + (randomint 2)
		while(local.k < local.pieces){
			local.p = (0 0 0)
			local.p[0] = local.gcx[local.i] + ((randomint 130) - 65)
			local.p[1] = local.gcy[local.i] + ((randomint 130) - 65)
			local.p[2] = 200			//dropped to the sand below, never guessed

			//[bug-2262] not on a tank trap - see coop_dropClear
			local.p = waitthread coop_dropSpot local.p 50
			if(local.p == NULL){ local.k++; continue }
			local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
			if(local.g != NULL && local.g != NIL){			//entity-pool guard
				local.g.origin = local.p
				local.g.angles = ((randomint 360) (randomint 360) (randomint 360))
				//the first piece of each cluster is the big one
				if(local.k == 0){ local.g scale (1.1 + (randomfloat 0.7)) }
				else{ local.g scale (0.45 + (randomfloat 0.55)) }
				local.g notsolid
				local.g anim idle
				local.g droptofloor
				local.made++
			}
			local.k++
		}

		//and a pool under the cluster, so it reads as wet rather than as props dropped on clean sand
		local.q = (0 0 0)
		local.q[0] = local.gcx[local.i]
		local.q[1] = local.gcy[local.i]
		local.q[2] = 200
		//[bug-2262] the pool is a ~300-500u plane at these scales, so it needs the biggest pad of
		//anything placed on this beach
		local.q = waitthread coop_dropSpot local.q 190
		local.s = NULL
		if(local.q != NULL){ local.s = spawn "models/fx/coop_bloodslick.tik" }
		if(local.s != NULL && local.s != NIL){
			local.s.origin = local.q
			local.s.angles = (0 (randomint 360) 0)
			local.s scale (0.8 + (randomfloat 0.9))
			local.s notsolid
			local.s droptofloor
		}
		//[user 2026-09-01] "Need more gore chunks, blood, and scattered objects around the map."
		//A dropped helmet and a rifle in the sand beside each cluster. These are the models the
		//engine already carries for exactly this - helmet_ranger_private.tik is what sethelmet
		//throws when a helmet pops, and the two rifles are the ones every ranger on the beach is
		//holding - so nothing new is precached and nothing can be missing.
		//[bug-2283] one dropped item per cluster, not two, and only on two clusters in three
		local.kit = 0
		if((randomint 3) == 0){ local.kit = 1 }
		while(local.kit < 1){
			local.m = "models/equipment/usgear/helmet_ranger_private.tik"
			local.r = randomint 3
			if(local.r == 1){ local.m = "models/weapons/m1_garand.tik" }
			if(local.r == 2){ local.m = "models/weapons/bar.tik" }

			local.o = spawn script_model model local.m
			if(local.o != NULL && local.o != NIL){		//entity-pool guard
				local.op = (0 0 0)
				local.op[0] = local.gcx[local.i] + ((randomint 300) - 150)
				local.op[1] = local.gcy[local.i] + ((randomint 300) - 150)
				local.op[2] = 200
				local.op = waitthread coop_dropSpot local.op 45
				if(local.op == NULL){ local.kit++; continue }
				local.o.origin = local.op
				//lying flat, not standing on end - roll 90 puts a rifle on its side
				local.o.angles = (0 (randomint 360) 90)
				local.o notsolid
				//[bug-2282] pad 70, not coop_dryGround's default 45: a Garand laid flat is about 50
				//units long, so half of it plus a barbwire run's own radius is what has to clear
				if(waitthread coop_placeGround local.o 70){ local.made++ }
			}
			local.kit++
		}

		local.i++
	}
	println("^~^~^ BEACHGORE clusters=" + local.n + " pieces=" + local.made)
}end


//=========================================================================
//[user 2026-08-31] THE SHERMAN THAT GETS KILLED IN FRONT OF YOU.
//
//User: "can we make one of the Sherman's get shelled and blow up (start it off as alive) but script it
//to get shelled and blow up/catch fire when a player gets close to it."
//
//WHY THIS IS WORTH MORE THAN ANOTHER AMBIENT EFFECT. The beach already runs six continuous loops -
//shellfire, return fire, water strikes, seawall fire, inland blasts, flank battle. Continuous chaos
//becomes wallpaper inside a minute. This is the opposite: it happens ONCE, it happens because YOU
//walked up to it, and it is loud. That is a punctuation mark, and the beach has almost none.
//
//THE BEAT, deliberately in this order:
//  1. You approach an INTACT Sherman - the only live one on the beach, so it reads as cover and as
//     something on your side.
//  2. arty_leadin: the incoming whistle. Retail already plays this alias on this map
//     (m3l1a.scr:3094), so the prefix match and the maxdist profile are proven here.
//  3. About a second of nothing. The gap is the whole trick - it is long enough to look up.
//  4. It brews up: fx_tank_explosion plus explosion_tank_sideplume, explode_tank on the wire, an
//     earthquake you feel, and a suppression spike on anyone close.
//  5. It is a burning wreck for the rest of the mission, and the cover box stays, so it is still
//     cover - just cover that is now on fire.
//
//SAFETY. No radiusdamage anywhere in here. The blast cannot kill a player, cannot kill a scripted
//actor, and cannot fail the mission; it only shakes the screen and makes noise. That is deliberate -
//a scripted set piece that can kill you is a set piece players learn to avoid.
//
//The hull is notsolid and an invisible box does the blocking, exactly as coop_beachWrecks does - see
//the long note there for why rendereffects "+dontdraw" and not `hide`.
//=========================================================================
coop_shermanShelled:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_shermanShelledOn == NIL){ level.coop_shermanShelledOn = 1 }
	if(!level.coop_shermanShelledOn){ end }

	//Open sand on the right of the run-up, clear of the lane coop_beachWar keeps free (x -900..1300)
	//and about 700 from the nearest static wreck. Height is dropped, never guessed.
	local.pos = (0 0 0)
	local.pos[0] = 1620
	local.pos[1] = 0 - 520
	local.pos[2] = 0 - 440

	local.tank = spawn script_model model "models/static/vehicle_shermantank.tik"
	if(local.tank == NULL || local.tank == NIL){			//entity-pool guard
		println("^~^~^ SHERMAN spawn failed")
		end
	}
	local.tank.origin = local.pos
	local.tank.angles = (0 85 0)
	local.tank anim idle
	local.tank notsolid
	local.tank droptofloor
	local.pos = local.tank.origin

	//cover box - yaw is near 90, so the long axis runs along Y. A SOLID_BBOX is axis-aligned in world
	//space whatever the entity's angles say, which is why the yaw is pinned near an axis.
	local.clip = spawn script_model model "models/fx/dummy.tik"
	if(local.clip != NULL && local.clip != NIL){
		local.clip.origin = local.pos
		local.clip.angles = (0 85 0)
		local.clip rendereffects "+dontdraw"
		local.clip setsize ( -58 -115 0) (58 115 112)
		local.clip solid
	}
	println("^~^~^ SHERMAN alive at " + local.pos)

	//[user 2026-09-01] IT IS IN THE FIGHT BEFORE IT DIES. A live Sherman parked silently on the sand
	//reads as scenery, which is exactly what the user saw - "im also not sure if that sherman was
	//actually shooting at the bunkers but it should have been". It now shells the emplacements on a
	//slow loop until the moment it is hit, so losing it costs you something.
	thread coop_shermanFire local.tank local.pos

	//--- wait for somebody to walk up to it -----------------------------------------------------
	local.hit = 0
	while(!local.hit && level.coop_shermanShelledOn){
		local.i = 1
		while(local.i <= $player.size){
			local.pl = $player[local.i]
			if(local.pl != NULL && local.pl != NIL && local.pl.health > 0){
				if(vector_length( local.pl.origin - local.pos ) < 750){ local.hit = 1 }
			}
			local.i++
		}
		//5 Hz is plenty for a 750-unit trigger and costs nothing. $player.size reads -1 when nobody is
		//connected, so the inner loop simply does not run - it does not need its own guard.
		wait 0.2
	}
	if(!level.coop_shermanShelledOn){ end }

	//--- the incoming round --------------------------------------------------------------------
	local.tank playsound arty_leadin
	wait ( 1.0 + ( randomfloat 0.5 ) )

	//--- and the hit ---------------------------------------------------------------------------
	local.up = local.pos + (0 0 70)

	//[user 2026-09-01, bug-2244] coop_ copy, NOT the retail one. models/fx/fx_tank_explosion.tik
	//carries `radiusdamage 120` in its own init block, and TIKI init commands run even on a
	//script_model - so this set piece was killing the player who walked up to it, despite the script
	//containing no radiusdamage anywhere. Checking the script was not enough; the TIKI had to be read.
	local.e = spawn script_model model "models/fx/coop_tank_explosion.tik"
	if(local.e != NULL && local.e != NIL){
		local.e.origin = local.up
		local.e notsolid
		local.e anim start
		thread coop_fxCleanup local.e 6
	}
	local.sp = spawn script_model model "models/emitters/explosion_tank_sideplume.tik"
	if(local.sp != NULL && local.sp != NIL){
		local.sp.origin = local.up
		local.sp notsolid
		local.sp anim start
		thread coop_fxCleanup local.sp 6
	}
	//[bug-2277] NOT explode_tank - it is declared maps "m2l2b " (and four other m2/e2l2 variants) and
	//the engine treats that field as a load filter matched as a PREFIX of the map name, so on m3l1a the
	//alias does not exist and this was silent. Caught by docs/tools/check_map_anims.py; a SECOND site
	//that the first hand-fix of this same alias missed.
	local.tank playsound arty_exp_sand

	//felt, not damaging
	thread coop_mod/main.scr::earthquake_radius local.pos 1.1 1.4 1600
	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL && local.pl.health > 0){
			if(vector_length( local.pl.origin - local.pos ) < 1400){
				thread coop_mod/main.scr::coop_bumpSuppression local.pl 0.75
			}
		}
		local.i++
	}

	//--- it is a wreck from here on ------------------------------------------------------------
	//Swapping the model in place rather than remove-and-respawn keeps the entity, and therefore keeps
	//it in every client's snapshot without a spawn/despawn pop. The Higgins wrecks do the same thing.
	//[user 2026-09-01] MASK THE SWAP. Swapping the model on the same frame the fireball spawns still
	//reads as a pop, because the flash has not covered the hull yet - the user called it "extremely
	//obvious". Wait for the fireball to actually bloom first, and put a dirt burst and a smoke column
	//ON the hull at the same instant so the silhouette is broken while it changes.
	level.coop_shermanFireOn = 0
	wait 0.25
	//[bug-2257] ON THE HULL, NOT ON THE ORIGIN. models/static/vehicle_shermantank.tik's QUAKED box is
	//(-288 -64 0) (24 64 160) - the mesh runs 288 units behind the entity origin and only 24 in front of
	//it, so the origin is at the extreme REAR of the tank and its geometric centre is ~132 units along
	//local -X. Every effect here was anchored on the origin and therefore bloomed in open air off the
	//back of the hull; the mask was never over the thing it was masking. coop_shermanBody rotates that
	//offset by the tank's own yaw.
	local.mid = waitthread coop_shermanBody local.tank local.pos
	local.mask = spawn script_model model "models/animate/fx_mortar_dirt.tik"
	if(local.mask != NULL && local.mask != NIL){
		local.mask.origin = local.mid + (0 0 30)
		local.mask notsolid
		local.mask anim start
		thread coop_fxCleanup local.mask 4
	}
	wait 0.12
	local.tank model "models/static/vehicle_shermantank_dead.tik"
	local.tank anim idle

	local.sm = spawn script_model model "models/emitters/shermansmoke.tik"
	if(local.sm != NULL && local.sm != NIL){
		local.sm.origin = local.pos
		local.sm notsolid
		local.sm anim start
	}
	local.f = spawn script_model model "models/emitters/fireandsmoke.tik"
	if(local.f != NULL && local.f != NIL){
		local.f.origin = local.pos + (0 0 40)
		local.f notsolid
		local.f anim start
		//[user, bug-2313] fire loopsound removed - visual only, and it was holding a channel
	}
	local.col = spawn script_model model "models/emitters/tehao_firesmoke_long.tik"
	if(local.col != NULL && local.col != NIL){
		local.col.origin = local.pos + (0 0 60)
		local.col notsolid
		local.col anim start
	}

	//and what came out of it
	local.k = 0
	while(local.k < 3){
		local.q = (0 0 0)
		local.q[0] = local.pos[0] + ((randomint 320) - 160)
		local.q[1] = local.pos[1] + ((randomint 320) - 160)
		local.q[2] = local.pos[2] + 90
		local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
		if(local.g != NULL && local.g != NIL){
			local.g.origin = local.q
			local.g.angles = ((randomint 360) (randomint 360) (randomint 360))
			local.g scale (0.6 + (randomfloat 0.7))
			local.g notsolid
			local.g anim idle
			waitthread coop_placeGround local.g 50
		}
		local.k++
	}

	println("^~^~^ SHERMAN brewed up")
}end


//=========================================================================
//[user 2026-08-31] THE VOICES, AND THE ROUNDS HITTING YOUR COVER.
//
//Two retail sound sets that ship with the game and that nothing has ever played.
//
//WHY loopsound AND NOT playsound. Entity::LoopSound writes edict->s.loopSound into the entity state,
//and S_OPENAL_AddLoopSounds re-evaluates every frame - it starts the loop when a listener comes into
//range and stops it when they leave. That buys three things a retrigger thread cannot: no seam at the
//60-second wrap, no per-frame script work at all, and a player who walks into range hears it
//immediately instead of waiting out the rest of a cycle.
//
//IT ALSO DECIDES THE EMITTER. loopSound rides in entityState_t, so the emitter MUST be an entity the
//client actually receives. A script_origin is NOT sent to clients and would be silent. So these use
//the same dontdraw script_model the wreck cover boxes use: rendereffects "+dontdraw" still SENDS the
//entity (entity.cpp:881), it just does not draw it.
//
//AND IT RESPECTS THE INTRO. The user asked for the opening music duck to be left alone. Nothing here
//needs timing: a loopsound is evaluated by distance, so the beds are simply inaudible under the duck
//and come up on their own as it releases. No wait, no sequence hook, no interaction with the intro.
//
//BUDGET. MAX_SOUNDSYSTEM_LOOP_SOUNDS is 128 (snd_local_new.h:97 - raised by bug-2315) and coopified already holds four
//fire loops, so this is deliberately capped well under it. Same-alias loops are direction-averaged by
//bCombine, so several hedgehog beds read as one wide source rather than stacking gain.
//=========================================================================
coop_beachVoices:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachVoicesOn == NIL){ level.coop_beachVoicesOn = 1 }
	if(!level.coop_beachVoicesOn){ end }

	//TWO anchors playing TWO DIFFERENT files. Never the same alias from two emitters at once - that is
	//self-layering, and with a 60s bed it doubles the gain and phases against itself.
	//The waterline crowd and the shingle crowd, so the beach has a front and a back.
	local.n = 0
	local.n++; local.vx[local.n] = 300;  local.vy[local.n] = 0 - 1500; local.va[local.n] = "coop_beachcrowd_rush"
	local.n++; local.vx[local.n] = 200;  local.vy[local.n] = 2500;     local.va[local.n] = "coop_beachcrowd_shingle"

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.vx[local.i]
		local.p[1] = local.vy[local.i]
		local.p[2] = 100

		local.e = spawn script_model model "models/fx/dummy.tik"
		if(local.e != NULL && local.e != NIL){			//entity-pool guard
			local.e.origin = local.p
			local.e notsolid
			local.e rendereffects "+dontdraw"
			local.e droptofloor
			local.e.origin = local.e.origin + (0 0 60)		//head height, not buried in the sand
			local.e loopsound local.va[local.i]
			local.made++
			local.beds[local.made] = local.e		//kept so they can be faded and stopped below
			local.ba[local.made] = local.va[local.i]	//and its alias, to re-issue at a lower gain
		}
		local.i++
	}
	println("^~^~^ BEACHVOICES beds=" + local.made)

	//[user 2026-09-03] AND THEY END. The same discipline coop_coverImpacts already got, for the same
	//reason: left alone these loop for the rest of the mission, so long after the wire is blown and
	//the fight has moved into the trenches a crowd of men is still shouting from an emptied shingle.
	//
	//WHY IT FADES INSTEAD OF STOPPING. Measured, not assumed. The shingle bed sits at (200 2500) and
	//the bangalores are at Y 2332-3352, so at the breach the player is ~1450 units from it, and the
	//inverse-square law in S_OPENAL_AddLoopSounds (snd_openal_new.cpp:2617-2626) puts it at
	//900*900*0.65/1450/1450 = about 25% of base. A bare stoploopsound there is an audible cut.
	//
	//THE FADE RE-ISSUES loopsound; IT DOES NOT START A NEW SOUND. Entity::LoopSound writes
	//aliasvolume * volume into edict->s.loopSoundVolume (fgame/entity.cpp, EV_LoopSound is "sFS" =
	//name, optional volume, optional mindist), and the client keeps the playing loop alive across
	//that because S_OPENAL_UpdateLoopSound only tears down when pSfx CHANGES. Same file, new gain:
	//no seam, no retrigger, no sample-offset reset.
	//
	//coop_flankMGDone is the established "the beach is behind you" signal - coop_seawallFire and
	//coop_coverImpacts already end on it, so all three now end together.
	if(local.made < 1){ end }

	local.done = 0
	while(local.done == 0){
		if(level.coop_flankMGDone == 1){ local.done = 1 }
		else if(!level.coop_beachVoicesOn){ local.done = 1 }
		else{ wait 2 }
	}

	//16 steps of 0.5s = an 8 second fade. MULTIPLY, NEVER DIVIDE: local.k * 0.0625 stays in floats,
	//where local.k / 16 is C integer division (script/scriptvariable.cpp:1673-1679) and would step
	//1,0,0,0... straight to silence - the exact hard cut this fade exists to avoid.
	local.k = 16
	while(local.k > 0){
		local.k--
		local.v = local.k * 0.0625
		local.j = 1
		while(local.j <= local.made){
			if(local.beds[local.j] != NULL && local.beds[local.j] != NIL){
				local.beds[local.j] loopsound local.ba[local.j] local.v
			}
			local.j++
		}
		wait 0.5
	}

	local.j = 1
	local.hushed = 0
	while(local.j <= local.made){
		if(local.beds[local.j] != NULL && local.beds[local.j] != NIL){
			local.beds[local.j] stoploopsound
			local.hushed++
		}
		local.j++
	}
	println("^~^~^ BEACHVOICES stopped=" + local.hushed)
}end

//Rounds hammering the steel you are hiding behind.
//
//sound/amb/Amb_M3_HedgeImpacts_01..07 are scoped `maps "m3l1a "` in retail's own ubersound - authored
//for this map, for this exact purpose, and played by nothing. The map's own $cover_sound entities are
//already positioned at every piece of cover and retail already fires one-shot impacts from them
//(m3l1a.scr:1986-1994), so they are the correct emitters and need no placement work.
//
//Only hedgehog and ramp cover. The seven `crater` anchors are sand - a metal impact bed reads wrong
//there, and the map already has crater_supression for them.
//=========================================================================
coop_coverImpacts:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_coverImpactsOn == NIL){ level.coop_coverImpactsOn = 1 }
	if(!level.coop_coverImpactsOn){ end }
	//12 was too many on two counts. Loop-sound budget: MAX_SOUNDSYSTEM_LOOP_SOUNDS is 64 and the
	//beach already holds ~28 (beachWar fires, boat burns, bunker fires, the Sherman, the two crowd
	//beds, the levelwide surf), so 12 here took it to ~40. And these are 5-11s clips looping with no
	//end condition - the exact "continuous texture stops registering" failure the user described.
	//Six, spread wider, is pressure; twelve is wallpaper.
	if(level.coop_coverImpactCap == NIL){ level.coop_coverImpactCap = 6 }

	//setup_cover fills in sound_index; give it a moment rather than racing it
	wait 2

	if($cover_trigger == NULL || $cover_trigger == NIL){
		println("^~^~^ COVERIMPACTS no cover triggers")
		end
	}

	//Spread the beds across the beach instead of taking the first N, which would cluster them all at
	//one end. Walk the list with a stride sized to land on the cap.
	local.total = $cover_trigger.size
	if(local.total < 1){ end }
	local.stride = local.total / level.coop_coverImpactCap
	if(local.stride < 1){ local.stride = 1 }

	local.made = 0
	local.i = 1
	while(local.i <= local.total && local.made < level.coop_coverImpactCap){
		local.t = $cover_trigger[local.i]
		if(local.t != NULL && local.t != NIL){
			if(local.t.cover_type == "hedgehog" || local.t.cover_type == "ramp"){
				local.si = local.t.sound_index
				if(local.si != NULL && local.si != NIL && local.si > 0){
					local.snd = $cover_sound[local.si]
					if(local.snd != NULL && local.snd != NIL){
						//one of the seven clips, so adjacent pieces of cover are not in lockstep
						local.snd loopsound ("hedgehog_ambient" + ((randomint 7) + 1))
						local.made++
						local.beds[local.made] = local.snd		//kept so they can be silenced below
					}
				}
			}
		}
		local.i = local.i + local.stride
	}
	println("^~^~^ COVERIMPACTS beds=" + local.made + "/" + local.total)

	//[user 2026-08-31] AND THEY STOP. Left alone these loop for the rest of the mission, so long after
	//the bunkers are cleared the hedgehogs are still being hammered by rounds that no longer exist -
	//which is the user's own complaint about continuous texture, in miniature.
	//
	//coop_flankMGDone is set when the bangalores blow the wire, i.e. the moment the beach is behind
	//you. Same signal coop_seawallFire already stops on, so the two end together.
	local.done = 0
	while(local.done == 0){
		if(level.coop_flankMGDone == 1){ local.done = 1 }
		else if(!level.coop_coverImpactsOn){ local.done = 1 }
		else{ wait 2 }
	}
	local.k = 1
	local.hushed = 0
	while(local.k <= local.made){
		if(local.beds[local.k] != NULL && local.beds[local.k] != NIL){
			local.beds[local.k] stoploopsound
			local.hushed++
		}
		local.k++
	}
	println("^~^~^ COVERIMPACTS stopped=" + local.hushed)
}end


//=========================================================================
//[user 2026-08-31] THE SCREAMING.
//
//19 allied panic lines ship in retail, are aliased ~99 times, and are played by nothing on this map.
//Meanwhile the beach has ~30 corpses, 46 blood pools, 21 ambient casualties and a shingle line of men
//refusing to move - and all of it is completely silent. Sound is most of what makes a beach feel bad.
//
//A SINGLE PACED THREAD, not per-actor voices. Three reasons, all of them from the existing code:
//  * coop_vigSpawn sets coop_noChatter = 1 and aivoice.scr:208 refuses on that flag, by design - the
//    vignette actors are meant to be silent props, not chatterboxes.
//  * A1 (the medic/patient pair) and A5 (the shingle line) are deliberately thread-free; the file
//    warns that attaching a second thread to A1 is exactly what broke it before.
//  * Nineteen actors each deciding independently when to scream is a chorus. One thread that fires
//    one line every seven to sixteen seconds is a battlefield.
//
//EMITTERS ARE THE MAP'S OWN $cover_sound ENTITIES. They are already positioned at every piece of cover
//across the whole beach, they are already networked, and retail already plays one-shot impacts from
//them (m3l1a.scr:1986-1994) - so they need no placement work and are guaranteed to be somewhere a
//player might be. One is picked near a live player each cycle so the scream is always audible.
//=========================================================================
coop_beachPanic:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachPanicOn == NIL){ level.coop_beachPanicOn = 1 }
	if(!level.coop_beachPanicOn){ end }

	wait 3			//let setup_cover finish before touching $cover_sound

	if($cover_sound == NULL || $cover_sound == NIL){
		println("^~^~^ BEACHPANIC no cover_sound anchors")
		end
	}
	local.total = $cover_sound.size
	if(local.total < 1){ end }
	println("^~^~^ BEACHPANIC anchors=" + local.total)

	while(level.coop_beachPanicOn){
		wait ( 7 + ( randomfloat 9 ) )

		//pick a live player to anchor the choice to, so we never scream on the far side of the map
		local.pl = NULL
		local.try = 0
		while(local.try < 4 && local.pl == NULL){
			if($player != NULL && $player != NIL && $player.size > 0){
				local.c = $player[((randomint $player.size) + 1)]
				if(local.c != NULL && local.c != NIL && local.c.health > 0){ local.pl = local.c }
			}
			local.try++
		}
		if(local.pl == NULL){ continue }

		//and an anchor near him - a handful of tries rather than a full sort every cycle
		local.pick = NULL
		local.try = 0
		while(local.try < 10 && local.pick == NULL){
			local.a = $cover_sound[((randomint local.total) + 1)]
			if(local.a != NULL && local.a != NIL){
				local.d = vector_length( local.a.origin - local.pl.origin )
				//inside the alias maxdist (2200) but not on top of the player
				if(local.d > 250 && local.d < 1900){ local.pick = local.a }
			}
			local.try++
		}
		if(local.pick == NULL){ continue }

		local.pick playsound coop_av_us_panic
	}
}end


//=========================================================================
//[user 2026-08-31] THE SEASICK MAN.
//
//higgins_ride_puke02 -> scripted/higgins/higginspuke02.skc is declared in level_m3l1.tik inside its
//$mapspec m3l1a block, so it is already loaded on this map through new_generic_human.tik's includes.
//It is NOT flagged `random`, so the name survives verbatim - no digit strip. Nothing in the entire
//game has ever played it.
//
//It is the single most recognisable image from the reference: on the way in, one of the men leans
//over the gunwale and is sick. MOHAA shipped the animation for it and never used it.
//
//$higgins1_ranger4 is the right man to give it to. He is set to `anim higgins_ride_stand04` once at
//m3l1a.scr:445 and is not touched again until the ramp drops (:2484 unglue/solid/physics_on), so
//during the ride he is purely cosmetic - and he is restored to his stand anim afterwards regardless.
//=========================================================================
coop_seasickMan:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_seasickOn == NIL){ level.coop_seasickOn = 1 }
	if(!level.coop_seasickOn){ end }

	//wait for the run-in to actually be under way rather than guessing at map-start timing
	local.t = 0
	while(local.t < 180 && level.coop_runInShelling != 1){
		wait 0.5
		local.t++
	}
	if(level.coop_runInShelling != 1){ end }

	wait ( 6 + ( randomfloat 7 ) )
	//if the ramp has already dropped the moment has passed - do not play it on the sand
	if(level.coop_runInShelling != 1){ end }
	if($higgins1_ranger4 == NULL || $higgins1_ranger4 == NIL){ end }

	//CLAIM HIM FIRST. Every ranger on this boat is driven by higgins1_crouch / _look / _flinch
	//(m3l1a.scr:7366/7379/7410/7423), and retail fires the flinch FIVE times during the ride, so
	//without this the puke is overridden within a second or two and the beat never lands. Those four
	//lines now skip ranger4 while this flag is up - only ranger4, only for the length of the anim.
	level.coop_seasickPlaying = 1
	$higgins1_ranger4 anim higgins_ride_puke02
	println("^~^~^ SEASICK played")
	//4.0 is the anim's real length (check_anim_dwell.py reads it from the SKC header). It used to be
	//4.5, which held the override flag half a second past the end and left him standing in the boat
	//for that half second before retail's flinch could take him back.
	wait 4.0
	level.coop_seasickPlaying = 0
	if(level.coop_runInShelling == 1 && $higgins1_ranger4 != NULL && $higgins1_ranger4 != NIL){
		$higgins1_ranger4 anim higgins_ride_stand04
	}
}end


//The live Sherman puts rounds into the bluff until it is killed. Cosmetic: the shell effects land on
//the real emplacement origins, so it reads as directed fire, but nothing here calls radiusdamage and
//it cannot hurt an actor or an objective.
//=========================================================================
coop_shermanFire local.tank local.pos:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_shermanFireOn == NIL){ level.coop_shermanFireOn = 1 }

	//[bug-2258] NOT UNTIL SOMEBODY IS ASHORE. The loop used to open fire the moment the map started,
	//i.e. through the whole boat ride, spending its shells on an empty beach.
	local.yawf = 0
	if(local.tank != NULL && local.tank != NIL){ local.yawf = local.tank.angles[1] }
	local.w = 0
	while(local.w < 200 && level.coop_runInShelling != 1){
		wait 1
		local.w = local.w + 1
	}
	local.w = 0
	while(local.w < 200 && level.coop_runInShelling == 1){
		wait 1
		local.w = local.w + 1
	}

	local.n = 0
	if($mg42_leftbunker1 != NULL){ local.n++; local.t[local.n] = $mg42_leftbunker1 }
	if($mg42_rightbunker1 != NULL){ local.n++; local.t[local.n] = $mg42_rightbunker1 }
	if($mg42_middle1 != NULL){ local.n++; local.t[local.n] = $mg42_middle1 }
	if($mg42_left1 != NULL){ local.n++; local.t[local.n] = $mg42_left1 }
	if($mg42_right1 != NULL){ local.n++; local.t[local.n] = $mg42_right1 }
	if(local.n < 1){ end }

	while(level.coop_shermanFireOn && local.tank != NULL && local.tank != NIL){
		wait ( 4 + ( randomfloat 5 ) )
		if(!level.coop_shermanFireOn){ end }

		//[bug-2258] MUZZLE FLASH AT THE MUZZLE, AND BIG ENOUGH TO SEE. This was firegood.tik at the
		//entity origin. firegood is a CAMPFIRE - fire_ring2.spr at scale 0.20 - and the origin is at
		//the rear of the hull (see coop_shermanBody), so the "flash" was a hearth-sized sprite behind
		//the tank while its 7-second smoke was the only thing that read. fx_mortar_dirt is the same
		//burst the shell impacts use and is visible at range.
		local.mz = waitthread coop_shermanBody local.tank local.pos
		local.mz[0] = local.mz[0] + ( 190 * cos(local.yawf) )
		local.mz[1] = local.mz[1] + ( 190 * sin(local.yawf) )
		local.f = spawn script_model model "models/animate/fx_mortar_dirt.tik"
		if(local.f != NULL && local.f != NIL){
			local.f.origin = local.mz + (0 0 96)
			local.f notsolid
			local.f anim start
			thread coop_fxCleanup local.f 0.9
		}
		//NOT explode_tank: that alias is declared `maps "m2l2b "` and this engine treats the maps
		//field as a load filter, so on m3l1a it does not exist and the shot would be silent.
		//arty_exp_sand is "m e t" at 1000/8000 - loaded here, and it carries across the beach.
		local.tank playsound arty_exp_sand

		wait 0.35
		local.tgt = local.t[((randomint local.n) + 1)]
		if(local.tgt == NULL || local.tgt == NIL){ continue }
		local.p = local.tgt.origin
		local.p[0] = local.p[0] + ((randomint 260) - 130)
		local.p[1] = local.p[1] + ((randomint 200) - 100)
		local.p[2] = local.p[2] + ((randomint 80) - 20)

		local.h = spawn script_model model "models/animate/fx_mortar_dirt.tik"
		if(local.h != NULL && local.h != NIL){
			local.h.origin = local.p
			local.h notsolid
			local.h anim start
			thread coop_fxCleanup local.h 3
		}
	}
}end


//=========================================================================
//[user 2026-09-01] SHELLING ON THE HIGH GROUND.
//
//"same with the shelling that goes on up in that region" - naval gunfire walking along the bluff and
//the draw behind it, for the whole mission. Purely cosmetic: fx_mortar_dirt.tik carries no
//radiusdamage (unlike fx_tank_explosion, see coop_shermanShelled), and nothing here is near a player.
//
//THE BAND is read off the emplacements themselves where they exist, so it lands on the ground the
//player is actually looking at rather than at coordinates guessed from a screenshot; it falls back to
//the measured bluff band if the map ever ships without them.
//=========================================================================
coop_bluffShelling:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_bluffShellOn == NIL){ level.coop_bluffShellOn = 1 }
	if(!level.coop_bluffShellOn){ end }
	if(level.coop_bluffShellDone == 1){ end }
	level.coop_bluffShellDone = 1

	while(level.coop_bluffShellOn){
		wait ( 3.5 + ( randomfloat 7 ) )

		//a stick of two or three, walked along the ridge rather than one lonely bang
		local.count = 2 + (randomint 2)
		local.x = ( 0 - 3400 ) + (randomint 7200)
		local.y = 4300 + (randomint 1900)

		local.j = 0
		while(local.j < local.count){
			local.p = (0 0 0)
			local.p[0] = local.x + (local.j * (140 + (randomint 220)))
			local.p[1] = local.y + ((randomint 320) - 160)
			local.p[2] = 700

			local.h = spawn script_model model "models/animate/fx_mortar_dirt.tik"
			if(local.h != NULL && local.h != NIL){		//entity-pool guard
				local.h.origin = local.p
				local.h notsolid
				local.h droptofloor		//onto the bluff, whatever height it is there
				local.h anim start
				//arty_exp_sand is the map's own ground-burst alias (m3l1a.scr:5306); there is no
				//arty_exp_dirt.
				local.h playsound arty_exp_sand
				thread coop_fxCleanup local.h 3.5
			}
			local.j++
			wait ( 0.25 + ( randomfloat 0.4 ) )
		}
	}
}end

//=========================================================================
//[user 2026-09-01] THE RUN-IN IS UNDER FIRE, AND THE SEA IS FULL OF IT.
//
//Three things the user asked for, all on the same clock so they read as one bombardment:
//  * "more bullets hitting the water as you drive in with the higgins (there are actual water getting
//    hit effects)" - models/fx/bh_water_hard.tik and bh_water_lite.tik ARE those effects; they are the
//    engine's own bullet-in-water impacts. Stitched in short bursts, the way an MG walks a burst
//    across the swell, rather than sprinkled evenly.
//  * "more explosions in the water as you arrive (should be more sparse not just around you but out in
//    the distance" - a second, slower stream out at 1400-4200 units, using the map's own
//    fx_mortar_water anchor height.
//  * "no water drops on screen when the bomb beside us hits the water" - close impacts poke
//    coop_lensSplash on that player, which cgame turns into beads on the lens and owns the decay for
//    (cg_view.c CG_CoopLensSplashLevel). Only the CLOSE ones, and only on the player they were close
//    to, so a distant shell never wets somebody else's screen.
//
//Runs only while coop_runInShelling is up, so it dies with the ride.
//=========================================================================
coop_runInWaterFire:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_runInWaterOn == NIL){ level.coop_runInWaterOn = 1 }
	if(!level.coop_runInWaterOn){ end }

	//wait for the ride to actually start, then run with it
	local.t = 0
	while(local.t < 30 && level.coop_runInShelling != 1){
		wait 0.5
		local.t = local.t + 0.5
	}
	if(level.coop_runInShelling != 1){ end }

	thread coop_runInWaterDistant

	while(level.coop_runInShelling){
		wait ( 0.35 + ( randomfloat 0.8 ) )
		if(!level.coop_runInShelling){ break }

		local.pl = NULL
		if($player != NULL && $player != NIL && $player.size > 0){
			local.cand = $player[((randomint $player.size) + 1)]
			if(local.cand != NULL && local.cand.health > 0){ local.pl = local.cand }
		}
		if(local.pl == NULL){ continue }

		//A BURST, WALKED. One origin, one direction, five or six impacts marching away from it - that
		//is what an MG doing this looks like. Scattered single splashes read as rain.
		local.bx = local.pl.origin[0] + ((randomint 900) - 450)
		local.by = local.pl.origin[1] - 260 - (randomint 500)
		local.dx = ((randomint 120) - 60)
		local.dy = 40 + (randomint 90)

		local.j = 0
		local.count = 5 + (randomint 3)
		while(local.j < local.count){
			local.p = (0 0 0)
			local.p[0] = local.bx + (local.dx * local.j) + ((randomint 40) - 20)
			local.p[1] = local.by + (local.dy * local.j) + ((randomint 40) - 20)
			local.p[2] = 0 - 496

			local.mdl = "models/fx/bh_water_lite.tik"
			if((randomint 3) == 0){ local.mdl = "models/fx/bh_water_hard.tik" }
			local.w = spawn script_model model local.mdl
			if(local.w != NULL && local.w != NIL){		//entity-pool guard
				local.w.origin = local.p
				local.w notsolid
				//[bug-2259] HIDE THE DUMMY. Every fx model that behaves here carries
				//`rendereffects +dontdraw` in its own init server block - fx_mortar_water.tik does.
				//bh_water_lite.tik and bh_water_hard.tik carry an EMPTY server block (read out of
				//Pak0 to confirm), so their dummy skeleton is a drawn model bobbing in the surf
				//under every splash. Set it here since we cannot edit a retail tik.
				local.w rendereffects "+dontdraw"
				local.w anim start
				thread coop_fxCleanup local.w 1.6
			}
			local.j++
			wait 0.06
		}
	}
}end

//The far half of the same bombardment - "out in the distance", and sparse on purpose.
//=========================================================================
coop_runInWaterDistant:{
//=========================================================================
	//[bug-2259] ITS OWN GUARDS. This is threaded from inside coop_runInWaterFire, so it used to inherit
	//that label's toggle: setting coop_runInWaterOn 0 to tone down the bullet splashes silently also
	//killed the distant water explosions, which are a separate thing the user asked for.
	if(level.gametype == 0){ end }
	if(level.coop_runInWaterDistOn == NIL){ level.coop_runInWaterDistOn = 1 }
	if(!level.coop_runInWaterDistOn){ end }

	while(level.coop_runInShelling && level.coop_runInWaterDistOn){
		wait ( 1.6 + ( randomfloat 3.4 ) )
		if(!level.coop_runInShelling){ break }

		local.pl = NULL
		if($player != NULL && $player != NIL && $player.size > 0){
			local.cand = $player[((randomint $player.size) + 1)]
			if(local.cand != NULL && local.cand.health > 0){ local.pl = local.cand }
		}
		if(local.pl == NULL){ continue }

		//1400-4200 units out, anywhere around the boat, but always seaward of the landing band so a
		//"distant" column never appears on the sand in front of you
		local.r = 1400 + (randomint 2800)
		local.a = randomint 360
		local.p = (0 0 0)
		//cos(x) / sin(x) call form, matching global/hoveringplane.scr:127-128 and lobby.scr:281 -
		//the working callers in this project all use the parenthesised-argument form.
		local.p[0] = local.pl.origin[0] + ( cos(local.a) * local.r )
		local.p[1] = local.pl.origin[1] + ( sin(local.a) * local.r )
		local.p[2] = 0 - 496
		if(local.p[1] > (0 - 2100)){ local.p[1] = 0 - 2100 - (randomint 900) }

		local.mdl = "models/animate/fx_mortar_water.tik"
		if((randomint 3) == 0){ local.mdl = "models/fx/fx_waterexplosion.tik" }
		local.sh = spawn script_model model local.mdl
		if(local.sh != NULL && local.sh != NIL){		//entity-pool guard
			local.sh.origin = local.p
			local.sh notsolid
			local.sh anim start
			//arty_exp_water1..3, not "arty_exp_water" - the map ships three numbered takes and no
			//unnumbered alias. 1000/8000, so a column 4000 units out is still audible.
			local.sh playsound ( "arty_exp_water" + ( ( randomint 3 ) + 1 ) )
			//[user 2026-09-01] the near ones among these throw water on the lens too - "more frequent
			//when water effects play near the player". Reach is smaller than the barrage's because
			//these are deliberately distant; only the ones that stray close count.
			thread coop_lensSplashAt local.p 1100
			thread coop_fxCleanup local.sh 4
		}
	}
}end

//A splash close enough to soak somebody. Pokes coop_lensSplash on the players it actually reached and
//nobody else; cgame consumes the cvar, clears it, and owns the fade from there.
//=========================================================================
coop_lensSplashAt local.pos local.reach:{
//=========================================================================
	if($player == NULL || $player == NIL){ end }
	if($player.size < 1){ end }
	if(local.reach == NIL){ local.reach = 700 }

	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i].health > 0){
			local.d = vector_length( $player[local.i].origin - local.pos )
			if(local.d < local.reach){
				local.amt = 1 - (local.d / local.reach)
				if(local.amt > 0.95){ local.amt = 0.95 }
				$player[local.i] stufftext ("coop_lensSplash " + local.amt)
			}
		}
		local.i++
	}
}end

//=========================================================================
//[user 2026-09-01] THE SECOND WAVE GOES IN BEHIND YOU.
//
//"once the bangalores blow up more people should charge in from the beach consistently and get
//shot/blown up", and "still doesnt seem like we have enough allies charging the beach on their own and
//getting killed".
//
//Hung off the SAME signal as coop_flankMG - m3l1a.scr:5304, the moment bangalore 3 detonates - so the
//breach and the men pouring through it are one beat.
//
//WHY WAYPOINTS AGAIN. Same reason as the flanks: these men are spawned at the waterline and sent up a
//stretch of sand whose pathnode coverage is written for the map's own scripted rangers, not for
//arbitrary start points. An info_waypoint target takes the direct-move branch in
//Actor::MoveToPatrolCurrentNode and needs no graph, so this cannot produce the "Path not found" flood
//that left the flank men standing still. This also answers "have them find their own paths to the
//entrance of the bunker if possible let me know if we need nodes" - no nodes needed.
//
//They aim for the breach itself ($bangalore_explosion3a where it exists), which is the way up off the
//beach, so the charge reads as going somewhere rather than milling about.
//=========================================================================
coop_bangaloreCharge:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_bangChargeOn == NIL){ level.coop_bangChargeOn = 1 }
	if(!level.coop_bangChargeOn){ end }
	if(level.coop_bangChargeDone == 1){ end }
	level.coop_bangChargeDone = 1

	//the gap in the wire is where they are all headed
	local.gap = (0 0 0)
	local.gap[0] = 400
	local.gap[1] = 4200
	local.gap[2] = 0 - 300
	if($bangalore_explosion3a != NULL && $bangalore_explosion3a != NIL){
		local.gap = $bangalore_explosion3a.origin
	}

	local.wave = 0
	while(local.wave < 3 && level.coop_bangChargeOn){
		local.k = 0
		while(local.k < 4){
			local.p = (0 0 0)
			local.p[0] = local.gap[0] + ((randomint 2600) - 1300)
			local.p[1] = 0 - 900 - (randomint 900)
			local.p[2] = 0 - 460

			local.mdl = "models/human/dday_29th_private"
			if((randomint 2) == 0){ local.mdl = "models/human/dday_ranger_private" }
			local.a = spawn local.mdl gun "m1 garand"
			if(local.a != NULL && local.a != NIL){		//entity-pool guard
				local.a.coop_noChatter = 1
				local.a threatbias ignoreme
				local.a notarget 1
				local.a dontdropweapons
				local.a notsolid
				local.a.isinsequence = 1
				local.a.isbusy = 1
				local.a.origin = local.p + (0 0 80)
				if(waitthread coop_dryGround local.a){ local.a thread coop_chargeRun local.gap }
			}
			local.k++
			wait ( 0.3 + ( randomfloat 0.7 ) )
		}
		local.wave++
		wait ( 14 + ( randomfloat 16 ) )
	}
	println("^~^~^ BANGCHARGE waves=" + local.wave)
}end

//One man of the second wave: up the sand toward the breach, and most of the way there something finds
//him. Same kill recipe as the flanks - maps/m3l1a.scr::bhit, which is the map's own.
//=========================================================================
coop_chargeRun local.gap:{
//=========================================================================
	//[user, bug-2272] EVERY MAN ENDS. Nobody vanishes and nobody stands.
	//
	//The user, twice: "instead of having guys run and then disappear up the beach like you do have them
	//get chewed up by mgs, blown up, etc", and "many of your spawned guys push up to the bared wire and
	//just stand there".
	//
	//Both were the same two lines. A survivor who reached y 1600 was `remove`d, which is a man
	//evaporating in front of you; and a man who used up his legs without reaching it fell out of the
	//loop and stood where he stopped, which on this beach is at the wire. There is no third outcome on
	//Omaha - you are hit on the sand or you are hit at the wire - so the loop no longer has an exit that
	//leaves anybody upright, and no exit that deletes anybody.
	local.wp = spawn info_waypoint
	if(local.wp == NULL || local.wp == NIL){ end }

	//[bug-2290] MORE LEGS, EACH SHORTER, EACH ROUTED. The old leg was 420-800 units of +y with the
	//marker's z copied off the man - the single worst offender in the file, because this is the one
	//route that deliberately crosses the wire belt at y 3270-3460. Same total distance, in hops the
	//obstacle test can actually clear.
	local.legs = 10 + (randomint 9)
	local.i = 0
	while(local.i < local.legs && isalive self){
		//lead him at the gap rather than straight up the beach, so the whole wave converges
		local.g = self.origin
		local.g[0] = local.g[0] + ((local.gap[0] - local.g[0]) / 3) + ((randomint 240) - 120)
		local.g[1] = local.g[1] + 1200
		local.moved = waitthread coop_advanceLeg self local.wp local.g ( 300 + (randomint 120) ) 34
		if(local.moved == 0){ wait 0.6 }
		wait ( 1.6 + ( randomfloat 1.2 ) )
		if(self == NULL || self == NIL){ break }
		waitthread coop_underCheck self
		if(self == NULL || self == NIL){ break }
		local.i++
		//the wire IS the beaten zone - do not let him walk into it and stop
		if(self != NULL && self != NIL){
			if(self.origin[1] > 3000){ break }
		}
	}

	if(local.wp != NULL && local.wp != NIL){ local.wp remove }
	if(!isalive self){ end }

	//--- and then the beach kills him. Two ways, because a whole wave dying identically reads as a
	//script: most are chewed up by the MGs, some go up with a shell.
	local.o = self.origin + (0 0 44)
	if((randomint 4) == 0){
		//BLOWN UP. fx_mortar_dirt is the map's own ground burst; the kill is still bhit so the body
		//plays a real death rather than freezing mid-stride.
		local.e = spawn script_model model "models/animate/fx_mortar_dirt.tik"
		if(local.e != NULL && local.e != NIL){
			local.e.origin = self.origin
			local.e notsolid
			local.e anim start
			local.e playsound arty_exp_sand
			thread coop_fxCleanup local.e 3
		}
		thread coop_mod/main.scr::earthquake_radius self.origin 0.4 0.6 600
		wait 0.1
		if(isalive self){ self thread maps/m3l1a.scr::bhit 1000 -1 }
		local.k = 0
		while(local.k < 3){
			local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
			if(local.g != NULL && local.g != NIL){
				local.g.origin = local.o
				local.g.angles = ((randomint 360) (randomint 360) (randomint 360))
				local.g notsolid
				local.g anim idle
				waitthread coop_placeGround local.g 50
			}
			local.k++
		}
	}else{
		//CHEWED UP. Two staggering hits then the one that drops him - retail's own recipe.
		self thread maps/m3l1a.scr::bhit 40 -1
		wait 0.16
		if(isalive self){ self thread maps/m3l1a.scr::bhit 40 -1 }
		wait 0.14
		if(isalive self){ self thread maps/m3l1a.scr::bhit 1000 -1 }
	}

	local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
	if(local.sp != NULL && local.sp != NIL){
		local.sp.origin = local.o
		local.sp notsolid
		local.sp anim start
		thread coop_fxCleanup local.sp 6
	}
	local.s = spawn "models/fx/coop_bloodslick.tik"
	if(local.s != NULL && local.s != NIL){
		local.s.origin = local.o - (0 0 44)
		local.s.angles = (0 (randomint 360) 0)
		local.s notsolid
		waitthread coop_placeGround local.s 170
	}

	//the concurrency slot comes back on death now, not on removal - see coop_beachCharge
	if(self != NULL && self != NIL){
		if(self.coop_chargeCounted == 1){
			self.coop_chargeCounted = 0
			level.coop_beachChargeLive--
		}
	}
}end


//Three whistles up the beach, then a second voice behind them. See the note at the call site.
//=========================================================================
coop_advanceWhistles:{
//=========================================================================
	if(level.coop_whistlesBlown == NIL){ level.coop_whistlesBlown = 0 }
	local.n = 0
	if($higgins1_door != NULL && $higgins1_door != NIL){ local.n++; local.e[local.n] = $higgins1_door }
	if($center_radioman != NULL && $center_radioman != NIL){ local.n++; local.e[local.n] = $center_radioman }
	if($higgins1_ranger10 != NULL && $higgins1_ranger10 != NIL){ local.n++; local.e[local.n] = $higgins1_ranger10 }
	if($higgins5_ranger1 != NULL && $higgins5_ranger1 != NIL){ local.n++; local.e[local.n] = $higgins5_ranger1 }
	if(local.n < 1){ end }

	local.i = 0
	while(local.i < 3){
		local.w = local.e[((local.i % local.n) + 1)]
		if(local.w != NULL && local.w != NIL){ local.w playsound coop_beach_whistle }
		wait ( 0.45 + ( randomfloat 0.35 ) )
		local.i++
	}

	//and a second man shouting it, a beat after the first, so the order comes from more than one
	//direction. A DIFFERENT speaker to the caller at the call site - never the same actor twice, which
	//would stomp his own waittill saydone.
	wait 0.9
	if($higgins5_ranger1 != NULL && $higgins5_ranger1 != NIL){
		if(isalive $higgins5_ranger1 && $higgins5_ranger1.isinsequence != 1 && $higgins5_ranger1.isbusy != 1){
			$higgins5_ranger1 say streamed_dfr_scripted_M3L1_044a
		}
	}
	wait 1.4
	local.w = local.e[((randomint local.n) + 1)]
	if(local.w != NULL && local.w != NIL){ local.w playsound coop_beach_whistle }

	//[bug-2322] the shingle objective is waiting on this - see coop_smokeSignal_releaseShingle.
	level.coop_whistlesBlown = 1
}end


//=========================================================================
//[user 2026-09-01] THE BEACH IS POPULATED BEFORE YOU GET THERE.
//
//"why do some of these actors on the beach only spawn when I approach the area? i think they should
//all be spawned anyways, even if they are triggered to act a specific way when I approach."
//
//WHY THEY DID NOT. They are retail's, not ours. maps/m3l1a.scr::sequence_6_spawn_shingle spawns all
//eighteen shingle_wave rangers, and the ONLY thing that calls it is the tier-6 trigger the player
//walks into. Until you touch that brush the shingle is literally empty, so men appear a few metres in
//front of you. Same shape at every tier.
//
//WHAT THIS DOES. Calls the map's OWN spawner early. Nothing is duplicated: sequence_6_spawn_shingle
//opens with `if (level.thread["sequence_6_spawn_shingle"]){ end }` and sets that flag, so when the
//player finally trips the trigger the retail call is a no-op and tier 7 hands its todos to the men who
//are already there.
//
//DELIBERATELY NOT setting level.m3l1a_sequence. The spawner and the tier are separate things - the
//variable is the path index (ai_execute_todo composes targetname + "_path_" + nextsequence), and
//stamping 6 here would let coop_advanceOnSmoke's gate pass before the player has even landed.
//
//SAFE TO DO EARLY: ai_friendly_setup runs `exec global/disable_ai.scr` on every one of them, so they
//stand at the shingle inert until a todo is handed to them. They are not going to wander off, and
//they are not going to fight ahead of their cue. They CAN be hit by the bunker guns, which is on
//theme - the user's next sentence in the same message was that not enough allies are dying out there.
//
//g_ddayshingleguys is a DETAIL cvar: 0 = none, 1 = the medium nine, 2 = all eighteen. Forced to 2,
//because a coop server deciding the beach is empty to save frames is not a tradeoff worth having.
//=========================================================================
coop_preSpawnBeach:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_preSpawnOn == NIL){ level.coop_preSpawnOn = 1 }
	if(!level.coop_preSpawnOn){ end }
	if(level.coop_preSpawnDone == 1){ end }
	level.coop_preSpawnDone = 1

	//the spawn markers are BSP entities, so they exist by prespawn - but the map's own main is still
	//wiring things up in the same frame, so give it one
	waitframe
	if($shingle_wave_spawn1 == NULL || $shingle_wave_spawn1 == NIL){
		println("^~^~^ PRESPAWN abort reason=no_markers")
		end
	}

	setcvar "g_ddayshingleguys" "2"
	waitthread maps/m3l1a.scr::sequence_6_spawn_shingle

	//[user, bug-2266] AND THEY TAKE COVER UNTIL THEY ARE CALLED. Pre-spawning them fixed "actors only
	//appear when I walk up to them" and created "allies literally just standing out in the open": retail
	//spawns these men at the moment tier 6 fires and hands them a todo seconds later, so nobody ever saw
	//them idle. Spawned at level start they stand at the shingle under four MG42s for ten minutes.
	//
	//Posed prone or crouched behind the shingle, which is what the men in the retail set piece are doing
	//twenty feet away. coop_vigHold yields the instant ai_execute_todo claims one, so tier 7 still works.
	local.live = 0
	local.i = 1
	while(local.i <= 18){
		local.m = $( "shingle_wave" + local.i )
		if(local.m != NULL && local.m != NIL){
			local.live++
			//[bug-2269] prone, or crouched behind the shingle - never upright. These men are lying
			//under four MG42s until tier 7 calls them forward.
			if((local.i % 4) == 0){ local.m thread coop_vigHold "crouch_beach_idle" }
			else{ local.m thread coop_vigHold "prone_beach_idle" }
		}
		local.i++
	}
	println("^~^~^ PRESPAWN shingle=" + local.live + "/18")
}end


//Two men still at the mouth of an already-beached boat. Separate label rather than a delay inside the
//placement loop, because that loop must not wait - it is placing eleven boats and the fleet is moving.
//=========================================================================
coop_disembarkStragglers local.pos:{
//=========================================================================
	local.h = spawn script_origin
	if(local.h == NULL || local.h == NIL){ end }
	local.h.origin = local.pos
	waitthread coop_disembarkSquad local.h 2 1
	if(local.h != NULL && local.h != NIL){ local.h remove }
}end


//=========================================================================
//[user 2026-09-01] A CONTINUOUS TRICKLE UP THE PLAYABLE BEACH.
//
//"still doesnt seem like we have enough allies charging the beach on their own and getting killed."
//
//coop_bangaloreCharge answers the second half of that, but only from the moment the wire is breached,
//which is the END of the beach fight. For everything before it the only men moving were on the
//OUT-OF-BOUNDS flanks, where the player cannot go and mostly cannot see. This fills the middle: small
//groups coming out of the surf and working up the sand you are actually crossing, most of them dying
//on the way, from the landing until the breach - at which point coop_bangaloreCharge's surge takes over
//and this stands down rather than competing with it.
//
//CONCURRENCY, not a total. level.coop_beachChargeLive counts men currently walking; a new group only
//goes in when there is room. That is what keeps this from being a slow leak of actors across a
//twenty-minute mission - the population is bounded at any instant, and dead men stop counting because
//coop_chargeRun decrements on the way out.
//=========================================================================
coop_beachCharge:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachChargeOn == NIL){ level.coop_beachChargeOn = 1 }
	if(!level.coop_beachChargeOn){ end }
	if(level.coop_beachChargeDone == 1){ end }
	level.coop_beachChargeDone = 1
	if(level.coop_beachChargeMax == NIL){ level.coop_beachChargeMax = 5 }
	level.coop_beachChargeLive = 0

	//not during the boat ride - there is nothing to see from out there and the men would be spawning
	//into the water the player is about to cross
	local.t = 0
	while(local.t < 180 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	local.t = 0
	while(local.t < 120 && level.coop_runInShelling == 1){
		wait 1
		local.t = local.t + 1
	}

	//the gap in the wire is where everyone is trying to get to, same as the bangalore surge
	local.gap = (0 0 0)
	local.gap[0] = 400
	local.gap[1] = 4200
	local.gap[2] = 0 - 300
	if($bangalore_explosion3a != NULL && $bangalore_explosion3a != NIL){
		local.gap = $bangalore_explosion3a.origin
	}

	while(level.coop_beachChargeOn && level.coop_bangChargeDone != 1){
		wait ( 5 + ( randomfloat 8 ) )
		if(level.coop_bangChargeDone == 1){ break }
		if($player == NULL || $player == NIL){ continue }
		if($player.size < 1){ continue }

		local.k = 0
		local.want = 2 + (randomint 2)
		while(local.k < local.want){
			if(level.coop_beachChargeLive >= level.coop_beachChargeMax){ break }

			local.p = (0 0 0)
			//the full playable width, not a strip - see the boat note in coop_extraBoats
			local.p[0] = ( 0 - 3800 ) + (randomint 7600)
			//[bug-2265] y -1500..-2400 is z -550..-586, i.e. thigh deep. The comment said "out of the
			//surf" and meant the opposite: seaward of the obstacles IS the surf on this beach. They come
			//out of the shallows now (z ~ -505) and immediately have somewhere to go.
			local.p[1] = 0 - 950 - (randomint 500)
			local.p[2] = 0 - 460

			local.mdl = "models/human/dday_29th_private"
			if((randomint 2) == 0){ local.mdl = "models/human/dday_ranger_private" }
			local.a = spawn local.mdl gun "m1 garand"
			if(local.a != NULL && local.a != NIL){		//entity-pool guard
				level.coop_beachChargeLive++
				local.a.coop_noChatter = 1
				local.a threatbias ignoreme
				local.a notarget 1
				local.a dontdropweapons
				local.a notsolid
				local.a.isinsequence = 1
				local.a.isbusy = 1
				local.a.origin = local.p + (0 0 80)
				local.a.coop_chargeCounted = 1		//so coop_chargeRun knows to give the slot back
				if(waitthread coop_dryGround local.a){
					local.a thread coop_chargeRun local.gap
				}else{
					level.coop_beachChargeLive--		//removed - give the slot straight back
				}
			}
			local.k++
			wait ( 0.4 + ( randomfloat 0.8 ) )
		}
	}
	println("^~^~^ BEACHCHARGE stood down live=" + level.coop_beachChargeLive)
}end


//=========================================================================
//[user 2026-09-01, bug-2255] AN ACTOR MUST NEVER END UP UNDER THE SEA.
//
//The user sent a screenshot taken from under the waterline: three riflemen standing on the seabed in a
//ready stance, with the surface above them. Every actor placement in this file ends `droptofloor`, and
//droptofloor does exactly what it says - it finds the FLOOR. Off a beach that floor is the seabed, and
//water is not solid, so a man dropped over the sea does not float, wade or drown: he stands on the
//bottom, several feet under, perfectly composed.
//
//THE WATERLINE IS A KNOWN NUMBER on this map, not a guess: -496 is the height every baked
//fx_mortar_water anchor sits at, which is why coop_runInShelling already uses it as "the map author's
//own water-impact height". A man whose FEET are more than ~64 units below that is chest-deep or worse.
//Wading at the edge is wanted and is left alone.
//
//So: drop him, and while he is too deep, step him SHOREWARD (+Y) and drop again. If several steps still
//cannot find dry ground he is somewhere no infantryman belongs and is removed - returns 0 so the caller
//can decide whether that slot becomes gore instead.
//
//USE THIS INSTEAD OF A BARE droptofloor for anything that is supposed to look alive.
//=========================================================================
coop_dryGround local.ent:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end 0 }
	local.r = waitthread coop_placeGround local.ent 45
	end local.r
}end

//=========================================================================
//[user, bug-2264] THE ONE PLACEMENT PRIMITIVE: dry sand, and not on a tank trap.
//
//This had been TWO half-answers that each missed the other's case, and the user reported both back:
//"Still have floating allies on top of obstacles and floating blood in areas", and "some guys just
//standing in the water doing nothing".
//
//  * coop_dryGround tested DEPTH only. An actor droptofloor'd onto a hedgehog is not in water, so it
//    passed, and the man stood on the tank trap.
//  * coop_dropClear tested OBSTACLES only, and was wired into six prop sites and no actor site at all.
//
//And the depth threshold was wrong. It used z < -560, picked by eye. The beach profile, measured from
//the z of the 229 obstacle statics that sit ON the sand:
//
//    y -2800..-1600   z -566..-598     submerged tidal flat
//    y -1600..-1200   z -550           wading, thigh deep
//    y -1200..-800    z -510           shallow, ankle deep
//    y  -800..0       z -492           the water's edge (surface is -496)
//    y     0..1200    z -480..-489     dry sand, rising
//    shingle markers  z -412..-452     dry sand at the seawall
//
//So dry land starts around y -400, and -560 only caught men who were fully submerged. -520 is the
//real line: below it a man is at least knee deep, which is fine for two strides out of a boat and
//wrong for anything that stands still.
//
//ORDER MATTERS: nudge XY clear of obstacles FIRST, then drop, then walk shoreward if wet - because a
//shoreward step can land you on a hedgehog, so the obstacle test has to be re-run each time.
//=========================================================================
coop_placeGround local.ent local.pad:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end 0 }
	if(local.pad == NIL){ local.pad = 45 }

	local.i = 0
	while(local.i < 8){
		//--- clear of the beach obstacles before we drop
		local.p = waitthread coop_dropSpot local.ent.origin local.pad
		if(local.p == NULL){
			local.ent remove
			end 0
		}
		local.ent.origin = local.p
		local.ent droptofloor

		//--- PERCHED? [bug-2268] The decisive test, and the only one that catches a spawned entity.
		//A Higgins hull, a crate we placed ourselves, a corpse, another actor - none of those are in
		//the static table and none ever could be. Ask where the ground should be instead: come to rest
		//more than 40 units above it and you are on top of SOMETHING.
		//
		//[bug-2282] TWO SOURCES FOR "where the ground should be", nearest first. A static model sits ON
		//the ground, so one within 500 units is a LOCAL reference that is valid anywhere - including the
		//bluff, where the y-band profile is useless and this test used to be switched off entirely. That
		//gap is why rifles were sitting on the barbed wire at y 3200-5900. The band profile is now only
		//the fallback, for open sand with no static near it.
		local.perched = 0
		local.want = waitthread coop_nearGroundZ local.ent.origin[0] local.ent.origin[1]
		if(local.want == NIL && local.ent.origin[1] < 2400){
			local.want = waitthread coop_groundZ local.ent.origin[1]
		}
		if(local.want != NIL){
			//[user 2026-09-02, bug-2327] 40 -> 20. "still have plenty of floating blood I think it
			//might be over objects weve placed or maybe even actors."
			//
			//The test was right and the number was wrong. A dropped ammo crate stands about 25-30
			//units tall and a prone corpse less, so a decal resting ON one sat only ~28 above the
			//sand - comfortably inside a 40-unit tolerance, and passed as "on the ground". 20 still
			//clears the sand's own undulation (the nearest-static reference is local, so it tracks
			//the terrain rather than assuming it is flat) while catching anything a man could have
			//put there.
			//[user 2026-09-02, bug-2370] 20 -> 12. "some of your actors are spawned near the barbed
			//wire and are glitching out." Same defect as the wreckage field, same measurement: I
			//instrumented every prop placement on this beach and the perched ones came to rest 18 to
			//38 units above the expected ground, on obstacle and wire clip hulls. A 20-unit
			//tolerance passes everything from 20 upward - i.e. most of them. 12 is the measured
			//value that separates a real seating (within about 10 either way of the datum, which is
			//the datum's own noise) from something standing on the wire.
			//[bug-2370] 12 -> 8, matching coop_wreckDrop. There is one measured answer for "is this
			//thing standing on something" on this beach and both placement paths should use it.
			if(local.ent.origin[2] > ( local.want + 8 )){ local.perched = 1 }
		}

		//--- and on dry enough ground
		if(local.perched == 0 && local.ent.origin[2] >= ( 0 - 520 )){ end 1 }

		local.q = local.ent.origin
		if(local.perched == 1){
			//shove off whatever it is and try again nearby, rather than walking all the way inland
			local.a = ( local.i * 97 )
			local.q[0] = local.q[0] + ( cos(local.a) * 150 )
			local.q[1] = local.q[1] + ( sin(local.a) * 150 )
			local.q[2] = local.q[2] + 120
		}else{
			//too deep - step shoreward
			local.q[1] = local.q[1] + 340
			local.q[2] = local.q[2] + 300
		}
		local.ent.origin = local.q
		local.i++
	}

	local.ent remove
	end 0
}end


//=========================================================================
//[user 2026-09-01] MEN DOING A JOB, NOT JUST DYING.
//
//"if we could have some allied actors we are spawning in do animations like moving ammo crates around
//and dropping them off, etc. that would be great and add a sense of realism... We need more people
//actually doing things."
//
//A carrying party. Each man walks from a beached boat to a dump point with an ammo crate in his hands,
//puts it down - a REAL crate that stays on the sand - and walks back for the next one. Over a few
//minutes the dump grows, which is the part that sells it: the beach is not just decorated, it is being
//worked, and it looks different later than it did when you landed.
//
//NO NEW ANIMATION IS INVENTED. The crate is `attachmodel`ed to tag_weapon_left, which is the same tag
//and the same command retail uses to put a canteen and a reload magazine in a man's hand
//(aihandler.scr:616 documents the frame-command form). The ordinary run cycle plus a crate in the hands
//reads as carrying at gameplay distance; a bespoke carry animation does not exist on these models and
//guessing an alias name is how a whole vignette silently does nothing.
//
//The crates are the mod's own models/coop_build/box_crate_*.tik - already precached by build mode and
//already shipped in our pk3, so no retail asset is touched and nothing can be missing.
//=========================================================================
coop_beachWorkParty:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_workPartyOn == NIL){ level.coop_workPartyOn = 1 }
	if(!level.coop_workPartyOn){ end }
	if(level.coop_workPartyDone == 1){ end }
	level.coop_workPartyDone = 1

	//not while the player is still in the boat - a supply dump forming on an unsecured beach is the
	//wrong picture, and nobody is there to see it
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling == 1){
		wait 1
		local.t = local.t + 1
	}
	wait 8

	//three parties, spread the width of the beach so the work is not all in one corner - the user:
	//"Tons of open beach where no one is spawning, no higins boats and no one pushing"
	//[bug-2261] PAY FOR YOUR OWN SLOTS. This spends six coop_vigSpawn slots and never raised the cap,
	//so it only worked because coop_flankLandings' +26 happens to go unspent (it spawns directly). The
	//day anyone routes that through coop_vigSpawn, all six carriers return NULL and the whole crate
	//system vanishes with no error - the same silent starvation coop_boatBurn was already bitten by.
	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 4 }

	//[user 2026-09-01] "we need to cap how many total crates can be spawned" - four men making up to
	//fourteen round trips each is 56 crates left on the sand, every one a live entity out of the pool
	//that bug-2283 just had to be widened for. Twenty is a supply dump; the rest would be a warehouse.
	//
	//[user 2026-09-01, bug-2284] AND PAST THE CAP THE OLDEST ONE DESPAWNS, rather than the party simply
	//stopping. "past the cap just have some of the dropped crates despawn?" - which is the better
	//design, and not only because the men keep producing: a dump that freezes at twenty is a static
	//prop the player walks past twice and stops seeing, while one that keeps turning over is a beach
	//still being worked. A RING, not a queue: slot = madeSoFar % cap, so the entity count is exactly
	//coop_crateCap forever and the crate that goes is always the one that has been there longest.
	if(level.coop_crateCap == NIL){ level.coop_crateCap = 20 }
	if(level.coop_cratesMade == NIL){ level.coop_cratesMade = 0 }

	//[user, bug-2265] UP THE BEACH, NOT IN THE SURF. The user: "some guys just standing in the water
	//doing nothing, and running around without pushing up the beach", and then "is the ammo crate
	//dropping troops here?" - yes, it was.
	//
	//The first pass put the boats at y -1450..-1750 and the dumps only 900-1400 further on, so the whole
	//carry happened between y -1750 and y -100. Measured against the beach profile (see coop_placeGround)
	//that band is z -510..-586 - i.e. the entire work party was ankle-to-thigh deep in the sea, walking
	//in circles. It read exactly as badly as it sounds.
	//
	//Now the pickup is at the tide line and the dump is up by the shingle, which is a ~1500-unit haul
	//across dry sand that crosses the player's own route inland. That is the shot: men carrying boxes
	//THROUGH the fight, not paddling below it.
	//[user 2026-09-01] THE USER'S LAST TWO VIEWPOS CAPTURES: "have them move to and from these two
	//points with crates". So there is ONE haul, not three parties - from (-1643 -1019) across to
	//(1715 -787), about 3,360 units, which crosses the whole width of the beach in front of the player.
	//Four men work it so the route is never empty. Both z values are his eye height less ~64.
	local.n = 0
	local.n++; local.px[local.n] = 0 - 1643; local.py[local.n] = 0 - 1019

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.px[local.i]
		local.p[1] = local.py[local.i]
		local.p[2] = 0 - 451

		//the far end of the haul - the user's fifth capture
		local.d = (0 0 0)
		local.d[0] = 1715
		local.d[1] = 0 - 787
		local.d[2] = 0 - 401

		//four on the route, staggered so they are spread along it rather than walking in a block
		local.k = 0
		while(local.k < 4){
			local.q = local.p
			local.q[0] = local.q[0] + ((randomint 180) - 90)
			local.q[1] = local.q[1] + ((randomint 180) - 90)
			local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.q 0
			if(local.a != NULL && local.a != NIL){
				local.a thread coop_carryCrate local.p local.d
			}
			local.k++
			wait ( 3 + ( randomfloat 4 ) )
		}
		local.i++
	}
	println("^~^~^ WORKPARTY dumps=" + local.n)
}end

//One man on the carry. Boat -> dump with a crate, put it down, walk back, repeat.
//=========================================================================
coop_carryCrate local.from local.to:{
//=========================================================================
	//[bug-2281] this man has a job; stop the default beach behaviour on him
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }
	wait 0.1
	//[user, bug-2274] THE AUTHORED CRATE CARRY, NOT AN IMITATION OF ONE.
	//
	//The user: "if these are the crates they are moving they are tiny... there are actual animations to
	//move giant crates from other missions, thats what I was suggesting. and why would they move them up
	//so far onto the beach, maybe have them move it across the beach towards the shoreline instead."
	//
	//All three complaints, and all three were mine:
	//
	//  * THE CRATE. models/coop_build/box_crate_*.tik are BUILD-MODE blocks; the client log measured one
	//    at ext [4.8 4.8 4.8]. The real prop is models/miscobj/crate_carry.tik and we do not even name
	//    it here - crate_pickup2 carries `enter attachmodel models/miscobj/crate_carry.tik
	//    tag_weapon_right` as a frame command, so the animation puts it in his hands itself.
	//  * THE ANIMATION. The first pass used walk_carrying_*, which the trilogy sweep established is the
	//    two-man CASUALTY carry, not a crate carry. The crate set is crate_pickup1 -> crate_pickup2 ->
	//    crate_walk -> crate_putdown1 -> crate_putdown2, in crate_carry.tik, now $include'd for this map.
	//  * THE DIRECTION. Hauling inland was backwards. Supplies come OFF the boats, so the dump is up on
	//    the dry sand and the party works DOWN to the water and back, across the player's own advance.
	//
	//MOVEMENT IS `moveto`, NOT `runto`, and that is the whole reason the walk cycle reads: moveto takes
	//(anim, dest) and plays the named anim script for the entire leg (anim/crate_walk.scr is two lines -
	//`self setanim crate_walk` / `pause`). The destination is still an info_waypoint rather than a bare
	//vector, for the bug-2246 reason - MoveToPatrolCurrentNode's waypoint branch uses ANIM_MODE_DEST and
	//never touches the pathnode graph, which the out-of-noded sand does not have.
	local.wp = spawn info_waypoint
	if(local.wp == NULL || local.wp == NIL){ end }

	//coop_vigSpawn parks every vignette actor on disable_ai, which is right for a man holding a pose and
	//wrong for one who has to walk somewhere
	self exec global/enable_ai.scr

	local.runs = 0
	while(isalive self && local.runs < 14 && level.coop_workPartyOn){
		//--- squat, take hold, stand up with it. crate_pickup2's frame command attaches the crate.
		self anim crate_pickup1
		self waittill animdone
		if(!isalive self){ break }
		self anim crate_pickup2
		self waittill animdone
		if(!isalive self){ break }

		//--- carry it down to the water, laden walk cycle for the whole leg
		//[user 2026-09-01, bug-2290] THE MEN THE USER ACTUALLY WATCHED GO UNDER, AND WHY IT WAS THEM.
		//
		//This haul is (-1643 -1019) to (1715 -787): 3,358 units straight across the obstacle belt. The
		//old first leg was HALF of that - 1,679 units - with the marker's z copied off the carrier and
		//never touched again, and measured against the static table that one line passes 0.3 units from
		//the centre of a hedgehog at (-55 -909), 10 from another at (961 -829), and inside the
		//footprint of six statics in all. Four men walked it up to 112 times.
		//
		//Two more things made it the carriers rather than anyone else. `waittill movedone` has no
		//timeout, and movedone cannot fire while THINKSTATE_NOCLIP owns the actor - which is the 77-79s
		//cluster in the log, a man hanging here for the whole length of a 16,384-unit dive. And
		//coop_carryCrate has no stuck check and never re-grounds, unlike coop_flankWalk, so once a
		//carrier was under the sand nothing ever brought him back.
		//
		//Now: short routed hops, marker z off the ground, a bounded wait instead of movedone, and the
		//under-map check each hop. `moveto` still carries the laden walk cycle for the whole leg, so
		//re-issuing it every couple of seconds costs nothing visually.
		local.leg = 0
		while(local.leg < 30 && isalive self){
			local.moved = waitthread coop_advanceLeg self local.wp local.to 300 34 "anim/crate_walk.scr"
			if(local.moved == 0){ wait 0.6 }
			wait ( 1.8 + ( randomfloat 0.8 ) )
			if(self == NULL || self == NIL){ break }
			waitthread coop_underCheck self
			if(!isalive self){ break }
			if(vector_length( self.origin - local.to ) < 220){ break }
			local.leg++
		}
		if(!isalive self){ break }

		//--- kneel and set it down. crate_putdown2 removes the attached crate on its own.
		self anim crate_putdown1
		self waittill animdone
		self anim crate_putdown2
		self waittill animdone

		//and a real box is left where he put it, so the dump grows over the mission
		//[bug-2284] THE RING. Take the slot this crate belongs in, retire whatever is standing in it,
		//then put the new one there. Removing BEFORE the spawn also means the pool never has to hold
		//cap+1 crates even for an instant, which matters on a map that just ran itself out of edicts.
		local.slot = ( level.coop_cratesMade % level.coop_crateCap ) + 1
		local.old = level.coop_crateRing[local.slot]

		//...but NOT WHILE SOMEBODY IS LOOKING AT IT. A crate blinking out of existence in front of the
		//player is worse than a slightly larger dump, so if the one due to retire is within 700 units of
		//a living player this trip is skipped entirely - the man still walks the route, still plays the
		//whole pick-up/carry/put-down set, he simply does not leave a box. The count stays bounded
		//because nothing was added either, and the next trip usually finds the coast clear.
		local.watched = 0
		if(local.old != NULL && local.old != NIL){
			local.i = 1
			while($player != NULL && $player != NIL && local.i <= $player.size){
				if($player[local.i] != NULL && $player[local.i].health > 0){
					if(vector_length( $player[local.i].origin - local.old.origin ) < 700){ local.watched = 1 }
				}
				local.i++
			}
		}

		local.box = NULL
		if(local.watched == 0){
			if(local.old != NULL && local.old != NIL){ local.old remove }
			level.coop_crateRing[local.slot] = NULL
			local.box = spawn script_model model "models/miscobj/crate_carry.tik"
		}
		if(local.box != NULL && local.box != NIL){			//entity-pool guard
			local.bp = (0 0 0)
			local.bp[0] = self.origin[0] + ((randomint 160) - 80)
			local.bp[1] = self.origin[1] + ((randomint 160) - 80)
			local.bp[2] = self.origin[2] + 30
			local.box.origin = local.bp
			local.box.angles = (0 (randomint 360) 0)
			local.box notsolid
			if(waitthread coop_placeGround local.box 90){
				//[bug-2327] AND THE CRATE JOINS THE OBSTACLE TABLE. The generated table comes from the
				//BSP's static models, so it cannot know about anything we spawn at runtime - which is
				//exactly how blood ended up on top of the crates this system drops. Registering it
				//means every later placement routes around it instead of landing on it.
				waitthread coop_registerObstacle local.box.origin[0] local.box.origin[1] 44 local.box.origin[2]
				//only a crate that actually found ground goes in the ring - one that could not be
				//placed was removed by coop_placeGround and must not be recorded as standing
				level.coop_crateRing[local.slot] = local.box
				level.coop_cratesMade++
			}else{
				local.box = NULL
			}
		}

		//--- and back up to the dump for the next one
		//[bug-2290] the return leg, same treatment - it had the identical half-the-beach marker
		local.leg = 0
		while(local.leg < 30 && isalive self){
			local.moved = waitthread coop_advanceLeg self local.wp local.from 340 34
			if(local.moved == 0){ wait 0.6 }
			wait ( 1.6 + ( randomfloat 1.2 ) )
			if(self == NULL || self == NIL){ break }
			waitthread coop_underCheck self
			if(!isalive self){ break }
			if(vector_length( self.origin - local.from ) < 220){ break }
			local.leg++
		}
		local.runs++
	}

	if(local.wp != NULL && local.wp != NIL){ local.wp remove }
	//tag_weapon_RIGHT - that is the tag crate_pickup2 attaches to, and a leak here welds a crate to a
	//dead man's hand for the rest of the mission
	if(self != NULL && self != NIL){ self removeattachedmodel "tag_weapon_right" }

	//[user 2026-09-01, bug-2288] AND HE IS HANDED BACK. Every job on this beach ends eventually - the
	//carrier runs out of trips, the welder's system is switched off, the loop hits its cap - and when it
	//does the man was being left standing with coop_behaveOff still 1, which is precisely the flag that
	//stops coop_beachBehave from ever picking him up. Clearing it and re-threading the default is what
	//makes "no ally ever just stands" actually hold, rather than holding only until his job finishes.
	if(self != NULL && self != NIL){
		if(isalive self){
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end


//The Sherman's geometric centre in world space. See the note at the mask in coop_shermanShelled: the
//entity origin is at the rear of the mesh, so anything meant to look like it is happening TO the tank
//has to be offset 132 units along the hull's own -X, rotated by its yaw.
//=========================================================================
coop_shermanBody local.tank local.pos:{
//=========================================================================
	local.yaw = 0
	if(local.tank != NULL && local.tank != NIL){ local.yaw = local.tank.angles[1] }
	local.p = local.pos
	local.p[0] = local.p[0] - ( 132 * cos(local.yaw) )
	local.p[1] = local.p[1] - ( 132 * sin(local.yaw) )
	end local.p
}end


//=========================================================================
//[user, bug-2262] NOTHING GETS LEFT SITTING ON A TANK TRAP.
//
//The user, more than once and over months: "We still have some blood floating over the tanktraps on
//omaha." Two previous attempts fixed it by hand-picking coordinates and writing the margin in a
//COMMENT (bug-2209, then bug-2256, where the comment had become a claim nobody had measured and three
//of four new boats were sitting through a hedgehog). Neither put a test in the code, so every new
//placement site added since re-armed the bug.
//
//WHY IT HAPPENS: Entity::droptofloor (fgame/entity.cpp:2669) is a BOX trace against clipmask with
//range MAP_SIZE. It stops on the first collidable thing below, and the tidal flat is carpeted with
//collidable statics. A pool dropped over a hedgehog lands ON the hedgehog.
//
//maps/m3l1a/obstacles.scr is the generated table - all 229 hedgehogs, minepoles, wire runs and
//Belgian-gate ramps with their real footprint radii, extracted from LUMP_STATICMODELDEF by
//docs/tools/gen_m3l1a_obstacles.py. The radius stored is the OBSTACLE's; the caller passes a pad for
//half of whatever it is placing, because origin-to-origin is what made ">=70u from a hedgehog" overlap
//a 64u-radius hedgehog.
//
//COST: the X early-out means a typical call touches a handful of the 229 rather than all of them.
//=========================================================================
coop_dropClear local.x local.y local.pad:{
//=========================================================================
	if(level.coop_obstN == NIL){ end 1 }			//table not loaded - never block placement
	if(local.pad == NIL){ local.pad = 40 }

	local.i = 1
	while(local.i <= level.coop_obstN){
		local.r = level.coop_obstR[local.i] + local.pad
		local.dx = local.x - level.coop_obstX[local.i]
		if(local.dx < 0){ local.dx = 0 - local.dx }
		if(local.dx < local.r){
			local.dy = local.y - level.coop_obstY[local.i]
			if(local.dy < 0){ local.dy = 0 - local.dy }
			if(local.dy < local.r){
				if((( local.dx * local.dx ) + ( local.dy * local.dy )) < ( local.r * local.r )){ end 0 }
			}
		}
		local.i++
	}
	end 1
}end

//The same test, but it MOVES rather than refuses. For anything whose position is meaningful - a pool
//where a man actually fell, a crate a carrier actually put down - shifting it a few feet is right and
//deleting it is not. Returns the adjusted vector, or NULL if twelve tries out to ~330 units all land on
//something, in which case the caller should skip: that spot is a thicket.
//=========================================================================
coop_dropSpot local.pos local.pad:{
//=========================================================================
	if(waitthread coop_dropClear local.pos[0] local.pos[1] local.pad){ end local.pos }

	local.i = 0
	while(local.i < 12){
		//a widening spiral rather than a ring, so a dense patch is escaped rather than circled
		local.a = local.i * 137
		local.r = 90 + ( local.i * 22 )
		local.p = local.pos
		local.p[0] = local.p[0] + ( cos(local.a) * local.r )
		local.p[1] = local.p[1] + ( sin(local.a) * local.r )
		if(waitthread coop_dropClear local.p[0] local.p[1] local.pad){ end local.p }
		local.i++
	}
	end NULL
}end

//Load the generated table. Called once from m3l1a.scr::main BEFORE anything places anything.
//=========================================================================
coop_obstInit:{
//=========================================================================
	if(level.coop_obstN != NIL){ end }
	waitthread maps/m3l1a/obstacles.scr::init
	println("^~^~^ OBSTACLES loaded=" + level.coop_obstN)
}end


//=========================================================================
//[user 2026-09-01, bug-2290] THE MEN WARPING UNDER THE BEACH.
//
//"I see whats happening to the box carrying soldiers, they are warping under the map when they run
//into the tank traps as they are trying to path... thats probably happening to other soldiers too"
//
//He is right, and it is one engine branch. Every coop mover on this map is ordered with
//`runto`/`moveto <info_waypoint>`, which is the ANIM_MODE_DEST branch of
//Actor::MoveToPatrolCurrentNode (fgame/actor.cpp:6620-6629). That branch was chosen deliberately and
//is still correct: this beach has no pathnodes below y 2768, so the other branch (SetPath, a graph
//search) cannot move anybody here at all.
//
//But ANIM_MODE_DEST has exactly ONE response to being blocked, and it is not stop, slide or re-path.
//fgame/actor.cpp:3441-3453, on the FIRST frame mm->hit_obstacle goes true - no counter, no timeout:
//
//    trace = G_Trace(m_Dest, PLAYER_BASE_MIN, PLAYER_BASE_MAX,
//                    m_Dest - Vector(0, 0, 16384), NULL, MASK_MOVEINFO, ...);
//    DoFailSafeMove(trace.endpos);
//
//DoFailSafeMove (actor.cpp:3377-3384) puts the actor into THINKSTATE_NOCLIP, and Actor::Think_NoClip
//(actor_noclip.cpp:50-66) then flies him to that point with SafeSetOrigin - a bare setOrigin, no
//trace, no ground, groundentity NULL. Collision is not merely bypassed for one write: Think_NoClip
//does not call PostThink, so DoMove and MmoveSingle never run at all while the state is up. Touching
//a tank trap is literally the trigger for moving with collision switched off.
//
//AND THE DESTINATION OF THAT FLIGHT WAS OUR FAULT, NOT THE ENGINE'S. That trace starts at the
//WAYPOINT. Every mover in this file built its marker as `local.t = self.origin` and then edited only
//[0] and [1], so the marker sat at the man's CURRENT height at a point up to 1,679 units away. MOHAA
//terrain is a 32-unit-thick collision shell (CM_CheckStartInsideTerrain, qcommon/cm_terrain.c:912-915
//- `fDot + 32 >= plane[3]`) and this beach IS terrain, 273 patches in the BSP's lump 22. A marker
//buried more than 32 units misses the sand entirely on the way down, CM_Trace keeps fraction 1 and
//copies the raw end point (qcommon/cm_trace.c:1398-1400), and the failsafe destination becomes
//waypoint-minus-16384. That is the warp, exactly as reported. It is in the 2026-09-01 qconsole 232
//times, and the paired durations are bimodal: a crowd under 5s, NOTHING between 20s and 60s, then a
//cluster at 77-79s. 16384 / 78s = 210 u/s, which is a run cycle. A constant-length descent.
//
//AND IT LATCHES. Once he is under the sand the next turn of the same loop reads `local.t =
//self.origin` again, inherits the underground z, and buries the next marker deeper.
//
//FOUR THINGS FIX IT, ALL SCRIPT-SIDE:
//
//  1. NEVER AUTHOR A BURIED MARKER - coop_legZ. The waypoint's z is read off the GROUND and lifted
//     clear, never copied off the man. This is FREE, and that is not a guess: grep the engine for
//     m_Dest and there are exactly two reads - the failsafe trace (actor.cpp:3443/3446) and
//     VectorSub2D at actor.cpp:5767, which takes x and y only. The arrival test is 2D as well
//     (actor.cpp:6591-6597, `fabs(delta[0]) < 16 && fabs(delta[1]) < 16`). So a waypoint's z changes
//     NOTHING about how a man walks or when he arrives. It changes only where that trace starts.
//     Started above the sand the trace HITS the sand, and the failsafe does what it was written to
//     do: drop him at his own destination. The line that was burying men now rescues them - a man
//     already underground gets a marker above the surface, so his next failsafe lifts him out.
//
//  2. DO NOT WALK INTO THE TRAP - coop_legClear / coop_pickLeg. The obstacle table is already loaded
//     (obstacles.scr: 401 statics with their own radii, used by coop_dropClear since bug-2262).
//     coop_legClear is that same test against a SEGMENT instead of a point, exact rather than
//     sampled, one pass over the table. coop_pickLeg then swings the bearing out to +/-100 degrees
//     and halves the reach until the corridor is clear.
//
//  3. SHORT HOPS. Legs are capped near 340 units instead of 420-800, or half the beach in the
//     carriers' case. Two reasons beyond avoidance: a short leg is a corridor you can actually
//     clear, and the noclip flight - which still happens whenever two of fifty actors bump, because
//     hit_temp_obstacle is raised for players and doors only (fgame/g_mmove.cpp:99-101) and NOT for
//     another AI - is a straight 3D chord. Over 300 units on this sand a chord hugs the ground. Over
//     1,679 it cuts through a berm.
//
//  4. A LAST LINE - coop_underCheck at each leg boundary. If a man is somehow more than 220 below
//     where the ground should be he is put back on it. 220 is well past anything the height estimate
//     can be wrong by (the y-band table is about +/-25 on the flat, and coop_nearGroundZ returns a
//     real static's own height) and far short of 16384, so it cannot fire on a man in a shell crater.
//
//COST. One leg costs one pass over the 401-row table per candidate bearing, and the bounding-box
//reject discards almost all of it: a 340-unit leg has a box about 600 units on a side against a
//beach 8,000 wide, so the inner arithmetic runs on single figures of rows. Fifty actors taking a leg
//every 2.5s is 20 legs/s, and the straight bearing is clear most of the time, so the steady-state
//cost is on the order of one coop_dropClear per leg. coop_dropSpot already spends twelve of those
//per placement and ships.
//=========================================================================


//Is the straight corridor from (ax,ay) to (bx,by) clear of every beach obstacle by local.pad?
//
//Exact, not sampled: for each obstacle this takes the closest point ON THE SEGMENT and compares it
//against radius+pad, so a trap cannot slip between two sample points. The bounding-box reject is
//widened by 130 - the largest radius in obstacles.scr - so it is conservative by construction and
//can never discard an obstacle the exact test would have hit.
//=========================================================================
coop_legClear local.ax local.ay local.bx local.by local.pad:{
//=========================================================================
	if(level.coop_obstN == NIL){ end 1 }			//table not loaded - never block movement
	if(local.pad == NIL){ local.pad = 34 }

	local.vx = local.bx - local.ax
	local.vy = local.by - local.ay
	local.len2 = ( local.vx * local.vx ) + ( local.vy * local.vy )
	if(local.len2 < 1){
		local.c = waitthread coop_dropClear local.ax local.ay local.pad
		end local.c
	}

	local.lox = local.ax
	local.hix = local.bx
	if(local.lox > local.hix){
		local.lox = local.bx
		local.hix = local.ax
	}
	local.loy = local.ay
	local.hiy = local.by
	if(local.loy > local.hiy){
		local.loy = local.by
		local.hiy = local.ay
	}
	local.marg = 130 + local.pad
	local.lox = local.lox - local.marg
	local.hix = local.hix + local.marg
	local.loy = local.loy - local.marg
	local.hiy = local.hiy + local.marg

	local.i = 1
	while(local.i <= level.coop_obstN){
		local.ox = level.coop_obstX[local.i]
		if(local.ox > local.lox && local.ox < local.hix){
			local.oy = level.coop_obstY[local.i]
			if(local.oy > local.loy && local.oy < local.hiy){
				local.t = ((( local.ox - local.ax ) * local.vx) + (( local.oy - local.ay ) * local.vy)) / local.len2
				if(local.t < 0){ local.t = 0 }
				if(local.t > 1){ local.t = 1 }
				local.dx = ( local.ax + ( local.vx * local.t ) ) - local.ox
				local.dy = ( local.ay + ( local.vy * local.t ) ) - local.oy
				local.r = level.coop_obstR[local.i] + local.pad
				if((( local.dx * local.dx ) + ( local.dy * local.dy )) < ( local.r * local.r )){ end 0 }
			}
		}
		local.i++
	}
	end 1
}end


//Pick the next leg. Aim at local.goal, then swing the bearing out and shorten the reach until the
//corridor is clear of tank traps. Returns the destination xy (z is the caller's job, through
//coop_legZ), or NULL when even a short sidestep is boxed in.
//
//The ladder is 0, +/-30, +/-60, +/-100, then the same again at half reach. Alternating signs so a man
//in a gap takes whichever side is open rather than always the same one; 100 rather than 90 so the
//last resort actually LOSES ground on the goal, which is what backs a man out of a thicket instead
//of sliding him along its face forever.
//
//THE WATER GUARD. A deflection is allowed to cost him progress but not to walk him into the sea, so
//a man whose ground is above the -520 line (coop_placeGround's measured wading threshold) will not
//accept a candidate below it. Without this the +/-100 rungs would happily send the crate party back
//into the surf, which is the exact complaint bug-2265 was about.
//=========================================================================
coop_pickLeg local.from local.goal local.reach local.pad:{
//=========================================================================
	if(local.reach == NIL){ local.reach = 340 }
	if(local.pad == NIL){ local.pad = 34 }

	local.dir = (0 0 0)
	local.dir[0] = local.goal[0] - local.from[0]
	local.dir[1] = local.goal[1] - local.from[1]
	local.gl = vector_length local.dir
	if(local.gl < 1){ end NULL }
	local.dir = vector_normalize local.dir

	local.dry = 0
	local.fz = waitthread coop_groundZ local.from[1]
	if(local.fz > ( 0 - 520 )){ local.dry = 1 }

	//[bug-2290] JITTER, AND IT IS LOAD-BEARING - do not "tidy" it away. A memoryless steerer with a
	//fixed ladder walks straight into limit cycles: simulated against the real 401-row table, a
	//carrier crossing the haul reached the far end on 17 round trips out of 280, because he ping-ponged
	//between two points either side of the hedgehog at (961 -829) forever, taking rung -60 and rung
	//+100 on alternate legs for the rest of the mission. That is not a crash, which is exactly why it
	//would have shipped: it looks like men milling about. Jittering the reach and each rung breaks the
	//symmetry, and the same simulation then completes 386 of 392. It also happens to look better -
	//nobody walks a beach on exact 300-unit bearings.
	local.ring = 0
	while(local.ring < 2){
		local.rr = local.reach
		if(local.ring == 1){ local.rr = local.reach / 2 }
		local.rr = local.rr * ( 0.75 + ( randomfloat 0.5 ) )
		if(local.rr > local.gl){ local.rr = local.gl }

		local.k = 0
		while(local.k < 7){
			local.a = 0
			if(local.k == 1){ local.a = 30 }
			if(local.k == 2){ local.a = 0 - 30 }
			if(local.k == 3){ local.a = 60 }
			if(local.k == 4){ local.a = 0 - 60 }
			if(local.k == 5){ local.a = 100 }
			if(local.k == 6){ local.a = 0 - 100 }
			local.a = local.a + ( ( randomfloat 24 ) - 12 )

			//rotate the unit bearing by local.a. cos/sin take DEGREES here - the call form matches
			//global/hoveringplane.scr:127-128, and coop_lensSplashAt above uses the same one.
			local.ca = cos(local.a)
			local.sa = sin(local.a)
			local.p = (0 0 0)
			local.p[0] = local.from[0] + ( (( local.dir[0] * local.ca ) - ( local.dir[1] * local.sa )) * local.rr )
			local.p[1] = local.from[1] + ( (( local.dir[0] * local.sa ) + ( local.dir[1] * local.ca )) * local.rr )

			local.ok = 1
			if(local.dry == 1){
				local.pz = waitthread coop_groundZ local.p[1]
				if(local.pz < ( 0 - 520 )){ local.ok = 0 }
			}
			if(local.ok == 1){
				local.ok = waitthread coop_legClear local.from[0] local.from[1] local.p[0] local.p[1] local.pad
			}
			if(local.ok == 1){ end local.p }
			local.k++
		}
		local.ring++
	}

	//[user 2026-09-02, bug-2317] A MAN WHO CANNOT FIND A CLEAN LANE STILL MOVES.
	//
	//"the guys moving the crates are standing around and not moving" - with screenshots of carriers
	//frozen mid-haul holding a crate. Returning NULL here made coop_advanceLeg report 0, and the
	//caller's response to 0 is to wait and try again - from the SAME spot, with the same table, so it
	//fails identically. Thirty legs of that is over a minute of a man standing in the open holding an
	//ammo crate, which is exactly what was photographed.
	//
	//Standing still is never the right answer on this beach. Fourteen candidates failing means he is
	//boxed in by obstacles, and what a person does there is shuffle a short step and look again - so
	//that is what he does: a 90-unit hop, obstacle test dropped (at that range he cannot end up deep
	//inside anything, and the engine's own collision still stops him), dry-land test KEPT so nobody
	//shuffles into the sea. From the new spot the full ladder is retried next leg, and the jitter
	//above means it is not the same set of bearings twice.
	local.k = 0
	while(local.k < 7){
		local.a = 0
		if(local.k == 1){ local.a = 45 }
		if(local.k == 2){ local.a = 0 - 45 }
		if(local.k == 3){ local.a = 90 }
		if(local.k == 4){ local.a = 0 - 90 }
		if(local.k == 5){ local.a = 140 }
		if(local.k == 6){ local.a = 0 - 140 }
		local.a = local.a + ( ( randomfloat 30 ) - 15 )
		local.ca = cos(local.a)
		local.sa = sin(local.a)
		local.p = (0 0 0)
		local.p[0] = local.from[0] + ( (( local.dir[0] * local.ca ) - ( local.dir[1] * local.sa )) * 90 )
		local.p[1] = local.from[1] + ( (( local.dir[0] * local.sa ) + ( local.dir[1] * local.ca )) * 90 )
		local.ok = 1
		if(local.dry == 1){
			local.pz = waitthread coop_groundZ local.p[1]
			if(local.pz < ( 0 - 520 )){ local.ok = 0 }
		}
		if(local.ok == 1){ end local.p }
		local.k++
	}

	end NULL
}end


//The z a waypoint should carry: the ground under it, lifted clear. NEVER the man's own z.
//
//128 is not arbitrary. The failsafe trace is a flat 31x31 pad with NO height at all (PLAYER_BASE_MIN
//and PLAYER_BASE_MAX, fgame/navigate.cpp:85-86), so nothing about the hull rescues a marker that
//starts even slightly under the sand. Over-estimating the ground is free - the trace is 16384 long
//and still lands on the sand - while under-estimating by 32 is the whole bug. So bias hard upward:
//the nearest static's own height, or the y-band profile, or the man's own feet, whichever is
//HIGHEST, and then 128 more.
//
//Passing his feet in matters in the one case the table cannot see: a man standing on a boat deck or
//a wreck is above every ground estimate for his xy, and without it his marker would be authored
//under the deck he is standing on.
//=========================================================================
coop_legZ local.x local.y local.floor:{
//=========================================================================
	local.want = waitthread coop_nearGroundZ local.x local.y
	if(local.want == NIL){ local.want = waitthread coop_groundZ local.y }
	if(local.want == NIL){ local.want = 0 - 480 }
	if(local.floor != NIL && local.floor != NULL){
		if(local.floor > local.want){ local.want = local.floor }
	}
	end ( local.want + 128 )
}end


//Issue ONE leg toward local.goal. Returns 1 if an order went out, 0 if he is boxed in - in which
//case the caller should let him stand for a beat rather than re-order into the same wall.
//local.anim is NIL for a plain run, or an anim script for a laden walk (see coop_carryCrate).
//
//The actor is passed rather than taken from self, matching coop_placeGround: every caller here
//already holds him in a local, and an explicit argument cannot be lost to a self rebind.
//=========================================================================
coop_advanceLeg local.ent local.wp local.goal local.reach local.pad local.anim:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end 0 }
	if(local.wp == NULL || local.wp == NIL){ end 0 }

	local.p = waitthread coop_pickLeg local.ent.origin local.goal local.reach local.pad
	if(local.p == NULL){ end 0 }
	local.z = waitthread coop_legZ local.p[0] local.p[1] local.ent.origin[2]
	local.p[2] = local.z
	local.wp.origin = local.p

	if(local.anim == NIL || local.anim == NULL){
		local.ent runto local.wp
	}else{
		local.ent moveto local.anim local.wp
	}
	end 1
}end


//THE LAST LINE. With coop_legZ in place he should never get here, but fifty actors on a hot beach
//bump each other constantly and another AI raises hit_obstacle exactly like a tank trap does, so the
//failsafe still fires and it only takes one bad frame for something unforeseen to put a man under
//the sand. Returns 1 if he was rescued.
//
//NOTE WHAT THIS CANNOT DO. Writing his origin does not cancel THINKSTATE_NOCLIP - Think_NoClip keeps
//dragging him toward m_NoClipDest and there is no script command that ends a think state. What makes
//the rescue converge is coop_legZ: a marker above the sand makes every subsequent failsafe land ON
//the sand, so the glide is short and self-correcting instead of a 16,384-unit dive. This check is
//what catches him once that glide finishes.
//=========================================================================
coop_underCheck local.ent:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end 0 }
	if(!isalive local.ent){ end 0 }

	local.want = waitthread coop_nearGroundZ local.ent.origin[0] local.ent.origin[1]
	if(local.want == NIL){ local.want = waitthread coop_groundZ local.ent.origin[1] }
	if(local.want == NIL){ end 0 }
	if(local.ent.origin[2] > ( local.want - 220 )){ end 0 }

	println("^~^~^ UNDERMAP rescued z=" + local.ent.origin[2] + " want=" + local.want)

	//NOT coop_placeGround, deliberately. That primitive REMOVES whatever it cannot place, which is
	//right for a blood pool and wrong for a man in the middle of a job - and worse, a removal here
	//would hand every caller a NULL self one line later, in loops whose very next statement is
	//`isalive self`. So: put him back by hand, and if the sand around him is crowded leave him
	//standing rather than delete him. This function can never return a removed entity.
	local.p = waitthread coop_dropSpot local.ent.origin 45
	if(local.p == NULL){ local.p = local.ent.origin }
	local.z = waitthread coop_legZ local.p[0] local.p[1]
	local.p[2] = local.z
	local.ent.origin = local.p
	local.ent droptofloor
	end 1
}end



//=========================================================================
//[user, bug-2266] "Got several allies literally just standing out in the open on the beach too."
//
//THE SAME FAULT AS bug-2253, AND THIS IS THE THIRD TIME IT HAS SHIPPED. A vignette actor was posed with
//a bare `local.a anim <name>`. Most of these aliases are ONE-SHOTS: the animation plays, ANIMDONE fires,
//and the actor falls back to its idle - which for a standing human is standing. So a man who is supposed
//to be flat on his face behind a hedgehog spends about a second doing that and the rest of the mission
//at attention in the open.
//
//coop_vigKeep already existed for exactly this and only four of the twenty vignettes used it. Rather
//than add a fifth special case, this is the general form: play the alias, wait for it to finish, play it
//again. A genuinely LOOPING alias never fires animdone, so the thread simply parks there and the pose is
//held - which means the same call is correct for both kinds and nobody has to know which is which.
//
//It yields to the map: the instant retail's own ai_execute_todo claims an actor (isbusy / isinsequence)
//the hold stops, so pre-posed men can still be handed their real orders later.
//=========================================================================
coop_vigHold local.anim:{
//=========================================================================
	if(local.anim == NIL || local.anim == NULL){ end }
	if(self == NULL || self == NIL){ end }

	//[bug-2281] take ownership from coop_beachBehave, which coop_vigSpawn starts on every actor. Both
	//drive `anim` on the same man, so exactly one of them may be running.
	self.coop_behaveOff = 1
	wait 0.1

	local.n = 0
	while(local.n < 20000){
		if(self == NULL || self == NIL){ end }
		if(!isalive self){ end }
		//hand the actor back the moment the map wants him. [bug-2294] "hand back" has to mean it: a bare
		//`end` here left him with coop_behaveOff still 1, which is precisely the flag that stops
		//coop_beachBehave taking him, so the release WAS the strand. Both exits go through the tail now.
		if(self.isbusy == 1 && self.coop_vigOwned != 1){ break }
		if(self.coop_vigReleased == 1){ break }

		self.coop_hb = level.time			//[bug-2326]
		self anim local.anim
		self waittill animdone
		//a floor, so a missing or zero-length alias cannot spin this thread hot for the whole mission
		wait 0.1
		local.n++
	}

	//[bug-2281] AND IF THIS LOOP EVER ENDS, HE DOES NOT GO BACK TO STANDING. Whatever released him -
	//the iteration cap, a map todo that claimed and then dropped him - he is handed to the beach's
	//default behaviour rather than left at attention. See coop_beachBehave.
	if(self != NULL && self != NIL){
		if(isalive self){
			//[bug-2294] CLEAR IT FIRST. coop_beachBehave's own first statement is a coop_behaveOff check,
			//so re-threading it without clearing the flag starts a thread that immediately ends - which is
			//a strand wearing the costume of a handback. Every other job thread in this file clears it
			//before re-threading; this one, the general case, did not.
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end


//=========================================================================
//[user, bug-2268] HOW HIGH SHOULD THE SAND BE HERE?
//
//An obstacle table can only ever catch what is IN it. The user sent a screenshot of a rifleman standing
//on the gunwale of a wrecked Higgins - and a Higgins is a spawned ENTITY, not a static model, so no
//amount of extending the static table would ever have caught it. Same for crates we place ourselves,
//same for corpses, same for another actor.
//
//So stop enumerating what a thing might be standing ON, and ask instead where the ground IS. If a man
//comes to rest more than a body's height above the sand for his position, he is standing on something,
//whatever that something is.
//
//THE PROFILE IS MEASURED, not guessed: the mean z of the 365 ground-sitting static models on this map,
//bucketed by y in 400-unit bands. Within the beach the spread is tight (p10/p90 about +/-25 units),
//which is what makes the test safe.
//
//IT STOPS AT y 2400 ON PURPOSE. Above that the bluff climbs and the same y carries wildly different
//heights (the 4800..5200 band runs -344 to -553), so a single number per band stops meaning anything
//and the test would reject good placements. Everything the user has reported is on the flat.
//=========================================================================
coop_groundZ local.y:{
//=========================================================================
	if(local.y < ( 0 - 2600 )){ end ( 0 - 566 ) }
	if(local.y > 2200){ end ( 0 - 441 ) }

	local.n = 0
	local.n++; local.gy[local.n] = 0 - 2600; local.gz[local.n] = 0 - 566
	local.n++; local.gy[local.n] = 0 - 2200; local.gz[local.n] = 0 - 581
	local.n++; local.gy[local.n] = 0 - 1800; local.gz[local.n] = 0 - 586
	local.n++; local.gy[local.n] = 0 - 1400; local.gz[local.n] = 0 - 550
	local.n++; local.gy[local.n] = 0 - 1000; local.gz[local.n] = 0 - 504
	local.n++; local.gy[local.n] = 0 - 600;  local.gz[local.n] = 0 - 483
	local.n++; local.gy[local.n] = 0 - 200;  local.gz[local.n] = 0 - 479
	local.n++; local.gy[local.n] = 200;      local.gz[local.n] = 0 - 472
	local.n++; local.gy[local.n] = 600;      local.gz[local.n] = 0 - 473
	local.n++; local.gy[local.n] = 1000;     local.gz[local.n] = 0 - 466
	local.n++; local.gy[local.n] = 1400;     local.gz[local.n] = 0 - 466
	local.n++; local.gy[local.n] = 1800;     local.gz[local.n] = 0 - 457
	local.n++; local.gy[local.n] = 2200;     local.gz[local.n] = 0 - 441

	local.i = 2
	while(local.i <= local.n){
		if(local.y <= local.gy[local.i]){
			local.span = local.gy[local.i] - local.gy[local.i - 1]
			local.t = ( local.y - local.gy[local.i - 1] ) / local.span
			end ( local.gz[local.i - 1] + ( ( local.gz[local.i] - local.gz[local.i - 1] ) * local.t ) )
		}
		local.i++
	}
	end ( 0 - 441 )
}end


//=========================================================================
//[user, bug-2273] MEDICS WORKING ON CASUALTIES, BEHIND COVER.
//
//"if you need something else to do with some of them have them do the medic treatment stuff around a
//dead body behind cover."
//
//medic01 / medic02 / patient01 are retail's own, authored FOR THIS MAP in
//models/human/animation/scripted/level_m3l1.tik, and coop_beachVignettes already uses them for the pair
//at the waterline - so this is the proven recipe, moved to the places a casualty would actually be
//dragged to: tucked up against the shingle behind the obstacle belt, which is the only cover on Omaha.
//
//coop_vigHold rather than a bare `anim`: medic01/02 and patient01 are one-shots, and a bare call leaves
//the medic standing over the man he is meant to be treating - the exact fault that has now shipped three
//times (bug-2253, bug-2266).
//=========================================================================
coop_beachAidPosts:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_aidPostsOn == NIL){ level.coop_aidPostsOn = 1 }
	if(!level.coop_aidPostsOn){ end }
	if(level.coop_aidPostsDone == 1){ end }
	level.coop_aidPostsDone = 1

	local.n = 0
	local.n++; local.ax[local.n] = 0 - 2260; local.ay[local.n] = 640
	local.n++; local.ax[local.n] = 0 - 880;  local.ay[local.n] = 1180
	local.n++; local.ax[local.n] = 620;      local.ay[local.n] = 980
	local.n++; local.ax[local.n] = 2140;     local.ay[local.n] = 1320

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.ax[local.i]
		local.p[1] = local.ay[local.i]
		local.p[2] = 0 - 440

		local.q = local.p
		local.q[0] = local.q[0] + 44
		local.q[1] = local.q[1] + 26

		local.pat = waitthread coop_vigSpawn "models/human/dday_29th_private_patient" "none" local.p 0
		local.med = waitthread coop_vigSpawn "models/human/dday_ranger_medic" "none" local.q 90
		if(local.pat != NULL && local.pat != NIL && local.med != NULL && local.med != NIL){
			local.pat thread coop_vigHold "patient01"
			if((local.i % 2) == 0){ local.med thread coop_vigHold "medic01" }
			else{ local.med thread coop_vigHold "medic02" }
			local.made++

			//and a man down beside them who is past helping, with the blood to match
			local.r = local.p
			local.r[0] = local.r[0] - 70
			local.r[1] = local.r[1] - 40
			local.dead = waitthread coop_vigSpawn "models/human/dday_29th_private" "none" local.r (randomint 360)
			if(local.dead != NULL && local.dead != NIL){ local.dead thread coop_vigHold "fallen" }
			local.sl = spawn "models/fx/coop_bloodslick.tik"
			if(local.sl != NULL && local.sl != NIL){
				local.sl.origin = local.r + (0 0 40)
				local.sl.angles = (0 (randomint 360) 0)
				local.sl scale (0.5 + (randomfloat 0.4))
				local.sl notsolid
				waitthread coop_placeGround local.sl 170
			}
		}
		local.i++
	}
	println("^~^~^ AIDPOSTS made=" + local.made + "/" + local.n)
}end


//=========================================================================
//[user, bug-2275] ENGINEERS CUTTING THE BEACH OBSTACLES APART.
//
//"welder cutting tank traps would be cool to add too."
//
//An engineer with an oxy torch working on a Belgian gate: a wheeled gas bottle at his feet with its own
//gauges animating, a mask in his off hand, and the torch throwing a spark fountain, a flash corona and
//bouncing metal fragments that skitter across the sand. It is the only ambient prop on this beach that
//emits light and debris under its own power, so it reads from a long way off.
//
//NO PROPS ARE SPAWNED HERE. welding_init's own server block does all three:
//    0 attachmodel models/miscobj/welding_torch.tik tag_weapon_left
//    0 attachmodel models/miscobj/welding_mask.tik  tag_weapon_right
//    0 attachmodel models/miscobj/welding_tank.tik  ORIGIN
//    1 attachedmodelanim ORIGIN tank_action
//and welding_start's `0 attachedmodelanim tag_weapon_left idleon` is what switches the torch's five
//emitters on - the torch declares no plain `idle` at all, so without that frame command it is a man
//miming. This is exactly the notetrack trap in docs/TRAPS.md: the animation IS the scene.
//
//NOT ONE `waittill animdone` IN HERE, AND THAT IS DELIBERATE.
//welding_init is aliased to scripted/welding/welding_idle.skc - the SAME file as welding_idle, which
//loops. Waiting on it never returns, and the thread would stall after the props attach but before
//welding_start, so the torch would never light. Retail agrees and never waits on it either
//(maps/m2l2a.scr:962-965, and our own global/welder.scr:8, both `anim welding_init` then a plain wait).
//Every wait here is a measured duration instead: welding_start is 14 frames at 0.0333 = 0.47s,
//welding_end 20 frames = 0.67s, read out of the SKC headers. TRAPS warns that a `waittill` on an
//animation that never finishes hangs the handler forever; timing them removes the whole class.
//
//welding_stop IS called on the way out and is safe: it runs on welding_end.skc and carries
//`0 removeattachedmodel ORIGIN` + `last removeattachedmodel tag_weapon_left/right`, i.e. it is the
//three-prop cleanup already written. Its `1 surface material10 -nodraw` warns once on the console
//because no dday_* model has that surface - Entity::SurfaceCommand warns and returns (entity.cpp:4336),
//it does not drop, and it does not abort the other frame commands.
//=========================================================================
coop_beachWelders:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_weldersOn == NIL){ level.coop_weldersOn = 1 }
	if(!level.coop_weldersOn){ end }
	if(level.coop_weldersDone == 1){ end }
	level.coop_weldersDone = 1

	//not during the run-in - a demolition party working the obstacle belt before anybody has landed is
	//the wrong picture, and there is nobody there to see it
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling == 1){
		wait 1
		local.t = local.t + 1
	}
	wait 6

	//Beside three real Belgian gates, in the playable middle rather than the out-of-bounds shoulders.
	//Each spot is the most open point on a 110-unit ring around its gate, measured against every static
	//model on the map: 258u, 240u and 197u clear. He stands at the gate, not on it.
	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 3 }

	//[user 2026-09-01] THE USER'S OWN THREE VIEWPOS CAPTURES, not my solved guesses. He walked to each
	//spot and read the coordinate off, so these are where he wants the men - the first one deliberately
	//beside a tank. The z is his EYE height; a man's feet sit ~64 below that, and coop_placeGround
	//settles the rest ("make sure they are on the ground").
	local.n = 0
	local.n++; local.wx[local.n] = 2326; local.wy[local.n] = 0 - 323; local.wz[local.n] = 0 - 438	//viewpos 1 - by the tank
	local.n++; local.wx[local.n] = 112; local.wy[local.n] = 0 - 822; local.wz[local.n] = 0 - 453	//viewpos 2
	local.n++; local.wx[local.n] = 0 - 2171; local.wy[local.n] = 0 - 573; local.wz[local.n] = 0 - 449	//viewpos 3

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.wx[local.i]
		local.p[1] = local.wy[local.i]
		local.p[2] = local.wz[local.i] + 20

		//face the gate he is cutting
		local.yaw = 180
		if(local.wx[local.i] < 0){ local.yaw = 0 }

		local.a = waitthread coop_vigSpawn "models/human/dday_engineer" "none" local.p local.yaw
		if(local.a != NULL && local.a != NIL){
			local.a thread coop_welderWork
			local.made++
		}
		local.i++
	}
	println("^~^~^ WELDERS made=" + local.made + "/" + local.n)
}end

//One engineer, cutting and pausing, for the rest of the mission. See the note above for why there is
//not a single `waittill animdone` in this loop.
//=========================================================================
coop_welderWork:{
//=========================================================================
	//[bug-2281] this man has a job; stop the default beach behaviour on him
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }
	wait 0.1
	//the torch, mask and bottle attach themselves on this frame
	self anim welding_init
	wait 0.7

	while(isalive self && level.coop_weldersOn){
		//light it - this is the frame command that turns the emitters on
		self anim welding_start
		wait 0.5

		//and cut. welding_action is a real looping SKC, so the wait times the burst rather than
		//counting re-triggers.
		self anim welding_action
		wait ( 12 + ( randomfloat 9 ) )
		if(!isalive self){ break }

		//torch off, then a breather with the bottle idling
		self anim welding_end
		wait 0.7
		self anim welding_idle
		wait ( 5 + ( randomfloat 6 ) )
	}

	//welding_stop is the authored three-prop cleanup - see the note above
	if(self != NULL && self != NIL){
		self anim welding_stop
		wait 0.7
		if(self != NULL && self != NIL){
			self removeattachedmodel "tag_weapon_left"
			self removeattachedmodel "tag_weapon_right"
		}
	}

	//[user 2026-09-01, bug-2288] AND HE IS HANDED BACK. Every job on this beach ends eventually - the
	//carrier runs out of trips, the welder's system is switched off, the loop hits its cap - and when it
	//does the man was being left standing with coop_behaveOff still 1, which is precisely the flag that
	//stops coop_beachBehave from ever picking him up. Clearing it and re-threading the default is what
	//makes "no ally ever just stands" actually hold, rather than holding only until his job finishes.
	if(self != NULL && self != NIL){
		if(isalive self){
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end


//=========================================================================
//[user, bug-2278] THE REST OF THE BEACH DETAIL.
//
//Six scenes, all from the trilogy sweep, every alias checked against the live include chain by
//docs/tools/check_map_anims.py before a line of this was written.
//
//THREE RULES HOLD THROUGHOUT, and each of them is a bug this map has already shipped:
//
//  1. NOT ONE `waittill animdone`. Half of these aliases LOOP, and a loop never fires ANIMDONE, so the
//     wait parks the thread forever (bug-2275 - the welder would have stalled before lighting his
//     torch). Every wait below is the measured duration out of the SKC header instead. The durations
//     are in the comments so the next person does not have to re-measure them.
//  2. EVERY ACTOR GOES THROUGH coop_placeGround. Not droptofloor - that finds the seabed, or the deck
//     of a Higgins (bug-2255, bug-2264, bug-2268).
//  3. NOBODY STANDS UPRIGHT IN THE OPEN. Prone, crouched, working or moving (bug-2269).
//=========================================================================
coop_beachDetail:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_beachDetailOn == NIL){ level.coop_beachDetailOn = 1 }
	if(!level.coop_beachDetailOn){ end }
	if(level.coop_beachDetailDone == 1){ end }
	level.coop_beachDetailDone = 1

	//everything here is post-landing - a beachhead being worked, not a beach being assaulted
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling == 1){
		wait 1
		local.t = local.t + 1
	}
	wait 4

	//[user 2026-09-01] THE CENSUS READ 140 ACTORS. The user, repeatedly: "tons of allies still standing
	//around". Cut across the board - vignettes 26 -> 14, flank landings 24 -> 12, disembark cap 26 -> 14,
	//the bangalore surge 25 -> 12, the beach trickle 8 -> 5 concurrent, and this block 16 -> 12. A dozen
	//men doing recognisable jobs beats forty holding poses, and every one of them costs an edict out of
	//the same 2048 pool as everything else on the map.
	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 12 }

	thread coop_beachEngineers
	wait 0.5
	thread coop_beachSignals
	wait 0.5
	thread coop_beachObservers
	wait 0.5
	thread coop_beachBaseOfFire
	wait 0.5
	thread coop_beachDragOut
	wait 0.5
	thread coop_beachCarry
	//[user 2026-09-01] NO PRISONER CAGE. It was proposed by the trilogy sweep and built, and the user
	//cut it on sight: "prisoners don't really make sense so undo that". He is right - a POW cage on the
	//sand belongs to a beach that has been taken, and this map ends with the bluff still contested.
	//The prisoners.tik $include went with it rather than being left as a dead dependency.
}end

//A demolition party on the obstacle belt: one man setting a charge on a Belgian gate, one breaking up a
//hedgehog with a sledgehammer, one watching the bluff for them. The sledgehammer attaches ITSELF -
//sledgehammer_init carries `0 attachmodel models/miscobj/sledgehammer.tik tag_weapon_right`.
//=========================================================================
coop_beachEngineers:{
//=========================================================================
	//beside real obstacles, in the playable middle
	local.n = 0
	local.n++; local.ex[local.n] = 1063; local.ey[local.n] = 0 - 1115
	local.n++; local.ex[local.n] = 0 - 1290; local.ey[local.n] = 0 - 640
	local.n++; local.ex[local.n] = 0 - 260; local.ey[local.n] = 0 - 240

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.ex[local.i]
		local.p[1] = local.ey[local.i]
		local.p[2] = 0 - 440

		local.a = waitthread coop_vigSpawn "models/human/dday_engineer" "none" local.p ((randomint 4) * 90)
		if(local.a != NULL && local.a != NIL){
			//[user 2026-09-01] "I added a few objects, we can remove the hammering allied those dont make
			//sense" - the sledgehammer man is gone. The demolition charge stays, because setting a charge
			//on a Belgian gate is what engineers were actually doing on that beach; a man breaking up an
			//obstacle by hand under machine-gun fire was never a real job.
			if(local.i == 2){ local.a thread coop_engCharge }
			//[user 2026-09-02, bug-2328] "found more assault engineers just standing in the open."
			//
			//They were asked for "watching01" and the engine answered
			//   Script Error : unknown animation 'watching1' in 'models/human/dday_engineer.tik'
			//- note the name it looked for has LOST ITS LEADING ZERO. That is the random-alias digit
			//strip: a TIKI alias carrying `random` is registered with its trailing digits removed, so
			//the numbered form is not a name that exists at runtime no matter what the include chain
			//says statically. docs/tools/check_map_anims.py resolves the chain and therefore reports
			//watching01 as present, which is why this passed the gate and still failed in play - a
			//real blind spot in that tool, noted in the buglog.
			//
			//trench_idle_up is a genuine 16.67s LOOP, already used by the firing line on this map, and
			//reads as exactly what this man is for: up on the lip watching the bluff for the demolition
			//party working below him.
			else{ local.a thread coop_vigHold "trench_idle_up" }
		}
		local.i++
	}
	println("^~^~^ ENGINEERS placed")
}end

//Setting a demolition charge on a Belgian gate. `explosives` is a ONE-SHOT of 11.33 seconds - long
//enough that it reads as real work - so it is re-triggered rather than waited on.
//=========================================================================
coop_engCharge:{
//=========================================================================
	//[bug-2281] this man has a job; stop the default beach behaviour on him
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }
	wait 0.1
	while(isalive self && level.coop_beachDetailOn){
		self anim explosives			//one-shot, 11.33s
		wait 11.4
		if(!isalive self){ break }
		self anim crouch_beach_idle		//LOOP - down behind the obstacle while it is checked
		wait ( 5 + ( randomfloat 6 ) )
	}
	//[user 2026-09-01, bug-2288] AND HE IS HANDED BACK. Every job on this beach ends eventually - the
	//carrier runs out of trips, the welder's system is switched off, the loop hits its cap - and when it
	//does the man was being left standing with coop_behaveOff still 1, which is precisely the flag that
	//stops coop_beachBehave from ever picking him up. Clearing it and re-threading the default is what
	//makes "no ally ever just stands" actually hold, rather than holding only until his job finishes.
	if(self != NULL && self != NIL){
		if(isalive self){
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end

//A captain and his signaller in the lee of the shingle, calling the bluff in.
//=========================================================================
coop_beachSignals:{
//=========================================================================
	local.p = (0 0 0)
	local.p[0] = 0 - 620
	local.p[1] = 1420
	local.p[2] = 0 - 430

	local.q = local.p
	local.q[0] = local.q[0] + 62
	local.q[1] = local.q[1] - 30

	local.cap = waitthread coop_vigSpawn "models/human/dday_ranger_captain" "thompson" local.p 20
	if(local.cap != NULL && local.cap != NIL){ local.cap thread coop_vigHold "shingle_coveridle_capt" }

	local.rad = waitthread coop_vigSpawn "models/human/dday_29th_private_radio" "none" local.q 200
	if(local.rad != NULL && local.rad != NIL){ local.rad thread coop_vigHold "radioman" }
	println("^~^~^ SIGNALS placed")
}end

//An observer pair using a wrecked hull as cover: one glassing the bluff, one ducking up and down.
//=========================================================================
coop_beachObservers:{
//=========================================================================
	local.p = (0 0 0)
	local.p[0] = 1820
	local.p[1] = 300
	local.p[2] = 0 - 450

	local.q = local.p
	local.q[0] = local.q[0] - 58
	local.q[1] = local.q[1] - 34

	local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "m1 garand" local.p 100
	if(local.a != NULL && local.a != NIL){ local.a thread coop_vigHold "shingle_idle_lookat" }

	local.b = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.q 100
	if(local.b != NULL && local.b != NIL){ local.b thread coop_peekLoop }
	println("^~^~^ OBSERVERS placed")
}end

//Up for a look, down again. bunker_peek_slow/fast are one-shots of ~4s.
//=========================================================================
coop_peekLoop:{
//=========================================================================
	//[bug-2281] this man has a job; stop the default beach behaviour on him
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }
	wait 0.1
	while(isalive self && level.coop_beachDetailOn){
		self anim crouch_beach_idle		//LOOP - down behind the plate
		wait ( 4 + ( randomfloat 5 ) )
		if(!isalive self){ break }
		if((randomint 2) == 0){
			self anim bunker_peek_slow	//one-shot 4.00s
			wait 4.1
		}else{
			self anim bunker_peek_fast	//one-shot 3.96s
			wait 4.0
		}
	}
	//[user 2026-09-01, bug-2288] AND HE IS HANDED BACK. Every job on this beach ends eventually - the
	//carrier runs out of trips, the welder's system is switched off, the loop hits its cap - and when it
	//does the man was being left standing with coop_behaveOff still 1, which is precisely the flag that
	//stops coop_beachBehave from ever picking him up. Clearing it and re-threading the default is what
	//makes "no ally ever just stands" actually hold, rather than holding only until his job finishes.
	if(self != NULL && self != NIL){
		if(isalive self){
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end

//A base of fire at the shingle - men down behind the bank putting rounds into the bluff so the rest can
//move. trench_idle_down and trench_idle_up are long loops (13.3s and 16.7s) authored for exactly this.
//=========================================================================
coop_beachBaseOfFire:{
//=========================================================================
	local.n = 0
	local.n++; local.bx[local.n] = 0 - 1560; local.by[local.n] = 1180
	local.n++; local.bx[local.n] = 0 - 1450; local.by[local.n] = 1240
	local.n++; local.bx[local.n] = 900;      local.by[local.n] = 1320
	local.n++; local.bx[local.n] = 1010;     local.by[local.n] = 1265

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.bx[local.i]
		local.p[1] = local.by[local.i]
		local.p[2] = 0 - 430

		local.gun = "m1 garand"
		if((local.i % 2) == 0){ local.gun = "bar" }
		local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" local.gun local.p 90
		if(local.a != NULL && local.a != NIL){ local.a thread coop_fireLineLoop }
		local.i++
	}
	println("^~^~^ BASEOFFIRE placed")
}end

//Down behind the bank, up to shoot, down again.
//=========================================================================
coop_fireLineLoop:{
//=========================================================================
	//[bug-2281] this man has a job; stop the default beach behaviour on him
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }
	wait 0.1
	while(isalive self && level.coop_beachDetailOn){
		self anim trench_idle_down		//LOOP 13.33s - head down
		wait ( 8 + ( randomfloat 8 ) )
		if(!isalive self){ break }
		self anim trench_idle_up		//LOOP 16.67s - up on the bank, firing
		wait ( 7 + ( randomfloat 9 ) )
	}
	//[user 2026-09-01, bug-2288] AND HE IS HANDED BACK. Every job on this beach ends eventually - the
	//carrier runs out of trips, the welder's system is switched off, the loop hits its cap - and when it
	//does the man was being left standing with coop_behaveOff still 1, which is precisely the flag that
	//stops coop_beachBehave from ever picking him up. Clearing it and re-threading the default is what
	//makes "no ally ever just stands" actually hold, rather than holding only until his job finishes.
	if(self != NULL && self != NIL){
		if(isalive self){
			self.coop_behaveOff = 0
			self thread coop_beachBehave
		}
	}
}end

//=========================================================================
//Two men dragging a third out of the surf, and two more carrying a casualty up to the aid posts.
//
//THIS IS RETAIL'S OWN RECIPE, copied rather than invented. maps/m3l1a.scr::dragging_guys_blow (:4541)
//spawns the pair at the SAME yaw, offsets the dragged man by 32 units, calls `setsynctime 0` on BOTH,
//and then just plays drag_dragging / drag_beingdragged. The pair MOVES on the animations' own delta -
//no runto, no waypoint, no pathnodes - which is why it works on unnoded sand where everything else on
//this beach needed the bug-2246 waypoint trick.
//
//setsynctime 0 is the load-bearing line: without it the two loops drift apart and the "dragged" man
//walks out of the hands holding him.

//=========================================================================
//[user 2026-09-01, bug-2311] A HAULING PAIR THAT STOPS.
//
//"same friendlies are stuck walking straight into the barbed wire at the seawall, including the dude
//carrying the friendly body" - reported twice, and it survived the whole under-map/pathing fix
//because these two pairs were never part of it. They issue NO movement order at all: the drag and
//carry animations carry a root delta, so the men simply travel in whatever direction they face, for
//as long as the animation loops. coop_vigHold loops it forever. There is no destination, no obstacle
//test and no stop condition anywhere in the pair, so the only thing that ever halted them was the
//seawall - which is precisely what the user watched them press into.
//
//coop_advanceLeg cannot help here: it drives `runto`/`moveto`, and a hauling pair must NOT be given a
//movement order - the two actors stay together only because they play matched loops with the same
//setsynctime, and a runto on either one breaks the pairing instantly.
//
//So this steers the pair by the only channel available - WHICH WAY THEY FACE - and gives them the
//authored ending they always had:
//   walk_carrying_start / _forward / _end   and   drag_dragging_start / drag_dragging
//The _end clips (one-shots, 1.20s) are how the animators intended a carry to finish: he sets the man
//down. Nothing had ever played them.
//
//THE BEARING TEST is the same closest-point-on-segment check coop_legClear already uses against the
//401-row obstacle table, so the wire, the hedgehogs and the Belgian gates are all one test. If the
//path ahead fouls, the pair turns by up to +-60 degrees to find a clear lane; if nothing is clear
//they stop where they are, which is a far better failure than pressing into wire forever.
//=========================================================================
coop_haulPair local.a local.b local.anima local.animb local.secs:{
//=========================================================================
	if(local.a == NULL || local.a == NIL){ end }
	if(local.b == NULL || local.b == NIL){ end }

	local.a.coop_behaveOff = 1
	local.b.coop_behaveOff = 1
	local.a setsynctime 0
	local.b setsynctime 0

	local.t = 0
	while(local.t < local.secs){
		if(local.a == NULL || local.a == NIL){ break }
		if(local.b == NULL || local.b == NIL){ break }
		if(!isalive local.a || !isalive local.b){ break }

		//--- is the lane ahead clear for the next stretch? Try straight on first, then widen.
		local.yaw = local.a.angles[1]
		local.ok = 0
		local.try = 0
		while(local.try < 5 && local.ok == 0){
			local.d = 0
			if(local.try == 1){ local.d = 30 }
			if(local.try == 2){ local.d = 0 - 30 }
			if(local.try == 3){ local.d = 60 }
			if(local.try == 4){ local.d = 0 - 60 }
			local.ty = local.yaw + local.d
			local.ax = local.a.origin[0]
			local.ay = local.a.origin[1]
			local.bx = local.ax + ( 260 * cos(local.ty) )
			local.by = local.ay + ( 260 * sin(local.ty) )
			if(waitthread coop_legClear local.ax local.ay local.bx local.by 46){
				local.ok = 1
				local.yaw = local.ty
			}
			local.try++
		}
		if(local.ok == 0){ break }			//boxed in - stop rather than push into it

		local.na = (0 0 0)
		local.na[1] = local.yaw
		local.a.angles = local.na
		local.b.angles = local.na

		local.a anim local.anima
		local.b anim local.animb
		wait 1.4
		local.t = local.t + 1.4
	}

	//--- the authored ending: he sets the man down, then both go back to the beach default
	if(local.a != NULL && local.a != NIL){
		if(isalive local.a){
			if(local.anima == "walk_carrying_forward"){
				local.a anim walk_carrying_end
				if(local.b != NULL && local.b != NIL){ local.b anim walk_being_carried_end }
				wait 1.2
			}
		}
	}
	if(local.a != NULL && local.a != NIL){
		if(isalive local.a){ local.a.coop_behaveOff = 0; local.a thread coop_beachBehave }
	}
	if(local.b != NULL && local.b != NIL){
		if(isalive local.b){
			//the man who was carried is a casualty - he does not get up and walk about
			local.b thread coop_vigHold "unarmed_pain_flooridle"
		}
	}
}end

//=========================================================================
coop_beachDragOut:{
//=========================================================================
	local.n = 0
	local.n++; local.dx[local.n] = 0 - 980; local.dy[local.n] = 0 - 520
	local.n++; local.dx[local.n] = 1540;    local.dy[local.n] = 0 - 470

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.dx[local.i]
		local.p[1] = local.dy[local.i]
		local.p[2] = 0 - 470

		//retail's convention exactly: both at yaw 270, the dragged man 32 units along -Y
		local.q = local.p
		local.q[1] = local.q[1] - 32

		//[bug-2288] ARMED AND HOLSTERED, which is retail's own recipe for this exact pair -
		//maps/m3l1a.scr:4541 spawns dragger and draggie with `gun "m1 garand"` and then holsters both,
		//so they carry a visible rifle without it being in the hands the drag animation needs.
		local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.p 270
		local.b = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.q 270
		//[user 2026-09-03] CLAIM THEM FIRST. coop_vigSpawn ends by threading coop_beachBehave on
		//EVERY actor it makes, and coop_behaveOff is the flag that says "I own this man, leave him
		//alone". coop_welderWork sets it (bug-2281); this pair never did - so the default behaviour
		//loop kept running alongside the job, and posed a man who had just been holstered into rifle
		//stances. The user's screenshot is exactly that: a crate on his shoulder and his free hand
		//shaped around a rifle that is holstered - an INVISIBLE GUN. coop_beachBehave's own header
		//already describes this failure ("the man knelt and fired with a crate still bound to
		//tag_weapon_right") - it was fixed for the welder and never for these two pairs.
		if(local.a != NULL && local.a != NIL){ local.a.coop_behaveOff = 1 }
		if(local.b != NULL && local.b != NIL){ local.b.coop_behaveOff = 1 }
		if(local.a != NULL && local.a != NIL){ local.a holster }
		if(local.b != NULL && local.b != NIL){ local.b holster }
		if(local.a != NULL && local.a != NIL && local.b != NULL && local.b != NIL){
			//[bug-2311] BOUNDED AND STEERED. These used to be two forever-looping holds with no
			//destination, so the pair walked on its facing until the seawall stopped it.
			thread coop_haulPair local.a local.b "drag_dragging" "drag_beingdragged" ( 14 + ( randomfloat 10 ) )
		}
		local.i++
	}
	println("^~^~^ DRAGOUT placed")
}end

//A man walking a wounded comrade up the beach. Same pairing convention as the drag.
//=========================================================================
coop_beachCarry:{
//=========================================================================
	local.n = 0
	local.n++; local.cx[local.n] = 0 - 1400; local.cy[local.n] = 260
	local.n++; local.cx[local.n] = 1800;     local.cy[local.n] = 180

	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.cx[local.i]
		local.p[1] = local.cy[local.i]
		local.p[2] = 0 - 450

		//[user 2026-09-01, bug-2313] THEY CARRY HIM TOWARDS THE WATER, NOT INLAND.
		//
		//"for anyone carrying bodies it makes more sense to carry them out towards the shore instead of
		//inland towards the barbed wire" - which is both better staging and historically what happened:
		//casualties went back down the sand to the waterline for the boats, not up into the wire the
		//assault was still trying to breach. They used to spawn at yaw 90, facing the seawall, which is
		//why every one of them ended up pressed into the barbed wire (bug-2311).
		//
		//On this map the water is toward -Y (dry sand begins around y -400 and the landing spawn sits at
		//y -2655), so seaward is yaw 270. The pair offsets flip with the facing: at yaw 90 the carried
		//man sat 28 to the carrier's right (+X) and 8 ahead (+Y); at 270 "right" is -X and "ahead" is -Y.
		local.q = local.p
		local.q[0] = local.q[0] - 28
		local.q[1] = local.q[1] - 8

		//[bug-2288] same as the drag pair - armed, then holstered so the carry animation has his hands
		local.a = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.p 270
		local.b = waitthread coop_vigSpawn "models/human/dday_29th_private" "m1 garand" local.q 270
		//[user 2026-09-03] CLAIM THEM FIRST. coop_vigSpawn ends by threading coop_beachBehave on
		//EVERY actor it makes, and coop_behaveOff is the flag that says "I own this man, leave him
		//alone". coop_welderWork sets it (bug-2281); this pair never did - so the default behaviour
		//loop kept running alongside the job, and posed a man who had just been holstered into rifle
		//stances. The user's screenshot is exactly that: a crate on his shoulder and his free hand
		//shaped around a rifle that is holstered - an INVISIBLE GUN. coop_beachBehave's own header
		//already describes this failure ("the man knelt and fired with a crate still bound to
		//tag_weapon_right") - it was fixed for the welder and never for these two pairs.
		if(local.a != NULL && local.a != NIL){ local.a.coop_behaveOff = 1 }
		if(local.b != NULL && local.b != NIL){ local.b.coop_behaveOff = 1 }
		if(local.a != NULL && local.a != NIL){ local.a holster }
		if(local.b != NULL && local.b != NIL){ local.b holster }
		if(local.a != NULL && local.a != NIL && local.b != NULL && local.b != NIL){
			//[bug-2311] BOUNDED AND STEERED - see coop_haulPair. This is the pair the user watched
			//walk into the wire at the seawall.
			local.a anim walk_carrying_start
			local.b anim walk_being_carried_start
			thread coop_haulPair local.a local.b "walk_carrying_forward" "walk_being_carried_forward" ( 16 + ( randomfloat 12 ) )
		}
		local.i++
	}
	println("^~^~^ CARRY placed")
}end


//=========================================================================
//[user, bug-2281] NO ALLY EVER JUST STANDS. This is the rule, and it is enforced in ONE place.
//
//The user, five separate times across one evening, ending with: "even more allies that just stand
//around. No allies should really just be standing. There is plenty you can have them do. Find cover,
//run up the beach to get killed, shake behind cover like they are scared, lie injured on the beach."
//
//WHY IT KEPT COMING BACK. Every fix so far treated a symptom: this pose was a one-shot, that spawn used
//a standing idle, that scene had too many men. All true, and all beside the point. The real fault is
//STRUCTURAL - a MOHAA actor's resting state is standing, so ANY coop thread that ends, fails to start,
//or falls out of a loop leaves a rifleman at attention on an open beach under four MG42s, permanently.
//There were a dozen such exits across this file and I kept closing them one at a time.
//
//So the default is no longer "stand". Every coop-spawned ally on this beach ends up here, and this loop
//never exits while he is alive. Four behaviours, straight off the user's own list:
//
//  COVER    - crouch or lie behind whatever is nearest (crouch_beach_idle / prone_beach_idle /
//             trench_idle_down, all genuine looping SKCs)
//  SCARED   - flinching and ducking against an obstacle (hedge_shake01-03, hedge_dodge01/02, hedge_look01)
//  INJURED  - down on the sand, not dead (unarmed_pain_flooridle / _kneesidle / fallen)
//  CHARGE   - gets up, runs at the bluff, and is killed - coop_chargeRun, which never returns a man
//             standing and never deletes one either (bug-2272)
//
//Every alias here was checked reachable on m3l1a by docs/tools/check_map_anims.py before it was used,
//and every wait is a measured duration - not one `waittill animdone`, because half of these LOOP and a
//loop never fires ANIMDONE (bug-2275).
//=========================================================================
//[user 2026-09-02, bug-2326] STOP HUNTING THE EXITS. SWEEP FOR THE SYMPTOM INSTEAD.
//
//"this guy is still just standing here" - the sixth screenshot of an idle ally, after five separate
//fixes that each closed one real stranding path: the yield guard that was a no-op (bug-2294), the
//dwell overruns (bug-2295), the job threads that never handed back (bug-2288), the spawn race
//(bug-2310), the boxed-in pathing (bug-2317). Every one of those was a genuine bug and every one of
//them was also just a door; a MOHAA actor's resting state is standing, so any new thread that ends,
//fails to start, or falls out of a loop opens another.
//
//So this does not close a door. It notices that a man has stopped and starts him again.
//
//HOW IT KNOWS. Every coop-spawned actor stamps self.coop_hb whenever it begins a pose - in
//coop_beachBehave's loop and in coop_vigHold's. A man who is working re-stamps every few seconds. A
//man who has been stranded stops stamping, and after STALE seconds this thread clears his
//coop_behaveOff and re-threads the default on him.
//
//WHY 45 SECONDS AND NOT 10. coop_vigHold deliberately PARKS on `waittill animdone` when its pose is a
//looping alias - that is how a held pose works and it is correct, but it means a legitimately posed
//man stops stamping too. Re-poking him merely replays a pose he is already holding, which is
//invisible; re-poking him every 10s would be churn for no gain. 45 is comfortably longer than the
//longest legitimate dwell (a 10-22s behave branch) and short enough that a stranded man is not a
//fixture of the level.
//
//IT NEVER TAKES A MAN OFF A JOB. coop_behaveOff is only cleared when the heartbeat is stale, and any
//running job re-stamps. A carrier mid-haul, a welder mid-cut and a firing-line man cycling his pose
//are all stamping, so the sweeper passes over them.
//=========================================================================
//[user 2026-09-02, bug-2334] BAZOOKA TEAMS WORKING THE BUNKERS.
//
//"Let's also add some bazooka soldiers behind cover occassionally firing rockets towards the bunkers."
//
//THE ANIMATION SET IS COMPLETE AND ALL OF IT LOOPS OR RESOLVES CLEANLY:
//    bazooka_aim     LOOP 2.00s   - shouldered, tracking the bluff
//    bazooka_shoot   once 0.73s   - the launch
//    bazooka_reload  once 3.00s   - and the long wait that makes a rocket feel like an event
//The one-shots are driven off `waittill animdone` rather than a timed wait, per the rule this file
//learned the hard way in bug-2295: a one-shot that outlives its wait leaves the man standing.
//
//THE ROCKET IS A PROP, NOT A PROJECTILE. models/projectiles/bazookashell.tik is a live Projectile with
//`hitdamage 200`, and models/fx/bazookaexplosion.tik carries `radiusdamage 110` AND `rendereffects
//+dontdraw` - so the obvious pair would both hurt the player and be invisible while doing it. That is
//the fx_tank_explosion trap from bug-2244 twice over. Instead the round is an inert ammo model
//origin-stepped along the flight (moveto no-ops on script_models, a standing trap here), and the
//impact is fx_mortar_higgins.tik - classname effectentity, no radiusdamage, already proven by the ramp
//cinematic.
//
//THEY ARE MORTAL, like the firing line: coop_vigSpawn hands out `nodamage` by default and it is undone
//here, with a share of them marked for the staged cut-down. A bazooka team that cannot be killed on
//that beach would be the one invulnerable thing on it.
//=========================================================================
coop_beachBazooka:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_bazookaOn == NIL){ level.coop_bazookaOn = 1 }
	if(!level.coop_bazookaOn){ end }
	if(level.coop_bazookaDone == 1){ end }
	level.coop_bazookaDone = 1

	//after the landing, same gate the firing line uses
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling != 1){ wait 1; local.t = local.t + 1 }
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling == 1){ wait 1; local.t = local.t + 1 }
	wait 6

	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 3 }

	local.n = 0
	local.n++; local.bx[local.n] = 900;         local.by[local.n] = 0 - 690; local.bz[local.n] = 0 - 505
	local.n++; local.bx[local.n] = 0 - 1120;    local.by[local.n] = 0 - 560; local.bz[local.n] = 0 - 500
	local.n++; local.bx[local.n] = 2180;        local.by[local.n] = 0 - 610; local.bz[local.n] = 0 - 508

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		//[user 2026-09-02, bug-2367] "rocket guys animations still stuck in the ground when they go
		//to shoot and aim."
		//
		//IT IS NOT THE ANIMATIONS. models/human/animation/human_bazooka.tik says so in its own
		//comment: "Bazooka aim and shoot animations work for either standing or crouching". It is
		//the SPAWN HEIGHT - I hardcoded local.bz per emplacement and added 30, which is a guess at
		//the terrain, and where the real sand sits above that guess the man spawns inside it. The
		//aim pose then reads as him standing in the ground.
		//
		//Everything else in this file that places something on this beach traces for the ground
		//instead of assuming it. So does this now.
		local.p = (0 0 0)
		local.p[0] = local.bx[local.i]
		local.p[1] = local.by[local.i]
		local.p[2] = local.bz[local.i] + 30

		local.tt = (0 0 0)
		local.tt[0] = local.p[0]
		local.tt[1] = local.p[1]
		local.tt[2] = 0 - 240
		local.tb = (0 0 0)
		local.tb[0] = local.p[0]
		local.tb[1] = local.p[1]
		local.tb[2] = 0 - 720
		local.gh = trace local.tt local.tb 1
		if(local.gh != NIL){
			local.gz = local.gh[2]
			if(local.gz > ( 0 - 700 ) && local.gz < ( 0 - 300 )){ local.p[2] = local.gz + 4 }
		}

		local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" "bazooka" local.p 90 1
		if(local.a != NULL && local.a != NIL){
			local.a takedamage
			local.a thread coop_bazookaLoop
			if((randomint 3) < 2){ local.a thread coop_firingLineCutDown }	//[user 2026-09-02] 1-in-3 -> 2-in-3
			local.made++
		}
		local.i++
	}
	println("^~^~^ BAZOOKA made=" + local.made + "/" + local.n)
}end


//Aim, fire, reload, forever - and the rocket actually crosses the beach.
//=========================================================================
coop_bazookaLoop:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	self.coop_behaveOff = 1
	wait 0.1

	while(isalive self && level.coop_bazookaOn){
		self.coop_hb = level.time			//[bug-2326] heartbeat for the idle sweeper

		//--- shouldered and tracking. bazooka_aim LOOPS, so a bare wait holds the pose.
		self anim bazooka_aim
		wait ( 5 + ( randomfloat 9 ) )
		if(!isalive self){ break }

		//--- the launch
		local.from = self.origin + (0 0 52)
		local.tgt = waitthread coop_bazookaTarget
		self anim bazooka_shoot
		self playsound coop_panzerschreck_fire
		thread coop_bazookaRocket local.from local.tgt
		self waittill animdone
		if(!isalive self){ break }

		//--- and the long reload, which is what makes the next one feel earned
		self anim bazooka_reload
		self waittill animdone
	}

	if(self != NULL && self != NIL){
		if(isalive self){ self.coop_behaveOff = 0; self thread coop_beachBehave }
	}
}end


//Pick a bunker. The map's own MG42 entities are the honest targets - if none of them survive, fall
//back to a point on the bluff so the team never fires into nothing.
//=========================================================================
coop_bazookaTarget:{
//=========================================================================
	local.n = 0
	if($mg42_bunker != NULL && $mg42_bunker != NIL){ local.n++; local.t[local.n] = $mg42_bunker.origin }
	if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.n++; local.t[local.n] = $mg42_middle1.origin }
	if($mg42_leftbunker1 != NULL && $mg42_leftbunker1 != NIL){ local.n++; local.t[local.n] = $mg42_leftbunker1.origin }
	if(local.n > 0){
		local.pick = ( randomint local.n ) + 1
		local.out = local.t[local.pick]
		end local.out
	}

	local.f = (0 0 0)
	local.f[0] = ( 0 - 900 ) + (randomint 2600)
	local.f[1] = 2600 + (randomint 700)
	local.f[2] = 0 - 120
	end local.f
}end


//The round in flight. Origin-stepped because moveto silently no-ops on a script_model.
//=========================================================================
coop_bazookaRocket local.from local.tgt:{
//=========================================================================
	if(local.from == NIL || local.tgt == NIL){ end }

	local.r = spawn script_model model "models/ammo/bazooka_shell.tik"
	if(local.r != NULL && local.r != NIL){			//entity-pool guard
		local.r.origin = local.from
		local.r notsolid
		local.d = local.tgt - local.from
		//A nested call inside a vector literal - ( 0 ( vectortoangles x )[1] 0 ) - is a PARSE ERROR that
		//kills the whole file, and neither depthscan2 nor scrlint can see it: the braces balance and
		//there is no bad character. Only the engine's own compiler catches it, which is why the
		//dedicated boot check exists. Split into statements.
		local.ang = vector_toangles local.d
		local.ry = local.ang[1]
		local.r.angles = ( 0 local.ry 0 )

		local.t0 = level.time
		while(1){
			local.f = ( level.time - local.t0 ) / 0.85
			if(local.f > 1){ local.f = 1 }
			if(local.r == NULL || local.r == NIL){ break }
			local.r.origin = local.from + ( local.d * local.f )
			if(local.f >= 1){ break }
			waitframe
		}
		if(local.r != NULL && local.r != NIL){ local.r remove }
	}else{
		wait 0.85
	}

	//--- impact. fx_mortar_higgins is classname effectentity with NO radiusdamage - see the header.
	local.e = spawn "models/animate/fx_mortar_higgins.tik"
	if(local.e != NULL && local.e != NIL){
		local.e.origin = local.tgt
		local.e notsolid
		local.e anim start
		local.e playsound bazooka_exp
		thread coop_fxCleanup local.e 5
	}
}end

//=========================================================================
//[user 2026-09-02, bug-2338] THE FLEET, FIRING.
//
//"add explosions out in the sea (needs to be close enough to be visible) that flashes consistently to
//coincide with the bombs that end up hitting the seawall and bunker areas. those should start
//flashing randomly out at sea starting once you're off the higgins boat."
//
//This is the OTHER END of the bombardment the player already sees landing: a muzzle flash out on the
//water, then the round arriving up on the bluff a beat later. Sound travels, so the flash is silent
//for a moment and the report follows - which is both correct and the thing that sells distance.
//
//WHERE. Seaward is -Y on this map. The water brush runs y -8000..-2160, and the drawn seabed stops at
//y -2816 - but that only matters for a camera UNDER the surface, and these sit above it. The rolled
//range is x -4200..+4200, y -7000..-4600 (bug-2364 pushed it further out than the -3600..-6200 this
//paragraph used to claim), z -470..-381: well past the landing craft lane, still inside the water
//rather than against the skybox wall at y -8000, and a little above the -520 surface so the flash is
//not clipped by it.
//
//BUDGET. TWO entities per volley since the report got its own carrier (see the note further down):
//the 0.55s flash, and an invisible dummy.tik mark living ~6.5-7.0s to carry the sound. Against a
//2.5-8.5s period that is at most ~4 slots live at once, not the one slot this paragraph used to
//claim. It also stops on its own after 200 rounds - a bombardment that outlives the map is a leak
//with a nice name.
//=========================================================================
coop_navalGunfire:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_navalOn == NIL){ level.coop_navalOn = 1 }
	if(!level.coop_navalOn){ end }
	if(level.coop_navalDone == 1){ end }
	level.coop_navalDone = 1

	//"starting once you're off the higgins boat" - the handoff sets this, and the non-cinematic paths
	//set it too, so this cannot wait forever on a beat that never happened.
	local.t = 0
	while(level.coop_rampDone != 1 && local.t < 120){
		wait 0.5
		local.t = local.t + 0.5
	}
	wait 2

	local.fired = 0
	while(level.coop_navalOn && local.fired < 200){
		//--- the flash, out on the water
		local.p = (0 0 0)
		local.p[0] = ( 0 - 4200 ) + (randomint 8400)
		local.p[1] = ( 0 - 7000 ) + (randomint 2400)		//[bug-2364] further out still
		local.p[2] = ( 0 - 470 ) + (randomint 90)

		local.fx = spawn "models/animate/fx_mortar_higgins.tik"
		if(local.fx != NULL && local.fx != NIL){			//entity-pool guard
			local.fx.origin = local.p
			local.fx notsolid
			//[user 2026-09-02, bug-2364] "the explosion effect you are using out in the distance to
			//resemble the battleships shooting doesnt look accurate at all... maybe make them
			//smaller too so they appear to have distance."
			//
			//It was a full-size mortar-into-water effect - the same one used for shells landing a
			//few metres away - played four thousand units out. At full scale the eye reads it as
			//something happening CLOSE, which is exactly backwards: the whole point is that these
			//are miles away. 0.30 is the honest size for the distance, and it is now a brief flash
			//rather than a lingering plume (1.2s -> 0.55s), because at that range you would see the
			//muzzle flash and essentially nothing else.
			local.fx scale 0.30
			local.fx anim start
			thread coop_fxCleanup local.fx 0.55
			local.fired++

			//--- and the report, after the light. coop_arty_leadin_far* are the mod's own long-range
			//aliases; the retail ones carry maxdist 1600, which in this engine is a hard START gate,
			//so a gun firing four thousand units out would simply not play at all.
			//
			//[2026-09-02] THE REPORT WAS PLAYING ONE TIME IN TEN, AND THE OTHER NINE WERE SILENT.
			//It used to be `local.fx playsound` after this wait - but the cleanup above removes the
			//flash at 0.55s while the wait draws uniformly from [0.5, 1.0], so the entity carrying
			//the sound was already gone for every draw above 0.55. The guard below it caught the
			//NULL and skipped the sound without a word. The user's report - naval flashes that do
			//not line up with anything you can hear - is this.
			//
			//The flash MUST stay short (0.30 scale, 0.55s) - that is what sells the distance - so
			//the sound gets its own carrier rather than a longer-lived flash. This is the same
			//dummy.tik mark that coop_smokeSignal_round uses to make a shell land where it lands.
			local.mark = spawn script_model
			if(local.mark != NULL && local.mark != NIL){
				local.mark model "models/fx/dummy.tik"
				local.mark.origin = local.p
				local.mark notsolid
			}

			wait ( 0.5 + ( randomfloat 0.5 ) )
			if(local.mark != NULL && local.mark != NIL){
				local.r = randomint 3
				if(local.r == 0){ local.mark playsound coop_arty_leadin_far1 }
				else if(local.r == 1){ local.mark playsound coop_arty_leadin_far2 }
				else{ local.mark playsound coop_arty_leadin_far3 }
				//outlive the report itself, then free the slot - the entity pool is shared with
				//several hundred pieces of beach scenery.
				thread coop_fxCleanup local.mark 6
			}
		}

		//irregular, because a metronome reads as a machine rather than a fleet
		wait ( 2.5 + ( randomfloat 6 ) )
	}
}end

//=========================================================================
//[user 2026-09-02, bug-2339] ROUNDS COMING INTO THE WATER, SEEN FROM UNDER IT.
//
//"it would be cool to also see bullets entering the water during our cinematic moment where we fall
//into the water."
//
//This is the most recognisable image of the sequence and the engine already owns every piece of it:
//    models/fx/bh_water_hard.tik      the entry - the white punch through the surface
//    models/fx/water_trail_bubble.tik the cavitation track the round drags down behind it
//Neither carries damage, and both put their emitters in `init { client { } }` rather than the server
//block - which is the detail that makes this work at all. A CLIENT init fires when the entity first
//arrives in a snapshot, by which time the server has already set the origin, so the ordinary
//spawn-then-position pattern is correct here. Had the sfx been in the server block it would have
//fired at the origin before positioning and every round would have burst at the world origin.
//
//IN BURSTS, NOT EVENLY. Machine guns fire in bursts, and an even drizzle of impacts reads as rain.
//4-8 rounds at 60-130ms, then a gap - so the water goes quiet, and then it does not.
//
//THE ROUNDS ARRIVE IN FRONT OF THE CAMERA. The pose holds yaw 90, which faces +Y - inland, toward
//the shore - so the band is placed ahead in +Y where it will actually be seen, rather than evenly
//around a camera that only ever looks one way.
//=========================================================================
coop_waterBullets local.wx local.wy:{
//=========================================================================
	if(level.coop_waterBulletsOn != 1){ end }

	local.fired = 0
	while(level.coop_waterBulletsOn == 1 && local.fired < 240){

		//--- a burst
		local.burst = 4 + ( randomint 5 )
		local.b = 0
		while(local.b < local.burst && level.coop_waterBulletsOn == 1 && local.fired < 240){
			local.px = local.wx + ( 0 - 190 ) + ( randomint 380 )
			local.py = local.wy + 40 + ( randomint 300 )

			//--- the entry wound in the surface
			local.hit = (0 0 0)
			local.hit[0] = local.px
			local.hit[1] = local.py
			local.hit[2] = 0 - 520

			local.e = spawn script_model model "models/fx/bh_water_hard.tik"
			if(local.e != NULL && local.e != NIL){			//entity-pool guard
				local.e.origin = local.hit
				local.e notsolid
				thread coop_fxCleanup local.e 1.6
				local.fired++
			}

			//--- and the track down. Two beads, each deeper and offset a little, so the round reads
			//as travelling rather than as a mark stamped on the surface. It stops well short of the
			//sand at -576, which is what a round actually does - they run out fast in water.
			local.d = 0
			while(local.d < 2){
				local.tp = (0 0 0)
				local.tp[0] = local.px + ( 0 - 6 ) + ( randomint 12 )
				local.tp[1] = local.py + ( 0 - 6 ) + ( randomint 12 )
				local.tp[2] = ( 0 - 528 ) - ( local.d * 9 )

				local.t = spawn script_model model "models/fx/water_trail_bubble.tik"
				if(local.t != NULL && local.t != NIL){
					local.t.origin = local.tp
					local.t notsolid
					thread coop_fxCleanup local.t 1.3
				}
				local.d++
			}

			local.b++
			wait ( 0.06 + ( randomfloat 0.07 ) )
		}

		//--- the gap between bursts
		wait ( 0.35 + ( randomfloat 0.85 ) )
	}
}end


//=========================================================================
//[user 2026-09-02, bug-2340] WHAT THE TIDE LEFT.
//
//"there should definitely be dead bodies and guns in there... maybe a typewriter somewhere... things
//that show weight has drowned people"
//
//WHAT ACTUALLY SANK AT OMAHA, and how much of it can honestly be shown here:
//  * The 741st Tank Battalion launched 29 DD Shermans about 6,000 yards out. 27 went down almost at
//    once in the swell. That is over three miles offshore - so they are NOT placed. Putting drowned
//    tanks where the player can see them would be the one detail everybody who knows the story would
//    catch. The tank wrecks already on this beach are the ones landed directly by LCT, which is right.
//  * The 111th Field Artillery lost all but one of its 105mm howitzers when the DUKWs carrying them
//    swamped - again, well out.
//  * What went down IN the surf, and is therefore fair game, is the men and what they carried. A
//    rifleman came off the ramp under 60-80lb; assault engineers and mortar crews well over 90. The
//    M-926 life belt was issued to be worn under the arms and was almost universally worn at the
//    waist, so when it inflated on a loaded man it rolled him face down and held him there. That one
//    object is the whole story of the drownings, which is why af_p_lifepreserver is in every band.
//  * Everything else here is the documented jettison list: gas masks (ditched near universally),
//    packs, entrenching tools, canteens, helmets, bangalores, ammo boxes and the rifles of men who
//    went down - plus the stretchers, tarpaulins and cots of the aid parties above the tideline.
//  * The typewriter is the user's, and it is a later-wave object rather than a first-wave one: HQ and
//    beach-group detachments landed with office kit, and photographs of the beach afterwards are full
//    of that sort of incongruous freight. It is placed once, high up near the shingle, as a single
//    deliberate absurdity rather than as set dressing.
//
//CLUSTERS, NOT CONFETTI. Most of the field is dropped as clusters - one body with two to four pieces
//of his kit inside ninety units - because that reads as a man who went down, where an even scatter
//reads as litter. A handful of loose pieces fill the gaps between.
//
//SEATED BY TRACE, NOT BY GUESS. Every piece traces straight down against world geometry only
//(`trace start end 1`, MASK_SOLID with entities excluded) and takes the surface it finds. A result
//outside -700..-360, or one that barely moved - which is what a trace starting inside solid returns -
//is DISCARDED rather than placed, so this can leave a gap but cannot embed a rifle in a bunker wall
//or hang a body in the air. Floating bodies skip the trace by design and ride the -520 surface.
//
//Everything is notsolid. Ninety-odd props on a beach the player has to cross at a run is exactly the
//situation where cosmetic clutter turns into a snag, and none of this is meant to be cover.
//=========================================================================
coop_beachWreckage:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_wreckOn == NIL){ level.coop_wreckOn = 1 }
	if(!level.coop_wreckOn){ end }
	if(level.coop_wreckDone == 1){ end }
	level.coop_wreckDone = 1

	//--- the kit of a man who did not make it
	//[user 2026-09-02, bug-2346] FOUR OF THESE NEVER LOADED. The user's own console:
	//    ^~^~^ Bad model name 'models/equipment/usbackpack.tik'
	//    ^~^~^ Bad model name 'models/equipment/uscanteen.tik'
	//    ^~^~^ Bad model name 'models/equipment/usknife_backpack.tik'
	//    ^~^~^ Bad model name 'models/equipment/usshovel_backpack.tik'
	//each preceded by TIKI_InitTiki failing on its .skc (backpack.skc, canteen.skc, ...). These are
	//ATTACHMENT models - gear hung off a soldier's skeleton - and they have no standalone animation to
	//load, so spawning one as a prop fails outright. The spawn returned an entity, my NULL guard passed,
	//and nothing rendered: a quarter of the field was invisible and the placed= count was a lie.
	//THE LESSON, and it is a new one for this file: `models/equipment/` is for ATTACHING, not spawning.
	//Only models under models/static/ (and the animate/ bodies) are standalone props.
	local.k = 0
	local.k++; local.kit[local.k] = "models/static/af_p_lifepreserver.tik"
	local.k++; local.kit[local.k] = "models/static/af_p_lifepreserver.tik"
	//[user 2026-09-02, bug-2375] THE HELMETS WERE THE WRONG CLASS OF MODEL ALL ALONG.
	//
	//models/equipment/ushelmet.tik is an ATTACHMENT model - `path models/equipment/usgear/helmets`,
	//a bare skelmodel with empty server and client init blocks. It exists to be hung on a soldier's
	//HEAD BONE, so its origin is authored for that bone, not for resting on sand. That is why it
	//kept hovering no matter how tight the ground test got: the test was placing the ORIGIN
	//correctly every time and the mesh simply is not where the origin is. Exactly the same family
	//as usbackpack/uscanteen/usknife_backpack, which did not even load (bug-2346) - I dropped those
	//four for failing loudly and kept these two because they failed quietly.
	//
	//models/static/static_ushelmet_* are the ground-prop versions of the same helmets, and they are
	//what the BSP itself places on this beach - 34 of them, none of which float.
	local.k++; local.kit[local.k] = "models/static/static_ushelmet_private.tik"
	local.k++; local.kit[local.k] = "models/static/static_ushelmet_private_net.tik"
	local.k++; local.kit[local.k] = "models/static/static_us-helmet_29th.tik"
	local.k++; local.kit[local.k] = "models/static/static_us-helmet_engineer01.tik"
	local.k++; local.kit[local.k] = "models/static/static_m1_garand.tik"
	local.k++; local.kit[local.k] = "models/static/static_m1_garand.tik"
	local.k++; local.kit[local.k] = "models/static/static_thompsonsmg.tik"
	local.kitN = local.k

	//--- the men
	local.k = 0
	//[bug-2346] models/static/, which is the copy retail spawns itself (M3L3.scr:8944 does exactly
	//`spawn script_model` / `model "models/static/body_us04.tik"` / origin / `angles (3 180 0)`).
	local.k++; local.bod[local.k] = "models/static/body_us01.tik"
	local.k++; local.bod[local.k] = "models/static/body_us02.tik"
	local.k++; local.bod[local.k] = "models/static/body_us03.tik"
	local.k++; local.bod[local.k] = "models/static/body_us04.tik"
	local.k++; local.bod[local.k] = "models/static/body_us05.tik"
	local.k++; local.bod[local.k] = "models/static/body_us06.tik"
	local.bodN = local.k

	//--- freight, which only makes it as far as the wet flat and the dry sand
	//[bug-2346] ammobox3 and wooden_barrel both reported Bad model name too - ammobox3.tik is a
	//malformed custom TIKI (the console shows TIKI_ParseSetup rejecting '{', 'init', 'server' and
	//'classname' inside its setup block) and wooden_barrel fails on its own .skc.
	local.k = 0
	local.k++; local.frt[local.k] = "models/coop_build/box_crate_30cal.tik"
	//[user 2026-09-02] "just get rid of these wood piles you have on the map those are buggy
	//looking" - plank_wood is gone.
	local.k++; local.frt[local.k] = "models/static/static_bangalore.tik"
	local.frtN = local.k

	local.made = 0

	//-----------------------------------------------------------------
	//CLUSTERS - a body and his kit around him
	//-----------------------------------------------------------------
	local.c = 0
	while(local.c < 16){
		local.cx = ( 0 - 2500 ) + ( randomint 5000 )
		local.cy = ( 0 - 2500 ) + ( randomint 1500 )		//the runnel and the wet flat

		//the man himself
		local.n = waitthread coop_wreckDrop local.bod[( randomint local.bodN ) + 1] local.cx local.cy 0
		local.made = local.made + local.n

		//and two to four pieces of what he was carrying, close in
		local.q = 2 + ( randomint 3 )
		local.j = 0
		while(local.j < local.q){
			local.ix = local.cx + ( 0 - 90 ) + ( randomint 180 )
			local.iy = local.cy + ( 0 - 90 ) + ( randomint 180 )
			local.n = waitthread coop_wreckDrop local.kit[( randomint local.kitN ) + 1] local.ix local.iy 0
			local.made = local.made + local.n
			local.j++
		}
		local.c++
	}

	//-----------------------------------------------------------------
	//OFFSHORE - men who never reached the sand, riding the surface
	//-----------------------------------------------------------------
	local.c = 0
	while(local.c < 7){
		local.px = ( 0 - 2300 ) + ( randomint 4600 )
		local.py = ( 0 - 3000 ) + ( randomint 520 )
		local.n = waitthread coop_wreckDrop local.bod[( randomint local.bodN ) + 1] local.px local.py 1
		local.made = local.made + local.n
		//a belt that did its job on a man it could not save
		local.n = waitthread coop_wreckDrop "models/static/af_p_lifepreserver.tik" ( local.px + 50 ) ( local.py + 30 ) 1
		local.made = local.made + local.n
		local.c++
	}

	//-----------------------------------------------------------------
	//LOOSE KIT everywhere between the water and the shingle
	//-----------------------------------------------------------------
	local.c = 0
	while(local.c < 26){
		local.px = ( 0 - 2600 ) + ( randomint 5200 )
		local.py = ( 0 - 2600 ) + ( randomint 2150 )
		local.n = waitthread coop_wreckDrop local.kit[( randomint local.kitN ) + 1] local.px local.py 0
		local.made = local.made + local.n
		local.c++
	}

	//-----------------------------------------------------------------
	//FREIGHT on the wet flat and up toward the shingle
	//-----------------------------------------------------------------
	local.c = 0
	while(local.c < 14){
		local.px = ( 0 - 2400 ) + ( randomint 4800 )
		local.py = ( 0 - 1500 ) + ( randomint 1100 )
		local.n = waitthread coop_wreckDrop local.frt[( randomint local.frtN ) + 1] local.px local.py 0
		local.made = local.made + local.n
		local.c++
	}

	//-----------------------------------------------------------------
	//THE HIGH WATER LINE - the aid party's gear, and one typewriter
	//-----------------------------------------------------------------
	//[user 2026-09-02, bug-2372] "thisw is still floating, just get rid of it at this point or move
	//it elsewhere where you can ensure its on the ground" - and then "you can move that stuff out
	//further to the left side of the beach its barren over there".
	//
	//So they move left, to x -3000..-1900, which is open sand well clear of the obstacle belt the
	//perched test keeps rejecting them onto. And they go through coop_wreckSeat, which is the same
	//placement but with a HARD tolerance of 8 and no retry: if that one spot is not honest ground,
	//the prop simply does not exist. For a handful of deliberate set-dressing pieces that is the
	//right trade - the user would rather not see it at all than see it hovering.
	local.n = waitthread coop_wreckDrop "models/static/af_p_stretcher.tik" ( ( 0 - 3000 ) + ( randomint 1100 ) ) ( ( 0 - 760 ) + ( randomint 300 ) ) 0
	local.made = local.made + local.n
	local.n = waitthread coop_wreckDrop "models/static/af_p_stretcher.tik" ( ( 0 - 2900 ) + ( randomint 1000 ) ) ( ( 0 - 700 ) + ( randomint 260 ) ) 0
	local.made = local.made + local.n
	//[user 2026-09-02] "remove your randomn body bags" - bodies_tarp is gone.
	local.n = waitthread coop_wreckDrop "models/static/cot.tik" ( ( 0 - 2950 ) + ( randomint 1050 ) ) ( ( 0 - 680 ) + ( randomint 240 ) ) 0
	local.made = local.made + local.n
	local.n = waitthread coop_wreckDrop "models/items/papers.tik" ( ( 0 - 2800 ) + ( randomint 900 ) ) ( ( 0 - 640 ) + ( randomint 220 ) ) 0
	local.made = local.made + local.n

	//one typewriter, high up, where a beach group's freight came apart. See the header.
	local.n = waitthread coop_wreckDrop "models/static/typewriter.tik" ( ( 0 - 2700 ) + ( randomint 800 ) ) ( ( 0 - 620 ) + ( randomint 200 ) ) 0
	local.made = local.made + local.n

	println("^~^~^ WRECKAGE placed=" + local.made + " rejectedPerched=" + level.coop_wreckRej)
}end


//One piece of wreckage. Returns 1 if it was placed, 0 if the ground under it was not sane - see the
//header on coop_beachWreckage for why a discard is preferred to a guess.
//=========================================================================
coop_wreckDrop local.mdl local.px local.py local.float local.try:{
//=========================================================================
	//[user 2026-09-02, bug-2357] "random floating helmet above the water when we get out of the water".
	//
	//MEASURED, not guessed. Two independent BSP raycasters replaying this exact function over
	//m3l1a.bsp across 300 map loads agree: ~0.4-0.66 wreckage props per load came to rest ABOVE the
	//water plane, up to 120 units clear of it, and 75% of them were sitting inside the footprint of an
	//entry in obstacles.scr. The trace is a zero-extent point ray against CONTENTS_SOLID|CONTENTS_FENCE
	//(scriptthread.cpp:3944-3987), so it happily lands on the textures/common/nodraw and woodclip hulls
	//wrapping the hedgehogs, log ramps and Belgian gates - and the acceptance window below cannot tell
	//the top of a tank trap from sand, because the tops fall inside it.
	//
	//NOTE MY EARLIER FIX WAS WRONG. I removed the float path believing it was the cause; helmets can
	//never reach it - float=1 is passed only for bodies and life preservers, the kit array is always
	//passed 0. And droptofloor cannot rescue it either: the prop starts one unit above the clip the
	//trace just found, so a box trace down re-seats it on that same clip.
	//
	//THE REAL DEFECT IS THAT THIS WAS THE ONE PLACEMENT SITE IN THE FILE WITH NEITHER GUARD. Every
	//other site calls coop_dropSpot to step clear of the obstacle table AND runs the perched test that
	//bugs 2262/2267/2268 exist to enforce. A new call site re-armed an old bug. Both guards are added
	//below; pad 45 and tolerance 40 are the measured values that take floating props to ZERO across
	//three independent seeds, and coop_dropSpot MOVES rather than discards, so field density is
	//essentially unchanged (1 discard in 49,218 drops).
	local.xy = (0 0 0)
	local.xy[0] = local.px
	local.xy[1] = local.py
	local.xy = waitthread coop_dropSpot local.xy 45
	if(local.xy == NULL){ end 0 }
	local.px = local.xy[0]
	local.py = local.xy[1]

	//[user 2026-09-02, bug-2376] NOTHING GOES NEAR THE HIGGINS. A screenshot showed helmets hanging
	//in the air at the boat's gunwale height: $higgins1_clip is a SOLID_BSP push-brush and it is
	//still solid at map load - coop_higginsSinkSafe does not make it notsolid until fifteen seconds
	//after the handoff - so the seating trace lands on the BOAT and the prop rides its deck. The
	//perched test then compares against a sand datum that is sixty units lower and should catch it,
	//but the honest fix is not to place anything there in the first place: it is where the player
	//starts, and a prop on the hull is wrong even when it is correctly grounded on it.
	if(level.flags["coop_spawn1origin"] != NIL){
		local.bo = level.flags["coop_spawn1origin"]
		local.bdx = local.px - local.bo[0]
		local.bdy = local.py - local.bo[1]
		if(local.bdx < 0){ local.bdx = 0 - local.bdx }
		if(local.bdy < 0){ local.bdy = 0 - local.bdy }
		if(local.bdx < 420 && local.bdy < 620){ end 0 }
	}

	local.pos = (0 0 0)
	local.pos[0] = local.px
	local.pos[1] = local.py

	//[user 2026-09-02] THE FLOAT PATH IS GONE. "the bodies during the cinematic scene that are in the
	//water need to actually be laying dead at teh bottom", and "random floating helmet above the water".
	//Bodies riding the -520 surface were a deliberate image and the user does not want it; worse, the
	//shallow band near the waterline (the water is only 3-20 units deep from y -900 inland) put small
	//props within a couple of units of the surface, where anything reads as floating on it. Everything
	//goes to the seabed now.
	if(local.float == 1){
		local.pos[2] = 0 - 574
	}else{
		local.top = (0 0 0)
		local.top[0] = local.px
		local.top[1] = local.py
		local.top[2] = 0 - 240
		local.bot = (0 0 0)
		local.bot[0] = local.px
		local.bot[1] = local.py
		local.bot[2] = 0 - 720

		local.hit = trace local.top local.bot 1
		if(local.hit == NIL){ end 0 }
		local.gz = local.hit[2]
		//a trace that started in solid returns its start, and one that fell through returns its end
		if(local.gz > ( 0 - 360 )){ end 0 }
		if(local.gz < ( 0 - 700 )){ end 0 }

		//[bug-2357] THE PERCHED TEST, the same one every other placement site in this file runs. The
		//window above cannot distinguish sand from the top of an obstacle, so ask where the ground
		//SHOULD be: a static model sits on it, so the nearest one is a valid local datum, and the
		//y-band profile is the fallback. More than 40 units above that and we are standing on
		//something - discard rather than place, because a gap in the field costs nothing and a helmet
		//hanging over the water is the thing being reported.
		local.pos[2] = local.gz + 1
	}

	//[user 2026-09-02, bug-2347] SPAWNED THE WAY RETAIL SPAWNS THESE - `spawn script_model` and then
	//`model` as a separate command (M3L3.scr:8935). The one-liner form worked, but this is the proven
	//path and it costs nothing to match it.
	local.o = spawn script_model
	if(local.o == NULL || local.o == NIL){ end 0 }		//entity-pool guard
	local.o model local.mdl
	local.o.origin = local.pos

	//ANGLES BEFORE THE DROP, and NEARLY FLAT. "the stretcher ... its not laying flat on teh gorund its
	//floating", and a screenshot of a corpse folded into the sand. My previous +-30 pitch and +-40 roll
	//tipped every prop into or out of the ground - on a body that reads as a mangled corpse rather than
	//as a dead man. Retail lays its own corpses at exactly `angles (3 180 0)`: three degrees, no roll.
	local.ry = randomint 360
	local.rp = randomint 4
	local.o.angles = ( local.rp local.ry 0 )

	//AND THEN LET THE ENGINE SEAT IT. droptofloor (fgame/entity.cpp:985) drops the entity using its own
	//bounding box, which is the thing my hand-rolled `ground + 1` could not know: every model carries a
	//different origin-to-mesh offset, so one constant put helmets proud of the sand and bodies inside
	//it. A short 120-unit range so a prop over a hole cannot fall out of the world.
	local.o droptofloor 120

	//[user 2026-09-02, bug-2363] THE PERCHED TEST HAS TO RUN *AFTER* droptofloor. IT WAS BEFORE.
	//
	//"there are somany floating helmets dear god." I had already added a perched test here and
	//measured it to zero - but I measured the wrong thing. The test ran on the result of `trace`,
	//which is a ZERO-EXTENT point ray, and then droptofloor ran afterwards and MOVED the prop.
	//droptofloor is a BOX trace using the model's own bounding box, so it is wider than the ray:
	//it catches the edge of a tank-trap clip hull that the point ray passed cleanly beside, and
	//rests the helmet on top of it. Every helmet the user is seeing was validated at a position it
	//no longer occupied by the time it rendered.
	//
	//So the check now runs LAST, on the entity's actual final origin, and it cannot be outflanked
	//by anything that moves the prop - because nothing does, after this.
	local.want = waitthread coop_nearGroundZ local.o.origin[0] local.o.origin[1]
	if(local.want == NIL){ local.want = waitthread coop_groundZ local.o.origin[1] }
	if(local.want != NIL){
		//[bug-2363] TOLERANCE 40 -> 12, and this time it is measured rather than recommended.
		//Instrumenting every placement showed the good ones landing on the real seabed at -575.875
		//while the floaters traced to -539, -543, -546, -565, -571 - i.e. 18 to 38 units above the
		//expected ground, on obstacle clip hulls. A 40-unit tolerance passed EVERY ONE of them,
		//which is why the field still floated after a fix that had been "measured to zero".
		//12 clears the datum's own noise (traces legitimately land up to ~8 units either side of
		//the y-band estimate) and rejects everything that was actually perched.
		//[bug-2372] 12 -> 8. The user is still seeing a hovering stretcher at 12, and the measured
		//spread of an HONEST seating was -9.9..+5.8 - so the positive side never needed more than 6.
		//8 keeps the margin on the side that matters and stops accepting anything perched.
		if(local.o.origin[2] > ( local.want + 8 )){
			if(level.coop_wreckRej == NIL){ level.coop_wreckRej = 0 }
			level.coop_wreckRej++
			local.o remove
			//[bug-2363] RETRY RATHER THAN GIVE UP. Tightening the tolerance to its measured value
			//rejected 38 of 121 placements, which took the field from 124 pieces to 83 - correct,
			//but thinner than it should be. The obstacle belt is dense, not continuous, so a spot a
			//couple of hundred units away is usually clear. Up to three more tries before this piece
			//is genuinely abandoned; local.try is threaded through so the recursion is bounded and
			//cannot run away.
			if(local.try == NIL){ local.try = 0 }
			if(local.try < 3){
				local.nx = local.px + ( 0 - 220 ) + ( randomint 440 )
				local.ny = local.py + ( 0 - 220 ) + ( randomint 440 )
				end ( waitthread coop_wreckDrop local.mdl local.nx local.ny local.float ( local.try + 1 ) )
			}
			end 0
		}
	}
	//and a hard backstop that needs no datum at all: nothing in this field belongs above the
	//water plane. -516 rather than -520 so a prop legitimately seated at the shallow waterline
	//is not thrown away for being a couple of units proud.
	if(local.o.origin[1] < ( 0 - 780 ) && local.o.origin[2] > ( 0 - 516 )){
		local.o remove
		end 0
	}

	local.o notsolid
	end 1
}end

//=========================================================================
//[user 2026-09-02, bug-2343] THE FIRE COMING INTO THE BOAT.
//
//"we also need to make sure we can actually see the bullets physically shredding the guys in our
//higgins boats forming from those mg nests and bunkers. it needs to invoke a sense of how brutal
//this assault was and how deadly it is."
//
//THE TRACERS ARE REAL, not faked. The map's bunker and bluff MG42s are TurretGun entities, and the
//engine exposes exactly the three commands needed on them - `setaimtarget <ent>`, `startfiring`,
//`stopfiring` (fgame/weapturret.cpp:77,104,113, all bound at :387-391). e1l1 already drives tanks
//this way, so the recipe is proven rather than invented. Pointing the real guns at the men in the
//ramp mouth and opening up means the engine draws its own tracer stream, with `tracerfrequency 1`
//so every round shows - which is a far better image than any prop I could fly along the line, and it
//comes from the actual emplacements the player is about to have to clear.
//
//THE PLAYER CANNOT DIE HERE. Live turrets firing into a boat the player is standing in is a real way
//to lose him mid-cutscene, so every player takes `nodamage` for the window and gets it back the
//moment the set piece ends - including on the watchdog path, because a cinematic that fails halfway
//must never leave somebody permanently invulnerable. That restore is in a `while` that outlives the
//sequence rather than in a line after it, for exactly that reason.
//
//AND YOU SEE WHERE IT IS FROM. mg42_sideflash on each gun as it fires, so the nests are lit up and
//readable at distance rather than being a source of tracers from nowhere.
//=========================================================================
coop_rampIncoming:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampIncomingOn == NIL){ level.coop_rampIncomingOn = 1 }
	if(!level.coop_rampIncomingOn){ end }
	if(level.coop_rampIncomingDone == 1){ end }
	level.coop_rampIncomingDone = 1

	//--- nobody dies in the cutscene
	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){ $player[local.i] nodamage }
		local.i++
	}
	thread coop_rampIncomingSafety

	//--- the guns that bear on the beach in front of the boat
	local.n = 0
	if($mg42_bunker != NULL && $mg42_bunker != NIL){ local.n++; local.g[local.n] = $mg42_bunker }
	if($mg42_middle1 != NULL && $mg42_middle1 != NIL){ local.n++; local.g[local.n] = $mg42_middle1 }
	if($mg42_middle2 != NULL && $mg42_middle2 != NIL){ local.n++; local.g[local.n] = $mg42_middle2 }
	if($mg42_leftbunker1 != NULL && $mg42_leftbunker1 != NIL){ local.n++; local.g[local.n] = $mg42_leftbunker1 }
	if($mg42_rightbunker1 != NULL && $mg42_rightbunker1 != NIL){ local.n++; local.g[local.n] = $mg42_rightbunker1 }
	if(local.n < 1){ end }

	//--- something in the ramp mouth to aim at
	local.tgt = $higgins1_ranger1
	if(local.tgt == NULL || local.tgt == NIL){ local.tgt = $higgins1_ranger2 }
	if(local.tgt == NULL || local.tgt == NIL){ local.tgt = $higgins1_ranger3 }

	local.i = 1
	while(local.i <= local.n){
		if(local.tgt != NULL && local.tgt != NIL){ local.g[local.i] setaimtarget local.tgt }
		local.g[local.i] tracerfrequency 1
		local.g[local.i] startfiring
		local.i++
	}
	println("^~^~^ RAMPFIRE guns=" + local.n)

	//--- muzzle flashes for as long as the set piece runs
	local.t0 = level.time
	while(( level.time - local.t0 ) < 11 && level.coop_rampCineDone != 1){
		local.i = 1
		while(local.i <= local.n){
			if(local.g[local.i] != NULL && local.g[local.i] != NIL){
				local.fl = spawn script_model model "models/fx/mg42_sideflash.tik"
				if(local.fl != NULL && local.fl != NIL){		//entity-pool guard
					local.fl.origin = local.g[local.i].origin + (0 0 12)
					local.fl notsolid
					thread coop_fxCleanup local.fl 0.5
				}
			}
			local.i++
		}
		wait ( 0.10 + ( randomfloat 0.10 ) )
	}

	local.i = 1
	while(local.i <= local.n){
		if(local.g[local.i] != NULL && local.g[local.i] != NIL){
			local.g[local.i] stopfiring
			local.g[local.i] clearaimtarget local.tgt
		}
		local.i++
	}
}end


//Hands the players their mortality back. Separate thread and a generous outer bound on purpose: if the
//set piece dies halfway - watchdog, a dropped player, anything - the one thing that must not survive it
//is a permanently invulnerable player.
//=========================================================================
coop_rampIncomingSafety:{
//=========================================================================
	local.t = 0
	while(local.t < 60 && level.coop_rampCineDone != 1){
		wait 0.5
		local.t = local.t + 0.5
	}
	wait 0.5
	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){ $player[local.i] takedamage }
		local.i++
	}
	println("^~^~^ RAMPFIRE players mortal again")
}end

//=========================================================================
//[user 2026-09-03] THE BOAT GETS HIT, AND THE RAMP LANDS ON SOMETHING.
//
//"its kinda awkward you just stand staring straight as everyone gets machine gunned down". One
//measurable reason: NOTHING IN THIS BEAT MAKES A SOUND AGAINST THE BOAT. Decoded off the wavs and
//off m3l1a.scr's own waits, T+0 = the ramp starting down ($higgins1_door_origin move):
//  T-4.3 higgins_whistle      Mec_Whistle_01.wav       2.05s
//  T-2.3 higgins_door_opening DoorHigginsOpen_04.wav   5.40s - a FLAT MACHINERY BED. A 0.1s RMS
//        sweep peaks at its own 3.0s and its largest step-up anywhere is x3.22; a real impact take
//        steps up by an order of magnitude. There is no slam in the file.
//  T+0.60 higgins_bullet_hits Amb_M3_FirstHits_01.wav  1.85s - the ONLY rounds cue in the beat, and
//        a one-shot ambience wash out of sound/amb/. Retail's `wait .6` (m3l1a.scr:2777) runs
//        CONCURRENTLY with the 0.65s move, so it lands 0.05s BEFORE horizontal, not after.
//        higgins_guys_rush   dfr_group_higgins02.wav 20.61s - the men shouting. Real, and long.
//  T+0.65 THE RAMP REACHES HORIZONTAL AND NOTHING FIRES THERE AT ALL.
//  T+2.00 coop_rampCinematic threads coop_rampIncoming: five MG42s startfiring, setaimtarget on a
//        ranger in the mouth, tracerfrequency 1 (coopified.scr:7798-7804). Real fire - but all of it
//        muzzle noise up the bluff, and coop_rampIncoming has ZERO playsound. Nothing hits the HULL.
//  T+2.60 arty_leadin, shell at T+3.60.
//The window with no gunfire audible at all is T+0.65..T+2.00; after that there is fire, but none of
//it is near you and the hull is never struck once. That is the diorama.
//
//THE KIT SHIPPED WITH THE MAP AND WAS NEVER USED IN THE BOAT. ubersound/ubersound.scr:1363-1382 has
//hedgehog_supression1..10 and ramp_supression1..10, both scoped maps "m3l1a " - six metal takes
//(wpn_impmetal05/06/13/16/19/23), six timber (wpn_impwood03/05/06/08/10/14), eight WhizBy near
//misses. Retail reaches them only from the beach cover system (m3l1a.scr:2031-2039).
//
//WHY THE TAKE NUMBERS SKIP 1 AND 10. Alias lookup is a PREFIX match over the QUERY length
//(Alias_ListFindRandomRange strncmp, qcommon/alias.c:544; the only candidate it refuses is one whose
//next char is an underscore, :570), so "hedgehog_supression1" also matches ...10, and 10 is a WhizBy,
//not an impact. 2..6 are unambiguously impacts, 7..9 whizzes. randomint N gives 0..N-1, so
//(randomint 5)+2 is 2..6 and (randomint 3)+7 is 7..9. Same rule is why bare "arty_leadin" (6 takes
//admitted here) and "snd_bodyfall_metal" work although neither exists as a bare alias.
//
//THE SLAM IS THREE METAL LAYERS AND NO WATER - A CORRECTION. The first cut used impact_watersplash1.
//THAT ALIAS IS DEAD ON THIS MAP: ubersound:197 is the only impact_watersplash1 the m3 filter admits
//(:1993's copy is e-series only) and its path is "sound/characters/body_fallwater_02" with NO
//EXTENSION. S_LoadSound passes the name straight to FS_FOpenFileRead with no extension fallback
//(snd_mem_new.cpp:466), and the live client log says so:
//    Couldn't load sound: sound/characters/body_fallwater_02
//    (G:/mohaa-gl2/home/maintt/qconsole.log 2026-09-03 12:00:43 - the ONLY failed sound in the whole
//     session, so nothing else used here is affected)
//The other admitted water alias, impact_leavewater, fails for the opposite reason: bug-2289
//re-declared it FOR this map because the engine fires it constantly whenever anything leaves water on
//Omaha, so one more copy would blend into the wading and read as nothing. So the water layer is
//dropped and the third layer is snd_bodyfall_metal (ubersound:215-218, body_fallmetal_01..04.wav,
//volume 1.0, maps "m1 m2 m3 m4 m5 m6") - the heaviest dull metal impact in the pack, and one
//effectively never heard on a sand map.
//
//CHANNELS, so nothing cuts anything off. hedgehog_supression*/ramp_supression*/king_vehicle_crash*
//are channel auto (a free channel each time), door_metal_close_stop* is item, snd_bodyfall_metal* is
//body - three channels for the three slam layers, so they cannot steal from each other even where
//two share an emitter. Alias volume is G_Random()*volumeMod + volume (entity.cpp:3730), so none of
//them can come out at zero.
//
//NOTHING IS DUCKED HERE, DELIBERATELY. bug-2319 moved the effects duck out of the run-up and into
//coop_rampAudioCut, one frame after the shell, so for this whole beat s_sfxduck is 1.0 and everything
//plays at 100%. The 34s s_sfxduck RISE at the end of coop_m3l1a_beachAudio is ~100s later (95 + 1.2
//of waits after the cut) and cannot reach this - re-checked after bug-2425 made that fade run its
//full 34s instead of 24. Everything below is ADDITIVE - no cvar write, no s_volume, no tmvolume, no
//stufftext - so it cannot make anything quieter and cannot regress bugs 2354/2369/2378/2390.
//
//WHERE THE EMITTERS SIT. Every player's listener is at exactly $higgins1_playerspot.origin +
//(0 0 85): coop_spawnBoatCamera (m3l1a.scr:8786-8787) puts EVERY player's camera there and binds it
//to that spot. Offsets measured from map_entities/m3l1a_entities.txt: playerspot 352 -7440 -464,
//hull centreline x 384 (higgins1_door_origin 384, higgins1_model 382.72), ranger spots x 344..416,
//coxswain x 328 - so the player stands 32 to port of centre and the inner walls are about x 319 and
//x 449. The hinge is y -7266 against a playerspot at y -7440, so the mouth is 174 forward. All three
//emitters land inside their alias minDist (160 for the supression kit, 320 for the bodyfall), i.e.
//full volume. $higgins1_playerspot is bound to the boat (m3l1a.scr:584) and the origin getter returns
//the WORLD origin for a bound entity (entity.cpp:2452). The boat is stopped by now - higgins1_landing
//waitmoves its last leg BEFORE threading higgins1_opening_sequence, leaving an 8-unit settle - so the
//emitters are seated once and re-seated once at the slam, not chased.
//
//A SOUND ON A SPAWNED script_origin DOES PLAY AND IS POSITIONED. Entity::Sound sends the entity's own
//s.origin with the sound (entity.cpp:3744, :3820), and S_OPENAL_StartSound flags a channel whose
//entity never reaches the client CHANNEL_FLAG_MISSING_ENT (snd_openal_new.cpp:1876-1880, the comment
//there naming script_origin specifically), which is what stops the respatialiser killing it at :2951.
//Same pattern as coop_mod/ambience.scr:240-242.
//
//level.coop_rampHullOn 0 restores today's behaviour exactly.
//=========================================================================
coop_rampHullFire:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampHullOn == NIL){ level.coop_rampHullOn = 1 }
	if(!level.coop_rampHullOn){ end }
	if(level.coop_rampHullDone == 1){ end }
	level.coop_rampHullDone = 1
	if($higgins1_playerspot == NULL || $higgins1_playerspot == NIL){ end }

	//--- three emitters: port gunwale, starboard gunwale, ramp mouth. Entity-pool guarded, and
	//    anything already made is handed back if a later one fails.
	local.a = spawn script_origin
	if(local.a == NULL || local.a == NIL){
		println("^~^~^ RAMPHULL abort - no entity for the port emitter")
		end
	}
	local.b = spawn script_origin
	if(local.b == NULL || local.b == NIL){
		local.a remove
		println("^~^~^ RAMPHULL abort - no entity for the starboard emitter")
		end
	}
	local.c = spawn script_origin
	if(local.c == NULL || local.c == NIL){
		local.a remove
		local.b remove
		println("^~^~^ RAMPHULL abort - no entity for the mouth emitter")
		end
	}
	waitthread coop_rampHullPlace local.a local.b local.c
	local.tstart = level.time
	println("^~^~^ RAMPHULL start")

	//--- the ramp is travelling (0.65s): rounds start finding the widening gap.
	local.k = 0
	while(local.k < 4){
		if(local.k == 0){
			local.a playsound ( "hedgehog_supression" + ( ( randomint 5 ) + 2 ) )
		}else if(local.k == 1){
			local.c playsound ( "ramp_supression" + ( ( randomint 5 ) + 2 ) )
		}else if(local.k == 2){
			local.b playsound ( "hedgehog_supression" + ( ( randomint 5 ) + 2 ) )
		}else{
			local.c playsound ( "ramp_supression" + ( ( randomint 3 ) + 7 ) )
		}
		wait ( 0.09 + ( randomfloat 0.05 ) )
		local.k++
	}
	//the four random gaps sum to 0.36..0.56, so wait out the remainder rather than letting the slam
	//drift up to a quarter second early. The ramp is horizontal at 0.65. level.time is SECONDS
	//(level.cpp:1112, inttime / 1000.0f).
	local.rem = ( 0.62 - ( level.time - local.tstart ) )
	if(local.rem > 0){ wait local.rem }

	//--- THE RAMP LANDS. Three layers on three channels: the dull heavy thud of it arriving, the
	//    steel groan, the stops clanging beside you. The jitter is small and short ON PURPOSE - the
	//    shell three seconds later runs 2.4/2.6/2200 and must stay the biggest thing here.
	waitthread coop_rampHullPlace local.a local.b local.c
	local.c playsound snd_bodyfall_metal
	local.c playsound king_vehicle_crash3
	local.a playsound door_metal_close_stop1
	if($higgins1_playerspot != NULL && $higgins1_playerspot != NIL){
		local.q = $higgins1_playerspot.origin
		thread coop_mod/main.scr::earthquake_radius local.q 0.45 0.55 500
	}
	println("^~^~^ RAMPHULL slam")

	//--- and then being shot at, in two densities: hard on the hull while the mouth is open and the
	//    men are dying in it, then thinning to near-misses only, so the killing shell's own
	//    arty_leadin at T+2.60 is heard clean. Bounded at 2.5s, ending T+3.15 - 0.45s of air before
	//    the shell. Exits early if the cinematic cuts the audio or finishes.
	local.t0 = level.time
	local.el = 0
	while(local.el < 2.5 && level.coop_rampAudioCut != 1 && level.coop_rampCineDone != 1){
		local.r = ( randomint 10 )
		if(local.el < 1.9){
			if(local.r < 2){
				local.a playsound ( "hedgehog_supression" + ( ( randomint 5 ) + 2 ) )
			}else if(local.r < 4){
				local.b playsound ( "hedgehog_supression" + ( ( randomint 5 ) + 2 ) )
			}else if(local.r < 7){
				local.c playsound ( "ramp_supression" + ( ( randomint 5 ) + 2 ) )
			}else if(local.r < 9){
				local.a playsound ( "ramp_supression" + ( ( randomint 3 ) + 7 ) )
			}else{
				local.b playsound ( "ramp_supression" + ( ( randomint 3 ) + 7 ) )
			}
			wait ( 0.10 + ( randomfloat 0.15 ) )
		}else{
			if(local.r < 5){
				local.a playsound ( "hedgehog_supression" + ( ( randomint 3 ) + 7 ) )
			}else{
				local.b playsound ( "ramp_supression" + ( ( randomint 3 ) + 7 ) )
			}
			wait ( 0.34 + ( randomfloat 0.22 ) )
		}
		local.el = ( level.time - local.t0 )
	}

	//the last take is still ringing when the loop drops out, and a channel whose emitter has been
	//freed keeps playing from its baked origin only until that entity slot is recycled. Decoded, the
	//longest take in either pool is Wpn_WhizBy20 at 0.74s (Wpn_ImpMetal06 0.71s, the rest
	//0.48..0.54s), so 0.8s covers all twenty - and by then the shell has landed anyway.
	wait 0.8
	if(local.a != NULL && local.a != NIL){ local.a remove }
	if(local.b != NULL && local.b != NIL){ local.b remove }
	if(local.c != NULL && local.c != NIL){ local.c remove }
	println("^~^~^ RAMPHULL done")
}end

//Seats the three emitters on the boat. Offsets are explained in coop_rampHullFire's header.
//=========================================================================
coop_rampHullPlace local.a local.b local.c:{
//=========================================================================
	if($higgins1_playerspot == NULL || $higgins1_playerspot == NIL){ end }

	if(local.a != NULL && local.a != NIL){
		local.p = $higgins1_playerspot.origin
		local.p[0] = local.p[0] - 33
		local.p[1] = local.p[1] + 30
		local.p[2] = local.p[2] + 66
		local.a.origin = local.p
	}
	if(local.b != NULL && local.b != NIL){
		local.p = $higgins1_playerspot.origin
		local.p[0] = local.p[0] + 97
		local.p[1] = local.p[1] + 38
		local.p[2] = local.p[2] + 66
		local.b.origin = local.p
	}
	if(local.c != NULL && local.c != NIL){
		local.p = $higgins1_playerspot.origin
		local.p[0] = local.p[0] + 32
		local.p[1] = local.p[1] + 150
		local.p[2] = local.p[2] + 40
		local.c.origin = local.p
	}
}end

//=========================================================================
//[user 2026-09-03] ONE SHELL THAT MISSES, BEFORE THE ONE THAT DOES NOT.
//
//The DREAD half of "chaotic ... and dramatic/cinematic" needs something aimed at the player before it
//lands on him. Today the only arty_leadin in this beat belongs to the shell that kills him. And the
//run-in barrage has just stopped - m3l1a.scr:2490 sets level.coop_runInShelling 0 on the line
//immediately before it threads higgins1_opening_sequence - so the sea goes quiet at the exact moment
//the ramp starts down. This walks one in short and to port: whistle at T+0.90, a real water column at
//T+1.90, a small jolt. The killing whistle follows 0.70s later.
//
//DELIBERATELY NO RING AND NO SHELLSHOCK. coop_tinnitus_triggerBlast's muffle branch stuffs s_volume,
//which bug-2354 established is squared into the OpenAL listener gain AND is half of
//S_GetBaseVolume(), so it bakes the music takeover's gain seconds later - the defect that made the
//score play at a third of intended for a minute. And the ring is the killing shell's signature;
//firing it early spends the loudest card in the beat on the round that misses.
//
//THE FX PLAYS ITS OWN SOUND. models/animate/fx_mortar_water.tik carries `enter sound arty_exp_water`
//in the client half of its start animation, so there is NO playsound for the impact - adding one
//would strike it twice. Same reason coop_runInShelling (:1735) has none. The height is 0 - 496
//ABSOLUTE, not a playerspot offset: that is the map author's own water-impact height and what both
//shipped water-shell threads on this map use (:1783, :1852). Deriving it from the playerspot put the
//column 16 units too low.
//
//NO LENS SPLASH, although coop_lensSplashAt is right there and the run-in near miss uses it:
//coop_rampCinematic starts 0.1s after this lands and immediately runs coop_rampGore, whose lens blood
//is the shot the user actually asked for. A water drench over it would fight it.
//
//WHY THIS IS NOT A REVERB OR OCCLUSION CHANGE ("the world opens up when the ramp drops"). Neither is
//reachable from script in this build. REVERB: cgi.S_SetReverb is a CGAME entry point
//(cg_public.h:265); Player::SetReverb(Event*) exists (player.cpp:9302) but is bound to no Event, so
//no script command reaches it, and CG_UpdateEnvReverb (cg_view.c:1564) picks by an UP-trace - open
//sky inside the boat and on the beach both give eax_generic level 0. OCCLUSION:
//S_OPENAL_UpdateOcclusion (snd_openal_new.cpp:2763) traces CM_BoxTrace(..., 0, CONTENTS_SOLID, ...) -
//model handle 0, the WORLD model only - and the ramp is a script_object, invisible to it; the one
//global knob s_occlusionStrength is CVAR_ARCHIVE (:1033), the bug-2298 latch. A real muffle would be
//a cgame change (a flags-0 coop_occFloor raising al_occ_tgt[i]) - out of scope for a script batch.
//
//level.coop_rampNearMissOn 0 removes it.
//=========================================================================
coop_rampNearMiss:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampNearMissOn == NIL){ level.coop_rampNearMissOn = 1 }
	if(!level.coop_rampNearMissOn){ end }
	if(level.coop_rampNearMissDone == 1){ end }
	level.coop_rampNearMissDone = 1

	//--- the whistle, up and over the port bow, so it arrives from somewhere
	wait 0.90
	if($higgins1_playerspot == NULL || $higgins1_playerspot == NIL){ end }
	local.w = spawn script_origin
	if(local.w == NULL || local.w == NIL){
		println("^~^~^ RAMPNEAR abort - no entity for the whistle emitter")
		end
	}
	local.p = $higgins1_playerspot.origin
	local.p[0] = local.p[0] - 150
	local.p[1] = local.p[1] + 120
	local.p[2] = local.p[2] + 280
	local.w.origin = local.p
	local.w playsound arty_leadin
	thread coop_fxCleanup local.w 3
	println("^~^~^ RAMPNEAR whistle")

	//--- and it goes into the sea off the port bow, forward enough to be IN FRAME: the camera sits at
	//    the playerspot looking up +Y, so 230 to port and 300 forward is about 37 degrees off axis,
	//    where 265 port / 110 forward would have been 67 and mostly out of shot. Hull walls are at
	//    about x 319 and x 449 and the mouth ends at y -7266, so the column is clear in both axes.
	//    1.00s after the whistle - the same gap retail gives its own killing shell (arty_leadin
	//    T+2.60, hit T+3.60) against an Exp_LeadIn take that decodes at 0.87s.
	wait 1.00
	if($higgins1_playerspot == NULL || $higgins1_playerspot == NIL){ end }
	local.q = $higgins1_playerspot.origin
	local.q[0] = local.q[0] - 230
	local.q[1] = local.q[1] + 300
	local.q[2] = 0 - 496

	local.fx = spawn "models/animate/fx_mortar_water.tik"
	if(local.fx != NULL && local.fx != NIL){
		local.fx.origin = local.q
		local.fx notsolid
		local.fx anim start
		//coop_runInShelling frees its own columns after 3s, but the arty_exp_water the tik plays for
		//itself is Exp_Water_01.wav, decoded at 4.21s - so 5, to outlive the sound rather than free
		//the emitter under it.
		thread coop_fxCleanup local.fx 5
	}
	thread coop_mod/main.scr::earthquake_radius local.q 0.9 0.85 1600
	println("^~^~^ RAMPNEAR splash")
}end

//=========================================================================
//[user 2026-09-01, bug-2345] MEN GOING DOWN IN THE WATER, SEEN FROM UNDER IT.
//
//The user's original ask for this beat asked, as a bonus, to "show people getting killed/drowning in
//the camera view looking toward shore". It was the one item of that batch that never got built, and
//the rewritten sequence is what finally makes it possible: the camera now spends TWELVE SECONDS on
//the seabed at pitch -6..-31 - looking up and forward, toward the shore - instead of tumbling
//through in a second and a half. There is now something to look at, and time to look at it.
//
//THE WATER HERE IS ONLY 56 UNITS DEEP. Surface -520, sand -576 (measured; the sand is flat at -576
//from y -2816 to -1792 and the surface is flat at -520 seaward of y -2160, and the landing point is
//at y -2655, inside both). A man is taller than the water is deep, so nobody floats suspended in
//mid-column here - that would be a lake, not a tidal flat. What actually happens, and what this
//builds, is two readable states:
//    at the surface, face down     - silhouetted against the light, which is the shot
//    on the sand, crumpled         - at the camera's own eye level
//and the transition between them, which is the part the user actually asked for: a man who is alive
//at the surface one moment, takes a round, and settles onto the bottom trailing blood.
//
//IN FRONT OF THE CAMERA. Everything is placed in +Y - between the camera and the shore - because the
//pose holds yaw 83..101 and never turns round. A body behind the camera is an entity nobody sees.
//
//COSTS NOTHING WHEN IT ENDS. Every entity here is removed on the way out, and the whole thread dies
//with level.coop_underDeadOn at the surface break, so none of it survives into play.
//=========================================================================
coop_underwaterDead local.wx local.wy local.pace:{
//=========================================================================
	if(level.coop_underDeadOn != 1){ end }
	//[2026-09-03] THE PACE COMES IN NOW. Every lifetime and every cadence below used to be a bare
	//constant sized against a 17.95s beat; coop_rampUnderwater's rewrite runs 21.9s to the handoff
	//at pace 1 and 25.7s at the 1.2 ceiling, so unscaled constants pop the corpses and the blood
	//out of frame BEFORE the break. A missing argument reads NIL, so default it rather than doing
	//arithmetic on a type none.
	if(local.pace == NIL || local.pace <= 0){ local.pace = 1 }

	//AND THE SWIM CORRIDOR IS KEPT CLEAR. coop_rampUnderwater now walks the camera from (sx,sy) out
	//to (sx-48, sy-106) and back, so a body that lands on that track is not parallax, it is a
	//texture wall across the near plane. The corridor is read from the SPAWN point, not from the
	//field centre this label is called with - the caller deliberately passes a y 190 units seaward
	//so the field straddles the corridor, and straddling is exactly what makes the keep-out needed.
	local.sx = local.wx
	local.sy = local.wy
	local.sp = level.flags["coop_spawn1origin"]
	if(local.sp != NIL){ local.sx = local.sp[0]; local.sy = local.sp[1] }

	local.b = 0
	local.b++; local.bod[local.b] = "models/static/body_us01.tik"
	local.b++; local.bod[local.b] = "models/static/body_us02.tik"
	local.b++; local.bod[local.b] = "models/static/body_us03.tik"
	local.b++; local.bod[local.b] = "models/static/body_us04.tik"
	local.b++; local.bod[local.b] = "models/static/body_us05.tik"
	local.b++; local.bod[local.b] = "models/static/body_us06.tik"
	local.bodN = local.b

	//-----------------------------------------------------------------
	//THE DEAD ALREADY THERE - four at the surface, three on the sand.
	//-----------------------------------------------------------------
	local.made = 0
	local.i = 0
	while(local.i < 7){
		local.p = (0 0 0)
		local.p[0] = local.wx + ( 0 - 330 ) + ( randomint 660 )
		local.p[1] = local.wy + 70 + ( randomint 430 )		//+Y: between the camera and the shore
		//[user 2026-09-02] "the bodies during the cinematic scene that are in the water need to
		//actually be laying dead at teh bottom." The four at the surface are gone; they all lie on
		//the sand now. And FLAT - retail lays its own corpses at angles (3 180 0), where my +-30 pitch
		//and +-40 roll stood them on edge and half-buried them, which is what read as mangled.
		local.p[2] = 0 - 574

		//push, do not re-roll: a re-roll can land in the box again. 95 units clears the widest body
		//model with room to spare and still leaves the corpse well inside the drawn seabed.
		if(local.p[0] > ( local.sx - 95 ) && local.p[0] < ( local.sx + 45 ) && local.p[1] > ( local.sy - 150 ) && local.p[1] < ( local.sy + 45 )){
			if(local.p[0] < local.sx){ local.p[0] = local.p[0] - 95 }else{ local.p[0] = local.p[0] + 95 }
		}

		local.d = spawn script_model
		if(local.d != NULL && local.d != NIL){			//entity-pool guard
			local.d model local.bod[( randomint local.bodN ) + 1]
			local.d.origin = local.p
			local.ry = randomint 360
			local.rp = randomint 4
			local.d.angles = ( local.rp local.ry 0 )
			local.d droptofloor 120
			local.d notsolid
			thread coop_fxCleanup local.d ( 26 * local.pace )
			local.made++

			//[bug-2359] and blood standing in the water above him. The user asked for "a mix of blood
			//in the water when we go down" - that is the whole twelve-second hold, not only the four
			//scripted kills, so every body on the sand carries its own cloud. Hung 30-40 units up so
			//it sits in the column at the camera's eye level rather than on the sand.
			local.bc = spawn "models/fx/coop_bloodcloud.tik"
			if(local.bc != NULL && local.bc != NIL){
				local.bq = local.p
				local.bq[2] = ( 0 - 552 ) + ( randomint 8 )
				local.bc.origin = local.bq
				local.bc notsolid
				local.bc anim start
				thread coop_fxCleanup local.bc ( 25 * local.pace )
			}
		}
		local.i++
	}

	//--- and a few standing clouds between the camera and the shore, with no body attached: blood
	//from men the current has already carried away.
	local.i = 0
	while(local.i < 4){
		local.dp = (0 0 0)
		local.dp[0] = local.wx + ( 0 - 300 ) + ( randomint 600 )
		local.dp[1] = local.wy + 90 + ( randomint 380 )
		local.dp[2] = ( 0 - 552 ) + ( randomint 10 )
		local.fc = spawn "models/fx/coop_bloodcloud.tik"
		if(local.fc != NULL && local.fc != NIL){
			local.fc.origin = local.dp
			local.fc notsolid
			local.fc anim start
			thread coop_fxCleanup local.fc ( 25 * local.pace )
		}
		local.i++
	}
	println("^~^~^ UNDERDEAD placed=" + local.made)

	//-----------------------------------------------------------------
	//AND THE ONES WHO ARE STILL ALIVE WHEN THE HOLD STARTS.
	//-----------------------------------------------------------------
	//[2026-09-03] SIX, NOT FOUR, AND PACE-SCALED. At the old 4 x (2.2 + rand 2.4) every kill was
	//over by about 13s - i.e. the 10.3s swim that is now the centrepiece of the beat had nobody
	//dying in it for its last seven seconds. Six kills at a 2.6 + rand 1.8 cadence put the expected
	//kill times at 2.4 / 5.9 / 9.4 / 12.9 / 16.4 / 19.9s against a swim that runs 9.6 -> 20.1s, so
	//three or four of them land inside it. The loop still exits the instant level.coop_underDeadOn
	//clears at the break, so a late draw costs nothing.
	wait ( ( 1.8 + ( randomfloat 1.2 ) ) * local.pace )
	local.k = 0
	while(level.coop_underDeadOn == 1 && local.k < 6){
		local.x = local.wx + ( 0 - 260 ) + ( randomint 520 )
		local.y = local.wy + 90 + ( randomint 380 )
		thread coop_underwaterKill local.x local.y local.bod[( randomint local.bodN ) + 1]
		local.k++
		wait ( ( 2.6 + ( randomfloat 1.8 ) ) * local.pace )
	}
}end


//One man, hit at the surface, going down. The round arrives first, then the blood, then he sinks -
//in that order, because that is the order it reads in.
//=========================================================================
coop_underwaterKill local.x local.y local.mdl:{
//=========================================================================
	if(level.coop_underDeadOn != 1){ end }

	//--- the round comes through the surface above him
	local.hit = (0 0 0)
	local.hit[0] = local.x
	local.hit[1] = local.y
	local.hit[2] = 0 - 520
	local.e = spawn script_model model "models/fx/bh_water_hard.tik"
	if(local.e != NULL && local.e != NIL){
		local.e.origin = local.hit
		local.e notsolid
		thread coop_fxCleanup local.e 1.6
	}

	//--- and he is there, at the surface, for the moment it takes to register
	local.pos = (0 0 0)
	local.pos[0] = local.x
	local.pos[1] = local.y
	local.pos[2] = 0 - 528

	local.m = spawn script_model
	if(local.m == NULL || local.m == NIL){ end }		//entity-pool guard
	local.m model local.mdl
	local.m.origin = local.pos
	local.m notsolid
	local.my = randomint 360
	local.m.angles = ( 0 local.my 0 )

	//--- blood into the water where the round went in.
	//
	//[user 2026-09-02, bug-2359] NOT coop_blooddrip, AND NOT ABOVE THE SURFACE. Two defects in what
	//this used to be. coop_blooddrip's particles carry `accel 0 0 -800` with collision + bouncedecal,
	//so they fell through the -520 surface and decalled the -576 sand inside half a second - a red
	//flicker, then nothing. And it spawned at local.pos + (0 0 14) = z -514, which is SIX UNITS ABOVE
	//the water: coop_bloodcloud is `wateronly`, so placed there every particle would be culled on its
	//first tick and the effect would be silently invisible. It goes DOWN from the body now, not up.
	local.bl = spawn "models/fx/coop_bloodcloud.tik"
	if(local.bl != NULL && local.bl != NIL){		//entity-pool guard
		//[bug-2363] well under the surface. -528-6 was only 14 units down and the emitter's own
		//offset reached straight back through it.
		local.bp = local.pos
		local.bp[2] = local.bp[2] - 26
		local.bl.origin = local.bp
		local.bl notsolid
		local.bl anim start
		thread coop_fxCleanup local.bl 11
	}

	//two chunks rather than five, and both BELOW the waterline - the old spread of +22/-6 around the
	//body put two in five of them in the air.
	local.g = 0
	while(local.g < 2){
		local.ch = spawn script_model model "models/fx/coop_gorechunk.tik"
		if(local.ch != NULL && local.ch != NIL){
			local.cp = local.pos
			local.cp[0] = local.cp[0] + ( ( randomint 26 ) - 13 )
			local.cp[1] = local.cp[1] + ( ( randomint 26 ) - 13 )
			local.cp[2] = local.cp[2] - ( randomint 18 )
			local.ch.origin = local.cp
			local.ch notsolid
			thread coop_fxCleanup local.ch 14
		}
		local.g++
	}

	wait 0.35

	//--- and down. 46 units to the sand at -574, over 2.4s, ease-OUT so he slows into it the way a
	//body in water does rather than dropping like a stone. He turns over on the way.
	local.t0 = level.time
	local.p0 = ( 0 - 528 )
	while(1){
		if(local.m == NULL || local.m == NIL){ end }
		local.f = ( level.time - local.t0 ) / 2.40
		if(local.f > 1){ local.f = 1 }
		local.v = 1 - local.f
		local.u = 1 - ( local.v * local.v * local.v )
		local.np = (0 0 0)
		local.np[0] = local.x
		local.np[1] = local.y
		local.np[2] = local.p0 - ( 46 * local.u )
		local.m.origin = local.np
		//he turns over on the way down and comes to rest FLAT on the sand, not on his edge
		local.rp = 4 * local.u
		local.ry = local.my + ( 40 * local.u )
		local.rr = ( 18 * local.u ) - ( 18 * local.u * local.u )
		local.m.angles = ( local.rp local.ry local.rr )
		if(local.f >= 1){ break }
		waitframe
	}

	//he stays where he came to rest until the sequence ends
	thread coop_fxCleanup local.m 16
}end

//Throw blood onto every living player's camera. Raise-only on the client, so the second man opened
//up next to you cannot shorten the first one's mark.
//=========================================================================
coop_rampLensBlood local.amt:{
//=========================================================================
	if(local.amt == NIL){ local.amt = 0.6 }
	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL){
			if(local.pl.health > 0 && local.pl.dmteam != "spectator"){
				local.pl stufftext ( "coop_lensBlood " + local.amt )
			}
		}
		local.i++
	}
}end

//=========================================================================
//[user 2026-09-02, bug-2361] THE HIGGINS DIES BEHIND YOU.
//
//"is it possible to also make our higgins boat destroyed after we get thrown out of it?" and then
//"Depending on how far we are from it, I'd love for it to slowly sink beside us and keel over while
//on fire."
//
//IT IS NOT BAKED IN. $higgins1 is not the boat - it is an invisible `script_origin` at (384 -7808
//-504) that the whole rig is bound to, and ScriptOrigin derives ScriptSlave derives Mover, so it
//takes the entire mover vocabulary. The visible hull is $higgins1_model, already notsolid, bound to
//it. Driving the pivot moves boat, ramp, spray emitters and clips together - which is exactly what
//retail does to it during the run-in (m3l1a.scr:2450-2457).
//
//THE AXES ARE ROTATED 90 DEGREES FROM THE HULL. $higgins1 has no angle key, so its forward is +X;
//the hull model carries `angle 90`, so the bow faces +Y. On the PIVOT therefore:
//    rotatex* = the BOAT'S ROLL   <- the keel-over
//    rotatez* = the BOAT'S PITCH  <- bow trim
//Four retail sites agree: the wave rock is rotatex (m3l1a.scr:740-742), the run-in rock is rotatex
//(:2450-2457), the grounding bow-lift is rotatezup (:2497) and higgins2's sink is rotatezup +
//movedown (:3230). The SIGN is inferred rather than read - level.coop_higginsSinkPort flips it in
//one variable if she heels the wrong way.
//
//TRANSLATION AND ROTATION RUN TOGETHER. Every move*/rotate* accumulates into the mover's pending
//NewPos/NewAngles and one `waitmove` fires a single LinearInterpolate carrying both, so a leg heels,
//trims and settles in one blended motion rather than three sequential ones.
//
//SHE CANNOT GO UNDER, AND SHOULD NOT. There are 56 units of water here (surface -520, sand -576) and
//nothing drawn below the waterline seaward of y -2816 - drop her far and you expose the void. So the
//drop is 26 units and the ROLL is the show: 38 degrees puts the low gunwale under and the bilge out,
//which is what actually happened to the LCVPs and is a better silhouette than a boat sliding down.
//
//THE 15-SECOND GATE IS LOAD-BEARING. $boatCamera is bound inside this rig through
//$higgins1_playerspot and is never unbound, so moving her before the handoff deletes those cameras
//would drag every player's view. The disembark pusher is still solid and moving until T+3, rangers 6
//to 10 are still walking the deck until ~T+12, and mg42AttackBeach re-aims the centre guns off
//$higgins1_clip at T+2..6. Fifteen seconds clears all of it.
//
//NOTHING IS EVER REMOVED. $higgins1_clip is a live `turnto` target at m3l1a.scr:4866 and $higgins1
//itself at :5480, and a NULL aim_target makes TurretGun::Think early-out. She is scenery for the
//rest of the map, so she stays an entity - only her push-brushes go notsolid.
//=========================================================================
coop_higginsSink:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_higginsSinkDone == 1){ end }
	level.coop_higginsSinkDone = 1
	if(level.coop_higginsSinkOn == NIL){ level.coop_higginsSinkOn = 1 }
	if(!level.coop_higginsSinkOn){ end }

	//tunables are level vars, NEVER getcvar - a script getcvar creates the cvar EMPTY and
	//permanently defeats the engine's own default (bug-1669).
	if(level.coop_higginsSinkDelay == NIL){ level.coop_higginsSinkDelay = 15 }
	if(level.coop_higginsSinkRoll  == NIL){ level.coop_higginsSinkRoll  = 38 }
	if(level.coop_higginsSinkPitch == NIL){ level.coop_higginsSinkPitch = 6 }
	if(level.coop_higginsSinkDrop  == NIL){ level.coop_higginsSinkDrop  = 26 }
	if(level.coop_higginsSinkPort  == NIL){ level.coop_higginsSinkPort  = 0 }

	if($higgins1 == NULL || $higgins1 == NIL){ end }
	if($higgins1_model == NULL || $higgins1_model == NIL){ end }

	wait level.coop_higginsSinkDelay
	if($higgins1 == NULL || $higgins1 == NIL){ end }

	//read the position at runtime - the fleet mover, the wave loop and the landing legs all
	//translate this rig, so where she ends up is not derivable from the .map
	local.pos = $higgins1_model.origin

	//--- "depending on how far we are from it". Sampled ONCE, and it drives the FX budget and the
	//pacing - not whether it happens. A player who runs inland still gets the smoke column on his
	//skyline, which is the half of this that reads at distance.
	local.pl = exec coop_mod/replace.scr::player_closestTo NIL local.pos
	local.d = 4000
	if(local.pl != NULL && local.pl != NIL){
		local.d = vector_length( local.pl.origin - local.pos )
	}
	local.band = 3
	if(local.d < 2500){ local.band = 2 }
	if(local.d < 900){ local.band = 1 }
	local.tm = 1.0
	if(local.band == 3){ local.tm = 0.85 }		//nobody is reading the detail - do not dawdle
	if(local.band == 1){ local.tm = 1.15 }		//he is standing next to her - let it breathe
	println("^~^~^ HIGGINSSINK band=" + local.band + " dist=" + local.d)

	waitthread coop_higginsSinkSafe
	waitthread coop_higginsSinkHit local.pos local.band
	thread coop_higginsSinkBurn local.pos local.band
	thread coop_higginsSinkWatchdog
	waitthread coop_higginsSinkMotion local.tm

	level.coop_higginsSinkLeg = 99
	println("^~^~^ HIGGINSSINK complete")
}end


//The three push-brushes. A moving SOLID_BSP brush blocks anything it cannot shove, and these ride
//the pivot - so they go notsolid BEFORE any motion. Nobody should be standing on a boat that is
//going over, so this costs no gameplay. They are never removed or unbound: see the header.
//=========================================================================
coop_higginsSinkSafe:{
//=========================================================================
	if($higgins1_clip != NULL && $higgins1_clip != NIL){ $higgins1_clip notsolid }
	if($higgins1_door_clip != NULL && $higgins1_door_clip != NIL){ $higgins1_door_clip notsolid }
	if($higgins1_clip_player != NULL && $higgins1_clip_player != NIL){ $higgins1_clip_player notsolid }
	//the coxswain is made solid + physics_on at m3l1a.scr:2546 and is never unglued, so he would
	//ride her down as a solid
	if($higgins1_coxswain != NULL && $higgins1_coxswain != NIL){ $higgins1_coxswain notsolid }
}end


//The shell that finishes her. Lifted from higgins2_blow (m3l1a.scr:3180-3253) but with the Sherman's
//mask-then-swap ordering, because retail swaps the model unmasked and you watch it pop.
//=========================================================================
coop_higginsSinkHit local.pos local.band:{
//=========================================================================
	//BOUND, so it rides her down - the same pattern m3l1a.scr:588 uses for $higgins2_mortar.
	//fx_mortar_higgins.tik is classname effectentity with NO radiusdamage (checked - this is the
	//bug-2244 rule), and its own server init supplies `angles 270 0 0`, so do not set angles here.
	local.mx = spawn "models/animate/fx_mortar_higgins.tik"
	if(local.mx != NULL && local.mx != NIL){		//entity-pool guard
		local.mx.origin = local.pos + (0 0 30)
		local.mx notsolid
		local.mx bind $higgins1
		local.mx anim start
		thread coop_fxCleanup local.mx 45		//its own smoke self-terminates at 30s
	}

	$higgins1 playsound higgins_explosion
	$higgins1 playsound higgins_blowup_guys

	//earthquake_radius, not jitter_large: the retail shake early-outs when $player.size > 1
	thread coop_mod/main.scr::earthquake_radius local.pos 1.4 1.6 2200

	//mask, THEN swap
	wait 0.25
	local.dz = spawn "models/animate/fx_mortar_dirt.tik"
	if(local.dz != NULL && local.dz != NIL){
		local.dz.origin = local.pos + (0 0 40)
		local.dz notsolid
		local.dz anim start
		thread coop_fxCleanup local.dz 8
	}
	wait 0.12
	if($higgins1_model != NULL && $higgins1_model != NIL){
		$higgins1_model model "vehicles/higgins_damage.tik"
	}

	//ONE fire loop, on the hull only - bug-2313 was five of these on this map exhausting the
	//channel pool. 400/4000 covers the whole band on its own.
	$higgins1 playsound coop_snd_fire_large
}end


//Four legs, each a single blended heel+trim+settle. Rising per-leg rate gives the acceleration one
//LinearInterpolate cannot. `time` persists until `speed` is called, so it is set per leg.
//=========================================================================
coop_higginsSinkMotion local.tm:{
//=========================================================================
	//[bug-2424] INTEGER DIVISION ZEROED THE ENTIRE SINK. 38 / 100 is int/int here and
	//evaluates to 0 (scriptvariable.cpp:1671-1679), so every leg issued rotatexup 0 /
	//rotatezup 0 / movedown 0 and the boat burned in place for 61 seconds while the mover
	//dutifully ran all four legs to completion. The log said so in plain sight the whole
	//time: "HIGGINSSINK legs t=12.650/14.950/17.250/16.100 roll=0/0/0/0" - the times are
	//floats because 11 * 1.15 promotes, the rolls are bare integer zeroes.
	//Multiply by a float rather than writing / 100.0: int * float promotes to float, it is
	//the same operation that already produces those leg times two lines below, and it stays
	//correct if anyone later sets one of the tunables to a float.
	local.R = level.coop_higginsSinkRoll  * 0.01
	local.P = level.coop_higginsSinkPitch * 0.01
	local.D = level.coop_higginsSinkDrop  * 0.01

	//[user 2026-09-02, bug-2377] "i dont think our higgins boat actually sunk." HIGGINSSINK printed,
	//so the thread ran and got as far as sampling the distance - which means the failure is in the
	//motion itself. Every leg passed an EXPRESSION straight to a command argument, `time ( 11 *
	//local.tm )`, and this language is not reliable about that: the file's own idiom everywhere else
	//is to compute into a local first and pass the local. Doing that here removes the one thing
	//between "the thread ran" and "the boat moved" that I had not made certain of.
	local.t1 = 11 * local.tm
	local.t2 = 13 * local.tm
	local.t3 = 15 * local.tm
	local.t4 = 14 * local.tm
	local.r1 = local.R * 12
	local.r2 = local.R * 26
	local.r3 = local.R * 40
	local.r4 = local.R * 22
	local.p1 = local.P * 50
	local.p2 = local.P * 30
	local.p3 = local.P * 15
	local.p4 = local.P * 5
	local.d1 = local.D * 24
	local.d2 = local.D * 26
	local.d3 = local.D * 30
	local.d4 = local.D * 20
	println("^~^~^ HIGGINSSINK legs t=" + local.t1 + "/" + local.t2 + "/" + local.t3 + "/" + local.t4 + " roll=" + local.r1 + "/" + local.r2 + "/" + local.r3 + "/" + local.r4)

	//leg 1 - she settles by the head
	level.coop_higginsSinkLeg = 1
	$higgins1 time local.t1
	waitthread coop_higginsSinkRoll local.r1
	$higgins1 rotatezup local.p1
	$higgins1 movedown local.d1
	$higgins1 waitmove

	//leg 2 - the list takes hold
	level.coop_higginsSinkLeg = 2
	$higgins1 time local.t2
	waitthread coop_higginsSinkRoll local.r2
	$higgins1 rotatezup local.p2
	$higgins1 rotateydown 2
	$higgins1 movedown local.d2
	$higgins1 waitmove

	//leg 3 - over she goes
	level.coop_higginsSinkLeg = 3
	$higgins1 time local.t3
	waitthread coop_higginsSinkRoll local.r3
	$higgins1 rotatezup local.p3
	$higgins1 rotateyup 1
	$higgins1 movedown local.d3
	$higgins1 waitmove

	//leg 4 - grounded, still settling
	level.coop_higginsSinkLeg = 4
	$higgins1 time local.t4
	waitthread coop_higginsSinkRoll local.r4
	$higgins1 rotatezup local.p4
	$higgins1 movedown local.d4
	$higgins1 waitmove
}end


//One place decides which gunwale goes under, so flipping her is a one-variable change.
//=========================================================================
coop_higginsSinkRoll local.deg:{
//=========================================================================
	if($higgins1 == NULL || $higgins1 == NIL){ end }
	if(level.coop_higginsSinkPort){
		$higgins1 rotatexdown local.deg
	}else{
		$higgins1 rotatexup local.deg
	}
}end


//A blocked push is the class of thing that has softlocked a set piece on this map before. This only
//RELEASES the mover - it never removes anything, so the worst case is a boat left part-heeled, which
//is still a perfectly good wreck.
//=========================================================================
coop_higginsSinkWatchdog:{
//=========================================================================
	local.last = 0
	local.t = 0
	while(local.t < 140){
		if(level.coop_higginsSinkLeg == 99){ end }
		if(level.coop_higginsSinkLeg == local.last){
			local.t = local.t + 2
			if(local.t > 26){
				if($higgins1 != NULL && $higgins1 != NIL){ $higgins1 stop }
				println("^~^~^ HIGGINSSINK watchdog released leg " + local.last)
				end
			}
		}else{
			local.last = level.coop_higginsSinkLeg
			local.t = 0
		}
		wait 2
	}
}end


//Fire that rides her over, and a smoke column that does not.
//=========================================================================
coop_higginsSinkBurn local.pos local.band:{
//=========================================================================
	//LAYER 1 - flame, BOUND to the pivot so it heels with the hull. A flame reads fine at 38
	//degrees. Count scales with distance; the user has asked before to "chill out on some of the
	//fire" on this beach, so far away gets one.
	local.n = 1
	if(local.band == 1){ local.n = 3 }
	if(local.band == 2){ local.n = 2 }
	local.k = 0
	while(local.k < local.n){
		local.f = spawn "models/emitters/tehao_fire.tik"
		if(local.f != NULL && local.f != NIL){
			local.fp = (0 0 0)
			local.fp[0] = local.pos[0] + ( ( randomint 90 ) - 45 )
			local.fp[1] = local.pos[1] + ( ( randomint 220 ) - 110 )
			local.fp[2] = local.pos[2] + 20 + ( randomint 40 )
			local.f.origin = local.fp
			local.f notsolid
			local.f bind $higgins1
			local.f anim start
			//NO loopsound - one coop_snd_fire_large already plays on the hull (bug-2313)
			thread coop_fxCleanup local.f 150
		}
		local.k++
	}
	if(local.band == 1){
		local.fm = spawn "models/emitters/fireandsmoke.tik"
		if(local.fm != NULL && local.fm != NIL){
			local.fm.origin = local.pos + (0 0 34)
			local.fm notsolid
			local.fm bind $higgins1
			local.fm anim start
			thread coop_fxCleanup local.fm 150
		}
	}

	//LAYER 2 - THE COLUMN, DELIBERATELY UNBOUND. A flame can lie over at 38 degrees; a smoke column
	//cannot - it has to keep going up. She only translates 26 units, so pinning the column to the
	//original waterline costs nothing and is what keeps her on the skyline for the rest of the map.
	local.cp = (0 0 0)
	local.cp[0] = local.pos[0]
	local.cp[1] = local.pos[1]
	local.cp[2] = 0 - 500
	local.sm = spawn "models/emitters/tehao_firesmoke_superlong.tik"
	if(local.sm != NULL && local.sm != NIL){
		local.sm.origin = local.cp + (0 0 50)
		local.sm notsolid
		local.sm anim start
		thread coop_fxCleanup local.sm 300
	}
	local.s2 = spawn "models/emitters/linger_smoke.tik"
	if(local.s2 != NULL && local.s2 != NIL){
		local.s2.origin = local.cp + (0 0 70)
		local.s2 notsolid
		local.s2 scale 2.4
		local.s2 anim start
		thread coop_fxCleanup local.s2 300
	}

	//LAYER 3 - the water taking her. Near and mid only.
	if(local.band == 3){ end }
	local.sp = spawn "models/animate/fx_water_spray.tik"
	if(local.sp != NULL && local.sp != NIL){
		local.sp.origin = local.cp + (0 0 8)
		local.sp notsolid
		local.sp anim start			//REQUIRED - its emitter is startoff
		thread coop_fxCleanup local.sp 60
	}
	local.k = 0
	while(local.k < 22){
		wait 2.4
		if($higgins1 == NULL || $higgins1 == NIL){ end }
		//[bug-2366] `spawn script_model model "..."`, NOT `spawn "..."`. water_trail_bubble.tik
		//declares no classname (its emitter lives in init{client{}} with nothing else), so the bare
		//form fails with "You must specify an explicit classname for misc object tik models" - 22 of
		//them in the user's console, one per iteration of this loop. coop_waterBullets already
		//spawns this exact model the correct way.
		local.b = spawn script_model model "models/fx/water_trail_bubble.tik"
		if(local.b != NULL && local.b != NIL){
			local.bp = (0 0 0)
			local.bp[0] = local.cp[0] + ( ( randomint 160 ) - 80 )
			local.bp[1] = local.cp[1] + ( ( randomint 300 ) - 150 )
			local.bp[2] = 0 - 522
			local.b.origin = local.bp
			local.b notsolid
			//NO `anim start` - water_trail_bubble has no start anim; its emitter is client-init
			thread coop_fxCleanup local.b 3
		}
		local.k++
	}
}end

//=========================================================================
//[user 2026-09-02, bug-2379] THE LANDING DOES NOT STOP WHEN YOURS DOES.
//
//"Can we have more huggins boats come in and drop off troops fully animated etc after we've already
//gotten thru the cinematic sequence?"
//
//coop_extraBoats already puts nine wrecks ashore and six more out at sea, but every one of those is
//placed ONCE at map load and rides in on $higgins_fleet - the mover that carries the opening wave.
//By the time the player is on the sand that mover has finished, so nothing new ever arrives and the
//beach behind you is a still photograph. This is the second wave, and the third, and the fourth.
//
//IT REUSES coop_boatLand VERBATIM for the ramp and the unload - the hinge-and-rotate that drops the
//door, the doomed-boat shell, coop_disembarkSquad putting out real actors, and `anim removeguys` to
//empty the hull's baked-in crew so the same men are not aboard and ashore at once. The only thing
//this adds is the run-in, because coop_boatLand never had one: it inherited its motion from the
//fleet bind, and that is exactly the part that is no longer available.
//
//THE RUN-IN IS ORIGIN-STEPPED. moveto silently no-ops on a script_model - a standing trap in this
//file - so the hull is walked shoreward a step per frame, from y -3400 out at sea to about y -2450
//where the opening wave grounded. 14 seconds, which is slow enough to read as a boat and short
//enough that the player is not watching an empty sea.
//
//BUDGET. Six boats over the mission, one every 45-75 seconds, and coop_disembarkCap is raised by
//eight per boat rather than lifted wholesale - so the actor count grows only as boats actually
//arrive, and a player who runs the map fast never pays for waves he outran. Hulls are removed 90
//seconds after they unload; the men are left, because men on the beach are the point.
//=========================================================================
coop_lateBoats:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_lateBoatsOn == NIL){ level.coop_lateBoatsOn = 1 }
	if(!level.coop_lateBoatsOn){ end }
	if(level.coop_lateBoatsDone == 1){ end }
	level.coop_lateBoatsDone = 1

	//after the handoff - this is explicitly the wave AFTER the cinematic
	local.t = 0
	while(level.coop_rampDone != 1 && local.t < 240){
		wait 1
		local.t = local.t + 1
	}
	wait ( 20 + ( randomfloat 15 ) )

	//lanes across the beach, well clear of the player's own landing point
	local.n = 0
	local.n++; local.lx[local.n] = 0 - 2350
	local.n++; local.lx[local.n] = 1850
	local.n++; local.lx[local.n] = 0 - 1450
	local.n++; local.lx[local.n] = 2700
	local.n++; local.lx[local.n] = 0 - 3150
	local.n++; local.lx[local.n] = 980

	local.i = 1
	while(local.i <= local.n && level.coop_lateBoatsOn){
		waitthread coop_lateBoatRun local.lx[local.i] local.i
		wait ( 45 + ( randomfloat 30 ) )
		local.i++
	}
	println("^~^~^ LATEBOATS waves=" + ( local.i - 1 ))
}end


//One boat: out of the haze, up the lane, ramp down, men out.
//=========================================================================
coop_lateBoatRun local.lane local.slot:{
//=========================================================================
	local.p = (0 0 0)
	local.p[0] = local.lane + ( ( randomint 260 ) - 130 )
	local.p[1] = 0 - 3400
	local.p[2] = 0 - 544

	local.hull = spawn script_model model "models/vehicles/higginslite_soldiers.tik"
	if(local.hull == NULL || local.hull == NIL){ end }		//entity-pool guard
	local.hull.origin = local.p
	local.hull.angles = (0 90 0)
	local.hull notsolid
	local.hull anim idle					//troops and coxswain aboard

	local.door = spawn script_model model "models/vehicles/higginsdoor.tik"
	if(local.door != NULL && local.door != NIL){
		local.door.origin = local.p
		local.door.angles = (0 90 0)
		local.door notsolid
	}

	//pay for the men this boat is about to land, rather than lifting the cap wholesale
	if(level.coop_disembarkCap != NIL){ level.coop_disembarkCap = level.coop_disembarkCap + 8 }

	//--- THE RUN-IN. Origin-stepped: moveto no-ops on a script_model.
	local.y0 = 0 - 3400
	local.y1 = 0 - 2450
	local.t0 = level.time
	while(1){
		if(local.hull == NULL || local.hull == NIL){ end }
		local.f = ( level.time - local.t0 ) / 14.0
		if(local.f > 1){ local.f = 1 }
		//ease out at the end so she settles onto the sand instead of stopping dead
		local.v = 1 - local.f
		local.u = 1 - ( local.v * local.v )
		local.np = (0 0 0)
		local.np[0] = local.p[0]
		local.np[1] = local.y0 + ( ( local.y1 - local.y0 ) * local.u )
		local.np[2] = ( 0 - 544 ) + ( 3 * ( randomint 2 ) )		//a little chop
		local.hull.origin = local.np
		if(local.door != NULL && local.door != NIL){ local.door.origin = local.np }
		if(local.f >= 1){ break }
		waitframe
	}

	//one boat in three takes a shell on the way in
	local.doomed = 0
	if((randomint 3) == 0){ local.doomed = 1 }

	//and from here it is the map's own landing, unchanged
	waitthread coop_boatLand local.hull local.door local.doomed 0

	thread coop_fxCleanup local.hull 90
	if(local.door != NULL && local.door != NIL){ thread coop_fxCleanup local.door 90 }
}end

//Put the map's own hidden MG42 crews back on their guns as inert scenery.
//=========================================================================
coop_showGunners:{
//=========================================================================
	if($mg42_bunker_gunner != NULL && $mg42_bunker_gunner != NIL){ $mg42_bunker_gunner show }
	if($mg42_middle1_gunner != NULL && $mg42_middle1_gunner != NIL){ $mg42_middle1_gunner show }
	if($mg42_middle2_gunner != NULL && $mg42_middle2_gunner != NIL){ $mg42_middle2_gunner show }
	if($mg42_leftbunker1_gunner != NULL && $mg42_leftbunker1_gunner != NIL){ $mg42_leftbunker1_gunner show }
	if($mg42_leftbunker2_gunner != NULL && $mg42_leftbunker2_gunner != NIL){ $mg42_leftbunker2_gunner show }
	if($mg42_rightbunker1_gunner != NULL && $mg42_rightbunker1_gunner != NIL){ $mg42_rightbunker1_gunner show }
	//[2026-09-02, bug-2398] THE SEVENTH GUNNER. m3l1a.scr:459 hides $mg42_rightbunker2_gunner exactly
	//as it hides rightbunker1 on the line above it, but only six of the seven were listed here - so
	//that gun kept firing with visibly nobody on it. A guard applied to six members of a set of seven
	//is the shape this project keeps repeating; the set is the hide block at m3l1a.scr:440-462.
	if($mg42_rightbunker2_gunner != NULL && $mg42_rightbunker2_gunner != NIL){ $mg42_rightbunker2_gunner show }
	println("^~^~^ GUNNERS shown")
}end

//=========================================================================
coop_idleSweeper:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_sweepOn == NIL){ level.coop_sweepOn = 1 }
	if(!level.coop_sweepOn){ end }

	local.stale = 100		//[bug-2348] 45 -> 100: longer than any legitimate pose on this beach
	local.revived = 0
	local.sweepN = 0		//ASSIGN BEFORE ANY READ - `++` on an unset local throws, and a thrown
							//statement is silently skipped, which would make the census below vanish

	while(level.coop_sweepOn){
		wait 6
		if(level.coop_actN == NIL){ continue }
		local.pass = 0		//[bug-2348] at most two revivals per pass - never a churn engine again

		local.i = 1
		while(local.i <= level.coop_actN){
			local.a = level.coop_actList[local.i]
			if(local.a != NULL && local.a != NIL){
				//[user 2026-09-02, bug-2329] FLOATING BODIES, DEAD OR ALIVE. "floating body over the
				//barbed wire" - a corpse hanging in the sky well above the wire, and the hand-placed
				//body props are all at ground z, so something is putting an ACTOR up there at runtime.
				//Rather than hunt which of the charge/failsafe/ragdoll paths does it - the same
				//whack-a-mole that produced five separate standing fixes - this catches the symptom on
				//the sweep that is already walking every spawned actor. It runs on the DEAD too, since
				//a floating corpse is the thing being reported.
				//
				//120 units is deliberately generous: a man on a Higgins hull or up on the bluff is
				//legitimately high, and coop_nearGroundZ resolves against the nearest static so it
				//tracks those. Only something genuinely hanging in the air trips it.
				local.gz = waitthread coop_nearGroundZ local.a.origin[0] local.a.origin[1]
				if(local.gz == NIL && local.a.origin[1] < 2400){
					local.gz = waitthread coop_groundZ local.a.origin[1]
				}
				if(local.gz != NIL && local.a.origin[2] > ( local.gz + 120 )){
					println("^~^~^ FLOATFIX ent=" + local.a.entnum + " z=" + local.a.origin[2] + " want=" + local.gz)
					local.fp = local.a.origin
					local.fp[2] = local.gz + 8
					local.a.origin = local.fp
					local.a droptofloor
				}
				//[user 2026-09-02, bug-2348] THE SWEEPER BECAME THE BUG.
				//
				//"some of these guys seem like they are cycling th ru animations... pointing and aiming
				//and then going down into the injured stance... its random and oesnt make sense", and
				//"some of these guys carrying crates stop and start moving randomly". The user's console
				//shows IDLESWEEP revived=331 in ONE session. This was written as a rare rescue for men
				//stranded by a thread that ended; at 331 firings it is not rescuing anything, it is a
				//churn engine, and it is the direct cause of both reports.
				//
				//THE DEFECT IS THE LINE THAT SET coop_behaveOff = 0. That flag is how a job thread - the
				//crate haul, the bazooka loop, the firing line, the welders - CLAIMS an actor and says
				//"I own this man, leave him alone". The sweeper cleared it and restarted coop_beachBehave
				//on top of the running job, so a man carrying a crate was yanked into a rifle pose every
				//45 seconds. Two threads then drove the same actor, which is exactly the random
				//animation cycling described.
				//
				//THREE THINGS FIX IT:
				//  1. A man with coop_behaveOff == 1 is BUSY BY DEFINITION. Skip him, and stamp his
				//     heartbeat so he never accrues staleness while his job runs.
				//  2. A man who MOVED since the last pass is fine whatever his heartbeat says.
				//  3. Stale is 100s, not 45 - longer than any legitimate pose on this beach - and at
				//     most two men are revived per pass, so this can never again become a churn engine.
				if(isalive local.a){
					if(local.a.coop_behaveOff == 1){
						local.a.coop_hb = level.time			//job-owned: hands off
					}else{
						if(local.a.coop_hb == NIL){ local.a.coop_hb = level.time }

						//did he move? cheap manhattan distance, no sqrt needed for a threshold
						if(local.a.coop_swpX == NIL){
							local.a.coop_swpX = local.a.origin[0]
							local.a.coop_swpY = local.a.origin[1]
						}
						local.dx = local.a.origin[0] - local.a.coop_swpX
						local.dy = local.a.origin[1] - local.a.coop_swpY
						if(local.dx < 0){ local.dx = 0 - local.dx }
						if(local.dy < 0){ local.dy = 0 - local.dy }
						if(( local.dx + local.dy ) > 12){ local.a.coop_hb = level.time }
						local.a.coop_swpX = local.a.origin[0]
						local.a.coop_swpY = local.a.origin[1]

						if(( level.time - local.a.coop_hb ) > local.stale && local.pass < 2){
							local.a.coop_hb = level.time
							local.a thread coop_beachBehave
							local.pass++
							local.revived++
							if(( local.revived % 10 ) == 1){
								println("^~^~^ IDLESWEEP revived=" + local.revived + " (ent " + local.a.entnum + ")")
							}
						}
					}
				}
			}
			local.i++
		}

		//[user 2026-09-02] "83.4% of your allies are standing how do you want to fix this"
		//
		//WHICH ALLIES DOES THIS SYSTEM ACTUALLY OWN? Six fixes have been aimed at coop_beachBehave
		//and the standing ratio has not moved (81.7% this session against 83.4% the last). The
		//structural question nobody had asked is whether the men being COUNTED are the men being
		//MANAGED: coop_beachBehave is threaded from coop_vigSpawn, so it owns the coop-spawned
		//vignette cast - while the pose census in probe.scr counts every tm=american actor,
		//retail's own shingle rangers, medics, bangalore waves and reinforcement waves included.
		//If the standing men are mostly retail's, then every fix so far has been tuning a system
		//that never touched them, which would explain six null results exactly.
		//
		//This publishes the OWNED set so the census can be split offline against the entnums the
		//actor.snap probe already prints. One line per pass, no per-actor spam, and it changes no
		//behaviour - it only reports what this loop already walked. Emitted every 5th pass so a
		//long session does not accumulate hundreds of these.
		local.sweepN++
		if(( local.sweepN % 5 ) == 1){
			local.own = ""
			local.busy = 0
			local.j = 1
			while(local.j <= level.coop_actN){
				local.e = level.coop_actList[local.j]
				if(local.e != NULL && local.e != NIL){
					if(isalive local.e){
						local.own = local.own + local.e.entnum + " "
						if(local.e.coop_behaveOff == 1){ local.busy++ }
					}
				}
				local.j++
			}
			println("^~^~^ SWEEPOWN listed=" + level.coop_actN + " revivedThisPass=" + local.pass + " jobOwned=" + local.busy + " ids=" + local.own)
		}
	}
}end

//=========================================================================
coop_beachBehave:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	if(level.coop_behaveOn == NIL){ level.coop_behaveOn = 1 }

	//[user 2026-09-01, bug-2310] YIELD ONE FRAME BEFORE CLAIMING THE ACTOR. This single waitframe is
	//what stops the default behaviour stealing men who already have a job.
	//
	//"some of the crate carrying guys are now shooting instead of moving the crates, the crates are
	//stuck in their hands with their rifle."
	//
	//THE ORDERING. coop_vigSpawn threads this as its LAST act and then returns the actor; the caller's
	//very next line threads the real job. But `thread` runs the new thread immediately, up to its first
	//wait - so this function got there FIRST, picked a pose (one of twelve is prone_aim: a man firing a
	//rifle), and parked in a 10-22 second wait. The job thread then set coop_behaveOff on its own first
	//line, but this loop only tests that flag at the TOP of an iteration, so the flag sat there unread
	//for the whole dwell while the man knelt and fired with a crate still bound to tag_weapon_right.
	//
	//A waitframe here inverts the order for every caller at once: this thread yields before touching
	//the actor, the caller's job thread runs and sets the flag, and on the next frame the loop's own
	//guard ends this thread without a single pose ever being played. That is 37 coop_vigSpawn call
	//sites fixed in one line, which is the only reason to prefer it over passing a flag at each - I
	//tried that first and it only ever fixes the sites you remember to change.
	waitframe
	if(self == NULL || self == NIL){ end }
	if(self.coop_behaveOff == 1){ end }

	//[user 2026-09-01] WIDER. "There are more animations out there we could use like the injured
	//animations, etc. Some can be prone instead, more can advance up the beach and get killed."
	//
	//There are 752 non-combat animations reachable on this map. The ones worth having are the <wg>_pain_*
	//family - a complete wounded set with floor, knees and crawling states and transitions between them -
	//and <wg>_prone_aim, which is a man lying down and actually firing rather than lying down idling.
	//
	//WEAPON GROUP MATTERS AT THE ALIAS LEVEL. The same pose exists twice, once per group, and they are
	//NOT interchangeable to look at: unarmed_pain_flooridle has his hands empty, rifle_pain_flooridle has
	//them on the Garand. Picking the wrong one gives a man clutching a rifle that is not in his hands.
	//So the group is chosen from what he is actually carrying.
	//
	//AND THE TWO GROUPS DIFFER IN LOOPING, which decides how each is driven: unarmed_pain_flooridle and
	//_kneesidle LOOP (2.60s), while rifle_pain_flooridle and _kneesidle are ONE-SHOTS (2.70s) and have to
	//be re-triggered or the man stands back up. Measured from the SKC headers, not assumed.
	local.wg = "rifle"
	if(self.gun == "none" || self.gun == "" || self.gun == NIL || self.gun == NULL){ local.wg = "unarmed" }

	//one man in four is a casualty and stays one
	local.hurt = 0
	if((randomint 4) == 0){ local.hurt = 1 }

	local.n = 0
	while(isalive self && level.coop_behaveOn && local.n < 4000){
		if(self.coop_behaveOff == 1){ end }		//a real job took him
		self.coop_hb = level.time			//[bug-2326] I am alive and doing something - see coop_vigHold
		local.n++

		if(local.hurt == 1){
			//--- INJURED, AND HE STAYS DOWN. [user 2026-09-01, bug-2295]
			//
			//"other standing and injured but doesnt make sense for them to just be standing out in the
			//open injured" - and he was never meant to be. The animation was right, reachable, and
			//playing; the DWELL was wrong. rifle_pain_flooridle is a ONE-SHOT lasting 2.70s and this
			//code waited up to 6.80s on it, so a wounded man lay down for under three seconds and then
			//stood back up in the open for four more. Every screenshot of "a guy just standing there"
			//is one of these caught in its dead time. docs/tools/check_anim_dwell.py now measures every
			//anim/wait pair against the real SKC headers and fails the build, so it cannot come back.
			//
			//THE TWO GROUPS NEED DIFFERENT DRIVING, because they differ in the loop flag:
			//    unarmed_pain_flooridle / _kneesidle   LOOP 2.60s -> issue once, wait, it holds
			//    <armed>_pain_flooridle / _kneesidle   ONCE 2.70s -> re-issue at animdone, exact and
			//                                                       cannot pop part-way through a pose
			//Any wait long enough to be worth having is longer than these one-shots, so re-triggering
			//is the ONLY correct way to hold an armed man's pain pose.
			//[user 2026-09-02, bug-2321] AND HE MAKES A SOUND. "there is plenty of dialogue from Omaha
			//... lines like 'my guts have been torn out' and many others that we can have the actors
			//you've added say too." The Omaha-specific ones ship without audio (see coop_aivoice.scr),
			//so this draws on the 39 generic damage/death lines that DO ship and that nothing else in
			//the game plays.
			//
			//ONE LINE PER MAN PER 18-40s, and a level-wide slot so fifty casualties cannot chorus. That
			//gate is the entire difference between atmosphere and the "He's hit" problem: the pool being
			//deep is necessary but not sufficient - the RATE is what made the old one obnoxious.
			if(level.coop_woundNext == NIL){ level.coop_woundNext = 0 }
			if(self.coop_woundNext == NIL){ self.coop_woundNext = 0 }
			if(level.time > level.coop_woundNext && level.time > self.coop_woundNext){
				level.coop_woundNext = level.time + ( 2.5 + ( randomfloat 3 ) )
				self.coop_woundNext = level.time + ( 18 + ( randomfloat 22 ) )
				self playsound coop_av_us_wounded
			}

			//[user 2026-09-02, bug-2323] WEIGHTED HARD TOWARDS THE FLOOR. "the injured guys holding
			//their shoulders only sometimes lay down and hold their wound, most of the time they are
			//standing in the open doing it."
			//
			//The kneeling pose is the culprit: <wg>_pain_kneesidle is upright from the waist, so at
			//any distance it reads as a man standing and clutching himself rather than a casualty.
			//It was 1 in 6; it is now 1 in 10, and the two floor branches take everything it lost.
			//A man down on the sand is what was asked for and what the beach should look like.
			local.r = randomint 10
			if(local.r > 5){ local.r = 3 }		//4,5,6..9 -> flat on the sand
			if(local.r == 4 || local.r == 5){ local.r = 2 }	//and the collapse-to-floor pair
			if(local.r == 0){
				//dragging himself. _pain_crawl exists for BOTH groups and is a one-shot in both.
				local.k = 0
				while(local.k < 5 && isalive self){
					self anim ( local.wg + "_pain_crawl" )
					self waittill animdone
					local.k++
				}
			}
			else if(local.r == 1){
				//up on his knees, holding himself
				if(local.wg == "unarmed"){
					self anim unarmed_pain_kneesidle
					wait ( 4 + ( randomfloat 5 ) )
				}else{
					local.k = 0
					while(local.k < 3 && isalive self){
						self anim ( local.wg + "_pain_kneesidle" )
						self waittill animdone
						local.k++
					}
				}
			}
			else if(local.r == 2){
				//[bug-2295] WAS `_pain_floorcrawl`, WHICH DOES NOT EXIST FOR THE UNARMED GROUP. Every
				//other weapon group ships it; unarmed does not, so an unarmed casualty routed here got
				//no animation at all and simply stood there. _pain_crawltofloor exists for both, and
				//reads better anyway - he collapses out of the crawl onto his face.
				self anim ( local.wg + "_pain_crawltofloor" )
				self waittill animdone
				local.k = 0
				while(local.k < 2 && isalive self){
					if(local.wg == "unarmed"){
						self anim unarmed_pain_flooridle
						wait ( 3 + ( randomfloat 3 ) )
					}else{
						self anim ( local.wg + "_pain_flooridle" )
						self waittill animdone
					}
					local.k++
				}
			}
			else{
				//flat, moving, alive - what the player sees most, so it gets the longest hold
				if(local.wg == "unarmed"){
					self anim unarmed_pain_flooridle
					wait ( 5 + ( randomfloat 6 ) )
				}else{
					local.k = 0
					while(local.k < 4 && isalive self){
						self anim ( local.wg + "_pain_flooridle" )
						self waittill animdone
						local.k++
					}
				}
			}
			continue
		}

		local.pick = randomint 12

		if(local.pick < 4){
			//--- PRONE. [bug-2295] `<wg>_prone_aim` DOES NOT EXIST FOR THE UNARMED GROUP either - the
			//second of the two missing aliases - so an unarmed man sent here also just stood. It made
			//no sense for him regardless: prone_aim is a man sighting a rifle he is not carrying. He
			//gets prone_beach_idle instead, this map's own authored prone (LOOP 5.13s).
			if(local.wg == "unarmed"){
				self anim prone_beach_idle
			}else{
				//NAMED LITERALLY, not concatenated: local.wg only ever holds "rifle" or "unarmed" (see
				//the top of this function), the unarmed case is handled above, so this branch is always
				//"rifle". Writing it out lets check_anim_dwell.py verify it instead of having to guess
				//which concatenations a guard makes unreachable.
				//[user 2026-09-02, bug-2380] "they will stand around like they have a gun in their
				//hands when they dont." This line was the one bare rifle_ animation left in this
				//function - everything else already routes through local.wg, which is set to
				//"unarmed" a hundred lines above for exactly this reason. A crate carrier is spawned
				//with gun "none", so he was being told to hold a Garand he does not have.
				if(local.wg == "unarmed"){ self anim unarmed_pain_flooridle }
				else{ self anim rifle_prone_aim }			//LOOP 0.10s - holds for as long as we wait
			}
			wait ( 10 + ( randomfloat 12 ) )
		}
		else if(local.pick < 7){
			//--- COVER, down and staying down
			local.r = randomint 3
			if(local.r == 0){ self anim prone_beach_idle }
			else if(local.r == 1){ self anim crouch_beach_idle }
			else{ self anim trench_idle_down }
			wait ( 9 + ( randomfloat 10 ) )
		}
		else if(local.pick < 10){
			//--- SCARED. [user] "shake behind cover like they are scared" / "more of them laying down
			//panicking and being scared". Widened, and split by loop flag like everything else here:
			//    hedge_shake02  LOOP 2.20s      hedge_shake01  once 3.00s
			//    hedge_shake03  LOOP 2.20s      hedge_dodge01  once 5.50s  <- was waited 9.00s on
			//    hedge_dodge02  LOOP 3.00s      hedge_dodge03  once 3.10s
			//                                   dfr_panic_05g  once 2.87s  <- a real panic animation
			//The one-shots are re-triggered off animdone; only the looping three get a bare wait.
			local.r = randomint 7
			if(local.r == 0){
				self anim hedge_shake02
				wait ( 5 + ( randomfloat 5 ) )
			}
			else if(local.r == 1){
				self anim hedge_shake03
				wait ( 5 + ( randomfloat 5 ) )
			}
			else if(local.r == 2){
				self anim hedge_dodge02
				wait ( 5 + ( randomfloat 5 ) )
			}
			else{
				local.k = 0
				while(local.k < 3 && isalive self){
					if(local.r == 3){ self anim hedge_shake01 }
					else if(local.r == 4){ self anim hedge_dodge01 }
					else if(local.r == 5){ self anim hedge_dodge03 }
					else{ self anim dfr_panic_05g }
					self waittill animdone
					local.k++
				}
			}
			//and back down behind whatever he is using - crouch_beach_idle LOOPS (13.33s)
			self anim crouch_beach_idle
			wait ( 4 + ( randomfloat 6 ) )
		}
		else if(local.pick < 11){
			//--- A LOOK, then back down. Never upright for long.
			self anim hedge_look01
			wait 8.3
			self anim crouch_beach_idle
			wait ( 5 + ( randomfloat 7 ) )
		}
		else{
			//--- ADVANCE, AND BE KILLED DOING IT. [user] "more can advance up the beach and get
			//killed" - 1 in 10 became 3 in 12. coop_chargeRun owns him from here and never returns him
			//standing, and never deletes him: he is chewed up by the MGs or goes up with a shell.
			local.gap = (0 0 0)
			local.gap[0] = 400
			local.gap[1] = 4200
			local.gap[2] = 0 - 300
			if($bangalore_explosion3a != NULL && $bangalore_explosion3a != NIL){
				local.gap = $bangalore_explosion3a.origin
			}
			self exec global/enable_ai.scr
			waitthread coop_chargeRun local.gap
			end
		}
	}

	//[bug-2281] the loop is bounded so a broken alias cannot spin it forever - but running out must not
	//leave him standing either. Lie him down and leave him down.
	if(self != NULL && self != NIL){
		if(isalive self){ self thread coop_vigHold "prone_beach_idle" }
	}
}end


//=========================================================================
//[user, bug-2282] "see random guns sitting on top of barbed wire, must be some of your placed debris"
//
//It was. coop_placeGround's perched test only ran below y 2400, because the y-band height profile it
//used is meaningless on the bluff - the 4800..5200 band spans -344 to -553, so one number per band would
//have rejected good placements. The barbed wire runs from y 3190 to y 5913, i.e. entirely in the region
//where the test was switched off, and that is exactly where the 20 northern gore clusters put dropped
//rifles and helmets.
//
//THE FIX IS A LOCAL REFERENCE INSTEAD OF A GLOBAL ONE. Every static model in obstacles.scr sits ON the
//ground, and the generator now carries its z. So the nearest static within 500 units IS a ground height
//for that spot - on the flat, on the bluff, in the draw, anywhere - and no profile is needed. The y-band
//table stays as the fallback for open sand with no static near it.
//=========================================================================
coop_nearGroundZ local.x local.y:{
//=========================================================================
	if(level.coop_obstN == NIL){ end NIL }

	//[user 2026-09-02, bug-2351] 500 -> 1100 units. "still floating blood all over barbed wire and
	//seawall areas." coop_placeGround's perched test needs a ground REFERENCE, and it takes the
	//nearest static model (statics sit on the ground, so one nearby is a valid local datum). Past
	//y 2400 the y-band profile is deliberately not trusted - the bluff climbs and a flat profile
	//would be a lie - so if no static was within 500 units the reference came back NIL and THE
	//PERCHED TEST WAS SKIPPED ENTIRELY. That is the seawall and the wire: open ground, few statics,
	//no check, blood left wherever it landed. Widening the datum search closes the gap without
	//pretending to know a height the profile cannot supply.
	local.best = 1210000		//1100 squared
	local.z = NIL
	local.i = 1
	while(local.i <= level.coop_obstN){
		local.dx = local.x - level.coop_obstX[local.i]
		if(local.dx < 0){ local.dx = 0 - local.dx }
		if(local.dx < 1100){
			local.dy = local.y - level.coop_obstY[local.i]
			if(local.dy < 0){ local.dy = 0 - local.dy }
			if(local.dy < 1100){
				local.d = ( local.dx * local.dx ) + ( local.dy * local.dy )
				if(local.d < local.best){
					local.best = local.d
					local.z = level.coop_obstZ[local.i]
				}
			}
		}
		local.i++
	}
	end local.z
}end


//=========================================================================
//[user, bug-2286] MEN BEHIND THE TANK TRAPS, WORKING THE BUNKERS.
//
//"we could have more allies behind tank traps just shooting towards the bunkers constantly too."
//
//PLACEMENT IS OFF THE REAL OBSTACLES, not guessed: each of these seven points is 95 units LANDWARD of an
//actual hedgehog read out of the BSP's static-model lump, filtered to the playable band and spaced at
//least 420 apart so they read as separate men rather than a line. The z on each row is that hedgehog's
//own ground height, so they start level with the trap they are using.
//
//THE ANIMATIONS ARE RETAIL'S OWN FIRING-FROM-COVER IDLES for this map, and all three genuinely LOOP, so
//a man holds the pose instead of playing it once and standing up (bug-2253's family):
//    shingle_idle_bang       LOOP  3.33s   - up over the top, firing
//    shingle_coveridle_bang  LOOP  6.67s   - firing from behind cover
//    trench_idle_up          LOOP 16.67s   - up on the bank, working a target
//They alternate with trench_idle_down so nobody is exposed permanently - which is both what men behind a
//tank trap actually did and the user's standing rule about nobody just being upright.
//=========================================================================
coop_beachFiringLine:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_firingLineOn == NIL){ level.coop_firingLineOn = 1 }
	if(!level.coop_firingLineOn){ end }
	if(level.coop_firingLineDone == 1){ end }
	level.coop_firingLineDone = 1

	//after the landing - men are not firing from the obstacle belt before anybody is ashore
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling != 1){
		wait 1
		local.t = local.t + 1
	}
	local.t = 0
	while(local.t < 200 && level.coop_runInShelling == 1){
		wait 1
		local.t = local.t + 1
	}
	wait 3

	if(level.coop_vigCap != NIL){ level.coop_vigCap = level.coop_vigCap + 7 }

	local.n = 0
	local.n++; local.fx[local.n] = 2008; local.fy[local.n] = 0 - 734; local.fz[local.n] = 0 - 510
	local.n++; local.fx[local.n] = 2526; local.fy[local.n] = 0 - 785; local.fz[local.n] = 0 - 510
	local.n++; local.fx[local.n] = 0 - 315; local.fy[local.n] = 0 - 1127; local.fz[local.n] = 0 - 542
	local.n++; local.fx[local.n] = 645; local.fy[local.n] = 0 - 494; local.fz[local.n] = 0 - 502
	local.n++; local.fx[local.n] = 0 - 2474; local.fy[local.n] = 783; local.fz[local.n] = 0 - 478
	local.n++; local.fx[local.n] = 0 - 2298; local.fy[local.n] = 0 - 769; local.fz[local.n] = 0 - 510
	local.n++; local.fx[local.n] = 0 - 802; local.fy[local.n] = 0 - 201; local.fz[local.n] = 0 - 494

	local.made = 0
	local.i = 1
	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.fx[local.i]
		local.p[1] = local.fy[local.i]
		local.p[2] = local.fz[local.i] + 30

		//yaw 90 is up the beach - every one of them faces the bluff and the bunkers on it
		local.gun = "m1 garand"
		if((local.i % 3) == 0){ local.gun = "bar" }
		local.a = waitthread coop_vigSpawn "models/human/dday_ranger_private" local.gun local.p 90 1
		if(local.a != NULL && local.a != NIL){
			//[user 2026-09-01, bug-2305] "the guys that are shooting should be susceptible to getting
			//killed too". coop_vigSpawn hands every actor `nodamage` (it is the right default for a
			//man holding a pose), so the whole firing line was immortal. `takedamage` with no argument
			//is EV_NORMAL -> DAMAGE_YES, undoing it for THIS caller only.
			//
			//They stay NOTSOLID deliberately - fifty solid bodies in the obstacle belt is how players
			//get shoved into tank traps - so a rifle round still passes through them. What kills them
			//is the same staged recipe the map already uses on the wire-cutters, coop_flankCutDown:
			//two staggers and then the round that drops him, on a long random delay so the beach loses
			//men steadily instead of in a chorus (bug-2254).
			local.a takedamage
			local.a thread coop_firingLoop
			if((randomint 3) < 2){ local.a thread coop_firingLineCutDown }	//[user 2026-09-02] 1-in-3 -> 2-in-3
			local.made++
		}
		local.i++
	}
	println("^~^~^ FIRINGLINE made=" + local.made + "/" + local.n)
}end

//A man on the firing line is hit. Modelled on coop_flankCutDown, which is the map's proven staged
//kill: two staggers and then the round that drops him. The long random lead-in matters - bug-2254 was
//eight simultaneous deaths inside the death-voice proximity gate, i.e. a chorus of screams from men
//the player could not see. Spread over minutes it reads as attrition instead.
//
//bhit is retail's own (maps/m3l1a.scr:8328, `bhit local.damage local.location local.direction
//local.force`); under-supplying the trailing args yields NIL and retail itself does exactly that at
//m3l1a.scr:2797. It passes NULL as the attacker, which is what gets it past the same-team filter.
//=========================================================================
coop_firingLineCutDown:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	//[user 2026-09-02] "more of these riflemen that just stand and shoot back at the bunkers should be
	//getting killed by mg fire and explosions." 25-215s meant most of them outlived the player's time
	//on that stretch of beach and the line looked immortal. 10-80s, so men are going down the whole
	//time you are among them.
	wait ( 10 + ( randomfloat 70 ) )
	if(self == NULL || self == NIL){ end }
	if(!isalive self){ end }
	//[bug-2368] coop_cutAnyway is set by coop_vigSpawn on armed vignette actors. They are not
	//part of the firing line and must not be gated on it, or the fix above is dead on arrival.
	if(self.coop_cutAnyway != 1 && !level.coop_firingLineOn){ end }

	local.o = self.origin + (0 0 44)
	self thread maps/m3l1a.scr::bhit 40 ( 0 - 1 )
	local.b = spawn script_model model "models/fx/coop_gorechunk.tik"
	if(local.b != NULL && local.b != NIL){
		local.b.origin = local.o
		local.b notsolid
		thread coop_fxCleanup local.b 25
	}
	wait 0.18
	if(self == NULL || self == NIL){ end }
	if(!isalive self){ end }
	self thread maps/m3l1a.scr::bhit 40 ( 0 - 1 )
	wait 0.22
	if(self == NULL || self == NIL){ end }
	if(isalive self){
		self thread maps/m3l1a.scr::bhit 1000 ( 0 - 1 )
		local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
		if(local.sp != NULL && local.sp != NIL){
			local.sp.origin = local.o
			local.sp notsolid
			local.sp anim start
			thread coop_fxCleanup local.sp 6
		}
		local.g = spawn script_model model "models/fx/coop_bloodslick.tik"
		if(local.g != NULL && local.g != NIL){
			local.g.origin = local.o - (0 0 40)
			local.g notsolid
			if(waitthread coop_placeGround local.g 170){ local.g anim start }
		}
	}
}end

//Up, fire, down, up again - forever, behind his trap.
//=========================================================================
coop_firingLoop:{
//=========================================================================
	if(self != NULL && self != NIL){ self.coop_behaveOff = 1 }	//he has a job; stop the default
	wait 0.1

	while(isalive self && level.coop_firingLineOn){
		local.r = randomint 3
		if(local.r == 0){ self anim shingle_idle_bang }
		else if(local.r == 1){ self anim shingle_coveridle_bang }
		else{ self anim trench_idle_up }
		wait ( 8 + ( randomfloat 12 ) )
		if(!isalive self){ break }

		//and back below the trap to reload and breathe
		self anim trench_idle_down
		wait ( 4 + ( randomfloat 7 ) )
	}

	//never end standing - see coop_beachBehave
	if(self != NULL && self != NIL){
		if(isalive self){ self.coop_behaveOff = 0; self thread coop_beachBehave }
	}
}end

//=========================================================================
//[user 2026-09-01, bug-2287] THE OBJECTS THE USER PLACED IN BUILD MODE.
//
//"I added a few objects, we can remove the hammering allied those dont make sense" / "i added a few
//objects too check for them". They were in coop_mod/save/build_m3l1a.dat, which is an EXPORT and not a
//save - build mode captures placements in paste-ready form and NOTHING respawns from that file at map
//load. Baked here, which is what makes them real.
//
//Two of them are hedgehogs, and those go into the runtime obstacle table as well as being spawned. The
//generated table in obstacles.scr comes from the BSP's static-model lump and therefore cannot know about
//anything WE place, so without this a blood pool or a rifleman would happily be dropped on top of the
//user's own new tank traps - the exact bug he has reported four times.
//=========================================================================
coop_userProps:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_userPropsOn == NIL){ level.coop_userPropsOn = 1 }
	if(!level.coop_userPropsOn){ end }

	//--- hedgehog beside the middle welder's position
	local.m = spawn script_model model "models/static/hedgehog.tik"
	if(local.m != NULL && local.m != NIL){
		local.m.origin = ( 57 ( 0 - 839 ) ( 0 - 493 ) )
		local.m.angles = (0 357 0)
		local.m solid
		waitthread coop_registerObstacle 57 ( 0 - 839 ) 64 ( 0 - 493 )
	}

	//--- hedgehog up on the left
	local.m = spawn script_model model "models/static/hedgehog.tik"
	if(local.m != NULL && local.m != NIL){
		local.m.origin = ( ( 0 - 2242 ) 714 ( 0 - 469 ) )
		local.m.angles = (0 52 0)
		local.m solid
		waitthread coop_registerObstacle ( 0 - 2242 ) 714 64 ( 0 - 469 )
	}

	//--- fire beside the right-hand welder
	local.m = spawn script_model model "models/emitters/tehao_fire.tik"
	if(local.m != NULL && local.m != NIL){
		local.m.origin = ( 2355 ( 0 - 111 ) ( 0 - 447 ) )
		local.m.angles = (0 52 0)
		local.m notsolid
		local.m anim start
		//[user, bug-2313] fire loopsound removed - visual only, and it was holding a channel
	}

	//--- and the explosion he put a long way out to sea. Kept because a burst on the horizon is good
	//scenery on this map, but flagged: it sits at y -7999, about 6,000 units seaward of the landing
	//band, so if it was a stray from testing rather than a deliberate placement, delete this block.
	local.m = spawn script_model model "models/fx/veltro_explode2.tik"
	if(local.m != NULL && local.m != NIL){
		local.m.origin = ( 3203 ( 0 - 8000 ) ( 0 - 257 ) )
		local.m.angles = (0 81 0)
		local.m notsolid
		local.m anim start
	}
	println("^~^~^ USERPROPS placed")
}end

//Add one entry to the runtime obstacle table, so coop_dropClear and coop_placeGround avoid something we
//placed ourselves. The generated table only knows what the BSP knows.
//=========================================================================
coop_registerObstacle local.x local.y local.r local.z:{
//=========================================================================
	if(level.coop_obstN == NIL){ end }
	level.coop_obstN++
	level.coop_obstX[level.coop_obstN] = local.x
	level.coop_obstY[level.coop_obstN] = local.y
	level.coop_obstR[level.coop_obstN] = local.r
	level.coop_obstZ[level.coop_obstN] = local.z
}end


//=========================================================================
//[user 2026-09-01, bug-2306] THE RAMP DROP, AS A SET PIECE.
//
//"Could we make the ramp open more cinematic? Like it opens, guys get instantly butchered in front
//of you and than an explosion inside sends you up and over the side dramatically, tons of handshake,
//blurriness etc to put you where you eventually spawn?"
//
//NOTHING PHYSICAL HAPPENS TO THE PLAYER. His body stays glued, hidden, notsolid, physics_off and
//notarget 1 in the boat for the whole extra 3.8 seconds, exactly as it does today - only his CAMERA
//flies. That single decision is why this is safe for eight people at once: nobody is teleported,
//nobody is given velocity, nobody can be left stuck in geometry, and the release at the end is the
//byte-identical m3l1a.scr block that shipped before, just fired 3.8s later.
//
//THE BUTCHERY WAS ALREADY THERE. Retail threads rangers 1-5 to their deaths in the ramp mouth at
//t+1.1 and they finish dying around t+3.3 - but coop released the players at t+2.0, so the player
//was already ashore before the last man fell. Holding the view is most of what was asked for, free.
//
//THREE ENGINE RULES THIS CODE OBEYS:
//  1. NEVER cut/start/follow/orbit/watch on $boatCamera. Camera::Cut ends with
//     ProcessEvent(EV_Camera_CameraThink) (camera.cpp:1537) and CameraThink re-posts itself every
//     0.05s doing setOrigin(CalculatePosition()) - it would stomp this arc forever.
//  2. movetopos/turnto, never `.origin =`/`.angles =`. Both write the transform AND stage
//     currentstate (camera.cpp:1159-1180), so if CameraThink ever does start it recomputes the same
//     values instead of jumping.
//  3. No hard cut. Eight players are looking eight different ways; each camera keeps its OWN yaw and
//     is eased along the shortest arc to 90, the spawn facing, so the takeover is invisible and the
//     landing lines up with playerFace.
//
//level.coop_rampCineOn 0 restores today's behaviour exactly. level.coop_rampTumble 0 keeps the
//throw and removes the roll, for anyone the tumble makes queasy. Level vars, NOT getcvar - script
//getcvar creates a cvar empty and permanently defeats the engine default (bug-1669).
//=========================================================================
coop_rampCinematic:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampCineOn == NIL){ level.coop_rampCineOn = 1 }
	if(level.coop_rampTumble == NIL){ level.coop_rampTumble = 1 }
	level.coop_rampCineDone = 0
	level.coop_rampDone = 0
	thread coop_rampWatchdog

	if(!level.coop_rampCineOn){ waitthread coop_rampHandoff; end }

	//[user 2026-09-03, LAYER 2] THE LOCK MOVED TO THE BLAST, and the tripod goes with it.
	//It used to be set right here - which is 1.60s BEFORE the shell - and in those 1.60s the only
	//thing that happened to the camera was NOTHING: coop_maintainBoatCameras stops copying
	//viewangles (maps/m3l1a.scr:8866) and no pose, movetopos or turnto runs until coop_rampFly.
	//The camera is bound through $higgins1_playerspot to a boat whose last move finished at
	//t 2.00 (m3l1a.scr:2498-2501), so it did not even drift. That is 54% of the 2.95s the ramp is
	//open spent as a bolted camera pointed wherever the player's head happened to be, and it is
	//the literal "you just stand staring straight".
	//It is now set one statement before coop_rampFly (see below), so free look survives right up
	//to the concussion that takes it away - which is the one takeover nobody resents. It also
	//means coop_rampFly's per-camera yaw snapshot is taken from where each player is ACTUALLY
	//looking, instead of from a 1.60s-stale yaw, which is exactly what rule 3 above wants.
	//
	//And publish the blast flag, which coop_rampHandheld's score stops on. coop_rampHandheld
	//seeds it too (it starts 6.30s before this line); this write is the cinematic re-asserting
	//ownership of the flag on the one path that can set it to 1.
	level.coop_rampBlast = 0

	//--- 1.6s of butchery. Retail's own five rangers are already dying in the mouth; all this adds
	//    is the gore and retail's own crew reactions.
	//[user 2026-09-03] BELT, not braces - the primary forced-decap mark is in m3l1a.scr one statement
	//ahead of higgins1_disembark_kill. This is a no-op once that ran (level.coop_rampDecapMarked), and
	//on its own it is measured 18.7% too late. It costs one same-frame waitthread and no wait.
	waitthread coop_rampDecapMark
	thread coop_rampGore
	//[user 2026-09-02, bug-2343] and the fire that is doing it, visibly, from the emplacements
	thread coop_rampIncoming
	wait 0.3
	thread maps/m3l1a.scr::higgins1_crouch
	wait 0.3
	if($higgins1_playerspot != NULL && $higgins1_playerspot != NIL){
		$higgins1_playerspot playsound arty_leadin
	}
	wait 0.1
	thread maps/m3l1a.scr::higgins1_flinch
	wait 0.3

	//the world greys and tunnels BEFORE the hit lands - the shell is audible first
	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){
			if($player[local.i].health > 0){
				thread coop_mod/main.scr::coop_setSuppression $player[local.i] 0.45
			}
		}
		local.i++
	}
	wait 0.6

	//--- THE HIT ---------------------------------------------------------------------------
	local.sp = $higgins1_playerspot
	if(local.sp == NULL || local.sp == NIL){ waitthread coop_rampHandoff; end }
	local.e = local.sp.origin + (0 0 85)

	local.bp = local.sp.origin
	local.bp[0] = local.bp[0] + 10
	local.bp[1] = local.bp[1] + 132		//the ramp mouth, on top of the men who just fell
	local.bp[2] = local.bp[2] + 26

	local.fx = spawn "models/animate/fx_mortar_higgins.tik"
	if(local.fx != NULL && local.fx != NIL){			//entity-pool guard
		local.fx.origin = local.bp
		local.fx notsolid
		local.fx anim start
		//its greasefire latch runs 30s otherwise, and this is a set piece we leave behind
		thread coop_fxCleanup local.fx 6
	}
	local.sp playsound higgins_explosion
	local.sp playsound higgins_blowup_guys
	//[LAYER 2] coop_rampHandheld watches this and stops here. The shell has to be an ESCALATION
	//over an already-shaking frame, not a jitter competing with a bed - and m_vViewVariation takes
	//the MAX (earthquake.cpp:209-225), so a live small bed would hold a floor under the shell's
	//own decay. It is set BEFORE fadeout/earthquake_radius so the score stops on the same frame
	//the shell lands, not one tick later.
	level.coop_rampBlast = 1

	fadeout 0.06 1 0.92 0.75 1
	thread coop_mod/main.scr::earthquake_radius local.bp 2.4 2.6 2200

	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL){
			if(local.pl.health > 0 && local.pl.dmteam != "spectator"){
				//[user 2026-09-02, bug-2354] THE RING IS PLAYED DIRECTLY. THIS FILE ALREADY SAID SO.
				//
				//coop_rampAudioCut's own header, a few hundred lines down, states the rule: "s_volume -
				//NEVER. It is clamped 0..1 and squared into the listener gain, so it would take the music
				//down with the world. This is why the ring is played directly rather than through
				//coop_tinnitus_triggerBlast, whose muffle branch stuffs s_volume." And then this line
				//called coop_tinnitus_triggerBlast anyway. The code contradicted its own design note.
				//
				//WHAT THAT COST: with the shipped coop_tinnitusMuffle 1 and coop_tinnitusTime 10, the
				//muffle branch stuffs s_volume 0.28 -> 0.50 -> 0.72 across ten seconds. s_volume is
				//squared into the OpenAL listener gain AND is half of S_GetBaseVolume(). The music
				//takeover's `tmvolume 1.5` runs 0.12s later and BAKES the triggered-music source gain
				//using S_GetBaseVolume() at that moment - i.e. at s_volume 0.28 - and the gain is only
				//recomputed when s_musicVolume->modified, which Cvar_Set2 never sets because the cgame
				//duck lerp keeps writing the same value. So the swell that is supposed to own the scene
				//played at roughly a third of intended for the whole sixty seconds, and the user heard
				//exactly that: "the dialogue ... still plays way louder than the music".
				//
				//The ring and the wash are both under sound/coop_tinnitus/, which S_HZM_CueTier gives
				//tier 1, so they ride OVER the cinematic duck without any help from s_volume. Playing
				//them directly gets the whole concussion beat and leaves the music alone.
				local.pl playlocalsound coop_tinnitus_ring
				local.pl playlocalsound coop_shellshock_uw
				local.pl stufftext "set coop_dizzy 1"
				thread coop_mod/main.scr::coop_bumpSuppression local.pl 1.0
			}
		}
		local.i++
	}

	//[user 2026-09-01, bug-2308] THE FADEIN GOES BEFORE THE FLIGHT, NOT AFTER IT.
	//
	//"because the screen is white we don't really see how we ended up outside of the boat" - my bug,
	//and an obvious one in hindsight: `waitthread coop_rampFly` BLOCKS for the whole 2.2s arc, so
	//calling fadein after it meant the screen stayed fully white for the entire flight and only
	//cleared once the player had already landed. The one shot the whole set piece exists to show was
	//playing behind a white card.
	//
	//fadein does not block - it sets a level fade that decrements per frame - so firing it here lets
	//it run CONCURRENTLY with the arc. 0.12s at full white (a blast flash, not a transition) then a
	//0.45s clear, so the screen is readable about a quarter of the way into the throw and the player
	//watches the boat fall away from him for the rest of it.
	wait 0.12
	fadein 0.45 1 0.92 0.75 1

	//[user 2026-09-02, bug-2319] THE CUT LANDS HERE - 0.12s AFTER THE SHELL, not eleven seconds
	//before it. Everything up to this line played at 100%: the whistle, the door, the machine-gunning
	//and the explosion itself.
	waitthread coop_rampAudioCut

	//[LAYER 2] free look ends HERE, one statement before the arc, and not a moment earlier. Order
	//is load-bearing: coop_maintainBoatCameras must stop copying viewangles (m3l1a.scr:8866)
	//BEFORE coop_rampFly reads each camera's starting yaw, or a late copy would fight the first
	//frame of the arc. The lock is cleared on EVERY exit path by coop_rampHandoff
	//(coopified.scr, `level.coop_rampCamLock = 0`), which is reached from the normal tail below,
	//from both early bails above, and from coop_rampWatchdog.
	level.coop_rampCamLock = 1
	println("^~^~^ RAMPCAM lock - free look held to the blast, released into the arc")

	waitthread coop_rampFly local.e
	waitthread coop_rampUnderwater
	waitthread coop_rampHandoff
}end


//ONE MAN LOSES HIS HEAD, IN FRONT OF YOU, EVERY TIME.
//
//[user 2026-09-03] "If there is a way to decapitate one of those allies that gets shot in the
//beginning too that would add some flair of danger."
//
//The engine has shipped a full decapitation since 2026-08-17 (game.dll Sentient::CoopGoreTryDecapitate)
//and it could not possibly fire here. Its MOD gate admits CoopGoreModIsExplosive plus MOD_SHOTGUN, and
//these five men die to maps/m3l1a.scr::bhit -> global/bullethit.scr:93, which is
//`damage NULL <dmg> NULL (0 0 0) <dir> (0 0 0) <force> 16 17 <loc>`.
//
//READ THAT 17 CAREFULLY. bullethit.scr's own comment table (its lines 100-125) calls 17 MOD_BULLET,
//and that table is RETAIL's - it has no MOD_GRENADE, so from index 14 down it is off by one from the
//engine we actually run. In openmohaa (code/fgame/bg_public.h:479-506) 17 is MOD_IMPACT; MOD_BULLET
//is 18, MOD_BASH is 26 and MOD_SHOTGUN is 27. So the script author wrote "bullet" and the engine
//hears "impact", and CoopGoreModIsExplosive's MOD_IMPACT case (sentient.cpp:3247) then returns false
//purely because bullethit passes a NULL inflictor rather than a projectile.
//
//MEASURED, not argued: across every m3l1a server log in this repo there are 393 kills - 346 mod=17
//and 47 mod=9 - and all 22 `DECAPTRY fired` lines are mod=9. 88% of the deaths on this map are the
//one death that can never decapitate, and not once in the history of the log has a bhit death taken
//a head off.
//
//gore_decap is the engine's answer: the sibling of gore_gibmark, forcing the decap past the MOD gate
//AND past the 30% roll, for exactly one entity, once. gore_gibmark rides along so the headless corpse
//gets the tier-3 gib skins the severed head is already force-skinned to - us_young_heads.tik carries
//four `surface head shader` entries per case with two clean pads specifically so index 3 is the gib
//face, so the head and the body match.
//
//WHY RANGER 1. He is already the man the machine guns are pointed at: coop_rampIncoming picks
//$higgins1_ranger1 as local.tgt and setaimtargets all five MG42s onto him. The tracers, the man and
//the head that comes off are one causal chain the player can read. He is also framed - his origin is
//360 -7328 -464 and $higgins1_deathnode1 is 4640 units up-beach at 472 -2688 -128, so he never
//reaches it; he runs a hundred-odd units straight out of the ramp mouth on +Y and dies dead ahead of
//a camera that coop_rampCamLock is holding forward. And he is a proven decap subject: all 22
//DECAPTRY lines in the logs are models/human/dday_ranger_private.tik, headsurfs=2, gibsurfs=19.
//
//WHY THE MARK IS SET IN m3l1a.scr AND NOT HERE. Measured from the retail script, not assumed.
//higgins1_opening_sequence:2789 starts his death thread; coop_rampCinematic is not reached until
//0.20+0.25+0.15+0.30 = 0.90s later. higgins1_disembark_kill (:2929) then waits (randomfloat .3 + .5)
//- which is randomfloat(0.3)+0.5, i.e. 0.5-0.8s, because a prim_expr cannot begin with TOKEN_PLUS so
//the `+` closes the parameter list - and hits him with bhit 40 -1, again at +0.2, then bhit 1000 at
//+0.5. bhit rolls its location as (randomint 17 + 1) = 1..17, and locations 1 and 2 are HITLOC_HELMET
//and HITLOC_NECK, both carrying a 4.0x damage multiplier (sentient.cpp:908-910) against this man's
//tik health of 100 (dday_ranger_private.tik:183 - and allied AI keep it, aihandler.scr:959 exempts
//team american from the 5000 pain buffer). So a bhit 40 kills him outright 2 times in 17.
//P(dead before the cinematic even starts) = 2/17 + (15/17)(2/17)(2/3) = 18.7%. A mark set inside the
//cinematic would silently no-show on nearly one run in five. The mark therefore goes in m3l1a.scr one
//statement AHEAD of his death thread, where nothing can have hit him yet.
//The call below is the belt, not the braces: it is a no-op once the m3l1a.scr hook has run, and on
//its own it inherits that same 18.7%.
//
//level.coop_rampDecapOn 0 turns it off and restores today's behaviour exactly.
//=========================================================================
coop_rampDecapMark:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampDecapOn == NIL){ level.coop_rampDecapOn = 1 }
	if(!level.coop_rampDecapOn){ end }
	if(level.coop_rampDecapMarked == 1){ end }

	local.m = $higgins1_ranger1
	local.tag = "higgins1_ranger1"
	if(local.m == NULL || local.m == NIL){
		local.m = $higgins1_ranger2
		local.tag = "higgins1_ranger2"
	}
	if(local.m == NULL || local.m == NIL){
		println("^~^~^ RAMPDECAP no target - ranger1 and ranger2 both absent")
		end
	}
	if(!isalive local.m){
		println("^~^~^ RAMPDECAP target already dead - too late to mark")
		end
	}

	//6s window: the last authored blow lands ~1.3s from here and coop_rampGore can finish him up to
	//~2.5s from here. A mark that outlives him simply expires; the engine clears it on the first
	//death that reaches CoopGoreTryDecapitate, so it can never carry onto another body.
	local.m gore_gibmark 6
	local.m gore_decap 6
	level.coop_rampDecapMarked = 1
	//entnum is printed so this line pairs exactly with the engine's `DECAPFORCE fired ent=<n>`.
	println("^~^~^ RAMPDECAP marked " + local.tag + " ent=" + local.m.entnum + " t=" + level.time)
}end


//The gore half of coop_flankCutDown, applied to the five men retail is already killing in the ramp
//mouth. It does NOT kill them - retail's own higgins1_disembark_kill threads do that, on their own
//timing; this only makes it read as butchery rather than as five men lying down.
//=========================================================================
coop_rampGore:{
//=========================================================================
	//[user 2026-09-01, bug-2308] TWO MEN DIE IN THE MOUTH, POINT BLANK, FIRST.
	//
	//"when the higgins door comes down they all run out the entrance" - they do, because retail's
	//higgins1_disembark_kill threads send them running and they fall well down the ramp, away from
	//the player. So the butchery was happening, just not in front of anybody. These two are cut down
	//where they stand, in the doorway, in the first half second - which is the shot that was asked
	//for. The other three still run and still die on retail's own timing, so the beat reads as the
	//front rank being scythed and the rest pushing past them.
	//[user 2026-09-02, bug-2325] AND YOU HEAR IT. "when they get killed when the door opens its not
	//brutal enough, im not hearing the sound of people getting chewed up by mgs."
	//
	//bhit does the damage and the stagger but makes no impact sound of its own, so the front rank was
	//dying quietly. snd_bh_flesh is retail's own bullet-into-flesh set (10 variants, all reachable
	//here) and snd_bodyfall_sand is the body landing. A burst is several rounds, so each man takes a
	//short volley of them rather than one hit - that is the difference between "he fell over" and
	//"he was chewed up".
	local.k = 1
	while(local.k <= 2){
		local.m = $( "higgins1_ranger" + local.k )
		if(local.m != NULL && local.m != NIL){
			if(isalive local.m){
				local.m thread maps/m3l1a.scr::bhit 40 ( 0 - 1 )
				local.o = local.m.origin + (0 0 44)
				//[user 2026-09-02, bug-2360] AND IT LANDS ON THE CAMERA. "when the higgins door opens
				//as soon as the allies start getting shot we should throw blood effects onto the
				//screen to get washed off my the water." These two die in the doorway, point blank,
				//so they get the full amount. The client owns the decay from here and the water
				//strips it in about a second - see the publish in cg_view.c.
				waitthread coop_rampLensBlood 0.85

				//the volley - 4 to 6 rounds into him over a fifth of a second
				local.v = 0
				local.vn = 4 + (randomint 3)
				while(local.v < local.vn){
					local.m playsound snd_bh_flesh

					//[user 2026-09-02, bug-2343] "we also need to make sure we can actually see the
					//bullets physically shredding the guys". The volley already threw gore and made
					//the right noise, but nothing showed a ROUND ARRIVING - so it read as a man
					//coming apart rather than as a man being hit. bh_human_uniform_hard is retail's
					//own bullet-into-uniform impact, the same effect the engine spawns when a round
					//hits an actor for real, and it is a pure client fx with no damage of its own.
					local.imp = spawn script_model model "models/fx/bh_human_uniform_hard.tik"
					if(local.imp != NULL && local.imp != NIL){
						local.ip = local.o
						local.ip[0] = local.ip[0] + ((randomint 22) - 11)
						local.ip[1] = local.ip[1] + ((randomint 22) - 11)
						local.ip[2] = local.ip[2] + ((randomint 40) - 22)
						local.imp.origin = local.ip
						local.imp notsolid
						thread coop_fxCleanup local.imp 2
					}

					local.g = spawn script_model model "models/fx/coop_gorechunk.tik"
					if(local.g != NULL && local.g != NIL){
						local.gp = local.o
						local.gp[0] = local.gp[0] + ((randomint 30) - 15)
						local.gp[1] = local.gp[1] + ((randomint 30) - 15)
						local.gp[2] = local.gp[2] + ((randomint 30) - 15)
						local.g.origin = local.gp
						local.g notsolid
						thread coop_fxCleanup local.g 25
					}
					wait 0.045
					local.v++
				}

				local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
				if(local.sp != NULL && local.sp != NIL){
					local.sp.origin = local.o
					local.sp notsolid
					local.sp anim start
					thread coop_fxCleanup local.sp 6
				}
				local.m playsound snd_bodyfall_sand
			}
		}
		wait 0.12
		local.k++
	}
	local.k = 1
	while(local.k <= 2){
		local.m = $( "higgins1_ranger" + local.k )
		if(local.m != NULL && local.m != NIL){
			if(isalive local.m){ local.m thread maps/m3l1a.scr::bhit 1000 ( 0 - 1 ) }
		}
		wait 0.1
		local.k++
	}

	local.i = 1
	while(local.i <= 5){
		local.m = $( "higgins1_ranger" + local.i )
		if(local.m != NULL && local.m != NIL){
			local.o = local.m.origin + (0 0 44)
			//[bug-2360] the three who run further down the ramp - less on the glass.
			waitthread coop_rampLensBlood 0.45
			local.b = spawn script_model model "models/fx/coop_gorechunk.tik"
			if(local.b != NULL && local.b != NIL){
				local.b.origin = local.o
				local.b notsolid
				thread coop_fxCleanup local.b 25
			}
			local.sp = spawn script_model model "models/fx/coop_blooddrip.tik"
			if(local.sp != NULL && local.sp != NIL){
				local.sp.origin = local.o
				local.sp notsolid
				local.sp anim start
				thread coop_fxCleanup local.sp 6
			}
			local.g = spawn script_model model "models/fx/coop_bloodslick.tik"
			if(local.g != NULL && local.g != NIL){
				local.g.origin = local.o - (0 0 40)
				local.g notsolid
				if(waitthread coop_placeGround local.g 170){ local.g anim start }
			}
		}
		wait 0.35
		local.i++
	}
}end


//THE ARC. One thread drives every camera, and $boatCamera is re-read EVERY FRAME so a player who
//connects mid-throw joins the arc on his first frame instead of sitting in the boat watching.
//=========================================================================
coop_rampFly local.e:{
//=========================================================================
	local.land = level.flags["coop_spawn1origin"]
	if(local.land == NIL){ local.land = local.e }
	local.land = local.land + (0 0 62)

	//[user 2026-09-02, bug-2320] AND NOW IT ACTUALLY REACHES THE WATER. As written the arc ended at
	//z -488, which is 32 units ABOVE the -520 surface (measured from m3l1a.bsp brush 787, contents
	//CONTENTS_WATER), so the camera never touched it and "water contact" was keyed on a hardcoded
	//fraction of the flight instead of on the surface. Ending ON the surface makes the crossing a
	//real event that the plunge below can continue from.
	if(level.coop_rampUnderOn == NIL){ level.coop_rampUnderOn = 1 }
	local.wz = local.land[2]
	if(level.coop_rampUnderOn){
		local.land[2] = ( 0 - 520 )
		local.wz = ( 0 - 520 )
	}

	//capture each camera's starting yaw once, and the SHORTEST arc from it round to 90
	local.n = 0
	local.i = 1
	while(local.i <= $boatCamera.size){
		local.c = $boatCamera[local.i]
		if(local.c != NULL && local.c != NIL){
			local.n++
			local.cam[local.n] = local.c
			local.y = local.c.angles[1]
			local.d = 90 - local.y
			while(local.d > 180){ local.d = local.d - 360 }
			while(local.d < ( 0 - 180 )){ local.d = local.d + 360 }
			local.y0[local.n] = local.y
			local.dy[local.n] = local.d
		}
		local.i++
	}

	local.t0  = level.time
	local.dur = 2.6		//[bug-2320] 2.2 -> 2.6. "slower makes it feel more cinematic"
	local.splashed = 0
	local.tum = level.coop_rampTumble
	if(local.tum == NIL){ local.tum = 1 }

	while(1){
		local.f = ( level.time - local.t0 ) / local.dur
		if(local.f > 1){ local.f = 1 }
		local.arc = 4 * local.f * ( 1 - local.f )		//0 at both ends, 1 at the top

		//position: a straight lerp from the ride eye to the spawn point, plus the throw
		//[bug-2320] EASE THE TRANSLATION, KEEP THE PARABOLA. local.s is a quadratic ease-out, so the
		//body leaves the gunwale fast and then drifts - which is what reads as "slower" - while the
		//vertical term stays a true 4f(1-f), accelerating downward at the end so the water ARRIVES
		//rather than being floated into. FOV is not available as a second lever: Camera::camera_fov
		//is only recomputed inside CameraThink, and rule 1 at the top of this file forbids ever
		//starting CameraThink on $boatCamera.
		local.s = 1 - ( ( 1 - local.f ) * ( 1 - local.f ) )

		local.p = local.e + ( ( local.land - local.e ) * local.s )
		local.p[0] = local.p[0] - ( 250 * local.arc )		//out over the port gunwale (was 200)
		local.p[2] = local.p[2] + ( 230 * local.arc )		//up (was 190)

		//pitch: thrown back at the sky, over onto the water, then up the beach to level
		local.pitch = ( 0 - 30 ) + ( 82 * local.f ) - ( 70 * local.arc )
		//roll: the tumble, capped near 120. A full barrel roll on eight non-consenting people is a
		//motion-sickness generator; level.coop_rampTumble 0 removes it and keeps the throw.
		local.roll = ( 0 - 120 ) * local.arc * local.tum

		//[bug-2320] HOLD THE BLUR ACROSS THE THROW - "more chaos, blurrier". The single
		//coop_bumpSuppression 1.0 fired at the blast decays back to its 0.45 floor in well under a
		//second, so two thirds of a 2.6s arc was rendering as a mild grey wash. This is a stepped
		//FLOOR rather than a bump, and the setter is edge-triggered, so four distinct values cost
		//four reliable commands per client for the whole flight - not one per frame.
		local.sup = 0.92
		if(local.f >= 0.30){ local.sup = 0.80 }
		if(local.f >= 0.60){ local.sup = 0.68 }
		if(local.f >= 0.85){ local.sup = 0.56 }
		waitthread coop_rampSuppressAll local.sup

		local.i = 1
		while(local.i <= local.n){
			local.c = local.cam[local.i]
			if(local.c != NULL && local.c != NIL){
				local.a = (0 0 0)
				local.a[0] = local.pitch
				local.a[1] = local.y0[local.i] + ( local.dy[local.i] * local.s )
				local.a[2] = local.roll
				local.c movetopos local.p
				local.c turnto local.a
			}
			local.i++
		}

		//water contact, once
		//[bug-2320] KEYED ON THE SURFACE, NOT ON A FRACTION OF THE FLIGHT. And the splash is stuffed
		//DIRECT rather than through coop_lensSplashAt, because that helper measures from each
		//player's ORIGIN - and every body is still glued in the boat two hundred units away, so its
		//900-unit reach may have been covering nobody at all.
		if(local.splashed == 0 && ( local.p[2] <= ( local.wz + 6 ) || local.f >= 0.95 )){
			local.splashed = 1
			level.coop_rampInWater = 1
			local.i = 1
			while(local.i <= $player.size){
				if($player[local.i] != NULL && $player[local.i] != NIL){
					if($player[local.i].health > 0){ $player[local.i] stufftext "coop_lensSplash 0.95" }
				}
				local.i++
			}
			//earthquake_radius is centred on the BOAT, not the landing point: the jitter measures
			//from each player's own origin and the bodies never left the boat.
			thread coop_mod/main.scr::earthquake_radius local.land 0.8 1.2 900
			if($higgins1_playerspot != NULL && $higgins1_playerspot != NIL){
				//[user 2026-09-02, bug-2332] "I need to hear the ringing, our body hitting the water".
				//arty_exp_water is the SHELL going into the sea; this is the man. snd_bodyfall_wade is
				//retail's own body-into-water pair and nothing on this map was using it.
				$higgins1_playerspot playsound snd_bodyfall_wade
				$higgins1_playerspot playsound arty_exp_water
			}
		}

		if(local.f >= 1){ break }
		waitframe
	}
}end


//=========================================================================
//[user 2026-09-02, bug-2319] THE CUT. One frame, no fade - "loud explosion can be heard ... and
//should cut down all of the sounds at that point, we should hear ringing and the music start playing
//and take ownership of the sounds at that point".
//
//FOUR LEVERS, AND ONE DELIBERATELY ABSENT:
//  s_sfxduck 0.05 - the world. Music-exempt, cue-exempt (so the ring rides over it) and
//                   whistle-exempt, all in openal_channel::set_gain.
//  coop_voxCut 0  - SPEECH. Scales the dialogue floor bug-2298 introduced. Flags 0, so it can never
//                   be written to a config; held ~5s; restored on four independent paths.
//  tmvolume 1.5   - the music, and this is the ONE call that actually applies the swell.
//                   coop_cvarDuckStart "Music" 4.6 put s_musicvolume at 4.6 ten seconds ago and it
//                   has been sitting there doing NOTHING: MUSIC_UpdateMusicVolumes consumes
//                   s_musicVolume->modified in its chan_song block before the chan_trig_music block
//                   can read it, so an s_musicvolume-only change never reaches the triggered
//                   channel. tmvolume sets music_volume_changed, which survives that, and releases
//                   the whole pending 4.6. THAT is why "it still isnt very loud".
//  s_volume       - NEVER. It is clamped 0..1 and squared into the listener gain, so it would take
//                   the music down with the world. This is why the ring is played directly rather
//                   than through coop_tinnitus_triggerBlast, whose muffle branch stuffs s_volume.
//=========================================================================
coop_rampAudioCut:{
//=========================================================================
	if(level.coop_rampAudioCut == 1){ end }
	level.coop_rampAudioCut = 1

	waitthread coop_mod/replace.scr::coop_setClientCvar "s_sfxduck" 0.05
	waitthread coop_mod/replace.scr::coop_setClientCvar "coop_voxCut" 0
	waitthread coop_mod/replace.scr::tmvolume 1.5
	exec coop_mod/replace.scr::coop_cvarDuckStart "Ambient" 0.0 0.3 8

	//[user 2026-09-02] "I still hear the dialogue over the music and it sounds like it is at full
	//volume ... Pain noises are also full volume whole time."
	//
	//THE ONE WINDOW NO LOG CAN BE READ BACKWARDS FOR. s_show_sounds prints a sound's ALIAS volume,
	//not the gain after openal_channel::set_gain applies the duck, so a finished log cannot say
	//whether the duck was on. And querying the cvars from the console minutes later reads 1 because
	//the duck has legitimately ended by then - which is exactly the false negative that nearly got
	//reported as a finding. The only honest measurement is a sample taken INSIDE the cut.
	//
	//Threaded, not inline, so the readback wait cannot delay the cinematic it is measuring. Both
	//cvars are registered in C (s_sfxduck in the client, coop_voxCut at snd_dma_new.cpp:113), so
	//getcvar cannot create either one empty - the bug-1669 trap does not apply here.
	thread coop_rampAudioProbe
}end

//=========================================================================
coop_rampAudioProbe:{
//=========================================================================
	//the stufftexts above land on the client command buffer, so read back a beat later, not now.
	wait 0.5
	//SANITISE BEFORE CONCATENATING. level.coop_voxCutHold is only assigned while the takeover owns
	//the floor, so it is NIL the rest of the time - and an unset var reads `none`, which makes
	//"str" + none THROW. A thrown println prints NOTHING at all, so the probe would go silent on
	//exactly the runs worth measuring (bug-1702, and the SPAWNDISG probe before it).
	local.hold = level.coop_voxCutHold
	if(local.hold == NIL || local.hold == NULL){ local.hold = "none" }
	println("^~^~^ RAMPAUD cut sfxduck=" + getcvar("s_sfxduck") + " voxCut=" + getcvar("coop_voxCut") + " voxFloor=" + getcvar("s_sfxduckVoxFloor") + " hold=" + local.hold)
	wait 7
	println("^~^~^ RAMPAUD post-release sfxduck=" + getcvar("s_sfxduck") + " voxCut=" + getcvar("coop_voxCut"))
	wait 30
	println("^~^~^ RAMPAUD t+37 sfxduck=" + getcvar("s_sfxduck") + " voxCut=" + getcvar("coop_voxCut"))
}end

//The bounded half. s_sfxduck is NOT restored here - coop_m3l1a_beachAudio still owns it and its
//existing tail fades it back over 12s after the 60s takeover, which is the behaviour to keep. Only
//the dialogue floor comes back, and it comes back quickly.
//=========================================================================
coop_rampAudioRelease:{
//=========================================================================
	wait 5
	//[user 2026-09-02, bug-2390] RESTORE TO THE TAKEOVER'S VALUE, NOT TO 1.
	//
	//This is why the user reported "dialogue still way louder than the music" after the cut was
	//already correct. coop_m3l1a_beachAudio sets coop_voxCut 0.55 for its 95-second music takeover,
	//but the handoff lands only ~20.5s into that window (2.6s arc + 17.95s underwater) and threads
	//BOTH of these, each of which slams coop_voxCut back to 1 unconditionally. So speech was ducked
	//for the first twenty seconds and then fully exempt - the bug-2298 floor - for the remaining
	//seventy-four. The blast cut was working; the takeover cut was being erased by the blast's own
	//cleanup.
	//
	//level.coop_voxCutHold is set by the takeover and cleared when it ends, so these restore to
	//whatever is actually wanted at the time and still return to 1 once nothing owns it.
	if(level.coop_voxCutHold != NIL){
		waitthread coop_mod/replace.scr::coop_setClientCvar "coop_voxCut" level.coop_voxCutHold
	}else{
		waitthread coop_mod/replace.scr::coop_setClientCvar "coop_voxCut" 1
	}
}end

//Belt and braces - called from the handoff AND the watchdog. Idempotent, and the reason a failure
//inside this set piece cannot leave the captain permanently inaudible.
//=========================================================================
coop_rampAudioSafe:{
//=========================================================================
	//[user 2026-09-02, bug-2390] RESTORE TO THE TAKEOVER'S VALUE, NOT TO 1.
	//
	//This is why the user reported "dialogue still way louder than the music" after the cut was
	//already correct. coop_m3l1a_beachAudio sets coop_voxCut 0.55 for its 95-second music takeover,
	//but the handoff lands only ~20.5s into that window (2.6s arc + 17.95s underwater) and threads
	//BOTH of these, each of which slams coop_voxCut back to 1 unconditionally. So speech was ducked
	//for the first twenty seconds and then fully exempt - the bug-2298 floor - for the remaining
	//seventy-four. The blast cut was working; the takeover cut was being erased by the blast's own
	//cleanup.
	//
	//level.coop_voxCutHold is set by the takeover and cleared when it ends, so these restore to
	//whatever is actually wanted at the time and still return to 1 once nothing owns it.
	if(level.coop_voxCutHold != NIL){
		waitthread coop_mod/replace.scr::coop_setClientCvar "coop_voxCut" level.coop_voxCutHold
	}else{
		waitthread coop_mod/replace.scr::coop_setClientCvar "coop_voxCut" 1
	}
}end

//=========================================================================
//[user 2026-09-03] THE UNDERWATER BEAT, AS A MAN AND NOT AS A CAMERA.
//
//"instead of just hitting the bottom of ocean floor and camera moving left and right, have him fall
//down, struggle a bit, try to get back up and move under the water like he is swiming up to shore...
//extend like entire scene if need be. But it feels too generic under the water, we need it to be
//more cinematic."
//
//WHY THE OLD VERSION READ AS A FLOATING HEAD, precisely. Three properties, all measurable:
//  1. XY NEVER MOVED. Every key in the 12-second hold set pos[0]=wx and pos[1]=wy. The camera
//     translated ZERO units in seventeen seconds. Nothing in the frame had parallax, so nothing
//     could read as travel - only as turning.
//  2. THE ONLY MOTION WAS A SMOOTH SPLINE. Seven keys walked with a smoothstep. A spline has no
//     body signature: no impact, no effort, no recovery, no periodicity. A man swimming has all
//     four, and they are what the eye actually reads as "a person is doing this".
//  3. THE ONE PERIODIC TERM WAS THE DIZZINESS, and its biggest term is a sine on ROLL (cg_view.c
//     :5913 calls CG_ApplyShellShock, whose roll term is sin(t*5.3) * 5.5 * sev). At the shipped
//     severity 2.4 that is +-13.2 degrees of roll oscillation with nothing else moving. That IS the
//     "camera feels like it kinda just waves around left and right" - the user was describing the
//     shell-shock sway, uncontested, because the choreography underneath it was static.
//
//THE FIX IS STAGING, and it is nine beats instead of four:
//    plunge      0.55s   he goes under head first, still tumbling from the throw
//    tumble      1.30s   a lazy half-turn in the column, ending pitched back at the light
//    bottom      0.26s   HE HITS IT. hard stop, jolt, sand, and the frame stops dead
//    sand        1.55s   the pause. he does not move. this beat has no equivalent today
//    try 1       1.51s   pushes up, the arm gives, he goes back down
//    try 2       1.70s   harder, gains ground, goes back down anyway
//    up          2.40s   gets his feet under him and levels off toward the shore
//    push       10.32s   SIX STROKES toward shore, each with surge, pulse and roll
//    gather      1.25s   plants and coils
//    break       0.55s   straight up through the surface onto the handoff pose
//MEASURED, not estimated: 2.66s of unpaced beats + 18.73s of paced ones = 21.39s nominal, and
//running the CODED table at the 20Hz server tick gives 21.35s submerged and 21.90s to the handoff
//at level.coop_uwPace 1 (the 0.5s difference is one frame of overshoot on each of the 21 legs),
//against 17.95s today. The user explicitly authorised the extension. coop_uwPace scales the six
//MIDDLE beats only - never the plunge or the break, both of which are timing-critical against the
//arc above and the handoff below.
//
//THE PACE CLAMP IS 0.5..1.2, AND THAT CEILING IS A SAFETY NUMBER, NOT A TASTE ONE. An earlier cut
//of this rewrite clamped at 1.8 and raised coop_rampWatchdog from 90 half-second ticks (45s) to 140
//(70s) to fit. That change is REMOVED, because it inverts an ordering that matters:
//    coop_rampWatchdog        `local.t < 90`, +1   per 0.5s wait  ->  45s, then clearfade + handoff
//    coop_rampIncomingSafety  `local.t < 60`, +0.5 per 0.5s wait  ->  60s, then takedamage
//Today the watchdog frees the player at 45s, fifteen seconds BEFORE mortality comes back. At a 70s
//watchdog the player becomes damageable at ~61s while still glued, hidden and locked in a camera he
//cannot leave, with no fade - a ten-second window that did not exist before. So the watchdog stays
//at 90 and the pace is clamped instead. MEASURED worst case at 1.2: the beat itself runs 25.65s to
//the handoff, plus 4.4s of butchery and arc ahead of it (0.3+0.3+0.1+0.3+0.6+0.12 of waits plus
//coop_rampFly's 2.6s arc) = 30.1s, against a 45s watchdog. 14.9s of margin, and the ordering is
//untouched. At pace 1 it is 26.3s, with 18.7s of margin.
//coop_uwPace is a LEVEL VAR and not a cvar - `set coop_uwPace 1.2` from the console does nothing;
//it is edited here or it is 1.
//
//WHAT MAKES IT READ AS SWIMMING, in order of how much it contributes:
//  * THE STROKE PULSE. Each of the six strokes does 62% of its own translation in its first 45%
//    and then coasts, pulses z up and back down, rolls toward the pulling side, and fires a small
//    per-player ViewJitter on the catch. That periodic surge-and-settle is the single strongest
//    "a body is doing this" cue available, and it costs nothing.
//  * REAL TRANSLATION, where there was exactly none. The plunge and tumble let the backwash carry
//    him 106 units seaward and 48 left; the struggle claws some of it back; the push takes the rest.
//    Measured over the whole submerged beat that is 243 units of camera path against the old zero.
//    It is not a long swim, and it does not need to be: an object 40 units off the track sweeps most
//    of the way across the frame in that distance, which is why the gear below is placed where it is.
//  * CLOSE PARALLAX, DELIBERATELY PLACED. His rifle is torn out of his hands on entry and sinks
//    past his face; his helmet comes off in the tumble; and one dropped Thompson is laid on the
//    sand beside the swim corridor. Three objects inside 110 units.
//
//THE YAW RAIL IS STILL THE MOST IMPORTANT LINE HERE, AND THE MARGIN AGAINST IT IS THE ONE THING THE
//FIRST CUT GOT WRONG. The drawn seabed stops dead at y -2816 and the skybox wall behind it starts at
//z -704, so a submerged camera looking seaward sees clouds under the sea. Facing the beach is yaw
//90, and every submerged pose goes through coop_uwPose, which clamps yaw to 74..106.
//
//BUT coop_uwPose CANNOT SEE THE CLIENT'S OWN CONTRIBUTION, and CG_ApplyShellShock is not roll-only.
//Read it (cg_view.c:684-686), all three axes:
//    vAngles[2] += sin(fT * 5.3) * 5.5 * fS        roll
//    vAngles[0] += sin(fT * 3.9 + 1.3) * 2.8 * fS  pitch
//    vAngles[1] += sin(fT * 2.9 + 2.1) * 1.6 * fS  YAW
//That runs on the client, after the camera angles arrive, so the server-side clamp is blind to it.
//At the severity this beat stuffs (2.4) the yaw term alone is +-3.84 degrees at full decay weight.
//The first cut of this table had a minimum server yaw of 77 against a 74 rail - three degrees - so
//the ON-SCREEN yaw reached about 74.5. Half a degree. The table below is pulled in to [82, 97]
//instead, which puts the worst on-screen yaw at 79.5 and 100.6: about 5.4 degrees of real margin on
//both sides, and the server-side clamp still never fires, so clampA==0 stays a meaningful test.
//The same budget was applied to roll (the plunge's -34 and the tumble's +41 both came in to +-28;
//measured on-screen peak 41.2 against the 46 comfort rail, where the first cut measured 47.2 and
//was therefore already outside it) and to pitch (server min -52 -> -48, on-screen -54.0 against the
//-62 rail). ALL THREE NUMBERS ARE MEASURED, by running the coded table at the 20Hz tick and adding
//CG_ApplyShellShock's own amplitude envelope at each frame - not reasoned from the peaks.
//
//THE ONE PLACE WITH LESS THAN A DEGREE OF MARGIN IS DELIBERATE AND UNCHANGED: the entry pose is
//pitch 52 against the 54 ceiling, because 52 is exactly what coop_rampFly ends on ( -30 + 82 - 0 )
//and the first frame of this beat MUST equal it or the handover snaps. It is one frame, at z -520,
//looking down at open water. The rail is server-side so it never fires there.
//
//AND THE SEAWARD DRIFT IS SAFE FOR THAT SEAM, checked rather than assumed. The seam is a line
//across x at y -2816. From anywhere shoreward of it every point on it lies at a bearing astern, so
//with yaw held at 90 +-16 and a half-FOV under 72 degrees it cannot enter frame at ANY y. The
//coded table bottoms out at wy-106 = y -2761, which is 55 units clear, and coop_uwPose's own y rail
//(wy-130 = -2785) bounds the worst case at 31 units clear.
//
//NEVER DWELL BETWEEN -534 AND -506 still holds - the water shader flaps while the CONTENTS boundary
//stays flat, so that band strobes. Simulated: the highest z reached anywhere between the plunge and
//the break is -540.3, six units clear, and it is a stroke peak that is already descending. The
//break crosses the whole band in about 0.19s.
//
//THE Z FLOOR IS -570, not the sand. Sand is at -576 and r_znear is 4 (renderergl2/tr_init.c:1916),
//so at the deepest key the near plane's lowest corner sits about 3 units clear of the floor even at
//cg_fov 120 - and every deep beat is looking UP anyway (negative pitch is up in this file: see
//coop_rampFly's own "thrown back at the sky" at pitch -59), so the near plane rises away from the
//sand rather than into it. coop_uwPose's floor stays at -572, two units below the deepest key, so
//it is a backstop rather than a value the choreography leans on.
//
//NO FADE ANYWHERE IN HERE, unchanged, for the same reason: a fadeout whose fadein is lost is the
//one softlock class in this set piece.
//
//SAFETY, and every path traced:
//  * A player who dies, spectates or disconnects mid-beat has his camera reaped by
//    coop_maintainBoatCameras (m3l1a.scr:8853-8862), which deletes it and restarts its own scan.
//    Every pose here re-reads $boatCamera through coop_rampPose, so his camera simply stops being
//    in the array. Nothing here holds a reference to a camera across a frame.
//  * A player who connects mid-beat gets a camera from coop_startBoatSpawnManager's
//    `level waittill playerspawn` and picks up the ABSOLUTE pose on his first frame. He also misses
//    the dizzy stuffs, which only ever makes his frame calmer than everyone else's.
//  * The only non-self-consuming client state set here is the suppression FLOOR, and it is set
//    exclusively through coop_rampSuppressAll so the handoff's existing coop_setSuppressionAll 0
//    and the watchdog both release it. dizziness, the lens splash and the ViewJitters all decay or
//    delete themselves on the client.
//  * Every entity spawned here is guarded for a NULL return and handed to coop_fxCleanup.
//  * level.coop_rampUnderOn 0 removes the whole beat exactly as before.
//
//THE PLAYER IS A PLAYER, NOT AN ACTOR, and this beat poses NOTHING on him. His body stays glued,
//hidden, notsolid and notarget in the boat for the whole beat, which is what makes it safe for
//eight people. The three things we CAN do to a player from here are all used: playlocalsound (a
//per-client CGM, player.cpp:18144, which resolves any alias and needs no channel), stufftext of a
//client cvar (coop_dizzy, coop_lensSplash, coop_suppHold), and earthquake_player, which spawns a
//ViewJitter that tracks his origin at radius 96 and therefore always covers him wherever his body
//is - unlike earthquake_radius, which measures from the player origin and would be centred on a
//point two hundred units from every body in the boat. The camera carries PMF_DAMAGE_ANGLES because
//coop_spawnBoatCamera sets `showquakes 1` (m3l1a.scr:8786 -> player.cpp:8124), so a ViewJitter is
//visible THROUGH the cinematic camera. That is the only reason the impact can be felt at all.
//
//WHAT WE CANNOT DO: there is no getter for a camera's own position, so nothing here reads one
//back; every pose is computed from the spawn origin and written absolutely. And a Camera must
//never be cut/started/followed/watched (rule 1 at the top of this file), so movetopos/turnto
//per frame remains the only legal driver.
//=========================================================================
coop_rampUnderwater:{
//=========================================================================
	//[user 2026-09-03] "set back to default once we hit the water" - this is that moment, and it
	//is stamped BEFORE the gate so the fog comes back even when the beat itself is switched off.
	//coop_rampFogLift owns the restore; this only tells it when. Restoring early is always safe,
	//restoring late is the failure, so it is the first statement in the label.
	level.coop_rampFogRestore = 1
	if(level.coop_rampUnderOn == NIL){ level.coop_rampUnderOn = 1 }
	if(!level.coop_rampUnderOn){ end }
	if(level.coop_uwPace == NIL){ level.coop_uwPace = 1.0 }
	if(level.coop_uwSound == NIL){ level.coop_uwSound = 1 }
	if(level.coop_uwGearOn == NIL){ level.coop_uwGearOn = 1 }
	//[user 2026-09-03] the surfacing breath. Defaulted HERE, beside the other beat switches, so the
	//one-shot block in BEAT 8 only ever tests it - a level var, never getcvar, which creates the
	//cvar empty and permanently defeats the engine default (bug-1669).
	if(level.coop_uwBreathOn == NIL){ level.coop_uwBreathOn = 1 }

	local.land = level.flags["coop_spawn1origin"]
	if(local.land == NIL){ end }
	local.wx = local.land[0]
	local.wy = local.land[1]

	//the rail, computed once and stored so coop_uwPose can enforce it without re-deriving. Set
	//BEFORE anything reads them - an unset level var reads as type none and poisons arithmetic.
	level.coop_uwYMin = local.wy - 130
	level.coop_uwYMax = local.wy + 20
	level.coop_uwXMin = local.wx - 170
	level.coop_uwXMax = local.wx + 60
	level.coop_uwZTop = 0 - 516			//the plunge starts ON the surface; tightened below
	level.coop_uwClampY = 0
	level.coop_uwClampZ = 0
	level.coop_uwClampA = 0

	//0.5..1.2, and the ceiling is the watchdog/mortality ordering, not taste. See the header.
	local.pace = level.coop_uwPace
	if(local.pace < 0.5){ local.pace = 0.5 }
	if(local.pace > 1.2){ local.pace = 1.2 }
	local.t00 = level.time
	println("^~^~^ RAMPUW start pace=" + local.pace + " at=" + local.wx + "," + local.wy)

	//[bug-2339] rounds coming into the water overhead, for as long as the head is under
	level.coop_waterBulletsOn = 1
	thread coop_waterBullets local.wx local.wy

	//[bug-2342] and the voices, from the same moment
	level.coop_memVoiceOn = 1
	thread coop_memoryVoices local.wx local.wy

	//[bug-2345] and the men who did not get up again. THE FIELD IS PUSHED 190 UNITS SEAWARD so it
	//actually straddles the swim corridor. coop_underwaterDead places bodies at param_y + 70 +
	//randomint 430, so at param_y = wy-190 the field runs wy-120 .. wy+439, and the corridor runs
	//wy-106 .. wy: there are dead both seaward of the deepest point and ahead of the finish, and the
	//camera passes through them. (The first cut used -60, which lands the field at wy+10 .. wy+439 -
	//every body still ahead of the camera, i.e. exactly the arrangement it claimed to fix.)
	//The pace goes with it so the corpses and blood clouds outlive the longer beat instead of
	//popping out mid-scene, and so the four scripted kills become six spread across the swim.
	level.coop_underDeadOn = 1
	thread coop_underwaterDead local.wx ( local.wy - 190 ) local.pace

	//[user 2026-09-03] and the floating head, which is the companion to the decapitated ranger on
	//the ramp. THIS LINE IS NOT OPTIONAL: coop_underwaterHead's only call site in the whole file is
	//here, so dropping it turns the label into dead code and the head silently never spawns again.
	//It takes the UNSHIFTED spawn point - it is deliberately placed close and in the +Y cone - plus
	//the pace, because its own drift loop is a fixed tick count that the longer beat outruns.
	thread coop_underwaterHead local.wx local.wy local.pace
	thread coop_underwaterWaders local.wx local.wy

	//The bed itself is 2D and per-client - what his ears hear, not an object in the world.
	waitthread coop_uwSay "coop_underwater_wash"

	//--- BEAT 1. THE PLUNGE, 0.55s. He goes under head first and is still tumbling from the throw,
	//so the roll that coop_rampFly left at 0 keeps going rather than stopping at the surface.
	//a0 is EXACTLY what coop_rampFly hands over ( (0-30) + 82 - 0 = pitch 52, yaw 90, roll 0 ), so
	//the first frame of this beat cannot snap.
	local.p0 = (0 0 0)
	local.p0[0] = local.wx
	local.p0[1] = local.wy
	local.p0[2] = 0 - 520
	local.a0 = (0 0 0)
	local.a0[0] = 52
	local.a0[1] = 90
	local.a0[2] = 0
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 11
	local.p1[1] = local.wy - 24
	local.p1[2] = 0 - 549
	local.a1 = (0 0 0)
	local.a1[0] = 22
	local.a1[1] = 86
	local.a1[2] = 0 - 28
	println("^~^~^ RAMPUW plunge")
	if(level.coop_uwGearOn){ thread coop_uwGear local.wx local.wy local.pace }
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 0.55 5
	level.coop_uwZTop = 0 - 536			//he is under. the envelope closes behind him.

	waitthread coop_rampSuppressAll 0.72
	waitthread coop_uwDizzy 2.4

	//--- BEAT 2. THE TUMBLE, 1.30s, in two legs so the roll can swing THROUGH a peak instead of
	//lerping to one. He turns over once, lazily, and ends pitched back at the light above him -
	//which is the shot that establishes how far under he is. Roll peaks at 28 rather than the 41
	//the first cut asked for, and the plunge's own end roll came back from -34 to -28 for the same
	//reason: the dizzy stuffed one line above is at FULL weight across the first frames of this leg
	//and adds +-13.2 degrees of client-side roll that no server clamp can see. Measured on-screen
	//peak is 41.2 against the 46 comfort rail; the first cut measured 47.2 - i.e. it was already
	//outside it - and 41 here would have put 54 on screen.
	local.p0 = local.p1
	local.a0 = local.a1
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 27
	local.p1[1] = local.wy - 62
	local.p1[2] = 0 - 561
	local.a1 = (0 0 0)
	local.a1[0] = 0 - 20
	local.a1[1] = 97
	local.a1[2] = 28
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 0.70 1

	local.p0 = local.p1
	local.a0 = local.a1
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 41
	local.p1[1] = local.wy - 92
	local.p1[2] = 0 - 568
	local.a1 = (0 0 0)
	local.a1[0] = 0 - 48
	local.a1[1] = 92
	local.a1[2] = 6
	println("^~^~^ RAMPUW tumble")
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 0.60 6

	//--- BEAT 3. THE BOTTOM, 0.26s. A hard stop, not a settle. The head is arrested by the sand,
	//so the pitch and roll SNAP rather than easing, and the jolt lands on the same frame.
	local.p0 = local.p1
	local.a0 = local.a1
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 46
	local.p1[1] = local.wy - 104
	local.p1[2] = 0 - 570
	local.a1 = (0 0 0)
	local.a1[0] = 0 - 37
	local.a1[1] = 88
	local.a1[2] = 19
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 0.26 6
	println("^~^~^ RAMPUW bottom")
	waitthread coop_uwJolt 0.55 1.9 "coop_uw_hitsand"
	waitthread coop_rampSuppressAll 0.88

	//--- BEAT 4. FACE IN THE SAND. The beat the old version had no equivalent of: he does not move.
	//Everything that is happening is happening TO him - the voices, the rounds coming in, the men
	//going down around him. Ending this beat is what makes the first push mean something.
	local.p0 = local.p1
	local.a0 = local.a1
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 48
	local.p1[1] = local.wy - 106
	local.p1[2] = 0 - 569
	local.a1 = (0 0 0)
	local.a1[0] = 0 - 44
	local.a1[1] = 84
	local.a1[2] = 24
	println("^~^~^ RAMPUW sand")
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 ( 1.55 * local.pace ) 4
	waitthread coop_rampSuppressAll 0.66

	//--- BEAT 5. THE STRUGGLE. Three attempts and the first two fail, because a struggle that
	//succeeds first time is not a struggle. Each is push - give - lie, and each push gains a little
	//more ground than the last so the failures still read as progress.
	//THE POSITION CHAIN IS PASSED IN, NOT DERIVED. An earlier cut had coop_uwTry compute its own
	//start from the peak it was given, which put attempt 2's first frame ten units from where
	//attempt 1's last frame left the camera - a one-frame snap, invisible in the numbers and very
	//visible on screen. Every leg in this beat now starts on the exact pose the previous leg ended.
	local.f0 = (0 0 0)
	local.f0[0] = local.wx - 48
	local.f0[1] = local.wy - 106
	local.f0[2] = 0 - 569
	local.f1 = (0 0 0)
	local.f1[0] = local.wx - 46
	local.f1[1] = local.wy - 102
	local.f1[2] = 0 - 557
	local.f2 = (0 0 0)
	local.f2[0] = local.wx - 47
	local.f2[1] = local.wy - 104
	local.f2[2] = 0 - 568
	waitthread coop_uwTry local.f0 local.f1 local.f2 local.pace 1

	local.f0 = local.f2
	local.f1 = (0 0 0)
	local.f1[0] = local.wx - 44
	local.f1[1] = local.wy - 90
	local.f1[2] = 0 - 550
	local.f2 = (0 0 0)
	local.f2[0] = local.wx - 45
	local.f2[1] = local.wy - 92
	local.f2[2] = 0 - 566
	waitthread coop_uwTry local.f0 local.f1 local.f2 local.pace 2

	//--- and he gets up. 1.50s of rise, then 0.90s on his knees swaying, and the pitch crosses zero
	//for the first time in the whole beat: he stops staring up at the light and levels off toward
	//the shore. a0 here is byte-identical to coop_uwTry's idx-2 rest pose, so nothing snaps.
	local.p0 = local.f2
	local.a0 = (0 0 0)
	local.a0[0] = 0 - 37
	local.a0[1] = 83
	local.a0[2] = 16
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 40
	local.p1[1] = local.wy - 72
	local.p1[2] = 0 - 545
	local.a1 = (0 0 0)
	local.a1[0] = 6
	local.a1[1] = 88
	local.a1[2] = 0 - 6
	waitthread coop_uwSay "coop_uw_strain"
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 ( 1.50 * local.pace ) 4

	local.p0 = local.p1
	local.a0 = local.a1
	local.p1 = (0 0 0)
	local.p1[0] = local.wx - 38
	local.p1[1] = local.wy - 66
	local.p1[2] = 0 - 543
	local.a1 = (0 0 0)
	local.a1[0] = 11
	local.a1[1] = 84
	local.a1[2] = 4
	println("^~^~^ RAMPUW up")
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 ( 0.90 * local.pace ) 4

	//the shock eases as he gets his bearings. This RESTARTS rather than being swallowed: the client
	//takes a new severity if it exceeds the live one OR 5000ms have passed since the last start
	//(cg_view.c:661-665), and by here it is about eleven seconds - so a LOWER value restarts cleanly
	//and gives the swim a gentler sway than the seabed had. It also re-arms the timer, which matters
	//at coop_uwPace above 1.1 where the original 24s window would otherwise run out mid-swim. At
	//severity 1.3 the client's yaw term is +-2.08 degrees, which is what the stroke yaw column below
	//is budgeted against.
	waitthread coop_uwDizzy 1.3
	waitthread coop_uwSay "coop_underwater_wash"
	waitthread coop_rampSuppressAll 0.58

	//--- BEAT 6. THE PUSH FOR SHORE. Six strokes, and every one of them is a body: 62% of its own
	//travel in the first 45% then a coast, a z pulse up and back, a roll toward the pulling side, and
	//a small jolt on the catch. The pulse amplitude DECAYS across the six - he is tiring - and the
	//pitch climbs from -2 to +13 so the surface is visibly coming down to meet him.
	//
	//The base line runs from (wx-38, wy-66) back to (wx, wy) - all 132 units of the drift, recovered
	//- so the beat ENDS exactly where the handoff will put his body. That is not decoration: the
	//handoff swaps camera for eye with no cut, so the two have to coincide.
	//
	//THE LAST TWO PULSES ARE 2, NOT 3, and their base z is one unit lower: the stroke pulse is the
	//only term that raises z, and strokes 5 and 6 are the closest the swim gets to the -534..-506
	//strobe band. As coded the highest z anywhere in the swim is -540.3.
	local.sx = local.wx - 38
	local.sy = local.wy - 66
	local.n = 0
	local.n++; local.bx[local.n] = local.wx - 32; local.by[local.n] = local.wy - 55; local.bz[local.n] = ( 0 - 548 ); local.pp[local.n] = ( 0 - 2 ); local.yy[local.n] = 84; local.rr[local.n] = 9;         local.zz[local.n] = 5
	local.n++; local.bx[local.n] = local.wx - 26; local.by[local.n] = local.wy - 45; local.bz[local.n] = ( 0 - 546 ); local.pp[local.n] = 1;         local.yy[local.n] = 88; local.rr[local.n] = ( 0 - 8 ); local.zz[local.n] = 5
	local.n++; local.bx[local.n] = local.wx - 20; local.by[local.n] = local.wy - 34; local.bz[local.n] = ( 0 - 545 ); local.pp[local.n] = 4;         local.yy[local.n] = 85; local.rr[local.n] = 7;         local.zz[local.n] = 4
	local.n++; local.bx[local.n] = local.wx - 14; local.by[local.n] = local.wy - 24; local.bz[local.n] = ( 0 - 544 ); local.pp[local.n] = 7;         local.yy[local.n] = 90; local.rr[local.n] = ( 0 - 6 ); local.zz[local.n] = 4
	local.n++; local.bx[local.n] = local.wx - 7;  local.by[local.n] = local.wy - 13; local.bz[local.n] = ( 0 - 543 ); local.pp[local.n] = 10;        local.yy[local.n] = 85; local.rr[local.n] = 5;         local.zz[local.n] = 2
	local.n++; local.bx[local.n] = local.wx;      local.by[local.n] = local.wy;      local.bz[local.n] = ( 0 - 542 ); local.pp[local.n] = 13;        local.yy[local.n] = 90; local.rr[local.n] = ( 0 - 5 ); local.zz[local.n] = 2

	local.cz = 0 - 543			//exactly where 'up' ended - stroke 1 lerps DOWN to -548, so the
							//push-off dip is a move rather than a five-unit pop
	local.cp = 11
	local.cy = 84
	local.cr = 4
	local.i = 1
	while(local.i <= local.n){
		local.p0 = (0 0 0)
		local.p0[0] = local.sx
		local.p0[1] = local.sy
		local.p0[2] = local.cz
		local.a0 = (0 0 0)
		local.a0[0] = local.cp
		local.a0[1] = local.cy
		local.a0[2] = local.cr
		local.p1 = (0 0 0)
		local.p1[0] = local.bx[local.i]
		local.p1[1] = local.by[local.i]
		local.p1[2] = local.bz[local.i]
		local.a1 = (0 0 0)
		local.a1[0] = local.pp[local.i]
		local.a1[1] = local.yy[local.i]
		local.a1[2] = local.rr[local.i]
		local.pu = (0 0 0)
		local.pu[0] = local.zz[local.i]
		local.pu[1] = local.rr[local.i]
		local.pu[2] = 5

		println("^~^~^ RAMPUW stroke " + local.i + " of " + local.n)
		thread coop_uwJolt 0.22 0.55 "coop_uw_strain"
		waitthread coop_uwStroke local.p0 local.p1 local.a0 local.a1 local.pu ( 1.72 * local.pace )

		local.sx = local.bx[local.i]
		local.sy = local.by[local.i]
		local.cz = local.bz[local.i]
		local.cp = local.pp[local.i]
		local.cy = local.yy[local.i]
		local.cr = local.rr[local.i]
		local.i++
	}

	//--- BEAT 7. THE GATHER, 1.25s. He plants his feet and coils: z DIPS seven units, the pitch
	//swings up to +26 so the surface fills the frame, the roll settles to dead level. This is the
	//wind-up that makes the break an action instead of a float, and it keeps the camera well clear
	//of the -534..-506 strobe band right up to the moment it crosses it decisively.
	local.p0 = (0 0 0)
	local.p0[0] = local.wx
	local.p0[1] = local.wy
	local.p0[2] = 0 - 542
	local.a0 = (0 0 0)
	local.a0[0] = 13
	local.a0[1] = 90
	local.a0[2] = 0 - 5
	local.p1 = (0 0 0)
	local.p1[0] = local.wx
	local.p1[1] = local.wy
	local.p1[2] = 0 - 549
	local.a1 = (0 0 0)
	local.a1[0] = 26
	local.a1[1] = 90
	local.a1[2] = 0
	println("^~^~^ RAMPUW gather")
	waitthread coop_uwSay "coop_uw_strain"
	waitthread coop_rampSuppressAll 0.80
	waitthread coop_uwLeg local.p0 local.a0 local.p1 local.a1 ( 1.25 * local.pace ) 5

	//--- BEAT 8. THE BREAK, 0.55s. Straight up through the surface. This is the ONE beat that does
	//NOT go through coop_uwPose: it deliberately leaves the submerged z rail, and it must land on
	//exactly the pose the handoff expects - pitch 0, yaw 90, roll 0, z -488 - so handing the view
	//back swaps one for the other invisibly. The endpoint is byte-identical to what shipped; only
	//the OPENING pitch changed, from -26 to +26, because a man who has spent a second coiled under
	//the surface is looking at it, not away from it.
	println("^~^~^ RAMPUW break")
	local.broke = 0
	local.t0 = level.time
	while(1){
		local.f = ( level.time - local.t0 ) / 0.55
		if(local.f > 1){ local.f = 1 }
		local.pos = (0 0 0)
		local.pos[0] = local.wx
		local.pos[1] = local.wy
		if(local.f < 0.545){
			local.u = local.f / 0.545
			local.pos[2] = ( 0 - 549 ) + ( 44 * local.u )
			waitthread coop_rampPose local.pos ( 26 - ( 12 * local.u ) ) 90 0
		}else{
			local.u = ( local.f - 0.545 ) / 0.455
			local.pos[2] = ( 0 - 505 ) + ( 17 * local.u )
			waitthread coop_rampPose local.pos ( 14 - ( 14 * local.u ) ) 90 0
		}
		if(local.broke == 0 && local.pos[2] >= ( 0 - 514 )){
			local.broke = 1
			level.coop_waterBulletsOn = 0		//[bug-2339] head is up - stop the rounds coming in
			level.coop_memVoiceOn = 0		//[bug-2342] and the voices go with the water
			level.coop_underDeadOn = 0		//[bug-2345] stop killing men in the water
			level.coop_underHeadOn = 0		//[user 2026-09-03] and the head stops drifting
			waitthread coop_rampSuppressAll 0.42
			//[user 2026-09-03] HE BREAKS THE SURFACE AND BREATHES. The call site was already here
			//and the alias was not, so this line has been a silent no-op since the beat shipped -
			//see coop_audio.scr::coop_uw_break, which is a copy of the ADS breath-hold exhale the
			//user asked for by name. It deliberately takes CHAN_LOCAL from the underwater wash on
			//the same entity, so the bed CUTS on this frame rather than bleeding ~1.5s past the
			//surface, which is what should have been happening anyway.
			if(level.coop_uwBreathOn){
				println("^~^~^ RAMPUW gasp")
				waitthread coop_uwSay "coop_uw_break"
			}
			//the lens splash decays over 3.6s, so beads carry across the handoff into the first
			//seconds of play - which is exactly the look wanted
			local.i = 1
			while(local.i <= $player.size){
				if($player[local.i] != NULL && $player[local.i] != NIL){
					if($player[local.i].health > 0){ $player[local.i] stufftext "coop_lensSplash 0.95" }
				}
				local.i++
			}
		}
		if(local.f >= 1){ break }
		waitframe
	}

	//THE RAIL IS REPORTED, NOT ASSUMED. If any of these is non-zero a beat asked for a pose outside
	//the safe envelope and was silently corrected - which is a defect to fix, not a success.
	println("^~^~^ RAMPUW done t=" + ( level.time - local.t00 ) + " clampXY=" + level.coop_uwClampY + " clampZ=" + level.coop_uwClampZ + " clampA=" + level.coop_uwClampA)
}end


//ONE EASED LEG, from one pose to another. Every beat above is one or more of these, which is what
//makes the choreography readable as a table instead of ten near-identical while loops.
//  ease 1 linear   2 ease-in quad   3 ease-out cubic   4 smoothstep   5 ease-in cubic   6 ease-out quad
//=========================================================================
coop_uwLeg local.p0 local.a0 local.p1 local.a1 local.dur local.ease:{
//=========================================================================
	if(local.dur == NIL || local.dur <= 0){ local.dur = 0.05 }
	local.t0 = level.time
	while(1){
		local.f = ( level.time - local.t0 ) / local.dur
		if(local.f > 1){ local.f = 1 }
		local.u = local.f
		if(local.ease == 2){ local.u = local.f * local.f }
		if(local.ease == 3){ local.v = 1 - local.f; local.u = 1 - ( local.v * local.v * local.v ) }
		if(local.ease == 4){ local.u = local.f * local.f * ( 3 - ( 2 * local.f ) ) }
		if(local.ease == 5){ local.u = local.f * local.f * local.f }
		if(local.ease == 6){ local.v = 1 - local.f; local.u = 1 - ( local.v * local.v ) }
		local.pos = local.p0 + ( ( local.p1 - local.p0 ) * local.u )
		local.ang = local.a0 + ( ( local.a1 - local.a0 ) * local.u )
		waitthread coop_uwPose local.pos local.ang
		if(local.f >= 1){ break }
		waitframe
	}
}end


//ONE SWIM STROKE, and this is the thing the old beat had none of.
//
//A spline has no body. A stroke has four signatures and all four are here:
//  SURGE      62% of the stroke's translation happens in its first 45%, then it coasts. That is
//             what a pull-and-glide is, and it is the difference between drifting and swimming.
//  PULSE      z rises and returns on a half-sine over the stroke - the body rides up on the pull
//             and settles on the recovery. `sin` takes DEGREES here (scriptthread.cpp:107, DEG2RAD
//             at :2689) and is already used nine times in this same file, so the call form is proven.
//  ROLL       swings toward the pulling side and back on the same half-sine, sign taken from the
//             stroke's own end roll so consecutive strokes alternate arms.
//  YAW WANDER a few degrees, so the head is not welded to the direction of travel.
//
//THE PULSE IS ONE-SIDED, AND THAT IS LOAD-BEARING, NOT A BUG. sin(f * 180) is non-negative for f in
//[0,1], so z only ever rises, roll only ever moves toward sign(rr), and yaw only ever rises. That
//one-sidedness is exactly why the swim's minimum yaw is its own table minimum (84) and its maximum
//z is computable in closed form - both of which the margin analysis in the header depends on. Do
//not "fix" it to a full sine without redoing that analysis.
//local.puls is ( zAmplitude rollPeak yawAmplitude ).
//=========================================================================
coop_uwStroke local.p0 local.p1 local.a0 local.a1 local.puls local.dur:{
//=========================================================================
	if(local.dur == NIL || local.dur <= 0){ local.dur = 0.05 }
	local.t0 = level.time
	while(1){
		local.f = ( level.time - local.t0 ) / local.dur
		if(local.f > 1){ local.f = 1 }

		//--- the surge
		if(local.f < 0.45){
			local.g = local.f / 0.45
			local.s = 0.62 * ( local.g * ( 2 - local.g ) )
		}else{
			local.g = ( local.f - 0.45 ) / 0.55
			local.s = 0.62 + ( 0.38 * ( local.g * local.g * ( 3 - ( 2 * local.g ) ) ) )
		}

		//--- the half-sine that the pulse, the roll and the wander all ride
		local.ph = local.f * 180
		local.h = sin(local.ph)

		local.pos = local.p0 + ( ( local.p1 - local.p0 ) * local.s )
		local.pos[2] = local.pos[2] + ( local.puls[0] * local.h )

		local.ang = (0 0 0)
		local.ang[0] = local.a0[0] + ( ( local.a1[0] - local.a0[0] ) * local.s )
		local.ang[1] = local.a0[1] + ( ( local.a1[1] - local.a0[1] ) * local.s ) + ( local.puls[2] * local.h )
		local.ang[2] = local.a0[2] + ( ( local.a1[2] - local.a0[2] ) * local.s ) + ( local.puls[1] * local.h * 0.5 )

		waitthread coop_uwPose local.pos local.ang
		if(local.f >= 1){ break }
		waitframe
	}
}end


//ONE FAILED ATTEMPT TO GET UP: push, the arm gives, lie there. Both failures are the same shape, so
//they are the same code with different numbers - which is also why the second can be made visibly
//harder than the first without duplicating thirty lines.
//=========================================================================
coop_uwTry local.pfrom local.ppeak local.prest local.pace local.idx:{
//=========================================================================
	//the angle chain is keyed on idx and is checked against its neighbours the same way the
	//positions are: try 1 opens on the pose BEAT 4 ended at, try 2 opens on the pose try 1 ended
	//at, and the rise after them opens on the pose try 2 ended at. Every yaw here sits inside
	//[82, 89] - see the yaw budget in the header; the first cut used 77 and 79 and had half a
	//degree of on-screen margin against the 74 rail once the client's own shell-shock yaw landed.
	local.a0 = (0 0 0)
	local.a1 = (0 0 0)
	local.a2 = (0 0 0)
	if(local.idx == 2){
		local.a0[0] = 0 - 45; local.a0[1] = 82; local.a0[2] = 25
		local.a1[0] = 0 - 6;  local.a1[1] = 89; local.a1[2] = 0 - 11
		local.a2[0] = 0 - 34; local.a2[1] = 84; local.a2[2] = 14
		local.d0 = 0.62; local.d1 = 0.40; local.d2 = 0.68
		local.ar = (0 0 0)
		local.ar[0] = 0 - 37; local.ar[1] = 83; local.ar[2] = 16
	}else{
		local.a0[0] = 0 - 44; local.a0[1] = 84; local.a0[2] = 24
		local.a1[0] = 0 - 14; local.a1[1] = 87; local.a1[2] = 8
		local.a2[0] = 0 - 41; local.a2[1] = 83; local.a2[2] = 27
		local.d0 = 0.55; local.d1 = 0.34; local.d2 = 0.62
		local.ar = (0 0 0)
		local.ar[0] = 0 - 45; local.ar[1] = 82; local.ar[2] = 25
	}

	//--- the push. ease-OUT, because he is straining and slowing, not accelerating.
	waitthread coop_uwSay "coop_uw_strain"
	waitthread coop_uwLeg local.pfrom local.a0 local.ppeak local.a1 ( local.d0 * local.pace ) 3

	//--- and it gives. ease-IN, so it lets go slowly and then drops - which is what an arm folding
	//under a man's own weight plus sixty pounds of soaked webbing actually does. It overshoots one
	//unit past where he will settle, so the landing has a small recoil instead of stopping dead.
	local.pc = local.prest
	local.pc[2] = local.pc[2] - 1
	waitthread coop_uwLeg local.ppeak local.a1 local.pc local.a2 ( local.d1 * local.pace ) 5
	waitthread coop_uwJolt ( local.d1 * local.pace ) ( 1.2 + ( 0.3 * local.idx ) ) "coop_uw_hitsand"

	//--- and he lies there. The dead beat after a failure is what makes the next attempt cost
	//something; without it two pushes in a row read as a bounce.
	waitthread coop_uwLeg local.pc local.a2 local.prest local.ar ( local.d2 * local.pace ) 4
	println("^~^~^ RAMPUW try" + local.idx + " failed")
}end


//THE ONE FUNNEL, AND THE ONE GUARD. Every submerged pose in this rewrite goes through here, so the
//yaw rail, the z envelope and the pitch limit are enforced in ONE place and a beat added later
//cannot quietly miss them - which is this project's recurring failure mode. Clamp hits are COUNTED
//rather than silently corrected, and the count is printed at the end of the beat.
//
//WHAT THIS GUARD CANNOT SEE, and the reason the beat table sits well inside it rather than against
//it: CG_ApplyShellShock (cg_view.c:684-686) adds sin terms to ALL THREE angles on the CLIENT, after
//these values arrive - roll 5.5*sev, pitch 2.8*sev, yaw 1.6*sev, each decaying over
//coop_dizzyTime*sev seconds. At the 2.4 this beat stuffs that is up to +-13.2 roll, +-6.7 pitch and
//+-3.84 yaw of on-screen motion that no server-side clamp can reach. The table is budgeted against
//it; the rails below are the backstop for a coding error, not for the shell shock.
//
//THE NUMBERS, and where each comes from:
//  yaw   74..106     the seam astern (drawn seabed rows stop at y -2816, skybox wall from z -704).
//                    90 is the beach facing and the spawn facing. This is the safety rail. The table
//                    is held to [82, 97] so that even the worst client yaw term lands inside it.
//  z     -572..coop_uwZTop  sand is at -576 and r_znear is 4, so -572 keeps the near plane out of it
//                    at any pitch and any cg_fov; the deepest key is -570, two units above the rail.
//                    The CEILING is a level var rather than a constant because exactly two beats
//                    legitimately leave the submerged envelope - the plunge coming in and the break
//                    going out - and both must cross the -534..-506 strobe band (deformvertexes
//                    flap) decisively rather than be clamped into it. Each of those two sets the
//                    ceiling explicitly and hands it back, so a clampZ count above zero still means
//                    a real violation by some other beat.
//  pitch -62..54     54 is exactly the pitch coop_rampFly hands over at (it ends on 52), so the
//                    ceiling can never clip the first frame; -62 leaves eight degrees under the
//                    deepest look-up in the table once the client's own pitch term is counted.
//  roll  -46..46     past that it is a barrel roll on eight non-consenting people. Note the arc that
//                    precedes this beat legitimately rolls to -120, so this is a comfort ceiling for
//                    the SUBMERGED beat and not an engine limit.
//  x,y   the drift box around the spawn point, so no beat can walk the camera off the drawn seabed.
//=========================================================================
coop_uwPose local.pos local.ang:{
//=========================================================================
	local.p = local.pos
	local.a = local.ang

	if(local.p[0] < level.coop_uwXMin){ local.p[0] = level.coop_uwXMin; level.coop_uwClampY++ }
	if(local.p[0] > level.coop_uwXMax){ local.p[0] = level.coop_uwXMax; level.coop_uwClampY++ }
	if(local.p[1] < level.coop_uwYMin){ local.p[1] = level.coop_uwYMin; level.coop_uwClampY++ }
	if(local.p[1] > level.coop_uwYMax){ local.p[1] = level.coop_uwYMax; level.coop_uwClampY++ }
	if(local.p[2] < ( 0 - 572 )){ local.p[2] = 0 - 572; level.coop_uwClampZ++ }
	if(local.p[2] > level.coop_uwZTop){ local.p[2] = level.coop_uwZTop; level.coop_uwClampZ++ }

	if(local.a[1] < 74){ local.a[1] = 74; level.coop_uwClampA++ }
	if(local.a[1] > 106){ local.a[1] = 106; level.coop_uwClampA++ }
	if(local.a[0] < ( 0 - 62 )){ local.a[0] = 0 - 62; level.coop_uwClampA++ }
	if(local.a[0] > 54){ local.a[0] = 54; level.coop_uwClampA++ }
	if(local.a[2] < ( 0 - 46 )){ local.a[2] = 0 - 46; level.coop_uwClampA++ }
	if(local.a[2] > 46){ local.a[2] = 46; level.coop_uwClampA++ }

	waitthread coop_rampPose local.p local.a[0] local.a[1] local.a[2]
}end


//A PER-PLAYER JOLT. earthquake_player, NOT earthquake_radius: the radius version measures from the
//player's ORIGIN and every body is still glued in the boat two hundred units from the camera, so a
//jitter placed at the camera would have covered nobody. earthquake_player tracks the player's own
//origin at radius 96, so it always lands (coop_mod/main.scr:1914).
//
//It reaches the cinematic camera because coop_spawnBoatCamera sets `showquakes 1`
//(m3l1a.scr:8786), which sets PMF_DAMAGE_ANGLES (player.cpp:8124), and cg_view.c:5887 subtracts
//damage_angles INSIDE the PMF_CAMERA_VIEW branch. Without that flag none of these would be felt.
//
//Self-consuming: the ViewJitter carries donedeath and is deleted by its own thread, so a jolt
//cannot be stranded by a death or a disconnect. Both arguments are float literals at every call
//site, which matters: earthquake_player's first act is `local.magnitude / local.duration`, and
//int/int is C integer division in this language (scriptvariable.cpp:1671-1679).
//=========================================================================
coop_uwJolt local.dur local.mag local.alias:{
//=========================================================================
	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL){
			if(local.pl.health > 0 && local.pl.dmteam != "spectator"){
				local.pl thread coop_mod/main.scr::earthquake_player local.dur local.mag
				if(level.coop_uwSound == 1 && local.alias != NIL && local.alias != ""){
					local.pl playlocalsound local.alias
				}
			}
		}
		local.i++
	}
}end


//ONE 2D LINE IN EVERY PLAYER'S EAR, PLAYED EXACTLY ONCE.
//
//[user 2026-09-03] TWO THINGS THIS USED TO GET WRONG, both measured rather than argued.
//
//1. THE ALIAS VOLUME NEVER LEFT THE SERVER. Player::PlayLocalSound ends at
//   `gi.Sound(&edict->s.origin, entnum, CHAN_LOCAL, found, 1.0f, ...)` - player.cpp:18190 - and that
//   1.0f is a literal. The #ifdef OPM_FEATURES branch above it that would have sent alias->volume is
//   DEAD: OPM_FEATURES appears at twenty #ifdef sites in this tree and is defined at none of them,
//   nor in CMake. SV_ClientSound stores the 1.0 (sv_snd.c:56), CG_ProcessSound hands it to
//   S_StartSound unchanged (cg_sound.cpp:31-42), and S_OPENAL_Start2DSound only substitutes when
//   fVolume < 0 (:1826-1828). So coop_underwater_wash's 1.0 and coop_shellshock_uw's 1.7 were the
//   same sound, and the user correctly heard the bed sitting level with the blast instead of over
//   it. `playsound` with one argument reaches Entity::Sound with argstype 0 (ProcessSoundEvent,
//   entity.cpp:3405), and argstype 0 takes volume, pitch, dist AND channel from the alias
//   (entity.cpp:3751-3757) - so the numbers in coop_audio.scr finally mean something.
//   It is equally safe: a missing alias is a DPrintf and a return (entity.cpp:3835), so it cannot
//   throw and cannot kill this thread, and coop_uw_strain / coop_uw_hitsand stay harmlessly
//   unaliased exactly as before. It also gains a probe playlocalsound never had - `coop_covtrace 1`
//   prints ^~^~^ COV SND / COV SNDMISS per play from inside Entity::Sound.
//   Same idiom, already working, with a variable alias: coop_memoryVoices below, and
//   coop_mod/xp.scr:1671.
//
//2. `break` - IT PLAYED ONCE PER PLAYER AND EVERY COPY WENT TO EVERYONE. playlocalsound is NOT
//   per-client in this build: it reaches SV_Sound, which loops every CS_ACTIVE client with no cull
//   (sv_snd.c:69-84), and CHAN_LOCAL then renders 2D pinned to the listener with no attenuation
//   (CHANNEL_FLAG_LOCAL_LISTENER, snd_openal_new.cpp:1835 / 2939). The per-player loop therefore
//   handed every client N coherent copies of the same wav on N different entnums - which do not
//   collide in PickChannelBase - i.e. +6 dB at two players, +12 at four, +18 at eight. The
//   health/spectator filter never bought the privacy it looks like it buys: if ONE player qualifies,
//   EVERYONE hears it. One play is the whole fix, and it is load-bearing rather than tidying -
//   coop_uw_break is aliased at 1.2, and four unbroken copies sum to 4.8 linear and hard-clip.
//   Nothing is lost by sharing it: coop_rampPose drives the shared $boatCamera array, so every
//   player is riding one camera and breaks the surface on the same frame. One copy each is not a
//   compromise here, it is the correct rendering of a shared cinematic.
//
//THE ENTITY MATTERS, because CHANNEL COLLISION IS DELIBERATE HERE. Every call lands on the same
//first-live-player entnum on CHAN_LOCAL, and S_OPENAL_PickChannelBase end_sample()s a live channel
//when iEntNum AND iEntChannel both match (:1663-1668). That is why the second wash restarts the
//first cleanly, and why coop_uw_break CUTS THE BED at the surface instead of playing over it. It is
//conditional on that entnum being the same one the wash used: if player 1 dies or spectates between
//the "up" beat and the break, the gasp lands on a different entnum and the bed bleeds ~1.5s past
//the surface instead of cutting. Audible only as a slightly soft handover, never as an error.
//=========================================================================
coop_uwSay local.alias:{
//=========================================================================
	if(level.coop_uwSound != 1){ end }
	if(local.alias == NIL || local.alias == ""){ end }
	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL){
			if(local.pl.health > 0 && local.pl.dmteam != "spectator"){
				local.pl playsound local.alias
				break			//ONE play, not one per player - see the header. Removing this
							//line restores an N-fold coherent stack and clips coop_uw_break.
			}
		}
		local.i++
	}
}end


//RESTART THE SHELL-SHOCK SWAY. Consumed-and-cleared on the client, and it only restarts if the new
//severity EXCEEDS the live one OR 5000ms have passed since the last start (cg_view.c:661-665) - so
//this is a no-op if fired too soon after a bigger one, and the two call sites here are eleven
//seconds apart on purpose.
//=========================================================================
coop_uwDizzy local.sev:{
//=========================================================================
	local.i = 1
	while(local.i <= $player.size){
		local.pl = $player[local.i]
		if(local.pl != NULL && local.pl != NIL){
			if(local.pl.health > 0 && local.pl.dmteam != "spectator"){
				local.pl stufftext ("set coop_dizzy " + local.sev)
			}
		}
		local.i++
	}
}end


//HIS GEAR, GOING DOWN WITHOUT HIM. Three entities, and they are the cheapest cinematic in this whole
//set piece: at 132 units of translation an object 40 units off the track sweeps most of the way
//across the frame, so these do more for the sense of movement than another ten seconds of camera
//would.
//
//models/static/ ONLY. models/equipment/ushelmet.tik is an ATTACHMENT model authored around a head
//bone, so it spawns, returns a valid entity, guards clean and renders NOWHERE - bug-2375, which cost
//a whole placement pass. static_ushelmet_private / static_m1_garand / static_thompsonsmg are the
//ground-prop versions, and THIS FILE ALREADY SPAWNS ALL THREE (coopified.scr:7450-7456), so nothing
//new is precached. Do NOT repeat the claim that the BSP itself places these three: it does not -
//LUMP_STATICMODELDEF carries static_us-helmet_29th / _engineer01 / _captain / _medic / _sergeant /
//_29th-net and none of these names. The conclusion holds; the stated reason did not.
//
//ORIGIN-STEPPED, never moveto: move and moveto silently no-op on a script_model.
//=========================================================================
coop_uwGear local.wx local.wy local.pace:{
//=========================================================================
	//24 * pace: this thread starts at the top of the beat and the handoff is at 21.9s at pace 1, so
	//the props expire about two seconds into play - long enough that nothing pops out mid-scene,
	//short enough that three of them are not left lying in the surf. It scales with the pace for the
	//same reason coop_underwaterDead's lifetimes now do.
	local.life = 24 * local.pace
	local.made = 0

	//--- the rifle, torn out of his hands as he goes in. It enters just below the surface and to his
	//left, sinks past the camera and comes to rest on the sand near where he lands.
	local.rx = local.wx - 24
	local.ry = local.wy - 18
	local.rf = spawn script_model model "models/static/static_m1_garand.tik"
	if(local.rf != NULL && local.rf != NIL){			//entity-pool guard
		local.rp = (0 0 0)
		local.rp[0] = local.rx
		local.rp[1] = local.ry
		local.rp[2] = 0 - 526
		local.rf.origin = local.rp
		local.rf notsolid
		local.made++
		thread coop_uwSink local.rf local.rx local.ry ( 0 - 526 ) ( 0 - 574 ) 2.6 62 local.life
	}

	//--- the helmet, off in the tumble. Slower, because a helmet holds air.
	wait 0.7
	local.hx = local.wx - 6
	local.hy = local.wy - 40
	local.hm = spawn script_model model "models/static/static_ushelmet_private.tik"
	if(local.hm != NULL && local.hm != NIL){			//entity-pool guard
		local.hp = (0 0 0)
		local.hp[0] = local.hx
		local.hp[1] = local.hy
		local.hp[2] = 0 - 534
		local.hm.origin = local.hp
		local.hm notsolid
		local.made++
		thread coop_uwSink local.hm local.hx local.hy ( 0 - 534 ) ( 0 - 573 ) 4.2 210 local.life
	}

	//--- and one Thompson already on the sand, laid deliberately BESIDE the swim corridor rather
	//than in it: the camera passes within about forty units of it during strokes three and four,
	//which is what turns a slow push into visible travel.
	local.tp = spawn script_model model "models/static/static_thompsonsmg.tik"
	if(local.tp != NULL && local.tp != NIL){			//entity-pool guard
		local.tq = (0 0 0)
		local.tq[0] = local.wx + 12
		local.tq[1] = local.wy - 44
		local.tq[2] = 0 - 574
		local.tp.origin = local.tq
		local.tp notsolid
		local.ta = (0 0 0)
		local.ta[0] = 0
		local.ta[1] = 214
		local.ta[2] = 90
		local.tp.angles = local.ta
		thread coop_fxCleanup local.tp local.life
		local.made++
	}
	println("^~^~^ RAMPUW gear placed=" + local.made)
}end

//One piece of kit sinking and turning over on the way down. Ease-OUT on the descent because a heavy
//object in water decelerates rather than accelerating, and a slow tumble on the yaw so it is not a
//rigid board dropping.
//=========================================================================
coop_uwSink local.ent local.x local.y local.z0 local.z1 local.dur local.spin local.life:{
//=========================================================================
	if(local.ent == NULL || local.ent == NIL){ end }
	thread coop_fxCleanup local.ent local.life
	local.y0 = randomint 360
	local.t0 = level.time
	while(1){
		if(local.ent == NULL || local.ent == NIL){ end }
		local.f = ( level.time - local.t0 ) / local.dur
		if(local.f > 1){ local.f = 1 }
		local.v = 1 - local.f
		local.u = 1 - ( local.v * local.v * local.v )
		local.p = (0 0 0)
		local.p[0] = local.x
		local.p[1] = local.y
		local.p[2] = local.z0 + ( ( local.z1 - local.z0 ) * local.u )
		local.ent.origin = local.p
		local.a = (0 0 0)
		local.a[0] = 62 * local.u
		local.a[1] = local.y0 + ( local.spin * local.u )
		local.a[2] = 90 * local.u
		local.ent.angles = local.a
		if(local.f >= 1){ break }
		waitframe
	}
	//and it comes to rest FLAT, the way retail lays its own props (angles (3 180 0)), not on edge
	if(local.ent != NULL && local.ent != NIL){
		local.a = (0 0 0)
		local.a[0] = 3
		local.a[1] = local.y0 + local.spin
		local.a[2] = 90
		local.ent.angles = local.a
	}
}end


//=========================================================================
//[user 2026-09-02, bug-2342] VOICES FROM THE PAST.
//
//"during the water sequence I'd like to also hear 'voices from the past' in our ear at random
//directions and distances, ideally with reverb and chaotic effects... the voice lines should be
//mission specific.. voices of griffin talking from prior missions, any other characters who have
//talked to us."
//
//WHICH VOICES. Fifteen lines, built from the FRIENDLY dialogue this install actually has - `dfr_`
//prefixed, not `den_`, which is the German pool and would have put enemy voices in a man's head at
//the worst possible moment. Three are from earlier missions and twelve are the boat and beach lines
//from this one: the briefing he was listening to ninety seconds ago. That weighting is deliberate.
//The install carries only a handful of prior-mission friendly lines, and the boat lines hit harder
//anyway - a memory from ten minutes ago is sharper than one from a month ago.
//
//WHERE THEY COME FROM. Each line spawns its own emitter at a random bearing and a random 130-620
//units, at a random height around the camera, and plays 3D. The alias mindist is 140, so one that
//lands close is nearly in the ear and one that lands far is a murmur across the water - which is the
//"random directions and distances" asked for, done with position rather than with volume.
//
//THE REVERB AND THE CHAOS ARE IN THE SAMPLES, not the engine. Reverb here is a property of a trigger
//volume (fgame/trigger.cpp:2642) with no script command behind it, so each line was pre-rendered
//slowed to 0.92, low-passed to 1.1kHz, run through two echo stages and a slow tremolo. That is exact,
//costs nothing at runtime, and cannot leak a reverb setting into the rest of the map.
//
//OVERLAPPING ON PURPOSE. The gap between lines is shorter than the lines are, so two and sometimes
//three are talking at once. One voice at a time would read as a radio; several at once reads as a
//head that is not working properly.
//=========================================================================
coop_memoryVoices local.wx local.wy:{
//=========================================================================
	if(level.coop_memVoiceOn != 1){ end }

	local.n = 6
	wait 1.4					//let the plunge land first - the voices start once he is under

	local.said = 0
	while(level.coop_memVoiceOn == 1 && local.said < 30){
		//--- a random offset in a box around him, and a random height. A box rather than a bearing
		//and a radius on purpose: `cos`/`sin` exist (scriptthread.cpp:98,107) but their calling
		//convention is one more thing that has to be right, and an unknown or mis-called command is
		//a COMPILE error that takes down this entire file - which is exactly how Omaha shipped with
		//no coop script at all in bug-2335. Two randomint draws need nothing new to be true, and
		//"somewhere in a 1200-unit box around your head" is indistinguishable from a bearing here.
		local.p = (0 0 0)
		local.p[0] = local.wx + ( 0 - 600 ) + ( randomint 1200 )
		local.p[1] = local.wy + ( 0 - 600 ) + ( randomint 1200 )
		local.p[2] = ( 0 - 560 ) + ( randomint 46 )

		local.e = spawn script_model model "models/fx/dummy.tik"
		if(local.e != NULL && local.e != NIL){			//entity-pool guard
			local.e.origin = local.p
			local.e notsolid
			//[user 2026-09-02] "I dont think the flashback voices should include anything besides
			//lines from main characters" - which cuts the pool to the SIX scripted lines the install
			//ships for the missions before Omaha (the generic pools are squad chatter any rifleman
			//says, and there is no briefing audio in any pak: War Chest's briefings are pre-rendered
			//video with the sound baked in). Six is enough for a twelve-second hold, but only if the
			//same voice does not come back twice running - so never repeat the last one.
			local.idx = ( randomint local.n ) + 1
			if(local.n > 1){
				local.guard = 0
				while(local.idx == local.lastv && local.guard < 6){
					local.idx = ( randomint local.n ) + 1
					local.guard++
				}
			}
			local.lastv = local.idx
			if(local.idx < 10){ local.a = "coop_memvoice0" + local.idx }
			else{ local.a = "coop_memvoice" + local.idx }
			local.e playsound local.a
			thread coop_fxCleanup local.e 9
			local.said++
		}

		//shorter than the lines, so they pile up
		wait ( 1.1 + ( randomfloat 1.6 ) )
	}
}end



//Drive EVERY camera to one pose. $boatCamera is re-read here every frame - unlike coop_rampFly, which
//has to snapshot the array once because it needs each camera's own STARTING yaw. Past the arc the yaw
//is absolute, so a player who connects mid-swim picks it up on his first frame. movetopos/turnto and
//never `.origin =`, per rule 2 at the top of this file.
//=========================================================================
coop_rampPose local.pos local.pitch local.yaw local.roll:{
//=========================================================================
	if($boatCamera == NULL || $boatCamera == NIL){ end }
	local.i = 1
	while(local.i <= $boatCamera.size){
		local.c = $boatCamera[local.i]
		if(local.c != NULL && local.c != NIL){
			local.a = (0 0 0)
			local.a[0] = local.pitch
			local.a[1] = local.yaw
			local.a[2] = local.roll
			local.c movetopos local.pos
			local.c turnto local.a
		}
		local.i++
	}
}end

//=========================================================================
coop_rampSuppressAll local.amount:{
//=========================================================================
	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){
			if($player[local.i].health > 0){
				thread coop_mod/main.scr::coop_setSuppression $player[local.i] local.amount
			}
		}
		local.i++
	}
}end

//=========================================================================
//[user 2026-09-03] NO CROSSHAIR FOR THE FULL INTRO.
//"can you ensure crosshair is off during the full intro and cinematic scene?"
//
//WHAT IS NOT DONE HERE. ui_crosshair and cg_crosshair are both CVAR_ARCHIVE (cg_main.c:207
//and :199) - the player's own saved preference, written to his config by Cvar_WriteVariables.
//Setting either from script and failing to restore it latches his crosshair off permanently,
//which is bug-2298 exactly. m2l2b.scr:583 already tries it and is SILENTLY FILTERED on the
//client (ui_crosshair is neither whitelisted nor coop_-prefixed in cg_servercmds_filter.cpp),
//so it has never once worked - which is the only reason it has not already burned somebody.
//
//WHAT IS DONE. coop_cineHud, flags 0, a HOLD IN SECONDS that cgame consumes into a deadline and
//then lets EXPIRE. This thread re-arms a 5-second hold every 2 seconds, and that ratio is the
//whole design:
//  * a stufftext that goes missing costs one 2s tick and still leaves 3s of slack
//  * every way this beat can end badly - the thread dying, a Script Error, the server hitching,
//    a disconnect and reconnect - stops the re-arm, and the crosshair is back WITHIN 5 SECONDS
//    ON ITS OWN. Nothing has to remember to restore it.
//  * a player who CONNECTS MID-BEAT is in $player, so the next tick covers him; the boat spawn
//    manager's playerspawn hook (m3l1a.scr) covers him in his arrival frame.
//coop_cineHudStop in coop_rampHandoff exists only so the crosshair returns in the SAME frame the
//view does instead of up to 5s later. It is a latency fix, not the safety.
//
//THE 200s BUDGET IS MEASURED, not guessed. qconsole 2026-09-03: map live 18:15:16, RAMPUW start
//18:16:39, RAMPUW done t=21.475 at 18:17:01 - 105s from map-live to the end of the swim. 200 is
//1.9x that and still a bounded number. The 45s coop_rampWatchdog only covers the cinematic, so
//it cannot be leaned on for the boat ride.
//=========================================================================
coop_cineHudStart:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_cineHudOn == 1){ end }
	level.coop_cineHudOn = 1
	level.coop_cineHudArmed = 0
	level.coop_cineHudDone = 0
	level.coop_cineHudT0 = level.time
	thread coop_cineHudLoop
}end

//=========================================================================
coop_cineHudLoop:{
//=========================================================================
	local.t = 0
	while(level.coop_cineHudOn == 1 && local.t < 200){
		local.n = waitthread coop_cineHudPoke "coop_cineHud 5"
		//THE ARM MARKER IS PRINTED ON THE FIRST TICK THAT ACTUALLY REACHED SOMEBODY, not blindly on
		//the first tick. The arm happens at the GLUE, and on a dedicated server no client is connected
		//that early - so an unconditional print emits "arm n=0", which contradicts this beat's own
		//census rule that n on the arm equals the connected player count and makes a healthy run read
		//as broken. The POKE is unconditional either way; only the marker waits for a real audience.
		if(level.coop_cineHudArmed == 0 && local.n > 0){
			level.coop_cineHudArmed = 1
			println("^~^~^ CINEHUD arm n=" + local.n)
		}
		wait 2
		local.t = local.t + 2
	}
	//EVERY exit from that loop releases - the flag being cleared, the budget running out, or the
	//thread simply falling through. coop_cineHudStop is idempotent and contains no wait.
	waitthread coop_cineHudStop
}end

//=========================================================================
coop_cineHudStop:{
//=========================================================================
	if(level.coop_cineHudT0 == NIL){ level.coop_cineHudT0 = level.time }
	level.coop_cineHudOn = 0
	//the poke is NOT guarded on coop_cineHudDone: a second release is free and covers a player who
	//connected between the handoff and the loop waking from its wait. Only the marker is guarded.
	local.n = waitthread coop_cineHudPoke "coop_cineHud 0"
	//and the release marker only prints if an ARM was printed, so the census can never see a release
	//with no arm - which its own rules call a defect. It would otherwise fire on any path that runs
	//coop_rampHandoff without this beat ever having armed. The poke above is unconditional: the
	//safety property is that every connected player is released, marker or no marker.
	if(level.coop_cineHudDone != 1 && level.coop_cineHudArmed == 1){
		level.coop_cineHudDone = 1
		println("^~^~^ CINEHUD release n=" + local.n + " t=" + ( level.time - level.coop_cineHudT0 ))
	}
}end

//The whole command string is passed in, so nothing is concatenated at the call site. No health or
//spectator filter on purpose: a release must reach EVERY connected player, including a dead one.
//=========================================================================
coop_cineHudPoke local.cmd:{
//=========================================================================
	local.n = 0
	local.i = 1
	while(local.i <= $player.size){
		if($player[local.i] != NULL && $player[local.i] != NIL){
			$player[local.i] stufftext local.cmd
			local.n = local.n + 1
		}
		local.i++
	}
	end local.n
}end

//THE HANDOFF, and the ORDER IS LOAD-BEARING. Idempotent, because the watchdog may also call it.
//=========================================================================
coop_rampHandoff:{
//=========================================================================
	if(level.coop_rampDone == 1){ end }
	level.coop_rampDone = 1

	//[bug-2319] the dialogue floor comes back on EVERY path through the handoff, and a separate
	//thread walks it back after 5s on the normal path. Both are idempotent.
	thread coop_rampAudioSafe
	thread coop_rampAudioRelease

	//--- 1. the retail release, byte for byte out of m3l1a.scr. This is deliberately a COPY and not
	//a rewrite: it is the one part of this whole set piece that must behave identically to the
	//build that shipped, because everything downstream on the beach depends on it.
	exec coop_mod/replace.scr::unglue
	for (local.i = 1;local.i <= $player.size;local.i++){
		local.player =  $player[local.i]
		if( local.player != NULL ){
			exec coop_mod/main.scr::playerPlaceAtSpawn local.i
			local.player show
		}
	}
	thread manageRespawns

	//--- 2. playerPlaceAtSpawn threads playerFace, which is a four-frame loop. This wait lets each
	//player's viewangles settle onto the spawn facing - which is exactly where the arc has already
	//eased his camera - so handing the view back swaps one for the other invisibly.
	wait 0.25

	//--- 3. hand the view back
	level.coop_rampCamLock = 0
	level.coop_rampCineDone = 1
	//[user 2026-09-03] and the crosshair, in the SAME frame the view returns. Safe to put inside
	//this load-bearing block: coop_cineHudStop contains no wait, so it runs inline. This is the
	//LATENCY fix only - coop_cineHud is a 5s self-expiring hold, so every path that never reaches
	//this line still gets the crosshair back on its own. See coop_cineHudStart.
	waitthread coop_cineHudStop
	thread maps/m3l1a.scr::coop_stopBoatSpawnManager	//cueplayer + $boatCamera delete
	thread coop_mod/main.scr::coop_setSuppressionAll 0	//the client's own 1.4s decay does the fade

	//[user 2026-09-02, bug-2361] the boat we came in on burns, heels over and settles.
	thread coop_higginsSink
}end


//THE ANTI-STRAND GUARANTEE, and it is not optional. The one softlock-class failure in this whole
//sequence is a fadeout whose fadein never arrives: every screen white, forever, with no way back.
//So a thread outside the cinematic waits it out and, if the cinematic has not reported done, clears
//the fade by hand and runs the handoff anyway. Every other screen effect used here is
//self-consuming (the suppression bump and the lens splash both decay on the client), so the fade is
//the only one that can stick.
//=========================================================================
coop_rampWatchdog:{
//=========================================================================
	local.t = 0
	//[bug-2332] 32 -> 60 half-second ticks (16s -> 30s). The revised set piece is ~13.5s from the
	//blast, so a 16s watchdog left only 2.5s of margin and would have fired on a slow frame.
	while(local.t < 90 && level.coop_rampCineDone != 1){
		wait 0.5
		local.t = local.t + 1
	}
	if(level.coop_rampCineDone == 1){ end }
	println("^~^~^ RAMPCINE watchdog fired - clearing fade and forcing the handoff")
	clearfade
	//[bug-2319] AND THE AUDIO. The watchdog restored the screen and nothing else, so any failure
	//inside the revised cinematic would have stranded the dialogue cut. coop_voxCut is the only thing
	//this beat holds that is not self-consuming: s_sfxduck is owned by coop_m3l1a_beachAudio, which
	//has its own tail, and S_BeginRegistration clears a latched one at the next map load anyway.
	waitthread coop_rampAudioSafe
	waitthread coop_rampHandoff
}end


//=========================================================================
//[user 2026-09-03] A REAL, SHOOTABLE, SELF-REPLACING CREW ON THE FOUR FLANK GUNS.
//
//The user's own observation is what settled the design: "How are the other mg42 nests handled in
//vanilla? it appears you can shoot the enemies that are attached and another will respawn and take
//over after you breach the seawall." That is exactly right, and the recipe is in the retail script
//we already ship - extracted-scripts/maps/m3l1a.scr:7039:
//
//    mg42_middle1_death:{
//        self waittill death
//        wait 5
//        $mg42_middle1_gunner remove          // nuke the gunner
//        $mg42_middle1.spawn = 1              // restart the gunners
//        trigger $mg42_middle1_waittrigger    // re-run the activation
//    }end
//
//WHY THE REPLACEMENT IS NOT OPTIONAL. TurretGun::m_bHadOwner is a ONE-WAY LATCH: initialised false
//exactly once (weapturret.cpp:497), set true in four places including Begin_MachineGunner
//(actor_machinegunner.cpp:80, which runs BEFORE the "turret already in use" check, so even a FAILED
//mount arms it), and cleared NOWHERE in the tree. TurretGun::Think:1693 then reads
//    if (!owner && (m_bHadOwner || !aim_target)) { ... ThinkIdle(); }
//so a gun that has ever had an owner and then loses him permanently drops into ThinkIdle and droops
//the barrel. These four guns fire TODAY only because that latch is still false. Mounting anybody
//spends it forever - which is why "just add a gunner" would have traded four guns that always fire
//for four that die the moment their man does. Vanilla never hits that because it always sends a
//replacement, and neither do we.
//
//BELT AND BRACES: coop_flankMG's own setaimtarget/startfiring loop is not removed, only gated. It
//skips a gun while a live gunner holds it (mg42_active drives that one) and takes the gun straight
//back the instant the crew flag clears. So the worst case is the gun firing script-driven at fixed
//points, exactly as it does today - never silence.
//
//THE MOUNT ITSELF IS COPIED FROM coop_mod/bunker.scr:427-462, which is the proven in-repo recipe and
//matches what every scripted nest in the game does: german_wehrmact_grenadier + gun "MG42", a
//_gunner targetname (mg42_active resolves the gunner BY NAME on entry), disable_ai while the fields
//are set, the full BSP field block, then enable_ai, then mg42_active on the GUN. The `enable_ai` is
//the part that makes him a real killable AI rather than scenery - which is the whole point here.
//=========================================================================
coop_flankCrew:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_flankCrewOn == NIL){ level.coop_flankCrewOn = 1 }
	if(!level.coop_flankCrewOn){ end }

	local.n = 0
	if( $mg42_left1  != NULL ){ local.n++; level.coop_flankGun[local.n] = $mg42_left1  }
	if( $mg42_left2  != NULL ){ local.n++; level.coop_flankGun[local.n] = $mg42_left2  }
	if( $mg42_right1 != NULL ){ local.n++; level.coop_flankGun[local.n] = $mg42_right1 }
	if( $mg42_right2 != NULL ){ local.n++; level.coop_flankGun[local.n] = $mg42_right2 }
	level.coop_flankGunN = local.n
	if( local.n == 0 ){ println("^~^~^ FLANKCREW no flank guns found"); end }

	//one supervisor per gun, staggered so four spawns do not land in one frame (T9: a spawn, its
	//model and its solid cannot all settle in the same frame)
	local.i = 1
	while( local.i <= local.n ){
		thread coop_flankCrewOne local.i
		wait 0.3
		local.i++
	}
	println("^~^~^ FLANKCREW supervising guns=" + local.n)
}end

//One gun's crew, for the life of the map: mount a man, hand the gun to mg42_active, wait for him to
//die, then send another. Bounded at 8 replacements so a player farming the flank cannot spawn
//actors forever against a 4096 entity pool.
//=========================================================================
coop_flankCrewOne local.idx:{
//=========================================================================
	local.made = 0
	while( local.made < 8 && level.coop_flankCrewOn == 1 ){
		local.gun = level.coop_flankGun[local.idx]
		if( local.gun == NULL || local.gun == NIL ){ end }

		//name him after the gun so mg42_active can resolve him, matching bunker.scr and the BSP
		local.tn = "coop_flankgunner" + local.idx + "_" + local.made
		local.sol = spawn "models/human/german_wehrmact_grenadier.tik" gun "MG42" targetname local.tn
		if( local.sol == NULL || local.sol == NIL ){
			println("^~^~^ FLANKCREW spawn FAILED for gun " + local.idx + " - entity pool?")
			end
		}

		local.sol exec global/disable_ai.scr
		//seat him ON the gun and let ThinkHoldGun_TurretGun settle the exact offset itself
		//(actor_machinegunner.cpp) rather than inventing one - an invented offset is a guess about
		//free space at every gun, and the model carries the authored seat.
		local.sol.origin = local.gun.origin
		local.sol.angles = local.gun.angles
		local.sol.turret = local.gun
		local.sol.type_idle = "machinegunner"
		local.sol.type_attack = "machinegunner"
		local.sol.type_disguise = "machinegunner"
		local.sol.type_grenade = "machinegunner"
		local.sol.accuracy = 20
		local.sol.sound_awareness = 100
		local.sol.noticescale = 100
		local.sol.fixedleash = 0
		local.sol.enemysharerange = 0
		local.sol.ammo_grenade = 0
		local.sol.gren_awareness = 10
		local.sol exec global/enable_ai.scr

		level.coop_flankCrewed[local.gun.entnum] = 1
		local.gun thread global/mg42_active.scr::mg42 6000
		println("^~^~^ FLANKCREW mounted gun=" + local.idx + " man=" + local.made + " ent=" + local.sol.entnum)

		local.sol waittill death

		//hand the gun straight back to the script driver before the replacement delay, so it is
		//never both unowned AND undriven
		if( local.gun != NULL && local.gun != NIL ){ level.coop_flankCrewed[local.gun.entnum] = 0 }
		println("^~^~^ FLANKCREW gunner down gun=" + local.idx)

		wait 5		//vanilla's own pause before the next man takes over (mg42_middle1_death)
		if( local.sol != NULL && local.sol != NIL ){ local.sol remove }
		local.made++
	}
	println("^~^~^ FLANKCREW gun " + local.idx + " exhausted after " + local.made + " crew")
}end

//=========================================================================
coop_rampShellPan:{
//=========================================================================
	//[user 2026-09-03] "During the rising of the sound effects ... have it occasionally and SLOWLY
	//shift between left and right channels a few times. by the time all the sounds are back to
	//normal ... the shellshock effect should be gone".
	//
	//WHY A CARRIER ENTITY AND NOT playlocalsound. A local sound cannot pan: S_OPENAL_Respatialize
	//hard-sets iPan = 64 - dead centre - for every CHANNEL_FLAG_LOCAL_LISTENER channel
	//(snd_openal_new.cpp:2929-2936), and playlocalsound is "sBF" (soundName loop time), so there is
	//no pan or volume argument to reach for. A 3D channel is respatialised from
	//s_entity[iEntNum].position on EVERY frame (:2947 re-reads it, :2980 pushes it to the source),
	//so a sound riding a moving entity pans by itself. That is the only lever the engine offers.
	//
	//AND THE CARRIER MUST KEEP MOVING. snd_openal_new.cpp:2938 kills a non-looping 3D sound outright
	//(end_sample) the moment its entity's update time goes stale. Stepping the origin every 0.1s is
	//therefore not just how the pan is produced, it is what keeps the wash alive at all.
	//
	//THE TRADE THIS MAKES, said plainly: the 2D wash it replaces was per-player by construction, and
	//a positional one is not - a team-mate inside 700 units hears a fading copy of yours. minDist is
	//200 and the carrier orbits at 150, so the owner is always at full volume while a man 700 units
	//off hears nothing. Everyone gets their own wash at the same instant anyway, so a neighbour's
	//quieter copy thickens the wash rather than fighting it. If it ever reads as flanging, drop
	//maxDist rather than going back to 2D, which cannot pan at all.
	if(level.coop_rampPan == NIL){ level.coop_rampPan = 1 }
	if(!level.coop_rampPan){ end }

	for(local.i = 1; local.i <= $player.size; local.i++){
		local.sp = $player[local.i]
		if(local.sp != NULL && local.sp != NIL && local.sp.health > 0 && local.sp.dmteam != "spectator"){
			thread coop_rampShellPanOne local.sp
		}
	}
}end

//=========================================================================
coop_rampShellPanOne local.sp:{
//=========================================================================
	if(local.sp == NULL || local.sp == NIL){ end }

	//[user 2026-09-03] "the shellshock should only be heard by the player thats being shellshocked
	//... thats not a global sound everyone hears." The first cut of this rode a carrier entity
	//through the world, which panned correctly and broadcast the wash to everyone in earshot - the
	//opposite of the requirement, and a regression against the 2D wash it replaced.
	//
	//So the sound goes back to playlocalsound, which is per-client by construction, and the PAN is
	//done client-side instead: S_HZM_LocalPanAmount (snd_openal_new.cpp) offsets the virtual
	//position of a local shellshock channel around that client's own listener, driven by coop_shellPan
	//in -1 (hard left) .. +1 (hard right). stufftext sends it to ONE player, so each man hears only
	//his own wash, panning in his own ears. Nothing else can be dragged off centre: the engine
	//matches the shellshock sample path specifically.
	local.sp playlocalsound coop_shellshock_uw

	//THREE slow crossings over 21s, inside the 34s the world takes to come back. The wash is a 10s
	//wav, so it is re-struck on the third crossing and left to decay through the second - a real gap
	//rather than a continuous drone.
	local.steps = 70					//70 * 0.1s = a 7-second crossing. Slow on purpose.
	local.side = 1
	local.sw = 0
	while(local.sw < 3){
		if(local.sp == NULL || local.sp == NIL){ break }
		if(local.sw == 2){ local.sp playlocalsound coop_shellshock_uw }

		local.k = 0
		while(local.k <= local.steps){
			if(local.sp == NULL || local.sp == NIL){ break }
			//[bug-2425] ( local.k / local.steps ) is int/int = C integer division: 0 until k==70,
			//then 1. The sweep was a hard flip on the final frame, not a crossing. * 1.0 first.
			local.f = ( ( local.k * 1.0 ) / local.steps )
			local.off = ( local.side * ( 1 - ( 2 * local.f ) ) )
			local.sp stufftext ( "set coop_shellPan " + local.off )
			wait 0.1
			local.k++
		}
		local.side = ( 0 - local.side )
		local.sw++
	}

	//back to dead centre, so a later blast-triggered wash is not stuck off to one side.
	if(local.sp != NULL && local.sp != NIL){ local.sp stufftext "set coop_shellPan 0" }
}end

//=========================================================================
coop_rampMusicSwell:{
//=========================================================================
	//[user 2026-09-03] "by the time all the sounds are back to normal, the music should be louder
	//than it is now". It is not that the music is cut - coop_cvarDuckEnd has already handed
	//s_musicvolume back to the player's own baseline - it is that the world rising from 0.05 to 1.0
	//underneath it buries the score. So the track's OWN gain climbs as the world does, and the music
	//keeps its place in the mix instead of being swallowed at the exact moment the scene lands.
	//tmvolume, not s_musicvolume: it is the cinematic's own music gain, it is what bug-2378 already
	//set to 1.9 here, and it never touches the player's archived slider.
	if(level.coop_rampSwell == NIL){ level.coop_rampSwell = 1 }
	if(!level.coop_rampSwell){ end }

	local.lo = 1.9
	local.hi = 2.6
	local.steps = 12
	local.i = 1
	while(local.i <= local.steps){
		//[bug-2425] both of these were integer division. ( local.i / local.steps ) was 0 for
		//i=1..11 and 1 at i==12 - eleven flat steps then a jump - and ( 34 / 12 ) is 2, so the
		//swell also ran 24 seconds instead of 34 and finished before the world had returned.
		local.g = ( ( local.i * 1.0 ) / local.steps )
		waitthread coop_mod/replace.scr::tmvolume ( local.lo + ( ( local.hi - local.lo ) * local.g ) )
		wait ( 34.0 / local.steps )
		local.i++
	}
}end

//=========================================================================
coop_underwaterHead local.wx local.wy local.pace:{
//=========================================================================
	//[user 2026-09-03] "I also vote we have a floating head underwater too when we land down there."
	//The companion to the decapitated ranger on the ramp: you watch a man lose his head as the door
	//drops, and thirty seconds later you meet it on the bottom.
	//
	//ONE head, deliberately. A field of them is a gore pile; a single one drifting past is an image.
	//
	//THE WATER COLUMN IS 54 UNITS. Sand is z -574 (where coop_underwaterDead lays its seven bodies)
	//and the surface is -520 - a constant this file already tests against in five places. -548 puts
	//the head mid-column, clear of the sand and well under the surface.
	//
	//PLACED CLOSE AND IN THE +Y CONE. coop_underwaterDead's own comment says +Y is "between the
	//camera and the shore", so that is where the camera looks. coop_headgib is scale 2.6 and reads
	//about 5 units across, so at the 330x430 spread the corpses use it would be a speck in the murk -
	//it sits at 95-150 units instead, near enough to read as a head.
	//
	//ORIGIN-STEPPED, not moveto: moveto silently NO-OPS on a script_model (docs/TRAPS.md).
	//No cos/sin anywhere - a mis-called trig command is a COMPILE error that takes down this entire
	//file, which is how Omaha once shipped with no coop script at all (bug-2335). A counter that
	//walks up and back down gives the bob just as well.
	if(level.coop_underHeadOn == NIL){ level.coop_underHeadOn = 1 }
	if(!level.coop_underHeadOn){ end }
	if(local.wx == NIL || local.wy == NIL){ end }
	if(local.pace == NIL || local.pace <= 0){ local.pace = 1 }

	local.h = spawn script_model model "models/fx/coop_headgib.tik"
	if(local.h == NULL || local.h == NIL){ end }			//entity-pool guard
	local.h notsolid

	local.p = (0 0 0)
	local.p[0] = local.wx + ( 0 - 45 ) + ( randomint 90 )
	local.p[1] = local.wy + 95 + ( randomint 55 )
	local.p[2] = 0 - 548
	local.h.origin = local.p
	local.h.angles = ( ( randomint 360 ) ( randomint 360 ) ( randomint 360 ) )

	//a slow drift ACROSS the view rather than toward it - something moving past you reads as adrift,
	//something moving at you reads as thrown.
	local.vx = ( 0 - 5 ) + ( randomint 11 )
	local.vy = ( 0 - 4 )
	local.ry = ( 0 - 6 ) + ( randomint 13 )

	println("^~^~^ UNDERHEAD x=" + local.p[0] + " y=" + local.p[1] + " z=" + local.p[2])

	//[2026-09-03] THE TICK BUDGET FOLLOWS THE BEAT. 180 ticks x 0.1s = 18s covered the old 17.4s
	//hold; coop_rampUnderwater's rewrite is 21.35s submerged at pace 1 and 25.1s at the 1.2 ceiling,
	//so a fixed 180 deleted the head three to seven seconds before the break. 190*pace + 60 gives
	//250 ticks / 25s at pace 1 and 288 / 28.8s at 1.2, and the break clears level.coop_underHeadOn
	//anyway, so this is only ever the backstop.
	local.ticks = ( 190 * local.pace ) + 60
	local.k = 0
	local.bob = 0
	local.dir = 1
	while(local.k < local.ticks){
		if(local.h == NULL || local.h == NIL){ break }
		if(level.coop_underHeadOn != 1){ break }

		local.bob = local.bob + local.dir
		if(local.bob >= 10){ local.dir = 0 - 1 }
		if(local.bob <= ( 0 - 10 )){ local.dir = 1 }

		local.q = local.h.origin
		local.q[0] = local.q[0] + ( local.vx * 0.1 )
		local.q[1] = local.q[1] + ( local.vy * 0.1 )
		local.q[2] = ( 0 - 548 ) + ( local.bob * 0.35 )
		local.h.origin = local.q

		local.a = local.h.angles
		local.a[1] = local.a[1] + ( local.ry * 0.1 )
		local.a[0] = local.a[0] + 0.4
		local.h.angles = local.a

		wait 0.1
		local.k++
	}

	if(local.h != NULL && local.h != NIL){ local.h delete }
}end

//=========================================================================
//THE RAMP SCREAMS. [user 2026-09-03] "if there is any death screams those should be played too
//before that explosion throws us overboard."
//
//WHAT WAS THERE: nothing staged. maps/m3l1a.scr::higgins1_disembark_kill (:2929) and _kill2 (:2945)
//are three bhits and two waits each with no voice call of any kind. Two things DID make noise, and
//neither is a performance:
//  * the actor's OWN native death VO - models/human/animation/dialogue/Generic_dialogue_US.tik:104
//    /113/122 fire snd_dfr_death_generic off the three death anims, and that alias set really is
//    American (uberdialog.scr:2499+ -> sound/dialogue/Generic/A/death/). But coop_mod/deathvox.scr::
//    muteNativeVO stops channels 4/7/8 on a dying man every frame for a second, so the coop layer
//    already silences it deliberately.
//  * in its place, ONE clip from coop_deathvox1..484 - an effects pool, nationality-agnostic, on
//    CHAN_AUTO, fired a frame AFTER death by coop_mod/aihandler.scr:178.
//So the honest description is not "they die silently". It is: retail's American cry is muted and
//replaced by a generic grunt that arrives late, unstaged, on the lowest-priority channel there is,
//underneath 4-6 snd_bh_flesh per man from coop_rampGore, snd_bodyfall_sand, higgins_bullet_hits,
//higgins_guys_rush and coop_rampIncoming. This block keeps the mute and supplies a STAGED American
//voice in its place - which is the whole reason for re-authoring a cry the actor nominally has.
//
//   T+0.00  armed, one frame after level.scripted_damage = 1 and 1.1s before the first kill thread
//   T+1.30  ranger5 SEES IT COMING and shouts - nothing has touched him yet
//   T+1.75  ranger1 takes his first stagger and yells
//   T+1.95  ranger2
//   T+2.20  ranger3
//   T+2.35  ranger4
//   T+2.1 .. 3.1  each man's death cry, fired on his OWN waittill death so it can never drift off
//                 the animation - retail's randomfloat decides the exact instant, not us
//   T+3.60  the shell, and coop_rampAudioCut 0.12s after it
//
//CHANNEL: CHAN_ITEM (2), declared in the alias (q_shared.h:1554-1566 - AUTO 0, BODY 1, ITEM 2).
//DO NOT repeat the claim an earlier draft of this block made, that channel 2 is "touched by exactly
//one thing in the engine". That was a C++ grep answering a script question and it is FALSE: a
//sound's channel is assigned in the ALIAS TABLE, and 910 aliases in ubersound/ubersound.scr alone
//are declared `item`, retail's own higgins_door_opening and higgins_bullet_hits among them.
//
//What actually matters is narrower and is measurable, because playsound override and stopsound are
//both scoped to ONE ENTITY:
//  * S_OPENAL_PickChannelBase (snd_openal_new.cpp:1664-1669) end_sample()s an existing channel only
//    when iEntNum AND iEntChannel both match, so a second cry replaces the first on the same man and
//    nobody else's item sound is involved.
//  * stopsound N is gi.StopSound(entnum, channel) -> S_OPENAL_StopSound (snd_openal_new.cpp:2278),
//    which scans for entnum AND entchannel. Same scope.
//  * So the only question is what lands on a RANGER on channel 2, and that was counted rather than
//    argued. Of the 653 `sound` commands in the whole models/human/** tree, resolved against every
//    alias table, the channel histogram is dialog 467, dialog_secondary 44, voice 33, auto 26,
//    item 1 - and the single item site is `first sound drink` (new_generic_human.tik:1612), a
//    drinking idle. The things that DO land on these men here are snd_bh_flesh = auto
//    (ubersound.scr:15, from bhit at m3l1a.scr:8497 and from coop_rampGore), snd_bodyfall_sand =
//    body (ubersound.scr:266) and the native VO = dialog. Channels 0, 1 and 8. Not 2.
//  * Their M1 Garand does not reach channel 2 either: m1_snd_fire* is `weapon`, snd_ping is `auto`,
//    m1_snd_reload IS `item` but its maps filter is "m1l1 m1l2a m1l2b m1l3a m1l3b m1l3c m3l2 m3l3
//    m4l0 m4l1 m5l1a m5l1b m6l3a" - no token is a prefix of m3l1a, so it is not loaded on this map -
//    and m1_reload_npc IS `item` and IS admitted but has zero fire sites anywhere in the mod.
//  * NOT 4 / 7 / 8: muteNativeVO stops exactly those three on a dying man, every frame, for 1.0s.
//  * NOT CHAN_AUTO: PickChannelBase enters same-entity reuse only when iEntChannel is nonzero
//    (:1649) and the steal test (:1717) only ever takes a channel of LOWER index, so an auto sound
//    is the lowest-priority sound in the game - and this is the busiest half second on the map.
//NOTHING HERE IS LOAD-BEARING ON THAT ANALYSIS. Each play is preceded by its own explicit
//stopsound 2 rather than relying on override, and the two cut-offs are cosmetic: if a stopsound ever
//missed, that cry simply runs to its natural end. Residual risk is the 96-slot 3D pool
//(snd_local_new.h:84) - under real exhaustion a channel-2 sound is a preferred steal target for any
//higher-numbered channel. That would cost a cry, not correctness.
//
//THE DUCK, MEASURED RATHER THAN HOPED. coop_rampAudioCut fires at T+3.72 and sets s_sfxduck 0.05,
//and openal_channel::set_gain runs on every playing sound every frame (S_OPENAL_Respatialize
//re-applies it, snd_openal_new.cpp:3657), so a cry still sounding then is pulled to 5%. It is NOT
//true that a dialog-channel cry would be spared: the vox floor at :3781-3819 is
//s_sfxduckVoxFloor * coop_voxCut, and coop_rampAudioCut sets coop_voxCut to 0, so the floor is 0 and
//fDuck stays 0.05 for CHAN_DIALOG too. The channel costs nothing here. What is fixed instead is the
//ARITHMETIC: ranger5 dies at 2.80-3.10, his hold is capped at 0.10 and his clip is pinned to
//coop_rampdeath04 (dfr_death_01e, 0.407s measured off the header), so his cry ends by 3.607 at the
//very worst - 0.11s clear of the cut.
//
//level.coop_rampScreamOn 0 restores today's behaviour exactly. A level var, NOT getcvar - script
//getcvar creates the cvar empty and permanently defeats the engine default (bug-1669).
//=========================================================================
coop_rampScreams:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampScreamOn == NIL){ level.coop_rampScreamOn = 1 }
	if(!level.coop_rampScreamOn){
		println("^~^~^ RAMPSCREAM off")
		end
	}

	level.coop_rampScreamNext = 0
	level.coop_rampScreamCount = 0

	//lead-in per man, measured from HERE, and each one is the MIDPOINT of that man's first-stagger
	//window - not a floor and not a mean of the whole series. Retail threads the five kills at
	//+1.10/+1.30/+1.55/+1.70/+2.00 (m3l1a.scr:2789-2801) and each kill thread waits
	//(randomfloat .3 + .5) before its first bhit, so the windows are 1.60-1.90, 1.80-2.10,
	//2.05-2.35, 2.20-2.50 and 2.50-2.80.
	local.lead[1] = 1.75
	local.lead[2] = 1.95
	local.lead[3] = 2.20
	local.lead[4] = 2.35

	local.armed = 0
	local.i = 1
	while(local.i <= 5){
		local.m = $( "higgins1_ranger" + local.i )
		if(local.m != NULL && local.m != NIL){
			if(isalive local.m){
				//ONE VOICE PER MAN. Suppresses the generic deathvox POOL GRUNT on this entity only
				//and deliberately KEEPS the native-VO mute, so the staged cry is the only thing heard
				//rather than three voices out of one throat. See the gate in coop_mod/deathvox.scr::
				//play, and note it follows the coop_keepVoiceLine idiom that file already uses.
				local.m.coop_noDeathvox = 1

				//the death watch is armed NOW, not after the lead-in wait, so a man who dies early
				//can never miss his own cry.
				local.m thread coop_rampScreamDeath local.i
				if(local.i == 5){
					local.m thread coop_rampScreamEarly
				}
				else{
					//through a temp, never local.lead[local.i] inline as a thread argument
					local.ld = local.lead[local.i]
					local.m thread coop_rampScreamHit local.i local.ld
				}
				local.armed++
			}
		}
		local.i++
	}
	println("^~^~^ RAMPSCREAM armed=" + local.armed + "/5 t=" + level.time)
}end

//The man who sees it coming. Self is ranger5 - retail sends him out last and kills him last, so he
//is still on his feet while the front rank is scythed in front of him.
//
//This uses the mod's OWN coop_rampyell01-09 rather than coop_av_us_panic, for three reasons, all of
//them found by checking: (1) coop_av_us_panic is declared `dialog` (coop_aivoice.scr:337-353), the
//channel muteNativeVO stops - safe only as long as nothing calls deathvox on him first, which is a
//timing coincidence and not a guarantee; (2) it is `alias`, not `aliascache`, so first play is a
//synchronous disk read inside the one beat that must not hitch; (3) ten of its seventeen wavs
//(dfr_panic_26a_2, 27j_2, 28m_2/3, 29e_1/2, 30f_1, 31k_1, 32o_1, 34f_1) exist only as LOOSE files in
//the retail basepath and are NOT in the mod's own sound tree, so they do not ship in the pk3. The
//nine that do ship are the ones redeclared here.
//=========================================================================
coop_rampScreamEarly:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	wait 1.30
	if(self == NULL || self == NIL){ end }
	if(!isalive self){ end }
	//1..9, always one digit, so the pad is unconditional
	local.n = ( randomint 9 ) + 1
	local.s = "0" + local.n
	self stopsound 2
	self playsound ( "coop_rampyell" + local.s )
	println("^~^~^ RAMPSCREAM yell slot=5 alias=coop_rampyell" + local.s + " t=" + level.time)
}end

//He is hit, and he yells. Short clips only (0.263-0.368s measured) so the yell is a reflex, not a
//performance - his death cry arrives a few tenths later on the SAME channel and replaces it.
//Names are ZERO PADDED on purpose: alias lookup is a PREFIX match (Alias_ListFindRandomRange,
//qcommon/alias.c:553), so an unpadded "coop_ramphit1" would also match coop_ramphit10 and the pick
//would not be the one asked for.
//=========================================================================
coop_rampScreamHit local.slot local.lead:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	wait local.lead
	if(self == NULL || self == NIL){ end }
	//the round that killed him beat us to it - his death cry covers it. Expect 4 of these normally,
	//occasionally 3: coop_rampGore puts its own bhit 40 into rangers 1 and 2 from T+2.0.
	if(!isalive self){ end }
	local.n = ( randomint 10 ) + 1
	local.s = "" + local.n
	if(local.n < 10){ local.s = "0" + local.n }
	self stopsound 2
	self playsound ( "coop_ramphit" + local.s )
	println("^~^~^ RAMPSCREAM hit slot=" + local.slot + " alias=coop_ramphit" + local.s + " t=" + level.time)
}end

//His death cry, fired on his own death event. Self is the ranger.
//=========================================================================
coop_rampScreamDeath local.slot:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	self waittill death
	if(self == NULL || self == NIL){ end }

	//ANTI-CHORUS, AND IT RESERVES BEFORE IT WAITS. Rangers 1 and 2 can land inside the same tenth of
	//a second - retail's own randomfloat decides, not us - and two cries on one frame is a sound
	//effect, not two men. An earlier draft read level.coop_rampScreamNext, waited, and only then
	//wrote it, so three threads resuming on one frame all read the same stale value and all waited
	//the same 0.30 - i.e. it separated a PAIR and nothing more. Writing the reservation BEFORE the
	//wait means the third thread sees the second thread's slot.
	if(level.coop_rampScreamNext == NIL){ level.coop_rampScreamNext = 0 }
	//ranger5 is the last man and the shell is at T+3.60: his hold is capped hard so his cry cannot be
	//pushed into coop_rampAudioCut.
	local.cap = 0.30
	if(local.slot == 5){
		local.cap = 0.10
	}
	local.due = level.time
	if(level.coop_rampScreamNext > local.due){
		local.due = level.coop_rampScreamNext
	}
	local.hold = local.due - level.time
	if(local.hold > local.cap){
		local.hold = local.cap
	}
	level.coop_rampScreamNext = level.time + local.hold + 0.30
	if(local.hold > 0){
		wait local.hold
	}
	if(self == NULL || self == NIL){ end }

	//TWO OF THE FIVE ARE CUT OFF MID-CRY, and they get the two longest clips so the cut is
	//unmistakable: 08 is dfr_death_01k at 2.543s, 13 is dfr_death_02f at 1.419s (measured off the wav
	//headers, not read off a wiki). RANGER 5 IS PINNED SHORT for the duck arithmetic in the header:
	//04 is dfr_death_01e at 0.407s. The other two run a random clip to its natural end.
	local.n = ( randomint 14 ) + 1
	local.cut = 0
	if(local.slot == 2){
		local.n = 8
		local.cut = 0.62
	}
	if(local.slot == 4){
		local.n = 13
		local.cut = 0.48
	}
	if(local.slot == 5){
		local.n = 4
	}
	local.s = "" + local.n
	if(local.n < 10){ local.s = "0" + local.n }
	self stopsound 2
	self playsound ( "coop_rampdeath" + local.s )

	if(level.coop_rampScreamCount == NIL){ level.coop_rampScreamCount = 0 }
	level.coop_rampScreamCount++
	println("^~^~^ RAMPSCREAM cry slot=" + local.slot + " alias=coop_rampdeath" + local.s + " cut=" + local.cut + " hold=" + local.hold + " n=" + level.coop_rampScreamCount + " t=" + level.time)

	if(local.cut > 0){
		wait local.cut
		if(self == NULL || self == NIL){ end }
		//best effort, not a guarantee - see the channel note in the header. If it ever misses, the
		//clip finishes on its own and the beat is merely less brutal.
		self stopsound 2
		println("^~^~^ RAMPSCREAM cutoff slot=" + local.slot + " t=" + level.time)
	}
}end


//=========================================================================
//[user 2026-09-03] LAYER 2 - THE HANDHELD, AND THE TRIPOD REMOVED.
//
//"when the higgins door comes down ... its kinda awkward you just stand staring straight as everyone
//gets machine gunned down" / "kinda feels like we are just awkwardly standing there".
//
//MEASURED, NOT REASONED. Seconds after the whistle at maps/m3l1a.scr:2755, adding up
//higgins1_opening_sequence's own waits (label at m3l1a.scr:2747):
//    0.00  $higgins1_door playsound higgins_whistle                         (m3l1a.scr:2755)
//    2.00  $higgins1_door playsound higgins_door_opening                    (m3l1a.scr:2763-2765)
//    4.30  $higgins1_door_origin time .65 / rotatezdown 90 / move           (m3l1a.scr:2767-2772)
//    4.90  higgins_bullet_hits + higgins_guys_rush + $ai_fodder_waittrigger (m3l1a.scr:2780-2786)
//    4.95  the ramp is fully down
//    5.40 5.60 5.85 6.00 6.30   retail kills rangers 1-5 in the mouth       (m3l1a.scr:2787-2801)
//    6.30  waitthread coop_rampCinematic                                    (m3l1a.scr:2821)
//    6.90  $higgins1_playerspot playsound arty_leadin                       (coopified.scr:9327)
//    7.30  the suppression bump - the world greys and tunnels               (coopified.scr:9334-9343)
//    7.90  the shell                                                        (coopified.scr:9363)
//THE RAMP IS OPEN FOR 2.95 SECONDS, and the player's view used to be a TRIPOD for 1.60 of them.
//coop_rampCinematic set level.coop_rampCamLock = 1 at coopified.scr:9316, which stops
//coop_maintainBoatCameras copying his viewangles onto his camera (maps/m3l1a.scr:8866) - and
//NOTHING moved the camera in its place until coop_rampFly at 7.90. The camera is bound to
//$higgins1_playerspot (m3l1a.scr:8787), which is itself bound to $higgins1_clip (m3l1a.scr:584) and
//so to the boat - and the boat's last move, `$higgins1 time 2 / rotatezup 2 / movedown 8`
//(m3l1a.scr:2498-2501), finishes at t 2.00, four full seconds before the lock. So the view did not
//even drift. Fifty-four percent of the open-ramp window was a locked, motionless camera pointed
//wherever his head happened to be. That is not a camera language - it is the complaint, in code.
//
//AND COOP DELETED THE ONE SHAKE THE BEAT SHIPPED WITH. m3l1a.scr:2492 threads jitter_mg_cover one
//line before higgins1_opening_sequence - it IS the door-drop shake - and its body (label at
//m3l1a.scr:8619) is
//    //chrissstrahl - don't do jitter the mg if there are multiple players, because it affects all
//    if($player.size > 1){ end }                                            (m3l1a.scr:8625-8626)
//(the same bail is in jitter_small:8635, jitter_medium:8652, jitter_large and jitter_artillery.) He
//was RIGHT: global/earthquake.scr is two lines and the second is the `earthquake` command, which
//sets one level-wide level.earthquake_magnitude (fgame/level.cpp:2307-2325, consumed at
//player.cpp:8265-8269) and would shake every player on the map, including anyone already ashore.
//The consequence, though, is that on this map in coop with two or more players there was ZERO
//camera disturbance until the shell - strictly less than singleplayer gets.
//
//THE INSTRUMENT, AND WHY IT IS THIS ONE. ViewJitter (fgame/earthquake.cpp) is that same effect made
//RADIUS-LIMITED and PER-SENTIENT, which is chrissstrahl's objection answered rather than dodged:
//    EventJitterThink walks SentientList, skips the dead (earthquake.cpp:194), and for each sentient
//    inside `radius` sets m_vViewVariation = max(current, strength - timedecay*t)
//                                                             (earthquake.cpp:185-225)
//    Player::SetPlayerView adds ps.damage_angles[i] += G_CRandom() * m_vViewVariation[i] and decays
//    m_vViewVariation by frametime*8 per frame, flooring at 0.01 (player.cpp:8281-8289)
//    and the client SUBTRACTS ps.damage_angles from refdefViewAngles IN THE CAMERA PATH
//    (cgame/cg_view.c:5885-5887), gated on cg_protocol >= PROTOCOL_MOHTA_MIN (15, q_shared.h:273)
//    and on PMF_DAMAGE_ANGLES, which player.cpp:8124-8125 sets because the camera has ShowQuakes()
//    (camera.h:310-313, set by camera.cpp:1638-1645, default false at camera.cpp:729) - and
//    coop_spawnBoatCamera already does `local.cam showquakes 1` (maps/m3l1a.scr:8785).
//    We ship protocol 17 (TARGET_GAME_PROTOCOL_MOHTT, q_shared.h:67). The whole chain is wired for
//    this exact camera today, unused. The PLAYER ENTITY is in the radius too, not just his camera:
//    m3l1a.scr:334 does `exec coop_mod/replace.scr::glue $higgins1_playerspot 0`, so every body sits
//    on the playerspot and passes the earthquake.cpp:198-199 lengthSquared test.
//    (The OTHER camera-shake path, camera.cpp:1088-1103, is dead here twice over: it is gated on
//    g_protocol < PROTOCOL_MOHTA_MIN and we ship 17, and it lives in the camera think path, which
//    rule 1 at the top of this file forbids ever starting on $boatCamera.)
//G_CRandom() is -1..1 (fgame/g_utils.h:262 -> G_Random(2) - 1), so jitteramount IS the peak
//amplitude in DEGREES, and the conversion from retail's numbers is exact: a global earthquake of
//magnitude M is the same as jitteramount ( M*2  M*2  M*3 ) (player.cpp:8261-8269 vs 8283).
//Retail's jitter_mg_cover is M .5 then .2 - ( 1.0 1.0 1.5 ) then ( .4 .4 .6 ) - and the shell's
//existing earthquake_radius 2.4 2.6 2200 (coopified.scr:9367) is ( 2.6 2.6 3.9 ), under half of
//retail's own jitter_artillery ( 6 6 9 ). Everything below stays inside that envelope: the peak
//single round is 2.40 degrees of pitch and 2.76 of roll, both under the shell's own.
//
//WHY NOT A PER-FRAME CAMERA OFFSET, which was the obvious alternative:
//  1. It cannot compose with free look. The only place to apply it is maps/m3l1a.scr:8866,
//     `local.cam.angles = group.player.viewangles` - the one statement that makes looking around
//     work at all. A Script Error there (a NIL vector, a level var read before it is written) SKIPS
//     THE STATEMENT, and skipping it every frame silently freezes every player's view. The failure
//     mode of the fix is the exact bug being fixed.
//  2. It writes into a networked, un-lerped field: cg.camera_angles is VectorCopy'd straight into
//     refdefViewAngles (cg_view.c:5883), so a server-rate jitter there reads as steps.
//     damage_angles rides the same snapshot but is applied as a SEPARATE additive term, so it never
//     corrupts where the camera is actually aimed and it cannot fight coop_rampFly movetopos/turnto.
//  3. It leaves residue that must be cleaned up on four exit paths. ViewJitter leaves NONE: with
//     donedeath set and duration > 0 the entity calls EV_Remove on itself once m_fTimeRunning passes
//     the duration (earthquake.cpp:230-236), and m_vViewVariation decays on its own. There is
//     nothing to release on death, disconnect, skip or watchdog - which is what makes this safe for
//     eight people who did not consent to a cutscene.
//  4. Coop and late join are free. The jitter is evaluated against every sentient's own origin every
//     frame, so a player who connects mid-beat and spawns glued in the boat is inside the radius on
//     his first tick, with no per-player list to keep in sync and nothing to unwind if he leaves.
//The one thing the camera-offset route buys - a DIRECTIONAL snap - is bought here instead by the
//AXIS MIX: every round picks one of three signatures (deck strike = pitch, crack past the ear =
//yaw and roll, hull hit = even), which alongside a positionally-played impact reads as direction.
//THE AXIS MIX ONLY EXISTS IF edgeeffect IS EXACTLY 1.0. earthquake.cpp:202-207 is
//    if (m_fEdgeEffect == 1.0f) { vApplyJitter = vDelta; }
//    else { ... vApplyJitter = Vector((1.0f - ...) * vDelta[0], 0, 0); }
//- yaw and roll are LITERAL ZEROS in the else branch, and the constructor default is 0.2f
//(earthquake.cpp:127). coop_rampShakeAt sets 1.0 unconditionally and says so in a comment there.
//The corollary, stated plainly: edgeeffect 1.0 means NO distance falloff at all. The radius is a
//hard cliff, not a fade. That is fine here - every body is glued to one point - but it is why the
//radius must stay small enough to EXCLUDE anybody ashore rather than merely attenuate him.
//
//SOLO IS DIFFERENT, AND MEASURED. With exactly one player jitter_mg_cover does NOT bail, and the
//global path is not max'd against ours - player.cpp:8266-8268 ASSIGNS damage_angles from
//level.earthquake_magnitude and player.cpp:8283 then ADDS m_vViewVariation, so the two are
//ADDITIVE. The overlap is bounded and small: jitter_mg_cover is two `waitexec global/earthquake.scr`
//calls of .3s each (m3l1a.scr:8628-8629) and `earthquake` puts the calling thread to sleep for the
//duration (level.cpp:2311), so retail's shake runs t 0.00 - 0.60 ONLY. That lands inside phase 0
//alone, whose bed is ( 0.20 0.18 0.32 ). Worst-case solo sum is ( 1.20 1.18 1.82 ), below retail's
//own jitter_small first step of ( 2 2 3 ). It never touches the rounds, which start at t 4.30.
//
//GATE: level.coop_rampShakeOn 0 restores today's behaviour exactly - this thread ends on its third
//line and nothing else in the beat reads it. level.coop_rampShakeScale scales the whole score, so
//the feel is tunable without touching a number in here. Level vars, NOT getcvar: script getcvar
//creates the cvar EMPTY and permanently defeats the engine default (bug-1669).
//=========================================================================
coop_rampHandheld:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_rampShakeOn == NIL){ level.coop_rampShakeOn = 1 }
	if(!level.coop_rampShakeOn){ println("^~^~^ RAMPSHAKE off by level.coop_rampShakeOn"); end }
	if(level.coop_rampShakeDone == 1){ end }
	level.coop_rampShakeDone = 1
	if(level.coop_rampShakeScale == NIL){ level.coop_rampShakeScale = 1.0 }

	//SEED THE FLAG HERE, not only in coop_rampCinematic. Two reasons, both real:
	//  - this thread starts at t 0.00 and coop_rampCinematic does not run until t 6.30, so every
	//    read of level.coop_rampBlast before then would be a read of an UNSET level var. That does
	//    not throw on `== 1` (scriptvariable.cpp:1982-1990 falls to `default: Clear(); return
	//    false;` for none-vs-int) but it DOES throw on the stop marker's `"blast=" + none`, and a
	//    thrown println prints NOTHING - the one marker that carries the diagnosis would vanish on
	//    exactly the paths where you need it.
	//  - it makes this thread self-contained: it can run with the cinematic gated off.
	level.coop_rampBlast = 0

	local.sp = $higgins1_playerspot
	if(local.sp == NULL || local.sp == NIL){ println("^~^~^ RAMPSHAKE no playerspot - nothing to centre on"); end }

	local.k = level.coop_rampShakeScale
	//700 covers the boat and its own length of water without reaching anybody ashore. The test is
	//(sentient.origin - jitter.origin).lengthSquared() <= radius*radius (earthquake.cpp:198-199),
	//and the `radius` setter squares its argument for you (earthquake.cpp:242-249), so 700 means
	//700 units. It is re-centred every tick off $higgins1_playerspot, which is bound to the boat.
	local.rad = 700
	local.t0 = level.time
	local.hits = 0
	local.bed = ( 0 - 1 )
	local.t = 0

	println("^~^~^ RAMPSHAKE start boat=" + local.sp.origin + " scale=" + local.k)

	while(1){
		local.t = level.time - local.t0

		//FOUR INDEPENDENT STOPS, because this thread must never outlive the beat it scores.
		//coop_rampBlast is the musical one and is checked FIRST; coop_rampCineDone and
		//coop_rampDone catch the gated-off and the watchdog paths; local.t is a pure anti-runaway
		//backstop and is deliberately WELL PAST the shell at 7.90 rather than just under it.
		//An earlier draft capped at 7.85, which is a coin flip against a shell at 7.90: whichever
		//of the two fired first decided the marker, so `blast=` - the field that is supposed to
		//prove the score and the beat still agree - would have been noise. 9.50 makes blast=1 the
		//deterministic healthy exit and leaves the cap doing only the job it is for.
		//A round fired in the <=0.23s between the shell and the next tick is invisible: the shell
		//is ( 2.6 2.6 3.9 ) and MAX wins on every axis over the peak round of ( 2.40 - 2.76 ).
		if(level.coop_rampBlast == 1){ break }
		if(level.coop_rampCineDone == 1){ break }
		if(level.coop_rampDone == 1){ break }
		if(local.t >= 9.50){ break }

		local.o = local.sp.origin
		local.o[2] = local.o[2] + 40		//about head height in the boat

		//--- the phase, read from the clock rather than accumulated, so a slow frame cannot drift
		//    it. Every boundary is a statement I read, not a number I liked:
		//      2.00 higgins_door_opening        m3l1a.scr:2765
		//      4.30 the ramp starts to swing    m3l1a.scr:2770-2772
		//      4.90 higgins_bullet_hits         m3l1a.scr:2782
		//      6.90 arty_leadin                 coopified.scr:9327
		//      7.30 the suppression bump        coopified.scr:9334-9343
		local.ph = 0
		if(local.t >= 2.00){ local.ph = 1 }		//the door sound - the ramp winch takes up
		if(local.t >= 4.30){ local.ph = 2 }		//the ramp is swinging down
		if(local.t >= 4.90){ local.ph = 3 }		//higgins_bullet_hits - rounds are arriving
		if(local.t >= 6.90){ local.ph = 4 }		//arty_leadin - something big is coming
		if(local.t >= 7.30){ local.ph = 5 }		//the world greys - and it is close

		//--- THE BED. One entity per phase, held FLAT (timedecay 0 0 0) for that phase and then let
		//    fall away on m_vViewVariation's own per-frame decay, a ~0.25s tail. Re-issued only on a
		//    phase CHANGE, so the whole window costs six spawns rather than one every tick. Each
		//    duration is set a little longer than its own phase window (2.00 2.30 0.60 2.00 0.40
		//    0.60) so a bed never gaps before the next one supersedes it; the overlap is harmless
		//    because m_vViewVariation takes the MAX (earthquake.cpp:209-225) and every phase is
		//    larger than the one before it.
		if(local.ph != local.bed){
			local.bed = local.ph

			local.b1 = 0.20		//pitch
			local.b2 = 0.18		//yaw
			local.b3 = 0.32		//roll leads, the way retail's own 2 2 3 default does
			local.bd = 2.35
			if(local.ph == 1){ local.b1 = 0.28; local.b2 = 0.24; local.b3 = 0.42; local.bd = 2.55 }
			if(local.ph == 2){ local.b1 = 0.40; local.b2 = 0.34; local.b3 = 0.55; local.bd = 0.85 }
			if(local.ph == 3){ local.b1 = 0.50; local.b2 = 0.42; local.b3 = 0.65; local.bd = 2.20 }
			if(local.ph == 4){ local.b1 = 0.85; local.b2 = 0.75; local.b3 = 1.05; local.bd = 0.55 }
			if(local.ph == 5){ local.b1 = 1.30; local.b2 = 1.10; local.b3 = 1.70; local.bd = 0.70 }

			local.bx = local.b1 * local.k
			local.by = local.b2 * local.k
			local.bz = local.b3 * local.k
			local.bamt = ( local.bx local.by local.bz )
			waitthread coop_rampShakeAt local.o local.bd local.bamt local.rad 1

			//--- and the two one-off mechanical impulses, on the frames the boat is actually acted
			//    on. They land within one idle tick (0.15s) of the event that causes them.
			if(local.ph == 1){
				local.ix = 0.90 * local.k
				local.iy = 0.40 * local.k
				local.iz = 0.70 * local.k
				local.iamt = ( local.ix local.iy local.iz )
				waitthread coop_rampShakeAt local.o 0.30 local.iamt local.rad 0
			}
			if(local.ph == 2){
				local.ix = 1.30 * local.k
				local.iy = 0.50 * local.k
				local.iz = 0.90 * local.k
				local.iamt = ( local.ix local.iy local.iz )
				waitthread coop_rampShakeAt local.o 0.32 local.iamt local.rad 0
			}
		}

		//--- THE ROUNDS. Nothing before the ramp moves: the boat is a boat until then, and the whole
		//    point of a score is that the shell has something to be bigger than.
		local.wt = 0.15
		if(local.ph >= 2){
			local.hits++

			local.a = 0.70 + ( randomfloat 1.10 )
			if(local.ph == 3){ local.a = 0.90 + ( randomfloat 1.50 ) }
			if(local.ph >= 4){ local.a = 1.10 + ( randomfloat 1.30 ) }
			local.a = local.a * local.k

			//three signatures. The axis is the only direction cue a random jitter can carry, and it
			//is a real one: a strike on the deck in front of you is pitch, a round past your ear is
			//yaw and roll. Layer 1 positional impacts do the rest of that work.
			//randomint returns 0..2 here: GetRandomInt -> G_Random(n) = G_Random()*n truncated to
			//int (scriptthread.cpp:2651-2653, g_utils.h:245-247). If some build ever made it
			//inclusive, index 3 falls through to the deck-strike defaults - harmless, and there is
			//no unhandled branch.
			local.s = randomint 3
			local.h1 = local.a			//deck strike
			local.h2 = local.a * 0.45
			local.h3 = local.a * 0.60
			if(local.s == 1){			//past the ear
				local.h1 = local.a * 0.35
				local.h2 = local.a
				local.h3 = local.a * 1.15
			}
			if(local.s == 2){			//into the hull
				local.h1 = local.a * 0.70
				local.h2 = local.a * 0.80
				local.h3 = local.a * 0.90
			}
			local.hamt = ( local.h1 local.h2 local.h3 )
			waitthread coop_rampShakeAt local.o 0.22 local.hamt local.rad 0

			local.wt = 0.16 + ( randomfloat 0.30 )
			if(local.ph == 3){ local.wt = 0.10 + ( randomfloat 0.22 ) }
			if(local.ph >= 4){ local.wt = 0.09 + ( randomfloat 0.14 ) }
		}

		//EVERY path through this loop reaches this line with local.wt a positive float: it is
		//assigned unconditionally above the `if`, and every branch that reassigns it uses a
		//positive base plus randomfloat. There is no single-frame spin here.
		wait local.wt
	}

	println("^~^~^ RAMPSHAKE stop hits=" + local.hits + " t=" + local.t + " blast=" + level.coop_rampBlast)
}end


//One radius-limited, per-axis ViewJitter. This is coop_mod/main.scr::earthquake_radius (label at
//main.scr:1889) with two deliberate differences and one bug not copied:
//  - the three axes are independent, because the axis mix is this layer's only direction cue;
//  - local.hold 1 holds the amplitude FLAT for the duration (timedecay 0 0 0) instead of ramping it
//    to zero, which is what a bed needs and what a fading impulse must not have. Flat works because
//    EventJitterThink computes vDelta = strength - timedecay*t (earthquake.cpp:187), so a zero
//    decay leaves vDelta at full strength until the duration expires and the entity removes itself;
//  - earthquake_radius computes `local.magnitude / local.duration` on two script values, and int/int
//    is C integer division (script/scriptvariable.cpp:1673-1679), so `earthquake_radius pos 2 1 900`
//    gets decay 0 and never decays at all. Dividing a VECTOR by the duration cannot hit that: both
//    vector/int and vector/float are float division (scriptvariable.cpp:1682-1698).
//Division by zero THROWS in Morpheus (scriptvariable.cpp:1674-1676), hence the duration guard
//before any arithmetic runs.
//=========================================================================
coop_rampShakeAt local.pos local.dur local.amt local.rad local.hold:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(local.dur == NIL){ end }
	if(local.dur <= 0){ end }
	if(local.amt == NIL){ end }

	local.j = spawn ViewJitter
	if(local.j == NULL || local.j == NIL){ end }		//entity-pool guard - Omaha is a busy map

	local.dec = ( 0 0 0 )
	if(local.hold != 1){ local.dec = local.amt / local.dur }

	local.j origin		local.pos
	local.j donedeath	game.true	//with duration > 0 this makes it EV_Remove itself
						//(earthquake.cpp:230-236). Same call main.scr:1899 makes.
	local.j edgeeffect	1.0		//1.0 IS LOAD-BEARING: any other value takes the else
						//branch at earthquake.cpp:204-206, which zeroes yaw and
						//roll and kills the whole axis mix. Ctor default is 0.2f.
	local.j radius		local.rad
	local.j duration	local.dur
	local.j jitteramount	local.amt
	local.j timedecay	local.dec
	local.j triggereffect	$world	//nothing happens until this line: it is what posts the first
					//EV_ViewJitter_Think (earthquake.cpp:104, 167-171).
}end


//=========================================================================
//[user 2026-09-03] LIVING MEN IN THE WATER. "I also dont see ... any allies storming the beach and
//getting shot down when I am underwater" / "I can't tell if anyone is running in front of us."
//
//THE MEN ARE ALREADY THERE - retail's ai_fodder1..9, released by `trigger $ai_fodder_waittrigger`
//(m3l1a.scr:2786) ~1.5s before this cinematic, all nine live because g_ddayfodderguys defaults to
//"2" (server/sv_init.c:1178). 491 `PRB actor.snap` samples in the shipped logs put them at z -575
//to -583, pos=run, hp down to 54: on the seabed, wading, being shot. THE DEFECT IS STAGING. Of the
//326 samples still in the surf, run back through this camera's real frustum, mean in-frame is 0.045
//and only 10% of samples are on screen at all. Per man (mean/best single sample):
//  f1 dx-1792 .00/.00  f2 dx-1346 .00/.00  f3 dx-977 .00/.00  f4 dx-506 .01/.29  f5 dx-170 .27/1.00
//  f6 dx +379 .06/.69  f7 dx +651 .02/.38  f8 dx+1073 .00/.00  f9 dx+1247 .00/.00
//Mean dy is +1..+253 - they are ABEAM the camera, not ahead of it - and eight of nine sit 500-1800
//units off the axis. So this AIMS a system rather than inventing one: same models, same weapon, same
//movement primitive, same death, staged inside the solid angle the camera actually holds.
//
//THE CONE, AND EVERY SEAT VALIDATED AGAINST IT ONE BY ONE. Camera $boatCamera at (367 -2655)
//(coop_mod/spawnlocations.scr:886), fov 80 (fgame/camera.cpp:710, nothing overrides it), walking the
//real 7-key hold table above (yaw 74..108, pitch -8..-30) then the swim-up leg (yaw 93->90). Each
//man is sampled at seven heights from his feet on the sand (-576) to the waterline (-520) - the
//SUBMERGED half only, the conservative read - at 16:9 vertical FOV, tighter than 4:3.
//
//                                        walk   +/-70u   +/-60u
//   seat  dx    dy   window     spawn    line   lateral  camera   death
//     1  -70  +240   2.20- 9.60  1.00    1.00    0.89     0.89    in frame, all 9 camera cases
//     2  +35  +225   2.20-17.40  1.00    1.00    0.92     0.94    LIVES
//     3 -105  +325   2.20-12.80  1.00    1.00    0.94     0.94    in frame, all 9 camera cases
//     4  +40  +315   3.60-15.20  1.00    1.00    1.00     1.00    in frame, all 9 camera cases
//     5   +0  +430   6.80-16.80  1.00    1.00    1.00     1.00    in frame, all 9 camera cases
//
//EVERY COLUMN IS A PER-SEAT WORST CASE, NEVER A MEAN. "walk line" is the worst of six points along
//his whole 420-unit route. "lateral" adds +/-70 units of wander, what coop_pickLeg's bearing ladder
//can do to him. "camera" additionally slides the camera up to 60 units in XY - the contingency for
//the choreography beat adding translation where today there is none. THE STAGING DOES NOT ASSUME A
//FROZEN CAMERA; 0.89 is the worst number anywhere in that envelope, against 0.045 for retail's men.
//AN EARLIER DRAFT HAD SIX SEATS AND CLAIMED "0.76 to 1.00, every seat" - that was the MEAN of a
//series printed as a floor. Measured per seat, its seat1 (dx -260) and seat2 (dx +270) scored 0.29
//and 0.28, and its seat2 died at t=15.4 at a bearing 46 degrees off axis: fifteen seconds of a
//thinking actor spent entirely off screen. Both are DELETED, not nudged. An actor that cannot be
//seen should not exist, and two actors back is real headroom on a 25ms tick.
//
//THE WATER, OUT OF THE BSP: surface z = -520 exactly (maps/m3l1a.bsp brush 787, common/nodraw,
//CONTENTS_WATER, top plane -520.0); seabed z = -576, flat y -2850..-1800 across x 217..517. The
//column is 56 units and MAXS_Z is 94 with the origin at the feet (fgame/bg_public.h:37), so the
//waterline cuts a man at 60% of his height - chest deep. (coop_placeGround's header still says
//"surface is -496"; -496 is a baked fx_mortar_water anchor height, never a surface reading.) AND THE
//SURFACE IS OPAQUE FROM UNDERNEATH: deepbluesea and deepbluesea_runup are co-planar at -520
//(LUMP_SURFACES) and deepbluesea's first stage has NO blendFunc - GL_ONE GL_ZERO - with `cull none`,
//so it draws from below as a lid. You see a wading man from about the waist down, and a man who is
//KILLED drops from behind that lid into full view. The fall is the shot: hence close seats (228-430
//units) and four deaths of five on camera.
//
//THE ANIMATION IS RETAIL'S OWN, RESOLVED LINK BY LINK: `<actor> runto <info_waypoint>` ->
//Actor::RunTo (fgame/actor.cpp:4854) execs global/runto.scr -> exec global/moveto.scr anim/run.scr
//-> Actor::MoveTo (actor.cpp:4813) SetThinkIdle(THINK_RUNNER) -> Begin_Runner
//(fgame/actor_runner.cpp:38-44) sets m_csMood AND m_csIdleMood = nervous -> anim/run.scr routes
//nervous to anim/runto_casual.scr -> runto_casual.scr:52 `if (self.ground == water) self
//setmotionanim run_rifle_water`, with self.ground from `exec global/setgroundtype.scr "water"` -
//retail does exactly this to its own fodder at m3l1a.scr:7764. (An earlier draft cited 7291; 7291 is
//`thread sequence_7_shingle_chatter`.) BOTH ALIASES RESOLVE ON m3l1a, re-checked with
//docs/tools/check_map_anims.py's own resolver and against e3l1 as a NEGATIVE control where both are
//absent: run_rifle_water -> waterWALK001a/b/d, all LOOPING (11/9/35 frames); death_mortar ->
//higgens_flip / higgens_medium / higgens_twist, all ONE-SHOT (8/18/34 frames = 1.07/2.40/3.40s).
//run_rifle_water's bare name is COMMENTED OUT in level_m3l1.tik and survives only because
//run_rifle_water1/2/3 carry `random`, which makes the digit strip register the base name - do not
//tidy that tik. anim/runto_inopen.scr has NO water branch (the token `water` does not appear in that
//file at all), which is why these men must never enter a combat think state.
//
//WHICH IS WHY disable_ai IS HERE AND WAS THE LINE AN EARLIER DRAFT DROPPED. Retail's fodder recipe
//opens with `local.dead_dork exec global/disable_ai.scr` (m3l1a.scr:7762) and only then runs `runto`
//(ai_fodder_takepath, :7863-7868), so disabling the AI plainly does not stop him walking.
//`threatbias ignoreme` and `notarget 1` stop OTHERS acquiring HIM; neither stops him acquiring, and
//the instant he does he leaves THINK_RUNNER for a combat think state - he stops wading and stands up
//to shoot. THE THINK STATE IS THE MECHANISM, NOT THE MOOD: `grep -n "m_csMood = " fgame/actor*.cpp`
//finds exactly one STRING_ALERT, in actor_turret.cpp:223, and Begin_Runner sets m_csIdleMood too so
//idle restores nervous. It is also free frame time - five actors that never run acquisition.
//
//NOT coop_dryGround / coop_placeGround, WHICH EVERY OTHER ACTOR SITE HERE USES: they exist to do the
//opposite - bug-2255, "AN ACTOR MUST NEVER END UP UNDER THE SEA" - stepping a man shoreward until he
//is above -520 and REMOVING him if they cannot. These five are the deliberate exception; in 56 units
//of water they are chest deep, not drowned. Placement is droptofloor from -530 with coop_dropSpot
//nudging first and an explicit LANDED check after. There are exactly four obstacles inside x 50..700,
//y -2800..-1900 (r 28/64/64/28) and every seat clears the nearest by 8 to 98 units even at the far
//corner of its jitter, so the nudge should never need to fire. coop_advanceLeg needs no change:
//coop_pickLeg takes local.dry from coop_groundZ(from.y), which is -572 at these seats, so the
//dry-land rung test is OFF in the surf and back ON near shore (it crosses -520 at about y -1139).
//
//BUDGET: five actors, at most four alive at once (seat 1 is down at t+6.2, seat 5 arrives at t+6.8),
//one info_waypoint each, at most two coop_bloodcloud emitters per death - 15 entities peak against a
//4096 pool. Every one has a named owner and every exit path frees it (tail of coop_underwaterWader).
//=========================================================================
coop_underwaterWaders local.wx local.wy:{
//=========================================================================
	if(level.coop_underDeadOn != 1){ end }
	if(local.wx == NIL || local.wy == NIL){ end }
	if(level.coop_underWadeOn == NIL){ level.coop_underWadeOn = 1 }
	if(!level.coop_underWadeOn){ end }

	//THE SEAT TABLE, every number measured rather than chosen.
	//  sx/sy  offset from the landing point - the validated seats in the header table
	//  gx/gy  the point he WALKS TOWARD, ~420 units further out and pulled back toward the camera
	//         axis. A goal POINT, not a heading: coop_pickLeg re-aims at it every leg, so a bearing
	//         it had to jitter around an obstacle self-corrects next leg instead of compounding.
	//         That is what holds the "lateral" column of the header table at 0.89.
	//  st     when he enters the water, sd when he is cut down, both in seconds from the START OF
	//         THE PLUNGE. The camera is on the bottom from 2.20 to 17.40, so every death here has
	//         its full 1.1-3.4s death animation finish while the camera is still down there.
	//  sd = 0 - 1 means he lives, and is handed to coop_disembarkRun.
	local.n = 0
	local.n++; local.sx[local.n] = 0 - 70;  local.sy[local.n] = 240; local.gx[local.n] = 0 - 25; local.gy[local.n] = 655; local.st[local.n] = 0;   local.sd[local.n] = 6.2
	local.n++; local.sx[local.n] = 35;      local.sy[local.n] = 225; local.gx[local.n] = 10;     local.gy[local.n] = 640; local.st[local.n] = 0;   local.sd[local.n] = 0 - 1
	local.n++; local.sx[local.n] = 0 - 105; local.sy[local.n] = 325; local.gx[local.n] = 0 - 50; local.gy[local.n] = 740; local.st[local.n] = 0;   local.sd[local.n] = 9.4
	local.n++; local.sx[local.n] = 40;      local.sy[local.n] = 315; local.gx[local.n] = 15;     local.gy[local.n] = 730; local.st[local.n] = 3.6; local.sd[local.n] = 11.8
	local.n++; local.sx[local.n] = 0;       local.sy[local.n] = 430; local.gx[local.n] = 0;      local.gy[local.n] = 845; local.st[local.n] = 6.8; local.sd[local.n] = 13.4
	local.seats = local.n

	//ONE CLOCK. Spawn times used to be accumulated from the waits while death times were read from
	//level.time - two clocks that agree only while nothing in the spawn path yields. That is true
	//today (coop_dropClear and coop_dropSpot are pure arithmetic, no waitframe) but the day something
	//in there yields they drift apart and the late seats die on the frame they spawn. Both come off
	//local.t0 now, so there is nothing left to drift.
	local.t0 = level.time
	local.cap = local.t0 + 26		//hard wall-clock stop, see coop_underwaterWader
	local.made = 0

	local.i = 1
	while(local.i <= local.seats){
		if(level.coop_underDeadOn != 1){ break }
		if(level.coop_rampCineDone == 1){ break }
		local.w = ( local.t0 + local.st[local.i] ) - level.time
		if(local.w > 0){ wait local.w }
		if(level.coop_underDeadOn != 1){ break }
		if(level.coop_rampCineDone == 1){ break }

		local.p = (0 0 0)
		local.p[0] = local.wx + local.sx[local.i] + ( ( randomint 32 ) - 16 )
		local.p[1] = local.wy + local.sy[local.i] + ( ( randomint 32 ) - 16 )
		//10 under the surface and 46 above the sand, so the drop starts in open water
		local.p[2] = 0 - 530
		local.q = waitthread coop_dropSpot local.p 34
		if(local.q != NULL){ local.p = local.q }

		local.a = waitthread coop_underwaterWaderSpawn local.p
		if(local.a != NULL && local.a != NIL){
			local.made++
			local.dl = 0
			if(local.sd[local.i] > 0){ local.dl = local.t0 + local.sd[local.i] }
			local.g = (0 0 0)
			local.g[0] = local.wx + local.gx[local.i]
			local.g[1] = local.wy + local.gy[local.i]
			local.g[2] = local.a.origin[2]
			local.a thread coop_underwaterWader local.i local.g local.dl local.cap
		}
		local.i++
	}
	println("^~^~^ UNDERWADE spawned=" + local.made + " seats=" + local.seats)
}end

//One wading rifleman, placed. Returns him, or NULL if the pool refused the spawn.
//=========================================================================
coop_underwaterWaderSpawn local.pos:{
//=========================================================================
	local.mdl = "models/human/dday_29th_private"
	if((randomint 2) == 0){ local.mdl = "models/human/dday_ranger_private" }

	local.a = spawn local.mdl gun "m1 garand"
	if(local.a == NULL || local.a == NIL){ end NULL }		//entity-pool guard

	//FIRST, AND IT IS RETAIL'S OWN ORDER (m3l1a.scr:7762 spawns, disables, then walks him).
	//self.enableEnemy = 0, so he never acquires, never leaves THINK_RUNNER, and never stands up out
	//of the wade to shoot. It also sets coop_aiDisabled, which keeps officer.scr's personality roll
	//off him - that roll overwrites the assigned think on about 65% of rolls.
	local.a exec global/disable_ai.scr

	//and the rest is verbatim coop_flankLandings (coopified.scr:3771-3778): he cannot be shot at,
	//cannot block a player, and no coop sweeper or retail todo can claim him.
	local.a.coop_noChatter = 1
	local.a threatbias ignoreme
	local.a notarget 1
	local.a dontdropweapons
	local.a notsolid
	local.a.isinsequence = 1
	local.a.isbusy = 1
	local.a.origin = local.pos
	local.a.angles = ( 0 90 0 )
	local.a droptofloor

	//DID HE ACTUALLY LAND. Entity::droptofloor (fgame/entity.cpp:2659-2677) returns WITHOUT moving
	//him on startsolid/allsolid/no-hit, silently - and a man left at -530 stands 46 units proud of
	//the sand with his head out of the water, which is exactly the screenshot this beat must never
	//produce (bug-2255). Sand is -576, so anything above -558 means the drop did not take: put him
	//just clear of the sand and drop again from there.
	if(local.a.origin[2] > ( 0 - 558 )){
		local.p2 = local.a.origin
		local.p2[2] = 0 - 574
		local.a.origin = local.p2
		local.a droptofloor
	}

	//THE ONE LINE THE WADE RESTS ON, and it is retail's own (m3l1a.scr:7764). Without it self.ground
	//is unset, anim/runto_casual.scr:52 falls through, and he wades in the DRY beach run - a man
	//jogging on sand while chest deep, which is worse than not doing this at all.
	local.a exec global/setgroundtype.scr "water"
	end local.a
}end

//His surge up the beach, and the round that finds him.
//=========================================================================
coop_underwaterWader local.seat local.goal local.deadline local.cap:{
//=========================================================================
	if(self == NULL || self == NIL){ end }

	//NEVER COMPARE AN UNSET LOCAL WITH A NUMBER. Both come from the one caller above and are always
	//real, but reading an argument that was not passed yields none and `none > 0` throws - and a
	//throw in the loop condition would leave the man standing in the sea, which is precisely the
	//failure this label exists to prevent.
	if(local.deadline == NIL || local.deadline == NULL){ local.deadline = 0 }
	if(local.cap == NIL || local.cap == NULL){ local.cap = level.time + 26 }

	//HIS OWN DESTINATION MARKER, spawned once and moved - the coop_flankWalk pattern. info_waypoint
	//is the class that sends Actor down the direct-move branch, the only one that works here: this
	//beach has no baked pathnodes below y 2768 (bug-2246). coop_advanceLeg authors the marker's
	//height off the GROUND and never off the man, which is the whole of the bug-2290 fix.
	local.wp = spawn info_waypoint
	if(local.wp == NULL || local.wp == NIL){ end }		//entity-pool guard

	println("^~^~^ UNDERWADE seat=" + local.seat + " org=" + self.origin)

	local.hit = 0
	local.k = 0
	while(local.k < 24){
		if(self == NULL || self == NIL){ break }
		if(!isalive self){ break }
		//THREE INDEPENDENT WAYS OUT, so no man can outlive the beat on any path. The first is the
		//normal one (coop_rampUnderwater clears it at the surface break). The second covers the
		//watchdog handoff, which does NOT clear coop_underDeadOn. The third is a wall clock, and it
		//still holds if neither flag is ever written at all.
		if(level.coop_underDeadOn != 1){ break }
		if(level.coop_rampCineDone == 1){ break }
		if(local.cap > 0 && level.time >= local.cap){ break }

		if(local.deadline > 0 && level.time >= local.deadline){
			local.hit = 1
			self waitthread coop_underwaterWaderDie local.seat
			break
		}

		//ONE SHORT SURGE, THEN HE STOPS. Legs of 70-130 units with a 2.4-4.2s dwell rather than one
		//long order: a man in chest-deep water under fire pushes, stops and pushes again. It is also
		//what keeps him inside the envelope the header table was validated over - the seats hold to
		//0.89 out to 420 units of travel, and this pacing puts his net travel across the whole hold
		//at roughly 250-350.
		waitthread coop_advanceLeg self local.wp local.goal ( 70 + ( randomint 60 ) ) 34
		if(self == NULL || self == NIL){ break }
		waitthread coop_underCheck self		//[bug-2290] the standing failsafe every mover here runs

		local.w = 2.4 + ( randomfloat 1.8 )
		if(local.deadline > 0){
			local.r = local.deadline - level.time
			if(local.r > 0 && local.r < local.w){ local.w = local.r }
		}
		wait local.w
		local.k++
	}

	//ONE TAIL, AND EVERY BREAK ABOVE COMES THROUGH IT. The marker is this thread's only owned edict
	//and it is freed here on all of them - normal end, death, watchdog, wall clock, actor gone.
	if(local.wp != NULL && local.wp != NIL){ local.wp remove }

	//HE IS NOT LEFT STANDING IN THE SEA. The survivor is handed to this file's own coop_disembarkRun
	//- the same handoff coop_disembarkSquad makes at coopified.scr:2207, off an actor neutered with
	//exactly this set - so "allies storming the beach" carries past the cinematic instead of stopping
	//with it. His groundtype goes back to "beach" FIRST: the map's own ai_groundtype triggers
	//(m3l1a.scr:2283-2291) would normally flip it as he passes, but those are TOUCH triggers and he
	//is notsolid, so nothing in the world will ever flip it for him and he would jog up dry sand
	//still playing waterWALK.
	if(self != NULL && self != NIL){
		if(local.hit == 0){
			if(isalive self){
				self exec global/setgroundtype.scr "beach"
				self thread coop_disembarkRun
			}
		}
	}
}end

//He is hit chest-deep and goes under. THE ORDER IS THE POINT: the blood is in the column before he
//falls, so the frame reads round, blood, body - rather than body, then blood.
//=========================================================================
coop_underwaterWaderDie local.seat:{
//=========================================================================
	if(self == NULL || self == NIL){ end }
	if(!isalive self){ end }

	//RETAIL'S OWN WATER DEATH, in retail's own UNQUOTED form (m3l1a.scr:8427, ai_mortar_death).
	//global/setdeathanim.scr sets self.deathanim and anim/killed.scr:73-76 plays it instead of the
	//location-based default. death_mortar resolves on m3l1a to higgens_flip / higgens_medium /
	//higgens_twist - authored for men blown off the Higgins, which is exactly the flail and go under
	//this needs, and all three are one-shots so he stays down. THERE IS NO DROWN ANIMATION ANYWHERE
	//IN THE SET: the full 2089-alias chain for both models on this map carries no drown, swim or wade
	//death, so the drowning is told by the water and the fall, not by the skeleton.
	self exec global/setdeathanim.scr death_mortar

	//BLOOD IN THE COLUMN, AND IT MUST BE UNDER -520. coop_bloodcloud is `wateronly`, so an emitter
	//above the surface has every particle culled on its first tick and the effect is silently
	//invisible (bug-2359). His origin is his feet on the sand at -576, so +34 puts the cloud at -542,
	//22 clear of the surface; the clamp covers the shallower sand seaward of y -2850.
	local.bp = self.origin
	local.bp[2] = local.bp[2] + 34
	if(local.bp[2] > ( 0 - 530 )){ local.bp[2] = 0 - 530 }
	local.bl = spawn "models/fx/coop_bloodcloud.tik"
	if(local.bl != NULL && local.bl != NIL){			//entity-pool guard
		local.bl.origin = local.bp
		local.bl notsolid
		local.bl anim start
		thread coop_fxCleanup local.bl 11
	}

	println("^~^~^ UNDERWADE kill seat=" + local.seat + " org=" + self.origin)

	//the stagger, then the one that drops him. maps/m3l1a.scr::bhit is retail's own kill recipe and
	//what every other coop death on this beach already uses. The location argument is written
	//( 0 - 1 ) rather than -1: both forms parse and both appear in this file, but a bare negative in
	//a command argument slot is one of this project's parse killers and is not worth the coin flip.
	self thread maps/m3l1a.scr::bhit 40 ( 0 - 1 )
	wait 0.16
	if(self == NULL || self == NIL){ end }
	if(isalive self){ self thread maps/m3l1a.scr::bhit 1000 ( 0 - 1 ) }
	wait 0.35

	if(self == NULL || self == NIL){ end }

	//and a second cloud where he actually came to rest, which is not where he was standing once the
	//death animation has thrown him
	local.b2 = self.origin
	local.b2[2] = local.b2[2] + 26
	if(local.b2[2] > ( 0 - 530 )){ local.b2[2] = 0 - 530 }
	local.c2 = spawn "models/fx/coop_bloodcloud.tik"
	if(local.c2 != NULL && local.c2 != NIL){		//entity-pool guard
		local.c2.origin = local.b2
		local.c2 notsolid
		local.c2 anim start
		thread coop_fxCleanup local.c2 10
	}

	//He lies on the bottom for the rest of the beat and the first seconds of play, then the edict
	//comes back. 45s puts the removal well behind a player who is by then up the sand.
	thread coop_fxCleanup self 45
}end


//=========================================================================
//[user 2026-09-03] THE OMAHA VOICE BANK - the finished retail Omaha lines that nothing plays.
//
//WHAT IS BEING ADDED. 21 finished, voice-acted, subtitled, lip-synced Omaha lines that ship in
//War Chest and that no code in any of the three games has ever played. They are not new content
//and they are not generic barks: every one is a scripted m3l1 line with its own .wav, its own
//alias in uberdialog.scr, and its own .skc lipsync animation in
//models/human/animation/dialogue/M3L1_dialogue_US.tik (which is $included by every dday_ranger_*
//and dday_29th_* model through generic_dialogue_US.tik's `includes test m3l1` block).
//
//FOUR OF THE ORIGINAL TWENTY-FIVE ARE GONE, AND EACH FOR A HARD REASON:
//  008a "Take the sides! Take the sides! Go! Go!" is the over-the-gunwale disembark order. It was
//    to fire 0.9s after ranger10's SIGN-OFF (007a, "I'll see you on the beach") with the boat
//    still 1800+ units offshore, which reads as a bug. Its .skc is precached by m3l1b.min and NOT
//    by m3l1a.min: it is the next map's line. Its only correct beat here is the ramp exit, which
//    is exactly the window where coop_voxCut is 0 and coop_rampScreams owns the audio. Dropped.
//  060f "We can't stay here! They're concentrating artillery on us! Displace!" is now SPOKEN by
//    the map, in higgins3_ranger5_2_left_speak (the [CUT-CONTENT RESTORE] block that prints
//    ^~^~^ CUTVOX 060f, in sequence 2). Placing it again would be a double play of a distinctive
//    line, with its subtitle, twice in one mission. Dropped; its 064a/065a follow-up survives and
//    is now the whole of that slot.
//  076a "Powell, we need some bangalores up here" and 077a "bring up some bangalores" are now
//    SPOKEN by the map too, in sequence_9_shingle_start_getbangalores (^~^~^ CUTVOX 076a / 077a).
//    Dropped for the same reason; that beat keeps 081e/082g and 087a.
//The three CUTVOX lines were restored by a sibling patch in this same run. Re-check them before
//applying this: if that restore is ever reverted, 060f/076a/077a become placeable here again.
//
//WHY `say` AND NOT `playsound`, AND WHY THE RETAIL ALIAS NAMES.  Actor::SoundSayAnim
//(fgame/actor.cpp) looks the alias name up as an ANIMATION first and only falls through to a bare
//Sound() when there is no anim by that name. With the anim, the mouth moves, and the alias's
//`first sound` fires CLIENT-side through CG_PlaySound - which is the only path in this engine that
//shows a subtitle in coop at all: the server-side Entity::Sound subtitle block is gated on
//`g_gametype->integer == GT_SINGLE_PLAYER` (fgame/entity.cpp:3803). So `playsound` here would cost
//both the lipsync and the subtitle. For the same reason NOTHING here is re-declared under a coop_*
//alias - coop_advanceOnSmoke already learned that ("the .skc ships only under the original name").
//
//RANGE IS A HARD START GATE, NOT A ROLLOFF. S_OPENAL_ShouldStart (client/snd_openal_new.cpp)
//returns Square(maxDist) > distSquared and gates pChannel->play() outright. Every one of these
//aliases is 200/1500 or 200-600/2500, so a line spoken more than maxDist from a listener does not
//arrive faint - it never plays. Every unscripted placement therefore tests the distance to the
//NEAREST player first, at 1100, which leaves headroom for a player moving during the line.
//
//THE BUS, AND THE THING THE FIRST DRAFT GOT WRONG. bug-2307 and bug-2324 are the two reports that
//matter: "its almost like these guys are constantly programmed to say random shit all of the time.
//it's way too common." That fix set coop_mod/aivoice.scr to ONE concurrency slot held 7-13s
//(aivoice.scr:244), i.e. the whole level speaks about once every ten seconds. This block borrows
//that same slot array rather than opening a second bus.
//
//The first draft claimed "an authored line and a generic bark can never land together, in either
//direction" and only ever WROTE the bus. Writing it stops a bark that has not started yet. It does
//nothing about the other direction, and nine placements began a line without ever READING it:
//every retail-hooked slot, and every follow-up sitting in a gap longer than the hold the previous
//line had taken (coop_vbDisplace waited 9s against a 6.81s hold; coop_vbBangalore waited 12/10/8s
//against ~4.3/4.7/4.4s holds). aivoice claims its slot for 7-13s, so a bark starting in any of
//those windows talked straight over an authored line.
//
//SO THE BUS IS NOW CLAIM/RELEASE, AND EVERY SLOT USES IT:
//  coop_vbClaim   waits, bounded, for the bus to go quiet - our own acoustic hold, our own owner
//                 token, AND all four of aivoice's slots - then takes it. This is the direction
//                 that was missing. On success it parks aivoice immediately, so nothing can start
//                 in the gap between the claim and the first `say`.
//  coop_vbSay     speaks on a bus the caller already owns, and re-parks it for the measured length
//                 of the line plus 1.2s of tail.
//  coop_vbWait    the ONLY way to wait INSIDE a claimed section. It re-parks the bus in chunks of
//                 at most 1.5s, so a deliberate beat between two sentences of one speech never
//                 becomes a window a bark can start in.
//  coop_vbRelease gives it back. The acoustic tail from the last line stays and expires by itself.
//A slot that dies without releasing cannot wedge the bus: level.coop_vbLease is a short lease that
//coop_vbSay and coop_vbWait refresh, and coop_vbOpen treats an expired lease as free. Gaps BETWEEN
//beats of a slot are deliberately left unclaimed (a plain `wait`), so this block never mutes the
//level for tens of seconds at a stretch - the next beat simply claims again.
//
//It also refuses to speak within 8s of a level.m3l1a_sequence change, which is exactly when
//retail's own scripted conversations fire, and never inside the ramp cinematic - coop_rampDone 0
//is the window where coop_rampAudioCut has taken coop_voxCut to ZERO, so a dialogue line placed
//there would play at 5% into a set piece coop_rampScreams already owns.
//
//WHAT IS DELIBERATELY NOT HERE. The two commented-out call sites (dfr_M3L1_300f and
//streamed_dfr_scripted_M3L1_035d) are a separate piece of work and are NOT touched here - placing
//them twice would be the defect. Two lines are genuinely unrecoverable: the call at :3770 names
//streamed_dfr_scripted_M3L1_019f-2, for which no alias and no wav exist under any name in any pak
//of any of the three games, and dfr_scripted_M3L1_090f points at a ..._090g.wav that does not ship
//(its sibling alias, confusingly named _090g, points at _090f.wav, which does ship and IS spoken).
//109d/110f/111h and den_scripted_M3L1_05b are m3l1b content - retail's own maps/m3l1b.scr speaks
//109d/110f/111h in its ditch and finish sequences. dfr_scripted_M3L1_030g and _032g are ALTERNATE
//TAKES of two lines this map already speaks verbatim.
//
//AND ONE CORRECTION, MEASURED. ubersound/coop_aivoice.scr:361-363 asserts that
//dfr_scripted_M3L1_034e ("My gut's been torn out!") ships only as a .lip and .skc and never as a
//.wav. That is wrong, and it is the pak-only-scan error bug-2386 already retracted once: the file
//is LOOSE at main/sound/dialogue/m3l1/a/dfr_scripted_m3l1_034e.wav, 72,826 bytes, 1.62s. The line
//is already spoken by this map and it works. Nothing here needs to place it.
//=========================================================================
coop_vbInit:{
//=========================================================================
	if(level.coop_vbInit == 1){ end }
	level.coop_vbInit = 1

	//BORROW AIVOICE'S BUS, DO NOT OPEN A SECOND ONE. aivoice_init may not have run yet (it is
	//registered per-actor from aihandler), so WRITE the four slots rather than reading them - a
	//write creates the array, a read of an unset array element does not. If aivoice_init runs
	//after this it re-stamps them to its own idle value, which only frees the bus early.
	if(level.coop_aivoiceInit != 1){
		level.coop_avSlot[0] = 0 - 1000
		level.coop_avSlot[1] = 0 - 1000
		level.coop_avSlot[2] = 0 - 1000
		level.coop_avSlot[3] = 0 - 1000
	}

	//EVERY var this block later COMPARES is written here, once. An unset level var reads `none`
	//and `none == 1` throws; a thrown statement is SKIPPED, which would quietly turn the owner
	//token into "always free" and put the collision straight back.
	level.coop_vbUntil = 0
	level.coop_vbSeqAt = 0
	level.coop_vbCount = 0
	level.coop_vbBusy = 0
	level.coop_vbLease = 0
	println("^~^~^ VOICEBANK init t=" + level.time)
}end

//MAY A LINE PHYSICALLY START RIGHT NOW? The concurrency answer only: our own acoustic hold, our
//own owner token, aivoice's four slots, and the one hard veto (the ramp cinematic). No politeness.
//Contains no `wait`, which is what makes the test-then-claim pair inside coop_vbClaim atomic.
//=========================================================================
coop_vbOpen:{
//=========================================================================
	local.r = 1

	//THE OWNER TOKEN, WITH A LEASE. A slot holds this across a whole speech so a second slot
	//cannot interleave between two of its sentences. The lease is what stops a slot that died on
	//an early `end` from wedging the bus for the rest of the mission: once it goes stale the token
	//is cleared here, by whoever asks next.
	if(level.coop_vbBusy == 1){
		if(level.coop_vbLease != NIL && level.time < level.coop_vbLease){ local.r = 0 }
		else{ level.coop_vbBusy = 0 }
	}

	if(local.r == 1 && level.coop_vbUntil != NIL){
		if(level.time < level.coop_vbUntil){ local.r = 0 }
	}

	//NEVER SPEAK INSIDE THE RAMP SET PIECE. coop_rampCinematic stamps level.coop_rampDone = 0 when
	//it starts and coop_rampHandoff stamps 1 on every exit path it has, including the anti-strand
	//watchdog - so 0 means "the cinematic owns this beat". That window is also where
	//coop_rampAudioCut has taken coop_voxCut to ZERO, so a dialogue line placed in it would be
	//inaudible, and where coop_rampScreams is staging five cries. NIL means the cinematic never
	//started, which must NOT block - otherwise a bail path would mute this block for the map.
	if(local.r == 1 && level.coop_rampDone != NIL && level.coop_rampDone != NULL){
		if(level.coop_rampDone == 0){ local.r = 0 }
	}

	//aivoice's own slots. Read them ONLY once aivoice has published them.
	if(local.r == 1 && level.coop_aivoiceInit == 1){
		local.i = 0
		while(local.i < 4){
			if(level.time < level.coop_avSlot[local.i]){ local.r = 0 }
			local.i++
		}
	}
}end local.r

//IS THIS A GOOD MOMENT? coop_vbOpen plus one politeness rule: stay out of retail's own scripted
//conversations, which all fire within a few seconds of a sequence change. Only the OPPORTUNISTIC
//placements consult this. A slot hooked into a retail beat IS the scripted moment, and must not
//hold itself off for eight seconds because of it.
//=========================================================================
coop_vbFree:{
//=========================================================================
	local.r = waitthread coop_vbOpen
	if(local.r == 1 && level.coop_vbSeqAt != NIL){
		if(level.time < ( level.coop_vbSeqAt + 8 )){ local.r = 0 }
	}
}end local.r

//Park the bus for local.secs. Writing aivoice's slots is what stops a generic bark landing on top
//of an authored line; writing our own var is what stops two of ours doing it.
//=========================================================================
coop_vbHold local.secs:{
//=========================================================================
	if(local.secs == NIL){ local.secs = 3 }
	local.u = level.time + local.secs
	level.coop_vbUntil = local.u
	level.coop_avSlot[0] = local.u
	level.coop_avSlot[1] = local.u
	level.coop_avSlot[2] = local.u
	level.coop_avSlot[3] = local.u
}end

//TAKE THE BUS. Waits up to local.maxwait seconds for it to go quiet, then claims it; returns 1 if
//it got it. THIS IS THE DIRECTION THE FIRST DRAFT WAS MISSING - without it a slot spoke over a
//bark that was already running, because writing the bus only ever stopped a bark that had not.
//  local.maxwait  how long this beat may be delayed. Sized per caller: short where a retail line
//                 is queued behind us, generous where nothing is.
//  local.tag      what to print on a timeout, so a line that never played is explained in the log.
//=========================================================================
coop_vbClaim local.maxwait local.tag:{
//=========================================================================
	if(local.maxwait == NIL){ local.maxwait = 3 }
	if(local.tag == NIL){ local.tag = "?" }
	local.got = 0
	local.spun = 0
	while(local.got == 0 && local.spun <= local.maxwait){
		local.f = waitthread coop_vbOpen
		//NOTHING WAITS BETWEEN THE TEST AND THE STAMP. The VM runs one script thread until that
		//thread waits, and coop_vbOpen never waits, so this pair cannot be interleaved by another
		//slot. It is the same assumption aivoice_say makes when it scans the slots then writes one.
		if(local.f == 1){
			level.coop_vbBusy = 1
			level.coop_vbLease = level.time + 5
			local.got = 1
		}
		else{
			wait 0.25
			local.spun = local.spun + 0.25
		}
	}
	if(local.got == 1){
		//park aivoice immediately: a bark must not be able to start in the gap between this claim
		//and the first `say`. coop_vbSay re-parks it for the real length of each line.
		waitthread coop_vbHold 2
	}
	else{
		println("^~^~^ VOICEBANK busy tag=" + local.tag)
	}
}end local.got

//GIVE THE BUS BACK. The acoustic hold from the last line stays where coop_vbSay left it, so the
//1.2s tail after the final syllable is still protected; only the owner token is dropped.
//=========================================================================
coop_vbRelease:{
//=========================================================================
	level.coop_vbBusy = 0
	level.coop_vbLease = level.time
}end

//THE ONLY WAY TO WAIT INSIDE A CLAIMED SECTION. A plain `wait 9` between two lines of one speech
//leaves the bus unheld the moment the first line's tail expires, and aivoice takes it - which is
//exactly how the follow-ups in coop_vbDisplace and coop_vbBangalore were being talked over.
//Re-parks in short chunks, so a thread that dies here leaves at most ~3.5s of stale hold.
//=========================================================================
coop_vbWait local.secs:{
//=========================================================================
	if(local.secs == NIL){ local.secs = 1 }
	local.n = local.secs
	while(local.n > 0.01){
		local.s = local.n
		if(local.s > 1.5){ local.s = 1.5 }
		waitthread coop_vbHold ( local.s + 2 )
		level.coop_vbLease = level.time + local.s + 3
		wait local.s
		local.n = local.n - local.s
	}
}end

//THE ONE PLACE A LINE IS EVER SPOKEN. THE CALLER MUST ALREADY OWN THE BUS (coop_vbClaim).
//  local.who     the speaker. Must exist and be alive AT THIS INSTANT, not when it was chosen.
//  local.alias   the retail alias name, verbatim - it is also the lipsync anim name.
//  local.secs    the MEASURED length of the wav, in seconds. Drives the bus hold; nothing here
//                waits on saydone, which would park forever on an actor that dies mid-line.
//  local.rng     distance gate to the nearest player. NIL = 1100. 0 = skip (the caller is a
//                retail beat that only fires when a player is already standing there).
//  local.busyok  1 = the caller IS the actor's scripted sequence, so isinsequence is expected.
//=========================================================================
coop_vbSay local.who local.alias local.secs local.rng local.busyok:{
//=========================================================================
	local.ok = 0
	local.go = 1
	if(local.secs == NIL){ local.secs = 3 }
	if(local.rng == NIL){ local.rng = 1100 }

	if(local.go == 1){ if(local.who == NULL || local.who == NIL){ local.go = 0 } }
	if(local.go == 1){ if(local.alias == NIL || local.alias == ""){ local.go = 0 } }
	if(local.go == 1){ if(!isalive local.who){ local.go = 0 } }
	if(local.go == 1 && local.busyok != 1){
		if(local.who.isinsequence == 1){ local.go = 0 }
	}
	if(local.go == 1 && local.busyok != 1){
		if(local.who.isbusy == 1){ local.go = 0 }
	}
	if(local.go == 1 && local.rng > 0){
		local.pl = exec coop_mod/replace.scr::player_closestTo local.who
		if(local.pl == NULL || local.pl == NIL){ local.go = 0 }
		else{
			if(( vector_length( local.pl.origin - local.who.origin ) ) > local.rng){ local.go = 0 }
		}
	}

	if(local.go == 1){
		waitthread coop_vbHold ( local.secs + 1.2 )
		//hold the owner token open for the whole line, so the lease can never go stale underneath
		//a speaker who is still talking.
		level.coop_vbLease = level.time + local.secs + 3
		local.who say local.alias
		if(level.coop_vbCount == NIL){ level.coop_vbCount = 0 }
		level.coop_vbCount++
		//SANITISE BEFORE CONCATENATING - "str" + none THROWS, and a thrown println prints nothing
		//at all, which is exactly how a beat gets read as absent by a log census.
		local.tn = local.who.targetname
		if(local.tn == NIL || local.tn == NULL){ local.tn = "?" }
		println("^~^~^ VOICEBANK say alias=" + local.alias + " by=" + local.tn + " t=" + level.time + " n=" + level.coop_vbCount)
		local.ok = 1
	}
}end local.ok

//First live, idle, in-range member of a numbered family. Same $( "name" + i ) idiom
//coop_rampScreams uses.
//=========================================================================
coop_vbFind local.base local.lo local.hi:{
//=========================================================================
	local.pick = NULL
	local.i = local.lo
	while(local.i <= local.hi && local.pick == NULL){
		local.e = $( local.base + local.i )
		if(local.e != NULL && local.e != NIL){
			if(isalive local.e){
				if(local.e.isinsequence != 1 && local.e.isbusy != 1){
					local.pl = exec coop_mod/replace.scr::player_closestTo local.e
					if(local.pl != NULL && local.pl != NIL){
						if(( vector_length( local.pl.origin - local.e.origin ) ) < 1000){ local.pick = local.e }
					}
				}
			}
		}
		local.i++
	}
}end local.pick

//A speaker from anywhere on the beach, tried nearest-group first.
//=========================================================================
coop_vbAnyone:{
//=========================================================================
	local.p = waitthread coop_vbFind "higgins1_ranger" 6 10
	if(local.p == NULL){ local.p = waitthread coop_vbFind "higgins3_ranger" 1 5 }
	if(local.p == NULL){ local.p = waitthread coop_vbFind "higgins5_ranger" 1 5 }
	if(local.p == NULL){ local.p = waitthread coop_vbFind "shingle_wave" 1 18 }
	if(local.p == NULL){ local.p = waitthread coop_vbFind "shingle_ranger" 2 7 }
}end local.p

//Every slot hooked into a retail beat opens with the same three checks. One label, so a kill
//switch added later cannot end up on three of the four.
//=========================================================================
coop_vbHookOk:{
//=========================================================================
	local.r = 1
	if(level.gametype == 0){ local.r = 0 }
	if(local.r == 1){
		if(level.coop_vbOn == NIL){ level.coop_vbOn = 1 }
		if(!level.coop_vbOn){ local.r = 0 }
	}
	if(local.r == 1){ waitthread coop_vbInit }
}end local.r


//=========================================================================
//THE MANAGER. Threaded once from m3l1a.scr::main. Owns the sequence-change clock that keeps this
//block out of retail's conversations, and dispatches the four beats that have no retail line to
//hang off. Each is a one-shot that claims and releases the bus for itself.
//=========================================================================
coop_beachVoiceBank:{
//=========================================================================
	if(level.gametype == 0){ end }
	if(level.coop_vbOn == NIL){ level.coop_vbOn = 1 }
	if(!level.coop_vbOn){
		println("^~^~^ VOICEBANK off")
		end
	}
	waitthread coop_vbInit

	//variable_prep is threaded AFTER this block in main:, so level.m3l1a_sequence and
	//level.progress are not set yet. Three seconds is the same settle the other beach threads use.
	wait 3

	local.seq = 0 - 1
	println("^~^~^ VOICEBANK watch up")

	thread coop_vbChatter

	while(1){
		wait 1

		//SEQUENCE CLOCK. Retail's scripted conversations all fire within a few seconds of a
		//sequence change, so stamp the change and let coop_vbFree hold everything off for 8s.
		if(level.m3l1a_sequence != NIL && level.m3l1a_sequence != NULL){
			if(level.m3l1a_sequence != local.seq){
				local.seq = level.m3l1a_sequence
				level.coop_vbSeqAt = level.time
			}
		}

		if(level.coop_vbDone == 1){ break }

		//DISPATCH ONLY. Every slot is threaded and does its own claim, so this loop keeps
		//servicing the sequence clock while a slot is waiting its turn on the bus. Each slot
		//stamps its own done-flag as its first statement, and this loop's own `wait 1` is a full
		//second of margin against dispatching the same slot twice.
		local.free = waitthread coop_vbFree
		if(local.free == 1){
			//--- the soaked private, at the first ramps -------------------
			if(local.seq >= 2 && local.seq <= 5 && level.coop_vbGearDone != 1){
				thread coop_vbGear
			}
			//--- more artillery inbound, long after the map's own displace order ---
			else if(local.seq >= 5 && local.seq <= 8 && level.coop_vbDispDone != 1){
				thread coop_vbDisplace
			}
			//--- keep it moving, off the shingle -------------------------
			else if(local.seq >= 10 && local.seq <= 11 && level.coop_vbMoveDone != 1){
				thread coop_vbMove
			}
			//--- eyes open, at the bunker --------------------------------
			else if(local.seq >= 11 && level.coop_vbEyesDone != 1){
				thread coop_vbEyes
			}
		}
	}
	println("^~^~^ VOICEBANK watch done n=" + level.coop_vbCount)
}end

//THE THREE-LINE EXCHANGE THE BEACH NEVER GOT. 027b/028e/029b are consecutive numbers and they read
//as one scene: an officer stops a man who came out of the water with nothing.
//   "Where's your gear, Private?" / "Had to ditch it, sir, almost drowned!" / "Grab some weapons
//   and follow me!"
//ONE CLAIM FOR ALL THREE. The 1.5s and 2.7s beats between them are inside the speech, not gaps in
//it, so they go through coop_vbWait and the bus is never let go mid-conversation.
//=========================================================================
coop_vbGear:{
//=========================================================================
	if(level.coop_vbGearDone == 1){ end }
	level.coop_vbGearDone = 1

	//An officer first - higgins3_ranger5 and higgins5_ranger4/5 are the lieutenant and sergeants of
	//the two flanking boats. Through coop_vbFind, NOT by bare name, so a candidate who is alive but
	//eight hundred units up the beach is skipped rather than picked and then silently dropped by
	//the range gate on every retry. If none is free, anyone will do: the line names a rank, not a
	//man. All of this runs BEFORE the claim - coop_vbFind never waits, so it costs the bus nothing.
	local.off = waitthread coop_vbFind "higgins3_ranger" 5 5
	if(local.off == NULL){ local.off = waitthread coop_vbFind "higgins5_ranger" 4 5 }
	if(local.off == NULL){ local.off = waitthread coop_vbAnyone }
	if(local.off == NULL){
		//nothing has been waited on yet, so giving the flag back cannot re-enter a running copy
		level.coop_vbGearDone = NIL
		println("^~^~^ VOICEBANK gear retry reason=no_officer")
		end
	}

	//and the man he is talking to. Never the same actor - one throat, two voices, is the exact
	//failure coop_rampScreams calls out.
	local.pri = waitthread coop_vbFind "higgins3_ranger" 1 3
	if(local.pri == local.off){ local.pri = NULL }
	if(local.pri == NULL){ local.pri = waitthread coop_vbFind "higgins5_ranger" 1 3 }
	if(local.pri == local.off){ local.pri = NULL }
	if(local.pri == NULL){
		level.coop_vbGearDone = NIL
		println("^~^~^ VOICEBANK gear retry reason=no_private")
		end
	}

	local.claim = waitthread coop_vbClaim 4 "gear"
	if(local.claim != 1){
		level.coop_vbGearDone = NIL
		end
	}

	local.off lookat local.pri
	local.pri lookat local.off

	local.said = waitthread coop_vbSay local.off "dfr_scripted_M3L1_027b" 1.11 1100 0
	if(local.said != 1){
		local.off lookat NULL
		local.pri lookat NULL
		waitthread coop_vbRelease
		level.coop_vbGearDone = NIL
		println("^~^~^ VOICEBANK gear retry at=027b")
		end
	}
	waitthread coop_vbWait 1.5

	waitthread coop_vbSay local.pri "streamed_dfr_scripted_M3L1_028e" 2.28 1400 0
	waitthread coop_vbWait 2.7

	waitthread coop_vbSay local.off "dfr_scripted_M3L1_029b" 1.53 1400 0
	waitthread coop_vbWait 1.9

	waitthread coop_vbRelease
	local.off lookat NULL
	local.pri lookat NULL
	println("^~^~^ VOICEBANK gear done")
}end

//THE ARTILLERY IS WALKING ONTO US, TAKE TWO. The map now speaks 060f itself, back in sequence 2
//(the [CUT-CONTENT RESTORE] block in higgins3_ranger5_2_left_speak), so this slot is no longer the
//order - it is the escalation several sequences later: 064a "Powell! There's more artillery
//inbound! Move out now!" or 065a "Powell! They're concentrating fire on our position! Move out
//now!", one take per run. Both are still unplayed by anything, and both name Powell - the player -
//which nothing else on this beach does.
//=========================================================================
coop_vbDisplace:{
//=========================================================================
	if(level.coop_vbDispDone == 1){ end }
	level.coop_vbDispDone = 1

	local.a = "streamed_dfr_scripted_M3L1_064a"
	local.d = 2.97
	if(( randomint 2 ) == 1){
		local.a = "streamed_dfr_scripted_M3L1_065a"
		local.d = 3.88
	}

	local.o = waitthread coop_vbFind "higgins1_ranger" 10 10
	if(local.o == NULL){ local.o = waitthread coop_vbAnyone }
	if(local.o == NULL){
		level.coop_vbDispDone = NIL
		println("^~^~^ VOICEBANK displace retry reason=no_speaker")
		end
	}

	local.claim = waitthread coop_vbClaim 4 "displace"
	if(local.claim != 1){
		level.coop_vbDispDone = NIL
		end
	}
	local.said = waitthread coop_vbSay local.o local.a local.d 1100 0
	waitthread coop_vbRelease

	if(local.said != 1){
		level.coop_vbDispDone = NIL		//nobody was in range - let it come round again
		println("^~^~^ VOICEBANK displace retry")
		end
	}
	println("^~^~^ VOICEBANK displace done alt=" + local.a)
}end

//"Come on, come on, keep it moving, let's go." Off the shingle, once.
//=========================================================================
coop_vbMove:{
//=========================================================================
	if(level.coop_vbMoveDone == 1){ end }
	level.coop_vbMoveDone = 1

	local.m = waitthread coop_vbAnyone
	if(local.m == NULL){
		level.coop_vbMoveDone = NIL
		end
	}
	local.claim = waitthread coop_vbClaim 4 "move"
	if(local.claim != 1){
		level.coop_vbMoveDone = NIL
		end
	}
	local.said = waitthread coop_vbSay local.m "streamed_dfr_scripted_M3L1_086e" 3.16 2200 0
	waitthread coop_vbRelease
	if(local.said != 1){
		level.coop_vbMoveDone = NIL
		println("^~^~^ VOICEBANK move retry")
		end
	}
	println("^~^~^ VOICEBANK move done")
}end

//"Keep your eyes open!" at the bunker, and the last thing this block says. Setting coop_vbDone
//stops the manager loop for the rest of the map.
//=========================================================================
coop_vbEyes:{
//=========================================================================
	if(level.coop_vbEyesDone == 1){ end }
	level.coop_vbEyesDone = 1

	local.m = NULL
	if($shingle_ranger1 != NULL){
		if(isalive $shingle_ranger1){ local.m = $shingle_ranger1 }
	}
	if(local.m == NULL){ local.m = waitthread coop_vbAnyone }
	if(local.m == NULL){
		level.coop_vbEyesDone = NIL
		end
	}
	local.claim = waitthread coop_vbClaim 4 "eyes"
	if(local.claim != 1){
		level.coop_vbEyesDone = NIL
		end
	}
	local.said = waitthread coop_vbSay local.m "dfr_scripted_M3L1_097d" 1.25 1100 0
	waitthread coop_vbRelease
	if(local.said != 1){
		level.coop_vbEyesDone = NIL
		println("^~^~^ VOICEBANK eyes retry")
		end
	}
	level.coop_vbDone = 1
	println("^~^~^ VOICEBANK eyes done")
}end

//"Any senior noncom, take the men off the beach!" - the divisional order, on the radio the map
//already has a man kneeling over. Threaded (not waitthread) from sequence_5_center_radioman so his
//radioman animation starts on time; the 6s wait puts this after his own 036h has finished.
//=========================================================================
coop_vbRadio:{
//=========================================================================
	local.ok = waitthread coop_vbHookOk
	if(local.ok != 1){ end }
	if(level.coop_vbRadioDone == 1){ end }
	level.coop_vbRadioDone = 1

	//036h is 4.6s and retail clears isinsequence the instant it starts it, so wait the line out
	//rather than the flag.
	wait 6
	if(self == NULL || self == NIL){
		println("^~^~^ VOICEBANK radio skip reason=no_self")
		end
	}
	//nothing is queued behind this one, so it can afford to sit out a whole bark (7-13s).
	local.claim = waitthread coop_vbClaim 10 "radio"
	if(local.claim != 1){ end }
	waitthread coop_vbSay self "streamed_dfr_scripted_M3L1_045a" 4.51 1400 1
	waitthread coop_vbRelease
}end

//"Powell, get the men up the beach! You lead one side, I'll take the other!" 062a_1 is the ORDER
//and retail's 063a, immediately below this call, is the detail that follows it. waitthread, not
//thread: they are one speech from one man and must not overlap.
//THE ONE PLACE THE CLAIM IS DELIBERATELY IMPATIENT. A retail line is queued behind this one, so a
//long wait would delay 063a rather than this. Three seconds, then give up: losing 062a_1 to a bark
//that is already running is a better outcome than either talking over it or stalling the map.
//=========================================================================
coop_vbCraters:{
//=========================================================================
	local.ok = waitthread coop_vbHookOk
	if(local.ok != 1){ end }
	if(level.coop_vbCraterDone == 1){ end }
	level.coop_vbCraterDone = 1

	if(self == NULL || self == NIL){ end }
	local.claim = waitthread coop_vbClaim 3 "craters"
	if(local.claim != 1){ end }
	local.said = waitthread coop_vbSay self "dfr_scripted_M3L1_062a_1" 4.38 0 1
	if(local.said == 1){ waitthread coop_vbWait 4.8 }
	waitthread coop_vbRelease
}end

//THE BANGALORE BEAT, WHAT IS LEFT OF IT. The map now says 076a and 077a itself (the
//[CUT-CONTENT RESTORE] block just above the anchor), so this slot is only the two lines still
//unplayed: 081e/082g, the carriers answering, one take per run - and 087a, the shout that passes
//them up the line. The opening 22s is exactly what used to be 076a + wait 12 + 077a + wait 10, so
//both land where they did before: after retail's 078d SPLAT and its 079a, and not on top of them.
//The gap between the two beats is a PLAIN wait, not coop_vbWait: that is a genuine silence in the
//middle of a firefight and a bark is welcome in it. The second beat simply claims again.
//=========================================================================
coop_vbBangalore:{
//=========================================================================
	local.ok = waitthread coop_vbHookOk
	if(local.ok != 1){ end }
	if(level.coop_vbBangDone == 1){ end }
	level.coop_vbBangDone = 1

	wait 22

	//the carriers answering - ONE take of two. 082g's alias name is declared twice in
	//uberdialog.scr (:592 and :42248) and the engine does NOT de-duplicate it, because
	//Alias_ListAdd's dedupe is strcmp against an already-lowercased stored name and this name has
	//capitals, so both nodes are added and Alias_FindRandom picks one at random. Both nodes are the
	//same LINE in two takes, so the coin flip is harmless - but the hold is sized for the longer of
	//the two (3.51s), not the shorter.
	local.a = "streamed_dfr_scripted_M3L1_081e"
	local.d = 2.18
	if(( randomint 2 ) == 1){
		local.a = "streamed_dfr_scripted_M3L1_082g"
		local.d = 3.51
	}
	local.c = waitthread coop_vbFind "shingle_wave" 1 18
	if(local.c == NULL){ local.c = waitthread coop_vbAnyone }
	if(local.c != NULL){
		local.claim = waitthread coop_vbClaim 10 "bang_carriers"
		if(local.claim == 1){
			waitthread coop_vbSay local.c local.a local.d 2200 0
			waitthread coop_vbRelease
		}
	}
	wait 8

	local.e = waitthread coop_vbFind "shingle_wave" 1 18
	if(local.e == NULL){ local.e = waitthread coop_vbAnyone }
	if(local.e != NULL){
		local.claim = waitthread coop_vbClaim 10 "bang_upline"
		if(local.claim == 1){
			waitthread coop_vbSay local.e "dfr_scripted_M3L1_087a" 1.50 2200 0
			waitthread coop_vbRelease
		}
	}
	println("^~^~^ VOICEBANK bang done alt=" + local.a)
}end

//"I'll toss some grenades in, then you follow up and light him up!" - the second half of the line
//the trench ranger already speaks. 106f is "Hold up! There's an MG-42 covering the length of this
//tunnel!"; 107f is what he says next, and retail stops after the first sentence. waitthread from
//mg42_bunker, between his existing `wait 1` and his trench_idle_down: one man, two sentences.
//A wait of up to 6s here only holds his own idle animation, so this claim can afford to be patient.
//=========================================================================
coop_vbTunnel:{
//=========================================================================
	local.ok = waitthread coop_vbHookOk
	if(local.ok != 1){ end }
	if(level.coop_vbTunnelDone == 1){ end }
	level.coop_vbTunnelDone = 1

	local.m = NULL
	if($trench_ranger != NULL){
		if(isalive $trench_ranger){ local.m = $trench_ranger }
	}
	if(local.m == NULL){
		println("^~^~^ VOICEBANK tunnel skip reason=no_trench_ranger")
		end
	}
	local.claim = waitthread coop_vbClaim 6 "tunnel"
	if(local.claim != 1){ end }
	local.said = waitthread coop_vbSay local.m "streamed_dfr_scripted_M3L1_107f" 3.47 0 1
	if(local.said == 1){ waitthread coop_vbWait 3.7 }
	waitthread coop_vbRelease
}end

//THE FOUR SHORT ONES. Not a loop that keeps talking - four one-shot lines, each tied to the stretch
//of beach its words belong to, each spoken once in a whole playthrough and only when the level is
//already quiet. level.progress is the map's own zone variable (m3l1a.scr::progress_player).
//=========================================================================
coop_vbChatter:{
//=========================================================================
	if(level.coop_vbChatOn == NIL){ level.coop_vbChatOn = 1 }
	if(!level.coop_vbChatOn){ end }

	//BOUNDED. A zone the players never linger in leaves its line unspoken, and without a cap this
	//would then be a thread polling at 0.25 Hz for the rest of the mission. 600 iterations is at
	//least 40 minutes of wall clock and more once a claim spins or a line's cooldown is counted -
	//longer than any run of this map either way, and it still terminates.
	local.left = 4
	local.spin = 0
	while(local.left > 0 && local.spin < 600){
		wait 4
		local.spin++

		if(level.coop_vbDone == 1){ break }
		local.free = waitthread coop_vbFree
		if(local.free == 1){
			//read the zone through a guard: level.progress is unset until the player trips the
			//first progress trigger, and an unset level var reads `none` - which throws the moment
			//it is compared or concatenated.
			local.zone = ""
			if(level.progress != NIL && level.progress != NULL){ local.zone = level.progress }

			//A LINE IS NOT CONSUMED UNTIL IT IS ACTUALLY SPOKEN. local.k is the choice; the
			//one-shot flag is stamped only after coop_vbSay reports that it played, so a pick made
			//while every ally is out of alias range is retried rather than silently burned.
			local.k = 0
			local.a = ""
			local.d = 0
			if(local.zone == "shore" && level.coop_vbC1 != 1){
				local.k = 1
				local.a = "streamed_dfr_scripted_M3L1_013c"		//Abandon heavy equipment and head for shore!
				local.d = 2.03
			}
			else if(( local.zone == "shore" || local.zone == "lower_beach" ) && level.coop_vbC2 != 1){
				local.k = 2
				local.a = "dfr_scripted_M3L1_011f"			//Spread out!
				local.d = 0.83
			}
			else if(( local.zone == "lower_beach" || local.zone == "upper_beach" ) && level.coop_vbC3 != 1){
				local.k = 3
				local.a = "dfr_scripted_M3L1_020e"			//Stay down!
				local.d = 1.16
			}
			else if(( local.zone == "upper_beach" || local.zone == "pre_shingle" ) && level.coop_vbC4 != 1){
				local.k = 4
				local.a = "dfr_scripted_M3L1_039g"			//Keep your head down!
				local.d = 1.30
			}

			if(local.k > 0){
				local.said = 0
				local.m = waitthread coop_vbAnyone
				if(local.m != NULL){
					//impatient on purpose: nothing is consumed unless it plays, so giving up after
					//two seconds and coming back in four costs nothing at all.
					local.claim = waitthread coop_vbClaim 2 "chatter"
					if(local.claim == 1){
						local.said = waitthread coop_vbSay local.m local.a local.d 1100 0
						waitthread coop_vbRelease
					}
				}
				if(local.said == 1){
					if(local.k == 1){ level.coop_vbC1 = 1 }
					else if(local.k == 2){ level.coop_vbC2 = 1 }
					else if(local.k == 3){ level.coop_vbC3 = 1 }
					else{ level.coop_vbC4 = 1 }
					local.left--
					wait 20
				}
			}
		}
	}
	println("^~^~^ VOICEBANK chatter done left=" + local.left)
}end

//=========================================================================
//[user 2026-09-03] MAKE THE BUNKERS VISIBLE WHEN THE RAMP DROPS.
//
//"if there is any way we can make the bunkers more visible when we arrive to the stop and the
//higgins doors open ... it can be set back to default once we hit the water."
//
//THEY ARE NOT DIM, THEY ARE CULLED. farplane_cull defaults to qtrue (worldspawn.cpp:586) and
//m3l1a's worldspawn carries no farplane key at all, so the map script is the only source and
//everything past the plane is not drawn. In coop that plane is 7000: main_boat_ride_fog takes
//its coop branch to farplane_done 7000 during the run-in, and the live log agrees -
//"FARPLANE: rolling back fog to: 7000", with g_ddayfog 0.
//
//THE DISTANCES, MEASURED. Every PRB actor.snap row carries dist= to the closest player
//(coop_mod/probe.scr:346). Solving the t=80 sample - the tick the ramp comes down - for the
//player position over its eight actors puts him at (491,-2959,-470) with 0.58 units RMS, and
//with him placed the XY ranges are:
//    mg42_leftbunker2_gunner   7988        mg42_bunker_gunner (casemate)  8789
//    mg42_leftbunker1_gunner   8032        mg42_middle2_gunner            8877
//    mg42_rightbunker1_gunner  8309        mg42_middle1_gunner            8940
//    mg42_rightbunker2_gunner  8341        trench_ranger (the shingle)    7972
//so the whole bluff sits 1000-1950 units past a 7000 plane. NOT four times past it: an earlier
//note measured from higgins1_playerspot's SPAWN origin (352,-7440), which is where the boat
//starts and not where it stops. XY and not 3D because XY is the axis the engine's own clamp
//uses - actorenemy.cpp zeroes vDelta[2] before the range test.
//
//WHY 9600, WITH A WALL ON EACH SIDE.
//  UPPER. AI sight is clamped to farplane_distance * 0.828 (actorenemy.cpp:50, actor.cpp:9144).
//  At 7000 that cap is 5796, which is exactly why every bunker gunner reads hasEnemy=0 at t=80
//  while its line of sight is already clear (see=1). The nearest gunner is at 7988, so any plane
//  from 9648 up hands the MG42 nests a live target on the open ramp. 9600 gives 7948.8 - 39 units
//  under him - so this changes what is DRAWN and provably nothing about who shoots.
//  LOWER. The farthest gun is 8940 and fog reaches solid AT the plane, so the plane must clear it
//  with room. Fog is linear from farplane_bias to farplane and the bias here is 0, for which both
//  renderers substitute 0.18 * farplane (gl1 tr_scene.c:677, gl2 tr_scene.c:807). At 9600 that
//  leaves the near bunkers at 79.5% fog and the deep guns at 91.6%: a dark shape on the bluff
//  rather than a clean bunker, which is the right Omaha read and is the most the upper wall
//  allows. level.coop_rampFogFar is the single number to move, and 9600 is its hard ceiling.
//
//THE COLOUR DOES NOT MOVE WITH THE PLANE, deliberately. farplane_color is the fog's TERMINAL
//colour and is distance-independent - only where the ramp starts and ends changes - and retail's
//own SP high setting already runs this same (.62 .62 .61) at farplane 8300 on this map, both on
//the run-in and on the beach. Moving it would be a mood change nobody asked for and one more
//thing that has to be restored.
//
//IT LIFTS BEFORE THE DOOR, NOT AS IT OPENS. From the whistle the retail sequence is wait 2 to
//door_opening, wait 2.3, then a 0.65s rotate, so the ramp is horizontal at whistle+4.95 and the
//shell lands at whistle+7.90. That is a 2.95s window, and a lift that starts when the doors open
//cannot finish inside it. Starting at the whistle and taking 3.9s means the fog wall has already
//receded before the ramp is down, and it recedes while the ramp is still shut - so there is no
//pop to hide rather than a pop that has been smoothed. 100 units per 0.15s is the same shape as
//main_boat_ride_fog's own ramp at a third of its configstring traffic; every $world farplane call
//is a CS_FOGINFO broadcast to every client (World::UpdateFog).
//
//IT RESTORES ON EVERY PATH, and that is the whole reason this is one self-owning thread instead
//of a set here and a set there. Its only exit is through the ramp-down, and the ramp-down is
//reached from the plunge (level.coop_rampFogRestore, stamped by coop_rampUnderwater), from
//level.coop_rampDone - which coop_rampHandoff stamps on EVERY path it has, including the one
//coop_rampWatchdog forces - and from its own 60s cap. Death and disconnect need no handling at
//all because fog is world state, not player state: there is no player to strand in it.
//
//AND IT NEVER STOMPS ANOTHER OWNER. It records the last value it wrote and re-reads
//$world.farplane before restoring; if anything else moved the fog meanwhile - the map's own
//progress_player writes 6000 the moment a player trips the "shore" area - the restore is
//abandoned rather than fought. It also declines to run at all when a coop_mod/fogmode.scr
//profile is loaded for this map, because that profile's keeper re-applies its own distance every
//two seconds and would win anyway.
//
//WEAK HARDWARE NEEDS NO NEW CVAR - the renderer already caps this. r_picmip is CVAR_ARCHIVE and
//defaults to 1 (tr_init.c:1435); at 2 or above, or with r_colorbits 16, tr_scene.c forces
//tr.farclip to 2800 and then takes the MIN of that and the map's plane, so a low-detail client
//never sees the lift at all. Where it does apply the cost is 9600/8300 = 1.16x the radius the
//retail high setting already shipped on this very map.
//=========================================================================
coop_rampFogLift:{
//=========================================================================
	if(level.coop_rampFogOn == NIL){ level.coop_rampFogOn = 1 }
	if(!level.coop_rampFogOn){ println("^~^~^ RAMPFOG off by level.coop_rampFogOn"); end }
	if(level.coop_fogProfileLoaded == 1){ println("^~^~^ RAMPFOG skipped - a fogmode profile owns this map"); end }
	if(level.coop_rampFogFar == NIL){ level.coop_rampFogFar = 9600 }
	if(level.coop_rampFogRestore == NIL){ level.coop_rampFogRestore = 0 }

	local.from = $world.farplane
	if(local.from == NIL || local.from <= 0){ local.from = 7000 }

	//the upper wall is enforced here and not only in the header: 0.828 * far has to stay under the
	//nearest bunker gunner's 7988 XY, which puts the ceiling at 9647.
	local.far = level.coop_rampFogFar
	if(local.far > 9600){ local.far = 9600 }
	if(local.far <= local.from){ println("^~^~^ RAMPFOG nothing to lift from=" + local.from); end }

	level.coop_rampFogWrote = local.from
	println("^~^~^ RAMPFOG lift from=" + local.from + " to=" + local.far + " aisight=" + ( local.far * 0.828 ))

	local.cur = local.from
	local.n = 0
	while(local.cur < local.far && local.n < 200){
		local.cur = local.cur + 100
		if(local.cur > local.far){ local.cur = local.far }
		$world farplane local.cur
		level.coop_rampFogWrote = local.cur
		local.n = local.n + 1
		wait 0.15
	}
	local.cur = local.far
	$world farplane local.cur
	level.coop_rampFogWrote = local.cur
	println("^~^~^ RAMPFOG up at=" + local.cur + " steps=" + local.n)

	//hold it until we hit the water, or until the beat ends by any route at all
	local.t = 0
	while(local.t < 600 && level.coop_rampFogRestore != 1 && level.coop_rampDone != 1){
		wait 0.1
		local.t = local.t + 1
	}
	local.why = "cap"
	if(level.coop_rampFogRestore == 1){ local.why = "water" }
	else if(level.coop_rampDone == 1){ local.why = "handoff" }

	//somebody else owns the fog now? leave it exactly as they left it.
	local.now = $world.farplane
	if(local.now == NIL){ local.now = level.coop_rampFogWrote }
	if(local.now > level.coop_rampFogWrote + 1 || local.now < level.coop_rampFogWrote - 1){
		println("^~^~^ RAMPFOG restore abandoned why=" + local.why + " fog=" + local.now + " ours=" + level.coop_rampFogWrote)
		end
	}

	local.n = 0
	while(local.cur > local.from && local.n < 200){
		local.cur = local.cur - 200
		if(local.cur < local.from){ local.cur = local.from }
		$world farplane local.cur
		level.coop_rampFogWrote = local.cur
		local.n = local.n + 1
		wait 0.1
	}
	$world farplane local.from
	level.coop_rampFogWrote = local.from
	println("^~^~^ RAMPFOG down at=" + local.from + " why=" + local.why + " t=" + local.t)
}end
