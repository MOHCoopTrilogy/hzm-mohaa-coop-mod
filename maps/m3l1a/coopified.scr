	local.n++; local.bdx[local.n] = 0 - 2800; local.bdy[local.n] = 0 - 863; local.bdz[local.n] = 0 - 498
	local.n++; local.bdx[local.n] = 3184; local.bdy[local.n] = 1129; local.bdz[local.n] = 0 - 474
	local.n++; local.bdx[local.n] = 2280; local.bdy[local.n] = 0 - 1419; local.bdz[local.n] = 0 - 539
	local.n++; local.bdx[local.n] = 2741; local.bdy[local.n] = 0 - 1600; local.bdz[local.n] = 0 - 557
