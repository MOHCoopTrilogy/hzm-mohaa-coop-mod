	while(local.i <= local.n){
		local.p = (0 0 0)
		local.p[0] = local.bdx[local.i]
		local.p[1] = local.bdy[local.i]
		local.p[2] = local.bdz[local.i]

		local.b = spawn script_model model local.tk[((randomint 6) + 1)]
		if(local.b != NULL && local.b != NIL){			//entity-pool guard
