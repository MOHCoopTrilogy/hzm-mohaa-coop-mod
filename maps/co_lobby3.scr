//==========================================================================================================//
// LEVEL:       co_lobby3.bsp   (a copy of m1l2a.bsp)
// TITLE:       HZM Coop - Post-Mission Lobby #3 (m1l2a "jeep / repair depot" staging area)
// FLOW:        ... m1l2a  ->  co_lobby3  ->  m1l2b
// NOTE:        m1l2a's own mission script (objectives, scripted spawns, enemy actors) is NOT run here -
//              co_lobby3.scr only keeps the world geometry, then hands off to the shared coop_mod/lobby.scr.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby3.scr"
	level.coop_aaMap = 1
	level.coop_lobbyMap = 1

	// --- per-lobby framing: the m1l2a "jeep / repair depot" ---
	level.coop_lobbySlotOrg[1] = ( -1122 -1026 -81 )
	level.coop_lobbySlotYaw[1] = 33
	level.coop_lobbySlotOrg[2] = ( -1340 -886 -66 )
	level.coop_lobbySlotYaw[2] = 355
	level.coop_lobbySlotOrg[3] = ( -1000 -823 -70 )
	level.coop_lobbySlotYaw[3] = 333
	level.coop_lobbySlotOrg[4] = ( -1094 -949 -77 )
	level.coop_lobbySlotYaw[4] = 347
	level.coop_lobbyCamOrg = ( -823 -933 -61 )
	level.coop_lobbyCamYaw = 162
	level.coop_lobbyNextMap = "m1l2b"				// completing this lobby launches m1l2b
	level.coop_lobbySkipProps = 1

	waitthread coop_mod/main.scr::main
	level.coop_weatherTheme = "none"

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain
	thread spawnLobby3Objects
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_m1l2a.dat (your removals already applied). 8 props/emitters + 1 animated SAS actor.
//=========================================================================
spawnLobby3Objects:{
//=========================================================================
	local.m = spawn script_model
	local.m model "models/static/vehicle_jeep.tik"
	local.m.origin = ( -1191.614 -734.557 -152.148 )
	local.m.angles = ( 0 202 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/scr536.tik"
	local.m.origin = ( -1257.498 -758.933 -89.696 )
	local.m.angles = ( 270 67 0 )
	local.m notsolid

	// animated actor: SAS relaxing
	local.m = spawn script_model
	local.m model "models/player/allied_sas.tik"
	local.m.origin = ( -1264.362 -694.214 -120.253 )
	local.m.angles = ( 0 292 0 )
	local.m notsolid
	local.m.coop_sceneAnim = "coop_act_relax"
	local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate

	local.m = spawn script_model
	local.m model "models/static/ballpeen_hammer.tik"
	local.m.origin = ( -1121.028 -739.458 -98.152 )
	local.m.angles = ( 0 292 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/wrenches.tik"
	local.m.origin = ( -1213.164 -807.088 -152.114 )
	local.m.angles = ( 0 292 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/miscobj/welding_torch.tik"
	local.m.origin = ( -1270.979 -718.609 -137.585 )
	local.m.angles = ( 0 176 0 )
	local.m scale 0.400
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/miscobj/sc_p_campfire.tik"
	local.m.origin = ( -992.966 -890.181 -145.759 )
	local.m.angles = ( 0 176 0 )
	local.m scale 0.400
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/fx/trucksteam.tik"
	local.m.origin = ( -1280.719 -743.311 -140.944 )
	local.m.angles = ( 0 176 0 )
	local.m scale 0.500
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/emitters/generic_spark.tik"
	local.m.origin = ( -1247.194 -707.299 -100.892 )
	local.m.angles = ( 0 176 0 )
	local.m scale 1.800
	local.m notsolid
}end
