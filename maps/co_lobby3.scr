//==========================================================================================================//
// LEVEL:       co_lobby3.bsp   (a copy of m1l2a.bsp)
// TITLE:       HZM Coop - Post-Mission Lobby #3 (m1l2a "radio / command post" staging area)
// FLOW:        ... m1l2a  ->  co_lobby3  ->  m1l2b
// NOTE:        m1l2a's own mission script (objectives, scripted spawns, enemy actors) is NOT run here -
//              co_lobby3.scr only keeps the world geometry, then hands off to the shared coop_mod/lobby.scr.
// SCENE:       rebaked 2026-07-09 from build_m1l2a.dat - ONLY this session's 10 placements (the command-post
//              cluster + one flak emplacement); earlier accumulated/crashed-session props were excluded.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby3.scr"
	level.coop_aaMap = 1
	level.coop_lobbyMap = 1

	// --- per-lobby framing: the m1l2a "radio / command post" (viewpos grab 2026-07-09) ---
	level.coop_lobbySlotOrg[1] = ( -2105 -895 -61 )
	level.coop_lobbySlotYaw[1] = 355
	level.coop_lobbySlotOrg[2] = ( -2189 -739 -61 )
	level.coop_lobbySlotYaw[2] = 338
	level.coop_lobbySlotOrg[3] = ( -2040 -585 -62 )
	level.coop_lobbySlotYaw[3] = 324
	level.coop_lobbySlotOrg[4] = ( -2024 -460 -49 )
	level.coop_lobbySlotYaw[4] = 311
	level.coop_lobbyCamOrg = ( -1783 -936 -58 )
	level.coop_lobbyCamYaw = 129
	level.coop_lobbyNextMap = "m1l2b"				// completing this lobby launches m1l2b
	level.coop_lobbySkipProps = 1

	waitthread coop_mod/main.scr::main
	level.coop_weatherTheme = "none"

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain
	thread spawnLobby3Objects
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_m1l2a.dat - THIS SESSION ONLY (qconsole BUILD_ON 14:30 -> BUILD_OFF 14:58, count 1-10,
// zero undos). 9 props/emitters + 1 animated SAS actor. Earlier-session props deliberately not included.
//=========================================================================
spawnLobby3Objects:{
//=========================================================================
	local.m = spawn script_model
	local.m model "models/statweapons/flak88_d.tik"
	local.m.origin = ( -2636.518 -352.632 -46.888 )
	local.m.angles = ( 0 324 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/sandbag_large_semicircle.tik"
	local.m.origin = ( -2583.714 -391.829 -94.538 )
	local.m.angles = ( 0 324 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/items/item_mg_ammobox.tik"
	local.m.origin = ( -2023.612 -695.498 -145.278 )
	local.m.angles = ( 0 324 0 )
	local.m scale 2.800
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/items/item_grenade_ammobox.tik"
	local.m.origin = ( -2093.152 -730.612 -142.773 )
	local.m.angles = ( 0 279 0 )
	local.m scale 2.800
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/weapons/static_kar98.tik"
	local.m.origin = ( -2027.270 -754.673 -125.005 )
	local.m.angles = ( 315 84 0 )
	local.m scale 1.400
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/animate/radiobomb.tik"
	local.m.origin = ( -2094.700 -747.095 -110.461 )
	local.m.angles = ( 270 84 0 )
	local.m scale 1.400
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/sc_p_map.tik"
	local.m.origin = ( -2016.056 -688.721 -97.683 )
	local.m.angles = ( 0 84 0 )
	local.m scale 0.600
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/static_radiostation4.tik"
	local.m.origin = ( -2086.375 -726.492 -111.586 )
	local.m.angles = ( 0 339 0 )
	local.m scale 0.600
	local.m notsolid

	// animated actor: SAS standing (coop_act_stand2)
	local.m = spawn script_model
	local.m model "models/player/allied_sas.tik"
	local.m.origin = ( -1997.984 -707.200 -144.718 )
	local.m.angles = ( 0 144 0 )
	local.m solid
	local.m.coop_sceneAnim = "coop_act_stand2"
	local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate

	local.m = spawn script_model
	local.m model "models/static/wicker_basket_2.tik"
	local.m.origin = ( -2016.401 -764.289 -147.988 )
	local.m.angles = ( 0 144 0 )
	local.m solid
}end
