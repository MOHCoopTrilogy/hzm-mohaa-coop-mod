// I MADE THis
//////////////////////////////

//=========================================================================
main:{
//=========================================================================
	level.coop_aaMap = 1				//chrissstrahl - let global scripts know this is a AA level
	waitthread coop_mod/main.scr::main 	//chrissstrahl - start coop mod extensions
	thread coop_baked_0808
	//[user 2026-08-08] STEALTH START. Spawn with NO weapons, overriding the armory loadout, so
	//the U-boat pens are actually played as the disguise mission they were written as. Players
	//still get the papers and the uniform; the picked kit is issued the instant the cover breaks
	//(itemhandler.scr::takeAllDisguises -> coop_armOnBlown), which also clears this flag so any
	//later spawn arms normally. Set BEFORE the first spawn, hence here rather than at prespawn.
	level.coop_weatherTheme = "none"	//HZM coop - dynamic weather: U-boat pens interior (no precip)

	level.coop_enableDisguises 	= game.true 	//[200] Smithy - mark this map as disguise enabled on load
	level.coop_uniformOnSpawn 	= game.false 	//[200] Smithy - players shouldn't have the german uniform to begin with
	
	//chrissstrahl - setup stuff that is needed
	if(level.gametype != 0){
		//[user 2026-08-10] A4 (master plan v2 Step 4): the per-map scene-actor name list read by
		//coop_mod/officer.scr::coop_isProtectedActor. Plain targetnames, assigned here rather than
		//derived later, because A3 measured that the personality roll fires 23 SECONDS BEFORE
		//alarm_system_setup and find_guy run - any derivation that depends on those would be empty
		//at the only moment it matters. No wait: array assignment only, single-frame safe.
		level.coop_sceneActorNames[1] = "suckyfatty"
		level.coop_sceneActorNames[2] = "guy1"
		level.coop_sceneActorNames[3] = "guy2"
		level.coop_sceneActorNames[4] = "guy3"
		level.coop_sceneActorNames[5] = "welderguy1"
		level.coop_sceneActorNames[6] = "welderguy2"
		level.coop_sceneActorNames[7] = "crateguy1"
		level.coop_sceneActorNames[8] = "crateguy2"
		level.coop_sceneActorNames[9] = "wrenchman1"
		level.coop_sceneActorNames[10] = "sledgehammerguy"
		level.coop_sceneActorNames[11] = "youallright"
		level.coop_sceneActorNames[12] = "goatsbutt"
		level.coop_sceneActorNames[13] = "sentry2dude"
		level.coop_sceneActorNames[14] = "officer1"
		level.coop_sceneActorNames[15] = "guythatlikesnorway"
		level.coop_sceneActorNames[16] = "guythathatesnorway"
		level.coop_sceneActorNames[17] = "whatsthesub"
		level.coop_sceneActorNames[18] = "hushyhushy"
		level.coop_sceneActorNames[19] = "stupid"
		level.coop_sceneActorNames[20] = "jokey"
		level.coop_sceneActorNames[21] = "loweralarmerguy"
		//[user 2026-08-09] STEALTH FROM FIRST SPAWN (master plan D1). These flags used to arm at
		//the uniform pickup inside likeynorway (strip-at-pickup), which left the whole walk to the
		//papers armed and let a loadout grant race the strip (the bug-1604/1606/1607 ordering
		//class). Set at map load, before any player can spawn, no weapon is ever granted at all:
		//nothing to strip, nothing to race. itemhandler.scr::coop_armOnBlown clears all three and
		//re-arms everyone the moment the cover breaks (naxos caught, alarm/takeAllDisguises).
		//[user 2026-08-11] PER-MAP STEALTH GATE. coop_stealthStart was ONE global boolean doing TWO
		//jobs - "is the stealth layer enabled at all" and "does THIS map start you unarmed" - so a
		//second map could not opt in without inheriting m2l2a's opening. level.coop_stealthMap is the
		//per-map half (set by the map); the cvar stays as the global kill switch, and !="0" rather
		//than =="1" so an unset cvar does not silently disable a map that opted in.
		level.coop_stealthMap = 1
		if( getcvar "coop_stealthStart" != "0" ){
			level.coop_noWeapon = game.true
			level.coop_startUnarmed = 1
			level.coop_forcePapersEquip = game.true
		}
		//[user 2026-08-09] QUIET NAXOS SABOTAGE - the stealth route is papers-only, so the Naxos
		//must be killable without a shot. Hold USE at the device instead of the retail walk-in
		//detonation. See coop_naxosSabotage below.
		thread coop_naxosSabotage
		//[user 2026-08-09] "When the officer sees that I am an american spy, he attacks, at that
		//point i think we should get our guns back because we are technically blown."
		thread coop_blownOnDamage
		//[user 2026-08-09] same defect m2l2b had: every objective is added at load, BEFORE any
		//player is on the server, so coop_obj_toast_all early-exits into the void and the map
		//never shows a single New Objective card. Toast the current one once somebody exists.
		thread coop_objToastStart
		//chrissstrahl - add them now only in mp, to avoid the spam at start add them before players are on the server - sp see further below
		waitthread global/objectives.scr::add_objectives 1 2 "Find a disguise." $suit.origin
		waitthread global/objectives.scr::add_objectives 2 2 "Destroy the Naxos Prototype." $obj2.origin
		waitthread global/objectives.scr::add_objectives 3 2 "Enter the 2nd U-boat." $endlevel.origin
		waitthread global/objectives.scr::current_objectives 1
	}

