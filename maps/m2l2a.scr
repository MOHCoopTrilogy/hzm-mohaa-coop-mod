likeynorway:
	level.guythatlikesnorway type_disguise "none"
	level.guythathatesnorway type_disguise "none"
	$suit remove
	$papers1 remove

	if(level.gametype == 0){//chrissstrahl - made coop compatible
		local.key = getboundkey1 "toggleitem"
		iprintlnbold_noloc (loc_convert_string "Press the ( ") (loc_convert_string local.key) (loc_convert_string " ) key to show your papers.")	
	}else{
		//[200] Smithy - ok, you need to use 7 to show papers now (can't do click)
		iprintlnbold_noloc "If you are asked for your papers, press PRIMARY FIRE to show them."
	}
	
	parm.other playsound pickup_papers	//chrissstrahl - made coop compatible
	parm.other playsound pickup_uniform	//chrissstrahl - made coop compatible
	
	thread objective1
	waitthread global/items.scr::add_item "papers_level1"
	waitthread global/items.scr::add_item "uniform"
	//[user 2026-08-09] STEALTH flags (coop_noWeapon / coop_startUnarmed / coop_forcePapersEquip)
	//moved to map load (main, gametype != 0 branch): players spawn unarmed now, so there is no
	//loadout here to strip and no grant to race (the bug-1604/1606/1607 class). The sweep stays
	//as a defensive containment pass - it also force-sets the disguise state and starts the
	//per-player hold-disguise watchdog, and it is a no-op on empty hands.
	if( level.coop_stealthMap == 1 && getcvar "coop_stealthStart" != "0" ){
		waitthread coop_mod/itemhandler.scr::coop_stealthStripWeapons
	}
	$likeynorwaydoor unlock
	wait .2
	$likeynorwaydoor open level.guythathatesnorway
	wait 1.5
	level.guythathatesnorway thread waitForEnemy //[200] Smithy - call new func
	level.guythatlikesnorway thread waitForEnemy //[200] Smithy - call new func
	level.guythathatesnorway thread guygo guythathatesnorwayspot1 level.guythatlikesnorway
	level.guythatlikesnorway thread guygo guythatlikesnorwayspot1 level.guythathatesnorway
	level.peopletalking = 0
	waitthread likeynorwaytalk level.guythathatesnorway den_M2L2_205q
	waitthread likeynorwaytalk level.guythatlikesnorway den_m2l2_206r
	waitthread likeynorwaytalk level.guythathatesnorway den_m2l2_207q
	waitthread likeynorwaytalk level.guythatlikesnorway den_m2l2_208r
	waitthread likeynorwaytalk level.guythathatesnorway den_m2l2_209q
	waitthread likeynorwaytalk level.guythatlikesnorway den_m2l2_210r
	level.peopletalking = 0
	if (level.guythatlikesnorway.thinkstate == "idle" && level.guythathatesnorway.thinkstate == "idle"){ //[200] Smithy - fix stupid behaviour
		//[user 2026-08-09] COOP: leave them type_disguise "none".
		//Retail flips these two to "salute" and immediately walks them to their patrol posts. In
		//singleplayer they hold no enemy at that moment, so the walkto runs and they wander off. In
		//coop the AI layer has them awake WITH the player as enemy, so the moment they are saluters
		//PassesTransitionConditions_Disguise wins over the walkto: they stand up at the card table,
		//salute, and never leave. That is the "one at the table stood up and is just standing there"
		//report, and the engine confirms it - "Saluting guy...." printed twice, once per man, while
		//their cardhand models failed to re-attach to tag_weapon_left.
		//Keeping "none" in coop preserves the retail INTENT (they get up and walk to their posts)
		//and only drops the salute, which is the part that traps them.
		if( level.gametype == 0 ){
			level.guythatlikesnorway type_disguise "salute"
			level.guythathatesnorway type_disguise "salute"
		}
		level.guythatlikesnorway exec global/walkto.scr $guard1patrol1
		level.guythathatesnorway exec global/walkto.scr $guard2patrol2
	}
	$suckyfatty hearing 1024
end

likeynorwaytalk local.talker local.word:
	if(isAlive local.talker && local.talker.thinkstate == "idle") //[200] Smithy - use idle
	{
		local.talker idlesay local.word //[200] Smithy - use idlesay instead of say
		local.talker waittill saydone
	}
end

//[200] Smithy - new func to stop dumb behavior with start guys
//=========================================================================
waitForEnemy:{
//=========================================================================
	local.previousThread = parm.previousthread
	//[user 2026-08-08] bug-1609. This waited ONLY while the actor was idle, then attacked
	//unconditionally - it never checked whether anyone was disguised. likeynorway threads this at
	//:42 and then calls guygo at :44, which makes them WALK: thinkstate stops being "idle", the
	//loop falls through, and both Germans open fire the instant they step into the locker room.
	//They are type_disguise "none" here too, so "disguise" never held it either.
	//
	//In coop, keep waiting while every player is still disguised. The moment somebody draws a
	//weapon canseeUndisguisedPlayers goes true, the loop exits and they attack - which is the
	//behaviour this label was written for.
	//WAITTHREAD, not thread. `thread` starts the label ASYNCHRONOUSLY and evaluates to a handle -
	//not the return value - so !(thread ...) negated a truthy handle, the OR term never held, and
	//this guard was a no-op. Everywhere in this codebase that wants a value back uses waitthread
	//(if (waitthread isWeaponClass ...), if (waitthread ...containsText ...)).
	local.seen = 0
	while( isAlive self ){
		if( level.gametype != 0 ){
			local.seen = waitthread coop_mod/aihandler.scr::canseeUndisguisedPlayers
			if( local.seen ){ break }
		}else{
			if( self.thinkstate != "idle" && self.thinkstate != "disguise" ){ break }
		}
		wait .25
	}
	if (isAlive self){
		//iprintlnbold_noloc("stopping previous thread")
		self turnto NULL
		self walkto NULL
		//self exec global/stand.scr
		println "^~^~^ STEALTH waitForEnemy fired - a player is undisguised, attacking"
		self attackplayer
		self type_disguise "none"
		if (local.previousThread){ local.previousThread end }
	}
}end

forceturn local.turn:
	self exec global/disable_ai.scr
	self exec global/stand.scr
	self exec global/turnto.scr local.turn
	wait .5
	self exec global/enable_ai.scr
