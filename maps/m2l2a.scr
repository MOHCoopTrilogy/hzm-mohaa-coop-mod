standattable local.table:
		self thread sciwalkto local.table
end

//-----------sciwalkto------------

sciwalkto local.table:
	self forceactivate
	self anim scientist_attachclipboard
	waitframe
	self type_attack "alarm"
	self alarmthread ohnothenaxos1
	self exec global/walkto.scr local.table
	self waittill movedone
	//[user 2026-08-10] RETURN TO THE SAME SPOT. walkto pathfinds to the nav node nearest $table, so
	//where he ends up depends on which direction he approached from. The first trip (map setup,
	//scientistidle) comes straight from his spawn; the trip AFTER talking to a player starts from
	//wherever the player was standing, so he lands on a different node - visibly off his clipboard
	//spot, which the user reported as "further away from the table... looks funky".
	//Remember the first arrival and correct back to it on later ones. The correction is only applied
	//within 160u, so it is a sub-stride nudge and never a visible teleport; beyond that we leave him
	//where the pathfinder put him rather than yank him across the room.
	if( level.gametype != 0 ){
		if( level.coop_sciSpot == NIL ){
			level.coop_sciSpot = self.origin
			level.coop_sciAngles = self.angles
		}else{
			if( ( vector_length ( self.origin - level.coop_sciSpot ) ) < 160 ){
				self.origin = level.coop_sciSpot
				self.angles = level.coop_sciAngles
			}
		}
	}
	self exec global/turnto.scr $tablelook
	self thread depressed
end

//-----------depressed------------

depressed:
	if(level.scienceinterupt == 0)
	{
		self anim "scientist_standtable_straight"
		if (level.scienceinterupt != 0)
			end
		local.randnum = (randomint(4) + 6)
		for(local.i = 1;local.i < local.randnum; local.i++)
		{
			if (level.scienceinterupt != 0)
			end
			wait .5
		}
		wait local.randnum
		self thread tablesciencepickthread
	}	
end

//-----------idle1------------

idle1:

	if(level.scienceinterupt == 0)
	{
		self anim "scientist_standtable_lean01"
		if (level.scienceinterupt != 0)
			end
		self waittill animdone
		self thread tablesciencepickthread
	}
end

//-----------idle2------------

idle2:

	if(level.scienceinterupt == 0)
	{	
		self anim "scientist_standtable_lean02"
		if (level.scienceinterupt != 0)
		end	
		self waittill animdone
		self thread tablesciencepickthread
	}
end

//-----------idle3------------

idle3:

	if(level.scienceinterupt == 0)
	{
		self anim "scientist_standtable_lean03"
		if (level.scienceinterupt != 0)
		end	
		self waittill animdone
		self thread tablesciencepickthread
	}
end


//-----------idletodepressed------------

idletodepressed:

	if(level.scienceinterupt == 0)
	{
		if (level.scienceinterupt != 0)
			end
		self anim "scientist_standtable_leantostraight"
		if (level.scienceinterupt != 0)
			end
		self waittill animdone
		self thread depressed
	}
end

tablesciencepickthread:
	local.randnum = randomint (100)	
	if		(local.randnum < 30)	self thread idle1
	else if	(local.randnum < 60)	self thread idle2
	else if	(local.randnum < 90)	self thread idle3
	else	
					self thread idletodepressed
end

