	$crate2_start notsolid
	$crate3_start notsolid
//	$gate2 notsolid
	exec global/loadout.scr maps/m2l2a.scr
	exec global/cardgame.scr
//[user 2026-08-05] bug-1458b - the PRESPAWN waittill dies the same way the spawn one did, and it
//dies FIRST, so the main thread was already dead before reaching the fix below. Same shim family.
waitthread coop_mod/replace.scr::waitTillPrespawn
	level.script = maps/m2l2a.scr
//	thread global/exploder.scr::main
	exec global/alarmlight.scr
	exec global/ambient.scr m2l2a

	//[user 2026-08-05] bug-1458 - the raw 'level waittill spawn' threw "invalid waittill spawn for
	//'Level'" here and KILLED the main thread, so nothing below ever ran: no waitForPlayer, no coop
	//setup, no spawn placement - four connected clients sat unspawned on a live map (user-reported,
	//caught by the sweep). The Level spawn event had already fired by the time this line was
	//reached (this map does a lot of work above it, and a 4-client HD-pak load widens that window),
	//and a waittill for an event that already happened can never be satisfied. replace.scr's own
	//shim is the project's answer: in coop it waits on the framework's trigger instead, and it
	//falls back to the raw waittill in single-player.
	waitthread coop_mod/replace.scr::waitTillSpawn
	waitthread coop_mod/replace.scr::waitForPlayer //chrissstrahl - wait for any player to join

	if($leaningguy)
		$leaningguy remove
		
	level.skillz = getcvar(skill)
	
//	$officerdoor1 solid
//	$officerdoor1 disconnect_paths
//	$gate2 solid
//	$gate2 disconnect_paths

	level.scienceinterupt = 0
	level.alarmlights = 0
	level.ai_alarm_backup_time = 15
	level.ai_alarm_backup_max = 4
	
	if( level.gametype == 0 ){//chrissstrahl - this seams to work only in singleplayer
		$player.has_disguise = 1
	}
	//chrissstrahl - disguise in mp seams not to work
	//exec coop_mod/replace.scr::has_disguise 1 //chrissstrahl - made coop compatible
	
	level.alarm = 0

	if(level.gametype == 0 ){ //chrissstrahl - add them now only in sp
		waitthread global/objectives.scr::add_objectives 1 2 "Find a disguise." $suit.origin
		waitthread global/objectives.scr::add_objectives 2 2 "Destroy the Naxos Prototype." $obj2.origin
		waitthread global/objectives.scr::add_objectives 3 2 "Enter the 2nd U-boat." $endlevel.origin
		waitthread global/objectives.scr::current_objectives 1
	}
	
///"stuffing" guys into variables and alarm system setup
