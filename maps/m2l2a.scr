		//if((vector_length ($player.origin - $alarm_sound[local.i].origin) < 1024)){ //chrissstrahl
		if( waitexec coop_mod/replace.scr::withinDistanceOf $alarm_sound[local.i] 1024 ){ //chrissstrahl - coop
