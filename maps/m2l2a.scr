objective1:
	waitthread global/objectives.scr::add_objectives 1 3 "Find a disguise." $obj1.origin
	waitthread global/objectives.scr::current_objectives 2
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 2 "Destroy the Naxos Prototype." }
	
end

objective2:
	$naxos waittill trigger
	//[user 2026-08-10] scienceinterupt 2 means "the prototype blew up - scientists, stop your
	//routine". sciencetalk tests it after EVERY line and bails; depressed stops its table loop on
	//any non-zero. In retail that is invisible because destroying the Naxos ALWAYS fires the
	//scripted bust and the scientists go hostile anyway. Our QUIET sabotage removed the bust but
	//kept the abort, so the talking scientist froze mid-conversation and never walked back to his
	//table (measured: clipboard scene at 00:23:03, sabotage at 00:23:22, user reported him stuck).
	//A sabotage nobody noticed must leave their routine untouched - that is the whole point of it.
	if( level.coop_naxosQuiet != 1 ){ level.scienceinterupt = 2 }
	//[user 2026-08-09] the scripted bust belongs to the LOUD path. A quiet sabotage completes the
	//objective without it - being CAUGHT mid-sabotage fires ohnothenaxos1 from the hold loop
	//instead, which is the retail bust doing exactly its job.
	if( level.coop_naxosQuiet != 1 ){ thread ohnothenaxos1 }
	thread blowupthenaxos
	waitthread global/objectives.scr::add_objectives 2 3 "Destroy the Naxos Prototype." $obj2.origin
	waitthread global/objectives.scr::current_objectives 3
	if( level.gametype != 0 ){ waitthread coop_mod/objectives.scr::coop_obj_toast_all 3 "Enter the 2nd U-boat." }
	thread norgirlsinpos
//	level.youallright thread youok
end


