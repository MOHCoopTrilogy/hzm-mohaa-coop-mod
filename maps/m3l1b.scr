//*********************************************
// starting bunker door on lower level guy death
//*********************************************
//[user 08-08] Shared wake for the back room, called from BOTH front germans' death threads.
//Latched: in coop two players can drop lower_1 and lower_2 in the same instant, and running this
//twice would re-trigger and re-issue attackplayer on actors already engaged.
coop_wakeLowerBack:

if( level.coop_lowerBackWoke == 1 ){ end }
level.coop_lowerBackWoke = 1

//*** wake up the guys in the next room
if( $weh_sol_bunker_lower_4 != NULL ){
	$weh_sol_bunker_lower_4 exec global/enable_ai.scr
	trigger $weh_sol_bunker_lower_4
}
if( $weh_sol_bunker_lower_5 != NULL ){
	$weh_sol_bunker_lower_5 exec global/enable_ai.scr
	trigger $weh_sol_bunker_lower_5
}

wait 2
if( isalive $weh_sol_bunker_lower_4 ){ $weh_sol_bunker_lower_4 attackplayer }
if( isalive $weh_sol_bunker_lower_5 ){ $weh_sol_bunker_lower_5 attackplayer }

end

weh_sol_bunker_lower_1_death:

local.self waittill death

//[user 08-08] EITHER front german now wakes the back room. WCR: "Fixed two germans in the back
//not responding until one of two germans in the front are killed." Retail hung the wake-up
//solely on weh_sol_bunker_lower_2's death, so killing lower_1 first left lower_4 and lower_5
//asleep in the next room until the player walked in on them.
thread coop_wakeLowerBack

wait .75
if (level.bunker_lower_alert != 1)
{
	$weh_sol_bunker_lower_2 say den_scripted_M3L1_01b
}

end


