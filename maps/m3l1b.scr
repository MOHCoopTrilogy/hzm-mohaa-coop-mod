//===========================================================================
// HZM coop [RESTORED CUT OBJECTIVE] - Destroy the two FLAK 88 emplacements in the back-field.
// The retail BSP shipped two 88mm guns (88mm_weapon1 near, 88mm_weapon2 far back), each with a plant
// trigger (88mm_trigger1/2) + a pulse_explosive charge marker (88mm_explosive1/2) carrying the exact entity
// keys the MP bomb system reads ($trigger_name/$explosion_fx/target). The devs CUT the objective and just
// ended the level after the bunker gunners. This re-wires it with the REAL MP bomb-plant
// (global/obj_dm.scr::bomb_thinker) exactly how the Omaha MP map obj_team3 does it - 6s timed plant, plant
// animation, physical bomb, explosion + wrecked-gun swap - then gates the exit on both being blown.
//===========================================================================
coop_flak88_objective:

	if (level.coop_flak88_started == 1){ end }
	level.coop_flak88_started = 1
	level.coop_flak88_destroyed = 0

	//*** MP bomb-plant params (mirror obj_team3, the Omaha Beach MP map)
	level.bomb_damage = 200
	level.bomb_explosion_radius = 640
	level.planting_team = "allies"

	//*** objective + map marker on the nearer gun
	waitthread global/objectives.scr::add_objectives 3 2 "Destroy the 2 FLAK 88 artillery emplacements" $88mm_weapon1.origin
	waitthread global/objectives.scr::current_objectives 3

	//*** arm the plant points and start the REAL bomb thinkers on the charge markers (timer/anim/bomb/boom
	//*** all come from the entity keys already on the markers)
	$88mm_trigger1 triggerable
	$88mm_trigger2 triggerable
	$88mm_explosive1 thread global/obj_dm.scr::bomb_thinker
	$88mm_explosive2 thread global/obj_dm.scr::bomb_thinker

	//[user 2026-08-07] The fuse and the defuse team MUST be set AFTER bomb_thinker runs, not before.
	//bomb_thinker opens by hardcoding its own level.bomb_tick_time = 45 (and bomb_damage /
	//bomb_explosion_radius), silently overwriting anything we set above it - which is why a planted
	//charge sat for 45 quiet seconds and read as a dud. waitframe lets both thinkers get past that
	//assignment; the explode loop reads the value at PLANT time, so the shorter fuse still applies.
	waitframe
	level.bomb_tick_time = 15
	//[user 2026-08-07] Instant plant. bomb_set_time is in TENTHS of a second and bomb_thinker
	//hardcodes 50 (a 5s hold-to-plant). The rest of the trilogy plants on a single use press, so
	//drop it to one 0.1s tick - the plant loop needs at least one iteration to reach its counter
	//test, so 0 would never complete.
	level.bomb_set_time = 1
	//retail leaves level.defusing_team unset here, so an allied player brushing the plant trigger
	//after arming gets "You're on the wrong team to defuse this bomb!". Everyone is allies in coop,
	//so name axis and the defuse path simply never engages.
	level.defusing_team = "axis"

	//*** watch each bomb; when bomb_thinker sets .exploded, count it + silence that gun
	thread coop_flak88_watch $88mm_explosive1 $88mm_weapon1
	thread coop_flak88_watch $88mm_explosive2 $88mm_weapon2

	//*** the guns fire on the beach until knocked out; a few defenders hold the emplacements
	thread coop_flak88_fire $88mm_weapon1
	thread coop_flak88_fire $88mm_weapon2
	thread coop_flak88_defenders
	//[user 2026-08-07] Rear garrison spawns HERE, when the 88 objective opens - not on completion.
	//Hooking it to coop_flak88_complete meant the rear was empty for the whole fight and only
	//populated once the guns were already down, which is backwards for "defend the rear area".
	thread coop_rear_defenders

end


//===========================================================================
// Watch a planted bomb; when bomb_thinker detonates it (.exploded), count the kill + stop that gun firing.
//===========================================================================
coop_flak88_watch local.bomb local.gun:

	if (local.bomb == NULL){ end }

	//[user 2026-08-07] obj_dm.scr's explode loop shows NO stopwatch - it just ticks silently for the
	//fuse, which is what made a planted charge read as a dud. Watch for the plant here (bomb_thinker
	//sets .live = 1 the instant it arms) and put the fuse on the native stopwatch for every player,
	//the same way coop_mod/officer.scr::coop_radio_bomb_countdown does its charge.
	while (local.bomb.live != 1 && local.bomb.exploded != 1)
	{
		waitframe
	}
	if (local.bomb.exploded != 1)
	{
		exec coop_mod/replace.scr::stopwatch level.bomb_tick_time
	}

	while (local.bomb.exploded != 1)
	{
		waitframe
	}

	if (local.gun != NULL){ local.gun.coop_fireStop = 1 }
	//[user 2026-08-07] Guaranteed detonation report. obj_dm.scr only plays a blast if the charge
	//marker carries an explosion_sound entity key (`if (self.explosion_sound != NIL)`), and these
	//retail pulse_explosive markers evidently do not - the kill was silent. explode_flak88 is
	//aliased maps "m e t" so it loads here, unlike the flak FIRE aliases (bug-1548).
	if (local.gun != NULL){ local.gun playsound explode_flak88 }

	level.coop_flak88_destroyed = level.coop_flak88_destroyed + 1
	if (level.coop_flak88_destroyed >= 2)
	{
		thread coop_flak88_complete
	}

end


//===========================================================================
// Restored firing-on-the-beach: the turret ACTUALLY fires (muzzle + sound + recoil) every few
// seconds until destroyed - not an explosion effect. Needs BOTH startFiring and an aim target;
// see the note in the body for why startFiring on its own never discharges.
//===========================================================================
coop_flak88_fire local.gun:

	if (local.gun == NULL){ end }

	//[user 2026-08-07] REWRITTEN. $88mm_weapon1/2 are class **Animate**, not TurretGun - the live log
	//is unambiguous: "Failed execution of command 'startFiring' for class 'Animate'", and the same for
	//stopFiring and setAimTarget. So the whole turret API is unavailable here, and the original
	//startFiring pair had never done anything; my first fix (spawn an aim target, mirroring M3L3) was
	//wrong for the same reason and just added a third failing command.
	//What DOES work is the model's own animation. flak88turret.tik declares fire_scripted =
	//88turret_fire.skc, and that anim carries the frame command `first sound flak_snd_fire`, so
	//playing it gives the recoil AND the report from one call - no turret, no aim target, no
	//projectile. Pair it with the alias maps-spec fix (bug-1548) or it animates silently.
	while (local.gun.coop_fireStop != 1)
	{
		local.gun anim fire_scripted

		//shake anyone standing near the gun as it goes off. NOT `$player.origin` - $player is an
		//ARRAY in coop and dereferencing it directly throws once a second player connects.
		local.near = exec coop_mod/replace.scr::player_closestTo local.gun
		if (local.near != NULL)
		{
			if (vector_length(local.gun.origin - local.near.origin) < 1200)
			{
				thread jitter_artillery 0
			}
		}

		wait 2
		if (local.gun == NULL){ end }
		if (local.gun.coop_fireStop != 1){ local.gun anim idle }
		wait 4
	}

end


//===========================================================================
// A few German defenders from the bunker-exit spawn points (valid ground), sent at the players.
//===========================================================================
coop_flak88_defenders:

	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn1
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn2
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn1
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn2

end


coop_flak88_spawn_defender local.spot:

	if (local.spot == NULL){ end }

	local.sol = spawn "models/human/german_wehrmact_soldier" gun "mauser kar 98k"
	local.sol exec global/disable_ai.scr
	local.sol.origin = local.spot.origin
	local.sol exec global/enable_ai.scr

	local.player = exec coop_mod/replace.scr::player_closestTo local.sol
	if (local.player != NULL)
	{
		local.sol exec global/runto.scr local.player
	}

end


//===========================================================================
// Both guns destroyed -> complete the objective and open the exit.
//===========================================================================
coop_flak88_complete:

	iprintlnbold "Both FLAK 88 emplacements destroyed - fall back to the exit!"


	waitthread global/objectives.scr::add_objectives 3 3
	waitthread global/objectives.scr::add_objectives 4 2 "Exit the bunker." $end_level_trigger.origin
	waitthread global/objectives.scr::current_objectives 4

	$end_level_trigger triggerable

end

//===========================================================================
// [user 2026-08-07] Rear-area garrison. Spawned once the FLAK 88s are down and the squad is sent
// back toward the exit, so the whole run home is not a walk through an empty map.
// Deliberately NOT given a runto: coop_flak88_spawn_defender above sends its men AT the players,
// which is assault behaviour. These hold where they are placed and engage on sight, which is what
// "defend the rear area" means. Points captured live with viewpos; the yaws viewpos printed were
// accumulated past one turn (-422, -796 ...) and are normalised into 0..360 here.
// Both models used below are already spawned elsewhere on this map (see the bunker_upper fodder
// block), so nothing new has to be precached.
//===========================================================================
coop_rear_defenders:

	if (level.coop_rearDefenders == 1){ end }
	level.coop_rearDefenders = 1

	waitthread coop_rear_spawn ( 391 365 320 ) 298 0
	wait 0.3
	waitthread coop_rear_spawn ( 433 -269 256 ) 289 0
	wait 0.3
	waitthread coop_rear_spawn ( -332 -112 328 ) 284 1
	wait 0.3
	waitthread coop_rear_spawn ( -871 -464 328 ) 293 0
	wait 0.3
	waitthread coop_rear_spawn ( -861 297 384 ) 273 0
