	wait 0.3
	waitthread coop_rear_spawn ( 2086 -676 256 ) 94 0
	wait 0.3
	waitthread coop_rear_spawn ( 2579 -715 384 ) 193 1
	wait 0.3
	waitthread coop_rear_spawn ( -85 -638 250 ) 238 0
	wait 0.3
	waitthread coop_rear_spawn ( 1047 95 320 ) 323 0
	wait 0.3

	//[user 2026-08-07] Second capture pass - "I want there to be an abundance out here". Same
	//treatment as the first 11: viewpos reports the EYE, so every z drops by DEFAULT_VIEWHEIGHT (82)
	//to put the actor on the floor, and the yaws viewpos printed had wrapped past a full turn
	//(-186, 667, 696 ...) so they are normalised into 0..360.

	waitthread coop_rear_spawn ( 542 -617 250 ) 174 0
	wait 0.3
	waitthread coop_rear_spawn ( -134 -640 250 ) 183 1
	wait 0.3
	waitthread coop_rear_spawn ( 250 76 320 ) 41 0
	wait 0.3
