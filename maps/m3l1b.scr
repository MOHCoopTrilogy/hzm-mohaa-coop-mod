//===========================================================================
// One rear defender. Mirrors coop_flak88_spawn_defender exactly (spawn -> disable_ai -> place ->
// enable_ai) - placing an actor before enable_ai is what stops it waking up at the world origin.
// The 0.3s stagger in the caller is the same-frame spawn/model/solid race guard.
//===========================================================================
coop_rear_spawn local.pos local.yaw local.nco:

	if (local.nco == 1)
	{
		local.sol = spawn "models/human/german_wehrmact_nco" gun "mp40"
	}
	else
	{
		local.sol = spawn "models/human/german_wehrmact_soldier" gun "mauser kar 98k"
	}

	if (local.sol == NULL){ end }

	local.sol exec global/disable_ai.scr
	local.sol.origin = local.pos
	local.sol.angles = ( 0 local.yaw 0 )
	local.sol exec global/enable_ai.scr

	//[user 2026-08-07] Register the ACTOR, not a tally. The previous death-counter compared
	//coop_rear_dead against a total that only grew on a successful spawn, so anything that failed
	//to spawn, landed in geometry or fell out of the world moved the two numbers together - and the
	//mission completed the instant the guns died with the backline untouched (log 17:17:41: the
	//"clear the backline" and "backline cleared" lines landed in the SAME second).
	//coop_rear_headcount polls this list instead, so only an actor that is genuinely gone counts.
	level.coop_rear_total = level.coop_rear_total + 1
	level.coop_rear_actor[level.coop_rear_total] = local.sol
	local.sol.coop_spawnPt = local.pos
	local.sol thread coop_navprobe "AXIS"

end



//===========================================================================
// [user 2026-08-07] Rear-area props, baked from a build-mode session.
// IMPORTANT: build mode is a CAPTURE tool, not a persistence layer. It writes paste-ready blocks to
// coop_mod/save/build_<map>.dat and re-reads that file only to append to it - nothing loads the .dat
// at runtime, so placements vanish the moment the map reloads until they are baked into a script
// like this. 34 pieces: crates, barbwire runs, tents, an Opel truck and a sandbag segment, forming
// the defensive position the rear garrison fights from.
