//===========================================================================
// [user 2026-08-07] One rear defender's death. When the last of them drops, the mission ends -
// "Clear the backline of enemies" replaced the old walk-back-to-the-bunker objective.
// Counted rather than scanned: the total is incremented as each actor is spawned, so it stays
// correct if the garrison list is ever added to.
//===========================================================================
// [user 2026-08-07] LIVE HEADCOUNT. Polls the actors we actually spawned and completes only when
// none are left standing. Also republishes the objective text with the remaining count, the same
// way the retail document hunt on m2l1 does ("[N remaining]") - so the state is visible instead of
// something the player has to take on trust.
// Requires BOTH: the FLAK 88s destroyed AND the backline down. Order does not matter.
//===========================================================================
coop_rear_headcount:

	while (level.coop_rear_done != 1)
	{
		wait 2

		local.alive = 0
		local.i = 1
		while (local.i <= level.coop_rear_total)
		{
			local.a = level.coop_rear_actor[local.i]
			if (local.a != NULL)
			{
				if (isAlive local.a){ local.alive = local.alive + 1 }
			}
			local.i = local.i + 1
		}
		level.coop_rear_alive = local.alive

		//only meaningful once the guns are down and the objective is actually showing
		if (level.coop_flak88_destroyed >= 2)
		{
			if (local.alive > 0)
			{
				if (local.alive != level.coop_rear_shown)
				{
					level.coop_rear_shown = local.alive
					waitthread global/objectives.scr::add_objectives 4 2 ("Clear the backline of enemies [" + local.alive + " remaining]")
				}
			}
			else
			{
				thread coop_rear_cleared
				end
			}
		}
	}

end

//===========================================================================
// Backline cleared -> objective complete -> mission over.
//===========================================================================
coop_rear_cleared:

	if (level.coop_rear_done == 1){ end }
	level.coop_rear_done = 1

	iprintlnbold "Backline cleared - the beach exit is secure!"
	waitthread global/objectives.scr::add_objectives 4 3
	waitthread global/objectives.scr::current_objectives 0

	wait 3

	//[user 2026-08-07] Mirror end_level_thread exactly. Finishing on the backline objective is now
	//the normal way out of this map, so it has to award the same medal and play the same fade the
	//old exit-trigger path did - otherwise clearing the map silently costs the player g_medal5.
	//[user 2026-08-07] POOPHEAD ENDING challenge. The retail script tags this map's shipped
	//ending "TEMP TEMP TEMP POOPHEAD ENDING" (m3l1b.scr:838, dev placeholder) - the intended
	//ending was the full gun-emplacement chain, all four objectives commented out at the top of
	//the file and their entities cut from the BSP. Reaching THIS ending means finishing it the
	//way they meant to, so it awards the challenge. Only granted on this path, never on the
	//exit-trigger failsafe.
	local.pi = 1
	while( local.pi <= $player.size )
	{
		local.pp = $player[local.pi]
		if( local.pp != NULL )
		{
			waitthread coop_mod/challenges.scr::chal_bump local.pp "cc_poophead_ending" 1
		}
		local.pi = local.pi + 1
	}

	fadeout 5 0 0 0 1
	setcvar "g_medal5" "1"

	exec global/missioncomplete.scr m3l2

end

//===========================================================================
// [user 2026-08-07] Anti-hard-lock watchdog for the backline objective.
// If an actor ends up stuck in geometry, unreachable or otherwise unkillable, the mission could
// never end. Rather than leave the exit permanently open (which let the player finish by simply
// walking out), the exit is armed ONLY once the kill count has not moved for a long stretch with
// enemies still alive. It cannot be reached by playing normally, and it deliberately does NOT
// award the POOPHEAD ENDING challenge - the backline was not actually cleared.
//===========================================================================
coop_rear_stallwatch:

	local.last = -1
	local.idle = 0

	while (level.coop_rear_done != 1)
	{
		wait 10

		if (level.coop_rear_done == 1){ end }

		if (level.coop_rear_alive == local.last)
		{
			local.idle = local.idle + 10
		}
		else
		{
			local.idle = 0
			local.last = level.coop_rear_alive
		}

		//3 minutes with not a single further kill = something is unreachable
		if (local.idle >= 180)
		{
			iprintlnbold "Remaining enemies have gone to ground - fall back to the bunker exit."
			waitthread global/objectives.scr::add_objectives 4 2 "Exit the bunker." $end_level_trigger.origin
			waitthread global/objectives.scr::current_objectives 4
			$end_level_trigger triggerable
			end
		}
	}

end


//===========================================================================
// [user 2026-08-07] Allied push on the FAR flak.
// Rangers with mixed US weapons who work their way to $88mm_weapon2 and hold that ground. They are
// tracked in their OWN list and are NOT registered in level.coop_rear_actor, so they can never
// count toward "Clear the backline of enemies" - that objective stays purely a measure of the axis
// garrison. Given a much deeper HP pool than the axis so they survive the walk and are still
// standing when the players arrive.
// Models and weapon strings are the ones this map already uses for its beach scene (see the
// switch above), so nothing new has to be precached.
//===========================================================================
coop_ally_push:

	if (level.coop_allyPush == 1){ end }
	level.coop_allyPush = 1
	level.coop_ally_total = 0

	waitthread coop_ally_spawn ( -1239 -1560 248 ) 359 0
	wait 0.3
	waitthread coop_ally_spawn ( -1158 -1566 250 ) 359 1
	wait 0.3
	waitthread coop_ally_spawn ( -1054 -1555 250 ) 359 2
	wait 0.3
	//[user 08-07] MEDIC, moved 48 units off ( -943 -1528 250 ). That point was the ONE dead probe
	//out of 44 after maps/m3l1b.pth went in - "NAVPROBE DEAD ALLY moved 0" - and being the medic,
	//a stuck one meant nobody got patched up on the whole rear push. It also produced 14 of the 59
	//"Path not found" lines by itself: unable to move at all, it failed every patrol target its AI
	//picked, including one deep in the far bunker that has no interior to stand in.
	//This replacement is a node captured on foot AND >96 units clear of every other ally spawn, so
	//it neither lands in the same isolated pocket nor stacks him on a squadmate.
	waitthread coop_ally_spawn ( -918 -1569 248 ) 89 5
	wait 0.3
	waitthread coop_ally_spawn ( -949 -1464 250 ) 88 3
	wait 0.3
	waitthread coop_ally_spawn ( -946 -1361 250 ) 88 0
	wait 0.3
	waitthread coop_ally_spawn ( -942 -1240 250 ) 88 1
	wait 0.3
	waitthread coop_ally_spawn ( 2140 -489 255 ) 178 2
	wait 0.3
	waitthread coop_ally_spawn ( 2314 -18 383 ) 178 0
	wait 0.3
	waitthread coop_ally_spawn ( 2621 -117 383 ) 178 5
	wait 0.3
	waitthread coop_ally_spawn ( 2176 54 384 ) 178 4
	wait 0.3

end

//===========================================================================
// One ranger. kind: 0 private+garand, 1 private+BAR, 2 sergeant+garand, 3 lieutenant+thompson,
// 4 captain+thompson, 5 medic+garand.
// All five are the Omaha beach-scene models this map already spawns, and each tik pulls a
// random head/face from us_old_heads.tik, so no two are identical even at the same kind.
// [user 2026-08-07] kind 4 IS the officer who opens m3l2 - confirmed against a screenshot: the
// captain bar on the helmet, the Thompson and the assault vest all match dday_ranger_captain
// (surface armband shader av_ltnt_cap on the allied_ranger_soldier/assaultvest body). Exactly one
// of him spawns, at the last capture point.
//===========================================================================
coop_ally_spawn local.pos local.yaw local.kind:

	local.model = "models/human/dday_ranger_private"
	local.gun   = "m1 garand"
	if (local.kind == 1){ local.model = "models/human/dday_ranger_private";    local.gun = "bar" }
	if (local.kind == 2){ local.model = "models/human/dday_ranger_sergeant";   local.gun = "m1 garand" }
	if (local.kind == 3){ local.model = "models/human/dday_ranger_lieutenant"; local.gun = "thompson" }
	if (local.kind == 4){ local.model = "models/human/dday_ranger_captain";    local.gun = "thompson" }
	if (local.kind == 5){ local.model = "models/human/dday_ranger_medic";      local.gun = "m1 garand" }

	local.n = level.coop_ally_total + 1
	local.tn = "coop_ally" + local.n
	spawn local.model targetname local.tn gun local.gun
	local.sol = $(local.tn)
	if (local.sol == NULL){ end }

	local.sol exec global/disable_ai.scr
	local.sol.origin = local.pos
	local.sol.angles = ( 0 local.yaw 0 )
	local.sol.team = "american"
	//Deeper pool than the axis garrison (which runs on stock actor health) so they survive the
	//advance and are still fighting when the squad reaches them.
	//[user 08-07] Was a flat 400, set while the rear nav graph was still dead and the rangers just
	//stood where they spawned trading shots. Now that maps/m3l1b.pth covers the rear area they
	//actually cross it - into the open, toward two flak positions held by 33 defenders - and 400
	//did not survive the walk. Tunable so it can be dialled without a rebuild; the leaders carry
	//more because losing them strands the push.
	local.hp = float( getcvar "coop_allyHealth" )
	if( local.hp <= 0 ){ local.hp = 1500 }
	if( local.kind == 2 || local.kind == 3 ){ local.hp = local.hp * 1.5 }
	local.sol.health = local.hp
	local.sol dontdropweapons

	//[user 2026-08-07] The captain is INVINCIBLE. He opens the next mission, so losing him here
	//would be a continuity break the player cannot undo and cannot see coming. `nodamage` is the
	//scripted-god path this project already uses (buildmode.scr, bt_playerTank.scr) - the "god"
	//console command is cheat-gated, the event is not. He still fights; he just cannot be killed,
	//by the axis garrison or by a stray round from the squad.
	if (local.kind == 4)
	{
		local.sol nodamage
	}
	local.sol exec global/enable_ai.scr

	level.coop_ally_total = local.n
	level.coop_ally_actor[local.n] = local.sol
	local.sol.coop_spawnPt = local.pos
	local.sol thread coop_navprobe "ALLY"

	//[user 2026-08-07] Medics run the existing medic brain instead of the advance: it already
	//prioritises reviving a DOWNED teammate, then patches up whoever is most hurt, kneeling and
	//going invulnerable while he works (coop_mod/paradrop.scr::coop_paradrop_medic). Reusing it
	//rather than writing a second one - it is proven and it handles the DBNO case properly.
	if (local.kind == 5)
	{
		thread coop_mod/paradrop.scr::coop_paradrop_medic local.sol
	}
	else
	{
		local.sol thread coop_ally_advance
	}

end


//===========================================================================
// [user 2026-08-07] Push each ranger to the far gun and keep pushing.
// Two bugs fixed here at once:
//  1. The destination was $88mm_weapon2.origin (-1046 -153 450) - the gun sits on a raised
//     emplacement with no AI path to it, so every runto failed outright with
//     "Path not found in Actor::MoveToPatrolCurrentNode" and nobody moved a step. The target is
//     now ( -871 -464 328 ), one of the points captured ON FOOT for the axis garrison, so it is
//     walkable by construction - 356 units from the gun, which is close enough to fight over it.
//  2. runto was issued ONCE at spawn. An actor that stops to engage never resumes, which is
//     exactly the "they just stand there and shoot" behaviour. This re-issues whenever he has
//     stalled, the same forceactivate + re-runto pattern coop_mod/officer.scr uses to get the
//     officer back to his radio through a firefight.
//===========================================================================
coop_ally_advance:

	//[user 2026-08-07] Which gun they head for depends on which side they started.
	//The eastern group (positive X, the staircase) could never reach the FAR gun - the log showed
	//"Path not found" for every one of them - and the reason is a door between the two halves of
	//the rear: a closed door breaks the AI link even though a player can open it and walk through.
	//They now push the NEAR gun instead, which is on their side of it.
	//Both destinations are points captured on foot, and both are ~300 units off their gun:
	//  near  88mm_weapon1 (2496 -363) -> ( 2250 -554 390 ), 311 units
	//  far   88mm_weapon2 (-1046 -153) -> ( -871 -464 328 ), 356 units
	//[user 08-07] The far-gun group now pushes right up onto the emplacement. The old point was
	//captured before the rear had nav coverage, so it was chosen for "somewhere they can stand"
	//rather than "close to the gun": 356 units out and 122 BELOW the gun's z 450, i.e. at the foot
	//of the rise instead of on it. maps/m3l1b.pth now covers the emplacement itself, so this is a
	//node walked on top of it - 99 units from 88mm_weapon2 ( -1046 -153 450 ), on the southern side
	//they actually approach from.
	local.dest = ( -1055 -251 440 )
	//[user 08-07] The far-gun group closes much tighter than the near one - 96-296 units off a
	//destination that is itself 99 off the gun, so they end up fighting from ON the emplacement
	//rather than somewhere in the postcode. Still a RANGE, not a fixed point, so they spread out
	//instead of stacking. Set BEFORE the branch below so the near group can override it; the
	//original code assigned stop AFTER the branch, which would have handed both groups one value.
	local.stop = randomint 200
	local.stop = local.stop + 96
	//[user 2026-08-07] All four eastern spawns MOVED. The staircase they were captured on is
	//navmesh-isolated: from there the log showed "Path not found" to the far gun AND to the near
	//gun, and the medic among them could not reach a player either. A player can walk those stairs;
	//the actor nav does not cover them, which is the same player-walkable != AI-reachable trap that
	//caught the gun emplacement and the patrol points. They now start ~64 units off axis garrison
	//points near the NEAR gun - ground where actors provably spawn and path every run.
	if (self.origin[0] > 0)
	{
		local.dest = ( 2250 -554 390 )
		local.stop = randomint 500
		local.stop = local.stop + 300
	}
	local.prev = self.origin
	//[user 2026-08-07] They do not need to reach the gun, just hold that ground - so each man
	//stops at his OWN distance (300-800) rather than everyone converging on one spot and stacking
	//up. The result is a squad spread across the area around the emplacement instead of a clump.

	while (isAlive self)
	{
		wait 3
		if (!isAlive self){ end }

		//close enough - hold this ground and let him fight from here
		if (vector_length(self.origin - local.dest) < local.stop){ break }

		//stalled (pinned, engaged, or the order was dropped) - shove him along again
		if (vector_length(self.origin - local.prev) < 48)
		{
			self forceactivate
			self runto local.dest
		}
		local.prev = self.origin
	}

	thread coop_ally_hold

end


//===========================================================================
// [user 2026-08-07] Holding behaviour once a ranger reaches the emplacement ground.
// Standing frozen on the spot looks dead, so between fights they stand properly (global/stand.scr,
// which is what retail global/patrol.scr uses for its idle beats) and stroll between three points.
// The three are all points captured ON FOOT for the axis garrison, so they are pathable by
// construction - the whole reason the original advance failed was aiming at a spot with no AI path
// to it, and inventing fresh waypoints here would risk exactly that again.
// No `waittill movedone`: an unreachable destination would hang the thread forever. A plain timed
// wait cannot, and if he never arrives he simply picks another point next cycle.
// Combat always wins over this - the actor drops it to engage and returns when things are quiet.
//===========================================================================
coop_ally_hold:

	while (isAlive self)
	{
		self exec global/stand.scr
		wait 8
		local.extra = randomint 10
		wait local.extra
		if (!isAlive self){ end }

		//[user 2026-08-07] The patrol WALK is gone. Once they reached the hold ground the log filled
		//with "Path not found ... to (-1007 280 384)" and "(-861 297 384)": those two points are not
		//AI-connected to where the squad ends up, even though a player can walk to all three. Being
		//captured on foot proves a PLAYER can reach a spot, not that the actor navmesh links them -
		//a distinction I got wrong twice now. Rather than guess at a third set of waypoints, they
		//hold position and idle properly, which is what global/stand.scr above gives them.
	}

end


//===========================================================================
// [user 2026-08-07] NAV PROBE - which spawn points can an ACTOR actually use?
// Half the 44 points on this map are unusable and I have now guessed wrong about which three
// times, because a point a PLAYER can walk to is not necessarily on the actor navmesh. This stops
// the guessing: every spawned actor is told to walk a short distance, and 6 seconds later we
// record whether he moved. Anything that never moved is either off-mesh ("couldn't find start
// node") or walled into a pocket - either way the point is dead and must be replaced.
// One line per point, machine-readable, so a single playthrough yields the definitive list:
//   ^~^~^ NAVPROBE OK   AXIS ( x y z ) moved N
//   ^~^~^ NAVPROBE DEAD ALLY ( x y z ) moved 0
// Grep the log for "NAVPROBE DEAD" and every bad coordinate is named.
//===========================================================================
coop_navprobe local.tag:

	local.start = self.origin

	//nudge him somewhere close - the DISTANCE does not matter, only whether he can move at all
	local.dest = local.start
	local.dest = local.dest + ( 96 96 0 )
	self forceactivate
	self runto local.dest

	wait 6
	if (!self){ end }

	local.moved = int( vector_length( self.origin - local.start ) )
	local.pt = self.coop_spawnPt
	local.txt = local.tag + " ( " + int(local.pt[0]) + " " + int(local.pt[1]) + " " + int(local.pt[2]) + " ) moved " + local.moved
	if (local.moved < 8)
	{
		println( "^~^~^ NAVPROBE DEAD " + local.txt )
	}
	else
	{
		println( "^~^~^ NAVPROBE OK   " + local.txt )
	}

end

//=========================================================================
// [user 2026-08-09] announce the first objective once someone is there to see it (m2l2a recipe).
//=========================================================================
coop_objToastStart:
	waitthread coop_mod/replace.scr::waitForPlayer
	wait 2
	waitthread coop_mod/objectives.scr::coop_obj_toast_all 1 "Clear out the bunker."
end
