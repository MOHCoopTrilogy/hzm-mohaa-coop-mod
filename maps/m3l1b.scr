//*************************************************************
//*************************************************************
//
// FUNCTION THREADS
//
//*************************************************************
//*************************************************************

// take path, to tell an AI to take a path
// $targetname takepath <name of path> <movement method|walk - walks, default is run>
//=========================================================================
takepath local.path local.movement:{
//=========================================================================
	if (local.self.ismoving == 1){
		println local.self " is already moving, aborting takepath!"
		end
	}

	local.self.ismoving = 1

	switch (local.movement)
	{
		case "walk":
			println ( "XXX " + local.self.targetname + " start walking on path " + local.path)
			local.self exec global/walkto.scr local.path
			local.self waittill movedone
			break

		default:
			println ("XXX " + local.self.targetname + " start running on path " + local.path)
			local.self exec global/runto.scr local.path
			local.self waittill movedone
			break
	}
	local.self.ismoving = 0
}end


//*************************************************************
// move object
// move_object <distance to move to|vector> <time to take>
//*************************************************************
move_object local.distance local.time:

//*** calculate how many moves it will have to make based on once/server frame
local.index = local.time / .05

//*** calculate the distance per move per axis
local.move_distance_x = local.distance[0] / local.index
local.move_distance_y = local.distance[1] / local.index
local.move_distance_z = local.distance[2] / local.index

//*** move the object every sever frame
for (local.i = 0 ; local.i <= local.time ; local.i += .05)
{
	local.newx = local.self.origin[0] + local.move_distance_x
	local.newy = local.self.origin[1] + local.move_distance_y
	local.newz = local.self.origin[2] + local.move_distance_z

	//*** set the new origin
	local.self.origin = (local.newx local.newy local.newz)

	waitframe
}

end


//******************************************************************************
// shooting routine for the AI
// <$targetname_of_ai> ai_shoot_volley <target to aim at> [optional crouch when done]
//******************************************************************************
ai_shoot_volley local.target local.crouch:

//*** if he's dead, quit out
if !(isalive local.self)
{
	goto ai_shoot_volley_end
}

//*** make the ai stand up
local.self exec global/stand.scr

//*** set variable to tell that this guy is shooting a volley
local.shots = ((randomint 3) + 5)
local.self exec global/aimat.scr local.target

wait .5
for (local.i = 1 ; local.i <= local.shots ; local.i ++)
{
        local.self exec global/shoot.scr
        wait (randomfloat .3 + .15)
}

local.self exec global/aimat.scr NULL

if (local.crouch != NIL)
{
	local.self exec global/crouch.scr
}

ai_shoot_volley_end:
end


//*************************************************************
// killing an AI with gunfire
// <$targetname_of_ai> ai_mg_death
//*************************************************************
ai_mg_death:

if !(isalive local.self)
{
	goto ai_mg_death_end
}

//*** set variable to tell that this guy is shooting a volley
local.shots = ((randomint 2) + 2)

for (local.i = 1 ; local.i <= local.shots ; local.i ++)
{
	local.self thread bhit 20 -1
	wait (randomfloat .3 + .15)
}

local.self thread bhit 1000 -1

ai_mg_death_end:
end


//*************************************************************
// killing an AI with mortar
// <$targetname_of_ai> ai_mortar_death [water, mine | default dirt]
//*************************************************************
ai_mortar_death local.type:

if !(isalive local.self)
{
	goto ai_mortar_death_end
}

//*** set the guys death animation
local.self exec global/setdeathanim.scr death_mortar

//*** set the type of mortar
if (local.type == "water")
{
	local.spawn_type = "models/animate/fx_mortar_water"
}
else if (local.type == "mine")
{
	local.spawn_type = "models/animate/fx_explosion_mine"
}
else
{
	local.spawn_type = "models/animate/fx_mortar_dirt"
}

//*** set the origin and targetname
local.spawn_origin = local.self.origin
local.spawn_origin[2] += 32
local.spawn_mortar = (local.self.targetname + "_mortar")

//*** spawn the item
spawn local.spawn_type targetname local.spawn_mortar
local.spawn_mortar = $(local.self.targetname + "_mortar")

//*** reset the items origin
local.spawn_mortar.origin = local.spawn_origin

//*** call the mortar
local.spawn_mortar waitthread mortar_call 1

wait 2
local.spawn_mortar remove

ai_mortar_death_end:
end


//*****************************************************
//  mortar call in
// <mortar> mortar_call [play leadin sound| any value for no]
//*****************************************************
//=========================================================================
mortar_call local.leadin:{
//=========================================================================
	if (local.leadin == NIL){
		//[200] Smithy - i assume this was a change made? Not needed
		//$world playsound arty_leadin wait 		
		//$world waittill sounddone
		println "PLAYING SOUND????"
		//[200] Smithy - playsound commands work against targetname arrays, and we don't need to play a sound if players aren't in server i suppose...
		if ($player){
			$player thread coop_mod/replace.scr::playsound_wait "arty_leadin"
			wait 3
		}
	}

	local.self anim start

	if(level.gametype == 0){	//chrissstrahl - sp handle
		//check the distance to the player, if he's close, use the greater jitter
		local.distance = vector_length (local.self.origin - $player.origin)

		if (local.distance >= 513) //*** beyond 512, small shake
		{
			thread jitter_small
		}
		else if (local.distance >= 193) //*** between 193 and 512, medium shake
		{
			thread jitter_medium
		}
		else if (local.distance >= 97) //*** between 97 and 192, large jitter, hurt the player if he's not in cover
		{
			thread jitter_large
		}
		else //*** under 97, large jitter, kill the player regardless of cover
		{
			thread jitter_large
		}
	}else{	//chrissstrahl - coop handle
		thread jitter_small
	}
	radiusdamage local.self.origin 1000 192
}end


//**************************************************************************************************************************************
//  bullet hit command
//  <target> bhit [damage| 40 default] [body location| default is chest, -1 is random] [direction| vector] [force to apply| 15 default]
//**************************************************************************************************************************************
bhit local.damage local.location local.direction local.force:

if (local.damage == NIL || local.damage == 0)
{
	local.damage = 40
}

if (local.location == NIL)
{
	local.location = 3
}
else if (local.location == -1)
{
	local.temp = (randomint 17 + 1)
	local.location = local.temp
}

if (local.direction == NIL || local.direction == 0)
{
	local.direction = (0 -1 0)
}

if (local.force == NIL)
{
	local.force = 15
}

//*** set the characters script_damage variable so the player doesn't lose the level
local.self.script_damage = 1

//*** damage the target
local.self exec global/bullethit.scr local.direction local.damage local.force local.location

local.self playsound snd_bh_flesh

local.self.script_damage = 0

end


//******************************
// jitter effect from mgs
// jitter_mg [delay]
//******************************
jitter_mg local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .5 1 0 0

waitexec global/earthquake.scr .3 1 0 0

end


//*********************************
// jitter effect from mgs in cover
// jitter_mg_cover [delay]
//*********************************
jitter_mg_cover local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .3 .5 0 0

waitexec global/earthquake.scr .3 .2 0 0

end


//*********************************
// jitter effect from mgs in cover
// jitter_small [delay]
//*********************************
jitter_small local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .3 1 0 0

waitexec global/earthquake.scr .3 .75 0 0

waitexec global/earthquake.scr 1.25 .3 0 0

end


//******************************
// jitter medium effect
// jitter_medium [delay]
//******************************
jitter_medium local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .23 2 0 0

waitexec global/earthquake.scr 1 1 0 0

waitexec global/earthquake.scr 1.25 .3 0 1

end


//******************************
// jitter large effect
// jitter_large [delay]
//******************************
jitter_large local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .25 3 0 0

waitexec global/earthquake.scr .4 1.25 0 0

waitexec global/earthquake.scr 1 .75 0 0

waitexec global/earthquake.scr 1.25 .3 0 1

end


//********************************************
// jitter effect from being next to artillery
// jitter_artillery [delay]
//********************************************
jitter_artillery local.time:

if (local.time)
{
	wait local.time
}

waitexec global/earthquake.scr .23 3 0 0

//waitexec global/earthquake.scr .3 .5 0 0

end


//********************************************
// huddraw refresh thread
//********************************************
huddrawrefresh:

println "NEED HUDDRAW REFRESH!!"

end


//===========================================================================
// HZM coop [RESTORED CUT OBJECTIVE] - Destroy the two FLAK 88 emplacements in the back-field.
// The retail BSP shipped two 88mm guns (88mm_weapon1 near, 88mm_weapon2 far back), each with a plant
// trigger (88mm_trigger1/2) + a pulse_explosive charge marker (88mm_explosive1/2) carrying the exact entity
// keys the MP bomb system reads ($trigger_name/$explosion_fx/target). The devs CUT the objective and just
// ended the level after the bunker gunners. This re-wires it with the REAL MP bomb-plant
// (global/obj_dm.scr::bomb_thinker) exactly how the Omaha MP map obj_team3 does it - 6s timed plant, plant
// animation, physical bomb, explosion + wrecked-gun swap - then gates the exit on both being blown.
//===========================================================================
coop_flak88_objective:

	if (level.coop_flak88_started == 1){ end }
	level.coop_flak88_started = 1
	level.coop_flak88_destroyed = 0

	//*** MP bomb-plant params (mirror obj_team3, the Omaha Beach MP map)
	level.bomb_damage = 200
	level.bomb_explosion_radius = 640
	level.planting_team = "allies"

	//*** objective + map marker on the nearer gun
	waitthread global/objectives.scr::add_objectives 3 2 "Destroy the 2 FLAK 88 artillery emplacements" $88mm_weapon1.origin
	waitthread global/objectives.scr::current_objectives 3

	//*** arm the plant points and start the REAL bomb thinkers on the charge markers (timer/anim/bomb/boom
	//*** all come from the entity keys already on the markers)
	$88mm_trigger1 triggerable
	$88mm_trigger2 triggerable
	$88mm_explosive1 thread global/obj_dm.scr::bomb_thinker
	$88mm_explosive2 thread global/obj_dm.scr::bomb_thinker

	//[user 2026-08-07] The fuse and the defuse team MUST be set AFTER bomb_thinker runs, not before.
	//bomb_thinker opens by hardcoding its own level.bomb_tick_time = 45 (and bomb_damage /
	//bomb_explosion_radius), silently overwriting anything we set above it - which is why a planted
	//charge sat for 45 quiet seconds and read as a dud. waitframe lets both thinkers get past that
	//assignment; the explode loop reads the value at PLANT time, so the shorter fuse still applies.
	waitframe
	level.bomb_tick_time = 15
	//[user 2026-08-07] Instant plant. bomb_set_time is in TENTHS of a second and bomb_thinker
	//hardcodes 50 (a 5s hold-to-plant). The rest of the trilogy plants on a single use press, so
	//drop it to one 0.1s tick - the plant loop needs at least one iteration to reach its counter
	//test, so 0 would never complete.
	level.bomb_set_time = 1
	//retail leaves level.defusing_team unset here, so an allied player brushing the plant trigger
	//after arming gets "You're on the wrong team to defuse this bomb!". Everyone is allies in coop,
	//so name axis and the defuse path simply never engages.
	level.defusing_team = "axis"

	//*** watch each bomb; when bomb_thinker sets .exploded, count it + silence that gun
	thread coop_flak88_watch $88mm_explosive1 $88mm_weapon1
	thread coop_flak88_watch $88mm_explosive2 $88mm_weapon2

	//*** the guns fire on the beach until knocked out; a few defenders hold the emplacements
	//[user 2026-08-07] MODEL SWAP - this is what finally gets a real animated shot.
	//Both guns are declared "classname turretweapon_german_88mmflakturret" in the BSP, the SAME
	//class m3l2 uses for its firing flak - the designer just pointed them at 15cmcannon.tik, whose
	//animations block holds nothing but "idle". No script can animate a shot that is not in the
	//model. flak88turret.tik carries fire_scripted (88turret_fire.skc) with `first sound
	//flak_snd_fire` as a frame command, so the recoil and the report both come from the anim -
	//exactly how retail m3l2::flak88_thinker does it (`local.gun_name anim fire_scripted`).
	//Swapping the mesh does NOT re-run the tik init, so these stay class Animate: the bomb-plant
	//wiring, triggers and destroyed-model swap are all untouched. Only the mesh and its anims change.
	//It also makes the map self-consistent - the objective text, entity class, trigger names and
	//explosion FX (fx_flak88_explosion.tik) already all say FLAK 88; only the model disagreed.
	if( $88mm_weapon1 != NULL ){ $88mm_weapon1 model "models/statweapons/flak88turret.tik" }
	if( $88mm_weapon2 != NULL ){ $88mm_weapon2 model "models/statweapons/flak88turret.tik" }
	//match the wreck to the gun - the BSP sets $destroyed_model to 15cmcannon_d, which would leave
	//a 15cm cannon wreck sitting where a flak 88 just blew up.
	//[user 2026-08-07] Aim baked from live tuning (coop_flakYaw/Pitch, since removed):
	//  near gun  base 45  + 220 = 265 yaw, -20 pitch
	//  far gun   base 135 + 160 = 295 yaw, -20 pitch
	//Negative pitch is UP in MOHAA, so both barrels sit 20 degrees elevated - they are AA guns
	//shelling out over the beach, not levelled at it. Spaced vector literals: a bare "(-20 ..."
	//with no space is a parse killer, the spaced form is what every shipped script uses.
	if( $88mm_weapon1 != NULL ){ $88mm_weapon1.angles = ( -20 265 0 ) }
	if( $88mm_weapon2 != NULL ){ $88mm_weapon2.angles = ( -20 295 0 ) }
	if( $88mm_weapon1 != NULL ){ $88mm_weapon1.destroyed_model = "statweapons//flak88_d.tik" }
	if( $88mm_weapon2 != NULL ){ $88mm_weapon2.destroyed_model = "statweapons//flak88_d.tik" }
	waitframe

	thread coop_flak88_fire $88mm_weapon1
	thread coop_flak88_fire $88mm_weapon2
	thread coop_flak88_defenders
	//[user 2026-08-07] Rear garrison spawns HERE, when the 88 objective opens - not on completion.
	//Hooking it to coop_flak88_complete meant the rear was empty for the whole fight and only
	//populated once the guns were already down, which is backwards for "defend the rear area".
	thread coop_rear_defenders
	thread coop_ally_push
	thread coop_rear_headcount

end


//===========================================================================
// Watch a planted bomb; when bomb_thinker detonates it (.exploded), count the kill + stop that gun firing.
//===========================================================================
coop_flak88_watch local.bomb local.gun:

	if (local.bomb == NULL){ end }

	//[user 2026-08-07] obj_dm.scr's explode loop shows NO stopwatch - it just ticks silently for the
	//fuse, which is what made a planted charge read as a dud. Watch for the plant here (bomb_thinker
	//sets .live = 1 the instant it arms) and put the fuse on the native stopwatch for every player,
	//the same way coop_mod/officer.scr::coop_radio_bomb_countdown does its charge.
	while (local.bomb.live != 1 && local.bomb.exploded != 1)
	{
		waitframe
	}
	if (local.bomb.exploded != 1)
	{
		exec coop_mod/replace.scr::stopwatch level.bomb_tick_time
	}

	while (local.bomb.exploded != 1)
	{
		waitframe
	}

	if (local.gun != NULL){ local.gun.coop_fireStop = 1 }
	//[user 2026-08-07] Guaranteed detonation report. obj_dm.scr only plays a blast if the charge
	//marker carries an explosion_sound entity key (`if (self.explosion_sound != NIL)`), and these
	//retail pulse_explosive markers evidently do not - the kill was silent. explode_flak88 is
	//aliased maps "m e t" so it loads here, unlike the flak FIRE aliases (bug-1548).
	if (local.gun != NULL){ local.gun playsound explode_flak88 }

	level.coop_flak88_destroyed = level.coop_flak88_destroyed + 1
	if (level.coop_flak88_destroyed >= 2)
	{
		thread coop_flak88_complete
	}

end


//===========================================================================
// Restored firing-on-the-beach: the turret ACTUALLY fires (muzzle + sound + recoil) every few
// seconds until destroyed - not an explosion effect. Needs BOTH startFiring and an aim target;
// see the note in the body for why startFiring on its own never discharges.
//===========================================================================
coop_flak88_fire local.gun:

	if (local.gun == NULL){ end }

	//[user 2026-08-07] The gun now wears flak88turret.tik (swapped in coop_flak88_objective), so
	//fire_scripted exists and this is the retail recipe verbatim. The anim carries its own
	//`first sound flak_snd_fire` frame command, so no separate playsound is needed - and that alias
	//only resolves here because m3l1b was added to its maps spec (bug-1548).
	//Earlier attempts and why they failed, so nobody re-treads them:
	//  startFiring/setAimTarget -> Script Error, class Animate has no turret API.
	//  anim fire_scripted on 15cmcannon.tik -> silent no-op, that model has only "idle".
	//  spawn cannonsmoke.tik -> NIL, the tik declares no server classname.
	//  explosion_bombwall.tik as a stand-in muzzle blast -> spawned fine, looked wrong.
	//[user 2026-08-23, bug-2087] GUARD THE GUN. This looped on local.gun with no NULL test, so
	//the moment the flak was destroyed every line in the body threw - "Field 'coop_fireStop'
	//applied to NULL listener", "command 'anim' applied to NULL listener", then the
	//vector_length pair cascading into "Cannot cast 'none' to vector". Script Errors do NOT
	//kill a thread in this engine, so it kept re-throwing on its 4-8s beat for the rest of the
	//map. `&&` short-circuits, so testing the handle first closes it.
	while (local.gun != NULL && local.gun.coop_fireStop != 1)
	{
		if (local.gun == NULL){ break }
		local.gun anim fire_scripted

		//shake anyone close as it goes off. NOT $player.origin - $player is an array in coop.
		local.near = exec coop_mod/replace.scr::player_closestTo local.gun
		if (local.near != NULL)
		{
			if (vector_length(local.gun.origin - local.near.origin) < 1200)
			{
				thread jitter_artillery 0
			}
		}

		//retail m3l2 paces its flak on a randomised beat rather than a metronome
		local.gap = 4 + (randomint 4)
		wait local.gap
	}

end


//===========================================================================
// A few German defenders from the bunker-exit spawn points (valid ground), sent at the players.
//===========================================================================
coop_flak88_defenders:

	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn1
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn2
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn1
	wait 0.4
	waitthread coop_flak88_spawn_defender $mg42_bunker_upper_fodder_spawn2

end


coop_flak88_spawn_defender local.spot:

	if (local.spot == NULL){ end }

	local.sol = spawn "models/human/german_wehrmact_soldier" gun "mauser kar 98k"
	local.sol exec global/disable_ai.scr
	local.sol.origin = local.spot.origin
	local.sol exec global/enable_ai.scr

	local.player = exec coop_mod/replace.scr::player_closestTo local.sol
	if (local.player != NULL)
	{
		local.sol exec global/runto.scr local.player
	}

end


//===========================================================================
// Both guns destroyed -> complete the objective and open the exit.
//===========================================================================
coop_flak88_complete:

	iprintlnbold "Both FLAK 88 emplacements destroyed - clear the backline!"

	waitthread global/objectives.scr::add_objectives 3 3
	//[user 2026-08-07] The mission now ends on CLEARING the rear, not on walking back to the
	//bunker. Marker points at the garrison rather than the exit trigger.
	waitthread global/objectives.scr::add_objectives 4 2 "Clear the backline of enemies." ( 1047 95 320 )
	waitthread global/objectives.scr::current_objectives 4


	//[user 2026-08-07] The exit trigger is NOT armed here any more. Leaving it live meant walking
	//out of the bunker ended the mission and skipped the backline objective entirely - which is
	//exactly what happened on the first playtest. Hard-lock protection moved to coop_rear_stallwatch
	//below, which can only arm the exit after the kill count has genuinely stopped moving.
	thread coop_rear_stallwatch

end

//===========================================================================
// [user 2026-08-07] Rear-area garrison. Spawned once the FLAK 88s are down and the squad is sent
// back toward the exit, so the whole run home is not a walk through an empty map.
// Deliberately NOT given a runto: coop_flak88_spawn_defender above sends its men AT the players,
// which is assault behaviour. These hold where they are placed and engage on sight, which is what
// "defend the rear area" means. Points captured live with viewpos; the yaws viewpos printed were
// accumulated past one turn (-422, -796 ...) and are normalised into 0..360 here.
// Both models used below are already spawned elsewhere on this map (see the bunker_upper fodder
// block), so nothing new has to be precached.
//===========================================================================
coop_rear_defenders:

	if (level.coop_rearDefenders == 1){ end }
	level.coop_rearDefenders = 1
	level.coop_rear_total = 0
	level.coop_rear_alive = 0
	level.coop_rear_shown = -1

	waitthread coop_rear_spawn ( 391 365 320 ) 298 0
	wait 0.3
