//=========================================================================
// HZM coop - MAP TOUR STUB: GERMAN - Communications Blackout village
// [user 2026-08-05] Holdout-candidate tour (MOHAARU pack). Overrides the pack's own MP script so
// the coop framework boots and the map is walkable with our tools (build mode allowed via
// coop_arenaMap). No objectives, no waves - layout evaluation only. Enemies come later, once a
// candidate is picked and authored like e3l4_arena.
//=========================================================================
main:
{
	level.coop_btMap = 1
	waitthread coop_mod/main.scr::main		//HZM coop - MUST be first

	level.coop_arenaMap = 1
	level.coop_weatherTheme = "none"

	level waittill prespawn
	level waittill spawn

	println( "^~^~^ MAPTOUR: german up - walk it; press N for the next candidate" )
	iprintlnbold_noloc( "TOUR: GERMAN - Communications Blackout village" )
}end
