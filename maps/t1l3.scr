//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// balcony nazi - special death
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
balcony_death_nazi_deathcheck:

	self.health = 10000
	self.nolongpain = 1
	self.ainocrouch = 1
	self.ainoprone = 1
	self.ainododge = 1
	self.ainohopforward = 1
	self.ainohopbackward = 1
	self.ainointerval = 1
	self.type_grenade = balcony_grenade

	local.health = self.health

	while ( local.health == self.health )
	{
		waitframe
	}

	self nodamage
	self thread balcony_death_nazi_deathanim

	wait 0.75
	self pophelmet
	self playsound snd_crate_wood3
	thread global/exploder.scr::explode 6

end

balcony_death_nazi_deathanim:

	self exec global/disable_ai.scr
	self anim 13A401_fall
	self waittill animdone
	self notsolid
	self bedead

end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// captain balcony jump
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
trigger_captain_jump:

	exec gags/t1l3_captain_jump_balcony.scr::t1l3_captain_jump

end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
// stay on path enemies
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
stayonpath local.dumbdelay:

//	dprintln "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ " self.targetname " waiting to stayonpath"
	local.bias = self.threatbias

	self exec global/disable_ai.scr 
	self notsolid
	self hide
	self threatbias ignoreme
	self ai_off

	self waittill trigger
//	dprintln "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ " self.targetname " was triggered to stayonpath, will wait " local.dumbdelay " to activate AI"

	self solid
	self show
	self threatbias local.bias
	self ai_on

	self runto self.target
	wait local.dumbdelay

	self exec global/enable_ai.scr 

end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
groupstayonpath local.group local.dumbdelay:

	if ( local.group != NIL )
	{
		local.count = local.group.size

		if ( local.count > 0 )
		{
			for ( local.i = 1; local.i <= local.count; local.i++ )
			{
				local.group[local.i] thread stayonpath local.dumbdelay
			}
		}
	}

end


//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
triggerstayonpath local.trigger local.dumbdelay local.triggerthread:

//	dprintln "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ triggerstayonpath " local.trigger
	if ( local.trigger != NIL )
	{
		if ( local.trigger.target != NIL )
		{
			local.count = $(local.trigger.target).size

			if ( local.count > 0 )
			{
				local.targs = exec global/makearray.scr $(local.trigger.target)
				for ( local.i = 1; local.i <= local.count; local.i++ )
				{
					local.targs[local.i] thread stayonpath local.dumbdelay
				}
			}

			if ( local.triggerthread != NIL )
			{
				local.trigger.target = NULL
				local.trigger thread local.triggerthread
			}
//			else
//			{
//				local.trigger waittill trigger
//				waitframe
//				local.trigger remove
//			}
		}
	}

end

// stub handlers - called by coop framework on player events
coop_playerJustSpawned:
end

coop_playerJustLeft:
end

coop_playerJustRespawned:
	// HZM coop - re-apply t1l3's British resistance loadout on respawn. Without this the engine hands the
	// respawning player the default M1 Garand (MP spawn weapon) instead of the Sten/Enfield the mission
	// starts with. Mirrors the initial loadout block above (binoculars are left to the reward-item system).
	local.player = parm.other
	if ( local.player == NULL )
		end
	local.player takeall
	local.player item weapons/Webley_Revolver.tik
	local.player item weapons/enfield.tik
	local.player item weapons/sten.tik
	local.player item weapons/mills_grenade.tik
	local.player item weapons/M18_smoke_grenade.tik
	local.player ammo pistol 32
	local.player ammo smg 128
	local.player ammo rifle 49
	local.player ammo smokegrenade 3
	local.player useweaponclass smg
end


//-------------------------------------------------------------------------
// HZM coop - ENDGAME FALLBACK SPAWN
//
// The coop respawn warper normally returns a player to where they died. When
// it can't (warper disabled, or no valid saved origin) the player falls back
// to the predefined coop_spawn location - which on t1l3 is the default map
// spawns near the boat START. So a death during the final flak/bridge stretch
// could bounce you all the way back. Once the Tiger tank is destroyed, move
// the fallback spawn for all 8 player slots to the endgame area so respawns
// land near the action. (Warper-to-death-spot still takes priority when valid.)
//-------------------------------------------------------------------------
coop_endgameSpawn:

	while ( level.tankdestroyed != 1 )
	{
		wait 1
	}

	for ( local.i = 1; local.i <= 8; local.i++ )
	{
		level.flags["coop_spawn"+local.i+"origin"] = ( -1898 2239 105 )
		level.flags["coop_spawn"+local.i+"angles"] = ( 0 88 0 )		// user gave 808; 808 == 88 normalized
	}

end


//-------------------------------------------------------------------------
// HZM coop - CAPTAIN FULL INVINCIBILITY  ("invincible + kill the fail")
//
// The captain's only scripted death is a mission-FAIL: the stock tank gag
// (tankpath3) fires radiusdamage 1500 at him, and colonel-gag captaindeathcheck
// turns any captain death into "You failed the mission" -> missionfailed. In
// coop's chaos (scaled enemies, stray fire) that fail is far too easy to trip.
//
// immortal can't be used - Actor::IsImmortal() is stubbed to false in OpenMOHAA -
// and 'nodamage' gets flipped back on by the tank gag's own 'takedamage' call.
// So we give the captain an enormous health pool and keep it topped up. 1500 tank
// damage (or any stray fire) can never bring 1e6 HP to 0, so he never dies -> the
// captaindeathcheck 'waittill death' never fires -> missionfailed never triggers.
// That single mechanism delivers BOTH the invincibility and the killed fail.
//-------------------------------------------------------------------------
coop_captainInvincible:

	local.cap = $friendlycaptain
	if ( local.cap == NULL )
		end

	local.cap.health = 1000000

	while ( local.cap != NULL )
	{
		if ( local.cap.health < 500000 )
			local.cap.health = 1000000
		wait 0.5
	}

end
