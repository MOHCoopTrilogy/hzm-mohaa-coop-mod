//==========================================================================================================//
// LEVEL:       co_lobby2.bsp   (a copy of m1l1.bsp)
// TITLE:       HZM Coop - Post-Mission Lobby #2 (m1l1 "medic camp" staging area)
// FLOW:        ... m1l1  ->  co_lobby2  ->  m1l2a
// NOTE:        m1l1's own mission script (objectives, scripted spawns, enemy actors) is NOT run here -
//              co_lobby2.scr only keeps the world geometry, then hands off to the shared coop_mod/lobby.scr.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby2.scr"
	level.coop_aaMap = 1							// AA-side level
	level.coop_lobbyMap = 1							// marks this as a lobby (gates mission behaviors)

	// --- per-lobby framing for the SHARED lobby framework (coop_mod/lobby.scr reads these) ---
	// the m1l1 "medic camp": 4 player anchors (viewpos EYE height), the static camera, and the next map.
	level.coop_lobbySlotOrg[1] = ( -6434 2178 514 )
	level.coop_lobbySlotYaw[1] = 178
	level.coop_lobbySlotOrg[2] = ( -6486 2043 514 )
	level.coop_lobbySlotYaw[2] = 177
	level.coop_lobbySlotOrg[3] = ( -6397 1841 514 )
	level.coop_lobbySlotYaw[3] = 155
	level.coop_lobbySlotOrg[4] = ( -6417 2274 514 )
	level.coop_lobbySlotYaw[4] = 199
	level.coop_lobbyCamOrg = ( -6761 1948 557 )
	level.coop_lobbyCamYaw = 29
	level.coop_lobbyNextMap = "m1l2a"				// completing this lobby launches m1l2a
	level.coop_lobbySkipProps = 1					// use OUR baked objects, not the training props

	waitthread coop_mod/main.scr::main				// MUST be first
	level.coop_weatherTheme = "none"				// no dynamic precip in the lobby

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain			// camera, auto-spawn, roster, ready, skins, music, launch
	thread spawnLobby2Objects						// our baked build-mode scene
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_m1l1.dat (build-mode capture; your removals already applied). 12 static props + 1
// animated medic actor. Origins are m1l1 world coords, so they land exactly where you placed them.
//=========================================================================
spawnLobby2Objects:{
//=========================================================================
	local.m = spawn script_model
	local.m model "models/static/af_p_stretcher.tik"
	local.m.origin = ( -6597.180 2177.300 394.125 )
	local.m.angles = ( 0 262 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/body_usvest06.tik"
	local.m.origin = ( -6595.797 2188.200 436.125 )
	local.m.angles = ( 0 82 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/items/cigarette.tik"
	local.m.origin = ( -6613.125 2265.677 495.105 )
	local.m.angles = ( 345 7 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/miscobj/clipboard.tik"
	local.m.origin = ( -6579.826 2272.645 496.125 )
	local.m.angles = ( 0 97 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/miscobj/bottle_condiment.tik"
	local.m.origin = ( -6567.978 2282.449 496.125 )
	local.m.angles = ( 0 97 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/static_m1_garand.tik"
	local.m.origin = ( -6600.718 2188.060 450.125 )
	local.m.angles = ( 0 22 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/vehicle_m3.tik"
	local.m.origin = ( -6548.159 2134.525 450.125 )
	local.m.angles = ( 0 202 0 )
	local.m notsolid

	// animated actor: medic. coop_act_cleanshoes is being repaired in parallel; the animator loops whatever
	// the alias resolves to.
	local.m = spawn script_model
	local.m model "models/player/american_army_medic.tik"
	local.m.origin = ( -6503.291 2294.819 426.125 )
	local.m.angles = ( 0 262 0 )
	local.m notsolid
	local.m.coop_sceneAnim = "coop_act_cleanshoes"
	local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate

	local.m = spawn script_model
	local.m model "models/miscobj/crate_carry.tik"
	local.m.origin = ( -6509.211 2248.804 438.125 )
	local.m.angles = ( 0 247 0 )
	local.m scale 1.400
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/items/item_50_healthbox.tik"
	local.m.origin = ( -6531.978 2256.129 454.125 )
	local.m.angles = ( 0 247 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/miscobj/tallglass.tik"
	local.m.origin = ( -6574.844 2287.931 496.125 )
	local.m.angles = ( 0 247 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/woodbucket.tik"
	local.m.origin = ( -6584.751 2239.361 432.125 )
	local.m.angles = ( 0 247 0 )
	local.m notsolid

	local.m = spawn script_model
	local.m model "models/static/steilhangrenate.tik"
	local.m.origin = ( -6592.894 2301.391 496.125 )
	local.m.angles = ( 0 247 0 )
	local.m notsolid
}end
