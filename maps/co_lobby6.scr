//==========================================================================================================//
// LEVEL:       co_lobby6.bsp   (a copy of m2l1.bsp, axis AI stripped - same geometry as co_lobby5)
// TITLE:       HZM Coop - Post-m2l1 staging lobby (intel / codebreaking spot, Enigma machine)
// FLOW:        ... m2l1 -> co_lobby6 -> m2l2a
// NOTE:        m2l1's mission script is NOT run here; co_lobby6.scr keeps geometry + hands off to lobby.scr.
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby6.scr"
	level.coop_aaMap = 1
	level.coop_lobbyMap = 1

	// --- per-lobby framing (viewpos grab 2026-07-09; FIRST coord = camera; spawn yaws normalized) ---
	level.coop_lobbyCamOrg = ( 3642 6924 233 )		// FIRST coord = camera
	level.coop_lobbyCamYaw = 22
	level.coop_lobbySlotOrg[1] = ( 3752 7218 258 )
	level.coop_lobbySlotYaw[1] = 244
	level.coop_lobbySlotOrg[2] = ( 3881 7022 258 )
	level.coop_lobbySlotYaw[2] = 205
	level.coop_lobbySlotOrg[3] = ( 4050 6987 258 )
	level.coop_lobbySlotYaw[3] = 191
	level.coop_lobbySlotOrg[4] = ( 3898 6906 258 )
	level.coop_lobbySlotYaw[4] = 176
	level.coop_lobbyNextMap = "m2l2a"				// completing this lobby launches m2l2a
	level.coop_lobbySkipProps = 1

	waitthread coop_mod/main.scr::main
	level.coop_weatherTheme = "none"				// natural map look (no forced weather this time)

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain
	thread spawnLobby6Objects
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from build_m2l1.dat - THIS SESSION only (this launch = count 1). A single Enigma machine.
//=========================================================================
spawnLobby6Objects:{
//=========================================================================
	local.m = spawn script_model
	local.m model "models/static/static_enigmaopen.tik"
	local.m.origin = ( 3885.092 7125.804 240.125 )
	local.m.angles = ( 0 241 0 )
	local.m notsolid
}end
