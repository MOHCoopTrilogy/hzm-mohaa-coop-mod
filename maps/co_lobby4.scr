//==========================================================================================================//
// LEVEL:       co_lobby4.bsp   (a copy of m1l3c.bsp)
// TITLE:       HZM Coop - Pre-Finale Lobby #4 (staging in the m1l3c area before Chapter 1's last mission)
// FLOW:        ... m1l3b (last jeep mission)  ->  co_lobby4  ->  m1l3c (Chapter 1 finale)
// NOTE:        m1l3c's own mission script (objectives, scripted spawns, enemy actors) is NOT run here -
//              co_lobby4.scr only keeps the world geometry, then hands off to the shared coop_mod/lobby.scr.
// SCENE:       sound-only (no props). One placed generator loop from build mode (snd_m1l3c.dat).
//==========================================================================================================//

//=========================================================================
main:{
//=========================================================================
	level.script = "maps/co_lobby4.scr"
	level.coop_aaMap = 1
	level.coop_lobbyMap = 1

	// --- per-lobby framing: the m1l3c staging area (viewpos grab 2026-07-09) ---
	level.coop_lobbySlotOrg[1] = ( -4567 -5942 834 )
	level.coop_lobbySlotYaw[1] = 189
	level.coop_lobbySlotOrg[2] = ( -4577 -5839 834 )
	level.coop_lobbySlotYaw[2] = 193
	level.coop_lobbySlotOrg[3] = ( -4710 -5814 834 )
	level.coop_lobbySlotYaw[3] = 221
	level.coop_lobbySlotOrg[4] = ( -4826 -5790 834 )
	level.coop_lobbySlotYaw[4] = 248
	level.coop_lobbyCamOrg = ( -4892 -5999 857 )
	level.coop_lobbyCamYaw = 39
	level.coop_lobbyNextMap = "m1l3c"				// completing this lobby launches the Chapter 1 finale
	level.coop_lobbySkipProps = 1

	waitthread coop_mod/main.scr::main
	level.coop_weatherTheme = "none"

	level.coop_hasCallback["coop_playerJustSpawned"] = 1
	level.coop_hasCallback["coop_playerJustRespawned"] = 1

	level waittill prespawn
	drawhud 0

	thread coop_mod/lobby.scr::lobbyMapMain
	thread spawnLobby4Objects
}end

//=========================================================================
coop_playerJustSpawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
coop_playerJustRespawned:{
//=========================================================================
	thread coop_mod/lobby.scr::lobbyOnSpawn parm.other
}end

//=========================================================================
// Baked from snd_m1l3c.dat - THIS SESSION's build (BUILD_ON m1l3c 15:48, one sound placed). Sound only.
//=========================================================================
spawnLobby4Objects:{
//=========================================================================
	// generator hum (positional loop - all players hear it, fades with distance)
	local.m = spawn script_model
	local.m model "fx/dummy.tik"
	local.m.origin = ( -4428.845 -6031.875 898.908 )
	local.m notsolid
	local.m loopsound "coop_snd_generator" 1.000 200
}end
