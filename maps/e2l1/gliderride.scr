// gliderride.scr
//============================================================================
StartRide: {
//============================================================================

	thread maps/e2l1/fog.scr::setFog level.fogDistanceTow level.fogBiasTow level.fogColorTow
	
	thread coop_mod/replace.scr::physics_off

	if (level.stickPlayerAtGlider == 1) {
		// debug hack to put player near the glider, for debugging
		$player.origin = $glider.origin
		$player notsolid
	}	

	level.skipDialogue 	 = 0
	level.dialogueFinished	 = 0
	level.gliderDetached 	 = 0
	level.gliderPilotShot 	 = 0
	level.gliderDescentBegun = 0
	level.gliderRideOver 	 = 0
	level.gliderCrashOver	 = 0
	level.gliderTakingFire	 = 0

	//[user 2026-08-03] bug-1312 - suspend player.scr::preventSpawnStuck for the whole ride.
	//Riders are physics_off in a camera and cannot move, so the stuck detector fired, prompted
	//"press use to switch spawnlocation", and ATE the USE press this scene's own beats need
	//(the user lost the restored pilot line to it). Cleared in coop_handlePlayerGliderEject /
	//coop_chuteDrop once the player actually has control.
	level.coop_noSpawnStuck = 1

	thread handlePilot
	thread handlePassengers
	thread handleCamera
	thread handleC47
	thread handleDialogue
	thread handleGlider
	//[coop] was: thread maps/e2l1/pocketflash.scr::DoGliderFlak $flak_left 3
	//retail DoGliderFlak ignores both args (its parameterised body is commented out) and
	//fires all 7 bursts on a hardcoded "wait 38.5" measured from StartRide. In coop the
	//descent no longer lands on that clock - and hacks.scr::allowSkipGliderDialogue lets
	//any player collapse the dialogue and start the descent ~30s early - so the whole
	//volley went off before the glider ever reached the flak cluster. Position-driven now.
	thread coop_gliderFlakVolley
	thread coop_chuteSpawnInit		//[user 2026-08-03] bug-1309 - drop-point table, must exist before handleCrash
	thread coop_preplaceGliderPlayer	//[user 2026-08-04] bug-1328c - park player 1 at the wreck for the WHOLE ride, like vanilla
	//thread RestrictView

	if (level.skipFadeIn == 0) {
		waitthread fadeIn
	}

	waitthread handleCrash
}end

//============================================================================
handlePassengers: {
//============================================================================
	spawn script_model model models/human/Sc_AL_US_CORP.tik targetname gliderDude1 
	spawn script_model model models/human/Sc_AL_US_ltPALIA.tik targetname gliderDude2

	//scaling hack, these guys are too big for the glider
	$gliderDude1 scale .9
	$gliderDude2 scale .9

       //misc stuff
	$gliderDude1 physics_off
	$gliderDude2 physics_off
	$gliderDude1 nodamage
	$gliderDude2 nodamage
	$gliderDude1 notsolid
	$gliderDude2 notsolid
	
	//adjust passengers to fit in the seats
	$gliderDude1 attach $glider passenger1 1 (0 0 0)   //here is the vector voodoo-> (left/right front/back up/down) 	
	$gliderDude2 attach $glider passenger2 1 (0 0 0)
	waitframe 

	$gliderDude1 thread handlePassenger1Idle
	$gliderDude2 thread handlePassenger2Idle

	// wait for the pilot to get shot
	waitthread game.waittill gliderPilotShot //[202] Smithy - save cpu cycles
	/*
	while (level.gliderPilotShot == 0) {
		waitframe
	}
	*/

	// wait for the scene to end and delete the passengers
	if (!level.gliderRideOver){
		waitthread game.waittill gliderRideOver //[202] Smithy - save cpu cycles
	}
	
	/*
   	while (level.gliderRideOver == 0) {
		waitframe
   	}
   	*/

	delete $gliderDude1
	delete $gliderDude2
}end

//============================================================================
doPanicSound local.sound: {
//============================================================================
	wait 0.1
	self playsound local.sound
}end

//============================================================================
handlePassenger1React: {
//============================================================================
	waitthread game.waittill gliderTakingFire //[202] Smithy - save cpu cycles
	wait 0.1 //[202] Smithy - add extra time now we don't do a loop
	/*
	while (level.gliderTakingFire == 0) { 
		wait 0.1
	}
	*/

	// how long to wait before reacting
	wait 2.9
	$gliderDude1 thread doPanicSound snd_den_pain_generic

	// animate the dudes to react
	$gliderDude1 anim A_21_passenger1_panic

	//[user 2026-08-03] bug-1305 - passenger 1 is WOUNDED, not killed (he keeps moving in
	//handlePassenger1FreakedOut), so he gets gore tier 1 only. See coop_bloodyGliderDude.
	$gliderDude1 thread coop_bloodyGliderDude 1

	$gliderDude1 waittill animdone
	$gliderDude1 thread handlePassenger1FreakedOut
}end

//============================================================================
handlePassenger1Idle: {
//============================================================================
	// keep looping the flying animation until the pilot gets shot
	thread handlePassenger1React

	while (level.gliderTakingFire == 0) {
		$gliderDude1 anim A_21_passenger1_idleA
		$gliderDude1 waittill animdone
	}
}end

//============================================================================
handlePassenger2React: {
//============================================================================
	waitthread game.waittill gliderTakingFire //[202] Smithy - save cpu cycles
	wait 0.1 //[202] Smithy - add extra time now we don't do a loop	
	/*
	while (level.gliderTakingFire == 0) { 
		wait 0.1
	}
	*/

	// how long to wait before reacting
	wait 2.5
	$gliderDude2 thread doPanicSound snd_den_pain_generic

	// animate the dudes to react
	$gliderDude2 thread doPanicSound snd_den_pain_generic
	$gliderDude2 anim A_21_passenger2_death

	//[user 2026-08-03] bug-1305 - passenger 2 is KILLED by this burst (A_21_passenger2_death),
	//so he ramps to gore tier 2 (heavy) rather than stopping at light.
	$gliderDude2 thread coop_bloodyGliderDude 2

	$gliderDude2 waittill animdone
}end

//============================================================================
handlePassenger2Idle: {
//============================================================================
	// keep looping the flying animation until the pilot gets shot
	thread handlePassenger2React

	while (level.gliderTakingFire == 0) {
		$gliderDude2 anim A_21_passenger2_idle
		$gliderDude2 waittill animdone
	}
}end

//============================================================================	
handlePassenger1FreakedOut: {
//============================================================================
	// keep looping until the glider crashes
	while (level.gliderRideOver == 0)  {
		$gliderDude1 anim  A_21_passenger1_idleB
		$gliderDude1 waittill animdone
	}
}end

//============================================================================
KillPassengersOnDeath: {
//============================================================================
	self waittill death
	local.ent = self QueryDriverSlotEntity 0
	
	if (local.ent){
		local.ent remove
	}
    
	for ( local.i = 0; local.i <= 6; local.i++ ) {
		local.ent = self QueryPassengerSlotEntity local.i

		if ( local.ent != NULL) {
            self DetachPassengerSlot local.i local.ent.origin
			local.ent exec global/bullethit.scr (0 0 20) 5000 0 1
		}
	}

	self thread global/vehicles_thinkers.scr::truck_killed 
}end

//============================================================================
WaitToStartTruck: {
//============================================================================
	level.starttruckonce = 0

	switch (level.skill) {
	case 0:
		wait 50.0
		break;
	case 1:
		wait 40.0
		break;
	case 2:
		wait 20.0
		break;
	}
	thread startTruck
}end

//============================================================================
MyTruckThink local.hp local.passengers local.passengertype: {
//============================================================================
	if (local.hp == NIL) {
		self.health = 4000
	}
	else {
		self.health = local.hp
	}

	// println "truck health: " self.health
	thread global/vehicles_thinkers.scr::truck_INIT

	if ( (local.passengers != NIL) && (local.passengers != 0) ) {
		self waitthread maps/e3l3/scene1.scr::MyTruckLoad local.passengers local.passengertype "carcano"
	}
    
    //$starttruck waitthread global/vehicle_thinkers.scr::truck_load local.passengers local.guy_type local.special local.passenger_name local.driver_name:

	self.driver.usegun = "beretta"
	self waittill death
	self stop
	self.collisionent disconnect_paths
}end

//============================================================================
startTruck: {
//============================================================================
	if (level.starttruckonce == 0) {
		level.starttruckonce = 1
		level.starttruckguy = 0

		exec global/spotlight.scr::corona $starttruck "light left" // Turn on headlight coronas
		exec global/spotlight.scr::corona $starttruck "light right"

		$starttruck.unloaddelay = 1.0				// wait after truck stops
		$starttruck.unloaddriverdelay = 1.0			// wait after passengers unload
		$starttruck thread KillPassengersOnDeath
		$starttruck thread global/vehicles_thinkers.scr::enemy_truck_think level.truck1_health 1 NIL NIL NIL "models/human/sc_ax_ital_inf" NIL "starttruckguy" "starttruckdriver"
		$starttruck waitthread global/vehicles_thinkers.scr::LoadPassenger 5 "models/human/sc_ax_ital_inf" NIL starttruckguy
		$starttruck waitthread global/vehicles_thinkers.scr::LoadPassenger 6 "models/human/sc_ax_ital_inf" NIL starttruckguy
		$starttruck waitthread global/vehicles_thinkers.scr::LoadPassenger 3 "models/human/sc_ax_ital_inf" NIL starttruckguy
		waitframe

		$starttruckdriver.usegun = "beretta"
		$starttruckdriver nodamage
		$starttruckguy waitthread truckWeapon
		$starttruckdriver.targetname = "starttruckguy"
		//$starttruck waitthread global/vehicles_thinkers.scr::truck_drive $starttruckpath
		$starttruck waitthread global/vehicles_thinkers.scr::truck_drive_fullspec $starttruckpath 400 400 256 256 $starttruck.unloaddelay
		$starttruckguy thread TruckGuyGoToCrashSite

		/*
		$starttruck drive $starttruckpath 400 400 256 256  //path speed accel ??  
		$starttruck thread MyTruckThink level.truck1_health 4 "models/human/Sc_AX_Ital_Inf.tik" 
		$starttruck waittill drive //detect when truck stops
		$starttruck fullstop

		waitframe //waits one frame
        if ($starttruck && isalive $starttruck) {
		    $starttruck waitthread global/vehicles_thinkers.scr::truck_unload
			$deleteguy waitthread Rename "starttruckguy"
			level.starttruckguy = 0
			$starttruckguy thread TruckGuyGoToCrashSite
		}
		*/
	}
}end

//============================================================================
truckWeapon: {
//============================================================================
	self gun "carcano"
	self weaponcommand mainhand sp weaponsubtype 17 //[202] Smithy - weaponsubtype 17 stops weapon being able to be picked up, so made it only do this in sp (added sp prefix)
	self.truckexitdelay = 0.25 + randomfloat(0.5)
}end

//============================================================================
Rename local.newname: {
//============================================================================
	self.targetname = local.newname
}end

// run to the crash site if we don't have an enemy...
//============================================================================
TruckGuyGoToCrashSite: {
//============================================================================
	while ( self && self.done_unloading==0 ) {
		wait 0.2
	}

	if ( self && self.enemy==NULL ) {
		level.starttruckguy++
		self.mood = curious

		switch ( level.starttruckguy ) {
		case	1:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_1
			break;
		case	2:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_2
			break;
		case	3:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_3
			break;
		case	4:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_4
			break;
		case	5:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_5
			break;
		default:
			self waitthread global/SafeMoveTo.scr::reach $troop_desitnation_5
			break;
		}
	}

	if ( isAlive self ) {
		//[202] chrissstrahl
		//self turnto $player
		self thread coop_mod/replace.scr::turnto
	}
}end

//============================================================================
handleCrash: {
//============================================================================
	$dead_dude1 anim dead_pose1
	$dead_dude2 anim dead_pose2
	$dead_dude1 notsolid
	$dead_dude2 notsolid

	//[user 2026-08-03] bug-1317 - the crash-site dead. They are script_models using the SAME two
	//models as the glider passengers (Sc_AL_US_CORP / Sc_AL_US_ltPALIA), which the bug-1305
	//coop overrides already gave gore tiers, so they take the same treatment: tier 2 heavy -
	//soaked, bullet holes - plus the coop_blooddrip emitter so each corpse pools where it lies.
	//Retail left them spotless, which read as men asleep rather than men killed in a crash.
	$dead_dude1 thread coop_bloodyGliderDude 2
	$dead_dude2 thread coop_bloodyGliderDude 2

	waitthread game.waittill gliderRideOver //[202] Smithy - save cpu cycles
	/*
	while (level.gliderRideOver == 0) {
		waitframe
	}
	*/

	//	thread UnrestrictView
	musicvolume 1.0 3.0

	// this is where we hit the tree
	if ($gliderCamera){
		$gliderCamera[1] playsound e2l1_crash2
	}
	
	thread doEarthquake 1.1 20 1 0

	//waitthread global/objectives.scr::add_objectives 2 2 "Locate your squad" local.waypoint1a
	wait 1

	//[202] chrissstrahl
	//$player playsound e2l1_crash1
	thread coop_mod/replace.scr::playsound e2l1_crash1
	
	thread game.event gliderCrashOver //[202] Smithy - save cpu cycles
	level.gliderCrashOver = 1
	thread HandleSearchParty
	thread coop_searchPartyShotWatch	//[user 2026-08-04] bug-1344 - first shot at them ends the show

	if (self){
		// find out what 75% of health is
		local.newHealth = 0.90*self.max_health

		// set current health to that
		self healthonly local.newHealth
	}


	// tell the player to eject from the glider
	wait 3
	
	//[202] chrissstrahl
	if(level.gametype == 0){
		local.usekey = getboundkey1 "+use"
		local.msg = (loc_convert_string "Press ") + local.usekey + (loc_convert_string " to eject from the glider.")
		thread global/throbtext.scr::throbtext local.msg 0
		
		exec global/autosave.scr 1

		while (!$player.useheld && $player.health > 0) {
			waitframe
		}
	}

	waitthread global/items.scr::add_item "explosives" noprint
	drawhud 1
	waitthread maps/e2l1/objectives.scr::transition "start"
	
	//[202] chrissstrahl
	if(level.gametype == 0){		
		thread global/throbtext.scr::throbtext "" 0
	}else{
		level.coop_weaponUse = "rifle" //[202] Smithy - for future spawns
	}
	
	//[202] chrissstrahl
	thread coop_mod/replace.scr::physics_on 
	
	//[202] Smithy - handle their eject stuff individually
	//[user 2026-08-03] bug-1309 CHUTE SPAWNS - only the FIRST active player takes the glider
	//eject beat; everyone else arrives by parachute at the user-scouted drop points above the
	//crash site, frozen until they cut the chute (same freeze->USE beat as the glider). Later
	//spawns (late join or respawn) come down the same way via coop_chuteSpawnManager.
	local.gliderTaken = 0
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.player = $player[local.i]
		if (waitthread game.playerActive local.player && !local.player.ejectHandled){
			if (local.gliderTaken == 0){
				local.gliderTaken = 1
				//[user 2026-08-03] bug-1328b - place him at the vanilla wreck spot IN THE CRASH
				//FRAME, before any camera release ordering can show his ground-level body for a
				//beat ('I spawn close to the ground, then respawn higher'). The eject handler
				//sets the same origin again - idempotent.
				local.player.origin = ( 4494 6086 592 )
				local.player.viewangles = ( 0 270 0 )
				local.player thread coop_handlePlayerGliderEject
			}else{
				local.player thread coop_chuteDrop
			}
		}
	}
	if (level.gametype != 0){
		thread coop_chuteSpawnManager
	}

	//[user 2026-08-03] bug-1307 - the flak run is over and the players are on the ground:
	//release the scripted suppression floor so the normal decay takes it to zero.
	thread coop_mod/main.scr::coop_setSuppressionAll 0

	//time to roll up the truck
	//[user 2026-08-03] bug-1308 (C3) PRE-ARM. WaitToStartTruck sleeps 20-50s (skill-dependent)
	//before startTruck runs enemy_truck_think, and only that runs truck_INIT. Until then
	//$starttruck still has the Vehicle default removeondeath qtrue - so a player who lands,
	//mounts $aagun2 (~950u away) and kills it sees it VANISH silently: no explosion, no sound,
	//no truck_killed. (It IS damageable in that window - the ctor sets DAMAGE_YES - so only the
	//death handling is missing, and that is all the pre-arm touches.)
	thread coop_preArmStartTruck
	thread WaitToStartTruck

    /* //[202] Smithy - done in coop_handlePlayerGliderEject now
	$searchparty thread EnableAI

	//wait 1
	level.abortSearchParty = 1
	*/
}end

//============================================================================
HandleSearchParty: {
//============================================================================
	//[user 2026-08-04] bug-1350 - REWRITTEN. Three compounding defects made this scene
	//unwatchable ('they never walked up... then noticed me from a distance'):
	//  1. e2l1.scr disable_ai's the search party, so retail's runto could never move them -
	//     they only ever moved once the ABORT enabled their AI, i.e. as hostiles.
	//  2. coop replace.scr::say_wait reports length NIL for these aliases, so every
	//     'waittill saydone' returned instantly and all four lines + GetPlayer collapsed into
	//     one frame.
	//  3. the 30s landing cap (bug-1348) expired while the player was still hanging.
	//Now: wait for the player to land (no cap - the scene is pointless unwatched), enable AI so
	//they can actually path to the wreck, but BLIND them (sight/hearing 1) so they walk in
	//without noticing, play the four lines on fixed timings, then restore their senses and
	//hand off to GetPlayer. Shooting one still ends it early via coop_searchPartyShotWatch.
	level.abortSearchParty = 0

	//[user 2026-08-04] bug-1354 - START AT THE CRASH, not on landing. The landing gate was
	//added (bug-1348) because the scene used to finish before the player had control - but
	//that was really the NIL-length dialogue collapsing all four lines into one frame
	//(bug-1350). With fixed timings the scene runs ~21s, so starting it at the crash lets the
	//player watch the Italians walk in and talk from the wreck, exactly as the user wants,
	//and they are still blind until it ends whether the player drops mid-scene or not.
	wait 1
	if (level.abortSearchParty == 1) { end }

	$searchparty waitthread EnableAI
	for (local.i = 1; local.i <= 2; local.i++) {
		if ($searchparty[local.i]) {
			$searchparty[local.i] sight 1
			$searchparty[local.i] hearing 1
		}
	}
	$searchparty[1] runto $searchpartyrunto1
	$searchparty[2] runto $searchpartyrunto2

	wait 6	//let them cover the ~1100u from their posts to the wreck before talking

	if (level.abortSearchParty == 0) {
		$searchparty[1] playsound den_E2L1_ITALIAN1
		wait 3.5
	}
	if (level.abortSearchParty == 0) {
		$searchparty[1] playsound den_E2L1_ITALIAN2
		wait 4
	}
	if (level.abortSearchParty == 0) {
		$searchparty[2] playsound den_E2L1_ITALIAN3
		wait 3.5
	}
	if (level.abortSearchParty == 0) {
		$searchparty[1] playsound den_E2L1_ITALIAN4
		wait 4
	}

	//senses back before the hunt, or they would chase blind
	for (local.i = 1; local.i <= 2; local.i++) {
		if ($searchparty[local.i]) {
			$searchparty[local.i] sight 2000
			$searchparty[local.i] hearing 2000
		}
	}
	if (level.abortSearchParty == 0) {
		$searchparty thread GetPlayer
	}
}end

//============================================================================
GetPlayer: {
//============================================================================

	// wake up the patrollers
	self waitthread EnableAI
	//[202] chrissstrahl
	self thread coop_mod/replace.scr::turntolookat
}end

//============================================================================
EnableAI: {
//============================================================================
	self exec global/enable_ai.scr
}end

//============================================================================
fadeIn: {
//============================================================================
	exec global/fadein.scr
	waitframe
	waitthread global/fadein.scr::DoFadeIn e2l1_1 e2l1_2 e2l1_3 NIL 0
}end

//============================================================================
handleDialogue: {
//============================================================================
	// this is where the scene is choriographed up until the final descent starts
	// wait for the scene to open...
	if (level.allowSkipGliderDialogue != 0) {
		thread detectDialogueSkip
	}

	if (level.skipFadeIn == 0) {
		wait 7
	}
	else {
		wait 2
	}
		
	if (level.skipDialogue == 0) {
		// "Look at this soup! ..."
		if ($gliderCamera){
			$gliderCamera[1] playsound dfr_E2L1_C471_01 //dfr_E2L1_C471 
		}
		wait 7
	}

	if (level.skipDialogue == 0) {
		// "Thanks for the cheery observation..."
		//[user 2026-08-03] bug-1330 - retail animates the pilot TALKING here with no audio;
		//GP1301 is that recorded line, shipped and never referenced.
		if ($gliderCamera){
			$gliderCamera[1] playsound DFRUS_E2L1_GP1301
		}
		$gliderPilot upperanim AA_pilot_talk1
		$gliderPilot waittill upperanimdone		
	}

	// the right-o line doesn't exist in uberdialog, c472 is a line that occurs later...
	//if (level.skipDialogue == 0) {
	//	// "Right-O Sir..."
	//	$gliderCamera playsound dfr_E2L1_C472
	//	wait 4
	//}

	if (level.skipDialogue == 0) {
		// "Looks like we're coming up on it right now..."
		if ($gliderCamera){
			$gliderCamera[1] playsound dfr_E2L1_C473   
		}

		wait 4
	}

	if (level.skipDialogue == 0) {
		// "Ready for detachment..."
		if ($gliderCamera){
			$gliderCamera[1] playsound dfr_E2L1_C474
		}
		wait 2.4
	}

	if (level.skipDialogue == 0) {
		// "Roger that, detachment ready..."
		//[user 2026-08-03] bug-1330 - same: GP1302 is this line's recording
		if ($gliderCamera){
			$gliderCamera[1] playsound DFRUS_E2L1_GP1302
		}
		$gliderPilot upperanim AA_pilot_talk2
		$gliderPilot waittill upperanimdone		
		wait 2.5
	}

	if (level.skipDialogue == 0) {
		// "detaching now..."
		if ($gliderCamera){
			$gliderCamera[1] playsound dfr_E2L1_C475
		}
		wait 1.6
	}

	// detach the glider from the C47
	thread game.event gliderDetached //[202] Smithy - save cpu cycles
	level.gliderDetached = 1
	thread doEarthquake 0.3 1 1 0

	// gentle earthquake at start of flying
	if (level.skipDialogue == 0) {
		thread doEarthquake 28 0.2 1 1
	}
	else {
		thread doEarthquake 14 0.2 1 1
	}

	wait 3
	if (level.skipDialogue == 0) {
		// "We are clear, Two-Four"
		$gliderPilot upperanim AA_pilot_talk3
		$gliderPilot waittill upperanimdone		
		wait 1.5
	}

	if (level.skipDialogue == 0) {
		// "Roger that, Two-Five..."
		if ($gliderCamera){
			$gliderCamera[1] playsound dfr_E2L1_C472
		}
		wait 5
	}

	if (level.skipDialogue == 0) {
		//[user 2026-08-02] bug-1297 - AA_pilot_talk4 DOES NOT EXIST. Retail ships only
		//AA_pilot_talk1/2/3 (models/human/animation/scripted/e2L1/) and level_e2l1.tik registers
		//exactly those three - there is no fourth. So this line threw
		//  Script Error : unknown animation 'AA_pilot_talk4' in 'models/human/sc_al_us_pilot.tik'
		//and ABORTED THIS THREAD, which is why everything below never ran: the descent events, the
		//dialogueFinished flag, cueplayer, the $gliderCamera cleanup, and - the visible one - the
		//setFog call at the end of this function that switches the map to its GROUND fog
		//(1500 units). Without it the map stays on the TOW fog (3000), i.e. twice as thin, which
		//reads in play as "no fog on the ground" and lets distant geometry pop in unmasked.
		//
		//[user 2026-08-03] bug-1302 - the first repair reused AA_pilot_talk3 here, but every
		//AA_pilot_talk* anim carries its OWN VO as an embedded TIKI frame command
		//(level_e2l1.tik:121-127, "1 sound DFRUS_E2L1_GP1303"), so replaying the anim replayed the
		//line: the pilot said "We are clear, Two-Four" twice in a row.
		//
		//CUT LINE RESTORED. The beat's real line is DFRUS_E2L1_GP1306, "There were reports of
		//heavy AA fire in this area, but hopefully our boys took care of that for us." - which is
		//why it sits immediately before the glider starts taking AA fire. All three pieces ship:
		//  anim   A_21_Glider_1A            level_e2l1.tik:257 (plays "0 sound DFRUS_E2L1_GP1306")
		//  audio  DFRUS_E2L1_GP1306xd04.mp3 maintt/sound/dialogue/Mission_2/Allies/ - a LOOSE file,
		//         not in any pk3, which is why a pk3-only search first reported it missing
		//  reach  sc_al_us_pilot.tik -> new_generic_human.tik -> level_e2l1.tik, the same include
		//         chain that resolves AA_pilot_talk1/2/3
		//Only the alias was commented out in ubersound/uberdialog.scr; the coop copy re-enables it.
		$gliderPilot upperanim A_21_Glider_1A
		$gliderPilot waittill upperanimdone
	}

	level.dialogueFinished = 1

	// now begin the descent
	thread game.event gliderDescentBegun 	//[202] Smithy - save cpu cycles
	thread game.event gliderTakingFire 		//[202] Smithy - save cpu cycles
	level.gliderDescentBegun = 1
	level.gliderTakingFire = 1
	wait 2

	//level.gliderTakingFire = 1

	// wait until the pilot gets shot
	waitthread cockpitBulletHit 0.2  0.1 mp44_snd_fire1  0.2	5
	$glider anim shot
	waitthread cockpitBulletHit 0.5  0.1 snd_bh_wood1  0.1 2 
	waitthread cockpitBulletHit 0.3  0.1 snd_bh_wood2  0.1 2 
	thread game.event gliderPilotShot //[202] Smithy - save cpu cycles
	level.gliderPilotShot = 1

	waitthread cockpitBulletHit 0.2  0.1 snd_bh_wood3  0.1 2 
	waitthread cockpitBulletHit 0.2  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.25  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.15  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.2  0.3 panzerschreck_snd_fire  0.4	10
	waitthread cockpitBulletHit 0.6  0.1 snd_bh_flesh1 0.2 4 
	waitthread cockpitBulletHit 0.2  0.1 mp44_snd_fire1  0.2	5
	waitthread cockpitBulletHit 0.25 0.1 snd_bh_flesh1 0.1 2 
	//wait 1.7

	//even more shots
	waitthread cockpitBulletHit 0.5  0.1 snd_bh_wood1  0.1 2 
	waitthread cockpitBulletHit 0.2  0.1 mp44_snd_fire1  0.2	5
	waitthread cockpitBulletHit 0.15  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.2  0.1 mp44_snd_fire1  0.2	5
	waitthread cockpitBulletHit 0.2  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.2  0.1 snd_bh_metal01  0.1 2 
	waitthread cockpitBulletHit 0.3  0.1 snd_bh_wood2  0.1 2 
	waitthread cockpitBulletHit 0.2  0.1 mp44_snd_fire1  0.2	5
	waitthread cockpitBulletHit 0.2  0.3 panzerschreck_snd_fire  0.4	10
	waitthread cockpitBulletHit 0.25  0.1 snd_bh_metal01  0.1 2 
	
	thread maps/e2l1/fog.scr::setFog level.fogDistanceDescent level.fogBiasDescent level.fogColorDescent

	// hit some trees
	wait 1.2
	if ($gliderCamera){
		$gliderCamera[1] playsound e2l1_tree1
	}
	$glider anim bank_left
	thread doEarthquake 0.25 2 1 0
	
	wait 0.5
	if ($gliderCamera){
		$gliderCamera[1] playsound e2l1_tree2
	}
	$glider anim bank_right
	thread doEarthquake 0.5 4 1 0
}end

//============================================================================
detectDialogueSkip: {
//============================================================================
	//[202] Smithy - this was only used by devs for testing when level.allowSkipGliderDialogue is true in hacks.scr
	while (level.dialogueFinished == 0 && level.skipDialogue == 0) {
		//[202] chrissstrahl - I want this to work while we are testing
		for (local.i = 1;local.i <= $player.size;local.i++){
			local.player =  $player[local.i]
			if( local.player && local.player.dmteam != "spectator" && local.player.useheld ){
				level.skipDialogue = 1
			}
		}
		waitframe
	}
}end

//============================================================================
cockpitBulletHit local.wait local.lightFlashTime local.sound local.shakeTime local.shakeMag: {
//============================================================================
	if (local.wait > 0) {
		wait local.wait
	}

	if (local.lightFlashTime > 0) {
		thread gliderLightFlash local.lightFlashTime
	}

	$gliderPilot playsound local.sound
	thread doEarthquake local.shakeTime local.shakeMag 1 0
}end

//[202] Smithy - made this work with multiple players and handler their cameras
//============================================================================
handleCamera: {
//============================================================================
	/* //[202] Smithy - done in coop_spawnGliderCamera per player now
	spawn Camera targetname gliderCamera
	$gliderCamera showquakes 1
	$gliderCamera attach $glider seat 1 ( 0 0 40 )
	
		//[202] Smithy - not needed now we cue each camera separately
	if (level.stickPlayerAtGlider != 1) {
		cuecamera $gliderCamera
	}
	*/
	
	//[202] Smithy - done on an individual basis now
	//level.oldPlayerAngles = $player.viewangles

	// don't start synching the angles until after the fade in has happened
	
	//[202] Smithy - handled on an individual basis now
	//local.deltaAngles = $player.viewangles - level.oldPlayerAngles
	//$gliderCamera.angles = $glider.angles + local.deltaAngles
	
	if (level.allowSkipGliderDialogue == 0) {
		wait 8
	}
	
	thread coop_startGliderSpawnManager //[202] Smithy - start the spawn manager

	while (level.gliderRideOver == 0) {
	
		//[202] Smithy - loop over all cameras
		for (local.i = 1; local.i <= $gliderCamera.size; local.i++){
			local.cam = $gliderCamera[local.i]
			group.player = local.cam.player

			
			if (isAlive group.player && !group.player.isSpectator){
				if (!group.player.inGliderCamera){
					thread coop_startGliderCamera					
				}			
			}else{
				if (group.player && group.player.inGliderCamera){
					thread coop_stopGliderCamera
				}
				local.cam waitthread game.replace::delete   //[202] Smithy - delete isn't faster than remove. they all call the same function internally lol... so lets wait until thinks have finished
				local.i = 0 								//[202] Smithy - gliderCamera.size will change, so, to stop someone being delayed by an extra frame, start again
				continue
			}
			
			//[202] Smithy - handle his camera view
			local.deltaAngles = group.player.viewangles - group.player.oldViewAngles
			local.cam.angles = $glider.angles + local.deltaAngles				
		}
				
		//local.deltaAngles = $player.viewangles - level.oldPlayerAngles
		//$gliderCamera.angles = $glider.angles + local.deltaAngles
		waitframe
	}

	if (!level.gliderCrashOver){
		waitthread game.waittill gliderCrashOver //[202] Smithy - save cpu cycles
	}
	
	/*
	while (level.gliderCrashOver == 0) {
		waitframe
	}
	*/
	
	//thread coop_stopGliderSpawnManager 	//[202] Smithy - stop handling glider spawns now
	cueplayer 								//[202] Smithy - will loop over all clients and turn off the cams for us		 
	
	thread maps/e2l1/fog.scr::setFog level.fogDistanceGround level.fogBiasGround level.fogColorGround
	delete $gliderCamera
}end

//[202] Smithy - checks for player spawns during the glider scene
//============================================================================
coop_startGliderSpawnManager:{
//============================================================================	
	if (level.gliderRideOver){ end }
	
	level.thread["coop_manageSpawnsDuringGlider"] = local
	
	if ($gliderCamera){
		$gliderCamera delete //[202] Smithy - start the number of cams at 0
	}
	
	//[202] Smithy - spawn any cameras we need for players that may have spawned before the handler started
	for (local.i = 1; local.i <= $player.size; local.i++){
		group.player = $player[local.i]
		if (!group.player.gliderCamera){
			println("ADDING PLAYER TO CAM (handleCamera)")
			thread coop_spawnGliderCamera
			
			if (!group.player.handleDeathThread){ //[202] Smithy - handle deaths
				group.player thread coop_handleDeath
			}
		}
	}
	while (1){
		level waittill playerspawn
		/*commanddelay 0.2*/ println("ADDING PLAYER TO CAM (playerspawn)")
		group.player = parm.other
		
		if (!group.player.handleDeathThread){ //[202] Smithy - handle deaths
			group.player thread coop_handleDeath
		}
		
		if (!group.player.isSpectator){ 	
			if (!level.gliderRideOver){					
				thread coop_spawnGliderCamera
			}else{	
				if (!group.player.coop_dead){ //[202] Smithy - as players can respawn at location of death, check for this
					group.player thread coop_handlePlayerGliderEject
				}							
			}
		}
		group.player.coop_dead = game.false
	}	
}end

//[202] Smithy - handle ejecting from the glider on fresh spawn
//============================================================================
coop_handlePlayerGliderEject:{
//============================================================================
	local.player = self
	local.player.ejectHandled = game.true
	local.player thread coop_crashDizzy	//[user 2026-08-03] bug-1322
	//[user 2026-08-03] bug-1328 - GLIDER PLAYER ONLY: stand at the vanilla post-crash spot.
	//Retail never moves the player at all: the body waits out the whole ride at the map's
	//single info_player_start (4494 6086 592) yaw 270 - seat height, ~192u above the static
	//wreck at (4462 5960 400) - and physics_on after USE settles them into the wreck. Coop
	//spawns sat at ground level, which read as 'way too close to the ground'. Same
	//origin/viewangles/physics_off recipe as coop_chuteDrop. Chute players keep their own
	//user-scouted drop points.
	local.player.origin = ( 4494 6086 592 )
	local.player.viewangles = ( 0 270 0 )
	local.player physics_off	
	local.player commanddelay 0.05 iprint("Hold USE to eject from the glider") game.true
	local.player.gliderEjectThread = local
	while (waitthread game.playerActive local.player && !local.player.useheld) {
		wait .1
	}
	if (local.player){
		//[user 2026-08-04] bug-1347 - the eject settles the player ~192u from the vanilla seat
		//height onto the wreck; in coop that fall damage was enough to put them straight into
		//DBNO. Same nodamage window coop_chuteDrop already uses for its drop.
		local.player nodamage
		local.player physics_on		
		local.player thread coop_ejectDamageRestore
		level.coop_gliderPlayerLanded = 1
		local.player.ejectHandled = game.false
		level.coop_noSpawnStuck = 0		//[user 2026-08-03] bug-1312 - player has control again
		//[user 2026-08-04] bug-1344 - ejecting NO LONGER aborts the search-party scene. Retail
		//killed the Italians' walk-in + 4-line exchange the moment the player pressed USE, so
		//in practice nobody ever saw it ('isn't there a script where the italians walk around
		//and have some kind of dialogue and dont notice you immediately?' - there is, and now
		//it plays). Hostility comes from the scene's own GetPlayer after line 4, or instantly
		//if any player SHOOTS a search-party member (coop_searchPartyShotWatch).
	}
}end

//[202] Smithy - check for death events so we know when to handle glider eject.
//we don't want players who respawn at death location to eject from the sky, do we? :D
//============================================================================
coop_handleDeath:{
//============================================================================
	local.player = self
	local.player.handleDeathThread = local
	local.player waitthread game.waittill2 playerdeath
	
	//[202] Smithy - sure, player can go to spec after dying, which means spawns reset
	//but not a big deal. if that happens then they will just drop from the glider like a normal spawn.
	//no biggie.
	//[202] chrissstrahl - prevent NULL console spam
	//BAD SMITHY!!! - we agreed to use flags for good reason! Shame on you!
	//Naa, don't you give me the rooling eyes, you know I am right!
	if(local.player){
		local.player.coop_dead = game.true 					
	}
}end

//[202] Smithy - stop the glider scene spawn handler
//============================================================================
coop_stopGliderSpawnManager:{
//============================================================================
	local.thread = level.thread["coop_manageSpawnsDuringGlider"]
	if (local.thread){ local.thread delete }		
}end


//[202] Smithy - spawn a camera for a player and set it up in glider
//============================================================================
coop_spawnGliderCamera:{
//============================================================================	
	if !(level.gliderRideOver && group.player.gliderCamera){
		local.cam = spawn Camera targetname gliderCamera 	//[202] Smithy - give them all the same name so they are handled in the targetname array
		local.cam showquakes 1
		local.cam attach $glider seat 1 ( 0 0 40 )
		local.cam.player = group.player
		group.player.gliderCamera = local.cam
		group.player.oldViewAngles = group.player.viewangles		
	}
}end

//[202] Smithy - make them look through their glider camera
//============================================================================
coop_startGliderCamera:{
//============================================================================	
	if (!level.gliderRideOver && group.player.gliderCamera && !group.player.inGliderCamera){
		group.player.inGliderCamera = game.true
		
		//[202] Smithy - fix players only watching one camera.
		//bug happened because i was passing in camera entity to 'target', which would translate to the targetname string 'gliderCamera'
		//and as all cameras have the same targetname, it was just selecting the first in the targetname array (thus, first player's camera)
		//now i temporarily rename camera to that of the targetname + player entnum then set that as the target. 
		//this should fix it.		
		local.name = ("gliderCamera_" + group.player.entnum)
		local.cam = group.player.gliderCamera
		local.cam targetname local.name
		
		local.camerause = spawn trigger_camerause target local.name	
		local.camerause doUse group.player
		local.camerause delete
		
		//[202] Smithy - set targetname back to original so it gets added back to the array
		local.cam targetname "gliderCamera"
	}
}end

//[202] Smithy - stop them looking through their glider camera
//============================================================================
coop_stopGliderCamera:{
//============================================================================	
	if (!level.gliderRideOver && group.player.gliderCamera && group.player.inGliderCamera){
		group.player.inGliderCamera = game.false
		
		//[202] Smithy
		local.name = ("gliderCamera_" + group.player.entnum)
		local.cam = group.player.gliderCamera
		local.cam targetname local.name
		
		local.camerause = spawn trigger_camerause target local.name
		local.camerause doUse group.player
		local.camerause delete
		
		//[202] Smithy
		local.cam targetname "gliderCamera"
	}
}end

//============================================================================
cameraLookatPilot: {
//============================================================================
	//[202] Smithy - don't think it's used
	println("DEV: gliderride.scr::cameraLookatPilot method called. FIX!")
	end
	
	local.y = -160 + $glider.angles[1] + $player.viewangles[1]
	local.x = -10 + $glider.angles[0] + $player.viewangles[0]
	level.oldPlayerAngles = ( local.x local.y 0 )
}end

//============================================================================
handleGlider: {
//============================================================================
	// snap the glider to the starting position, at the first spline path node
	$glider.origin = $gliderpath.origin
	thread gliderIdle
	$glider light 1 1 1 1000
	$glider lightOff

	// play the wind sound
	$glider loopsound e2l1_glider_snd_idle

	// stick a jeep inside the glider
	spawn models/vehicles/e2l1_jeep_glider targetname gliderJeep
	$gliderJeep attach $glider jeep_tag	1 ( -40 0 0 ) 

	// bob the glider around until we're detached from the C47
	waitthread gliderBob
	$glider playsound e2l1_c47_snd_teather

	// wait for the signal for the glider start the final descent
	waitthread game.waittill gliderDescentBegun //[202] Smithy - save cpu cycles
	/*
	while (level.gliderDescentBegun == 0) {
		waitframe
	}
	*/

	// don't want the flak anymore...
	thread maps/e2l1/pocketflash.scr::StopGliderFlak

	// start the glider on the descent path, and wait for it to finish
	$glider anim descent
	$glider.origin = $gliderpath.origin
	$glider flypath gliderpath 1200 200 500
	$glider waitmove	

	// give the signal for the camera to give control back to the player
	thread game.event gliderRideOver //[202] Smithy - might as well use our event system to save cpu cycles. the BT devs really needed to make one themselves...
	level.gliderRideOver = 1
	$glider stoploopsound
	$gliderJeep delete

	// get rid of the glider so it isn't spewing particles and hogging
	// cpu cycles
	wait 10
	$glider delete
}end

//============================================================================
gliderIdle: {
//============================================================================
	// the idle animation spews the fog particles
	while (level.gliderDescentBegun == 0) {
		$glider anim idle
		$glider waittill animdone
	}
}end

//============================================================================
gliderBob: {
//============================================================================
	local.vz = 0
	local.az = 50
	local.lastTime = level.time
	local.z = 0
	local.minZ = 20
	local.maxZ = 40

	while (level.gliderDetached == 0) {
		local.dTime = level.time - local.lastTime
		local.lastTime = level.time

		if ((local.az > 0 && local.z > local.maxZ) || (local.az < 0 && local.z < local.minZ)) {
			local.az = -local.az
		}

		local.vz += local.az*local.dTime
		if (local.vz > 30.0) {
			local.vz = 30.0
		}

		if (local.vz < -30.0) {
			local.vz = -30
		}

		local.dz = local.vz*local.dTime
		local.z += local.dz
		$glider.origin += ( 0 0 local.dz )
		waitframe
	}
}end

//============================================================================
gliderLightFlash local.duration: {
//============================================================================
	$glider lightOn
	wait local.duration
	$glider lightOff
}end

//============================================================================
handleC47: {
//============================================================================
	// move the C47 to it's first spline path node
	$c47.origin = $c47Path.origin
	
	// the c47 make engine noise
	$c47 loopsound e2l1_c47_snd_idle
	$c47 anim no_props
	
	// spawn the teather, and attach it to the C47
	spawn models/vehicles/CG4Aglider_tether targetname c47Teather
	$c47Teather attach $c47 Origin
	$c47Teather.angles = ( 0 90 0 )
	$c47Teather anim idle

	// wait for the detach signal
	waitthread game.waittill gliderDetached //[202] Smithy - save cpu cycles
	/*
	while (level.gliderDetached == 0) {
		waitframe
	}
	*/

	// play the teather detach animation
	$c47Teather anim detach

	// fly fly away
	$c47 flypath c47Path 600 300 256
	$c47 waitmove
}end

//============================================================================
handlePilot:{
//============================================================================
	// initialize the glider pilot, start him in the flying animation
	//spawn models/human/allied_oss_man_disguised targetname gliderPilot
	//spawn models/human/allied_usa_c47-paratrooper1 targetname gliderPilot
	//spawn models/human/allied_pilot targetname gliderPilot
	spawn models/human/sc_al_us_pilot targetname gliderPilot
	$gliderPilot physics_off
	$gliderPilot nodamage
	$gliderPilot notsolid
	$gliderPilot attach $glider seat 1 ( -8 53.5 -47 )
	$gliderPilot holster
	$gliderPilot thread handlePilotIdle

	// wait for the pilot to get shot
	waitthread game.waittill gliderPilotShot //[202] Smithy - save cpu cycles
	/*
	while (level.gliderPilotShot == 0) {
		waitframe
	}
	*/

	// animate the his death
	$gliderPilot anim AA_pilot1_death2
	$gliderPilot playsound dfr_E2L1_PILOT_DEATH

	//[user 2026-08-03] bug-1314 - he is being shot to pieces through the windscreen, so he goes
	//straight to gore tier 2 (heavy): soaked tunic and pants, bullet holes, and an entry wound on
	//the face. Retail left him spotless because his model shipped one shader per surface - the
	//coop override in models/human/SC_Al_US_pilot.tik adds the tiers.
	$gliderPilot thread coop_bloodyGliderPilot

	$gliderPilot waittill animdone
	$gliderPilot ai_off

	// wait for the scene to end and delete the pilot
	waitthread game.waittill gliderRideOver //[202] Smithy - save cpu cycles
	/*
   	while (level.gliderRideOver == 0) {
		waitframe
   	}
   	*/

	delete $gliderPilot
}end

//============================================================================
handlePilotIdle: {
//============================================================================
	// keep looping the flying animation until the pilot gets shot
	while (level.gliderPilotShot == 0) {
		self anim AA_pilot1
		self waittill animdone
	}
}end
	
//============================================================================
doEarthquake local.duration local.magnitude local.no_rampup local.no_rampdown: {
//============================================================================
	earthquake local.duration local.magnitude local.no_rampup local.no_rampdown
}end

//	Make sure player can't do 360s...
//============================================================================
RestrictView: {
//============================================================================
	//[202] Smithy - this isn't used. see commented out thread call above.
	// don't let player mess with the mouse while we do this...
	level.restrict = spawn models/statweapons/camera_restrict.tik
	level.restrict.origin = $player.origin
	level.restrict notsolid
	level.restrict.angles = "90 0 0"
	level.restrict hide
	level.restrict turnspeed 1000
	level.restrict startyaw -90	// turn us a bit...
	level.restrict maxyawoffset 180
	level.restrict pitchcaps "-80 50 0"
	level.restrict viewjitter .5
	level.restrict name ""
	level.restrict pickupsound ""
	level.restrict setPlayerUsable 1
	level.restrict maxuseangle 180	// make sure the doUse command works!
	level.restrict doUse $player
	level.restrict setPlayerUsable 0
	//level.restrict glue $playerspot_plane
}end

//	allow player to look normally when they detach from the
//	parachute...
//============================================================================
UnrestrictView: {
//============================================================================
	//[202] chrissstrahl - let us know this needs fixing
	iprintlnbold_noloc("e2l1/gliderride.scr::UnrestrictView - needs fixing")
	println("----------- e2l1/gliderride.scr::UnrestrictView - needs fixing -------------")
	
	level.restrict setPlayerUsable 1
	level.restrict doUse $player
	level.restrict setPlayerUsable 0
	level.restrict delete
	level.restrict = NULL
}end

//============================================================================
coop_gliderFlakVolley: {
//============================================================================
	//[coop] position-driven replacement for pocketflash.scr::DoGliderFlak. Each burst
	//fires when the glider closes to within local.lead units of that flak origin along
	//the descent axis (+Y), so the volley is correct at any descent speed and survives
	//the dialogue being skipped. exp_flak_near_moving.tik launches its particles down
	//-Y toward the oncoming glider, so a lead of a few hundred to ~1200 units puts the
	//flash ahead of the cockpit and sweeps the smoke past it a fraction of a second later.

	while (level.gliderDescentBegun == 0 && level.gliderRideOver == 0) {
		waitframe
	}

	if (level.gliderRideOver) { end }
	if (!$glider) { end }
	if (!$gliderpath) { end }

	//handleGlider snaps the glider onto the start of the descent spline before it flies.
	//With the glider parked at the tow position this gate is already satisfied and falls
	//through in zero frames; it only does work if the snap has not happened yet. Kept as
	//insurance against a future reorder, not because it is load-bearing today.
	local.armY = $gliderpath.origin[1] + 100
	while (level.gliderRideOver == 0 && $glider && $glider.origin[1] > local.armY) {
		waitframe
	}

	if (level.gliderRideOver) { end }
	if (!$glider) { end }

	//origins in the order the glider meets them (sorted by Y). Leads spread the volley
	//over roughly 1.5s - 4.0s of the descent, the last two bursting close in as the
	//glider flies through the cluster.
	//[user 2026-08-03] bug-1307 - the suppression/blur floor is set by the FIRST BURST inside
	//coop_flakWhenGliderNears, not here: this label runs at descent start, ~1.5-4s before any
	//flak is visibly firing, and the user called the early blur out ("hits a bit too early").
	//Released in handleCrash at the eject beat.
	level.coop_gliderSuppOn = 0

	$flak_origin_1 thread coop_flakWhenGliderNears 1200
	$flak_origin_3 thread coop_flakWhenGliderNears 1050
	$flak_origin_6 thread coop_flakWhenGliderNears 1100
	$flak_origin_5 thread coop_flakWhenGliderNears 900
	$flak_origin_7 thread coop_flakWhenGliderNears 750
	$flak_origin_2 thread coop_flakWhenGliderNears 600
	$flak_origin_4 thread coop_flakWhenGliderNears 300
}end

//============================================================================
coop_flakWhenGliderNears local.lead: {
//============================================================================
	//[coop] fire one retail DoSingleFlak burst at this script_origin the moment the
	//glider closes to within local.lead units of it along the descent axis (+Y).
	if (!self) { end }

	while (level.gliderRideOver == 0) {
		if (!$glider) { end }

		if (($glider.origin[1] + local.lead) >= self.origin[1]) {
			break
		}

		waitframe
	}

	if (level.gliderRideOver) { end }

	//[user 2026-08-03] bug-1307 tune - the FIRST burst sets the held floor ("hits a bit too
	//early" when it armed at descent start). Later bursts skip straight to the bump.
	if (level.coop_gliderSuppOn != 1) {
		level.coop_gliderSuppOn = 1
		thread coop_mod/main.scr::coop_setSuppressionAll 0.55
	}

	self thread maps/e2l1/pocketflash.scr::DoSingleFlak

	//[user 2026-08-03] bug-1307 - each burst also spikes the one-shot suppression bump on top
	//of the held floor, so individual flak bursts read as flinches rather than a flat tint.
	for (local.i = 1; local.i <= $player.size; local.i++) {
		thread coop_mod/main.scr::coop_bumpSuppression $player[local.i] 0.5
	}
}end

//============================================================================
coop_bloodyGliderDude local.tier: {
//============================================================================
	//[user 2026-08-03] bug-1305 - bloody a glider passenger's uniform as he is shot up.
	//
	//The engine's gore tier 1 (Sentient::CoopGoreUpdateSkinTier) drives this automatically for
	//real AI, by accumulating damage and writing MDL_SURFACE_SKINOFFSET_BIT0/BIT1 into
	//edict->s.surfaces[]. These two passengers are cinematic script_models: they never take
	//damage, so nothing ever set their tier. Driving the same skin bits by hand is exactly what
	//the retail glider does for its cracked windscreen (CG4Aglider.tik surface +skin1/+skin2).
	//
	//Requires the blood skins to EXIST on the model - retail Sc_Al_US_Corp.tik / Sc_Al_US_LtPalia.tik
	//declare one shader per surface, so the coop overrides in models/human/ add the _blood1/2/3
	//tiers copied verbatim from models/human/Sc_Al_US_Inf.tik, which already shipped them for the
	//same two surfaces. Shaders live in scripts/coop_gore.shader.
	//
	//skin offset: 0 clean, 1 = +skin1 (light), 2 = +skin2 (heavy). Written the same way the
	//engine writes it - never both bits, since offset 3 is the gib skin.
	if (!self) { end }

	self surface Sc_Al_US_Inf_Tunic "+skin1"
	self surface Sc_Al_US_Inf_Pants "+skin1"
	self surface hand "+skin1"

	if (local.tier < 2) { end }

	//killed outright - let the light tier read for a beat, then go heavy
	wait 0.6
	if (!self) { end }

	self surface Sc_Al_US_Inf_Tunic "-skin1" "+skin2"
	self surface Sc_Al_US_Inf_Pants "-skin1" "+skin2"
	self surface hand "-skin1" "+skin2"

	//[user 2026-08-03] bug-1317 - tier 2 means killed, so bleed. Same oil-drum-leak reskin the
	//engine attaches to real corpses (Sentient::CoopGoreTryDripAttach, "Bip01 Spine1"); these are
	//scripted props the engine never reaches.
	self attachmodel "models/fx/coop_blooddrip.tik" "Bip01 Spine1"
}end

//============================================================================
coop_preArmStartTruck: {
//============================================================================
	//[user 2026-08-03] bug-1308 (C3) - minimal by design. The truck is ALREADY damageable in
	//the pre-arrival window (Vehicle ctor sets DAMAGE_YES, health 1000); what is missing is
	//death handling, so a kill vanished it silently. Deliberately NOT touched here:
	//  health          - startTruck's enemy_truck_think sets level.truck1_health at arrival;
	//                    raising it early would make the window kill HARDER, not easier
	//  collisionent    - $truckcollide is ONE script_object shared with $starttruck2's own
	//                    drive-in; binding or disconnect_path-ing it early breaks the other
	//                    truck's arrival (adversarial-review finding D-5)
	if (!$starttruck) { end }

	$starttruck removeondeath 0
	$starttruck thread coop_startTruckDeathBeforeArrival
}end

//============================================================================
coop_startTruckDeathBeforeArrival: {
//============================================================================
	//If the truck is destroyed before startTruck ever runs, run the retail death sequence once
	//and latch level.starttruckonce so startTruck (which guards on it) becomes a no-op instead
	//of attaching enemy_truck_think to a corpse. If startTruck ran first it set the latch
	//itself and enemy_truck_think owns the death - this thread just exits.
	self waittill death

	if (level.starttruckonce == 1) { end }
	level.starttruckonce = 1

	self stop
	//NO disconnect_paths: self.collisionent is unset pre-arrival, and the collide brush is
	//shared with $starttruck2 (see coop_preArmStartTruck).
	self thread global/vehicles_thinkers.scr::truck_killed
}end

//============================================================================
coop_chuteSpawnInit: {
//============================================================================
	//[user 2026-08-03] bug-1309 CHUTE SPAWNS - drop points scouted by the user with viewpos
	//(console 2026-08-03 19:58-19:59). Format was (x y z) : yaw; yaws normalised to 0-360.
	//All four hang well above the crash-site ground, so a frozen player reads as descending.
	level.coop_chutePoint[1] = ( 3113 5130 618 )
	level.coop_chuteYaw[1] = 32
	level.coop_chutePoint[2] = ( 2600 4597 851 )
	level.coop_chuteYaw[2] = 134
	level.coop_chutePoint[3] = ( 2806 4463 713 )
	level.coop_chuteYaw[3] = 352
	level.coop_chutePoint[4] = ( 3154 5949 695 )
	level.coop_chuteYaw[4] = 340
	level.coop_chuteCount = 4
	level.coop_chuteNext = 1
}end

//============================================================================
coop_chuteDrop: {
//============================================================================
	//[user 2026-08-03] bug-1309 - one player's parachute arrival. Same freeze -> USE beat as
	//coop_handlePlayerGliderEject, at altitude: teleport to the next drop point, hang a canopy
	//overhead (models/static/parachute_actors.tik - the same canopy this map's own para battle
	//hangs its AI from), and hold physics off until the player cuts away. nodamage covers the
	//fall so the authored drop heights can never be a death sentence; 15s failsafe auto-cut so
	//nobody is stranded in the sky if the prompt is missed.
	local.player = self
	if (!local.player) { end }
	local.player.ejectHandled = game.true
	local.player.coop_chuting = 1
	local.player thread coop_crashDizzy	//[user 2026-08-03] bug-1322

	local.idx = level.coop_chuteNext
	level.coop_chuteNext++
	if (level.coop_chuteNext > level.coop_chuteCount) { level.coop_chuteNext = 1 }

	local.player.origin = level.coop_chutePoint[local.idx]
	local.player.viewangles = ( 0 level.coop_chuteYaw[local.idx] 0 )
	local.player physics_off

	local.chute = spawn script_model model "models/static/parachute_actors.tik" targetname "coop_chute_canopy"
	local.chute notsolid
	local.chute.origin = local.player.origin + ( 0 0 8 )

	local.player commanddelay 0.05 iprint("Hold USE to cut your chute") game.true

	local.t = 0
	while (waitthread game.playerActive local.player && !local.player.useheld && local.t < 150) {
		wait .1
		local.t++
	}

	if (local.chute) { local.chute delete }

	if (local.player) {
		local.player nodamage
		local.player physics_on
		wait 3
		if (local.player) { local.player takedamage }
	}

	if (local.player) {
		local.player.coop_chuting = 0
		local.player.ejectHandled = game.false
		level.coop_noSpawnStuck = 0		//[user 2026-08-03] bug-1312 - player has control again
	}
}end

//============================================================================
coop_chuteSpawnManager: {
//============================================================================
	//[user 2026-08-03] bug-1309 - after the crash, EVERY arrival (late join or respawn) comes
	//down by chute at the scouted points, so nobody ever pops in standing at a map default.
	//Mirrors coop_startGliderSpawnManager's playerspawn loop, which stops mattering once the
	//ride is over.
	while (1) {
		level waittill playerspawn
		group.player = parm.other

		if (group.player && group.player.coop_chuting != 1) {
			group.player thread coop_chuteDrop
		}
	}
}end

//============================================================================
coop_bloodyGliderPilot: {
//============================================================================
	//[user 2026-08-03] bug-1314 - the pilot takes the burst that kills him through the
	//windscreen, so he ramps light -> heavy rather than popping straight to soaked. Same
	//[user 2026-08-04] bug-1332 - "head*" not "head": head1.skd contains TWO surfaces both
	//named "head" (LOD pair) and Surface_NameToNum returns only the FIRST - the rendered one
	//stayed clean ("his face is perfectly clean"). The trailing * is retail SurfaceCommand
	//prefix-match mode (entity.cpp:4237) and flips BOTH. Engine gore tiers loop all surfaces
	//by index, which is why AI faces were never affected.
	//hand-driven skin-offset mechanism as coop_bloodyGliderDude and the retail cracked
	//windscreen: 0 clean, +skin1 light, +skin2 heavy. Tokens MUST be quoted - a bare +skin1
	//is a whole-file parse killer (bug-1308).
	if (!self) { end }

	self surface Sc_Al_US_Pilot_Tunic "+skin1"
	self surface Sc_Al_US_Pilot_Pants "+skin1"
	self surface "head*" "+skin1"

	wait 0.5
	if (!self) { end }

	//heavy: soaked, bullet holes, and the entry wound on the face
	self surface Sc_Al_US_Pilot_Tunic "-skin1" "+skin2"
	self surface Sc_Al_US_Pilot_Pants "-skin1" "+skin2"
	self surface "head*" "-skin1" "+skin2"
	self surface hand "-skin1" "+skin2"

	//[user 2026-08-03] bug-1314 - BLEED. models/fx/coop_blooddrip.tik is the mod's own
	//oil-drum-leak reskin (persistent originemitter: falling streaks + droplets, each carrying
	//collision + bouncedecal so every drip leaves a coop_bloodsplat mark where it lands). The
	//engine normally attaches it itself - Sentient::CoopGoreTryDripAttach, to the "Bip01 Spine1"
	//tag - but only for damageable AI; this pilot is a scripted nodamage prop, so nothing ever
	//triggered it. Attach the same tik to the same tag by hand.
	self attachmodel "models/fx/coop_blooddrip.tik" "Bip01 Spine1"

	//[user 2026-08-03] bug-1316 - and paint the WINDSCREEN. The glass surface carries a fourth
	//skin in the coop CG4Aglider.tik override (base / cracks001 / cracks002 / coop_glass_blood),
	//so setting BOTH offset bits selects the bloodied pane. This is the same surface the retail
	//shot anim drives to +skin2, which is why it is already shattered underneath.
	if ($glider) {
		$glider surface glider_body_glass "+skin1" "+skin2"
		thread coop_glassBloodKeeper	//[user 2026-08-04] bug-1341 - the shot anim REPLAYS its crack progression on every flak burst and its 2.1s step forces cracks-only, wiping this
	}
}end

//============================================================================
coop_crashDizzy: {
//============================================================================
	//[user 2026-08-03] bug-1322 - ~10 seconds of hard concussion while you hang. Threaded from
	//BOTH hang paths (the glider eject and every parachute arrival), so late joiners and
	//respawns that come down by chute get it too, without a second timer to keep in sync.
	//0.9 is deliberately near the top of the range: a damaging hit spikes the client to
	//0.25 + lost * 2.5 (cg_view.c), so ~0.9 is what a solid wound already feels like, and the
	//suppression shader weights its tunnel/blur curve to the TOP of the range (sHi = s * s),
	//which is what reads as dizzy rather than as a flat grey wash.
	//The 0.3s lead-in matters: the crash frame also threads coop_setSuppressionAll 0 to release
	//the flak-run floor. Both are threads off the same frame, so without the wait that release
	//lands a moment AFTER this floor is set and silently clears it.
	local.player = self
	if (!local.player) { end }
	wait 0.3
	if (!local.player) { end }
	thread coop_mod/main.scr::coop_setSuppression local.player 0.9

	local.t = 0
	while (local.t < 10) {
		wait 0.5
		local.t = local.t + 0.5
		if (!local.player) { end }
	}

	//ramp out rather than snapping off, so it reads as the world steadying
	local.a = 0.9
	while (local.a > 0) {
		local.a = local.a - 0.15
		if (local.a < 0) { local.a = 0 }
		if (!local.player) { end }
		thread coop_mod/main.scr::coop_setSuppression local.player local.a
		wait 0.35
	}
}end

//============================================================================
coop_preplaceGliderPlayer: {
//============================================================================
	//[user 2026-08-04] bug-1328c - the crash-frame origin set still lost a visible race ('spawns
	//you close to the ground first, then up at the default point'). Vanilla never has this
	//problem because the body stands at info_player_start (4494 6086 592) physics-off for the
	//ENTIRE ride. Do the same: pin the first active player there from ride start until the
	//crash; the eject handler owns them afterwards. Re-pin each half second in case a respawn
	//or late activation moves the body mid-ride.
	local.pinned = NULL
	while (level.gliderCrashOver != 1) {
		if (local.pinned == NULL || local.pinned == NIL) {
			for (local.i = 1; local.i <= $player.size; local.i++) {
				if (local.pinned == NULL && waitthread game.playerActive $player[local.i]) {
					local.pinned = $player[local.i]
					//[user 2026-08-04] bug-1328d - viewangles + physics ONCE at first pin only.
					//Re-stuffing viewangles each tick snapped the camera straight ahead every half
					//second ('wont let me move my camera around'). Only the ORIGIN is re-pinned.
					local.pinned.viewangles = ( 0 270 0 )
					local.pinned physics_off
				}
			}
		}
		if (local.pinned != NULL && local.pinned != NIL) {
			local.pinned.origin = ( 4494 6086 592 )
		}
		wait 0.5
	}
}end

//============================================================================
coop_glassBloodKeeper: {
//============================================================================
	//[user 2026-08-04] bug-1341 - once the pilot's blood is on the windscreen it must survive
	//every later shot-anim replay (each flak burst re-runs the crack progression, whose 2.1s
	//step is '-skin1 +skin2'). Cheapest robust answer: re-assert the blood skin twice a second
	//for the remainder of the ride - any wipe lasts at most half a second.
	while (level.gliderCrashOver != 1) {
		if ($glider) {
			$glider surface glider_body_glass "+skin1" "+skin2"
		}
		wait 0.5
	}
	if ($glider) {
		$glider surface glider_body_glass "+skin1" "+skin2"
	}
}end

//============================================================================
coop_searchPartyShotWatch: {
//============================================================================
	//[user 2026-08-04] bug-1344 - the search party is disable_ai during their scene, which
	//would make them free kills that never react. First damage to EITHER member enables the
	//whole party and aborts the remaining dialogue - the retail abort, just moved from
	//'player pressed USE' to 'player opened fire'.
	for (local.i = 1; local.i <= 2; local.i++) {
		if ($searchparty[local.i]) {
			$searchparty[local.i] thread coop_searchPartyMemberHit
		}
	}
}end

//============================================================================
coop_searchPartyMemberHit: {
//============================================================================
	self waittill damage
	if (!level.coop_searchPartyAborted){
		level.coop_searchPartyAborted = game.true
		level.abortSearchParty = 1
		$searchparty thread EnableAI
		//[user 2026-08-04] bug-1350 - restore the senses the scene blinded, or a shot-at
		//search party would hunt with sight 1 and never find anyone.
		for (local.i = 1; local.i <= 2; local.i++) {
			if ($searchparty[local.i]) {
				$searchparty[local.i] sight 2000
				$searchparty[local.i] hearing 2000
			}
		}
	}
}end

//============================================================================
coop_ejectDamageRestore: {
//============================================================================
	//[user 2026-08-04] bug-1347 - re-arm damage once the player is on the ground (or after a
	//5s cap), so the eject fall cannot DBNO them but they are not invulnerable afterwards.
	local.player = self
	local.t = 0
	while (local.t < 5) {
		wait 0.25
		local.t = local.t + 0.25
		if (!local.player) { end }
		if (local.player.groundentity != NULL && local.t > 1) { break }
	}
	if (local.player) { local.player takedamage }
}end
