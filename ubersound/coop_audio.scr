// Numbered aliases + script randomint pick (the proven deathvox pattern).
aliascache coop_amb_artillery1 sound/coop_amb/artillery1.wav soundparms 0.5 0.1 0.85 0.15 2000 20000 auto loaded maps "m e t dm obj train"
