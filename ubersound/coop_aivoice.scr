alias coop_av_de_contact5 sound/dialogue/generic/g/sighted/alt_g_005a.wav soundparms 1.15 0.10 1.0 0.05 220 2400 dialog loaded maps "m e t dm obj train"
alias coop_av_de_contact6 sound/dialogue/generic/g/sighted/alt_o_003a.wav soundparms 1.15 0.10 1.0 0.05 220 2400 dialog loaded maps "m e t dm obj train"
