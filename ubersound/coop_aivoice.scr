// ============================================================================================
// [user 2026-08-31] OMAHA PANIC POOL - 19 allied panic/scream wavs ship loose in retail at
// sound/dialogue/generic/a/panic/ and are aliased ~99 times in retail's uberdialog.scr as
// dfr_panic_*. Nothing plays them on Omaha, so a beach covered in dead and dying men is silent.
//
// DECLARED HERE RATHER THAN USING THE RETAIL ALIASES, deliberately. The dfr_panic_* aliases are
// `streamed`, which in this engine means 2D - no position at all - and they carry maxDist 1200.
// A scream that comes from inside your own head, from a man you can see thirty feet away, reads
// as a bug. `loaded` puts them on the true 3D path with the coop occlusion filter; 220/2200 is
// what makes them audible at the range you actually see the casualties from.
//
// ONE NAME, MANY LINES = a random pool. Alias_ListFindRandomRange picks among same-name entries,
// which is exactly the coop_av_us_mandown shape immediately above - same file, same soundparms,
// proven. 33h_1 and 35c_1 are deliberately absent: mandown already owns them, and a shared line
// would make 'man down' and 'panic' sometimes say the same thing.
// ============================================================================================
// coop_av_us_panic
alias coop_av_us_panic1 sound/dialogue/generic/a/panic/dfr_panic_25j_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic2 sound/dialogue/generic/a/panic/dfr_panic_26a_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic3 sound/dialogue/generic/a/panic/dfr_panic_26a_2.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic4 sound/dialogue/generic/a/panic/dfr_panic_27j_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic5 sound/dialogue/generic/a/panic/dfr_panic_27j_2.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic6 sound/dialogue/generic/a/panic/dfr_panic_28m_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic7 sound/dialogue/generic/a/panic/dfr_panic_28m_2.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic8 sound/dialogue/generic/a/panic/dfr_panic_28m_3.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic9 sound/dialogue/generic/a/panic/dfr_panic_29e_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic10 sound/dialogue/generic/a/panic/dfr_panic_29e_2.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic11 sound/dialogue/generic/a/panic/dfr_panic_30f_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic12 sound/dialogue/generic/a/panic/dfr_panic_31k_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
alias coop_av_us_panic13 sound/dialogue/generic/a/panic/dfr_panic_32o_1.wav soundparms 1.20 0.10 1.0 0.05 220 2200 dialog loaded maps "m e t dm obj train"
