waitexec "anim/default_inithandler.scr"
waitexec anim/smoking.scr::SmokeRemoveCigarette

self.blendtime = 0.5	// Slow blendtime to avoid popping during idles.

self.painhandler = anim/pain_mg42.scr::PainOnMG42

//[user 2026-08-18] CREW SIDE-STEPS: the gun-traverse shuffle anims (mg42_stand_left1/2,
//mg42_stand_right1/2) shipped in every pak and were never played - the idle loop only aim-
//blended the torso while the feet stayed nailed down. Track the mounted gun's yaw between
//iterations; a real traverse plays a side-step in that direction, then falls back to the
//aim idle. Threshold 6 deg so micro-adjustments never dance.
self.coop_mgPrevYaw = self.angles[1]
idle_loop:
local.yaw = self.angles[1]
if (self.turret != NULL && self.turret != NIL)
{
	local.yaw = self.turret.angles[1]
}
local.dyaw = local.yaw - self.coop_mgPrevYaw
if (local.dyaw > 180) { local.dyaw = local.dyaw - 360 }
if (local.dyaw < -180) { local.dyaw = local.dyaw + 360 }
self.coop_mgPrevYaw = local.yaw
if (local.dyaw > 6)
{
	local.n = randomint 2
	if (local.n == 0) { self setmotionanim mg42_stand_left1 }
	else { self setmotionanim mg42_stand_left2 }
	self waittill flaggedanimdone
	goto idle_loop
}
if (local.dyaw < -6)
{
	local.n = randomint 2
	if (local.n == 0) { self setmotionanim mg42_stand_right1 }
	else { self setmotionanim mg42_stand_right2 }
	self waittill flaggedanimdone
	goto idle_loop
}
self setaimmotionanim MG42_crouch_idle MG42_stand_idle MG42_high_idle
self waittill flaggedanimdone
goto idle_loop
