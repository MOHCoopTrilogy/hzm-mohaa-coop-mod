//------
// disguise_halt.scr
//------

if (level.disguise_debug)
	iprintlnbold "Stop, fiend!"

	self lookat self.enemy
	self.blendtime = 0.50
	self setmotionanim (self.weapongroup + "_stand_alert_legs")
	self setupperanim ("den_actor_alert_" + self.voicetype)
	self waittill upperanimdone

	self lookat self.enemy

	//[200] Smithy - make them work with coop
	if (level.gametype != 0){
		//[user 2026-08-10] PER-TARGET DISGUISE GATE (master plan v2 Step 2, commit A1).
		//WAS: `&& thread coop_mod/aihandler.scr::canseeUndisguisedPlayers`. Two defects in one term.
		//(1) `thread` starts a label ASYNCHRONOUSLY and evaluates to a HANDLE, not to the return
		//value, so the term was ALWAYS TRUTHY - this guard never guarded anything.
		//(2) Even read correctly it is a ROOM TEST ("can I see ANY undisguised player") used to
		//decide whether to attack THIS enemy. In single player those are the same question; with
		//four players they are not, so one man drawing a weapon three rooms away made this guard
		//attack the disguised player standing in front of him, mid-papers-check.
		//NOW: the engine's own per-target truth, is_disguised (maintained per frame in coop since
		//bug-1638). Read into a local AFTER the classname test - is_disguised is a Player getter and
		//Morpheus && is not relied on to short-circuit.
		if (self.enemy != NULL && self.enemy.classname == "Player" && !self.flags["coop_isAttacking"]){
			local.edisg = self.enemy.is_disguised
			if (local.edisg != 1){
				thread coop_mod/aihandler.scr::attackPlayer self.enemy
				thread coop_mod/aihandler.scr::sentientIsSeen self self.enemy NIL 	//check to see if anyone can see him spot you
				thread coop_mod/aihandler.scr::sentientIsHeard self self.enemy 		//check to see if anyone can hear him spot you	
				self aimat self.enemy
				wait 0.1
				end
			}
		}
	}
	
	wait 10

//iprintlnbold "Warning: disguise_papers.scr has ended."

end
