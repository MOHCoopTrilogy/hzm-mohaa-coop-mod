//------
// Grenade martyr
//------



//===================================================================================
GrenadeMartyr:
	//println "grenademartyr.scr"
	waitexec "anim/default_inithandler.scr"
	waitexec anim/smoking.scr::SmokeRemoveCigarette

	self.blendtime = 0.50
	self setmotionanim diveongrenade 
	self waittill flaggedanimdone

	//[user 2026-08-18] retail's own TODO, finally done: a martyr shot on the grenade dies in the
	//dive pose instead of a generic death (alert/diveongrenade_death.skc was shipped unused).
	self.deathhandler = anim/grenademartyr.scr::GrenadeMartyrDeath

	// this script shouldn't terminate, to keep it from looping
	pause
end

//[user 2026-08-18] the wired grenade-dive death (pattern: cornerleftdeath)
GrenadeMartyrDeath:
	self setmotionanim diveongrenade_death
	self waittill flaggedanimdone
	self.position="dead"
end
