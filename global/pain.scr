//[200] Smithy - modified original file. Engine calls this every time an actor feels pain
start local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.dflags local.meansofdeath local.location:

	//[user 08-02] *** THIS GUARD PERMANENTLY DISABLED THE COOP PAIN HANDLER AFTER ONE HIT. ***
	//It was a boolean latch: set here and NEVER CLEARED ANYWHERE. A repo-wide grep found exactly
	//two references to coop_painThread in the whole mod - this test and the assignment below - so
	//nothing ever reset it. The engine calls global/pain.scr::start on EVERY pain event, so:
	//   hit 1 -> flag unset -> passes -> sets flag -> threads actorPainHandler
	//   hit 2..N -> flag still set -> prints the "killing thread" line -> ends immediately
	//i.e. actorPainHandler ran exactly ONCE per actor for the life of the map. Since that handler
	//is the ONLY thing that reconciles the engine health buffer (initialisePainVars parks every
	//managed actor on coop_aiBuffer and moves the real hp into coop_actorActualHealth), every
	//actor became a permanent bullet sponge after its first hit. That is BOTH reported symptoms:
	//"axis that will not die" and "the truck explosion doesn't kill the allies like in single
	//player" - the 700-damage radiusdamage cannot chew through an unreconciled buffer.
	//The guard's real purpose is to stop SAME-FRAME re-entrancy (two pain events in one frame
	//double-threading the handler). A timestamp does that and cannot leak: it self-clears the
	//moment level.time advances, so there is no state left to forget to reset.
	if (self.flags["coop_painFrame"] != NIL && self.flags["coop_painFrame"] == level.time){
		end
	}

	self.flags["coop_painFrame"] = level.time

	//[200] Smithy - add our own handler here
	//[200] Smithy - added check to force stop pain handler: ["coop_actorStopPainHandler"]
	if (level.gametype != 0 && !self.flags["coop_actorStopPainHandler"] && (self.flags["coop_actorHandledPain"] || level.coop_actorPainHandler)){
		//[202] chrissstrahl - this is to help us debug, we are having lots of crashes 
		if (level.coop_mapname == "e2l1"){
			local.var1 = level.gametype
			local.var2 = self.flags["coop_actorStopPainHandler"]
			local.var3 = self.flags["coop_actorHandledPain"]
			local.var4 = level.coop_actorPainHandler
			println "(pain.scr) " self " gametype: " local.var1 " actorStopPainHandler: " local.var2 " coop_actorHandledPain: " local.var3 " coop_actorPainHandler: " local.var4
		}	
		self thread coop_mod/aihandler.scr::actorPainHandler local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.dflags local.meansofdeath local.location
		end
	}
	
	self.fact = local CreateListener
	self.fact.attacker = local.attacker
	self.fact.damage = local.damage
	self.fact.inflictor = local.inflictor
	self.fact.position = local.position
	self.fact.direction = local.direction
	self.fact.normal = local.normal
	self.fact.knockback = local.knockback
	self.fact.dflags = local.dflags
	self.fact.meansofdeath = local.meansofdeath
	self.fact.location = local.location

	//[302] HZM XP - assist ledger + savior stamp (mirror of the aihandler pain-handler site;
	//this path runs for actors whose coop pain handler is off/stopped)
	if( local.attacker != NULL && local.attacker.classname == "Player" ){
		if( self.coop_xp_hp0 == NIL ){ self.coop_xp_hp0 = self.health + local.damage }
		local.xan = local.attacker.entnum
		if( self.coop_xp_dmgT[local.xan] != NIL && (level.time - self.coop_xp_dmgT[local.xan]) > 10 ){ self.coop_xp_dmg[local.xan] = 0 }
		if( self.coop_xp_dmg[local.xan] == NIL ){ self.coop_xp_dmg[local.xan] = 0 }
		self.coop_xp_dmg[local.xan] = self.coop_xp_dmg[local.xan] + local.damage
		self.coop_xp_dmgT[local.xan] = level.time
		self.fact.enemyAtPain = self.enemy
	}
end
