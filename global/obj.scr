//HZM coop - override of the base-game global/obj.scr.
//The stock SP obj.scr does `level waittill spawn` (invalid in MP coop -> the "invalid waittill spawn for
//'Level'" errors) and only feeds the SP objective HUD (hidden in MP), so maps that register objectives via
//`exec global/obj.scr` (t2l1, t2l3) showed NO objectives on the coop HUD.
//This forwards to the coop-integrated global/objectives.scr::add_objectives, which calls the engine
//addobjective AND pushes to the coop HUD - converting the SP status WORD to the coop numeric status.
//Called as: exec global/obj.scr <index> <status: hidden|current|complete (or 1|2|3)> <text> <location>
//=========================================================================
main local.index local.status local.objective local.location:{
//=========================================================================
	//SP status word -> coop numeric (1 = don't draw/hidden, 2 = in progress/current, 3 = completed)
	local.snum = local.status
	if( local.status == "hidden" ){ local.snum = 1 }
	else if( local.status == "current" ){ local.snum = 2 }
	else if( local.status == "complete" ){ local.snum = 3 }
	else if( local.status == "completed" ){ local.snum = 3 }

	waitthread global/objectives.scr::add_objectives local.index local.snum local.objective local.location
}end
