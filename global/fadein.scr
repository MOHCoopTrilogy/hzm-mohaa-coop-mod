//------------------------------------------------------------------
// HZM coop bug-3234: the retail global/fadein.scr (mainta+maintt pak1.pk3, md5 272c6a09), byte-for-byte, plus one
// coop_mod/menumirror.scr call after each showmenu/hidemenu so remote players get the title cards too.
//------------------------------------------------------------------
//	FadeIn.scr
//	Jeff Leggett
//	07/19/2002
//
//	Re-usable fade-in routine.
//
//	exec this script before your waittill spawn command.
//
//	Call fadein to put up the text menus and fade in the screen.
//	
//------------------------------------------------------------------


//------------------------------------------------------------------
main:
//
//	prepare for the fade in...
//------------------------------------------------------------------
	fadeout .001 0 0 0 1
	drawhud 0

	End

//------------------------------------------------------------------
DoFadeIn local.menu1 local.menu2 local.menu3 local.menu4 local.bDrawHud:
//------------------------------------------------------------------

	if (getcvar(debug) == "1")
	{
		fadein 0.1 0 0 0 1
		drawhud 1
		End
	}

	if ( local.bDrawHud==NIL )
		local.bDrawHud = 1
	
// NOTE: if a menu is not showing up you may need to increase this wait
	wait 1.5
		
	showmenu local.menu1
	waitthread coop_mod/menumirror.scr::coop_mirrorCard local.menu1	//bug-3234 remote players: showmenu reaches only the listen host
	hidemouse
	wait 1.5

	if ( local.menu2!=NIL )
	{
		showmenu local.menu2
		waitthread coop_mod/menumirror.scr::coop_mirrorCard local.menu2	//bug-3234 remote players: showmenu reaches only the listen host
		hidemouse

		wait 2.25
	}

	if ( local.menu3!=NIL )
	{
		showmenu local.menu3
		waitthread coop_mod/menumirror.scr::coop_mirrorCard local.menu3	//bug-3234 remote players: showmenu reaches only the listen host
		hidemouse

		wait 3
	}

	if ( local.menu4!=NIL )
	{
		showmenu local.menu4
		waitthread coop_mod/menumirror.scr::coop_mirrorCard local.menu4	//bug-3234 remote players: showmenu reaches only the listen host
		hidemouse

		wait 3
	}

	fadein 3.5 0 0 0 1

//	wait 0.5
	hidemenu local.menu1
	waitthread coop_mod/menumirror.scr::coop_mirrorCardHide local.menu1	//bug-3234 remote players: showmenu reaches only the listen host

	if ( local.menu2!=NIL )
		hidemenu local.menu2
		waitthread coop_mod/menumirror.scr::coop_mirrorCardHide local.menu2	//bug-3234 remote players: showmenu reaches only the listen host

	if ( local.menu3!=NIL )
		hidemenu local.menu3
		waitthread coop_mod/menumirror.scr::coop_mirrorCardHide local.menu3	//bug-3234 remote players: showmenu reaches only the listen host

	if ( local.menu4!=NIL )
		hidemenu local.menu4
		waitthread coop_mod/menumirror.scr::coop_mirrorCardHide local.menu4	//bug-3234 remote players: showmenu reaches only the listen host

	hidemouse

	if ( local.bDrawHud==1 )
	{
		drawhud 1
	}

	End
