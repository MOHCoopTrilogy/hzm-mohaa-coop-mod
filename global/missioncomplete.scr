//chrissstrahl - modified original file for loading next map
//2018.07.15

main local.nextlevel local.bsp local.skipFade:{
	//[user 2026-08-06] bug-1463 - COVERAGE SWEEP GUARD, second door. bug-1452 suppressed mission end
	//in coop_mod/missioncomplete.scr, but many maps (m3l3, and every map using the retail chain)
	//call THIS file instead - so the sweep's force-fire kept triggering real mission transitions:
	//m3l3 reloaded 7 times in 10 minutes, an endless restart loop that paused the whole rotation.
	//Same treatment: no-op under coop_maptest 3, and log it as a completability datapoint.
	if( getcvar( "coop_maptest" ) == "3" ){
		println( "^~^~^ COV MISSIONCOMPLETE_SUPPRESSED " + level.coop_mapname + " -> " + local.nextlevel )
		end
	}

	//[200] Smithy - store the thread name
	local.threadName = "global/missioncomplete.scr::main"

	//[user 07-12] XP "Made It" bonus anchor: mission-end is almost always exec'd from the exit
	//trigger's own handler thread, and called threads inherit self - so self here is usually the
	//end trigger (or the finishing player). Record its origin so xp.scr::xp_summary can reward
	//the players who actually reached the end point. No valid self -> anchor stays NIL and the
	//bonus falls back to "alive at mission end".
	if( level.gametype != 0 && self != NULL && self != $world ){
		level.coop_xp_endPoint = self.origin
	}

	//[311] FRONTLINE score layer - mission-complete fanfare (2D, per player; cvar-gated)
	if( level.gametype != 0 ){
		thread coop_mod/flmusic.scr::fl_sting "coop_sting_end"
	}

	if (local.skipFade != 1){
		local.skipFade = 0
	}

	// HZM COOP CAMPAIGN CHAIN: after a mission, detour through its post-mission lobby instead of going
	// straight to the next map. Gated on coop_campaign (set only by "Begin Full Campaign"; start_server.cfg
	// clears it) so normal single-map play is unaffected. Each lobby then launches the real next map itself.
	if( getcvar( "coop_campaign" ) == "1" ){
		local.coop_curMap = getcvar "mapname"
		if( local.coop_curMap == "m1l1" ){ local.nextlevel = "co_lobby2" }
		else if( local.coop_curMap == "m1l2a" ){ local.nextlevel = "co_lobby3" }
		else if( local.coop_curMap == "m1l3b" ){ local.nextlevel = "co_lobby4" }	// last jeep mission -> pre-finale lobby -> m1l3c
		else if( local.coop_curMap == "briefing2" ){ local.nextlevel = "co_lobby5" }	// chapter 2 briefing -> night-blizzard lobby -> m2l1
		else if( local.coop_curMap == "m2l1" ){ local.nextlevel = "co_lobby6" }		// post-m2l1 intel lobby -> m2l2a (bsp arg ignored by coop missioncomplete)
		else if( local.coop_curMap == "m2l2b" ){ local.nextlevel = "co_lobby7" }	// U-boat pens: m2l2b -> co_lobby7 staging -> m2l2c
		else if( local.coop_curMap == "m2l3" ){ local.nextlevel = "co_lobby8" }	// end of chapter 2: m2l3 -> co_lobby8 harbor staging -> briefing3
		else {
			//[user 2026-08-17] EVERY OTHER MISSION gets a lobby too, using co_lobby1 as the
			//placeholder until a purpose-built scene exists. Flow: briefing -> lobby -> mission ->
			//lobby -> mission. Two rules:
			// (a) NEVER insert a lobby before a BRIEFING - the briefing is itself the pause, and the
			//     lobby belongs on its far side (which is exactly what the co_lobby5 mapping above
			//     already does: briefing2 -> co_lobby5 -> m2l1).
			// (b) never lobby out of a lobby, or the campaign deadlocks bouncing between them.
			local.toBrief = 0
			local.fromLobby = 0
			if( local.nextlevel != NIL ){
				local.toBrief = waitthread coop_mod/main.scr::containsText local.nextlevel "briefing" 0
			}
			local.fromLobby = waitthread coop_mod/main.scr::containsText local.coop_curMap "co_lobby" 0
			if( local.nextlevel != NIL && local.toBrief != 1 && local.fromLobby != 1 ){
				//stash the destination the MAP chose, then detour
				setcvar "coop_campaignNext" local.nextlevel
				local.nextlevel = "co_lobby1"
			}
		}
	}

	//[200] chrissstrahl - have a seperate coop handle
	if(waitthread coop_mod/main.scr::inCoopMode){
		waitthread coop_mod/missioncomplete.scr::main local.nextlevel local.bsp local.skipFade
		end
	}


	if ($player.health <= 0)
		pause

	$player stopwatch 0	
	if (local.nextlevel != NIL)
	{
		if (local.bsp != NIL)
		{
			game.loadout = false
			bsptransition local.nextlevel local.skipFade
		}
		else
		{
			game.loadout = NIL
			leveltransition local.nextlevel local.skipFade
		}
	}
}end
