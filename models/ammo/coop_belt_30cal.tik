TIKI
// [reload audit phase B polish 2026-10-05] the M1919's new belt as a hand prop: the coop 30cal skeleton with ONLY the
// belt surface (coop_belt.skd), attached at the frozen tag_weapon_left so it leaves from / lands on the gun's belt.
setup
{
	scale 1.1
	path models/weapons/30calportable
	skelmodel coop_belt.skd
	surface belt shader shellbelt
}

animations
{
	idle	30cal.skc
}
