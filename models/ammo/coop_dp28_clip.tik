TIKI
// [reload audit phase B 2026-10-05] Lt. Pato's DP-28 pan prop (models/ammo/coop_dp28/clip.skd shipped with his
// reload, never wired). Attached to tag_weapon_left by coop_reload_dp28 while the gun's own pan is hidden.
setup
{
	scale 0.52
	path models/ammo/coop_dp28
	skelmodel clip.skd
	surface drum shader coop_dp28_body
}

animations
{
	idle	clip.skc
}
