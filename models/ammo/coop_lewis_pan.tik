TIKI
// [reload audit phase B 2026-10-05] the Lewis gun's top pan as a hand prop: the gun's own skeleton and pose with ONLY
// the pan surface (coop_lewis_pan.skd = BAR.skd whose header lists just 'drum' - "flags nodraw" on the other
// surfaces is ignored for an attached model, run rb1), so attached at tag_weapon_left - which
// coopr_lewis_gun_reload freezes at the gun transform of the grip frame - it sits exactly where the gun's pan was.
setup
{
	scale 0.52
	path models/weapons/coop_bar1918
	skelmodel coop_lewis_pan.skd
	surface drum shader coop_bar1918_lewismag
}

animations
{
	idle	lewis.skc
}
