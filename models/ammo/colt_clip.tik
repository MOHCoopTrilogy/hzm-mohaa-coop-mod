TIKI
// HZM coop [2026-09-01, bug-2241] RELOAD MAGAZINE, per-finish skin list.
// GENERATED by docs/tools/gen_clip_skins.py - do not hand-edit, re-run the generator.
//
// The retail copy of this file declares ONE shader row per surface, so numskins is 1 and
// tr_model.cpp clamps every skin index back to 0 - which is why the magazine in your hand
// stayed stock while the gun wore its finish. Each surface now carries 8 rows: index 0 is
// the untouched retail shader, 1-7 are the finishes, in the order loadoutskins.scr declares
// them. Entity::AttachModelEvent stamps the index onto the attached entity.
//
// Each finish shader is WHATEVER THE GUN'S OWN VARIANT TIK ASSIGNS to the surface wearing
// this clip's stock shader, so the magazine can never drift from the gun. Matching on the map
// TEXTURE was tried and is wrong: gold/chrome/blued tint the stock file while bloody and the
// camos use their own art, so it succeeds for three finishes and fails for four.
//
// EIGHT IS THE CEILING. MAX_TIKI_SHADER is 8 and MAX_TIKI_LOAD_SHADERS must track it;
// raising one alone corrupts memory and hangs the load (bug-2082). An eighth finish needs
// both raised.
setup
{
	scale 0.52
	path models/ammo/coltclip
	skelmodel clip_colt.skd
	surface colt45 shader colt
	surface colt45 shader coop_skin_colt45_gold	// gold
	surface colt45 shader coop_skin_colt45_chrome	// chrome
	surface colt45 shader coop_skin_colt45_blued	// blued
	surface colt45 shader coop_skin_colt45_bloody	// bloody
	surface colt45 shader coop_skin_colt45_camo_woodland	// camo_woodland
	surface colt45 shader coop_skin_colt45_camo_winter	// camo_winter
	surface colt45 shader coop_skin_colt45_camo_desert	// camo_desert
}

animations
{
	idle 	clipreload_colt.skc
   {	
	server
		{
			0  surface colt45 +nodraw
			18 surface colt45 -nodraw
			39 surface colt45 +nodraw
			
		}
			
	}

	
}
