TIKI
// [reload audit phase B 2026-10-05] the MG42 belt end as a hand prop: the gun skeleton with ONLY the shellbelt surface
// (coop_belt.skd), attached at the frozen tag_weapon_left so it leaves from and lands on the gun's belt.
setup
{
	scale 0.52
	path models/weapons/mg42portable
	skelmodel coop_belt.skd
	surface shellbelt shader shellbelt
}

animations
{
	idle	mg42.skc
}
