TIKI
// [reload audit phase B 2026-10-05] C96 stripper clip prop: the Kar98's own 5-round stripper clip (KAR98.skd listing only
// the clip and its rounds), posed in the Kar98's charger guides and shifted onto the C96's guides (origin pos +(-1.7, 0, 1.5) u,
// coop_c96_stripper.skc), so attached at a frozen tag it lands exactly in the C96's guides.
setup
{
	scale 0.52
	path models/weapons/KAR98
	skelmodel coop_stripper_full.skd
	surface material7 shader m1clip
	surface material8 shader m1clip
}

animations
{
	idle	coop_c96_stripper.skc
}
