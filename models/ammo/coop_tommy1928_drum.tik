TIKI
// [reload audit phase B 2026-10-05] The 1928 Tommy drum as a hand prop: the gun's own skeleton with ONLY the magazine surface (a
// copy of the gun skd whose header lists just that surface), attached at tag_weapon_left which the coopr_* reload clip
// freezes at the gun transform of the grip frame - so it leaves from, and lands back on, exactly where the gun's was.
setup
{
	scale 0.52
	path models/weapons/coop_tommy1928d
	skelmodel coop_drum.skd
	surface Clip shader coop_tommy1928d_gangstertdrum
}

animations
{
	idle	ThompsonSMG.skc
}
