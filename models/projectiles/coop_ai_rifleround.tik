TIKI
// HZM coop (bug-1185) - a plain, NON-EXPLOSIVE small-arms round for script_aimedstrafinggunfire.
//
// WHY THIS EXISTS: ScriptSimpleStrafingGunfire/ScriptAimedStrafingGunfire (fgame/scriptslave.cpp)
// ALWAYS fires via ProjectileAttack() - it is never hitscan, no matter what the script says. Its
// "bulletdamage"/"bulletcount"/"throughwood" setters are accepted and then completely ignored by
// GunFire(). If the script does not override the projectile, the class silently defaults to
// models/projectiles/stukaround.tik - a dive-bomber HE round - at fireDelay 0.05 (20 rounds/sec).
// A ground infantryman wired that way one-shots a 750hp coop player in well under a second.
//
// So: any coop script that spawns a strafinggunfire for a MAN must point it at this round.
// Damage is tuned to the "bulletdamage 12" the calling code always intended.
setup
{
	scale 0.04			// effectively invisible; the round reads as hitscan at this speed
	lod_scale 30
	path models/ammo/bazooka_shell
	skelmodel projectile_bazooka.skd	// base-game asset, guaranteed to resolve; scaled to nothing
}

init
{
	server
	{
		classname		Projectile
		anim			idle
		setsize			"-1 -1 -1" "1 1 1"
		speed			9000		// near-instant travel, so it feels like a bullet, not a shell
		addownervelocity	0
		hitdamage		12		// matches the intended "bulletdamage 12"
		life			2.0
		meansofdeath		bullet
		gravity			0
		knockback		8
		// NO explosionmodel and NO explodeontouch on purpose - this is a bullet, not ordnance.
	}
}

animations
{
	idle projectile_bazooka.skc
}
