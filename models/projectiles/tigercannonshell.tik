// Modified from mohaa standard, by Duncan Weir (Scorpio)

TIKI

//user for tiger tanks and king tiger tanks

setup
{
	scale 1.0	// Needs to be unnaturally large so it is visible
	path models/fx/dummy
	skelmodel dummy3.skd
}


init
{
	server
	{
		rendereffects 	+dontdraw
		classname		Projectile
		setsize		"-4 -4 -4" "4 4 4"
		speed			6000
		addownervelocity	0
		hitdamage		200
		life			20.0
		meansofdeath	explosion
//		impactmarkshader	blastmark
//		impactmarkradius	50
//		impactmarkorientation	random
		explosionmodel		models/fx/explosionTIGERshell.tik
//		notouchdamage
		explodeontouch
		smashthroughglass 64
//		gravity 0.8
//		addvelocity 0 0 200
//		avelocity random 90 random 90 60
		knockback			500
//		dlight 0.5 0.2 0.1 256 // red green blue radius
		gravity 0.5

		cache blastmark.spr
		cache models/fx/explosionTIGERshell.tik
	}
	client
	{
		originemitter bazookatrail
		(
				model vsssource.spr
				velocity 150
				friction 0.85
				randvel crandom 10 crandom 10 crandom 10
				accel 0 0 20
				spawnrate 110
				color .4 .4 .4
				spritegridlighting
				alpha 0.4
				fadein 0.1
				fadedelay 1.0
				scalemin 0.8
				scalemax 1.0
				scalerate 0.5
				life 1.0 1.25
		)
	}
}

animations
{
	idle dummy3.skc
}
