TIKI
setup
{
	scale 1			
	path models/renan_models
	skelmodel cod_flatcar.skd
	surface flatcar_side shader flatcar_side 
	surface rail_wheelface shader rail_wheelface 
	surface railcar_axle shader railcar_axle 
	surface railcar_beam1 shader railcar_beam1 
	surface railcar_spring shader railcar_spring
	surface flatcar_floor shader flatcar_floor

}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle     cod_flatcar.skc
}

