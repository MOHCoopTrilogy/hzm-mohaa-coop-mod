TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/ukgear/helmets/uk_helmet.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel uk_helmet.skd
	surface us_helmet shader uk_pt_helmet3
}

animations
{
	idle		us_helmetfit.skc
}
