TIKI
// HZM coop [user 08-07] bug-1540: EXACT-FIT attachable headgear, same recipe as the other
// pieces (geometry lifted from a worn gear skd, head-bone-local coords, cm scale -> 0.52,
// shared identity idle skc). Round-tripped through _research/assetaudit/skx.py (0 warnings)
// before deploy; binary-format valid and script-parse clean, NOT verified in-game.
// Source skd: models/human/gear/brit_tank_beret/brit_tank_beret.skd
// Worn by:    allied_british_tank_corporal.tik - the CHAINED case: single-weighted to bone
// 'beret_and_goggles', two JT_POSROT gear bones deep off Bip01 Head. No player animation
// carries a 'helmet'/'beret_and_goggles' channel, so the engine leaves both at identity and
// the raw offsets ARE head-bone-local - transplanted verbatim, no transform applied.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel brit_tankberet.skd
	surface beret shader brit_tank_beret
	surface goggles shader brit_tank_goggles
}

animations
{
	idle		us_helmetfit.skc
}
