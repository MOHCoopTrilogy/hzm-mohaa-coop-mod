TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/germangear/officer_hat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel ger_offhat_sh.skd
	surface officer_hat shader dak_officer_hat
}

animations
{
	idle		us_helmetfit.skc
}
