TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/germangear/helmet.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel ger_helmet_sh.skd
	surface helmet shader static_ranger_helmet
}

animations
{
	idle		us_helmetfit.skc
}
