TIKI
// HZM coop [user 08-07] bug-1540: EXACT-FIT attachable headgear, same recipe as the other
// pieces (geometry lifted from a worn gear skd, head-bone-local coords, cm scale -> 0.52,
// shared identity idle skc). Round-tripped through _research/assetaudit/skx.py (0 warnings)
// before deploy; binary-format valid and script-parse clean, NOT verified in-game.
// Source skd: models/human/heads/al_us_maskhead.skd
// Worn by:    allied_us_mask.tik / sc_al_us_infmask.tik - the US M9 gas mask (a different mask
// from the German gasmask.skd already shipped as piece 35).
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel us_gasmask.skd
	surface AL_US_Mask shader AL_US_Mask
}

animations
{
	idle		us_helmetfit.skc
}
