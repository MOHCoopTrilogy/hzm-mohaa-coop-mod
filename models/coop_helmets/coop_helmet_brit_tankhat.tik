TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/britgear/sc_al_brit_tankhat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel brit_tankhat.skd
	surface BritTankHat shader SC_AL_BRIT_TankHat
}

animations
{
	idle		us_helmetfit.skc
}
