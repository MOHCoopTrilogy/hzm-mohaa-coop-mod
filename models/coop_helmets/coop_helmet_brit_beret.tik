TIKI
// HZM coop [user 07-12] bone-attached headgear tried DIRECTLY (own root bone, authored
// around origin). If it sits wrong in-game it gets the exact-fit rebuild treatment.
setup
{
	scale 0.52
	path models/human/brit-beret
	skelmodel brit-beret.skd
	//[user 2026-08-23, bug-2085] BIND THE SHADER EXPLICITLY. With the animation fixed these
	//three loaded and drew real geometry (SKELDRAW rc=190 dV=190) but stayed invisible: the
	//TIKs declared NO surface binding at all, so the mesh fell back to whatever shader name the
	//skd embeds. For the Soviet hat the log said so outright - "Couldn't find image file for
	//shader hat". Every working helmet in this folder binds its surfaces explicitly (see
	//coop_helmet_brit_tankberet.tik); these three were the only ones that did not. The shader
	//names below all exist in the retail shader scripts.
	surface brit_beret shader brit_beret
}

animations
{
	//[user 2026-08-23, bug-2085] USE THIS MESH'S OWN ANIMATION. This read
	//`../../coop_helmets/us_helmetfit.skc` - a RELATIVE path out of the setup block's
	//`path`, which the engine cannot resolve inside a pak. The log was unambiguous:
	//"Could not open binary file models/human/brit-beret/../../coop_helmets/..." then
	//"No valid animations found", and a TIKI with no valid animation does not load AT ALL -
	//so the beret was missing from the armory preview and from play, not merely mispositioned.
	//Each of these three meshes ships its OWN matching .skc beside it in the retail paks, so
	//the fix is a bare sibling filename that resolves against the path already set, and it
	//matches the skeleton exactly rather than borrowing the US helmet's.
	idle		brit-beret.skc
}
