TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/italiangear/ax_ital_infhat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel ital_infhat.skd
	surface ax_ital_infhat shader SC_AL_US_Inf_Helm
}

animations
{
	idle		us_helmetfit.skc
}
