TIKI
// HZM coop [user 07-13] EXACT-FIT attachable helmet (same transplant recipe as coop_helmet_medic):
// worn us_helmet.skd geometry in head-bone-local coords, retail lieutenant variant skin.
setup
{
	scale 0.52		// cm -> game units (16u/ft), same as the player TIKs
	path models/coop_helmets
	skelmodel us_helmetfit.skd
	surface us_helmetstatic shader static_us-helmet_ltnt
}

animations
{
	idle		us_helmetfit.skc
}
