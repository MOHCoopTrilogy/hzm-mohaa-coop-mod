TIKI
// HZM coop [user 08-07] bug-1545: STANDARD ISSUE headgear piece for the hatless armory
// bodies (models/player/*_nohat.tik). The armory bodies no longer carry any baked headgear,
// so "Standard Issue" attaches this - the SAME mesh and the SAME shader the body used to
// carry, so the default look is unchanged. Geometry container: see the piece it reuses.
// Worn by: allied_airborne_82nd_3
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel std_liner.skd
	surface us_helmet_inside shader helmet_inside_bob
	skelmodel us_helmetfit.skd
	surface us_helmetstatic shader blank_web
}

animations
{
	idle		us_helmetfit.skc
}
