TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/germangear/dak_hat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel dak_hat.skd
	surface hat shader DAKhat	// 15 candidate shaders in paks
}

animations
{
	idle		us_helmetfit.skc
}
