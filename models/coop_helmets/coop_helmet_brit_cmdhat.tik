TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/britgear/al_brit_cmdhat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel brit_cmdhat.skd
	surface AL_BRIT_CMDHAT shader AL_Brit_CMDHAT
}

animations
{
	idle		us_helmetfit.skc
}
