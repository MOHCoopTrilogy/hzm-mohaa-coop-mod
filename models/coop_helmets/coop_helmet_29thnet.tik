TIKI
// HZM coop [user 07-12] EXACT-FIT attachable helmet: geometry transplanted from the worn
// us_helmet.skd (head-bone-local coordinates, in CM like all MOHAA models -> scale 0.52),
// UV layout/triangles kept from us_helmetstatic so the original variant skins map perfectly.
// attachmodel this to "Bip01 Head" with ZERO offset = pixel-identical to the model's own helmet.
setup
{
	scale 0.52		// cm -> game units (16u/ft), same as the player TIKs - the worn-skd coords are cm too; 1.0 rendered the helmet 2x size (shot0079)
	path models/coop_helmets
	skelmodel us_helmetfit.skd
	surface us_helmetstatic shader static_us-helmet_29th-net
}

animations
{
	idle		us_helmetfit.skc
}
