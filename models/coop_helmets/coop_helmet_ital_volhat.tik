TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/equipment/italiangear/ax_it_volhat.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel ital_volhat.skd
	surface AX_ITAL_VOLHAT shader AX_Ital_Vol_Hat
}

animations
{
	idle		us_helmetfit.skc
}
