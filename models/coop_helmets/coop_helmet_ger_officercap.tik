TIKI
// HZM coop [user 07-12] EXACT-FIT headgear: geometry lifted from the worn gear skd
// (models/gear/g_headgear/officercap.skd) - head-bone-local coords, cm scale -> 0.52. Shared identity idle skc.
setup
{
	scale 0.52
	path models/coop_helmets
	skelmodel ger_officercap.skd
	surface officercap shader officer_hat
}

animations
{
	idle		us_helmetfit.skc
}
