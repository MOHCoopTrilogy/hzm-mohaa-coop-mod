TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

//	path models/human/german_elite_gestapo
//	skelmodel gestapo.skd

//	surface pants shader Officer2_pants			//.tik model for both Gestapo and Elite SS officer (colonel/general) because 2015 mixed it up and forgot it. 
//	surface coat shader gestapocoat				//with pistol it's given high ranking officer model (SS greatcoat) and for other weapons it's given Gestapo guard model.
//	surface coatcull shader cull_gestapocoat		//so Elite Officers appear in m4l1 and m4l3, and Gestapo in m4l1 and m6l2b.

	$include models/human/heads/german_old_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader L_gloves
	surface hand shader L_gloves_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader L_gloves_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader L_gloves_blood3	// HZM coop - gore tier1e (gib)

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader generalcoat
		surface coat shader generalcoat_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader generalcoat_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader generalcoat_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader generalcoat
		surface coatcull shader generalcoat_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader generalcoat_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader generalcoat_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_steingrau
	}

	//*** p-38 pistol
	case weapon "Walter P38"
	{

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader generalcoat
		surface coat shader generalcoat_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader generalcoat_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader generalcoat_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader generalcoat
		surface coatcull shader generalcoat_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader generalcoat_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader generalcoat_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_steingrau
	}

	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{
//		skelmodel k98clips.skd
//		surface k98clips shader german_riflebelt

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_black

	}

	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{
//		skelmodel k98clips.skd
//		surface k98clips shader german_riflebelt

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_black

	}
	
	//*** MP40 submachinegun
	case weapon "MP40"
	{
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader gestapohat2	//officerhat_ss_black

	}

	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_black

	}

	//*** panzerschrek
	case weapon "Panzerschrek"
	{
		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_black

	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{
		path models/human/german_elite_gestapo
		skelmodel gestapo.skd

		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface coat shader gestapo_ledermantel
		surface coat shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coat shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coat shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)
		surface coatcull shader gestapo_ledermantel
		surface coatcull shader gestapo_ledermantel_blood1	// HZM coop - gore tier 1 (light)
		surface coatcull shader gestapo_ledermantel_blood2	// HZM coop - gore tier 1 (heavy)
		surface coatcull shader gestapo_ledermantel_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_black
	}
//*** end weapon equipment assignment
//************************************


//	path models/gear/g_headgear
//	skelmodel officercap.skd
//	surface officercap shader officer2_hat

	

	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 125
		weapon "walter p38"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_ssofficercap.tik" 200 4 "officercap" 
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_german.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_ssofficer.tik

