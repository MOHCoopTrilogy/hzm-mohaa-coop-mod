TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

	path models/human/german_waffenss_nco	// Set path to set skelmodel from
	skelmodel ssnco.skd		// Set body model

	surface top shader shutzshirt_nco
	surface top shader shutzshirt_nco_blood1	// HZM coop - gore tier 1 (light)
	surface top shader shutzshirt_nco_blood2	// HZM coop - gore tier 1 (heavy)
	surface top shader shutzshirt_nco_blood3	// HZM coop - gore tier1e (gib)
	surface pants shader shutzpants_nco
	surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
	surface culltop shader cull_shutzshirt_nco
	surface culltop shader cull_shutzshirt_nco_blood1	// HZM coop - gore tier 1 (light)
	surface culltop shader cull_shutzshirt_nco_blood2	// HZM coop - gore tier 1 (heavy)
	surface culltop shader cull_shutzshirt_nco_blood3	// HZM coop - gore tier1e (gib)



//	path models/human/heads			// Set new path for head model
//	skelmodel head8.skd			// Set head model
//	surface head shader hopper
	$include models/human/heads/german_old_heads.tik	//models/human/heads/german_old_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

//	path models/gear/g_headgear

//	skelmodel ssncocap.skd			//vanilla model
//	surface ssncocap shader crusher_ss

	path models/gear/g_headgear

	skelmodel crusher.skd
	surface crusher shader crusher_ss_feldgrau

	

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** p-38 pistol
	case weapon "Walter P38"
	{

		path models/gear/ss

		skelmodel ssholster.skd
		surface ssholster shader german_holster

		path models/gear/officer

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

	}

	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{

		path models/gear/ss

		skelmodel sskarclips.skd
		surface sskarclips shader german_riflebelt

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss

	}

	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{

		path models/gear/ss

		skelmodel ssholster.skd
		surface ssholster shader german_holster

		path models/gear/officer

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

	}
	
	//*** MP40 submachinegun
	case weapon "MP40"
	{

		path models/gear/ss

//		skelmodel ssmp40clips.skd
//		surface ssmp40clips shader ammo_pouch

		skelmodel ssholster.skd
		surface ssholster shader german_holster

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss

		path models/gear/officer

		skelmodel mp40clips.skd
		surface mp40clips shader ammo_pouch

	}
	
	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{

		path models/gear/ss

		skelmodel ssmp44clips.skd
		surface ssmp44clips shader mp44ammopouch

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss
	}
//*** end weapon equipment assignment
//************************************


	radius 20					// Defines size of shadow
}

init
{
	server
	{
     	 	classname Actor
    	  	german
		setsize "-16 -16 0" "16 16 92"
		health 125
		weapon "MP40"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_ssnco.tik" 200 4 "ssncocap"
	}
}

$include models/human/animation/dialogue/generic_dialogue_german.tik
$include models/human/new_generic_human.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_ssnco.tik

