TIKI
setup
{
	scale 0.52
	path models/human/SC_Ax_ital_INF	          // Set path to set skelmodel from
	skelmodel SC_Ax_ital_INF.skd		// Set body model

        surface SC_Ax_ital_INF_Pants   shader SC_Ax_ital_INF_Pants
        surface SC_Ax_ital_INF_Pants shader SC_Ax_ital_INF_Pants_blood1	// HZM coop - gore tier 1 (light)
        surface SC_Ax_ital_INF_Pants shader SC_Ax_ital_INF_Pants_blood2	// HZM coop - gore tier 1 (heavy)
        surface SC_Ax_ital_INF_Pants shader SC_Ax_ital_INF_Pants_blood3	// HZM coop - gore tier1e (gib)
        surface Sc_AX_Ital_Inf_tunic   shader SC_Ax_ital_INF_Tunic
        surface Sc_AX_Ital_Inf_tunic shader SC_Ax_ital_INF_Tunic_blood1	// HZM coop - gore tier 1 (light)
        surface Sc_AX_Ital_Inf_tunic shader SC_Ax_ital_INF_Tunic_blood2	// HZM coop - gore tier 1 (heavy)
        surface Sc_AX_Ital_Inf_tunic shader SC_Ax_ital_INF_Tunic_blood3	// HZM coop - gore tier1e (gib)

	//path models/human/heads
	//skelmodel head1.skd
	//surface head shader us_j
        $include models/human/heads/it_young_heads.tik
	
        // HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	// GEAR
	// =======================================================
	//path models/equipment/USGear/airborne
	//skelmodel airborne_gear.skd
	//surface gear shader airborne_gear

	// HELMET
	// =======================================================
	path models/equipment/ItalianGear
	skelmodel ax_ital_infhat.skd
	surface ax_ital_infhat shader SC_AL_US_Inf_Helm
	
	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// defines size of shadow
}

init
{
	server
	{
      	classname Actor
   	   	german
		nationality it
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "Carcano"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/ax_ital_infhat_TOSS.tik" 150 0.1 "ax_ital_infhat"
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/Generic_dialogue_Italian.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

