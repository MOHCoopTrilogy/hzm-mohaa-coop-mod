TIKI
setup
{
	scale 0.52
	path models/human/SC_AL_Brit_INF	          // Set path to set skelmodel from
	skelmodel sc_al_brit_inf.skd		// Set body model

        surface Sc_AL_brit_Inf_Pants  shader Sc_AX_Ital_Inf2_Pant
        surface Sc_AL_brit_Inf_Pants shader Sc_AX_Ital_Inf2_Pant_blood1	// HZM coop - gore tier 1 (light)
        surface Sc_AL_brit_Inf_Pants shader Sc_AX_Ital_Inf2_Pant_blood2	// HZM coop - gore tier 1 (heavy)
        surface Sc_AL_brit_Inf_Pants shader Sc_AX_Ital_Inf2_Pant_blood3	// HZM coop - gore tier1e (gib)
        surface Sc_AL_brit_inf_Tunic  shader Sc_AX_Ital_Inf2_Tunic
        surface Sc_AL_brit_inf_Tunic shader Sc_AX_Ital_Inf2_Tunic_blood1	// HZM coop - gore tier 1 (light)
        surface Sc_AL_brit_inf_Tunic shader Sc_AX_Ital_Inf2_Tunic_blood2	// HZM coop - gore tier 1 (heavy)
        surface Sc_AL_brit_inf_Tunic shader Sc_AX_Ital_Inf2_Tunic_blood3	// HZM coop - gore tier1e (gib)
        //This does not exist
        //surface pack                   shader Sc_AL_brit_inf_equip

	//path models/human/heads
	//skelmodel head1.skd
	//surface head shader paul
        $include models/human/heads/it_young_heads.tik

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	// GEAR
	// =======================================================
	path models/equipment/britgear
	skelmodel SC_AL_BRIT_INF_GEAR.skd
	surface pack shader SC_AL_BRIT_INF_GEAR

	// HELMET
	// =======================================================
	path models/equipment/USGear/helmets
	skelmodel us_helmet.skd
	surface us_helmet shader SC_AL_US_Inf_Helm
	
	// parachute pack
	//path models/human/gear/us_parachute_pack
	//skelmodel us_parachute_pack.skd
	//surface pack shader us_parachute_pack

	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// defines size of shadow
}

init
{
	server
	{
      	classname Actor
   	   	german
		nationality it
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "carcano"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/ax_ital_inf2hat_TOSS.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/Generic_dialogue_Italian.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik



