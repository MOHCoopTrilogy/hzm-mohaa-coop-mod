TIKI
setup
{
//	path models/human/german_wehrmact_officer	// Set path to set skelmodel from
//	skelmodel german_officer.skd			// Set body model

//	surface tunic shader Officer2_tunic 
//	surface pants shader Officer2_pants
//	surface tunic_c shader Officer2_tunic_c


//	path models/human/heads			// Set new path for head model
//	skelmodel head8.skd			// Set head model
//	surface head shader hopper
	$include models/human/heads/german_old_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader L_gloves

//	path models/gear/g_headgear

//	skelmodel officerhat_new.skd
//	surface officerhat shader officerhat_ss_steingrau 	//officerhat_ss_black
	

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster

		path models/human/german_wehrmact_officer	// Set path to set skelmodel from
		skelmodel german_officer.skd			// Set body model

		surface tunic shader Officer2_tunic 
		surface tunic shader officer2_tunic_blood1	// HZM coop - gore tier 1 (light)
		surface tunic shader officer2_tunic_blood2	// HZM coop - gore tier 1 (heavy)
		surface tunic shader officer2_tunic_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface tunic_c shader Officer2_tunic_c
		surface tunic_c shader officer2_tunic_c_blood1	// HZM coop - gore tier 1 (light)
		surface tunic_c shader officer2_tunic_c_blood2	// HZM coop - gore tier 1 (heavy)
		surface tunic_c shader officer2_tunic_c_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_steingrau


	}

	//*** p-38 pistol
	case weapon  "Walter P38"
	{
//		path models/gear/g_headgear

//		skelmodel officercap.skd
//		surface officercap shader officer2_hat

		path models/human/german_wehrmact_officer	// Set path to set skelmodel from
		skelmodel german_officer.skd			// Set body model

		surface tunic shader Officer2_tunic 
		surface tunic shader officer2_tunic_blood1	// HZM coop - gore tier 1 (light)
		surface tunic shader officer2_tunic_blood2	// HZM coop - gore tier 1 (heavy)
		surface tunic shader officer2_tunic_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader Officer2_pants
		surface pants shader officer2_pants_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader officer2_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader officer2_pants_blood3	// HZM coop - gore tier1e (gib)
		surface tunic_c shader Officer2_tunic_c
		surface tunic_c shader officer2_tunic_c_blood1	// HZM coop - gore tier 1 (light)
		surface tunic_c shader officer2_tunic_c_blood2	// HZM coop - gore tier 1 (heavy)
		surface tunic_c shader officer2_tunic_c_blood3	// HZM coop - gore tier1e (gib)
		

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_steingrau
	}

	//*** MP40 submachinegun
	case weapon "MP40"
	{

		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

	}

	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{
		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/heer

		skelmodel karclips.skd
		surface karclips shader german_riflebelt

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

	}

	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{

		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/ss

		skelmodel ssholster.skd
		surface ssholster shader german_holster

		path models/gear/officer

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

	}
	
	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{

		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/ss

		skelmodel ssmp44clips.skd
		surface ssmp44clips shader mp44ammopouch

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

	}


	//*** panzerschrek
	case weapon "Panzerschrek"
	{
		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

		
	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{
		path models/human/german_waffenss_nco	// Set path to set skelmodel from
		skelmodel ssnco.skd		// Set body model

		surface top shader ss_smock_officer_cpt
		surface top shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface top shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface top shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)
		surface pants shader shutzpants_nco
		surface pants shader shutzpants_nco_blood1	// HZM coop - gore tier 1 (light)
		surface pants shader shutzpants_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface pants shader shutzpants_nco_blood3	// HZM coop - gore tier1e (gib)
		surface culltop shader ss_smock_officer_cpt
		surface culltop shader ss_smock_officer_cpt_blood1	// HZM coop - gore tier 1 (light)
		surface culltop shader ss_smock_officer_cpt_blood2	// HZM coop - gore tier 1 (heavy)
		surface culltop shader ss_smock_officer_cpt_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel officerhat_new.skd
		surface officerhat shader officerhat_ss_feldgrau

	}


//*** end weapon equipment assignment
//************************************


	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 115
		weapon "Walter P38"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_ssofficercap.tik" 200 4 "officercap" 
	}
}

//
// include the base animations definition
//

$include models/human/animation/dialogue/generic_dialogue_german.tik
$include models/human/new_generic_human.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_ssofficer.tik

