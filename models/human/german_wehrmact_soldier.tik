TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

//	path models/human/german_wehrmact_soldier
//	skelmodel heerprivate.skd

//	surface wehrmact_pants shader heer_pants_late		//wehrmact_pants_fgrey
//	surface wehrmact_tunic shader wehrmact_tunic_fieldgrey	//wehrmacht_soldat
//	surface wehrmact_tunic_c shader wehrmact_tunic_fieldgrey_c

	$include models/human/heads/german_young_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		skelmodel german_holster.skd
		surface german_holster shader german_holster

		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants_fgrey
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_soldat
		surface wehrmact_tunic shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_soldat
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)

	}

	//*** p-38 pistol
	case weapon "Walter P38"
	{

		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants_fgrey
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_soldat
		surface wehrmact_tunic shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_soldat
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader hundhat

	}

	
	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader heer_pants_late		//wehrmact_pants_fgrey
		surface wehrmact_pants shader heer_pants_late_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader heer_pants_late_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader heer_pants_late_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_soldat
		surface wehrmact_tunic shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_soldat
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_soldat_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		skelmodel karclips.skd
		surface karclips shader german_riflebelt

		path models/gf
		skelmodel ghandgranade.skd
		surface ghandgranade shader ghandgranadegf


		
	}
	
	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmacht_pants_camo2
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_sniper
		surface wehrmact_tunic shader wehrmacht_sniper_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_sniper_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_sniper_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_sniper
		surface wehrmact_tunic_c shader wehrmacht_sniper_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_sniper_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_sniper_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_hat_camo2	//heer_hat_camo		// 1- green-blue splinter camo, 2-green-brown splinter camo

		path models/gear/heer
		skelmodel holster.skd
		surface holster shader german_holster


		
	}
	
	//*** MP40 submachinegun
	case weapon "MP40"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants_fgrey
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_alt_soldat
		surface wehrmact_tunic shader wehrmacht_alt_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_alt_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_alt_soldat_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_alt_soldat
		surface wehrmact_tunic_c shader wehrmacht_alt_soldat_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_alt_soldat_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_alt_soldat_blood3	// HZM coop - gore tier1e (gib)

		//path models/gear/g_headgear
		//skelmodel creasecap.skd
		//surface creasecap shader hundhat

		path models/gear/g_headgear
		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		//path models/gear/officer
		//skelmodel mp40clips.skd
		//surface mp40clips shader ammo_pouch_tan

		path models/gear/panzer
		skelmodel panzerloadout.skd
		surface panzerloadout shader german_gear	//lightened loadout

		path models/gear/heer
		//skelmodel loadout.skd
		//surface loadout shader german_gear

		skelmodel mp40clip.skd
		surface mp40clip shader ammo_pouch_tan

	}
	
	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants_fgrey
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_fgrey_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_gefreiter	//wehrmacht_ober_vet
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter	//shader wehrmacht_ober_vet
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		skelmodel hmp44clips.skd
		surface hmp44clips shader mp44pouch_green	//mp44ammopouch

		path models/gf
		skelmodel ghandgranade.skd
		surface ghandgranade shader ghandgranadegf
	
		
	}


	//*** panzerschrek
	case weapon "Panzerschrek"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader heer_pants_late		//wehrmact_pants_fgrey
		surface wehrmact_pants shader heer_pants_late_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader heer_pants_late_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader heer_pants_late_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_gefreiter
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader hundhat

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		
	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader heer_pants_late		//wehrmact_pants_fgrey
		surface wehrmact_pants shader heer_pants_late_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader heer_pants_late_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader heer_pants_late_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_gefreiter
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_gefreiter_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/dak
		
		skelmodel dakholster.skd
		surface dakholster shader german_holster

		skelmodel dakgloadout.skd
		surface shells shader grenadier_shells
		surface ammobox shader grenadier_ammobox
	}
//*** end weapon equipment assignment
//************************************



	

	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 100
		weapon "Mauser KAR 98K"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_helmet.tik" 150 0.1 "outside" "inside" 
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_german.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_wehrmact.tik

