TIKI
// HZM coop [user 2026-08-03] bug-1314 - GORE TIER 1 blood skins for the e2l1 glider pilot.
// Retail ships one shader per surface, so Sentient::CoopGoreUpdateSkinTier / a scripted
// surface +skin had no alternate to select and he stayed clean while being shot. Shaders in
// scripts/coop_gore.shader; art generated from his own diffuse. head blood2 = entry wound.
setup
{
	scale 0.52
	path models/human/SC_Al_US_pilot	// Set path to set skelmodel from
	skelmodel SC_Al_US_pilot.skd		// Set body model

        surface Sc_Al_US_Pilot_Pants     shader Sc_AL_US_Pilot_Pants
        surface Sc_Al_US_Pilot_Pants shader Sc_AL_US_Pilot_pants_blood1	// HZM coop - gore tier 1 (light)
        surface Sc_Al_US_Pilot_Pants shader Sc_AL_US_Pilot_pants_blood2	// HZM coop - gore tier 1 (heavy)
        surface Sc_Al_US_Pilot_Pants shader Sc_AL_US_Pilot_pants_blood3	// HZM coop - gore tier1e (gib)
        surface Sc_Al_US_Pilot_Tunic     shader Sc_AL_US_Pilot_Tunic
        surface Sc_Al_US_Pilot_Tunic shader Sc_AL_US_Pilot_tunic_blood1	// HZM coop - gore tier 1 (light)
        surface Sc_Al_US_Pilot_Tunic shader Sc_AL_US_Pilot_tunic_blood2	// HZM coop - gore tier 1 (heavy)
        surface Sc_Al_US_Pilot_Tunic shader Sc_AL_US_Pilot_tunic_blood3	// HZM coop - gore tier1e (gib)

	path models/human/heads
	skelmodel head1.skd
	surface head shader Bensonazi
	surface head shader Bensonazi_blood1	// HZM coop - gore tier 1 (light)
	surface head shader Bensonazi_blood2	// HZM coop - gore tier 1 (heavy) - ENTRY WOUND
	surface head shader Bensonazi_blood3	// HZM coop - gore tier1e (gib)

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	// GEAR
	// =======================================================
	//path models/equipment/USGear/airborne
	//skelmodel airborne_gear.skd
	//surface gear shader airborne_gear

	// HELMET
	// =======================================================
	path models/equipment/USGear/helmets
	skelmodel us_helmet.skd
	surface us_helmet shader SC_AL_US_Inf_Helm
	
	// parachute pack
	//path models/human/gear/us_parachute_pack
	//skelmodel us_parachute_pack.skd
	//surface pack shader us_parachute_pack

	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// defines size of shadow
}

init
{
	server
	{
      	classname Actor
   	   	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

