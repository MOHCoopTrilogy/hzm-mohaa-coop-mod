// [user 08-07] HZM coop override of the stock allied_oss_man_disguised.tik (Major Grillo's
// German-officer disguise, worn for the WHOLE of m2l1 including his scripted death - the map
// never swaps him back to allied_oss_man_m1.tik).
//
// WHY THIS FILE EXISTS: m2l1.scr's death handler tries to paint a chest/back wound on him via the
// skin-offset recipe, but it was written against surfaces "shirt"/"cullshirt" - those belong to
// allied_oss_man_m1.tik (the brown resistance outfit), NOT to this disguise, whose torso is
// "tunic"/"tunic_c". Setting a surface that does not exist is a silent no-op (the engine only
// warns "group not found"), so no wound ever appeared. Even with the right names the stock model
// declares exactly one shader per surface, so there was no blood tier to switch TO.
//
// Adding the tier declarations here is the same pattern already applied to allied_oss_man_m1.tik.
// The officer_tunic_blood1/2 and officer_tunic_c_blood1/2 shaders already existed in
// scripts/coop_gore.shader - only the model side was missing.
//
// BASED ON THE HRRTM ADDON COPY, not retail Pak0: both paks carry this filename, and the addon's
// sorts earlier than our own pk3 but later than Pak0, so the addon's version (crusher cap +
// knitgloves) is what actually renders. Copying the Pak0 version instead would have silently
// stripped his hat and gloves.
TIKI
setup
{
	scale 0.52
	path models/human/german_wehrmact_officer	// Set path to set skelmodel from
	skelmodel german_officer.skd			// Set body model

	surface tunic shader officer_tunic
	surface tunic shader officer_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface tunic shader officer_tunic_blood2	// HZM coop - gore tier 2 (heavy)
	surface pants shader officer_pants
	surface tunic_c shader officer_tunic_c
	surface tunic_c shader officer_tunic_c_blood1	// HZM coop - gore tier 1 (light)
	surface tunic_c shader officer_tunic_c_blood2	// HZM coop - gore tier 2 (heavy)

	path models/human/heads			// Set new path for head model
	skelmodel head2.skd			// Set head model
	surface head shader jeff
	//$include models/human/heads/us_young_heads.tik

	path models/gear/g_headgear
	skelmodel ssncocap.skd			//crusher hat model
	surface ssncocap shader crusher_heer	//feldgrau Heer crusher texture

	path models/human/hands
	skelmodel hand.skd
	surface hand shader knitgloves1

	

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster
	}

	//*** p-38 pistol
	case weapon  "Walter P38"
	{
		
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

	}

	//*** MP40 submachinegun
	case weapon "MP40"
	{
		
		
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

	}
//*** end weapon equipment assignment
//************************************


	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		american
		health 100
		weapon "Walter P38"
	}
}

//
// include the base animations definition
//

$include models/human/animation/dialogue/generic_dialogue_US.tik
$include models/human/new_generic_human.tik



/*QUAKED ai_allied_oss-man_disguised (1.0 0.5 0.0) (-16 -16 0) (16 16 96)
*/