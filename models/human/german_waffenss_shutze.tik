TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

	path models/human/german_waffenss_shutze
	skelmodel waffen_ss_shutze.skd

	surface pants shader shutzpants
	surface pants shader shutzpants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader shutzpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader shutzpants_blood3	// HZM coop - gore tier1e (gib)
	surface tunic shader shutzshirt
	surface tunic shader shutzshirt_blood1	// HZM coop - gore tier 1 (light)
	surface tunic shader shutzshirt_blood2	// HZM coop - gore tier 1 (heavy)
	surface tunic shader shutzshirt_blood3	// HZM coop - gore tier1e (gib)
      	surface tunic_cull shader shutzshirt_cull
      	surface tunic_cull shader shutzshirt_cull_blood1	// HZM coop - gore tier 1 (light)
      	surface tunic_cull shader shutzshirt_cull_blood2	// HZM coop - gore tier 1 (heavy)
      	surface tunic_cull shader shutzshirt_cull_blood3	// HZM coop - gore tier1e (gib)


//	path models/human/heads
//	skelmodel head1.skd
//	surface head shader dolf
	$include models/human/heads/german_young_heads.tik


	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster

		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader sidecap_ss_olive
	}

	//*** p-38 pistol
	case weapon "Walter P38"
	{
		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader sidecap_ss_olive

		path models/gear/ss

		skelmodel ssholster.skd
		surface ssholster shader german_holster


	}

	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{
		//path models/gear/g_headgear
		//skelmodel coveredhelmet.skd
		//surface outside shader camohelm
		//surface inside shader german-helmet_inside

		path models/gear/g_headgear
		skelmodel coveredhelm_new.skd
		surface camocover shader helmet_covered_ss
		surface inside shader german-helmet_inside

		path models/gear/ss

		skelmodel sskarclips.skd
		surface sskarclips shader german_riflebelt

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss

		path models/gf
		skelmodel ghandgranade.skd
		surface ghandgranade shader ghandgranadegf

	}

	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{
		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader sidecap_ss_olive

		path models/gear/ss

		skelmodel sskarclips.skd
		surface sskarclips shader german_riflebelt

	}
	

	//*** MP40 submachinegun
	case weapon "MP40"
	{
		//path models/gear/g_headgear
		//skelmodel coveredhelmet.skd
		//surface outside shader camohelm
		//surface inside shader german-helmet_inside

		path models/gear/g_headgear
		skelmodel coveredhelm_new.skd
		surface camocover shader helmet_covered_ss
		surface inside shader german-helmet_inside

		path models/gear/ss

		skelmodel ssloadout.skd
		surface ssloadout shader german_gear


		skelmodel ssmp40clips.skd
		surface ssmp40clips shader ammo_pouch_tan

	}

	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{
		//path models/gear/g_headgear
		//skelmodel coveredhelmet.skd
		//surface outside shader camohelm
		//surface inside shader german-helmet_inside

		path models/gear/g_headgear
		skelmodel coveredhelm_new.skd
		surface camocover shader helmet_covered_ss
		surface inside shader german-helmet_inside

		path models/gear/ss

		skelmodel ssmp44clips.skd
		surface ssmp44clips shader mp44pouch_green

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss

		path models/gf
		skelmodel ghandgranade.skd
		surface ghandgranade shader ghandgranadegf

	}

	//*** panzerschrek
	case weapon "Panzerschrek"
	{
		path models/gear/g_headgear

		skelmodel hat.skd
       		surface hat shader hat_ssolive

		path models/gear/ss

		skelmodel ssholster.skd
		surface ssholster shader german_holster

		path models/gear/heer

		skelmodel loadout.skd
		surface loadout shader gear_ss

	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{
		//path models/gear/g_headgear
		//skelmodel coveredhelmet.skd
		//surface outside shader camohelm
		//surface inside shader german-helmet_inside

		path models/gear/g_headgear
		skelmodel coveredhelm_new.skd
		surface camocover shader helmet_covered_ss
		surface inside shader german-helmet_inside
		
		path models/gear/dak
		
		skelmodel dakholster.skd
		surface dakholster shader german_holster

		skelmodel dakgloadout.skd
		surface shells shader grenadier_shells
		surface ammobox shader grenadier_ammobox
	}

//*** end weapon equipment assignment
//************************************


	





	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 100
		weapon "Mauser KAR 98K"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_sshelmet_camo.tik" 150 0.1 "outside" "inside"  
	}
}

//
// include the base animations definition
//

$include models/human/animation/dialogue/generic_dialogue_german.tik
$include models/human/new_generic_human.tik
//$include models/human/animation/dialogue/M3L1_dialogue_german.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_sscovered.tik

