TIKI
setup
{
	scale 0.52
	path models/human/allied_army_soldier	// Set path to set skelmodel from
	skelmodel usarmy.skd			// Set body model

	surface ranger_pants shader hbtpants
	surface ranger_pants shader HBTpants_blood1	// HZM coop - gore tier 1 (light)
	surface ranger_pants shader HBTpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface ranger_pants shader HBTpants_blood3	// HZM coop - gore tier1e (gib)
	surface us_top shader ranger_jacket2
	surface us_top shader ranger_jacket2_blood1	// HZM coop - gore tier 1 (light)
	surface us_top shader ranger_jacket2_blood2	// HZM coop - gore tier 1 (heavy)
	surface us_top shader ranger_jacket2_blood3	// HZM coop - gore tier1e (gib)
	surface armband shader ranger_pfc
	surface us_top_c shader ranger_jacket2
	surface us_top_c shader ranger_jacket2_blood1	// HZM coop - gore tier 1 (light)
	surface us_top_c shader ranger_jacket2_blood2	// HZM coop - gore tier 1 (heavy)
	surface us_top_c shader ranger_jacket2_blood3	// HZM coop - gore tier1e (gib)

//	path models/human/heads			// Set new path for head model
//	skelmodel head4.skd			// Set head model
//	surface head shader slick_dirty
	$include models/human/heads/us_young_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/usgear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** colt 45 pistol
	case weapon "colt 45"
	{
		path models/equipment/USGear/helmets

		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us
	
		skelmodel 45holster.skd
		surface 45holster shader 45holster

		skelmodel haversack.skd
		surface haversack shader usequip

		path models/gear
	
		skelmodel ranger_knife.skd
		surface ranger_knife shader r_knife

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left
	}

	//*** m1 garand rifle
	case weapon "m1 garand"
	{
		path models/equipment/USGear/helmets

		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us

		skelmodel haversack.skd
		surface haversack shader usequip

		skelmodel garandbelt.skd
		surface garandbelt shader usammobelt

		path models/gear

		//skelmodel ranger_knife.skd
		//surface ranger_knife shader r_knife
	
		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

	}
	
	//*** springfield rifle
	case weapon "springfield '03 sniper"
	{
		path models/equipment/USGear/helmets

		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us

		//skelmodel haversack.skd
		//surface haversack shader usequip

		skelmodel garandbelt.skd
		surface garandbelt shader usammobelt

		path models/gear

		skelmodel ranger_knife.skd
		surface ranger_knife shader r_knife
	
		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left
	}

	//*** thompson
	case weapon "thompson"
	{
		path models/equipment/USGear/helmets
		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us

		skelmodel haversack.skd
		surface haversack shader usequip

		skelmodel rangertommybelt.skd
		surface tommybelt shader tommybelt

		path models/gear

		//skelmodel ranger_knife.skd
		//surface ranger_knife shader r_knife
	
		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left
	}

	//*** bar machinegune
	case weapon "bar"
	{
		path models/equipment/USGear/helmets

		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us

		//skelmodel haversack.skd
		//surface haversack shader usequip

		skelmodel barbelt.skd
		surface barbelt shader barbelt

		path models/gear

		skelmodel ranger_knife.skd
		surface ranger_knife shader r_knife

		skelmodel 101_granade.skd
		surface 101_granade shader 101_grenade
	}
	
	//*** bazooka
	case weapon "bazooka"
	{
		path models/equipment/USGear/helmets

		skelmodel us_helmet.skd
		surface us_helmet shader us-helmet_private_net

		path models/gear/us

		skelmodel haversack.skd
		surface haversack shader usequip

		skelmodel garandbelt.skd
		surface garandbelt shader usammobelt

		path models/gear

		//skelmodel ranger_knife.skd
		//surface ranger_knife shader r_knife

		skelmodel 101_granade.skd
		surface 101_granade shader 101_grenade
	}

//*** end weapon equipment assignment
//************************************


	

	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
      	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"

		// Make him capable of breathing steam
		exec global/breathe.scr 0 0

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_ranger_private.tik

