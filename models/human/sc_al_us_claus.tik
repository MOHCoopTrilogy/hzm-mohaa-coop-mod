TIKI
setup
{
	path models/human/french_resistance	// Set path to set skelmodel from
	skelmodel resistance.skd			// Set body model

	surface pants shader brownpants
	surface pants shader brownpants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader brownpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader brownpants_blood3	// HZM coop - gore tier1e (gib)
	surface cullpants shader cull_brownpants
	surface cullpants shader cull_brownpants_blood1	// HZM coop - gore tier 1 (light)
	surface cullpants shader cull_brownpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullpants shader cull_brownpants_blood3	// HZM coop - gore tier1e (gib)
	surface shirt shader browncoat
	surface shirt shader browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface shirt shader browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface shirt shader browncoat_blood3	// HZM coop - gore tier1e (gib)
	surface cullshirt shader cull_browncoat
	surface cullshirt shader cull_browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface cullshirt shader cull_browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullshirt shader cull_browncoat_blood3	// HZM coop - gore tier1e (gib)
	surface inside shader browncoat

	path models/human/heads
	skelmodel head4.skd
	surface head shader claus

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
}

init
{
	server
	{
      	classname Actor
   	   	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

