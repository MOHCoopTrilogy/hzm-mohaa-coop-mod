// [user 08-02] SHIPPED BY THE COOP MOD ON PURPOSE - do not delete.
// This is Spearhead's level_t3l1.tik, extracted verbatim from mainta/pak1.pk3 (5847B).
// Breakthrough's maintt/pak1.pk3 ships a 1629B STUB of the same path that lacks the four
// 31R###_idle01 anims. We launch with com_target_game 2, so the mount order is
// main -> mainta -> maintt and the BT stub WINS - which stripped the anims off all four
// Soviet actors on t3l1 ('unknown animation 31R100_idle01 in soviet_infantry1.tik').
// The VO for that scene is emitted by client anim commands ON these anims, so losing them
// meant no dialogue at all, and gags/t3l1_fourrussians.scr::DoRussians aborted on the
// failed PlayAnim - taking the whole objective chain with it.
// Our pk3 sorts last (zzzzzz_), so shipping it here wins over the stub.
// A full sweep of every models/human/animation/scripted/*.tik found this is the ONLY file
// where the winning pak ships a smaller stub - it is an isolated retail packaging bug.
animations // Now list all of the animations and any special commands for them
{
$path models/human/animation/scripted/t3l1

	//===========================
	//	tank with 4 germans on it
	//===========================

	31P001_Tank		31P001_Tank.skc
	
	//===========================
	//	German01 on tank
	//===========================

	31G101_German01Idle	31G101_German01Idle.skc
	31G102_German01JumpOff	31G102_German01JumpOff.skc
	{
		client		
		{
			4 sound movement
			18 sound movement
			45 sound movement	
		}
	}

	31G103_German01Death	31G103_German01Death.skc
	{
		client		
		{
			13 bodyfall
	
		}
	}
	31G104_DeathLoop	31G104_DeathLoop.skc


