animations
{
	$path models/human/animation

	//----------------------------------------------------------------
	// HZM COOP MOD - kneeling "tending the wounded" medic gesture.
	//
	// coop_medic_kneel maps the D-Day mission medic clip (medic01.skc,
	// the kneeling soldier aiding a downed comrade from m3l1a) to a
	// global label so the paradrop medic can kneel beside a downed /
	// wounded player. The source clip has ZERO root translation, so the
	// actor kneels exactly where it stands. The .skc lives in main/Pak0
	// (loads on every AA map). No prop is attached by this clip.
	//----------------------------------------------------------------

	coop_medic_kneel		scripted/level_m3l1/medic01.skc
	coop_medic_kneel_alt		scripted/level_m3l1/medic02.skc
}
