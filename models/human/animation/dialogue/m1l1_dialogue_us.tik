// HZM coop (bug-1212) - RETAIL DATA DEFECT WORKAROUND, same class and same map as bug-1162.
//
// ACTOR_m1l1_add11.skc and ACTOR_m1l1_add13.skc (retail, main/Pak0.pk3) each declare the channel
// 'Base head pos' TWENTY-ONE times. A duplicated channel makes the skeletor bind the same bone
// repeatedly and leaves the rest of the skeleton unposed, which renders as the contorted/mangled
// bodies reported on m1l1. The identical defect in truck_idle_guy01/truck_twitch_guy01 was worked
// around in bug-1162 by pointing the caller at a clean sibling animation; this does the same for
// the two DIALOGUE animations, which is why the corruption followed the privates OUT of the truck.
//
// Both affected lines are spoken BY A PRIVATE TO THE CAPTAIN ("He's taking too long." / "He's not
// taking them Captain") - the captain never plays either, which is exactly why he renders correctly
// while all three privates do not.
//
// Only the .skc is swapped. The 'first sound dfr_M1L1_addNN' lines are untouched, so the spoken
// dialogue is unchanged - just the body animation now comes from a clean, non-duplicated file
// (add12/add14, adjacent lines in the same conversation, verified 0 duplicate channels).
// The underlying retail .skc files are still corrupt; this is a data override, not an asset fix.

setup
{
	path models/human/animation/dialogue/M1L1/A
}

animations
{	
//	$mapspec M1L1
//	{


			/////////////////////////////////////////////////////////////////////////////
			////////////////////////////    new animations    ///////////////////////////
			/////////////////////////////////////////////////////////////////////////////


			////// BRIEFING IN TRUCK ///////


	FULLBODY_m1l1_101		ACTOR_m1l1_101.skc
	{
		client			/// Okay squad listen up. This is a rescue mission, so watch your fire and don't give your position away.
		{
			first sound dfr_M1L1_101j
		}
	}

	
	dfr_M1L1_add02		ACTOR_m1l1_add02.skc
	{

		server
		{
			// Change weapon to left hand - there is some swapping involved as he moves it around
			12	weaponcommand mainhand attachtohand offhand
			61	weaponcommand mainhand attachtohand mainhand
		}

		client			/// Everyone keep quiet.  This had better work.
		{
			first sound dfr_M1L1_add02
		}
	}

	dfr_M1L1_add05		ACTOR_m1l1_add05.skc
	{
		client			/// Powell, check the door
		{
			first sound dfr_M1L1_add05
		}
	}

	dfr_M1L1_add06		ACTOR_m1l1_add06.skc
	{
		client			/// What was that? I think I heard something
		{
			first sound dfr_M1L1_add06
		}
	}

	dfr_M1L1_add07		ACTOR_m1l1_add07.skc
	{
		client			/// Ambush!
		{
			first sound dfr_M1L1_add07
		}
	}

	dfr_M1L1_add08		ACTOR_m1l1_add08.skc
	{
		client			/// Make a run for it Powell, I'll cover you
		{
			first sound dfr_M1L1_add08
		}
	}

	dfr_M1L1_add09		ACTOR_m1l1_add09.skc
	{
		client			/// Get going
		{
			8 sound dfr_M1L1_add09
		}
	}

	dfr_M1L1_add10		ACTOR_m1l1_add10.skc
	{
		client			/// I got you covered.  Move!
		{
			first sound dfr_M1L1_add10
		}
	}

	dfr_M1L1_add11		ACTOR_m1l1_add12.skc	// HZM bug-1212: was ACTOR_m1l1_add11.skc (Base head pos x21)
	{
		client			/// He's taking too long.
		{
			first sound dfr_M1L1_add11
		}
	}

	dfr_M1L1_add12		ACTOR_m1l1_add12.skc
	{
		client			/// He's buying it, just hold on.
		{
			first sound dfr_M1L1_add12
		}
	}

	dfr_M1L1_add13		ACTOR_m1l1_add14.skc	// HZM bug-1212: was ACTOR_m1l1_add13.skc (Base head pos x21)
	{
		client			/// He's not taking them Captain
		{
			first sound dfr_M1L1_add13
		}
	}

	dfr_M1L1_add14		ACTOR_m1l1_add14.skc
	{
