TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

	path models/human/german_hund_hundpatrol
	skelmodel hund.skd

	surface coat shader mantel
	surface coat shader mantel_blood1	// HZM coop - gore tier 1 (light)
	surface coat shader mantel_blood2	// HZM coop - gore tier 1 (heavy)
	surface coat shader mantel_blood3	// HZM coop - gore tier1e (gib)
	surface cullcoat shader mantel
	surface cullcoat shader mantel_blood1	// HZM coop - gore tier 1 (light)
	surface cullcoat shader mantel_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullcoat shader mantel_blood3	// HZM coop - gore tier1e (gib)
	surface pants shader wehrmact_pants_fgrey
	surface pants shader wehrmact_pants_fgrey_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader wehrmact_pants_fgrey_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader wehrmact_pants_fgrey_blood3	// HZM coop - gore tier1e (gib)

	//$include models/human/heads/german_young_heads.tik

	$include models/human/heads/german_winter_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader knitgloves1
	surface hand shader knitgloves1	// HZM coop - gore tier 1 (light)
	surface hand shader knitgloves1_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader knitgloves1_blood3	// HZM coop - gore tier1e (gib)

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
//		path models/human/german_hund_hundpatrol
//		skelmodel hund.skd

//		surface coat shader hundpatrol_coat
//		surface cullcoat shader cull_hundpatrol_coat
//		surface pants shader hundpants

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/dak
		
		skelmodel dakholster.skd
		surface dakholster shader german_holster

		skelmodel dakgloadout.skd
		surface shells shader grenadier_shells
		surface ammobox shader grenadier_ammobox

	}

	//*** p-38 pistol
	case weapon "walter p38"
	{

		path models/gear/heer
		skelmodel holster.skd
		surface holster shader german_holster

		path models/gear/g_headgear
		skelmodel creasecap.skd
		surface creasecap shader hundhat

	}

	//*** regular KAR 98
	case weapon "mauser kar 98k"
	{
		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/heer
		skelmodel karclips.skd
		surface karclips shader german_riflebelt

		path models/gear/winter

		skelmodel winterloadout.skd
		surface winterloadout shader german_gear

	}
	
	//*** KAR 98 sniper
	case weapon "mauser kar 98d sniper"
	{

		path models/gear/g_headgear

		skelmodel coveredhelmet.skd
		surface outside shader winterhelmet1
		surface inside shader german-helmet_inside

		path models/gear/heer
		skelmodel karclips.skd
		surface karclips shader german_riflebelt

	}

	//*** MP40 submachinegun
	case weapon "MP40"
	{

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelm_wint
		surface inside shader german-helmet_inside

		path models/gear/heer

		skelmodel mp40clip.skd
		surface mp40clip shader ammo_pouch_tan

		path models/gear/winter

		skelmodel winterloadout.skd
		surface winterloadout shader german_gear

	}

	
	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{
		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/heer

		skelmodel hmp44clips.skd
		surface hmp44clips shader mp44pouch_green

		path models/gf
		skelmodel ghandgranade.skd
		surface ghandgranade shader ghandgranadegf

		path models/gear/winter

		skelmodel winterloadout.skd
		surface winterloadout shader german_gear

	}


	//*** panzerschrek
	case weapon "Panzerschrek"
	{

		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader hundhat

		
	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{

		path models/gear/g_headgear

		skelmodel stahlhelm.skd
		surface outside shader heerhelmet
		surface inside shader german-helmet_inside

		path models/gear/dak
		
		skelmodel dakholster.skd
		surface dakholster shader german_holster

		skelmodel dakgloadout.skd
		surface shells shader grenadier_shells
		surface ammobox shader grenadier_ammobox
	}

//*** end weapon equipment assignment
//************************************

	

	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 100
		weapon "Mauser KAR 98K"

		// Make him breathe and mumble
		exec global/breathe.scr 1 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_helmet.tik" 150 0.1 "outside" "inside" 
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_german.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_wintercovered.tik

/*QUAKED ai_german_winter_type2 (1.0 0.5 0.0) (-16 -16 0) (16 16 92)
*/
