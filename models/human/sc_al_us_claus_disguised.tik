TIKI
setup
{
	path models/human/german_wehrmact_officer	// Set path to set skelmodel from
	skelmodel german_officer.skd			// Set body model

	path models/human/heads
	skelmodel head4.skd
	surface head shader claus

	surface tunic shader DAK_officer_tunic
	surface tunic shader DAK_officer_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface tunic shader DAK_officer_tunic_blood2	// HZM coop - gore tier 1 (heavy)
	surface tunic shader DAK_officer_tunic_blood3	// HZM coop - gore tier1e (gib)
	surface pants shader DAK_officer_pants
	surface pants shader DAK_officer_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader DAK_officer_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader DAK_officer_pants_blood3	// HZM coop - gore tier1e (gib)
	surface tunic_c shader DAK_officer_tunic_c
	surface tunic_c shader DAK_officer_tunic_c_blood1	// HZM coop - gore tier 1 (light)
	surface tunic_c shader DAK_officer_tunic_c_blood2	// HZM coop - gore tier 1 (heavy)
	surface tunic_c shader DAK_officer_tunic_c_blood3	// HZM coop - gore tier1e (gib)

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew
	surface hand shader handsnew_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)


	path models/equipment/germangear

	skelmodel officer_hat.skd
	surface officer_hat shader dak_officer_hat

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/germangear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** p-38 pistol
	case weapon  "Walter P38"
	{
		path models/gear/g_headgear

		skelmodel officercap.skd
		surface officercap shader dak_officer_hat
		

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster
	}

	//*** MP40 submachinegun
	case weapon "MP 40"
	{
		path models/gear/g_headgear

		skelmodel officercap.skd
		surface officercap shader dak_officer_hat

		
		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader ammo_pouch_tan
	}

//*** end weapon equipment assignment
//************************************





	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
}

init
{
	server
	{
      	classname Actor
   	   	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

