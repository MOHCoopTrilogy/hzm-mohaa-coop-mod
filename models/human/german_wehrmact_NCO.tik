TIKI
setup
{
	scale 0.52					// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's

//	path models/human/german_wehrmact_soldier
//	skelmodel heerprivate.skd

//	surface wehrmact_pants shader wehrmact_pants
//	surface wehrmact_tunic shader wehrmacht_nco
//	surface wehrmact_tunic_c shader wehrmacht_nco
	
	
//	path models/human/heads
//	skelmodel head4.skd
//	surface head shader roml
	$include models/human/heads/german_old_heads.tik	//models/human/heads/german_old_heads.tik

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here


	//*** no weapon assigned
	case weapon "none"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_field_cap
	}

	//*** p-38 pistol
	case weapon "Walter P38"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel creasecap.skd
		surface creasecap shader hundhat
		

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader mapholder

	}

	//*** regular KAR 98
	case weapon "Mauser KAR 98K"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_field_cap

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		skelmodel karclips.skd
		surface karclips shader german_riflebelt

	}
	
	//*** KAR 98 sniper
	case weapon "Mauser KAR 98D Sniper"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmacht_pants_camo2
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmacht_pants_camo2_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet2
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_hat_camo2

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster


		
	}
	
	//*** MP40 submachinegun
	case weapon "MP40"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_field_cap

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		path models/gear/officer
		
		skelmodel holster.skd
		surface holster shader german_holster

		skelmodel mp40clips.skd
		surface mp40clips shader ammo_pouch

	}
	
	//*** mp44 / stg44 machinegun
	case weapon "StG44"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco_vet2
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_vet2_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_vet2_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel ssncocap.skd
		surface ssncocap shader crusher_heer

		path models/gear/heer
		
//		skelmodel loadout.skd
//		surface loadout shader german_gear

		skelmodel hmp44clips.skd
		surface hmp44clips shader mp44ammopouch



	}


	//*** panzerschrek
	case weapon "Panzerschrek"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco
		surface wehrmact_tunic shader wehrmacht_nco_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco
		surface wehrmact_tunic_c shader wehrmacht_nco_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_field_cap

		path models/gear/heer
		
		skelmodel loadout.skd
		surface loadout shader german_gear

		
	}
	
	//*** mg42 mounted machinegun
	case weapon "MG42"
	{
		path models/human/german_wehrmact_soldier
		skelmodel heerprivate.skd

		surface wehrmact_pants shader wehrmact_pants
		surface wehrmact_pants shader wehrmact_pants_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_pants shader wehrmact_pants_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_pants shader wehrmact_pants_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic shader wehrmacht_nco
		surface wehrmact_tunic shader wehrmacht_nco_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic shader wehrmacht_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic shader wehrmacht_nco_blood3	// HZM coop - gore tier1e (gib)
		surface wehrmact_tunic_c shader wehrmacht_nco
		surface wehrmact_tunic_c shader wehrmacht_nco_blood1	// HZM coop - gore tier 1 (light)
		surface wehrmact_tunic_c shader wehrmacht_nco_blood2	// HZM coop - gore tier 1 (heavy)
		surface wehrmact_tunic_c shader wehrmacht_nco_blood3	// HZM coop - gore tier1e (gib)

		path models/gear/g_headgear

		skelmodel hat.skd
		surface hat shader heer_field_cap

		path models/gear/dak
		
		skelmodel dakholster.skd
		surface dakholster shader german_holster

		skelmodel dakgloadout.skd
		surface shells shader grenadier_shells
		surface ammobox shader grenadier_ammobox
	}

//*** end weapon equipment assignment
//************************************

	

	


	scale 0.52				// Set default scale to 16/30.5 since world is 
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
     		classname Actor
		setsize "-16 -16 0" "16 16 92"
		german
		health 125
		weapon "MP40"

		// Make him mumble but not breathe steam
		exec global/breathe.scr 0 1

		// Set up the helmet for popping off
		// <surface to turn off> <model to spawn> <speed to throw it at> <damage multiplier for helmet shots>
		sethelmet "models/gear/german_ncocap.tik" 200 4 "hat" 
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_german.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_german_nco.tik



