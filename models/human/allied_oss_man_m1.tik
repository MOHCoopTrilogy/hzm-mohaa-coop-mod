TIKI
// this is the OSS man from M1L2 and M1L3
// used for mission 1
//made by z


setup
{
	scale 0.52
	path models/human/french_resistance	// Set path to set skelmodel from
	skelmodel resistance.skd			// Set body model

	surface pants shader brownpants
	surface pants shader brownpants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader brownpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader brownpants_blood3	// HZM coop - gore tier1e (gib)
	surface cullpants shader cull_brownpants
	surface cullpants shader cull_brownpants_blood1	// HZM coop - gore tier 1 (light)
	surface cullpants shader cull_brownpants_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullpants shader cull_brownpants_blood3	// HZM coop - gore tier1e (gib)
	surface shirt shader browncoat
	surface shirt shader browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface shirt shader browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface shirt shader browncoat_blood3	// HZM coop - gore tier1e (gib)
	surface cullshirt shader cull_browncoat
	surface cullshirt shader cull_browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface cullshirt shader cull_browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullshirt shader cull_browncoat_blood3	// HZM coop - gore tier1e (gib)
	surface inside shader browncoat

	path models/human/heads			// Set new path for head model
	skelmodel head2.skd			// Set head model
	surface head shader jeff_c
	surface head shader jeff_c	// HZM coop - gore tier 1 (light)
	surface head shader jeff_c_skin2	// HZM coop - gore tier 1 (heavy)
	surface head shader jeff_c_blood3	// HZM coop - gore tier1e (gib)

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	//path models/equipment/USGear/helmets

	//skelmodel us_helmet.skd
	//surface us_helmet shader us-helmet_private

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/usgear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** colt 45 pistol
	case weapon "colt 45"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** m1 garand rifle
	case weapon "m1 garand"
	{
		//skelmodel k98clips.skd
		//surface k98clips shader german_riflebelt
	}
	
	//*** springfield rifle
	case weapon "springfield '03 sniper"
	{
		//skelmodel k98clips.skd
		//surface k98clips shader german_riflebelt
	}

	//*** bar machinegune
	case weapon "bar"
	{
		//skelmodel mp40clips.skd
		//surface mp40clips shader ammo_pouch_tan
	}
	
	//*** bazooka
	case weapon "bazooka"
	{
		//skelmodel mp40clips.skd
		//surface mp40clips shader ammo_pouch_tan
	}
//*** end weapon equipment assignment
//************************************


	

	

	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
      	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik


