TIKI
setup
{
	scale 0.52
	path models/human/SC_AX_Ital_Vol	// Set path to set skelmodel from
	skelmodel It_AX_Ital_Vol.skd		// Set body model

	surface Tunic   shader sc_AX_Ital_Vol_tunic
	surface Tunic shader sc_AX_Ital_Vol_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface Tunic shader sc_AX_Ital_Vol_tunic_blood2	// HZM coop - gore tier 1 (heavy)
	surface Tunic shader sc_AX_Ital_Vol_tunic_blood3	// HZM coop - gore tier1e (gib)
	surface Pants   shader sc_AX_Ital_Vol_Pant
	surface Pants shader sc_AX_Ital_Vol_Pant_blood1	// HZM coop - gore tier 1 (light)
	surface Pants shader sc_AX_Ital_Vol_Pant_blood2	// HZM coop - gore tier 1 (heavy)
	surface Pants shader sc_AX_Ital_Vol_Pant_blood3	// HZM coop - gore tier1e (gib)

	//path models/human/heads
	//skelmodel head1.skd
	//surface head shader jeff
        $include models/human/heads/it_young_heads.tik

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew_blood1	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_blood2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	// HELMET
	// =======================================================
	path models/equipment/italiangear
	skelmodel ax_it_volhat.skd
	surface ax_ital_volhat shader AX_Ital_Vol_Hat

	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// defines size of shadow
}

init
{
	server
	{
      	classname Actor
   	   	german
		nationality it
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "Carcano"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		// sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/Generic_dialogue_Italian.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

