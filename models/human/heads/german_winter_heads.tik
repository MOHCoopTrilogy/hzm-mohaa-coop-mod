	surface head shader hans_blood3	// HZM coop - gore tier1e (gib)

	case headmodel head1
	{
		skelmodel head1.skd
	}
	case headmodel head2
	{
		skelmodel head2.skd
	}
	case headmodel head4 // head4 is not allowed with this skin
	{
		skelmodel head3.skd
	}
	case headmodel head5 // head5 is not allowed with this skin
	{
		skelmodel head6.skd
	}
	case headmodel head6
	{
		skelmodel head6.skd
	}
	case headmodel head7
	{
		skelmodel head7.skd
	}
	case headmodel head8
	{
		skelmodel head8.skd
	}
}

