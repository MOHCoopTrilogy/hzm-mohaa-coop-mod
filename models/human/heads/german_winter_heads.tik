	surface head shader dominik
	surface head shader dominik	// HZM coop - gore tier1e (clean pad - keeps the gib skin at index 3)
	surface head shader dominik	// HZM coop - gore tier1e (clean pad - keeps the gib skin at index 3)
	surface head shader dominik_blood3	// HZM coop - gore tier1e (gib)

	case headmodel head1
	{
