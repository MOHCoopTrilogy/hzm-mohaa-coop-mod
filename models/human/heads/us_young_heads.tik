path models/human/heads

// Skins allowed:
// bensonazi, bignose, gunter, slick, srg, tom,
// us_north, us_thomas, us_z, us_j, us_senn, us_powzer, us_mike, 
// us_chance, us_bob, us_dave

// Heads allowed:
// 1, 2, 4, 5, 6, 7, 8

case headskin us_north
{
	surface head shader us_north
	surface head shader us_north	// HZM coop - gore tier1e (clean pad - keeps the gib skin at index 3)
	surface head shader us_north	// HZM coop - gore tier1e (clean pad - keeps the gib skin at index 3)
	surface head shader us_north_blood3	// HZM coop - gore tier1e (gib)

	case headmodel head1
	{
		skelmodel head1.skd
	}
	case headmodel head2
	{
		skelmodel head2.skd
	}
	case headmodel head4	
	{
		skelmodel head4.skd
	}
	case headmodel head5	
	{
		skelmodel head5.skd
	}
	case headmodel head6
	{
		skelmodel head6.skd
	}
	case headmodel head7
	{
		skelmodel head7.skd
	}
	case headmodel head8
	{
		skelmodel head8.skd
	}
}

