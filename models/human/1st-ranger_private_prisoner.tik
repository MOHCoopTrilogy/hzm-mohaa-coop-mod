TIKI
setup
{
	scale 0.52
	path models/human/allied_army_soldier	// Set path to set skelmodel from
	skelmodel usarmy.skd			// Set body model

	surface ranger_pants shader ranger_pants
	surface ranger_pants shader ranger_pants_blood1	// HZM coop - gore tier 1 (light)
	surface ranger_pants shader ranger_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface ranger_pants shader ranger_pants_blood3	// HZM coop - gore tier1e (gib)
	surface us_top shader army_jacket
	surface us_top shader army_jacket_blood1	// HZM coop - gore tier 1 (light)
	surface us_top shader army_jacket_blood2	// HZM coop - gore tier 1 (heavy)
	surface us_top shader army_jacket_blood3	// HZM coop - gore tier1e (gib)
	surface armband shader army_blank
	surface us_top_c shader army_jacket
	surface us_top_c shader army_jacket_blood1	// HZM coop - gore tier 1 (light)
	surface us_top_c shader army_jacket_blood2	// HZM coop - gore tier 1 (heavy)
	surface us_top_c shader army_jacket_blood3	// HZM coop - gore tier1e (gib)

	path models/human/heads			// Set new path for head model
	skelmodel head4.skd			// Set head model
	surface head shader paul_dirty
	surface head shader paul_dirty	// HZM coop - gore tier 1 (light)
	surface head shader paul_dirty_skin2	// HZM coop - gore tier 1 (heavy)
	surface head shader paul_dirty_blood3	// HZM coop - gore tier1e (gib)
//	$include models/human/heads/us_young_heads.tik

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)


//	path models/equipment/USGear/helmets
//	skelmodel us_helmet.skd
//	surface us_helmet shader us-helmet_29th


	scale 0.52				// Set default scale to 16/30.5 since world is
						// in 16 units per foot and model is in cm's
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// Defines size of shadow
}

init
{
	server
	{
      	classname Actor
      	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		//weapon "M1 Garand"
	}
}

//
// include the base animations definition
//

$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/helmet_flyoff/helmet_flyoff_ranger_private.tik

