TIKI
setup
{
	scale 0.52
	path models/human/allied_airborne	// Set path to set skelmodel from
	skelmodel airborne.skd		// Set body model

	surface shirt shader airborne_top
	surface shirt shader airborne_top_blood1	// HZM coop - gore tier 1 (light)
	surface shirt shader airborne_top_blood2	// HZM coop - gore tier 1 (heavy)
	surface shirt shader airborne_top_blood3	// HZM coop - gore tier1e (gib)
	surface pants shader airborne_pants
	surface pants shader airborne_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader airborne_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader airborne_pants_blood3	// HZM coop - gore tier1e (gib)
	surface sleeve shader airborne_top_cull
	surface sleeve shader airborne_top_cull_blood1	// HZM coop - gore tier 1 (light)
	surface sleeve shader airborne_top_cull_blood2	// HZM coop - gore tier 1 (heavy)
	surface sleeve shader airborne_top_cull_blood3	// HZM coop - gore tier1e (gib)

//	path models/human/heads			// Set new path for head model
//	skelmodel head2.skd		// Set head model
//	surface head shader srg_dirty
	$include models/human/heads/us_young_heads.tik

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew
	surface hand shader handsnew	// HZM coop - gore tier 1 (light)
	surface hand shader handsnew_skin2	// HZM coop - gore tier 1 (heavy)
	surface hand shader handsnew_blood3	// HZM coop - gore tier1e (gib)

	path models/equipment/USGear/airborne
	skelmodel airborne_gear.skd
	surface gear shader airborne_gear


	path models/equipment/USGear/helmets
	skelmodel us_helmet.skd
	surface us_helmet shader air_helm

	path models/gear
	skelmodel dmedipack.skd
	surface dmedipack shader coop_dmedipack	// HZM bug-922: fresh un-contested shader name + private texture path - the dday_medipack-1 def never reached this surface at runtime despite 4 rounds of shader-file fixes
	
	//path models/gear
	//skelmodel bob_helmet_camo.skd
	//surface bob_helmet_camo shader dday_camo_hel

	//skelmodel us_helmet_inside.skd
	//surface us_helmet_inside shader helmet_inside_bob

	//path models/equipment/USGear/helmets
	//skelmodel us_helmet.skd
	//surface us_helmet shader pvt_helmet_camo

	

//************************************
//*** weapon equipment assignment - Justin modify the equipment skelmodels in here
	path models/equipment/usgear

	//*** no weapon assigned
	case weapon "none"
	{
		//skelmodel german_holster.skd
		//surface german_holster shader german_holster
	}

	//*** colt 45 pistol
	case weapon "colt 45"
	{
		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife
	}

	//*** m1 garand rifle
	case weapon "m1 garand"
	{

		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife

	}
	
	//*** springfield rifle
	case weapon "springfield '03 sniper"
	{
		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife
	}

	//*** thompson
	case weapon "thompson"
	{
		path models/gear/ss
		skelmodel ssmp40clips.skd
		surface ssmp40clips shader tommypouch

		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife
	}

	//*** bar machinegune
	case weapon "bar"
	{

		path models/gear/us

		skelmodel barbelt.skd
		surface barbelt shader barbelt

		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel ranger_2grenades.skd
		surface 2gren_right shader 2gren_right
		surface 2gren_left shader 2gren_left

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife
	}
	
	//*** bazooka
	case weapon "bazooka"
	{
		path models/gear/us
	
		skelmodel rangertommybelt.skd
		surface tommybelt shader tommybelt

		path models/gear
		skelmodel bob45holster.skd
		surface bob45holster shader bob45holster

		skelmodel 101_knife.skd
		surface 101_knife shader 101_knife
	}

//*** end weapon equipment assignment
//************************************


	

	scale 0.52				// Set default scale to 16/30.5 since world is
	path models/human/protoanimations	// Set path to set animations from

	radius 20				// defines size of shadow
}

init
{
	server
	{
      	classname Actor
   	   	american
		setsize "-16 -16 0" "16 16 92"
		health 100
		weapon "M1 Garand"

		// Set up the helmet for popping off
		// <model to spawn> <speed to throw it at> <damage multiplier for helmet shots> <surface(s) to turn off>
		//sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet" 	//helmet falloff must be deleted due to model's bug
	}
}

//
// include the base animations definition
//
$include models/human/new_generic_human.tik
$include models/human/animation/dialogue/generic_dialogue_US.tik
//$include models/human/animation/dialogue/m1l1_dialogue_us.tik

