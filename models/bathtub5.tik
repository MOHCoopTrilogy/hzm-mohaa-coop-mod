TIKI
setup
{
	scale .55			
	path models/renan_models
	skelmodel bathtub5.skd
	surface bathtub shader waw_bathtub1
	surface bathtub1 shader waw_bathtub1
	surface bathtub2 shader waw_bathtub1
	surface bathtub3 shader waw_bathtub1
	surface bathtub4 shader waw_bathtub1
	surface bathtub5 shader waw_bathtub1
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle     bathtub5.skc
}

