TIKI

setup
{
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{
	server
	{
	   classname ScriptModel
		rendereffects +dontdraw
		notsolid
	}

	client
	{
		settiki none
		aliascache ts_train_main sound/amb_amigos3d/Amb_fragnrock.wav soundparms 8.1 0.0 1.00 0.00 400 1700 auto loaded maps "obj/obj_Frag-n-Rock"
		aliascache ts_train_ding sound/amb_amigos3d/Amb_fragnrock2.wav soundparms 8.1 0.0 1.00 0.00 400 1300 auto loaded maps "obj/obj_Frag-n-Rock"
		// soundparms parameters are: <BaseVolume> <RandVolume> <BasePitch> <randPitch> <minDist> <maxDist> <Channel> <Loaded/Streamed> <Maps>
	}
}

animations
{
	idle     dummy3.skc
}