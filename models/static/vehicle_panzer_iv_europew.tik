TIKI
setup
{
	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/vehicles/panzer_iv
	skelmodel panzer_iv.skd
	surface tread shader panzer_iv_tread_eunw
	surface frontwheel shader panzer_iv_frontwheel_eunw
     	surface frontwheelband shader panzer_iv_frontwheelband_eunw
 	surface backwheel shader panzer_iv_backwheel_eunw
	surface backwheelband shader panzer_iv_backwheelband_eunw
	surface smallwheel shader panzer_iv_smallwheel_eunw
      	surface smallwheelband shader panzer_iv_smallwheelband_eunw
     	surface verysmallwheel shader panzer_iv_verysmallwheel_eunw
      	surface backwheelaxel shader panzer_iv_backwheelaxel_eunw
      	surface turret shader panzer_iv_turret_euw
      	surface boxes shader panzer_iv_boxes_euw
      	surface undercarriage shader panzer_iv_undercarriage_euw
}

animations
{
	idle     panzer_iv.skc
}

