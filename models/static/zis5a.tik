TIKI
setup
{
	scale 1.37			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
					// Convert from inches to game units
	path models/static/zis5a
	skelmodel zis5a.skd
	surface zis1 shader zis5a
	surface zis2 shader zis5a
	surface zis3 shader zis5a
	surface zis4 shader zis5a
	surface opeltreadstill shader zis5a
	surface opelhubstill shader zis5a
}

animations
{
	idle     zis5a.skc
}

