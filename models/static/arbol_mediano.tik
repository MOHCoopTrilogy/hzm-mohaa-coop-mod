TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/natural
	skelmodel tree_med.skd
	surface palm shader mohpa_trunk
	surface moss shader mohpa_thin_branch
	surface leaves22 shader mohpa_backwall_top

}

animations
{
	idle     tree_med.skc
}

