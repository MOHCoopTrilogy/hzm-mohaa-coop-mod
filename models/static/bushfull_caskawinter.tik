TIKI
setup
{
	//scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	scale 1
	path models/static/natural
	skelmodel bush_full.skd
	surface tree4_1 shader static_tree4_1winter
	surface tree4_2 shader static_tree4_2winter
	surface tree4_3 shader static_tree4_3winter
	surface tree4_4 shader static_tree4_4winter
}

animations
{
	idle     bush_full.skc
}

