TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
					// Convert from inches to game units
	path models/static/ventanas
	skelmodel ventana2.skd
	surface ventana shader ventanareja
}

animations
{
	idle     ventana2.skc
}

