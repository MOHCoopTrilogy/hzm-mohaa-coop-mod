TIKI
setup
{
	//scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	scale 2.5			// Convert from inches to game units
	path models/static/ba6
	skelmodel ba6-torre.skd
	surface torre shader ba6
}

animations
{
	idle     ba6-torre.skc
}

