TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/natural
	skelmodel tree_skinny.skd
	surface bushesball shader mohpa_tall_skinny
	surface trunk shader mohpa_tall_skinny_trunk
}

animations
{
	idle     tree_skinny.skc
}

