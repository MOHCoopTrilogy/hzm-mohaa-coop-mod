TIKI
setup
{
	scale 0.52				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/zis5
	skelmodel zis5.skd
	surface opel1 shader zis5
	surface opel3 shader zis5
	surface opel4 shader zis5
	surface opelhub shader opelhub_d
	surface opeltread shader opeltread_norotate
	surface opelwindows shader opelwindows_d
	surface dtruckwindow shader dtruckwindow
	surface dtruck3 shader Dtruck_rusted
	surface dtruck2 shader Dtruck_rusted
}

animations
{
	idle		     zis5.skc
}

