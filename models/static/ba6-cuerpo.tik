TIKI
setup
{
	//scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	scale 2.5			// Convert from inches to game units
	path models/static/ba6
	skelmodel ba6-cuerpo.skd
	surface delantera shader ba6
	surface trasera shader ba6
	surface reverso shader ba6
	surface delanteras shader ba6
	surface traseras shader ba6
	surface traseras1 shader ba6
}
init
{
	server
	{
		classname scriptmodel
	}
}
animations
{
	idle     ba6-cuerpo.skc
}

