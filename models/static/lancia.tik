TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
					// Convert from inches to game units
	path models/static/lancia
	skelmodel lancia.skd
	surface lancia1 shader lancia_cull
	surface lancia2 shader lancia_nocull
	surface lancia3 shader lancia_nocull
	surface lancia4 shader lancia_cull
}

animations
{
	idle     lancia.skc
}

