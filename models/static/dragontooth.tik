TIKI
setup
{
	scale 0.52			// cm -> game units (16/30.5), same as every retail static prop
	path models/static/dragontooth
	skelmodel dragontooth.skd
	surface dragontooth shader textures/general_structure/dragontooth128
}

animations
{
	idle     dragontooth.skc
}

// [user 07-29] Siegfried-Line anti-tank obstacle. MOHAA never shipped this as a MODEL - it exists
// only as BSP brushwork on m5l2a / m5l2b / obj_team1 / MP_Bahnhof_DM, which is why it could never
// be placed in build mode. Authored as a truncated square pyramid (92cm base, 34cm top, 112cm tall
// - a real tooth is ~1.1m) and pushed through code/tools/md5_2_skX to produce the skd + skc.
// Reuses the retail texture, so it matches the brushwork versions exactly.
/*QUAKED static_dragontooth (0.5 0.0 0.5) (-24 -24 0) (24 24 58)
*/
