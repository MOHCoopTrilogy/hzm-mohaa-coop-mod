TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/bandera
	skelmodel bandera.skd
	surface material1 shader neutral
}

animations
{
	idle     bandera.skc
}

