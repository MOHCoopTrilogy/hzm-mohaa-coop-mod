TIKI
setup
//TIKI MODIFIED BY [SNPT]Laurent _ U can use it as model without bugs now!
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/fan
	skelmodel bunkerfan.skd
	surface fan shader static_fan_movable
}

animations
{
	idle     bunkerfan.skc
}

