TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/static/natural
	skelmodel tree_common_fall_orange.skd
	surface tree1_1 shader static_common_fall_orange1_1
	surface tree1_2 shader static_common_fall_orange1_2
	surface tree1_3 shader static_common_fall_orange1_3
	surface tree1_4 shader static_common_fall_orange1_4
	surface tree1_5 shader static_common_fall_orange1_5
	surface tree1sprite shader static_common_fall_orange1sprite

	lod_scale 100 // to prevent the continous LOD system from messing with this model
}

animations
{
	idle     tree_common_fall_orange.skc
}

