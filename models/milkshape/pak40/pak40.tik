TIKI
setup
{
	scale 2.500000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/pak40
	skelmodel pak40.skd
      surface Material06_1 shader pak40_pak40-6
      surface Material07_1 shader pak40_pieds
      surface Material10_1 shader pak40_pak40-1
      surface Material04_1 shader pak40_pak40-4
      surface Material05_1 shader pak40_pak40-5
      surface Material03_1 shader pak40_pak40-3
      surface Material01_1 shader pak40_plaque
      surface Material08_1 shader pak40_canon
      surface Material02_1 shader pak40_pak40-2
}

animations
{
	idle     pak40.skc
}

