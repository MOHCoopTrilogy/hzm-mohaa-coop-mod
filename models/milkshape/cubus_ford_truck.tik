TIKI
setup
{
	scale 0.52
	path models/milkshape/cubus_ford_truck
	skelmodel cubus_ford_truck.skd
 	
	surface achse_h1 shader fordt_achse
	surface kabi1 shader fordt_kabi
	surface dashboard1 shader fordt_dash
	surface lenkrad1 shader fordt_lenkrad
	surface boden1 shader fordt_boden

	surface body1 shader fordt_body
	surface sitz1 shader fordt_sitz
	surface fenster1 shader fordt_glass
	surface profil_rrad1 shader fordt_profils
	surface rad_fs1 shader fordt_profils

	surface rad_fr1 shader fordt_profilr
	surface rad_ss1 shader fordt_rads
	surface rad_sr1 shader fordt_radr

}

init
{
	server
      	{
      		classname drivablevehicle
			//classname VehicleTankTandem
      		
      		//setsize "-60 -40 0" "60 40 120"
			setsize "-50 -40 0" "50 40 60"
			vehicleWheelCorners "140 140 78" "-8 -8 -1.5"
			vehicleinit jeep.tik
			vehiclespeed 1000
			vehiclemass 1500 // not used
			vehicletread 10 // not used
			vehicleradius 0.33
			vehiclerollingresistance 0.5 // not used
			vehicledrag 0.00001
			vehiclebouncy 0.2
			vehiclespringy 0.8
			turnrate 25
			//vehicleYaw -10 10
			//vehicleRoll -10 10
			//vehicleZ -5 10
			mass 1000

			//spawnturret 0 "models/milkshape/cubus_vietnam_M113_mg2.tik"
			//attachmodel "models/milkshape/cubus_vietnam_M113_mg2.tik" 1 turret0
		//AnimationSet "tank_"
		//SoundSet "tank_"

		AnimationSet "sdkfz_"
		SoundSet "sdkfz_"

			//////////////////////////////////////////
			// Pitch-Mod Sound for vehicles by speed
			//
			// Linearly Interpolates from the minimum pitch when the vehicle is at the minimum speed to 
			// the maximum pitch when the vehicle is at the maximum speed.
			//
			// Speed is in World Units.
			//
			//
			//                 +--------------- Minimum Speed
			//                 |  +------------ Minimum Pitch
			//                 |  |
			//                 |  |      +----- Maximum Speed
			//                 |  |      |  +-- Maximum Pitch
			//                 V  V      V  V
			setsoundparameters 0 0.95   200 1	

			surface rad_fs1 +nodraw
			surface rad_ss1 +nodraw
			
	}
}

animations
{
	idle 			cubus_ford_truck.skc

}


