TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/Bottle
	skelmodel Bottle.skb
      surface bottle shader Bottle_bottle
}

animations
{
	idle     Bottle.skc
}

