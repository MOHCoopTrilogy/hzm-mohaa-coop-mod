TIKI
setup
{
	scale 4.500000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/kubelwagen
	skelmodel kubelwagen.skb
      surface arriere shader kubelwagen_arriere
      surface tableau shader kubelwagen_tableaubord
      surface phares shader kubelwagen_phare
      surface parebrise shader kubelwagen_kubel1
      surface sieges shader kubelwagen_sieges
      surface roues shader kubelwagen_roues
      surface roues02 shader kubelwagen_tranchesroues
      surface dessus shader kubelwagen_dessus
      surface fond shader kubelwagen_fond
      surface cotes shader kubelwagen_cote
}

animations
{
	idle     kubelwagen.skc
}

