TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/bakerSign
	skelmodel bakerSign.skb
      surface Material02 shader bakerSign_bakersSign
      surface Material02 shader bakerSign_bakersSign
      surface Material02 shader bakerSign_bakersSign
      surface Material02 shader bakerSign_bakersSign
}

animations
{
	idle     bakerSign.skc
}

