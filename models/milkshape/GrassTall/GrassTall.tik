TIKI
setup
{
	scale 1.000000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/GrassTall
	skelmodel GrassTall.skb
        surface GrassTall shader GrassTall_GrassTall
}

animations
{
	idle     GrassTall.skc
}

