TIKI
setup
{
	scale 7.000000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/sdkfz-234-3-puma
	skelmodel sdkfz-234-3-puma.skd
      surface toureld1 shader sdkfz-234-3-puma_cotetourelle
      surface canon shader sdkfz-234-3-puma_canon
      surface desutourel shader sdkfz-234-3-puma_dessustourelle
      surface tourelg2 shader sdkfz-234-3-puma_cottourelle
      surface dessus shader sdkfz-234-3-puma_dessus
      surface cotes shader sdkfz-234-3-puma_cote
      //surface roues shader sdkfz-234-3-puma_roues
      surface face shader sdkfz-234-3-puma_facedessous
      surface echapements shader sdkfz-234-3-puma_jagd8
      surface roues shader sdkfz-234-3-puma_roues
      surface tourelo shader sdkfz-234-3-puma_dessustourelle
      surface box1 shader sdkfz-234-3-puma_facedessous
      surface box2 shader sdkfz-234-3-puma_facedessous
      surface antene shader sdkfz-234-3-puma_jagd8
}

animations
{
	idle     sdkfz-234-3-puma.skc
}

