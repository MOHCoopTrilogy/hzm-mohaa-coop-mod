TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/sausages
	skelmodel sausages.skb
      surface Material01 shader sausages_sausage
      surface Material01 shader sausages_sausage
      surface Material01 shader sausages_sausage
}

animations
{
	idle     sausages.skc
}

