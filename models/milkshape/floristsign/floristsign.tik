TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/floristSign
	skelmodel floristSign.skb
      surface Material02 shader floristSign_floristSign
      surface Material02 shader floristSign_floristSign
      surface Material02 shader floristSign_floristSign
      surface Material02 shader floristSign_floristSign
}

animations
{
	idle     floristSign.skc
}

