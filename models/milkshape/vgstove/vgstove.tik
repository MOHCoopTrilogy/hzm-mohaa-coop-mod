TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/vgstove
	skelmodel vgstove.skb
      surface Stovedoor shader vgstove_VGstovedoor
      surface Stoveglass shader vgstove_VGstoveglass
      surface Stovehandle shader vgstove_vgfiller01
      surface Stovemain shader vgstove_VGstovemain
      surface Stoveshelve shader vgstove_VGstoveshelve
      surface Stovetopgrate shader vgstove_vgfiller01
      surface Stovetopigniters shader vgstove_vgfiller01
      surface Stovevalve1 shader vgstove_vgfiller01
      surface Stovevalves shader vgstove_vgfiller02
}

animations
{
	idle     vgstove.skc
}

