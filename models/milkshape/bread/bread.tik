TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/bread
	skelmodel bread.skb
      surface Material03 shader bread_bread
      surface Material03 shader bread_bread
}

animations
{
	idle     bread.skc
}

