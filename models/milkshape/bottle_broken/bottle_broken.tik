TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/bottle_broken
	skelmodel bottle_broken.skb
      surface bottle_broken shader bottle_broken_bottle_broken
}

animations
{
	idle     bottle_broken.skc
}

