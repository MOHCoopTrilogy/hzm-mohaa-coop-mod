TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/triporteur
	skelmodel triporteur.skb
      surface boite shader triporteur_jh_rivplate1
      surface pignons shader triporteur_pak40-5
      surface chaine shader triporteur_jagd11
      surface cadre shader triporteur_bnkrpipe1_blue
      surface roues shader triporteur_pneu
      surface pignons shader triporteur_pak40-5
      surface pignons shader triporteur_pak40-5
      surface selle shader triporteur_elephan
      surface pub shader triporteur_tripot
      surface pub shader triporteur_tripot
}

animations
{
	idle     triporteur.skc
}

