TIKI
setup
{
	scale 6.000000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/sdkfz-234-1
	skelmodel sdkfz-234-1.skd
      surface dessus shader sdkfz-234-1_233dessus
      surface cotes shader sdkfz-234-1_233cote
      surface roues shader sdkfz-234-1_233roues
      surface face shader sdkfz-234-1_233face
      surface echap shader sdkfz-234-1_jagd8
      surface tcote shader sdkfz-234-1_tourelle234cote
      surface cula shader sdkfz-234-1_culasse234
      surface tface shader sdkfz-234-1_tourelle234face
      surface gdessus shader sdkfz-234-1_grilledessus
      surface canon shader sdkfz-234-1_233canon
      surface gcotes shader sdkfz-234-1_grillecote
      surface gdevant shader sdkfz-234-1_grilledessus
}

animations
{
	idle     sdkfz-234-1.skc
}

