TIKI
setup
{
	scale 0.520000			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/milkshape/bouteille
	skelmodel bouteille.skb
      surface etiquette shader bouteille_etiquette
      surface bouteille shader bouteille_bouteille
}

animations
{
	idle     bouteille.skc
}

