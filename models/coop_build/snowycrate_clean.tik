// HZM coop [user 07-21] - snowycrate minus the snow: same skd/skc, both
// opel_crate surfaces retargeted to the stock nazi_crate wood shader.
TIKI
setup
{
	scale 0.54
	path models/static/snowycrate
	skelmodel snowycrate.skd
	surface opel_crate_side shader nazi_crate
	surface opel_crate_top shader nazi_crate
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle snowycrate.skc
}
