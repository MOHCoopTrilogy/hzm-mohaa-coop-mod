TIKI
//=========================================================================
// HZM coop BUILD MODE - LADDER MARKER + GHOST PREVIEW (rusted steel)
//
// [user 2026-08-05] bug-1425 - this model is ONLY ever seen as the build-mode GHOST; the placed
// ladder is textured func_beam rails/rungs plus a latch trigger (coop_mod/ladder.scr), and the
// props row keeps this tik path purely as a style MARKER for save/reload.
//
// The ghost used to be shape_post - a big cube - which showed neither the ladder's plane, its
// facing, nor anything ladder-like ("in build mode I just get giant cubes"). wood_latice is the
// stock destruction lattice: a FLAT crosshatch panel, so the ghost now shows the ladder's plane
// and yaw at a glance, wearing this style's own texture. The side facing YOU while placing is the
// climbing side (you place facing INTO the wall).
//
// Height note: ghost scale tracks KP+/- like every ghost, and ladder height is 128 x scale, but
// the lattice's native proportions are its own - the preview is proportional, not exact.
//=========================================================================
setup
{
	scale .5
	path models/fx/destruction/wood_latice
	skelmodel wood_latice.skd
	surface wood_latice1 shader textures/mohtest/rustflat
	surface wood_latice2 shader textures/mohtest/rustflat
}

init
{
	server
	{
		classname animate
	}
}

animations
{
	idle wood_latice.skc
}
