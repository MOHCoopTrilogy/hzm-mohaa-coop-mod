TIKI
//=========================================================================
// HZM coop BUILD MODE - WOODEN PLANK PANEL (bridge / duckboard)
//
// [user 2026-08-16, bug-1821] The user picked this look out of build mode: it is the GHOST that
// stands in for models/coop_build/ladder_wood.tik - wood_latice geometry wearing the wood-floor
// texture rather than the stock destruction-lattice one. But that ghost can never be placed as a
// prop: buildmode.scr:637 diverts any tik whose path contains "ladder" (props.scr::prop_isLadder)
// into ladder.scr, which builds func_beam rails and a climb trigger instead of spawning a model.
// So this is the same asset under a name that does NOT contain "ladder", which reaches the normal
// prop path and can be placed, scaled, rotated and removed like any other prop.
//
// scale 1 where the ladder marker uses .5, because the user's note on the ghost was "if it were
// just a bit longer it would work" - this is 2x the ghost's length before KP+/- scaling, which
// runs to 8.0 on top.
//
// Intended use on m3l3: laid flat across the barbed wire as the plank you fetch and place for
// objective #4. Placed props collide as an AXIS-ALIGNED BBOX (buildmode writes `solid` +
// `setsize`), so lay it FLAT - a tilted panel gets a big rectangular block, not a ramp.
//=========================================================================
setup
{
	scale 1
	path models/fx/destruction/wood_latice
	skelmodel wood_latice.skd
	surface wood_latice1 shader textures/mohtest/flrwood1_rep
	surface wood_latice2 shader textures/mohtest/flrwood1_rep
}

init
{
	server
	{
		classname animate
	}
}

animations
{
	idle wood_latice.skc
}
