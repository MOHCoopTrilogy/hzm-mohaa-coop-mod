// HZM coop [user 07-21] - DESERT officer tent: the Spearhead officer_tent mesh
// (mainta winter asset) with its three snow surfaces retargeted to stock desert
// shaders. Same transplant recipe as the helmet switcher / box primitives:
// same skd + skc, surfaces re-aimed at registered stock shader names.
//   offtentsno      (snow canvas)  -> static_tent  (AA olive tent canvas)
//   snowcrate_side  (snowy crates) -> nazi_crate
//   snowcrate_top   (snowy crates) -> nazi_crate
TIKI
setup
{
	scale 1.0
	path models/static/officer_tent
	skelmodel officer_tent.skd
	surface offtentsno shader static_tent
	surface snowcrate_side shader nazi_crate
	surface snowcrate_top shader nazi_crate
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle officer_tent.skc
}
