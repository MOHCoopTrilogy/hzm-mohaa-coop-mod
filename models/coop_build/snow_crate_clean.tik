// HZM coop [user 07-21] - snow_crate minus the snow: same skd/skc, both
// snowcrate surfaces retargeted to the stock nazi_crate wood shader
// (same transplant recipe as officer_tent_desert.tik).
TIKI
setup
{
	scale 0.6
	path models/static/snow_crate
	skelmodel snow_crate.skd
	surface snowcrate_side shader nazi_crate
	surface snowcrate_top shader nazi_crate
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle snow_crate.skc
}
