TIKI
//=========================================================================
// HZM coop BUILD MODE - LIGHT EMITTER MARKER (light_warm_bright)
//
// [user 2026-08-05] bug-1423 - this file is now ONLY an invisible marker. The light itself is the
// engine's native constantLight, applied by script right after the spawn:
//     coop_mod/props.scr::prop_lightApply  ->  lightRed/Green/Blue + lightRadius + lightOn
// networked in entityState, rendered by CG_EntityEffects for every entity carrying it, and gone
// the instant the entity is deleted. No client commands live here any more - the four previous
// failures (bug-1408/1409/1417/1421b) were all attempts to tie a CLIENT tempmodel's lifetime to a
// SERVER entity, which constantLight simply does not need.
//=========================================================================
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{
	server
	{
		classname animate
		notsolid
		rendereffects +dontdraw
	}
}

animations
{
	idle dummy3.skc
}
