TIKI
setup
{
	scale 0.52

	path models/vehicles/CG4Aglider
	skelmodel CG4Aglider.skd

	surface interior_M1 	  shader Sc_V_CG4Alit
	surface interior_M2 	  shader Sc_V_CG4Alit
	surface interior_M3 	  shader Sc_V_CG4Alit
	surface interior_M4 	  shader Sc_V_CG4Alit
	surface interior_M5 	  shader Sc_V_CG4Alit
	surface interior_M6 	  shader Sc_V_CG4Alit
	surface interior_M7 	  shader Sc_V_CG4Alit
	surface glider_body_M1	  shader Sc_V_CG4Aout
	surface glider_body_M2	  shader Sc_V_CG4Aout
	surface glider_body_M3    shader Sc_V_CG4Aout
	surface glider_gauges     shader Sc_V_CG4Agauge
	surface glider_body_glass shader Sc_V_CG4Aglass  shader glider_glass_cracks001 shader glider_glass_cracks002 shader coop_glass_blood


//______________________________________
//  here is a list of possible emitters:
//______________________________________
//          emitter_front_right
//          emitter_front_left
//          emitter_front_mid
//          emitter_front_top
//          emitter_smoke_lower
//          emitter_smoke_upper
//          tracer1
//          tracer2
//          tracer3
//          tracer4
//          tracer5
//          tracer6
//______________________________________
}

init
{
	server
	{
		classname scriptmodel
	
	}

	client
	{	
         cache vsssource.spr
         cache tracer_fake.spr

	     tagemitter emitter_front_right cloudy_side
		   (
			spawnrate 4
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 3
			life 2
            align
			accel  0 -1000 0
			randvelaxis random 40 crandom 5 5
            notagaxis
			friction 0.7
			angles crandom 20 crandom 30 crandom -120
			scalemin 7
			scalemax 10
			fade
			fadein 1
			collision
			bouncefactor 0.3
			)

	    tagemitter emitter_front_left cloudy_side
		   (
			spawnrate 4
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 3
			life 2
            align
			accel -350 -1000  0
			randvelaxis random 10 crandom 5 5
            notagaxis
			friction 0.7
			angles crandom 20 crandom 30 crandom -100 -120
			scalemin 7
			scalemax 10
			fade
			fadein 1
			collision
			bouncefactor 0.3
			)

	    tagemitter emitter_smoke_lower cloudy
		   (
			spawnrate 4
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 2
			life .8
            align
			accel  0 -800 -1000
			randvelaxis random 40 crandom 5 5
            notagaxis
			friction 0.7
			angles crandom 20 crandom 30 crandom -120
            scalerate .5
			scalemin 7
			scalemax 10
			fade
			fadein .3
			collision
			bouncefactor 0.3
			)

	     tagemitter emitter_smoke_upper cloudy
		   (		     
			spawnrate 4
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 3
			life .8
            align
			accel  0 -800 1300
            notagaxis
			friction 0.7
			angles crandom 20 crandom 30 crandom -120
            scalerate 1.5
			scalemin 7
			scalemax 10
			fade
			fadein .3
			collision
			bouncefactor 0.3
			)

	    tagemitter emitter_smoke_lower cloudy_descent
		   (
			spawnrate 4
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 2
			life 1
            align
			accel  0 0 -5500
			randvelaxis random 40 crandom 5 5
			friction 0.7
			scalemin 5
			scalemax 7
			fade
			fadein 1
			collision
			bouncefactor 0.3
			)

	     tagemitter emitter_smoke_upper cloudy_descent
		   (
			spawnrate 8
			model vsssource.spr
			color 0.4 0.4 0.4
			varycolor
			//life 2
			life 1
            align
            accel  0 0 1000
			randvel crandom -400 400 crandom 0 0 crandom 2300 2300
			friction 0.7
			scalemin 5
			scalemax 7
			fade
			fadein 1
			collision
			bouncefactor 0.3
			)


	}

}

animations
{


	idle			CG4Aglider.skc
	{
		server
		{
		}
		client
		{
                 entry emitteron cloudy
		 entry emitteron cloudy_side
		 entry emitteroff cloudy_descent
                }
        }
	shot			CG4Aglider_shot.skc
	{
		server
		{
		entry                   surface glider_body_glass        -skin1 -skin2
		enter  commanddelay 1.1 surface glider_body_glass        +skin1
		enter  commanddelay 2.1 surface glider_body_glass        -skin1 +skin2
		}
		client
		{
			enter tagspawn tracer1
			(
				model tracer_fake.spr    
				count 1
				alpha 0.9
				life 3
				scale .5
                                accel  0 4500 4000
			)
			enter tagspawn tracer2
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .5
                                accel  0 4500 4000 
			)                       
			enter commanddelay 0.5 tagspawn tracer3
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .51
                                accel  0 4500 4000 
			)
			enter  commanddelay 0.7 tagspawn tracer4
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .5
                                accel  0 4500 4000 
			)
			enter  commanddelay 1 tagspawn tracer5
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .55
                                accel  0 4500 4000 
			)
			enter  commanddelay 1.1 tagspawn tracer6
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .65
                                accel  0 4500 4000 
			)
                        //let's add more shots
			enter commanddelay 1.3 tagspawn tracer3
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .45
                                accel  0 4500 4000 
			)
			enter  commanddelay 1.5 tagspawn tracer4
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .5
                                accel  0 4500 4000 
			)
			enter  commanddelay 1.9 tagspawn tracer5
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .5
                                accel  0 4500 4000 
			)
			enter  commanddelay 2.1 tagspawn tracer6
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .6
                                accel  0 4500 4000 
			)
                        //this one hits the driver! 
			enter commanddelay 2.4 tagspawn tracer1
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .53
                                accel  0 4500 4000 
			) 
                }
        }
	descent			CG4Aglider_descent.skc
	{
		server
		{
		}
		client
		{
                 entry emitteroff cloudy
		 entry emitteron cloudy_descent 
                }
        }
	bank_left		CG4Aglider_bank_left.skc
	{
		server
		{
		entry	surface glider_body_glass        +skin2	// [user 2026-08-03] bug-1316 - was "-skin1 +skin2".
		//The -skin1 is a redundant re-assert (commanddelay 2.1 in the shot anim already set this
		//state) and it CLEARED the blood windscreen, which needs BOTH offset bits. Setting +skin2
		//alone reaches cracks002 exactly as before when skin1 is clear, and leaves the bloodied
		//pane intact when the pilot has already been shot.
		}
		client
		{
		enter  commanddelay 0.01 tagspawn tracer6
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .53
                                accel  400 6500 4000
			)
                        //let's add more shots
			enter commanddelay 0.03 tagspawn tracer3
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .45
                                accel  400 6500 4000
			)
			enter  commanddelay 0.1 tagspawn tracer4
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .7
                                accel -450 6500 4000
			)
			enter  commanddelay 0.11 tagspawn tracer5
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .66
                                accel  -400 6500 4000
			)
			enter  commanddelay 0.12 tagspawn tracer6
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .78
                                accel  400 6600 4000
			)
                        //this one hits the driver! 
			enter commanddelay 0.15 tagspawn tracer1
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .8
                                accel  -300 6500 4000 
			) 
                }
        }
	bank_right		CG4Aglider_bank_right.skc
	{
		server
		{
		entry	surface glider_body_glass        +skin2	// [user 2026-08-03] bug-1316 - was "-skin1 +skin2".
		//The -skin1 is a redundant re-assert (commanddelay 2.1 in the shot anim already set this
		//state) and it CLEARED the blood windscreen, which needs BOTH offset bits. Setting +skin2
		//alone reaches cracks002 exactly as before when skin1 is clear, and leaves the bloodied
		//pane intact when the pilot has already been shot.
		}
		client
		{
			enter tagspawn tracer1
			(
				model tracer_fake.spr    
				count 1
				alpha 0.9
				life 3
				scale .87
                                accel  0 8800 4000
			)
			enter tagspawn tracer2
			(
				model tracer_fake.spr                        
				count 1
				alpha 0.9
				life 3
				scale .53
                                accel  0 8800 4000 
			)                       
			enter commanddelay 0.05 tagspawn tracer3
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .65
                                accel  0 8800 4000
			)
			enter  commanddelay 0.3 tagspawn tracer4
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .77
                                accel  0 8800 4000
			)
			enter  commanddelay 1 tagspawn tracer5
			(
				model tracer_fake.spr                       
				count 1
				alpha 0.9
				life 3
				scale .91
                                accel  0 8800 4000
			)
                }
        }
	emitter_off			CG4Aglider.skc
	{
		server
		{
                 //[user 2026-08-04] bug-1338 - REMOVED: entry +skin1 -skin2. This is the glider's
                 //BASE anim, so every return to it re-asserted 'light cracks only' - which wiped the
                 //blood skin (skin1+skin2) moments after the pilot died ('there for a moment but then
                 //goes away'). Surface skin bits persist on their own; the shot anim owns the crack
                 //progression and the script owns the blood - the base anim must not touch the glass.
		}
		client
		{
                 entry emitteroff cloudy
		 entry emitteroff cloudy_descent 
		 entry emitteroff cloudy_side
                }
        }

}

/*QUAKED addon_vehicle_CG4Agliderlight (0.0 0.0 1.0) (-239.65 -150.413 -87.596) (239.65 150.413 87.596)
glider -- fly, fly away into the sky with this glider
*/
