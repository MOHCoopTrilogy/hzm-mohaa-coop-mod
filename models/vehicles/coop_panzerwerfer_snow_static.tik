// [user 2026-08-11] STATIC panzerwerfer for use as SCENERY.
// Identical to models/vehicles/panzerwerfer_base_snow.tik except that the nine animated surfaces
// point at coop_pzw42_*_static (scripts/coop_static_vehicles.shader) instead of the retail
// shaders, whose tcMod scroll/rotate runs unconditionally in the renderer and cannot be stopped
// from script. Use this when a panzerwerfer is a prop; use the retail TIK when it must drive.
TIKI
setup
{
	scale 0.52
	path models/vehicles/panzerwerfer
	skelmodel panzerwerfer_base.skd
	surface pzw_body shader pzw_body_s
	surface pzw42_tire1 shader coop_pzw42_tire1_static
	surface pzw42_tread1 shader coop_pzw42_tread1_static
	surface pzw42_tread2 shader coop_pzw42_tread2_static
	surface pzw42_treadedge shader coop_pzw42_treadedge_static
	surface pzw42_teeth shader coop_pzw42_teeth_static
	surface pzw42_tire2 shader coop_pzw42_tire2_static
	surface pzw42_tread3 shader pzw42_tread3_s
	surface pzw42_tire3 shader coop_pzw42_tire3_static
	surface pzw42_tire4 shader coop_pzw42_tire4_static
	surface pzw42_tire5 shader coop_pzw42_tire5_static
	surface pzw42_suspen shader pzw42_suspen_s
}

init
{
	server
	{
		classname vehicletank
		setsize "-60 -60 0" "60 60 78"
		vehicleWheelCorners "300 200 78" "75 0 -1.5"
		vehiclespeed 200
		vehiclemass 1500
		vehicletread 10
		vehicleradius 0.33
		vehiclerollingresistance 0.5
		vehicledrag 0.00001
		vehiclebouncy 0.2
		vehiclespringy 0.8
		turnrate 40
		mass 2500

		// Spawn and attach the parts
		spawnturret 0 "vehicles/panzerwerfer_cannon_snow.tik"

		// Set the Animation Set to use
		SoundSet "tank_"


			//////////////////////////////////////////
			// Pitch-Mod Sound for vehicles by speed
			//
			// Linearly Interpolates from the minimum pitch when the vehicle is at the minimum speed to 
			// the maximum pitch when the vehicle is at the maximum speed.
			//
			// Speed is in World Units.
			//
			//
			//                 +--------------- Minimum Speed
			//                 |  +------------ Minimum Pitch
			//                 |  |
			//                 |  |      +----- Maximum Speed
			//                 |  |      |  +-- Maximum Pitch
			//                 V  V      V  V
			setsoundparameters 0 0.95   200 1		


	}
}

animations
{
	idle			panzerwerfer_base.skc
	lean_back		panzerwerfer_base_lean_back.skc
	lean_forward		panzerwerfer_base_lean_forward.skc
	lean_left		panzerwerfer_base_lean_left.skc
	lean_right		panzerwerfer_base_lean_right.skc
	level			panzerwerfer_base_level.skc
	low			panzerwerfer_base_low.skc
	high			panzerwerfer_base_high.skc
}

