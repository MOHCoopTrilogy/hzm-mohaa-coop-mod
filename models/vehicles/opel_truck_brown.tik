TIKI
setup
{
	scale 0.52
	path models/vehicles/Opel_Truck_Brown
	skelmodel Opel_Truck_Brown.skd
	surface opel1 shader opel shader opelgreen shader opelsnow
	surface opel2 shader opel2sided shader opelgreen2sided shader opelsnow2sided
	surface opel3 shader opel shader opelgreen shader opelsnow
	surface opel4 shader opel shader opelgreen shader opelsnow
	surface opelhub shader opelhub shader opelhubgreen shader opelhubsnow
	surface opeltread shader opeltread shader opeltreadsnow
	surface opelhubstill shader opelhub_norotate shader opelhubgreen_norotate shader opelhubsnow_norotate
	surface opeltreadstill shader opeltread_norotate shader opeltreadsnow_norotate
	surface opelwindows shader opelwindows shader opelwindows_cracked shader opelwindowssnow
	surface opellights shader opellights
	surface opelheadlights shader opelheadlights shader opel
	surface opel_crate_side shader opel_crate_side
	surface opel_crate_top shader opel_crate_top
	surface shovel shader shovel
	surface flourbag shader flourbag
}

init
{
	server
	{
		classname drivablevehicle
		setsize "-56 -56 0" "56 56 72"
		vehicleWheelCorners "180 112 78" "0 0 -1.5"
		vehicleinit jeep.tik
		vehiclespeed 1000
		vehiclemass 1500
		vehicletread 10
		vehicleradius 0.33
		vehiclerollingresistance 0.5
		vehicledrag 0.00001
		vehiclebouncy 0.5
		vehiclespringy 0.8
		mass 1000

		AnimationSet "opeltruck_"
		SoundSet "opeltruck_"

		setsoundparameters 0 0.95   200 1

		surface opelhubstill +nodraw
		surface opeltreadstill +nodraw

		surface opel_crate_side +nodraw
		surface opel_crate_top  +nodraw
		surface shovel          +nodraw
		surface flourbag        +nodraw
	}
}

animations
{
	idle    Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opellights +nodraw
			entry surface opelheadlights +skin1
		}
	}
	lean_back       Opel_truck_Brown_lean_back.skc
	lean_forward    Opel_truck_Brown_lean_forward.skc
	lean_left       Opel_truck_Brown_lean_left.skc
	lean_right      Opel_truck_Brown_lean_right.skc
	level           Opel_truck_Brown_level.skc
	low             Opel_truck_Brown_low.skc
	high            Opel_truck_Brown_high.skc

	idlelights  Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opellights -nodraw
			entry surface opelheadlights -skin1
			entry surface opelheadlights -skin2
		}
	}
	idlenolights    Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opellights +nodraw
			entry surface opelheadlights +skin1
		}
	}
	skidding Opel_Truck_Brown.skc
	{
		client
		{
			entry stopaliaschannel snd_skid_stone
			entry sound snd_skid_stone

			first tagspawn "tire_spew_back_left"
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)
			first tagspawn "tire_spew_back_right"
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)
			first tagspawn "tire_spew_front_left"
			(
				count 1
				scale .25
				model models/fx/snipesmoke.tik
			)
			first tagspawn "tire_spew_front_right"
			(
				count 1
				scale .25
				model models/fx/snipesmoke.tik
			)
		}
	}
	stop_wheels Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opelhub         +nodraw
			entry surface opeltread       +nodraw
			entry surface opelhubstill    -nodraw
			entry surface opeltreadstill  -nodraw
		}
	}
	start_wheels    Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opelhub         -nodraw
			entry surface opeltread       -nodraw
			entry surface opelhubstill    +nodraw
			entry surface opeltreadstill  +nodraw
		}
	}
	cargo   Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opel_crate_side -nodraw
			entry surface opel_crate_top  -nodraw
			entry surface shovel          -nodraw
			entry surface flourbag        -nodraw
		}
	}
	color_brown Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opel1        -skin1 -skin2
			entry surface opel2        -skin1 -skin2
			entry surface opel3        -skin1 -skin2
			entry surface opel4        -skin1 -skin2
			entry surface opelhub      -skin1 -skin2
			entry surface opelhubstill -skin1 -skin2
		}
	}
	color_green Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opel1        +skin1
			entry surface opel2        +skin1
			entry surface opel3        +skin1
			entry surface opel4        +skin1
			entry surface opelhub      +skin1
			entry surface opelhubstill +skin1
		}
	}
	color_snow  Opel_Truck_Brown.skc
	{
		server
		{
			entry surface opel1        +skin2
			entry surface opel2        +skin2
			entry surface opel3        +skin2
			entry surface opel4        +skin2
			entry surface opelhub      +skin2
			entry surface opeltread    +skin1
			entry surface opelwindows  +skin2
			entry surface opelhubstill +skin2
			entry surface opeltreadstill +skin1
		}
	}
	dooropen    Opel_Truck_Brown_dooropen.skc
	{
		client
		{
			24 opeltruck_snd_dooropen
			58 opeltruck_snd_doorclose
		}
	}
}

/*QUAKED addon_vehicle_german_Opel-Truck-Brown (0.0 0.0 0.0) (-65 -40 0) (65 40 120)
Opel Truck Brown (default skin)
*/
