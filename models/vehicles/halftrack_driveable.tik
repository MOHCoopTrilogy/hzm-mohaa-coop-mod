TIKI
setup
{
	scale 0.52
	path models/vehicles/halftrack_driveable
	skelmodel halftrack_driveable.skd
	surface htw_side shader htw_side
	surface htw_panel_hood shader htw_panel_hood
	surface htw_windshield shader htw_windshield
	surface htw_frontpanel shader htw_frontpanel
	surface htw_headlamp shader htw_headlamp
	surface htw_wheel2_front shader htw_wheel2_front
	surface htw_yellow shader htw_yellow
	surface htw_fender shader htw_fender
	surface htw_tread shader htw_tread
	surface htw_tread_side shader htw_tread_side
	surface htw_wheel3 shader htw_wheel3
	surface htw_wheel2 shader htw_wheel2
	surface htw_wheel_front shader htw_wheel_front
	surface htw_wheel shader htw_wheel
	surface htw_side_num_r shader htw_side_num_r
	surface htw_rear shader htw_rear
}

init
{
	server
	{
		classname drivablevehicle
		setsize "-76 -56 0" "140 56 56"
		vehicleWheelCorners "300 112 112" "0 0 -1.5``"
		vehiclespeed 1000
		vehiclemass 1500
		vehicletread 10
		vehicleradius 0.33
		vehiclerollingresistance 0.5
		vehicledrag 0.00001
		vehicleinit vehicles/halftrack_driveable.tik
		vehiclebouncy 0.2
		vehiclespringy 0.8
		mass 1500
		turnrate 40
		health 500

		//AnimationSet "halftrack_driveable_"
		//SoundSet "halftrack_driveable_"
		SoundSet "sdkfz_"

		//spawnturret 0 "vehicles/sdkfz_mg42.tik"
		//spawnturret 0 "vehicles/jeep_30cal.tik"
		//HZM coop: turret is script-spawned post-level (maps/t2l2.scr coop_setup) - putting spawnturret
		//here nulls the whole DrivableVehicle in MP. With the game.dll DropToFloor fix (PlaceTurret runs
		//for post-level turrets) the STOCK eye-bone camera is valid, so the script-spawned cannon looks
		//correct (down the barrel) exactly like the jeep .30cal.
		//spawnturret 0 "vehicles/PzB41_turret.tik"

		//////////////////////////////////////////
		// Pitch-Mod Sound for vehicles by speed
		//
		// Linearly Interpolates from the minimum pitch when the vehicle is at the minimum speed to 
		// the maximum pitch when the vehicle is at the maximum speed.
		//
		// Speed is in World Units.
		//
		//
		//                 +--------------- Minimum Speed
		//                 |  +------------ Minimum Pitch
		//                 |  |
		//                 |  |      +----- Maximum Speed
		//                 |  |      |  +-- Maximum Pitch
		//                 V  V      V  V
		setsoundparameters 0 0.95   200 1		

	}
}

animations
{
	idle     		halftrack_driveable.skc
	high			halftrack_driveable_high.skc
	lean_back		halftrack_driveable_lean_back.skc
	lean_forward		halftrack_driveable_lean_forward.skc
	lean_left		halftrack_driveable_lean_left.skc
	lean_right		halftrack_driveable_lean_right.skc
	level			halftrack_driveable_level.skc
	low			halftrack_driveable_low.skc

	skidding 		halftrack_driveable.skc
	{
		client
		{
			entry stopaliaschannel snd_skid_stone
			entry sound snd_skid_stone

			first tagspawn "tire_spew_back_left"
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)

			first tagspawn "tire_spew_back_right"
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)

			first tagspawn "tire_spew_front_left"
			(
				count 1
				scale .25
				model models/fx/snipesmoke.tik
			)

			first tagspawn "tire_spew_front_right"
			(
				count 1
				scale .25
				model models/fx/snipesmoke.tik
			)
		}
	}

	22P100_Hafltrack_wobble		halftrack_driveable_wobble.skc
}

/*QUAKED addon_vehicle_german_snowy-halftrack-antitank (0.0 0.0 1.0) (-160.354 -55.6747 0) (160.354 55.6747 98)
*/
