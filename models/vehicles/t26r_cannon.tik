TIKI
setup
{
	scale 0.45				// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/vehicles/t26
	skelmodel t26_cannon.skd
	surface torreta shader t26r
      surface armas shader t26r
}
init
{
	server
	{
		classname 		VehicleTurretGun
		setsize			"-8 -8 -8" "8 8 8"
		weapontype		cannon
		name			"T-26"

		// turret settings
		idleCheckOffset	"-56 0 0"

		// Primary fire type info
		projectile		models/projectiles/panzerIVshell.tik
		firetype		heavy
		meansofdeath		rocket
		//bulletcount		1
		usenoammo		1
		firedelay			5
		turnspeed			38
		pitchcaps			"-30 15 0"

		// DM Attributes

		SoundSet "tank_"

	}
	client
	{
		cache snowplume_01.spr
		cache tehaoSmoke_light.spr
		cache muzsprite.spr
		cache trainSpark_01.spr
		cache models/fx/muzflash.tik
		cache models/projectiles/panzerIVshell.tik
	}
}


animations
{
	idle     t26_cannon.skc
	fire     t26_cannon.skc
	{
		server
		{
			first shoot
		}
		client
		{
			entry stopaliaschannel tank_snd_fire
			entry stopaliaschannel tank_snd_reload
			first sound tank_snd_fire weapon 1.0 -1 0.95 0.1
			first playforcefeedback weapons/tank_fire
			last sound tank_snd_reload weapon 1.0 -1 0.95 0.1
		
			// muzzle flash
			enter blockdlight 400 0.25
			(
				color 0.7 0.7 0.5
				scalerate -4
				offset 0 0 0
			)

			//blast -muzzle-
			enter tagspawn tag_barrel
			(
 				model muzzleCharge.spr
				count 8
				color 1 .4 .1
				varycolor
				alpha 0.9
				life 0.4
				scalerate -1
				randvelaxis range 100 700 crandom 80 crandom 80
				friction 40
				avelocity 0 0 crandom 60
				scalemin 0.4
				scalemax 0.7
				fade
			)
			
			//sparks
			enter tagspawn tag_barrel
			(
				model trainSpark_01.spr
				count 7
				life .15
				scalerate -3
				radius 5
				randvelaxis range 1500 2500 0 0
				scale .5
			)
			
			//fire -expanding- front
			enter tagspawn tag_barrel
			(
 				model tehaoSmoke_light.spr
				alpha .5
				count 10
				life 1.5
				scalerate 2.2
				randvelaxis range 600 1200 0 0
				friction 8.5
				offsetalongaxis range 10 100 crandom 10 crandom 10
				avelocity 0 0 crandom 50
				scalemin 0.1
				scalemax 0.3
				fade
				offset 30 0 0
			)

			//fire -expanding- middle
			enter tagspawn tag_barrel
			(
 				model tehaoSmoke_light.spr
				alpha .5
				count 8
				life 1.5
				scalerate 3.3
				randvelaxis range 500 1200 0 0
				friction 9
				offsetalongaxis crandom 2 crandom 10 crandom 10
				avelocity 0 0 crandom 50
				scalemin 0.2
				scalemax 0.4
				fade
			)
			
			//fire -billow- back 
			enter tagspawn tag_barrel
			(
 				model tehaoSmoke_light.spr
				count 8
				life 1.3
				scalerate 5
				randvelaxis range 200 300 crandom 300 crandom 300
				accel -500 0 0
				friction 6
				avelocity 0 0 crandom 50
				scalemin 0.1
				scalemax 0.2
				fade
			)
			
			//smoke -expanding- front
			enter tagspawn tag_barrel
			(
 				model snowplume_01.spr
				count 5
				alpha 0.5
				color 0.32 0.3 0.3
				life 1.5
				scalerate 4
				randvelaxis range 200 500 0 0
				accel 100 0 160
				friction 6
				offset 5 0 0
				offsetalongaxis crandom 50 crandom 10 crandom 10
				scalemin 0.2
				scalemax 0.3
				fade
				)
			
			//smoke -billow- back 
			enter tagspawn tag_barrel
			(
 				model snowplume_01.spr
				count 5
				alpha 0.5
				color 0.32 0.3 0.3
				scale 0.1
				life 1.5
				scalerate 4
				randvelaxis range 200 500 0 0
				accel 100 0 160
				friction 6
				offset 5 0 0
				offsetalongaxis crandom 50 crandom 10 crandom 10
				scalemin 0.2
				scalemax 0.3
				fade
				)

		}
	}
}