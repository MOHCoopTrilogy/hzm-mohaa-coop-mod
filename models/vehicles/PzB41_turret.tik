TIKI
setup
{
	scale 1.33				//legacy scale matched, do not change!
	path models/vehicles/pzb41_turret
	skelmodel pzb41_turret.skd
	surface pzb_41 shader pzb_41
}

init
{
	server
	{
		classname 		VehicleTurretGun
		weapontype		cannon
		name			"PzB41 Anti-Tank"

		// turret settings
		idleCheckOffset	"-56 0 0"

		// Primary fire type info
		projectile		models/projectiles/pzb41shell.tik
		firetype		heavy
//		ammotype		"MG"
		meansofdeath		rocket
		bulletcount		1
//		clipsize		20
//		startammo		20
//		ammorequired		1
//		ammorequired		0
		usenoammo		1
		firedelay		0.50 //0.50
		bulletrange		4000
		reloaddelay		1 //2
		reloadshots		20
		bulletdamage		100
		bulletspread	20 20	//25 25
		tracerfrequency 	10 //3
//		largebullet             1	//bad init command
		bulletknockback		100
		turnspeed		1001 //1001     				// this seems to do nothing
		viewjitter	    3.75					     // amount of camera shake when firing
		aimtolerance		"90 90 0"

		SoundSet "pzb41_"
		

	}
}

animations
{
	idle    pzb41_turret.skc
	fire	pzb41_fire.skc
	{
		server
		{
			entry shoot
		}
		client
		{

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.05 110 0.11
			entry tagspawnlinked tag_barrel
			(
				scale 0.6
				offsetalongaxis 3 0 0
				count 1
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.04
			)
			entry tagspawnlinked tag_barrel
			(
				count 1
				scalemin 1.0
				scalemax 1.5
				model models/fx/muzflash.tik
				randomroll
				life 0.03
			)

		}
	}
}

/*QUAKED vehicle_axis_turret_PzB41 (0.0 .0 0.0) (-60 -40 0) (60 40 128)
German Mounted  PzB41
*/