TIKI
setup
{
	scale 0.4			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/statweapons/maxim
	skelmodel soporte.skd
	surface ruedas shader soporte
	surface soporte shader soporte
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle     soporte.skc
}

