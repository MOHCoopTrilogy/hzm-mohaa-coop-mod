TIKI
// HZM coop: floating ALLIED faction marker (white star) - a camera-facing billboard
// quad attached above each allied paratrooper's head via attachmodel.
setup
{
	scale 0.8
	path models/fx/unitsquare
	skelmodel unitsquare.skd
	surface all shader coop_allied_marker
}

init
{
	server
	{
		classname animate
	}
}

animations
{
	idle unitsquare.skc
}
