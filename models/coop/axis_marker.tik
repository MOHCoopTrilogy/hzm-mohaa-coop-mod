TIKI
// HZM coop: floating AXIS faction marker (Iron Cross) - a camera-facing billboard
// quad attached above each German combatant's head via attachmodel.
setup
{
	scale 0.8
	path models/fx/unitsquare
	skelmodel unitsquare.skd
	surface all shader coop_axis_marker
}

init
{
	server
	{
		classname animate
	}
}

animations
{
	idle unitsquare.skc
}
