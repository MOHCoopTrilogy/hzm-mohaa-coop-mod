TIKI
// HZM coop [2026-10-12] BLIZZARD (day) VEIL - the per-player sheet of coop_mod/wxextreme.scr (blizzard / downpour tier).
// models/emitters/coop_dustveil_day.tik without its three sand emitters: the same retail sheet mesh
// (models/emitters/emitters_cube, maintt pak1), one fadeable skin (scripts/coop_wxextreme.shader). `idle` and `on`
// both exist because duststorm.scr's sheet code plays them; neither starts anything here.
// The server block is only classname + setsize: an init server block runs on `spawn` (bug-2244).
// THE NAME MUST CONTAIN "coop_dustveil": cgame (cg_modelanim.c, bug-2963) keys the camera-locked path on it.
setup
{
	scale .52
	path models/emitters/emitters_cube
	skelmodel emitters_cube.skd
	surface fog_screen shader coop_dustveil_snow
}

init
{
	server
	{
		classname animate
		setsize "-2 -2 0" "2 2 4"
	}
}

animations
{
	idle emitters_cube.skc
	on emitters_cube.skc
}
