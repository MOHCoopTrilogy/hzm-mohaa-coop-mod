TIKI
// HZM coop [2026-09-26, bug-2963] DUST STORM VEIL (day) - the per-player sand sheet of coop_mod/duststorm.scr.
//
// The retail e1l1 sheet (models/emitters/emitters_cube.tik, maintt pak1) - same mesh, same scale, same three
// sand emitters - with three changes:
//   - ONE fadeable skin (scripts/coop_duststorm.shader coop_dustveil_day: alphaGen entity) instead of retail's
//     three-skin swap; retail's sandstorm_animB has no alphaGen, so it could never fade.
//   - emitters OFF in `idle` and ON only in `on`, so the script turns the blowing sand off indoors.
//   - spawn rates / 5: count and spawnrate are multiplied by cg_effectdetail, and the mod ships 1.0 against
//     retail's 0.2 (TRAPS "TIKI and sound-alias traps", bug-2477/2507). Everything else is retail.
// The server block is only classname + setsize: an init server block runs on `spawn` (bug-2244).
// THE NAME MUST CONTAIN "coop_dustveil": cgame (cg_modelanim.c, bug-2963) keys the camera-locked path on it,
// which is what keeps this a veil in third person, in cover and under script cameras.
setup
{
	scale .52
	path models/emitters/emitters_cube
	skelmodel emitters_cube.skd
	surface fog_screen shader coop_dustveil_day
}

init
{
	server
	{
		classname animate
		setsize "-2 -2 0" "2 2 4"
	}

	client
	{
		tagemitter emitter_01 sandstorm
		(
			spawnrate 1.2
			model sandstorm01.spr
			color .36 .2 .1
			alpha .7
			varycolor
			scale 1
			life 3
			scalerate .2
			radius 80
			radialvelocity .25 1 3
			velocity 5
			randvel crandom 5 crandom 5 crandom 5
			accel 0 40 -5
			friction 0
			angles crandom 5 crandom 5 crandom 20
			scalemin 2
			scalemax 3
			circle
			fade
			fadein 1
		)

		tagemitter emitter_01 sandstorm
		(
			spawnrate 0.6
			model sandstorm_gust.spr
			color .35 .2 .1
			alpha .8
			varycolor
			life 5
			scalerate .5
			randvelaxis crandom 10 crandom 50 crandom 30
			accel 0 -150 10
			offset crandom 80 range -100 200 range -20 140
			angles crandom 60 crandom 60 crandom 180
			avelocity crandom 20 crandom 20 50
			scalemin .75
			scalemax 3.5
			fadedelay 2
			fadein 1
			inwardsphere
		)

		tagemitter emitter_02 sandstorm
		(
			spawnrate 1.4
			model sandstorm02.spr
			color .34 .18 .1
			alpha .8
			varycolor
			scale 2
			life 4
			scalerate .3
			radius 150
			radialvelocity .15 2 4
			velocity 5
			randvel crandom 5 crandom 7 crandom 5
			accel 0 -35 0
			friction 0
			angles crandom 5 crandom 5 crandom 10
			scalemin 2
			scalemax 3
			circle
			fade
			fadein 1
		)
	}
}

animations
{
	idle emitters_cube.skc
	{
		client
		{
			entry emitteroff sandstorm
		}
	}

	on emitters_cube.skc
	{
		client
		{
			entry emitteron sandstorm
		}
	}
}
