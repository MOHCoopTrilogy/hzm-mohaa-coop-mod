TIKI
// HZM coop [2026-09-26, bug-2963] DUST STORM VEIL (night) - coop_dustveil_day.tik with the night sheet
// (scripts/coop_duststorm.shader coop_dustveil_night) and night particle colours. THE NAME MUST CONTAIN "coop_dustveil"
// (cg_modelanim.c, bug-2963). Everything else - mesh, spawn rates / 5, idle = emitters OFF / on = ON, server block -
// is the day tik; read the notes there.
// [2026-09-28] MOONLIT, not soot (docs/proposals/duststorm_2026-09-28/plan.md section 2): the particles are unlit
// (rgbGen vertex) and were pulled down to the old near-black storm fog (~.1), so at night the blowing sand read as dark
// smudges. They are now moonlit grey-tan, a little brighter than the night storm wall (duststorm.scr
// coop_dust_nightLook) the way sand close to your face catches more light than the dust far off - so the gusts
// read against the wall at night.
setup
{
	scale .52
	path models/emitters/emitters_cube
	skelmodel emitters_cube.skd
	surface fog_screen shader coop_dustveil_night
}

init
{
	server
	{
		classname animate
		setsize "-2 -2 0" "2 2 4"
	}

	client
	{
		tagemitter emitter_01 sandstorm
		(
			spawnrate 1.2
			model sandstorm01.spr
			color .26 .23 .20
			alpha .7
			varycolor
			scale 1
			life 3
			scalerate .2
			radius 80
			radialvelocity .25 1 3
			velocity 5
			randvel crandom 5 crandom 5 crandom 5
			accel 0 40 -5
			friction 0
			angles crandom 5 crandom 5 crandom 20
			scalemin 2
			scalemax 3
			circle
			fade
			fadein 1
		)

		tagemitter emitter_01 sandstorm
		(
			spawnrate 0.6
			model sandstorm_gust.spr
			color .28 .25 .21
			alpha .8
			varycolor
			life 5
			scalerate .5
			randvelaxis crandom 10 crandom 50 crandom 30
			accel 0 -150 10
			offset crandom 80 range -100 200 range -20 140
			angles crandom 60 crandom 60 crandom 180
			avelocity crandom 20 crandom 20 50
			scalemin .75
			scalemax 3.5
			fadedelay 2
			fadein 1
			inwardsphere
		)

		tagemitter emitter_02 sandstorm
		(
			spawnrate 1.4
			model sandstorm02.spr
			color .25 .22 .19
			alpha .8
			varycolor
			scale 2
			life 4
			scalerate .3
			radius 150
			radialvelocity .15 2 4
			velocity 5
			randvel crandom 5 crandom 7 crandom 5
			accel 0 -35 0
			friction 0
			angles crandom 5 crandom 5 crandom 10
			scalemin 2
			scalemax 3
			circle
			fade
			fadein 1
		)
	}
}

animations
{
	idle emitters_cube.skc
	{
		client
		{
			entry emitteroff sandstorm
		}
	}

	on emitters_cube.skc
	{
		client
		{
			entry emitteron sandstorm
		}
	}
}
