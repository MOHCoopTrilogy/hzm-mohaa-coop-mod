TIKI
// HZM coop [aircraft 2026-10-05] smoke + fire trail of a stricken aircraft (coop_mod/aircraft.scr::stricken).
// Retail sprites only (tehaoSmoke_dark / tehaoSmoke_light / campFire_01, maintt pak1). Per-puff smoke that is dark at
// the fire and greys as it ages, grows, fades and drifts with the wind, with gaps between puffs - the retail
// plane_smoke.tik (vsssource.spr, spawnrate 120, colour 0.1) drew as one solid black rope under VSS.
// Budget: ~10 + 6 + 8 live particles per second of life -> about 70 particles per burning aircraft.
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{
	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw
	}
	client
	{
		cache tehaoSmoke_dark.spr
		cache tehaoSmoke_light.spr
		cache campFire_01.spr

	// young smoke right behind the fire: dark, small, short-lived
		originemitter acsmoke
		(
			spawnrate 12
			model tehaoSmoke_dark.spr
			alpha 0.75
			color 0.16 0.15 0.14
			life 2.6
			scalerate 1.7
			randvel crandom 12 crandom 12 random 8
			accel 10 -6 18
			friction 0.6
			angles 20 30 crandom 180
			avelocity crandom 5 crandom 5 crandom 50
			scalemin 0.13
			scalemax 0.2
			fadein 0.15
			fade
		)

	// older smoke: grey, larger, lingering and drifting downwind
		originemitter acsmoke
		(
			spawnrate 6
			model tehaoSmoke_light.spr
			alpha 0.42
			color 0.45 0.44 0.43
			life 6.0
			scalerate 0.9
			randvel crandom 18 crandom 18 random 10
			accel 14 -8 22
			friction 0.45
			angles 20 30 crandom 180
			avelocity crandom 5 crandom 5 crandom 30
			scalemin 0.2
			scalemax 0.32
			fadein 0.8
			fadedelay 2.5
		)

	// the fire at the wing root
		originemitter acsmoke
		(
			spawnrate 8
			model campFire_01.spr
			color 1 .55 .25
			alpha .9
			life 0.45
			scalerate .3
			randvel crandom 8 crandom 8 random 6
			angles 0 0 crandom 30
			scalemin .18
			scalemax .3
			fadein .1
			fadedelay .2
			flicker
		)
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{
		client
		{
			enter emitteron acsmoke
		}
	}
	stop dummy3.skc
	{
		client
		{
			enter emitteroff acsmoke
		}
	}
}
