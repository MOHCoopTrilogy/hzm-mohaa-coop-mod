TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_airborne_82nd_3.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	path models/human/allied_airborne	// Set path to set skelmodel from
	skelmodel airborne.skd		// Set body model

	surface shirt shader air_jacket_82nd_cpl
	surface shirt shader air_jacket_82nd_cpl_blood1	// HZM coop - gore tier 1 (light)
	surface shirt shader air_jacket_82nd_cpl_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader airborne_pants
	surface pants shader airborne_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader airborne_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface sleeve shader air_jacket_82nd_cpl
	surface sleeve shader air_jacket_82nd_cpl_blood1	// HZM coop - gore tier 1 (light)
	surface sleeve shader air_jacket_82nd_cpl_blood2	// HZM coop - gore tier 1 (heavy)

	//$path models/human/heads			// Set new path for head model
	//skelmodel head4.skd		// Set head model
	//surface head shader us_bob
	
	$path models/human/heads			// Set new path for head model
	skelmodel head8.skd		// Set head model
	surface head shader us_bob

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	path models/equipment/USGear/airborne
	skelmodel airborne_gear.skd
	surface gear shader airborne_gear

	//path models/equipment/USGear/helmets
	//skelmodel us_helmet.skd
	//surface us_helmet shader blank_web

	path models/gear/ss
	skelmodel ssholster.skd				//captured Luger/P38 holster
	surface ssholster shader german_holster

	path models/gear
	skelmodel 101_granade.skd
	surface 101_granade shader 101_grenade

	skelmodel 101_knife.skd
	surface 101_knife shader 101_knife

	path models/gear
	skelmodel dmedipack.skd
	surface dmedipack shader coop_dmedipack	// HZM bug-922: fresh un-contested shader name + private texture path - the dday_medipack-1 def never reached this surface at runtime despite 4 rounds of shader-file fixes
	
	path models/gear


	path models/equipment/USGear/helmets

}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype airborne // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end