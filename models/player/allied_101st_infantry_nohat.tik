TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_101st_infantry.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52
	path models/human/allied_army_soldier
	skelmodel usarmy.skd

	surface ranger_pants shader hbtpants_snow
	surface ranger_pants shader HBTpants_snow_blood1	// HZM coop - gore tier 1 (light)
	surface ranger_pants shader HBTpants_snow_blood2	// HZM coop - gore tier 1 (heavy)
	surface us_top shader hbt_jacket_snow
	surface us_top shader hbt_jacket_snow_blood1	// HZM coop - gore tier 1 (light)
	surface us_top shader hbt_jacket_snow_blood2	// HZM coop - gore tier 1 (heavy)
	surface armband shader hbt_pfc_snow
	surface us_top_c shader hbt_jacket_c_snow
	surface us_top_c shader hbt_jacket_c_snow_blood1	// HZM coop - gore tier 1 (light)
	surface us_top_c shader hbt_jacket_c_snow_blood2	// HZM coop - gore tier 1 (heavy)

	path models/human/heads
	skelmodel head1.skd
	surface head shader us_head_snow_2

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader hands_snow1

	// GEAR
	// =======================================================
	path models/gear/us
	
	skelmodel haversack.skd
	surface haversack shader usequip_snw

	skelmodel garandbelt.skd
	surface garandbelt shader usammobelt_snw

	// HELMET
	// =======================================================
	path models/equipment/USGear/helmets
}

init
{
	server
	{
		voicetype allied // set the voicetype to use for multiplayer instant messaging
	}
}

$include models/player/base/include.txt
