TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_british_tank_corporal.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52
	path models/human/allied_british_tank_corporal
	skelmodel brit_tank_corp.skd

	surface handsnew shader handsnew_btc
	//surface handsnew shader seaman_gloves
	surface brit_tank_tunic shader brit_tank_tunic
	surface brit_tank_pants shader brit_tank_pants

	path models/human/heads
	skelmodel head1.skd
	surface head shader brit_tank_corp

	// HELMET
	// =======================================================
	path models/human/gear/brit_tank_beret
}

init
{
	server
	{
		voicetype british // set the voicetype to use for multiplayer instant messaging
	}
}

$include models/player/base/include.txt
