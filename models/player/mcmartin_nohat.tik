TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/mcmartin.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	path models/human/SC_AL_US_INF			// Set path to set skelmodel from
	skelmodel sc_al_us_inf.skd			// Set body model

	surface Sc_Al_US_Inf_Pants shader Sc_AL_US_Inf_Pants
	surface Sc_Al_US_Inf_Tunic shader Sc_AL_US_Inf_Tunic

	path models/human/heads
	skelmodel head5.skd
	surface head shader Sc_Al_Mcmartin

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	path models/equipment/USGear
	skelmodel SC_AL_US_INF_GEAR.skd
	surface Sc_Al_US_Inf_gear shader SC_AL_US_INF_GEAR

	path models/equipment/USGear/helmets
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype american // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt