TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_british_tank.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52
	path models/human/SC_AL_Brit_INF	
	skelmodel sc_al_brit_inf.skd	

	// HZM coop - surface names must match SC_AL_BRIT_INF.skd EXACTLY. Retail shipped a typo here
	// (Sc_Al_brit_Inf__Pants / __Tunic, DOUBLE underscore) -> TIKI_InitTiki "could not find surface"
	// at every map load and both surfaces rendered with no shader. The skd has exactly two surfaces:
	// Sc_AL_brit_Inf_Pants and Sc_AL_brit_inf_Tunic (see allied_British_Cmd.tik, which is correct).
	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_Inf_Pants
	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_inf_Pants_blood1	// HZM coop - gore tier 1 (light)
	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_inf_Pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface Sc_AL_brit_inf_Tunic shader Sc_AL_brit_Inf_Tunic
	surface Sc_AL_brit_inf_Tunic shader SC_AL_brit_inf_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface Sc_AL_brit_inf_Tunic shader SC_AL_brit_inf_tunic_blood2	// HZM coop - gore tier 1 (heavy)

	path models/human/heads
	skelmodel head2.skd
	surface head shader old_dog

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew

	// HELMET
	// =======================================================
	path models/equipment/britgear

}

init
{
	server
	{
		voicetype british // set the voicetype to use for multiplayer instant messaging
	}
}

$include models/player/base/include.txt
