TIKI
setup
{
	path models/human/allied_pilot
	skelmodel allied_pilot.skd

	surface pants shader pilot_pants
	surface pants shader pilot_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader pilot_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface coat shader pilot_top
	surface coat shader pilot_top_blood1	// HZM coop - gore tier 1 (light)
	surface coat shader pilot_top_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullpants shader cull_pilot_pants
	surface cullpants shader cull_pilot_pants_blood1	// HZM coop - gore tier 1 (light)
	surface cullpants shader cull_pilot_pants_blood2	// HZM coop - gore tier 1 (heavy)

//	$include models/human/heads/us_old_heads.tik
	path models/human/heads
	skelmodel head1.skd
	surface head shader us_j

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	path models/equipment/germangear

	skelmodel officer_hat.skd
	surface officer_hat shader pilot_hat

	path models/gear/us
		
	skelmodel 45holster.skd
	surface 45holster shader 45holster
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype pilot // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end