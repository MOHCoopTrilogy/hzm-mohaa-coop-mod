TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/american_ranger_sergeant.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	path models/human/allied_pilot
	skelmodel allied_pilot.skd

	surface pants shader tanker_pants2
	surface coat shader tanker_jacket_rgr_sgt
	surface cullpants shader tanker_pants2

//	$include models/human/heads/us_old_heads.tik
	path models/human/heads
	skelmodel head2.skd		// Set head model
	surface head shader srg

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew

	path models/equipment/USGear/helmets


	path models/gear/us
		
	skelmodel 45holster.skd
	surface 45holster shader 45holster

	//skelmodel garandbelt.skd
	//surface garandbelt shader usammobelt

	path models/gear/us

	//skelmodel rangertommybelt.skd
	//surface tommybelt shader tommybelt

	skelmodel tommybelt.skd
	surface tommybelt shader tommybelt	//thompson pouch model for no haversack, for haversack/assaultvest use rangertommybelt

	path models/gear
	skelmodel 101_knife.skd
	surface 101_knife shader 101_knife

	skelmodel 101_granade.skd
	surface 101_granade shader 101_grenade
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype pilot // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
