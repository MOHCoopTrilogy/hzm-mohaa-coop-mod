TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_russian_corporal.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52

	path models/human/german_panzer_tankcommander	// Set path to set skelmodel from
	skelmodel panzer_tankcommander.skd

	surface coat1 shader soviet_corporal_tunic
	surface coat1 shader soviet_corporal_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface coat1 shader soviet_corporal_tunic_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader soviet_corporal_pants
	surface pants shader soviet_corporal_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader soviet_corporal_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface coat2 shader soviet_corporal_tunic
	surface coat2 shader soviet_corporal_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface coat2 shader soviet_corporal_tunic_blood2	// HZM coop - gore tier 1 (heavy)

	path models/human/heads
	skelmodel head1.skd
	surface head shader soviet_pvt_3

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew

	// GEAR
	// =======================================================
	path models/equipment/germangear
	skelmodel shovel.skd
	surface shovel shader german_gear

	// HELMET
	// =======================================================
	path models/equipment/USGear/helmets
}

init
{
	server
	{
		voicetype russian
	}
}

$include models/player/base/include.txt
