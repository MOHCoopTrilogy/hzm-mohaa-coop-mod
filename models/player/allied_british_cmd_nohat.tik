TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_british_cmd.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52
	path models/human/SC_AL_Brit_INF	          // Set path to set skelmodel from
	skelmodel sc_al_brit_inf.skd		// Set body model

	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_Inf_Pants
	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_inf_Pants_blood1	// HZM coop - gore tier 1 (light)
	surface Sc_AL_brit_Inf_Pants shader Sc_AL_brit_inf_Pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface Sc_AL_brit_inf_Tunic shader Sc_AL_Brit_CMD_Tunic
	surface Sc_AL_brit_inf_Tunic shader Sc_AL_Brit_CMD_Tunic_blood1	// HZM coop - gore tier 1 (light)
	surface Sc_AL_brit_inf_Tunic shader Sc_AL_Brit_CMD_Tunic_blood2	// HZM coop - gore tier 1 (heavy)
	surface pack shader Sc_AL_brit_inf_equip

	path models/human/heads
	skelmodel head2.skd
	surface head shader old_dog

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew

	// GEAR
	// =======================================================
	path models/equipment/britgear
	skelmodel SC_AL_BRIT_INF_GEAR.skd
	surface pack shader SC_AL_BRIT_INF_GEAR


	// HELMET
	// =======================================================
	path models/equipment/britgear

}

init
{
	server
	{
		voicetype british // set the voicetype to use for multiplayer instant messaging
	}
}

$include models/player/base/include.txt
