TIKI
setup
{
	path models/player/US_Army
	skelmodel USarmyplyr.skd
	
	surface viewsleeves shader viewsleeves_pilot
	surface triggerhand shader handview 
	surface triggerhand shader lthr_gloveview	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface triggerhand shader grmn_winter_glove	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface triggerhand shader coop_glove_uswinter_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface triggerhand shader coop_glove_mittens_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface triggerhand shader coop_glove_seaman_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface triggerhand shader handviewcold	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)
	surface lefthand shader handview
	surface lefthand shader lthr_gloveview	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface lefthand shader grmn_winter_glove	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface lefthand shader coop_glove_uswinter_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface lefthand shader coop_glove_mittens_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface lefthand shader coop_glove_seaman_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface lefthand shader handviewcold	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)
	surface garandhand shader handview
	surface garandhand shader lthr_gloveview	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface garandhand shader grmn_winter_glove	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface garandhand shader coop_glove_uswinter_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface garandhand shader coop_glove_mittens_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface garandhand shader coop_glove_seaman_view	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface garandhand shader handviewcold	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)
}

$define pulloutdir sound/weapons/pullout

$include models/player/base/include_fps.txt