TIKI
setup
{
	$path models/human/allied_army_soldier	// Set path to set skelmodel from
	skelmodel usarmy.skd			// Set body model

	surface ranger_pants shader medic_pants
	surface us_top shader medic_coat
	surface armband shader army_medic
	surface us_top_c shader medic_coat_c

	$path models/human/heads			// Set new path for head model
	skelmodel head1.skd		// Set head model
	surface head shader us_mike

	$path models/human/hands			
	skelmodel hand.skd		
	surface hand shader knitgloves1
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	path models/equipment/USGear/helmets
	skelmodel us_helmet.skd
	surface us_helmet shader medic_helmet

        path models/gear/us
	skelmodel garandbelt.skd
	surface garandbelt shader usammobelt
	
	path models/gear/us
	skelmodel 45holster.skd
	surface 45holster shader 45holster

	path models/gear/us
	skelmodel haversack.skd
	surface haversack shader usequip

	path models/gear/us
	skelmodel rangertommybelt.skd
	surface tommybelt shader tommybelt
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype russian // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end