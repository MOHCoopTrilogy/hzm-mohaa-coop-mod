TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/american_ranger_assault.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	path models/human/allied_ranger_soldier	// Set path to set skelmodel from
	skelmodel assaultvest.skd		// Set body model

	surface ranger_pants shader hbtpants
	surface ranger_top shader ranger_top
	surface armband shader av_pfc

	$path models/human/heads			// Set new path for head model
	skelmodel head1.skd		// Set head model
	surface head shader slick_dirty

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew

	path models/equipment/USGear/helmets


	path models/gear

	skelmodel ranger_knife.skd
	surface ranger_knife shader r_knife

	skelmodel ranger_2grenades.skd
	surface 2gren_right shader 2gren_right
	surface 2gren_left shader 2gren_left

}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype ranger // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
