TIKI
// HZM MP [bug-2754] GENERATED HATLESS VARIANT of models/player/german_winter_7_nco.tik for the MP appearance PREVIEW -
// identical to the original with the head-covering skelmodel/surface lines removed, so a chosen
// helmet does not double over the baked one in the 3D viewer. Regenerate with
// _research/nohat/gen_axis_nohat.py; do not hand-edit. (Live spawn already de-doubles via
// mp_cosmetics.scr::hideBakedHelmet; this twin is what the client menu model needs.)
setup
{
	path models/human
	skelmodel finwinter4.skd

	surface finwint_pants4 shader wehrmacht_pants_winter
	surface finwint_top4 shader winterparka_nco
	surface hand shader mittens2
	surface collar4 shader winterparka_nco

	path models/human/heads
	skelmodel head8.skd
	surface head shader gustav

	path models/gear/g_headgear


	path models/gear/winter

	skelmodel winterloadout.skd
	surface winterloadout shader german_gear

	path models/gear/officer

	skelmodel mp40clips.skd
	surface mp40clips shader ammo_pouch

	path models/gear/ss
	skelmodel ssholster.skd
	surface ssholster shader german_holster

	path models/human/hands
	skelmodel hand.skd
	surface hand shader knitgloves1

}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype axis5 // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
