TIKI
setup
{
	path models/human/manon   		// Set path to set skelmodel from
	skelmodel manon.skd			// Set body model

	surface coat shader manon_shirt
	surface coat shader manon_shirt_blood1	// HZM coop - gore tier 1 (light)
	surface coat shader manon_shirt_blood2	// HZM coop - gore tier 1 (heavy)
	surface cull_coat shader c_manon_shirt
	surface cull_coat shader c_manon_shirt_blood1	// HZM coop - gore tier 1 (light)
	surface cull_coat shader c_manon_shirt_blood2	// HZM coop - gore tier 1 (heavy)
	surface pants shader manon_pants
	surface pants shader manon_pants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader manon_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface inside shader manon_shirt
	surface hand shader manon_hands

	path models/human/heads			// Set new path for head model
	skelmodel manon_head.skd			// Set head model
	surface manon shader manon_head

	path models/gear/officer
		
	//skelmodel holster.skd
	//surface holster shader german_holster

	skelmodel mp40clips.skd
	surface mp40clips shader ammo_pouch

	//path models/gear/panzer
		
	//skelmodel panzerholster.skd
	//surface panzerholster shader german_holster

	//path models/gear/heer
	//skelmodel holster.skd
	//surface holster shader german_holster

	path models/equipment/germangear
	skelmodel german_holster.skd
	surface german_holster shader german_holster

	//path models/gear/ss
	//skelmodel ssholster.skd
	//surface ssholster shader german_holster


}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype manon // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
