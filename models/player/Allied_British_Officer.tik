TIKI
setup
{
	path models/britpack	// Set path to set skelmodel from
	skelmodel battledress.skd		// Set body model

	surface battledress_tunic shader britpistoltunic
	surface britparapants shader britprivatepants
	surface battledress_sleeve shader britprivatesleeve
	   

//	$include models/human/heads/us_young_heads.tik
	path models/human/heads
	skelmodel head1.skd
	surface head shader britpistolface

	path models/human/hands	
	skelmodel hand.skd		
	surface hand shader handsnew

	path models/britpack
	skelmodel british_offcap2.skd
	surface offcap2 shader britoffcap2

	path models/britpack
	skelmodel binoculars1.skd
	surface binoculars1 shader britbinoculars

	path models/britpack
	skelmodel british_holster.skd
	surface britholster shader britpackholster

	path models/britpack
	skelmodel british_canteen.skd
	surface britcanteen shader britpackcanteen



	
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype airborne // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
