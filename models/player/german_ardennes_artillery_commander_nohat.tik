TIKI
// HZM MP [bug-2754] GENERATED HATLESS VARIANT of models/player/german_ardennes_artillery_commander.tik for the MP appearance PREVIEW -
// identical to the original with the head-covering skelmodel/surface lines removed, so a chosen
// helmet does not double over the baked one in the 3D viewer. Regenerate with
// _research/nohat/gen_axis_nohat.py; do not hand-edit. (Live spawn already de-doubles via
// mp_cosmetics.scr::hideBakedHelmet; this twin is what the client menu model needs.)
setup
{
	scale 0.52

	path models/human/german_winter_type1
	skelmodel wintersoldier1.skd

	surface top shader wintertop1_art
	surface cullskirt shader cull_winterpants1_art
	surface skirt shader winterpants1_art
	
	path models/human/heads
	skelmodel head3.skd
	surface head shader bjorn

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader knitgloves1

	// GEAR
	// =======================================================
	path models/gear/winter

	skelmodel winterk98clips.skd
	surface winterk98clips shader german_riflebelt

	skelmodel winterloadout.skd
	surface winterloadout shader german_gear

	// HELMET
	// =======================================================
	path models/gear/g_headgear
}

init
{
	server
	{
		voicetype german // set the voicetype to use for multiplayer instant messaging
	}
}

$include models/player/base/include.txt

