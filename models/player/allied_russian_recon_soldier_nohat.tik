TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/allied_russian_recon_soldier.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52

	path models/human/german_wehrmact_soldier
	skelmodel heerprivate.skd

	surface wehrmact_tunic shader soviet_officer_tunic
	surface wehrmact_pants shader soviet_officer_pants
	surface wehrmact_tunic_c shader soviet_officer_tunic

	path models/human/heads
	skelmodel head1.skd
	surface head shader soviet_pvt_1

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew

	// GEAR
	// =======================================================

	// HELMET
	// =======================================================
}

init
{
	server
	{
		voicetype russian
	}
}

$include models/player/base/include.txt
