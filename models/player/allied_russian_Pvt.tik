TIKI
setup
{
	path models/human/german_afrika_private
	skelmodel daksoldier.skd


	surface pants shader Soviet_Private_pants
	surface tunic shader Soviet_Private_tunic
	surface c_tunic shader c_Soviet_Private_tunic

	path models/human/heads
	skelmodel head7.skd
//	surface head shader dolf
	surface head shader dolf

	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew


	path models/equipment/germangear
	skelmodel creasecap.skd
	surface creasecap shader Soviet_Private_hat

}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype russian 
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
