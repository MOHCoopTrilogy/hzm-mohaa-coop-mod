TIKI
// HZM MP [bug-2754] GENERATED HATLESS VARIANT of models/player/german_afrika_nco_shirt.tik for the MP appearance PREVIEW -
// identical to the original with the head-covering skelmodel/surface lines removed, so a chosen
// helmet does not double over the baked one in the 3D viewer. Regenerate with
// _research/nohat/gen_axis_nohat.py; do not hand-edit. (Live spawn already de-doubles via
// mp_cosmetics.scr::hideBakedHelmet; this twin is what the client menu model needs.)
setup
{
	path models/human/German_worker
	skelmodel german_worker.skd

	surface hand shader handsnew
	surface shirt shader DAK_shirt_NCO
	surface pants shader workpants_dak_olive

	path models/human/heads			// Set new path for head model
	skelmodel head1.skd			// Set head model
	surface head shader bensonazi

	path models/gear/g_headgear


	path models/gear/dak
		
	skelmodel dakloadout.skd
	surface dakloadout shader german_gear

	path models/gear/officer
		
	skelmodel holster.skd
	surface holster shader german_holster

	skelmodel mp40clips.skd
	surface mp40clips shader ammo_pouch		//ammo_pouch_tan
}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype axis4 // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
