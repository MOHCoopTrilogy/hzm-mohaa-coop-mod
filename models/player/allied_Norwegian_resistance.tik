TIKI
setup
{
	path models/human/french_resistance	// Set path to set skelmodel from
	skelmodel resistance.skd			// Set body model

	surface pants shader greypants	//brownpants
	surface pants shader greypants_blood1	// HZM coop - gore tier 1 (light)
	surface pants shader greypants_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullpants shader cull_greypants	//cull_brownpants
	surface cullpants shader cull_greypants_blood1	// HZM coop - gore tier 1 (light)
	surface cullpants shader cull_greypants_blood2	// HZM coop - gore tier 1 (heavy)
	surface shirt shader browncoat
	surface shirt shader browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface shirt shader browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface cullshirt shader cull_browncoat
	surface cullshirt shader cull_browncoat_blood1	// HZM coop - gore tier 1 (light)
	surface cullshirt shader cull_browncoat_blood2	// HZM coop - gore tier 1 (heavy)
	surface inside shader browncoat

//	$include models/human/heads/us_young_heads.tik
	path models/human/heads
	skelmodel head1.skd
	surface head shader wolfgang

	path models/human/hands
	skelmodel hand.skd
	surface hand shader knitgloves1
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	//path models/gear/g_headgear
	//skelmodel hat.skd
	//surface hat shader greyhat

	path models/dc
	skelmodel woolcap.skd
	surface woolcap shader woolcapdc

	path models/dc
	skelmodel british_dagger.skd
	surface britdagger shader britdaggerdc

	//path models/dc
	//skelmodel british_holster.skd
	//surface britholster shader britholsterdc

	//path models/dc
	//skelmodel british_canteen.skd
	//surface britcanteen shader britcanteendc

	path models/gear/officer	
	skelmodel holster.skd
	surface holster shader german_holster

}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype sas // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end