TIKI
// HZM coop [user 08-07] bug-1545 GENERATED HATLESS VARIANT of models/player/riflemannohelm.tik -
// identical to the original with the head-covering skelmodel/surface lines removed,
// so the helmet switcher's chosen piece is the only thing on the head. Regenerate with
// _research/nohat/nohat_build.py; do not hand-edit. Standard Issue re-attaches the original
// headgear as a coop_std_*.tik piece (coop_mod/helmet.scr::level.coop_skinStdHelmet).
setup
{
	scale 0.52
	path models/human/allied_army_soldier	// Set path to set skelmodel from
	skelmodel usarmy.skd			// Set body model

	surface ranger_pants shader 34th_pants2
	surface us_top shader 34th_jacket1
	surface armband shader 34th_privarm
	surface us_top_c shader 34th_jacket1_c

	path models/human/heads			// Set new path for head model
	skelmodel head2.skd			// Set head model
	surface head shader 34th_camohead
//	$include models/human/heads/us_young_heads.tik

	path models/human/hands

	path models/equipment/USGear/helmets

	path models/gear/us
	skelmodel garandbelt.skd
	surface garandbelt shader usammobelt
	skelmodel haversack.skd
	surface haversack shader usequip
}

init
{
	server
	{
      	voicetype pilot
	}
}

$include models/player/base/include.txt