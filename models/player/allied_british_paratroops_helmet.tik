TIKI
setup
{
	path models/6abs	// Set path to set skelmodel from
	skelmodel brit_para.skd		// Set body model

	surface britparatunic shader tunic6abs
	surface britparapants shader pants6abs
	surface britparasleeve shader sleeve6abs
	   

//	$include models/human/heads/us_young_heads.tik
	path models/human/heads
	skelmodel head1.skd
	surface head shader britparaface6abs1

	path models/human/hands			
	skelmodel hand.skd		
	surface hand shader handsnew

	path models/6abs
	skelmodel british_para_helmet_mask.skd
	surface britparamask shader britparamask6abs

	path models/6abs
	skelmodel british_dagger.skd
	surface britdagger shader britdagger6abs

	path models/6abs
	skelmodel british_holster.skd
	surface britholster shader britholster6abs	

	path models/6abs
	skelmodel british_canteen.skd
	surface britcanteen shader britcanteen6abs

	path models/6abs
	skelmodel british_showel.skd
	surface britshowel shader britshowel6abs

	path models/6abs
	skelmodel british_ammo.skd
	surface britammo shader britammo6abs



}


//
// define what folder to get specific sound from for the player model
//
$define pulloutdir sound/weapons/pullout


init
{
	client
	{
		// Cache sounds here
	}
	server
	{
		voicetype airborne // set the voicetype to use for multiplayer instant messaging
	}
}


//
// include the base player model definition
//
$include models/player/base/include.txt

// need to indicate the end of the tiki file because we have a tiki command at the end
//end
