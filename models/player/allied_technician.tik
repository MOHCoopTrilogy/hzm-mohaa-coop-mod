TIKI
setup
{
	scale 0.52

	path models/human/german_wehrmact_soldier
	skelmodel heerprivate.skd

	surface wehrmact_tunic shader allied_tech_tunic
	surface wehrmact_tunic shader allied_tech_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface wehrmact_tunic shader allied_tech_tunic_blood2	// HZM coop - gore tier 1 (heavy)
	surface wehrmact_pants shader allied_tech_pants
	surface wehrmact_pants shader allied_tech_pants_blood1	// HZM coop - gore tier 1 (light)
	surface wehrmact_pants shader allied_tech_pants_blood2	// HZM coop - gore tier 1 (heavy)
	surface wehrmact_tunic_c shader allied_tech_tunic
	surface wehrmact_tunic_c shader allied_tech_tunic_blood1	// HZM coop - gore tier 1 (light)
	surface wehrmact_tunic_c shader allied_tech_tunic_blood2	// HZM coop - gore tier 1 (heavy)

	path models/human/heads
	skelmodel head1.skd
	surface head shader slick

	// HANDS
	// =======================================================
	path models/human/hands
	skelmodel hand.skd
	surface hand shader handsnew
	surface hand shader l_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (1: Leather Gloves)
	surface hand shader knitgloves1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (2: Wool Knit Gloves)
	surface hand shader handssnow	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (3: US Winter Gloves)
	surface hand shader mittens2	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (4: Wool Mittens)
	surface hand shader seaman_gloves	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (5: Seaman's Gloves)
	surface hand shader hands_snow1	// HZM coop GLOVES [gen_gloves.py] - do not hand-edit (6: Alpine Hands)

	// GEAR
	// =======================================================

	// HELMET
	// =======================================================
	path models/equipment/USGear/helmets
	skelmodel us_helmet.skd
	surface us_helmet shader us-helmet_private
}

init
{
	server
	{
		voicetype american
	}
}

$include models/player/base/include.txt