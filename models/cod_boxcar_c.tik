TIKI
setup
{
	scale 1			
	path models/renan_models
	skelmodel cod_boxcar_c.skd
	surface rail_wheelface shader rail_wheelface 
	surface railcar_axle shader railcar_axle 
	surface railcar_beam1 shader railcar_beam1
	surface railcar_roof shader railcar_roof 
	surface railcar_spring shader railcar_spring
	surface railcar_trim shader railcar_trim
	surface boxcar_end shader boxcar_end 
	surface boxcar_floor shader boxcar_floor 
	surface boxcar_side shader boxcar_floor

}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle     cod_boxcar_c.skc
}

