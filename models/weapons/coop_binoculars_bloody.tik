TIKI
setup
{
	scale 0.52
	// Use the real binoculars model + its own animations so the player SEES binoculars
	// in hand when equipped (not a handgun, not an invisible weapon).
	path models/items/binoculars
	skelmodel binoculars.skd
	surface binoculars shader coop_skin_coop_binoculars_bloody
}

init
{
	server
	{
		classname		Weapon
		weapontype		pistol
		name			"Bombing Run (Bloody)"
		rank			1525 1525

		firetype		bullet
		ammotype		"binocstrike"
		meansofdeath	bullet
		semiauto
		bulletcount		1
		bulletrange		100
		bulletdamage	0
		// Fire FREELY - no ammo cost. The 3-strike limit AND the 10s gap are enforced
		// entirely in script (level.coop_binoc_uses + level.coop_binoc_laststrike in
		// binoculars_fired). Ammo/firedelay limits caused lost strikes after weapon
		// switches + cooldown-click drain, so they're removed.
		clipsize		0
		ammorequired	0
		usenoammo		1

		firedelay		1.0

		startammo		3
		sp startammo	3
		dm startammo	3

		weapongroup		binoculars
		airange			short
		autoputaway		0

		// Binocular "look through" zoom: press secondary fire (RMB) to zoom to FOV 20,
		// like the real binoculars item. Primary fire (LMB) still calls the strike.
		zoom			20 1
	}
	client
	{
	}
}

animations
{
	raise	binoculars.skc
	idle	binoculars.skc
	fire	binoculars.skc
	{
		server
		{
			entry shoot primary
		}
	}
	fire_empty	binoculars.skc
	{
		server
		{
			entry shoot primary
		}
	}
}
