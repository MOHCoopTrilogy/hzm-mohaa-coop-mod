TIKI

setup
{
	//[user 2026-08-17] East's Johnson M1941 (moh-db.com/mods/16967), imported as an ADDITION.
	//His mod replaces the M1 Garand outright AND ships its own fps_anims_rifle.txt, which would
	//have overwritten the first-person rifle table we maintain. Neither is taken. His shader
	//names were part1..part16 and his textures were textures/1.jpg..16.jpg at the texture ROOT,
	//so both are renamed here - johnson_part* over textures/coop_johnson/.
	//Everything below the setup block is OUR m1_garand.tik: same cartridge, same action, so our
	//.30-06 tuning is the right starting point.
	scale 0.52
	path models/weapons/coop_johnson
	skelmodel johnson.skd
	surface Tube4     shader coop_skin_johnson_m1941_camo_winter_0
	surface Tube1     shader coop_skin_johnson_m1941_camo_winter_1
	surface Cube1     shader coop_skin_johnson_m1941_camo_winter_2
	surface Cylinder1 shader coop_skin_johnson_m1941_camo_winter_3
	surface Cube5     shader coop_skin_johnson_m1941_camo_winter_4
	surface Cylinder4 shader coop_skin_johnson_m1941_camo_winter_5
	surface stock     shader coop_skin_johnson_m1941_camo_winter_6
	surface Tube3     shader coop_skin_johnson_m1941_camo_winter_7
	surface Cylinder3 shader coop_skin_johnson_m1941_camo_winter_8
	surface stock1    shader coop_skin_johnson_m1941_camo_winter_9
	surface Cube4     shader coop_skin_johnson_m1941_camo_winter_10
	surface Cube2     shader coop_skin_johnson_m1941_camo_winter_11
	surface Cube3     shader coop_skin_johnson_m1941_camo_winter_12
	surface Tube2     shader coop_skin_johnson_m1941_camo_winter_13
	surface Cube6     shader coop_skin_johnson_m1941_camo_winter_14
	surface Cylinder2 shader coop_skin_johnson_m1941_camo_winter_15
	//[user 2026-08-17] The clip is the RETAIL m1clip shader, which is what East pointed these two
	//surfaces at - his mod replaced the Garand, so it was already loaded. Re-pathing his gun onto
	//private names renamed it to johnson_clip, which nothing ever defined, so the magazine drew
	//untextured. He shipped 16 textures for 18 surfaces; the two missing ones were never his.
	//Same precedent as the sights below pointing at the retail thompsite.
	surface material4 shader m1clip
	surface material5 shader m1clip
}

init
{
	server
	{

	//========================================//
	//		WEAPON NAME		  		//
	//========================================//

		classname		Weapon
		weapontype		rifle
		name			"Johnson M1941 (Winter)"
		//[user 2026-08-17] UNIQUE rank. Derived tiks inherited the donor gun's rank (210),
		//which is what made this weapon unreachable in the weapon wheel after a give-all -
		//rank drives weapon-select order, so two guns on one rank shadow each other. 218 stays in the US rifle cluster with the Garand.
		rank			1576 1576
	//========================================//
	//		WEAPON ACCURACY 	  		//
	//========================================//

//		M1 Garand: Max Eff. Range is 300 yds with a muzzle velocity of 2800 ft/s. (30-06 Springfield)

		sp bulletrange		4000	 	//the range at which bulletspread is applied
		realism bulletrange	4000
		dm bulletrange		4000

		sp bulletspread		10 10 60 60 //minpitch minyaw maxpitch maxyaw
		dm bulletspread		10 10 80 80
		realism bulletspread	4 4 60 60

		sp firespreadmult	0.7 0.6 200 0.8
		dm firespreadmult 	0.75 0.6 200 0.8
		realism firespreadmult 	0.75 0.6 200 0.8

	//========================================//
	//		DAMAGE / RATE OF FIRE	  	//
	//========================================//

		sp bulletdamage		45
		dm bulletdamage		50

		sprealism bulletdamage	100
		dmrealism bulletdamage	75

		sp firedelay		0.15
		dm firedelay		0.18
		realism firedelay	0.18

		realism throughwood	24
		realism throughmetal	8

	//========================================//
	//		PLAYER MOVEMENT		  	//
	//========================================//

		sp movementspeed	1.0
		dm movementspeed	1.05	
		realism movementspeed	1.05

	//========================================//
	//		RIFLE BUTT / SECONDARY FIRE	//
	//========================================//

		secondary firetype			melee
		secondary ammotype			none
		secondary ammorequired		0
		secondary meansofdeath		bash
		secondary bulletknockback	50
		secondary quiet

		sp secondary bulletrange	64
		sp secondary bulletdamage	60

		dm secondary bulletrange	96
		dm secondary bulletdamage	60

		realism secondary bulletrange	96
		realism secondary bulletdamage	60

	//========================================//
	//		AMMO			  		//
	//========================================//

		firetype			bullet
		ammotype			"rifle"
		meansofdeath		bullet
		semiauto
//		cantpartialreload	// HZM coop: removed so the Garand reloads like other rifles (press Reload any time clip < full; clip_fill tops up from reserve)
		bulletcount			1
		clipsize			8
		ammorequired		1
		bulletlarge			1

		sp startammo		8
		dm startammo		64
		sprealism startammo	8
		dmrealism startammo	48

		// Additional DM Loadout
		dm additionalstartammo "grenade" 0
		dm additionalstartammo "smokegrenade" 0
		dm startitem "items/binoculars.tik"

		// Additional DM Realism Loadout
		dmrealism additionalstartammo "grenade" 0
		dmrealism additionalstartammo "smokegrenade" 0
		dmrealism startitem "items/binoculars.tik"

	//========================================//
	//		CROSSHAIR, ZOOM, TRACERS  	//
	//========================================//

		sp tracerfrequency 	2
		dm tracerfrequency 	0
		sprealism tracerfrequency 	2
		dmrealism tracerfrequency 	0

		crosshair			1

	//========================================//
	//		SOUND, AI, OTHER	  		//
	//========================================//

		surface material8 +nodraw		

		pickupsound		m1_snd_pickup
		ammopickupsound	m1_snd_pickup_ammo
		noammosound		m1_snd_noammo

		// Holstering info
holstertag				"Bip01 Spine2"
holsteroffset			"8.0 -7.75 6.5"
holsterangles			"0 185 -25"
holsterScale			1.0

		// AI animation group info
		weapongroup		rifle
		airange			long

		// this is attached to the player during reload
		cache models/ammo/garand_clip_reload.tik

		//[200] Smithy - get handled
		exec coop_mod/itemhandler.scr "initialiseItem" "rifle" "M1 Garand"
	}
	client
	{
		cache tracer.spr
		cache muzsprite.spr
		cache vsssource.spr
		cache models/fx/muzflash.tik
		cache models/ammo/rifleshell.tik
		cache models/fx/snipesmoke.tik
		cache models/ammo/garand_clip_empty.tik
	}
}

animations
{
	//[user 2026-08-17] East's own 73-frame idle/fire and reload. The empty-magazine poses fall
	//back to retail's garand_empty.skc by FULL path - he never shipped one, and a bare name would
	//resolve under coop_johnson/ and 404 the way his own tik did.
	//The reload's hide/show is retargeted from 'material8', which this mesh does not have, onto
	//material4/material5 - the surfaces his own setup block skins as the clip - so the magazine
	//actually disappears during the reload instead of the command silently doing nothing.
	idle		johnson_idle.skc
	idle_empty	garand_empty.skc
	secondaryfire	johnson_idle.skc
	fire_empty	garand_empty.skc
	reload		johnson_reload.skc
	{
		server
		{
			28 surface material4 -nodraw
			28 surface material5 -nodraw
			48 surface material4 +nodraw
			48 surface material5 +nodraw
			last idle
		}
		client
		{
			entry sound m1_snd_reload
		}
	}
	fire	johnson_idle.skc
	{
		server
		{
			entry shoot
		}
		client
		{
			entry stopaliaschannel johnson_snd_fire
			entry sound johnson_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -2.5 -2.5   -0.1 -0.1   0.15   "T"  8.0 8.2 3.6

//			entry viewkick 	    -3.0 -3.0   -0.1 -0.1   0.15   "T"  8.0 8.2 3.6//original recent
//			entry viewkick 	    -1.0 -1.0   -0.1 -0.1   0.45   "T"  8.0 8.2 3.6//original old

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 150 0.11
			entry tagspawnlinked tag_barrel
			(
				count 1
				model models/fx/muzflash.tik
				color 0.00 0.00 1.00
				scale 0.20
				life 0.01
				velocity 300.00
				alignstretch 0.02
				randomroll
			)

			entry tagspawnlinked tag_barrel
			(
				count 1
				model muzsprite.spr
				color 1.00 1.00 1.00
				scale 0.10
				scalerate 10
				life 0.04
			)

			entry tagspawn tag_barrel
			(
				count 1
				scale .7
				model models/fx/garandsmoke.tik
			)

			// shell eject
			entry tagspawn tag_eject
			(
				spawnrange 2048
				count 1
				model models/ammo/rifleshell.tik
				scale 1.0
				velocity 70
				randvel crandom 10 crandom 10 random 20
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.2
				bouncesoundonce snd_rifle_shell
			)

			// smoke puff
//			entry commanddelay 0.05 tagspawn tag_barrel
//			(
//				volumetric
//				model gun			// sets the type of smoke
//				life 10				// amount of smoke
//				scale 1.5			// radius
//				alpha 0.4			// density
//				color 0.7 0.7 0.7		// RBG color of the smoke
//				velocity 2			// base velocity away from the surface
//				randvelaxis random 6 0 0	// velocity offset
//				offsetalongaxis random 4 0 0	// positional offset
//			)
		}
	}
}

/*QUAKED addon_playerweapon_allied_m1-Garand (0.0 0.0 1.0) (-8 -8 -8) (8 8 8)
American rifle - M1 Garand.
*/