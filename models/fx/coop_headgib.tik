TIKI
// HZM coop [user 2026-08-19] DECAP HEAD GIB: the tumbling head-mass thrown by
// Sentient::CoopGoreDeathKinetics. Crossed-quad xbeam mesh (view-angle safe, same donor as
// the neck stump); shader coop_headgib = the gib-tier face texture soaked in #150200. At
// scale 2.6 it reads ~5u across - head-sized. Nonsolid, bouncing, removed after coop_decapLife.
setup
{
	scale 2.6
	path models/fx/xbeam
	skelmodel xbeam.skd
	surface all shader coop_headgib
}
animations
{
	idle xbeam.skc
}
