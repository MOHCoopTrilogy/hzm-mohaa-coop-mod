TIKI
// HZM coop - GORE TIER 3 (hit-location wound props): tiny bullet-wound patch the engine attaches at
// the LBD hit bone (sentient.cpp CoopGoreTryWoundProp, cap 4 per body, cvar coop_goreWounds).
// Mesh is the retail crossed-quad xbeam (models/fx/xbeam.skd - "an x which is 1 unit in all
// dimensions") so the wound reads from any viewing angle without orientation control; at scale 2.2
// the patch is ~4.2 units across. Shader coop_wound1 (scripts/coop_blood.shader) carries hole +
// blood art baked at the mod's exact blood hue #150200 / RGB(21,2,0) - NEVER stock red (see
// _research/player_gore_research.md section 6c).
setup
{
	scale 2.2
	path models/fx/xbeam
	skelmodel xbeam.skd
	surface all shader coop_wound1
}
animations
{
	idle xbeam.skc
}
