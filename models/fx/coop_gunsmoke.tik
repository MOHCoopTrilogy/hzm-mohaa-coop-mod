TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	server
	{
	}
	client
	{
		cache vsssource.spr

		// HZM coop - SMOKE WHIPS: a lingering gun-smoke cloud spawned at the muzzle + at bullet impacts
		// (SFX_COOP_GUNSMOKE, fired from cg_parsemsg.cpp, gated by the coop_smokeWhip* cvars). Tuned to
		// actually STICK AROUND - slow, fat, semi-opaque puffs that grow, drift up/out, and fade over a few
		// seconds. To dial: alpha/scale/life/count here (baked - needs a repack), or the spawn CHANCE cvars.
		// HZM fix (bug-1172): user-reported "ginormous puffs" on bullet impacts - scale/scalerate roughly
		// halved from the original tuning (0.4/0.3 start, 2.5/3.0 growth) so impact puffs stay noticeable
		// without ballooning to an unrealistic size over their 1.3-1.6s life.
		sfx originspawn
		(
			model vsssource.spr
			count 1
			scalerate 1.3
			angles 0 0 random 360
			avelocity 0 0 crandom 30
			life 1.3
			scale 0.2
			alpha 0.38
			color 0.58 0.58 0.58
			spritegridlighting
			velocity 14
			randvelaxis random 5 5 7
			offsetalongaxis 2 crandom 2 crandom 2
			fade
		)
		sfx originspawn
		(
			model vsssource.spr
			count 1
			scalerate 1.5
			angles 0 0 random 360
			avelocity 0 0 crandom 18
			life 1.6
			scale 0.15
			alpha 0.26
			color 0.62 0.62 0.62
			spritegridlighting
			velocity 8
			randvelaxis random 4 4 9
			offsetalongaxis 3 crandom 2 crandom 2
			fade
		)
	}
}
