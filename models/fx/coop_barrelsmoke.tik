TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	server
	{
	}
	client
	{
		cache vsssource.spr

		// HZM coop - BARREL WISP: a SHORT, small smoke wisp that trails back off the barrel right after a
		// shot. Spawned at the muzzle by cg_parsemsg.cpp (SFX_COOP_BARRELSMOKE) with angles pointing BACK
		// toward the shooter, so it drifts back along the gun rather than out in front of your face. Kept
		// brief + thin on purpose (life ~0.6s, small scale, low alpha). Dial it here (needs a repack) or via
		// the spawn CHANCE cvar coop_barrelSmoke.
		sfx originspawn
		(
			model vsssource.spr
			count 1
			scalerate 1.8
			angles 0 0 random 360
			avelocity 0 0 crandom 22
			life 0.6
			scale 0.18
			alpha 0.30
			color 0.6 0.6 0.6
			spritegridlighting
			velocity 24
			randvelaxis random 3 3 4
			offsetalongaxis 2 crandom 1 crandom 1
			fade
		)
	}
}
