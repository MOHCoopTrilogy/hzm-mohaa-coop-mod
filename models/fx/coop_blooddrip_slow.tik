TIKI
// HZM coop - GORE TIER 2 (blood drip): SLOW looping drip, attached by the engine (game.dll
// Sentient::CoopGoreTryDripAttach) to a badly WOUNDED but still standing human - enemy AI and
// allied AI (bug-792: NEVER players - no body gore on players; their bouncedecal splats also
// read as a premature "pool" under a stationary wounded player).
// Half-rate sibling of coop_blooddrip.tik (the corpse bleed-out version);
// see that file for the full recipe notes. Streaks leave the mod's coop_bloodsplat mark on landing.
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	client
	{
		//cache some stuff used in this effect
		cache models/fx/coop_blooddrip_long.tik
		cache coop_blood_drop.spr

		// falling streaks - splat a coop_bloodsplat mark where they land
		originemitter coop_dripstreak
		(
			spawnrate 0.8
			model models/fx/coop_blooddrip_long.tik
			align
			alpha 0.9
			life 1.2
			fadedelay 1.0
			scalemin 0.6
			scalemax 0.9
			offsetalongaxis crandom 3 crandom 3 crandom 3
			randvelaxis crandom 4 crandom 4 0
			accel 0 0 -800
			collision
			dietouch
			bouncedecal
			decalshader coop_bloodsplat
			decalradius 6
			physicsrate every
		)

		// droplet sprites - visual filler between streaks
		// bug-735: rates/scales raised - the old 0.07-0.12 sprites were sub-pixel at gameplay distance
		originemitter coop_dripdrop
		(
			spawnrate 1.4
			model coop_blood_drop.spr
			alpha 0.9
			life 1.0
			fadedelay 0.8
			scalemin 0.14
			scalemax 0.22
			offsetalongaxis crandom 3 crandom 3 crandom 3
			randvelaxis crandom 6 crandom 6 0
			accel 0 0 -800
			collision
			dietouch
			physicsrate every
		)
	}
}

// This section is just needed to be a valid tiki file
animations
{
	idle dummy2.skc
}
