TIKI
// HZM coop [gore phase A] the ARTERY jet's falling streak (clone of coop_blooddrip_long.tik, same retail splinter mesh)
// wearing the bright coop_artery_streak shader.
setup
{
	scale 0.52
	path models/fx/splinter
	skelmodel splinter.skd
	surface material1 shader coop_artery_streak
}
animations
{
	idle splinter.skc
}
