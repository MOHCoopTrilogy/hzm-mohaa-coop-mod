TIKI
// HZM coop [user 2026-08-19] DANGLING EYEBALL: attached at "Bip01 Head" with a socket offset
// on a slice of confirmed headshot kills (Sentient::CoopGoreHeadshotExtras). Tiny crossed-quad
// so it reads from any angle; shader coop_eyegib = authored eye-on-sinew texture.
setup
{
	scale 0.45
	path models/fx/xbeam
	skelmodel xbeam.skd
	surface all shader coop_eyegib
}
animations
{
	idle xbeam.skc
}
