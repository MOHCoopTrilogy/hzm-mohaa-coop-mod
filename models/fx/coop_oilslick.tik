TIKI
// [user 2026-08-09] flat oil-slick plane for the sortie finale. Reuses the retail waterPlane
// mesh (models/miscobj/waterPlane/water_plane.skd - the tehao puddle emitters prove the mesh
// out) with our slick shader on its one surface. Scaled up live by script as she burns.
setup
{
	scale 1.0
	path models/miscobj/waterPlane
	skelmodel water_plane.skd
	surface water_plane shader coop_oilslick
}

init
{
	server
	{
		classname effectentity
		notsolid
	}
}

animations
{
	idle water_plane.skc
}
