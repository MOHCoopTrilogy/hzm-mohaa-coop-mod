TIKI
// HZM coop [user 2026-08-31] BLOOD SLICK - flat blood plane for the Omaha waterline and the beach.
//
// Byte-for-byte the same recipe as models/fx/coop_oilslick.tik (the m2l2b sortie slick), which is the
// proven way to lay a flat stain on a surface in this project: the retail waterPlane mesh with one
// surface, wearing our own privately-named shader. Reusing that recipe rather than inventing one is
// the project's standing rule.
//
// NOTE the mesh lives in maintt/pak1.pk3 (models/miscobj/waterPlane), NOT in main/ or mainta/. That is
// fine under the normal com_target_game 2 launch, which mounts main + mainta + maintt, and the shipped
// coop_oilslick.tik already carries the same dependency - but it is worth stating rather than
// discovering.
setup
{
	scale 1.0
	path models/miscobj/waterPlane
	skelmodel water_plane.skd
	surface water_plane shader coop_bloodslick
}

init
{
	server
	{
		classname effectentity
		notsolid
	}
}

animations
{
	idle water_plane.skc
}
