TIKI
// HZM coop [user 2026-08-19] GENERIC MEAT CHUNK: brain pieces / explosion viscera thrown by
// Sentient::CoopGoreThrowChunks (budgeted). Crossed-quad xbeam + the solid #150200 blood-blob
// shader (coop_stump) - reads as a wet red mass from every angle. Scale set per-throw.
setup
{
	scale 1.4
	path models/fx/xbeam
	skelmodel xbeam.skd
	surface all shader coop_stump
}
animations
{
	idle xbeam.skc
}
