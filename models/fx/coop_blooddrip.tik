TIKI
// HZM coop - GORE TIER 2 (blood drip): FULL-RATE looping drip, attached by the engine (game.dll
// Sentient::CoopGoreTryDripAttach) to a FRESH CORPSE's torso bone for a short bleed-out window.
// Re-skin of the oil-barrel leak recipe (barrel_oil_leak_small/_splat donors): persistent
// originemitter blocks (spawnrate = models/sec, runs as long as this entity exists) spawn falling
// streaks + droplet sprites; the streak carries collision+dietouch+bouncedecal so EVERY drip leaves
// the mod's existing coop_bloodsplat ground mark where it lands - client-side, no protocol traffic.
// Color authority: everything here resolves to #150200 art (see coop_blood.shader). Rates are kept
// low on purpose - the engine also caps concurrent drip emitters (~8) for perf.
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	client
	{
		//cache some stuff used in this effect
		cache models/fx/coop_blooddrip_long.tik
		cache coop_blood_drop.spr

		// falling streaks - splat a coop_bloodsplat mark where they land
		originemitter coop_dripstreak
		(
			spawnrate 2.2
			model models/fx/coop_blooddrip_long.tik
			align
			alpha 0.9
			life 1.2
			fadedelay 1.0
			scalemin 0.7
			scalemax 1.1
			offsetalongaxis crandom 3 crandom 3 crandom 3
			randvelaxis crandom 4 crandom 4 0
			accel 0 0 -800
			collision
			dietouch
			bouncedecal
			decalshader coop_bloodsplat
			decalradius 8
			physicsrate every
		)

		// droplet sprites - visual filler between streaks
		// bug-735: rates/scales raised - the old 0.08-0.14 sprites were sub-pixel at gameplay distance
		originemitter coop_dripdrop
		(
			spawnrate 3.5
			model coop_blood_drop.spr
			alpha 0.9
			life 1.0
			fadedelay 0.8
			scalemin 0.16
			scalemax 0.26
			offsetalongaxis crandom 3 crandom 3 crandom 3
			randvelaxis crandom 6 crandom 6 0
			accel 0 0 -800
			collision
			dietouch
			physicsrate every
		)
	}
}

// This section is just needed to be a valid tiki file
animations
{
	idle dummy2.skc
}
