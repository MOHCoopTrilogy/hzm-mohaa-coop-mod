TIKI
// HZM coop - GORE TIER 2 (blood drip): the falling blood STREAK model. Clone of the oil-barrel
// streak (models/fx/barrel_oil_long.tik - same retail splinter.skd mesh) pointing at our own
// coop_blood_long shader (scripts/coop_blood.shader), whose texture is the mod's exact blood hue
// #150200 / RGB(21,2,0) with the retail streak's alpha shape. NEVER point this at the barrel_oil_*
// shaders - wrong hue (see _research/player_gore_research.md section 6c).
setup
{
	scale 0.52
	path models/fx/splinter
	skelmodel splinter.skd
	surface material1 shader coop_blood_long
}
animations
{
	idle splinter.skc
}
