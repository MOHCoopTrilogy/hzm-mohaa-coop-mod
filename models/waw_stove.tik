{
	scale .75			
	path models/renan_models
	skelmodel waw_stove.skd
	surface waw_stove shader stove5
	surface waw_stove1 shader stove5
	surface waw_stove2 shader stove5
	surface waw_stove3 shader stove5
	surface waw_stove4 shader stove5
	surface waw_stove5 shader stove5
	surface waw_stove6 shader stove5
	surface waw_stove7 shader stove5
	surface waw_stove8 shader stove5
}

init
{
	server
	{
		classname object
	}
}

animations
{
	idle     waw_stove.skc
}

