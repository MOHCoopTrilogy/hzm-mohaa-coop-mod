// [user 08-02] SHIPPED BY THE COOP MOD ON PURPOSE - do not delete.
// Extracted from pak1.pk3 and hardened for coop: NULL-guarded actor refs and
// de-singularised $player. Everything else is retail-verbatim.
//
// gags/t3l1_fourrussians.scr
//
// Four russian soldiers talking, then fighting.
//

main:
end


DoRussians:

	level.subtitle_save = getcvar g_subtitle

	setcvar g_subtitle 1

	wait 6
	// [user 08-02] HZM coop - NULL-GUARDED. These four were bare references, and a throw on any
	// one of them aborts DoRussians - which is the master opening chain: it calls DoSanta
	// (the scripted mortar/Panzerschrek explosion, 'thread global/exploder.scr::explode 210')
	// and then initobjectives + objective1. So one missing actor silently costs the opening
	// explosion AND the entire objective chain. The soldiers are addon_ai_soviet_* markers, so
	// instantiation is not guaranteed.
	if ( $startingsoldier1 != NULL ){ $startingsoldier1 thread PlayAnim 31R100_idle01 NIL }
	if ( $startingsoldier2 != NULL ){ $startingsoldier2 thread PlayAnim 31R200_idle01 5 }
	if ( $startingsoldier3 != NULL ){ $startingsoldier3 thread PlayAnim 31R300_idle01 6 }
	if ( $startingsoldier4 != NULL ){ $startingsoldier4 thread PlayAnim 31R400_idle01 7 }

	wait 19
	thread gags/t3l1_enemyspawn.scr::DoSanta


	setcvar g_subtitle level.subtitle_save
	
	wait 4
	// [user 08-02] TRAPS T5: bare $player is an array in coop and throws, killing DoRussians
	// before it reaches initobjectives/objective1.
	for ( local.pi = 1; local.pi <= $player.size; local.pi++ ) { if ( $player[local.pi] != NULL ) { $player[local.pi] useweaponclass smg } }
	for ( local.pj = 1; local.pj <= $player.size; local.pj++ ) { if ( $player[local.pj] != NULL ) { $player[local.pj] physics_on } }
	drawhud 1

	$startingsoldier1 lookat $player[1]
	$startingsoldier1 turnto $player[1]

	// initialize the objective list
	waitthread maps/t3l1.scr::initobjectives
 
	// start the thread that waits for objective 1 completion
	thread maps/t3l1.scr::objective1


//	$player stufftext "tmstop"
//	$player stufftext "tmstart sound/music/Kleveburg.mp3"

	wait 10
	$startingsoldier1 lookat NULL
	$startingsoldier1 turnto NULL

	
	end

PlayAnim local.anim local.index:

	self nodamage
	self exec global/disable_ai.scr
	self.no_idle = 1
	self anim local.anim
	self waittill animdone
	self exec global/enable_ai.scr
	self takedamage

	if ( local.index==NIL )
	{
		if ( $wave1!=NIL && $wave1.size>0 )
		{
			local.random = randomint $wave1.size
			if ( local.random==0 )
				local.random++

			self setaimtarget $wave1[local.random] 1
			self runto $wave1[local.random]
		}
	}
	else
	{
		if ( $wave3!=NIL && $wave3.size>=local.index )
		{
			self setaimtarget $wave3[local.index] 1
			self runto $wave3[local.index]
		}
	}

	wait 1
	self.no_idle = 0
	
	end

