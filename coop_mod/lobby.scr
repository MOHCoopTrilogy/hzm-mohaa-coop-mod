//==========================================================================================================//
// HZM Coop - Pre-Mission Lobby module.  Full spec: _research/coop_lobby1_build.md
//
// Called from maps/co_lobby1.scr::main after prespawn. PHASE A scope: spawn the placed props, build the
// single static camera every player views through, place the squad at the 4 anchor points, and lock them
// (no move / look / fire) while leaving the menu, console, quit and text chat fully usable.
// Idle-emote rotation, overhead rank/name, ready-up, skin cycle, music and the briefing launch are wired
// in later phases (marked STUB below).
//==========================================================================================================//

//=========================================================================
lobbyMapMain:{
//=========================================================================
	level.coop_lobbyActive = 1
	// NOTE: do NOT freezeplayer here - the level-global freeze pins players in the spawn CROUCH before the
	// at-ease pose can stand them up. The lock is per-player freezecontrols, applied AFTER the pose is set
	// (lobbyPoseAndFreeze) + re-asserted each frame (lobbyLockWatch) to survive the respawn m_bFrozen reset.

	// lobby players sit idle by design - stop the inactivity timer from spec-booting them (the
	// auto-spawn loop would then re-join them, causing a respawn flicker). Restored at teardown (Phase D).
	level.coop_lobbyPrevInactiveSpec = getcvar "g_inactivespectate"
	setcvar "g_inactivespectate" "0"
	setcvar "g_inactivekick" "0"

	// g_forcerespawn only auto-respawns DEAD players - it is NOT the deploy mechanism (that is
	// lobbyAutoSpawnLoop + skipTeamAndWeaponSelect). Keep it 1 for later dead-respawns; it MUST be
	// restored on launch (teardown) or a leaked =1 auto-respawns DBNO'd players in the mission.
	level.coop_lobbyPrevForceRespawn = getcvar "g_forcerespawn"
	setcvar "g_forcerespawn" "1"

	// lobby soldiers stay ARMED (rifle slung) so the EMOTE_ATEASE pose holds: the emote system's proven
	// path is an armed player - going unarmed risks the -HAS_WEAPON edge cancelling the pose to STAND.

	// --- the 4 player anchor points (viewpos coords recorded in training space; yaw only) ---
	level.coop_lobbySlotOrg[1] = ( -5264 -498 -227 )
	level.coop_lobbySlotYaw[1] = 101
	level.coop_lobbySlotOrg[2] = ( -5446 -438 -227 )
	level.coop_lobbySlotYaw[2] = 74
	level.coop_lobbySlotOrg[3] = ( -5377 -393 -227 )
	level.coop_lobbySlotYaw[3] = 86
	level.coop_lobbySlotOrg[4] = ( -5301 -378 -227 )
	level.coop_lobbySlotYaw[4] = 83

	// point the coop spawn system at the anchors too, so the first spawn + any late joiner lands here
	level.flags["coop_spawn1origin"] = level.coop_lobbySlotOrg[1]
	level.flags["coop_spawn2origin"] = level.coop_lobbySlotOrg[2]
	level.flags["coop_spawn3origin"] = level.coop_lobbySlotOrg[3]
	level.flags["coop_spawn4origin"] = level.coop_lobbySlotOrg[4]

	thread spawnProps
	waitthread spawnLobbyCamera
	thread lobbyCamTune
	thread lobbyAutoSpawnLoop
}end

//=========================================================================
// The single static camera at anchor #1. Every player is bound to this one entity, so the whole
// squad shares the same framed shot. Pitch/yaw are live-tunable via cvars for on-the-fly framing.
//=========================================================================
spawnLobbyCamera:{
//=========================================================================
	// A Camera IGNORES .origin= and .angles= (same class of no-op as moveto on a script_model; proven
	// by LOBBYDBG: the cam stayed at 0 0 0). Position it with 'movetopos' and aim it with 'watch' at a
	// look-at marker - the t2l2 recipe. bug-360.
	level.coop_lobbyCam = spawn Camera
	level.coop_lobbyCam.targetname = "coop_lobbyCam"
	level.coop_lobbyLookAt = spawn script_origin targetname "coop_lobbyLookAt"
	waitthread applyLobbyCam
	if( level.coop_lobbyCam != NULL ){ level.coop_lobbyCam cut }
}end

//=========================================================================
// Position + aim the shared camera from cvars (live-tunable). Camera at coop_lobbyCamX/Y/Z looks at the
// squad-centre marker at coop_lobbyLookX/Y/Z. Defaults frame the 4 slots from the front.
//=========================================================================
applyLobbyCam:{
//=========================================================================
	// DEFAULTS = the user's original captured viewpos:  (-5304 -248 -237) : yaw 230.
	// The look-at (-5497 -478 -237) is that origin projected 300u along yaw 230 (pitch 0), so 'watch'
	// aims the camera exactly on the recorded facing. FOV 80 matches the player's own cg_fov.
	local.cx = getcvar "coop_lobbyCamX"
	if( local.cx == "" ){ local.cx = "-5304" }
	local.cy = getcvar "coop_lobbyCamY"
	if( local.cy == "" ){ local.cy = "-248" }
	local.cz = getcvar "coop_lobbyCamZ"
	if( local.cz == "" ){ local.cz = "-237" }
	local.cxi = int( local.cx )
	local.cyi = int( local.cy )
	local.czi = int( local.cz )

	local.lx = getcvar "coop_lobbyLookX"
	if( local.lx == "" ){ local.lx = "-5497" }
	local.ly = getcvar "coop_lobbyLookY"
	if( local.ly == "" ){ local.ly = "-478" }
	local.lz = getcvar "coop_lobbyLookZ"
	if( local.lz == "" ){ local.lz = "-237" }
	local.lxi = int( local.lx )
	local.lyi = int( local.ly )
	local.lzi = int( local.lz )

	local.fov = getcvar "coop_lobbyCamFov"
	if( local.fov == "" ){ local.fov = "80" }
	local.fovi = int( local.fov )

	if( level.coop_lobbyLookAt != NULL ){
		level.coop_lobbyLookAt.origin = ( local.lxi local.lyi local.lzi )
	}
	if( level.coop_lobbyCam != NULL ){
		level.coop_lobbyCam movetopos ( local.cxi local.cyi local.czi )
		if( level.coop_lobbyLookAt != NULL ){
			level.coop_lobbyCam watch level.coop_lobbyLookAt 0
		}
		level.coop_lobbyCam fov local.fovi
	}
}end

//=========================================================================
lobbyCamTune:{
//=========================================================================
	// cheap live-tune loop: re-reads the framing cvars so the camera can be dialed in-game
	while( level.coop_lobbyActive == 1 ){
		waitthread applyLobbyCam
		wait 0.5
	}
}end

//=========================================================================
// Auto-spawn: force any spectator straight onto allies (skips the team/weapon-select click) so the
// squad just appears in the lobby. PER-FRAME scan (F3) so a spectator is force-joined the same frame it
// becomes one - kills the multi-second deploy limbo / "click to spawn". join_team while already allied is
// a no-op, so once everyone is deployed the loop costs nothing.
//=========================================================================
lobbyAutoSpawnLoop:{
//=========================================================================
	while( level.coop_lobbyActive == 1 ){
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.player = $player[local.i]
			if( local.player != NULL ){
				if( local.player.dmteam == "spectator" ){
					waitthread coop_mod/main.scr::skipTeamAndWeaponSelect local.player
					local.player.flags["coop_lobbyDeployTry"] = NIL
				}
				else if( local.player.flags["coop_isActive"] != 1 && local.player.flags["coop_lobbyDeployTry"] != 1 ){
					// Joined allies but the engine gates the actual SPAWN behind a fire-click (player.cpp:4959);
					// g_forcerespawn only auto-deploys DEAD players (4940) and a fresh joiner never died. Force
					// the deploy ONCE with a direct respawn (EV_Player_Respawn) - kills the ~10s click limbo.
					local.player.flags["coop_lobbyDeployTry"] = 1
					local.player respawn
				}
			}
		}
		waitframe
	}
}end

//=========================================================================
// Called from co_lobby1.scr on every (re)spawn: seat this player at their slot, lock them, and hand
// their view to the shared static camera. Runs AFTER the spawn completes, so the camera view holds.
//=========================================================================
lobbyOnSpawn local.player:{
//=========================================================================
	if( local.player == NULL || local.player == $world ){ end }
	if( level.coop_lobbyActive != 1 ){ end }

	// assign a slot once (round-robin 1..4)
	if( local.player.flags["coop_lobbySlot"] == NIL ){
		if( level.coop_lobbyNextSlot == NIL ){ level.coop_lobbyNextSlot = 1 }
		local.player.flags["coop_lobbySlot"] = level.coop_lobbyNextSlot
		level.coop_lobbyNextSlot = level.coop_lobbyNextSlot + 1
		if( level.coop_lobbyNextSlot > 4 ){ level.coop_lobbyNextSlot = 1 }
	}
	local.slot = local.player.flags["coop_lobbySlot"]

	// feet-on-ground: slot origins were recorded at EYE height (viewpos); drop by the standing view height.
	local.drop = getcvar "coop_lobbyFeetDrop"
	if( local.drop == "" ){ local.drop = "82" }
	local.di = int( local.drop )
	local.feet = level.coop_lobbySlotOrg[local.slot] - ( 0 0 local.di )

	local.player.flags["coop_lobbyYaw"] = level.coop_lobbySlotYaw[local.slot]
	local.player.flags["coop_lobbyOrg"] = local.feet

	// AVENUE #2: the VISIBLE body is a script_model MANNEQUIN wearing the player's OWN chosen skin
	// (lobbySpawnMannequin) - it has no player statemap / weapon / freeze fight, so it animates fluidly like
	// the MP skin-select menu. The REAL player is just an INVISIBLE, locked camera-viewer. So here we only
	// plant + HIDE + lock the player and bind the shared camera - NO pose, NO holster, NO unhide. Any residual
	// weapon/anim churn on the real player is never seen, which is what makes the whole freeze fight moot.
	local.player.origin = local.feet
	local.player.angles = ( 0 level.coop_lobbySlotYaw[local.slot] 0 )
	local.player.viewangles = ( 0 level.coop_lobbySlotYaw[local.slot] 0 )
	local.player.flags["coop_lobbyFrozen"] = 1
	local.player hide

	// hide the coop HUD (health/ammo/objectives slots) + compass for this client
	local.player thread lobbyHideHud

	// every player views the ONE shared static camera. Re-cue per spawn so late joiners pick it up.
	if( level.coop_lobbyCam != NULL ){
		level.coop_lobbyCam cut
		cuecamera level.coop_lobbyCam
	}

	// lock the (invisible) body so it can't drift/jump/rotate the shared shot; lobbyLockWatch re-asserts it
	// every frame (m_bFrozen resets on the coop respawn churn).
	local.player freezecontrols 1
	if( local.player.flags["coop_lobbyLockWatch"] != 1 ){
		local.player.flags["coop_lobbyLockWatch"] = 1
		local.player thread lobbyLockWatch
	}

	// hide the vanilla engine HUD (star/compass/ammo/crosshair); respawn clears it so re-assert each deploy.
	drawhud 0

	// spawn the visible mannequin (per player, own skin, animated) - guarded so a respawn re-uses it.
	local.player thread lobbySpawnMannequin

	// STUB Phase B: overhead nameplate (rank + name), Kleveburg music
	// STUB Phase C: F ready + A/D skin cycle
}end

//=========================================================================
// self = player. AVENUE #2: spawn ONE script_model mannequin wearing THIS player's chosen skin at their
// slot, animated by the same weight-pooled idle the MP skin-select menu uses (coop_lobbyselect). The
// mannequin is the VISIBLE body; the real player stays hidden + locked. A script_model has no player
// statemap / weapon system / freeze, so it just cycles the pool fluidly (proven PoC). Guarded so a respawn
// re-uses the existing mannequin instead of spawning duplicates.
//=========================================================================
lobbySpawnMannequin:{
//=========================================================================
	// already have a mannequin (this is a respawn) - just re-seat it and stop.
	if( self.flags["coop_lobbyMannequin"] != NIL ){
		if( self.flags["coop_lobbyMannequin"] != NULL ){
			self.flags["coop_lobbyMannequin"].origin = self.flags["coop_lobbyOrg"]
			self.flags["coop_lobbyMannequin"].angles = ( 0 self.flags["coop_lobbyYaw"] 0 )
		}
		end
	}

	// let the spawn settle so the player's chosen model is assigned before we copy it.
	wait 0.5
	if( self == NULL ){ end }
	if( level.coop_lobbyActive != 1 ){ end }

	// copy the player's OWN skin (models/player/<dm_playermodel>.tik); default if unset.
	local.skin = self.model
	if( local.skin == "" || local.skin == NIL ){ local.skin = "models/player/allied_tanker2.tik" }

	local.m = spawn script_model
	local.m model local.skin
	local.m.origin = self.flags["coop_lobbyOrg"]
	local.m.angles = ( 0 self.flags["coop_lobbyYaw"] 0 )
	local.m notsolid
	self.flags["coop_lobbyMannequin"] = local.m

	// menu-style fluid idle: play a weighted-random pick from the pool, wait for it, pick again.
	while( level.coop_lobbyActive == 1 && local.m != NULL ){
		local.m anim "coop_lobbyselect"
		local.m waittill animdone
	}
}end

//=========================================================================
// self = player. Per-frame watchdog: re-assert the movement/look lock (freezecontrols - m_bFrozen resets
// on the coop respawn churn). The player is invisible now, so there is no pose to hold - just the lock so
// the hidden body can't drift and wander the shared camera.
//=========================================================================
lobbyLockWatch:{
//=========================================================================
	while( level.coop_lobbyActive == 1 && self != NULL && self.flags["coop_lobbyFrozen"] == 1 ){
		self freezecontrols 1
		waitframe
	}
}end

//=========================================================================
lobbyHideHud:{
//=========================================================================
	// self = player. Hide the coop HUD - the health/ammo/objectives ihuddraw slots (the same slots the
	// DBNO spectator cleanup clears) plus the compass menu. Re-asserted because the HUD re-inits at spawn.
	// Coop draws its HUD across slots 20..72 (ammo/nade/objectives ~27-47, deployables/XP/rank ~62-72).
	// Hide the WHOLE range and keep re-asserting while the lobby is active - the XP + item HUD threads
	// re-draw their slots on update, so a one-shot (or 4s) hide leaks the icons back (bug-361).
	while( level.coop_lobbyActive == 1 && self != NULL ){
		for( local.s = 20; local.s <= 90; local.s++ ){
			ihuddraw_alpha self local.s 0
		}
		// drawhud is a LEVEL script command (not a client cvar) - call it bare. Hides the vanilla HUD + compass.
		drawhud 0
		self stufftext "ui_removehud hud_compass"
		// The vanilla bottom-left STAR lives in the hud_health UI MENU (ui/hud_health.urc, faded via
		// ui_hudAlpha) - drawhud 0 / PMF_NO_HUD does NOT remove UI menus, so remove them by name like compass.
		self stufftext "ui_removehud hud_health"
		self stufftext "ui_removehud hud_ammo"
		wait 0.5
	}
}end

