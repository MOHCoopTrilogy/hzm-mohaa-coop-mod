//==========================================================================================================//
// BUILD-MODE SCENE ACTORS.  Full docs: _research/build_actor_anims.md
//
// coop_sceneActorAnimate (self = a placed allied player-model script_model) loops the actor's
// captured idle animation (self.coop_sceneAnim) at the anim boundary - the same fluid recipe the
// lobby mannequin uses. Any prop was attachmodel'd at spawn and rides the animated bone, so nothing
// else is needed here. Used both by build mode's live placements AND by scene blocks pasted below.
//
// spawnSceneActors is the paste target: run build mode inside co_lobby1 (exec coop_mod/cfg/buildmode.cfg),
// pick the ALLIED ACTORS category, place animated soldiers, then paste the "coop_build ACTOR" blocks
// from  %APPDATA%\openmohaa\maintt\coop_mod\save\build_co_lobby1.dat  into spawnSceneActors. The
// captured origins are co_lobby1 world coords, so they drop in at the exact spot you built them.
// (Shipped empty = a safe no-op; the lobby is unchanged until you paste real actor blocks in.)
//==========================================================================================================//

//=========================================================================
coop_sceneActorAnimate:{
//=========================================================================
	if( self == NULL ){ end }
	if( self.coop_sceneAnim == NIL || self.coop_sceneAnim == "" ){ end }
	// [user 07-09] chained routines: a "coop_seq_*" alias plays a natural multi-clip sequence
	// (light -> drag -> pause -> drag ...) via the build-mode routine player instead of one looped clip.
	if( self.coop_sceneAnim == "coop_seq_smoke" || self.coop_sceneAnim == "coop_seq_smoke2" || self.coop_sceneAnim == "coop_seq_drink" ){
		waitthread coop_mod/buildmode_actors.scr::coop_build_animSequence self self.coop_sceneAnim
		end
	}
	while( self != NULL ){
		self anim self.coop_sceneAnim
		self waittill animdone
	}
}end

//=========================================================================
spawnSceneActors:{
//=========================================================================
	// >>> PASTE build-mode "coop_build ACTOR" blocks here (from build_co_lobby1.dat). Example shape:
	// local.m = spawn script_model
	// local.m model "models/player/american_ranger.tik"
	// local.m.origin = ( -5400 -450 -309 )
	// local.m.angles = ( 0 90 0 )
	// local.m notsolid
	// local.m attachmodel "models/items/cigarette.tik" "Bip01 L Finger11"
	// local.m.coop_sceneAnim = "coop_act_smoke"
	// local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate
}end
