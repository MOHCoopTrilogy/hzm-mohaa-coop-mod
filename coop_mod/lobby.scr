//==========================================================================================================//
// HZM Coop - Pre-Mission Lobby module.  Full spec: _research/coop_lobby1_build.md
//
// Called from maps/co_lobby1.scr::main after prespawn. PHASE A scope: spawn the placed props, build the
// single static camera every player views through, place the squad at the 4 anchor points, and lock them
// (no move / look / fire) while leaving the menu, console, quit and text chat fully usable.
// Idle-emote rotation, overhead rank/name, ready-up, skin cycle, music and the briefing launch are wired
// in later phases (marked STUB below).
//==========================================================================================================//

//=========================================================================
lobbyMapMain:{
//=========================================================================
	level.coop_lobbyActive = 1
	// NOTE: do NOT freezeplayer here - the level-global freeze pins players in the spawn CROUCH before the
	// at-ease pose can stand them up. The lock is per-player freezecontrols, applied AFTER the pose is set
	// (lobbyPoseAndFreeze) + re-asserted each frame (lobbyLockWatch) to survive the respawn m_bFrozen reset.

	// lobby players sit idle by design - stop the inactivity timer from spec-booting them (the
	// auto-spawn loop would then re-join them, causing a respawn flicker). Restored at teardown (Phase D).
	level.coop_lobbyPrevInactiveSpec = getcvar "g_inactivespectate"
	setcvar "g_inactivespectate" "0"
	setcvar "g_inactivekick" "0"

	// g_forcerespawn only auto-respawns DEAD players - it is NOT the deploy mechanism (that is
	// lobbyAutoSpawnLoop + skipTeamAndWeaponSelect). Keep it 1 for later dead-respawns; it MUST be
	// restored on launch (teardown) or a leaked =1 auto-respawns DBNO'd players in the mission.
	level.coop_lobbyPrevForceRespawn = getcvar "g_forcerespawn"
	setcvar "g_forcerespawn" "1"

	// lobby soldiers stay ARMED (rifle slung) so the EMOTE_ATEASE pose holds: the emote system's proven
	// path is an armed player - going unarmed risks the -HAS_WEAPON edge cancelling the pose to STAND.

	// --- the 4 player anchor points (viewpos coords, EYE height; yaw only). GENERALIZED: a lobby map script
	// (co_lobby2/3/...) sets these BEFORE threading lobbyMapMain; if it didn't, use the co_lobby1 training defaults.
	if( level.coop_lobbySlotOrg[1] == NIL ){
		level.coop_lobbySlotOrg[1] = ( -5264 -498 -227 )
		level.coop_lobbySlotYaw[1] = 101
		level.coop_lobbySlotOrg[2] = ( -5446 -438 -227 )
		level.coop_lobbySlotYaw[2] = 74
		level.coop_lobbySlotOrg[3] = ( -5377 -393 -227 )
		level.coop_lobbySlotYaw[3] = 86
		level.coop_lobbySlotOrg[4] = ( -5301 -378 -227 )
		level.coop_lobbySlotYaw[4] = 83
	}

	// point the coop spawn system at the anchors too, so the first spawn + any late joiner lands here
	level.flags["coop_spawn1origin"] = level.coop_lobbySlotOrg[1]
	level.flags["coop_spawn2origin"] = level.coop_lobbySlotOrg[2]
	level.flags["coop_spawn3origin"] = level.coop_lobbySlotOrg[3]
	level.flags["coop_spawn4origin"] = level.coop_lobbySlotOrg[4]

	// A/D skin-cycle roster: the FULL allied set the MP model menu offers, mirroring the engine
	// PlayerModelPickerClass::SetupFiles allied filter (all models/player/*.tik that are NOT _fps,
	// NOT leading-'_', and NOT prefixed german/axis/it/sc). Regenerate with the pak-scan one-liner if
	// custom allied skins are added. Wrap-around.
	level.coop_lobbySkins[1] = "allied_101st_captain"
	level.coop_lobbySkins[2] = "allied_101st_infantry"
	level.coop_lobbySkins[3] = "allied_101st_scout"
	level.coop_lobbySkins[4] = "allied_501st_pir_scout"
	level.coop_lobbySkins[5] = "allied_501st_pir_soldier"
	level.coop_lobbySkins[6] = "allied_airborne"
	level.coop_lobbySkins[7] = "allied_airborne_101st_1"
	level.coop_lobbySkins[8] = "allied_airborne_101st_2"
	level.coop_lobbySkins[9] = "allied_airborne_101st_sgt"
	level.coop_lobbySkins[10] = "allied_airborne_82nd_1"
	level.coop_lobbySkins[11] = "allied_airborne_82nd_2"
	level.coop_lobbySkins[12] = "allied_airborne_82nd_3"
	level.coop_lobbySkins[13] = "allied_airborne_82nd_sgt"
	level.coop_lobbySkins[14] = "allied_british_6th_airborne_captain"
	level.coop_lobbySkins[15] = "allied_british_6th_airborne_paratrooper"
	level.coop_lobbySkins[16] = "allied_british_cmd"
	level.coop_lobbySkins[17] = "allied_british_tank"
	level.coop_lobbySkins[18] = "allied_british_tank_corporal"
	level.coop_lobbySkins[19] = "allied_manon"
	level.coop_lobbySkins[20] = "allied_norwegian_resistance"
	level.coop_lobbySkins[21] = "allied_pilot"
	level.coop_lobbySkins[22] = "allied_russian_corporal"
	level.coop_lobbySkins[23] = "allied_russian_crazy_boris"
	level.coop_lobbySkins[24] = "allied_russian_recon_scout"
	level.coop_lobbySkins[25] = "allied_russian_recon_soldier"
	level.coop_lobbySkins[26] = "allied_russian_seaman"
	level.coop_lobbySkins[27] = "allied_sas"
	level.coop_lobbySkins[28] = "allied_tanker"
	level.coop_lobbySkins[29] = "allied_tanker2"
	level.coop_lobbySkins[30] = "allied_technician"
	level.coop_lobbySkins[31] = "allied_us_mask"
	level.coop_lobbySkins[32] = "allied_us_tank"
	level.coop_lobbySkins[33] = "allied_wheathers"
	level.coop_lobbySkins[34] = "american_army"
	level.coop_lobbySkins[35] = "american_army2"
	level.coop_lobbySkins[36] = "american_army3"
	level.coop_lobbySkins[37] = "american_army_29id"
	level.coop_lobbySkins[38] = "american_army_29id_bar"
	level.coop_lobbySkins[39] = "american_army_29id_radioman"
	level.coop_lobbySkins[40] = "american_army_29id_sgt"
	level.coop_lobbySkins[41] = "american_army_bar"
	level.coop_lobbySkins[42] = "american_army_captain"
	level.coop_lobbySkins[43] = "american_army_hbt"
	level.coop_lobbySkins[44] = "american_army_lieutenant"
	level.coop_lobbySkins[45] = "american_army_m43"
	level.coop_lobbySkins[46] = "american_army_major"
	level.coop_lobbySkins[47] = "american_army_medic"
	level.coop_lobbySkins[48] = "american_army_sergeant"
	level.coop_lobbySkins[49] = "american_assault_engineer"
	level.coop_lobbySkins[50] = "american_assault_engineer2"
	level.coop_lobbySkins[51] = "american_major"
	level.coop_lobbySkins[52] = "american_navy_beach_radioman"
	level.coop_lobbySkins[53] = "american_ranger"
	level.coop_lobbySkins[54] = "american_ranger2"
	level.coop_lobbySkins[55] = "american_ranger3_hbt"
	level.coop_lobbySkins[56] = "american_ranger_assault"
	level.coop_lobbySkins[57] = "american_ranger_assault_captain"
	level.coop_lobbySkins[58] = "american_ranger_assault_sergeant"
	level.coop_lobbySkins[59] = "american_ranger_lieutenant"
	level.coop_lobbySkins[60] = "american_ranger_medic"
	level.coop_lobbySkins[61] = "american_ranger_sergeant"
	level.coop_lobbySkins[62] = "american_ranger_winter"
	level.coop_lobbySkins[63] = "american_ranger_winter_m41"
	level.coop_lobbySkins[64] = "american_ranger_winter_m43"
	level.coop_lobbySkins[65] = "american_ranger_winter_m43_lt"
	level.coop_lobbySkins[66] = "american_ranger_winter_sgt"
	level.coop_lobbySkins[67] = "american_winter_m41"
	level.coop_lobbySkins[68] = "american_winter_m43"
	level.coop_lobbySkins[69] = "american_winter_sgt"
	level.coop_lobbySkins[70] = "american_winter_specengineer"
	level.coop_lobbySkins[71] = "rifleman"
	level.coop_lobbySkins[72] = "riflemannohelm"
	level.coop_lobbySkins[73] = "submachine_gunner"
	level.coop_lobbySkins[74] = "submachine_gunnernohelm"
	level.coop_lobbySkins[75] = "support_gunner"
	level.coop_lobbySkins[76] = "support_gunnernohelm"

	// co_lobby1 spawns the training props here; other lobbies (co_lobby2/3) set coop_lobbySkipProps=1 and
	// thread their OWN baked objects/actors from their map script instead.
	if( level.coop_lobbySkipProps != 1 ){
		thread spawnProps
		thread spawnSceneActors		// HZM coop BUILD MODE: animated allied actors placed via build mode (paste target below)
	}
	waitthread spawnLobbyCamera
	thread lobbyCamTune
	thread lobbyCamSway
	thread lobbyAutoSpawnLoop
	thread lobbyRoster
	thread lobbyUnlockList
	thread lobbyReadyWatch

	// staging music. Precedence: the coop_lobbyMusic cvar (live override) wins; else a per-lobby track the
	// lobby declared in its own .scr as level.coop_lobbyMusicTrack (e.g. every Operation Overlord lobby sets
	// the "Dogs of War" main title); else the default Kleveburg staging loop. tmstartloop registers
	// level.coop_musicCommand so late joiners auto-get whichever track is chosen.
	level.coop_lobbyMusicFile = getcvar "coop_lobbyMusic"
	if( level.coop_lobbyMusicFile == "" ){
		if( level.coop_lobbyMusicTrack != NIL ){
			level.coop_lobbyMusicFile = level.coop_lobbyMusicTrack
		}
		else{
			level.coop_lobbyMusicFile = "sound/music/Kleveburg.mp3"
		}
	}
	thread coop_mod/replace.scr::tmstartloop level.coop_lobbyMusicFile
}end

//=========================================================================
// The single static camera at anchor #1. Every player is bound to this one entity, so the whole
// squad shares the same framed shot. Pitch/yaw are live-tunable via cvars for on-the-fly framing.
//=========================================================================
spawnLobbyCamera:{
//=========================================================================
	// A Camera IGNORES .origin= and .angles= (same class of no-op as moveto on a script_model; proven
	// by LOBBYDBG: the cam stayed at 0 0 0). Position it with 'movetopos' and aim it with 'watch' at a
	// look-at marker - the t2l2 recipe. bug-360.
	level.coop_lobbyCam = spawn Camera
	level.coop_lobbyCam.targetname = "coop_lobbyCam"
	level.coop_lobbyLookAt = spawn script_origin targetname "coop_lobbyLookAt"
	waitthread applyLobbyCam
	if( level.coop_lobbyCam != NULL ){ level.coop_lobbyCam cut }
}end

//=========================================================================
// Position + aim the shared camera from cvars (live-tunable). Camera at coop_lobbyCamX/Y/Z looks at the
// squad-centre marker at coop_lobbyLookX/Y/Z. Defaults frame the 4 slots from the front.
//=========================================================================
applyLobbyCam:{
//=========================================================================
	// DEFAULTS = the user's original captured viewpos:  (-5304 -248 -237) : yaw 230.
	// The look-at (-5497 -478 -237) is that origin projected 300u along yaw 230 (pitch 0), so 'watch'
	// aims the camera exactly on the recorded facing. FOV 80 matches the player's own cg_fov.
	local.cx = getcvar "coop_lobbyCamX"
	if( local.cx == "" ){ local.cx = "-5304" }
	local.cy = getcvar "coop_lobbyCamY"
	if( local.cy == "" ){ local.cy = "-248" }
	local.cz = getcvar "coop_lobbyCamZ"
	if( local.cz == "" ){ local.cz = "-237" }
	local.cxi = int( local.cx )
	local.cyi = int( local.cy )
	local.czi = int( local.cz )

	local.lx = getcvar "coop_lobbyLookX"
	if( local.lx == "" ){ local.lx = "-5497" }
	local.ly = getcvar "coop_lobbyLookY"
	if( local.ly == "" ){ local.ly = "-478" }
	local.lz = getcvar "coop_lobbyLookZ"
	if( local.lz == "" ){ local.lz = "-237" }
	local.lxi = int( local.lx )
	local.lyi = int( local.ly )
	local.lzi = int( local.lz )

	local.fov = getcvar "coop_lobbyCamFov"
	if( local.fov == "" ){ local.fov = "80" }
	local.fovi = int( local.fov )

	// GENERALIZED per-lobby camera: if the map script set a camera origin + yaw, recompute from it (the look-at
	// is the origin projected 300u along the yaw, so 'watch' aims exactly at the recorded facing). Uses the
	// PROVEN vector*scalar / vector+vector ops (NOT vector_scale(a,b) - the comma builtin kills the file, bug-402).
	if( level.coop_lobbyCamOrg != NIL ){
		local.camorg = level.coop_lobbyCamOrg
		local.yaw = level.coop_lobbyCamYaw
		local.cxi = local.camorg[0]
		local.cyi = local.camorg[1]
		local.czi = local.camorg[2]
		local.fwd = angles_toforward( ( 0 local.yaw 0 ) )
		local.step = local.fwd * 300
		local.lookorg = local.camorg + local.step
		local.lxi = local.lookorg[0]
		local.lyi = local.lookorg[1]
		local.lzi = local.lookorg[2]
		if( level.coop_lobbyCamFovN != NIL ){ local.fovi = level.coop_lobbyCamFovN }
	}

	// base framing for the sway loop: the un-swayed look-at, and the horizontal 'right' vector (perpendicular
	// to cam->look in the XY plane) that lobbyCamSway offsets along. lobbyCamSway OWNS coop_lobbyLookAt.origin
	// per-frame (base + sway) - we only seed it here.
	level.coop_lobbyLookBase = ( local.lxi local.lyi local.lzi )
	level.coop_lobbyCamRight = vector_normalize( ( ( local.lyi - local.cyi ) ( local.cxi - local.lxi ) 0 ) )
	if( level.coop_lobbyLookAt != NULL ){
		level.coop_lobbyLookAt.origin = level.coop_lobbyLookBase
	}
	if( level.coop_lobbyCam != NULL ){
		level.coop_lobbyCam movetopos ( local.cxi local.cyi local.czi )
		if( level.coop_lobbyLookAt != NULL ){
			level.coop_lobbyCam watch level.coop_lobbyLookAt 0
		}
		level.coop_lobbyCam fov local.fovi
	}
}end

//=========================================================================
// LIVELY CAMERA: a gentle handheld drift of the shared shot, reusing the injured-view SWAY motion (two
// detuned sine harmonics, in degrees) but tiny and always-on. Applied to the look-at TARGET so the camera's
// AIM slowly wanders (a watch-camera can't roll, so the injured "roll" harmonic maps to a sideways aim drift,
// "pitch" -> vertical). coop_lobbyCamSway scales it (default 1.0; 0 = perfectly still). Sole writer of the
// look-at origin, so it never fights applyLobbyCam.
//=========================================================================
lobbyCamSway:{
//=========================================================================
	while( level.coop_lobbyActive == 1 ){
		if( level.coop_lobbyLookAt != NULL && level.coop_lobbyLookBase != NIL && level.coop_lobbyCamRight != NIL ){
			local.amt = getcvar "coop_lobbyCamSway"
			if( local.amt == "" ){ local.amt = "1.0" }
			local.a = float( local.amt )
			if( local.a <= 0 ){
				level.coop_lobbyLookAt.origin = level.coop_lobbyLookBase
			} else {
				local.t = level.time
				// same rates as the injured sway (0.95/1.7/0.70 rad/s -> 54/97/40 deg/s). Amplitudes tuned tiny.
				local.hs = sin( local.t * 54 )
				local.hs2 = sin( ( local.t * 97 ) + 63 )
				local.hs = ( local.hs + ( 0.45 * local.hs2 ) ) * 5.0 * local.a
				local.vs = sin( ( local.t * 40 ) + 34 )
				local.vs = ( local.vs * 3.0 ) * local.a
				// scale the right-vector by the horizontal sway with the PROVEN vector*scalar operator
				// (e.g. ammobox.scr `local.fwd * 9`) - NOT vector_scale( a, b ): a comma-separated 2-arg
				// builtin call has no precedent in this codebase and fails to compile the whole file (bug-402).
				local.cr = level.coop_lobbyCamRight
				local.roff = local.cr * local.hs
				local.voff = ( 0 0 local.vs )
				local.newlook = level.coop_lobbyLookBase + local.roff
				local.newlook = local.newlook + local.voff
				level.coop_lobbyLookAt.origin = local.newlook
			}
		}
		waitframe
	}
}end

//=========================================================================
lobbyCamTune:{
//=========================================================================
	// cheap live-tune loop: re-reads the framing cvars so the camera can be dialed in-game. Slow (2s) so it
	// only refreshes the BASE framing - lobbyCamSway owns the per-frame look-at origin.
	while( level.coop_lobbyActive == 1 ){
		waitthread applyLobbyCam
		wait 2.0
	}
}end

//=========================================================================
// Auto-spawn: force any spectator straight onto allies (skips the team/weapon-select click) so the
// squad just appears in the lobby. PER-FRAME scan (F3) so a spectator is force-joined the same frame it
// becomes one - kills the multi-second deploy limbo / "click to spawn". join_team while already allied is
// a no-op, so once everyone is deployed the loop costs nothing.
//=========================================================================
lobbyAutoSpawnLoop:{
//=========================================================================
	while( level.coop_lobbyActive == 1 ){
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.player = $player[local.i]
			if( local.player != NULL ){
				if( local.player.dmteam == "spectator" ){
					waitthread coop_mod/main.scr::skipTeamAndWeaponSelect local.player
					local.player.flags["coop_lobbyDeployTry"] = NIL
				}
				else if( local.player.flags["coop_isActive"] != 1 && local.player.flags["coop_lobbyDeployTry"] != 1 ){
					// Joined allies but the engine gates the actual SPAWN behind a fire-click (player.cpp:4959);
					// g_forcerespawn only auto-deploys DEAD players (4940) and a fresh joiner never died. Force
					// the deploy ONCE with a direct respawn (EV_Player_Respawn) - kills the ~10s click limbo.
					local.player.flags["coop_lobbyDeployTry"] = 1
					local.player respawn
				}
			}
		}
		waitframe
	}
}end

//=========================================================================
// Called from co_lobby1.scr on every (re)spawn: seat this player at their slot, lock them, and hand
// their view to the shared static camera. Runs AFTER the spawn completes, so the camera view holds.
//=========================================================================
lobbyOnSpawn local.player:{
//=========================================================================
	if( local.player == NULL || local.player == $world ){ end }
	if( level.coop_lobbyActive != 1 ){ end }

	// assign a slot once, RANDOMLY, among the slots not already taken by another connected player (so the
	// squad doesn't always line up in the same order and no two share a spot).
	if( local.player.flags["coop_lobbySlot"] == NIL ){
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			if( $player[local.i] != NULL && $player[local.i] != local.player ){
				local.os = $player[local.i].flags["coop_lobbySlot"]
				if( local.os != NIL ){ local.taken[local.os] = 1 }
			}
		}
		local.k = 0
		for( local.s = 1; local.s <= 4; local.s++ ){
			if( local.taken[local.s] != 1 ){ local.k = local.k + 1; local.free[local.k] = local.s }
		}
		if( local.k > 0 ){
			local.rf = randomfloat( local.k )
			local.ri = int( local.rf )
			local.ri = local.ri + 1
			if( local.ri > local.k ){ local.ri = local.k }
			local.player.flags["coop_lobbySlot"] = local.free[local.ri]
		} else {
			local.rf = randomfloat( 4 )
			local.rp = int( local.rf )
			local.player.flags["coop_lobbySlot"] = local.rp + 1
		}
	}
	local.slot = local.player.flags["coop_lobbySlot"]

	// feet-on-ground: slot origins were recorded at EYE height (viewpos); drop by the standing view height.
	local.drop = getcvar "coop_lobbyFeetDrop"
	if( local.drop == "" ){ local.drop = "82" }
	local.di = int( local.drop )
	local.feet = level.coop_lobbySlotOrg[local.slot] - ( 0 0 local.di )

	local.player.flags["coop_lobbyYaw"] = level.coop_lobbySlotYaw[local.slot]
	local.player.flags["coop_lobbyOrg"] = local.feet

	// AVENUE #2: the VISIBLE body is a script_model MANNEQUIN wearing the player's OWN chosen skin
	// (lobbySpawnMannequin) - it has no player statemap / weapon / freeze fight, so it animates fluidly like
	// the MP skin-select menu. The REAL player is just an INVISIBLE, locked camera-viewer. So here we only
	// plant + HIDE + lock the player and bind the shared camera - NO pose, NO holster, NO unhide. Any residual
	// weapon/anim churn on the real player is never seen, which is what makes the whole freeze fight moot.
	local.player.origin = local.feet
	local.player.angles = ( 0 level.coop_lobbySlotYaw[local.slot] 0 )
	local.player.viewangles = ( 0 level.coop_lobbySlotYaw[local.slot] 0 )
	local.player.flags["coop_lobbyFrozen"] = 1
	local.player hide

	// hide the coop HUD (health/ammo/objectives slots) + compass for this client
	local.player thread lobbyHideHud

	// every player views the ONE shared static camera. Re-cue per spawn so late joiners pick it up.
	if( level.coop_lobbyCam != NULL ){
		level.coop_lobbyCam cut
		cuecamera level.coop_lobbyCam
	}

	// lock the (invisible) body so it can't drift/jump/rotate the shared shot; lobbyLockWatch re-asserts it
	// every frame (m_bFrozen resets on the coop respawn churn).
	local.player freezecontrols 1
	if( local.player.flags["coop_lobbyLockWatch"] != 1 ){
		local.player.flags["coop_lobbyLockWatch"] = 1
		local.player thread lobbyLockWatch
	}

	// hide the vanilla engine HUD (star/compass/ammo/crosshair); respawn clears it so re-assert each deploy.
	// drawhud only sets PMF_NO_HUD (the engine HUD); the ihuddraw roster/help layer is gated by
	// cg_huddraw_force, forced on just below (now whitelisted, so the push reaches every client).
	drawhud 0

	// spawn the visible mannequin (per player, own skin, animated) - guarded so a respawn re-uses it.
	local.player thread lobbySpawnMannequin

	// LOBBY CONTROLS with NO client binds: the engine reads A/D (rightmove) + F (+use) from this player's
	// usercmd and publishes self.coop_lobbyInput; lobbyInputPoll dispatches it. Works for host AND remote
	// clients, and there is nothing to restore at launch. Also force the roster/help ihuddraw layer on.
	local.player coop_lobbyinput 1
	local.player stufftext "set cg_huddraw_force 1"
	if( local.player.flags["coop_lobbyInputPoll"] != 1 ){
		local.player.flags["coop_lobbyInputPoll"] = 1
		local.player thread lobbyInputPoll
	}

	//[304] CLICKABLE LOBBY UI: mouse cursor + buttons (Challenges now; loadout / skill trees later).
	local.player thread coop_mod/lobbyui.scr::lobbyui_start
}end

//=========================================================================
// self = player. Poll the engine LOBBY INPUT bridge (self.coop_lobbyInput, set by Player::TickCoopLobbyInput
// from the usercmd) and dispatch: 31 = next uniform (D), 32 = prev (A), 33 = ready toggle (F). Consumes the
// value each tick (resets to 0). No client binds involved - every connected client drives this natively.
//=========================================================================
lobbyInputPoll:{
//=========================================================================
	self.coop_lobbyInput = 0
	while( level.coop_lobbyActive == 1 && self != NULL && self.flags["coop_lobbyFrozen"] == 1 ){
		local.cmd = self.coop_lobbyInput
		if( local.cmd != NIL && local.cmd != 0 ){
			self.coop_lobbyInput = 0
			//[user 07-17] uniform switching moved to the ARMORY (Loadout menu) - the lobby A/D bridge
			//no longer cycles skins (this was the missed second route; the name-bus route was closed
			//in player.scr the same day). Rate-limited hint so A/D spam doesn't flood the screen.
			if( local.cmd == 31 || local.cmd == 32 ){
				if( self.coop_lobbySkinHintT == NIL || (level.time - self.coop_lobbySkinHintT) > 3 ){
					self.coop_lobbySkinHintT = level.time
					self iprint "Change your uniform in the ARMORY (Loadout menu)." 1
				}
			}
			else if( local.cmd == 33 ){ self thread lobbyReadyToggle }
		}
		waitframe
	}
}end

//=========================================================================
// self = player. AVENUE #2: spawn ONE script_model mannequin wearing THIS player's chosen skin at their
// slot, animated by the same weight-pooled idle the MP skin-select menu uses (coop_lobbyselect). The
// mannequin is the VISIBLE body; the real player stays hidden + locked. A script_model has no player
// statemap / weapon system / freeze, so it just cycles the pool fluidly (proven PoC). Guarded so a respawn
// re-uses the existing mannequin instead of spawning duplicates.
//=========================================================================
lobbySpawnMannequin:{
//=========================================================================
	// already have a mannequin (this is a respawn) - just re-seat it and stop.
	if( self.flags["coop_lobbyMannequin"] != NIL ){
		if( self.flags["coop_lobbyMannequin"] != NULL ){
			self.flags["coop_lobbyMannequin"].origin = self.flags["coop_lobbyOrg"]
			self.flags["coop_lobbyMannequin"].angles = ( 0 self.flags["coop_lobbyYaw"] 0 )
		}
		end
	}

	// let the spawn settle so the player's chosen model is assigned before we copy it.
	wait 0.5
	if( self == NULL ){ end }
	if( level.coop_lobbyActive != 1 ){ end }

	// copy the player's OWN skin (models/player/<dm_playermodel>.tik); default if unset.
	local.skin = self.model
	if( local.skin == "" || local.skin == NIL ){ local.skin = "models/player/allied_tanker2.tik" }

	local.m = spawn script_model
	local.m model local.skin
	local.m.origin = self.flags["coop_lobbyOrg"]
	local.m.angles = ( 0 self.flags["coop_lobbyYaw"] 0 )
	local.m notsolid
	self.flags["coop_lobbyMannequin"] = local.m

	// menu-style fluid idle: play a weighted-random pick from the pool, wait for it, pick again.
	while( level.coop_lobbyActive == 1 && local.m != NULL ){
		local.m anim "coop_lobbyselect"
		local.m waittill animdone
	}
}end

//=========================================================================
// self = player. Cycle this player's skin by local.dir (+1 next / -1 prev), wrapping. Swaps the VISIBLE
// mannequin's model live AND the real (hidden) player's model + dm_playermodel so the choice carries into
// the launched mission. Bound to A/D via cfg/lobby_binds.cfg through the name-append bus.
//=========================================================================
lobbySkinCycle local.dir:{
//=========================================================================
	if( self == NULL ){ end }
	if( level.coop_lobbyActive != 1 ){ end }
	if( level.coop_lobbySkins == NIL ){ end }

	local.n = level.coop_lobbySkins.size
	if( local.n < 1 ){ end }

	local.idx = self.flags["coop_lobbySkinIdx"]
	if( local.idx == NIL ){ local.idx = 1 }
	//[user 07-16] skip skins still locked behind challenge/rank unlocks. The 48 lobby-only extras are
	//outside the gated set (cosmetic_gatedBuild) so they stay free; only the shared armory "premium"
	//skins require earning - this closes the bypass where the lobby set dm_playermodel into the mission.
	local.tries = 0
	local.found = 0
	while( local.tries < local.n ){
		local.idx = local.idx + local.dir
		if( local.idx > local.n ){ local.idx = 1 }
		if( local.idx < 1 ){ local.idx = local.n }
		if( waitthread coop_mod/helmet.scr::cosmetic_isUnlocked self ("models/player/" + level.coop_lobbySkins[local.idx] + ".tik") ){ local.found = 1; break }
		local.tries = local.tries + 1
	}
	if( local.found == 0 ){ self iprint "No other skins unlocked yet." 1; end }
	self.flags["coop_lobbySkinIdx"] = local.idx

	local.skin = level.coop_lobbySkins[local.idx]
	local.mdl = "models/player/" + local.skin + ".tik"

	// the VISIBLE body is the mannequin - swap its model live (NIL guard: an unassigned flag
	// reads NIL, and NIL != NULL passes - see the helmet.scr mannequin fix, qconsole 07-20)
	if( self.flags["coop_lobbyMannequin"] != NIL && self.flags["coop_lobbyMannequin"] != NULL ){
		self.flags["coop_lobbyMannequin"] model local.mdl
	}
	// LOCK the choice as this player's default: seta dm_playermodel (CVAR_ARCHIVE|USERINFO) carries into the
	// launched mission AND persists across sessions. Now reaches the client - dm_playermodel is whitelisted.
	self model local.mdl
	self stufftext ( "seta dm_playermodel " + local.skin )

	self iprint ( "Skin: " + local.skin ) 1
}end

//=========================================================================
// self = player. Toggle this player's lobby ready state (F key). The bottom-left roster shows a green
// checkmark for readied players. Countdown-when-all-ready is Phase D.
//=========================================================================
lobbyReadyToggle:{
//=========================================================================
	if( self == NULL ){ end }
	if( level.coop_lobbyActive != 1 ){ end }
	if( self.flags["coop_lobbyReady"] == 1 ){
		self.flags["coop_lobbyReady"] = 0
		self iprint "Not ready" 1
	} else {
		self.flags["coop_lobbyReady"] = 1
		self iprint "Ready!" 1
	}
}end

//=========================================================================
// Returns 1 only if there is at least one connected player AND every one of them has readied up.
//=========================================================================
lobbyAllReady:{
//=========================================================================
	local.n = $player.size
	if( local.n < 1 ){ end 0 }
	local.all = 1
	for( local.i = 1; local.i <= local.n; local.i++ ){
		if( $player[local.i] == NULL ){ continue }
		if( $player[local.i].flags["coop_lobbyReady"] != 1 ){ local.all = 0 }
	}
}end local.all

//=========================================================================
// Squad ready-watch. When ALL connected players are ready, count down (coop_lobbyCountdown secs, default 5
// [user 07-18]: was 10 - the post-ready launch countdown should be 5 seconds)
// broadcast to every screen; if anyone un-readies the countdown aborts and resets. At 0, launch the campaign.
// Started once from lobbyMapMain.
//=========================================================================
lobbyReadyWatch:{
//=========================================================================
	level.coop_lobbyLaunching = 0
	while( level.coop_lobbyActive == 1 && level.coop_lobbyLaunching == 0 ){
		local.ready = waitthread lobbyAllReady
		if( local.ready == 1 ){
			local.secs = getcvar "coop_lobbyCountdown"
			if( local.secs == "" ){ local.secs = "5" }	//[user 07-18] was 10: post-ready launch countdown = 5s
			local.t = int( local.secs )
			local.abort = 0
			while( local.t > 0 && local.abort == 0 && level.coop_lobbyActive == 1 ){
				local.still = waitthread lobbyAllReady
				if( local.still != 1 ){
					local.abort = 1
				} else {
					waitthread lobbyCountdownHud local.t
					wait 1
					local.t = local.t - 1
				}
			}
			local.final = waitthread lobbyAllReady
			if( local.abort == 0 && local.final == 1 && level.coop_lobbyActive == 1 ){
				level.coop_lobbyLaunching = 1
				waitthread lobbyLaunch
			} else {
				waitthread lobbyCountdownClear
				for( local.i = 1; local.i <= $player.size; local.i++ ){
					if( $player[local.i] != NULL ){ $player[local.i] iprint "Launch aborted - not everyone is ready" 1 }
				}
			}
		}
		wait 0.5
	}
}end

//=========================================================================
// Draw the big centred "LAUNCHING IN N" countdown on every screen (fade-exempt slot 114).
//=========================================================================
lobbyCountdownHud local.t:{
//=========================================================================
	for( local.v = 1; local.v <= $player.size; local.v++ ){
		local.viewer = $player[local.v]
		if( local.viewer == NULL ){ continue }
		ihuddraw_virtualsize local.viewer 114 1
		ihuddraw_align local.viewer 114 center top
		ihuddraw_rect local.viewer 114 0 70 640 0
		ihuddraw_font local.viewer 114 "facfont-20"
		ihuddraw_string local.viewer 114 ( "LAUNCHING IN " + local.t )
		ihuddraw_color local.viewer 114 0.6 1 0.6
		ihuddraw_alpha local.viewer 114 1
	}
}end

//=========================================================================
// Hide the countdown text on every screen.
//=========================================================================
lobbyCountdownClear:{
//=========================================================================
	for( local.v = 1; local.v <= $player.size; local.v++ ){
		if( $player[local.v] != NULL ){ ihuddraw_alpha $player[local.v] 114 0 }
	}
}end

//=========================================================================
// Launch the campaign: lock skins in (already seta'd on each pick), stop the lobby, and clean-transition to
// the vanilla briefing (which auto-advances to m1l1). Uses the mod's own safe stuffsrv "map" reset housekeeping
// (NOT bsptransition/loadMap - those archive on a live coop server and crash). No client binds were touched,
// so there is nothing to restore.
//=========================================================================
lobbyLaunch:{
//=========================================================================
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.pl = $player[local.i]
		if( local.pl == NULL ){ continue }
		local.pl iprint "Launching campaign..." 1
		local.pl coop_lobbyinput 0
		local.pl stufftext "set cg_huddraw_force 0"
		//[user 07-18] the NEW UNLOCKS list was on screen for the whole lobby stay - launching is the
		//acknowledgment. Empty each player's pending queue (flag + session cvar + save file) so the
		//next lobby starts clean; lobbyUnlockList wipes its slots on lobby end.
		waitthread coop_mod/challenges.scr::chal_pend_clear local.pl
	}
	waitthread lobbyCountdownClear
	level.coop_lobbyActive = 0		// stops the roster/help/input loops; lobbyRoster wipes slots 100-114 on exit
	wait 0.25

	// mirror missioncomplete / coop_maptest_transition safe-reload housekeeping, then raw stuffsrv "map"
	setcvar "g_scriptcheck" "0"
	exec coop_mod/replace.scr::stopwatch 0
	setcvar "coop_prevMapList" ( getcvar "sv_maplist" )
	setcvar "sv_maplist" ""
	level.coop_preventGameTypeChanges = game.true
	if( level.coop_changeGameTypeThread ){
		level.coop_changeGameTypeThread end
	}
	game.loadout = false

	// GENERALIZED next map: each lobby sets level.coop_lobbyNextMap (co_lobby1 -> briefing1 -> m1l1;
	// co_lobby2 -> m1l2a; co_lobby3 -> m1l2b). Default keeps co_lobby1 behavior.
	local.next = level.coop_lobbyNextMap
	if( local.next == NIL || local.next == "" ){ local.next = "briefing/briefing1" }
	// HZM coop [user 08-02]: RESTORE the cvars the lobby stashed on entry. Both stash vars
	// (level.coop_lobbyPrevInactiveSpec at lobby.scr:21, level.coop_lobbyPrevForceRespawn at
	// :28) were written and then NEVER read anywhere - the restore this teardown promised in
	// its own comments was never implemented. Consequences, both live:
	//  - g_inactivespectate leaked as "0", so idle-spectate was OFF for the whole mission
	//    after any lobby launch, silently masking whatever value the server cfg set.
	//  - g_forcerespawn leaked as "1", which (per the note at :26-27) auto-respawns DBNO'd
	//    players in the mission instead of leaving them down for a revive.
	// g_inactivekick was clamped to 0 on entry with no stash at all, so re-seed it from the
	// server default rather than a saved value.
	// Disabling the timer *inside* the lobby is intended (players idle by design) - this only
	// undoes it on the way out.
	if( level.coop_lobbyPrevInactiveSpec != NIL && level.coop_lobbyPrevInactiveSpec != "" ){
		setcvar "g_inactivespectate" level.coop_lobbyPrevInactiveSpec
	} else {
		setcvar "g_inactivespectate" "600"
	}
	if( level.coop_lobbyPrevForceRespawn != NIL && level.coop_lobbyPrevForceRespawn != "" ){
		setcvar "g_forcerespawn" level.coop_lobbyPrevForceRespawn
	}
	setcvar "g_inactivekick" "0"

	setcvar "coop_weatherPin" ""		// [user 07-09] clear any per-lobby weather pin (co_lobby5's blizzard) so the launched map keeps its own weather
	println( "^~^~^ COOP_CAMPAIGN_LAUNCH " + local.next )
	stuffsrv ( "map " + local.next )
}end

//=========================================================================
// self = player. Per-frame watchdog: re-assert the movement/look lock (freezecontrols - m_bFrozen resets
// on the coop respawn churn). The player is invisible now, so there is no pose to hold - just the lock so
// the hidden body can't drift and wander the shared camera.
//=========================================================================
lobbyLockWatch:{
//=========================================================================
	while( level.coop_lobbyActive == 1 && self != NULL && self.flags["coop_lobbyFrozen"] == 1 ){
		self freezecontrols 1
		waitframe
	}
}end

//=========================================================================
// The BOTTOM-LEFT lobby roster: one stacked row per connected player = rank emblem + name, plus a green
// READY tag once they ready up. Drawn on EVERY player's screen (shared camera). Uses ihuddraw slots
// 100-111 (3 per row x 4 rows) which sit ABOVE the lobbyHideHud wipe band (20-90) and the XP bar (62-72),
// and are NOT touched by drawhud 0 (that only hides the engine HUD). Re-drawn every 0.5s so joins/leaves/
// ready toggles reflect; active rows are overwritten (no flicker), empty rows cleared to alpha 0.
//=========================================================================
lobbyRoster:{
//=========================================================================
	while( level.coop_lobbyActive == 1 ){
		// TOP-LEFT control help (slots 112/113). >= 100 => the engine HUD-fade leaves it fully on; drawn
		// for every viewer each refresh so late joiners get it. verdana-12 = the smallest font the game ships.
		for( local.v = 1; local.v <= $player.size; local.v++ ){
			local.viewer = $player[local.v]
			if( local.viewer == NULL ){ continue }

			ihuddraw_virtualsize local.viewer 112 1
			ihuddraw_align local.viewer 112 left top
			ihuddraw_rect local.viewer 112 12 12 0 0
			ihuddraw_font local.viewer 112 "verdana-12"
			ihuddraw_string local.viewer 112 "Uniforms + Loadout: the ARMORY"
			ihuddraw_color local.viewer 112 1 1 1
			ihuddraw_alpha local.viewer 112 1

			ihuddraw_virtualsize local.viewer 113 1
			ihuddraw_align local.viewer 113 left top
			ihuddraw_rect local.viewer 113 12 26 0 0
			ihuddraw_font local.viewer 113 "verdana-12"
			ihuddraw_string local.viewer 113 "F   Ready Up"
			ihuddraw_color local.viewer 113 1 1 1
			ihuddraw_alpha local.viewer 113 1
		}

		for( local.p = 1; local.p <= 4; local.p++ ){
			local.rankSlot = 100 + ( ( local.p - 1 ) * 3 )
			local.nameSlot = local.rankSlot + 1
			local.chkSlot  = local.rankSlot + 2
			local.ly = 410 + ( ( local.p - 1 ) * 15 )		// stacked, compact, anchored near the bottom

			local.pl = NULL
			if( local.p <= $player.size ){ local.pl = $player[local.p] }

			if( local.pl == NULL ){
				// empty slot - clear its row on every viewer
				for( local.v = 1; local.v <= $player.size; local.v++ ){
					if( $player[local.v] != NULL ){
						ihuddraw_alpha $player[local.v] local.rankSlot 0
						ihuddraw_alpha $player[local.v] local.nameSlot 0
						ihuddraw_alpha $player[local.v] local.chkSlot 0
					}
				}
				continue
			}

			// row content: padded rank emblem (matches xp.scr), clean name, ready flag
			local.rank = local.pl.flags["coop_xp_rank"]
			if( local.rank == NIL ){ local.rank = 0 }
			local.rn = local.rank
			if( local.rn < 10 ){ local.rn = "0" + local.rn }
			local.nm = waitthread game.player::playerCleanName local.pl.netname
			local.rdy = local.pl.flags["coop_lobbyReady"]

			// checkmark sits right after the name: name starts at x=23, verdana-12 averages ~6.5 virtual px
			// per char. Recomputed here every refresh, so it tracks a name changed live in the lobby. Clamped.
			local.nmlen = local.nm.size
			if( local.nmlen == NIL ){ local.nmlen = 0 }
			local.nmw = local.nmlen * 6.5
			local.nmw = int( local.nmw )
			local.chkX = local.nmw + 29
			if( local.chkX < 40 ){ local.chkX = 40 }
			if( local.chkX > 600 ){ local.chkX = 600 }

			for( local.v = 1; local.v <= $player.size; local.v++ ){
				local.viewer = $player[local.v]
				if( local.viewer == NULL ){ continue }

				// rank emblem - compact, matched to the text height
				ihuddraw_virtualsize local.viewer local.rankSlot 1
				ihuddraw_align local.viewer local.rankSlot left top
				ihuddraw_rect local.viewer local.rankSlot 8 local.ly 12 12
				ihuddraw_shader local.viewer local.rankSlot ( "textures/hud/coop_rank_" + local.rn )
				ihuddraw_color local.viewer local.rankSlot 1 1 1
				ihuddraw_alpha local.viewer local.rankSlot 1

				// name
				ihuddraw_virtualsize local.viewer local.nameSlot 1
				ihuddraw_align local.viewer local.nameSlot left top
				ihuddraw_rect local.viewer local.nameSlot 23 ( local.ly + 1 ) 0 0
				ihuddraw_font local.viewer local.nameSlot "verdana-12"
				ihuddraw_string local.viewer local.nameSlot local.nm
				ihuddraw_color local.viewer local.nameSlot 1 1 1
				ihuddraw_alpha local.viewer local.nameSlot 1

				// high-def green checkmark once readied (textures/hud/coop_ready_check.tga)
				if( local.rdy == 1 ){
					ihuddraw_virtualsize local.viewer local.chkSlot 1
					ihuddraw_align local.viewer local.chkSlot left top
					ihuddraw_rect local.viewer local.chkSlot local.chkX local.ly 11 11
					ihuddraw_shader local.viewer local.chkSlot "textures/hud/coop_ready_check"
					ihuddraw_color local.viewer local.chkSlot 1 1 1
					ihuddraw_alpha local.viewer local.chkSlot 1
				} else {
					ihuddraw_alpha local.viewer local.chkSlot 0
				}
			}
		}
		wait 0.5
	}

	// lobby ended - wipe the roster + help + countdown (slots 100-114) so nothing bleeds into the launched mission
	for( local.p = 1; local.p <= $player.size; local.p++ ){
		if( $player[local.p] == NULL ){ continue }
		for( local.s = 100; local.s <= 114; local.s++ ){
			ihuddraw_alpha $player[local.p] local.s 0
		}
	}
}end

//=========================================================================
//[user 07-18] LEFT-SIDE "NEW UNLOCKS" LIST - ihuddraw slots 117-126 (claimed in
// _research/hud_slot_map.md; >= 100 = HUD-fade-exempt, clear of the roster 100-111,
// help/countdown 112-114, readygate 115-116 and the SR panel 150-174/196-249).
// Shows everything THIS player unlocked since their last lobby visit (challenge
// rewards + rank-up grants - challenges.scr::chal_add_unlock queues the names and
// persists them across the mission->lobby map change). PER-VIEWER: each player only
// sees their own list. Small verdana-12 stack under the top-left help text: header +
// up to 8 "New Unlock: <Name>" lines + a "+N more" overflow line. Stays up for the
// whole lobby stay; lobbyLaunch empties the queue (chal_pend_clear) and this thread
// wipes the slots when the lobby ends. Refresh loop = late joiners + live grants.
//=========================================================================
lobbyUnlockList:{
//=========================================================================
	while( level.coop_lobbyActive == 1 ){
		for( local.v = 1; local.v <= $player.size; local.v++ ){
			local.viewer = $player[local.v]
			if( local.viewer == NULL ){ continue }

			// the queue loads with the challenge save (chal_ensure). Not loaded yet (fresh joiner):
			// kick the load off NON-blocking and try again next refresh - never stall the loop.
			if( local.viewer.flags["coop_chal_loaded"] != 1 ){
				thread coop_mod/challenges.scr::chal_ensure local.viewer
				continue
			}

			local.pd = local.viewer.flags["coop_unlockPend"]
			if( local.pd == NIL ){ local.pd = "" }

			// split the "~"-separated names into up to 8 lines + an overflow count
			local.n = 0
			local.extra = 0
			local.field = ""
			local.i = 0
			while( local.i <= local.pd.size ){
				local.done = 0
				if( local.i == local.pd.size ){ local.done = 1 }
				else if( local.pd[local.i] == "~" ){ local.done = 1 }
				if( local.done == 1 ){
					if( local.field != "" ){
						if( local.n < 8 ){ local.line[local.n] = local.field; local.n++ }
						else { local.extra++ }
					}
					local.field = ""
				} else {
					local.field += local.pd[local.i]
				}
				local.i++
			}

			if( local.n <= 0 ){
				for( local.s = 117; local.s <= 126; local.s++ ){ ihuddraw_alpha local.viewer local.s 0 }
				continue
			}

			// header - sits below the two help lines (y=12/26), well above the roster rows (y=410+)
			ihuddraw_virtualsize local.viewer 117 1
			ihuddraw_align local.viewer 117 left top
			ihuddraw_rect local.viewer 117 12 46 0 0
			ihuddraw_font local.viewer 117 "verdana-12"
			ihuddraw_string local.viewer 117 "NEW UNLOCKS"
			ihuddraw_color local.viewer 117 1 0.85 0.4
			ihuddraw_alpha local.viewer 117 0.9

			for( local.j = 0; local.j < 8; local.j++ ){
				local.s = 118 + local.j
				if( local.j < local.n ){
					local.ly = 60 + ( local.j * 14 )
					ihuddraw_virtualsize local.viewer local.s 1
					ihuddraw_align local.viewer local.s left top
					ihuddraw_rect local.viewer local.s 12 local.ly 0 0
					ihuddraw_font local.viewer local.s "verdana-12"
					ihuddraw_string local.viewer local.s ( "New Unlock: " + local.line[local.j] )
					ihuddraw_color local.viewer local.s 0.85 0.95 0.85
					ihuddraw_alpha local.viewer local.s 0.9
				} else {
					ihuddraw_alpha local.viewer local.s 0
				}
			}

			if( local.extra > 0 ){
				ihuddraw_virtualsize local.viewer 126 1
				ihuddraw_align local.viewer 126 left top
				ihuddraw_rect local.viewer 126 12 172 0 0
				ihuddraw_font local.viewer 126 "verdana-12"
				ihuddraw_string local.viewer 126 ( "+" + local.extra + " more" )
				ihuddraw_color local.viewer 126 0.7 0.8 0.7
				ihuddraw_alpha local.viewer 126 0.9
			} else {
				ihuddraw_alpha local.viewer 126 0
			}
		}
		wait 1
	}

	// lobby ended - wipe the whole list block so nothing bleeds into the launched mission
	for( local.p = 1; local.p <= $player.size; local.p++ ){
		if( $player[local.p] == NULL ){ continue }
		for( local.s = 117; local.s <= 126; local.s++ ){
			ihuddraw_alpha $player[local.p] local.s 0
		}
	}
}end

//=========================================================================
lobbyHideHud:{
//=========================================================================
	// self = player. Hide the coop HUD - the health/ammo/objectives ihuddraw slots (the same slots the
	// DBNO spectator cleanup clears) plus the compass menu. Re-asserted because the HUD re-inits at spawn.
	// Coop draws its HUD across slots 20..72 (ammo/nade/objectives ~27-47, deployables/XP/rank ~62-72).
	// Hide the WHOLE range and keep re-asserting while the lobby is active - the XP + item HUD threads
	// re-draw their slots on update, so a one-shot (or 4s) hide leaks the icons back (bug-361).
	while( level.coop_lobbyActive == 1 && self != NULL ){
		for( local.s = 20; local.s <= 90; local.s++ ){
			ihuddraw_alpha self local.s 0
		}
		// drawhud is a LEVEL script command (not a client cvar) - call it bare. Hides the vanilla HUD + compass.
		drawhud 0
		self stufftext "ui_removehud hud_compass"
		// The vanilla bottom-left STAR lives in the hud_health UI MENU (ui/hud_health.urc, faded via
		// ui_hudAlpha) - drawhud 0 / PMF_NO_HUD does NOT remove UI menus, so remove them by name like compass.
		self stufftext "ui_removehud hud_health"
		self stufftext "ui_removehud hud_ammo"
		wait 0.5
	}
}end

