//====================================================================
// parasquad.scr - HZM coop PARATROOPER SQUAD BRAIN (2026-10-04)
//====================================================================
// [user 2026-10-04] "I do need those allied paratroopers to be able to have squad brain, take
// cover, work together, prone, throw grenades, clear rooms etc. To make them smart but without
// them damaging themselves or friendlies." + one trooper sets up a mounted .30 cal.
//
// One brain per stick (paradrop.scr::coop_paradrop_main -> newSquad + brain). Members 1-4 are
// driven here; member 5 (medic) keeps its own tend/advance loop and only counts for safety.
// Who is who (paradrop.scr, by door order): 1 BAR, 2 Thompson, 3 M1 Garand - he carries the
// .30 cal -, 4 Springfield sniper, 5 medic.
//   POSTS    every man has a POST: a point his leash is tethered to (the engine's own `tether`:
//            Actor::Think puts m_vHome on the tether entity every frame). The engine's cover and
//            turret thinks path, hunt and take cover nodes only INSIDE the leash round that point
//            (SetPathWithLeash / MovePathWithLeash), so where the post is, is where he fights. The
//            brain moves posts; the man follows. (Until 2026-10-12 the leash was 640u and was reset
//            to wherever he stood - on every order here and by the engine on every new enemy - so
//            it never held anyone: that was the "brainless rush", 1000u past the players.)
//   FOLLOW   no contact for 8s: wedge behind the anchor (the trooper who threw the smoke, else the
//            nearest player), the two fire teams (1+3 / 2+4) moving on alternate ticks = bounding.
//   CONTACT  the wedge turns to face the enemy and stays BEHIND / BESIDE the players - nobody goes
//            past them toward the enemy; a man who is, comes back. Engine combat inside the leash
//            (type_attack cover: cover nodes, peeking; own prone/crouch legs in anim/attack.scr) plus:
//            - BASE OF FIRE: the .30 cal with the enemy in its arc, else the BAR man with a line to
//              him, else two riflemen with one. No base of fire = nobody moves up;
//            - BOUND: with a base of fire up, the men who are behind their place move up one fire
//              team at a time, 300u at most, to cover where there is some, while the base
//              suppresses (the gun fires bursts for the move, the others suppresschance 100);
//            - COVER: a man in plain view of the enemy goes (crouched) to the nearest cover - low
//              cover he can fire over first, else a corner - and his post goes with him; with no
//              cover in reach he gets small where he is;
//            - PINNED: a man who has just been hit stays down where he is (or crawls to cover
//              within 130u) for 4s: no orders;
//            - MAN DOWN: for 6s nobody bounds, everybody in view takes cover;
//            - LANES: a man in front of a player's muzzle steps out of it; no post in a doorway;
//            - GRENADES: scripted throw (calcgrenadetoss + the retail throw anim), never the
//              engine's own decision (ammo_grenade stays 0 otherwise);
//            - ROOM CLEARING: an enemy under a roof and walled in -> two men stack outside the
//              wall line, frag in when it is safe, then enter while the rest cover.
//   .30 CAL  one man carries an M1919; when the squad has held one spot for 6s he takes it to
//            the nearest cover he can rest its bipod on and fire over at the enemy, else puts down
//            a small sandbag rest where he can (never in the way), and mans it as a real TurretGun
//            (actor machinegunner think, mg42_active.scr recipe): suppresses, holds fire with a
//            friend in front, re-sites when the fight moves, packs up when the squad moves on.
//            See THE .30 CAL EMPLACEMENT below (bug-3562).
//
// FRIENDLY-FIRE SAFETY (the hard requirement):
//   * Sentient::ArmorDamage drops damage whose attacker is a SAME-TEAM sentient (sentient.cpp,
//     "same-team damage is filtered in ALL gametypes"), so a trooper's bullets, grenades and his
//     manned turret's bullets (owner = the gunner) can never hurt a player or another trooper.
//   * Two holes remain and are closed here: (1) attacker == self is NOT filtered - his own
//     grenade can hurt him; (2) a grenade whose thrower is gone (corpse removed) explodes with no
//     owner and hurts everyone. So every throw needs the target >= 450u from the thrower and from
//     every player, >= 400u from every allied actor, re-checked just before release, and the
//     thrower is immune to grenades until his own has gone off.
//   * Nothing here spawns a weapon entity that is not owned by the trooper using it (bug-3309:
//     the strafing gun was not a Sentient, so the filter never applied). No radiusdamage.
//   * The .30 cal never sets up with a player in front of the muzzle.
// Debug lines (^~^~^ PSQ ...) print only with coop_paraDebug 1.
// Traces: traced <a> <b> 1023 (0 0 0) (0 0 0) 1 = ignore no entity, CONTENTS_SOLID only - a body
// (trooper, player, enemy) or a clip brush is never mistaken for cover.
//====================================================================

newSquad local.caller:{
	if( level.coop_psqN == NIL ){ level.coop_psqN = 0 }
	level.coop_psqN++
	local.sid = level.coop_psqN
	level.coop_psqCaller[local.sid] = local.caller
	level.coop_psqHolding[local.sid] = 0
	level.coop_psqT0[local.sid] = level.time
	level.coop_psqM[local.sid][1] = NIL		// the array exists before anyone lands
}end local.sid


dbg local.s:{
	local.d = getcvar( "coop_paraDebug" )
	if( local.d == "1" || local.d == "2" ){ println( "^~^~^ PSQ t=" + level.time + " " + local.s ) }
}end


// last notable squad action (read by debug/test tooling: who did what, when)
ev local.name local.a:{
	level.coop_psqEv = local.name
	level.coop_psqEvActor = local.a
	level.coop_psqEvT = level.time
}end


// self = the landed, activated trooper. One deterministic setup instead of the german
// personality roll (bug-3309), latched so no global pass re-rolls him.
member local.k local.sid:{
	if( self == NULL ){ end }
	self.flags["coop_personality_set"] = 1
	self.flags["coop_role"] = "para"
	self.coop_psqSid = local.sid
	self.coop_psqK = local.k
	self.coop_psqBusy = 0
	self.coop_psqMounted = 0
	self.coop_psqNadeT = 0
	self.coop_psqNoPath = 0
	self.coop_psqNoGo = 0
	self.coop_psqWoFail = 0
	self.coop_psqLost = 0
	self.coop_psqPinT = 0
	self.coop_psqSideT = 0
	self.coop_psqCovT = 0
	self.coop_psqHp = self.health
	self type_attack "cover"
	self.mindist = 128
	// maxdist: an American whose enemy is beyond it always CHARGES (Actor::Turret_SelectState - the "hold at
	// your leash" branch is German-only). 3000 = he fights from where he is posted.
	self.maxdist = 3000
	self.interval = 128			// spacing the engine keeps from squadmates while moving
	self.nosurprise = 1
	self.ammo_grenade = 0			// no engine-decided throws - only the checked scripted ones below
	self gren_awareness 90			// he sees a grenade land (engine default 20%): the engine's own grenade think gets him away
	self.suppresschance = 40
	self.coop_paraProne = 25		// anim/attack.scr: own prone leg at long range
	self.coop_paraCrouch = 45		// own crouch leg (raised while he holds a low-cover spot)
	self.coop_paraBrain = 1			// set LAST: attack.scr reads the two values above once this is 1
	waitthread post self self.origin 240
	if( local.sid != NIL ){
		level.coop_psqM[local.sid][local.k] = self
		// the .30 cal is the RIFLEMAN's (member 3, the M1 Garand): the BAR man (member 1) keeps his BAR
		// and stays the squad's automatic rifle. Member 3 is also the man who gets out of a C-47 that
		// is lost to flak; a squad that lands without him has no .30 cal (the sniper and the medic
		// never take it).
		if( local.k == 3 ){ thread gunner self local.sid }
	}
}end


// His POST: the point his leash is tethered to (see the header). local.leash = how far from it the engine may
// take him. Never `resetleash` on a trooper - it clears the tether (Actor::EventResetLeash).
post local.a local.pos local.leash:{
	if( local.a == NIL || local.a == NULL ){ end }
	local.e = local.a.coop_psqPost
	if( local.e == NIL || local.e == NULL ){
		local.e = spawn script_origin
		local.e.origin = local.pos
		local.a.coop_psqPost = local.e
		local.a tether local.e
	}
	local.e.origin = local.pos
	local.a.leash = local.leash
}end


// The squad's anchor: the trooper-caller if he is alive and playing, else the nearest player.
anchor local.sid:{
	local.c = level.coop_psqCaller[local.sid]
	if( local.c != NIL && local.c != NULL ){
		if( isAlive local.c && local.c.health > 0 && local.c.dmteam != "spectator" ){ end local.c }
	}
	local.cen = waitthread centroid local.sid
	local.best = NIL
	local.bd = 999999
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || !isAlive local.p || local.p.dmteam == "spectator" ){ continue }
		if( local.cen == NIL ){ local.best = local.p; break }
		local.d = vector_length( local.p.origin - local.cen )
		if( local.d < local.bd ){ local.bd = local.d; local.best = local.p }
	}
}end local.best


centroid local.sid:{
	local.n = 0
	local.sum = ( 0 0 0 )
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( local.a == NIL || local.a == NULL ){ continue }
		if( !isAlive local.a ){ continue }
		local.sum = local.sum + local.a.origin
		local.n++
	}
	if( local.n == 0 ){ end NIL }
	local.r = vector_scale local.sum ( 1.0 / local.n )
}end local.r


// usable = landed, alive, not busy with a scripted move/throw/clear, not on the gun
usable local.a:{
	if( local.a == NIL || local.a == NULL ){ end 0 }
	if( !isAlive local.a ){ end 0 }
	if( local.a.coop_psqBusy == 1 || local.a.coop_psqMounted == 1 ){ end 0 }
}end 1


flatDist local.a local.b:{
	local.v = local.a - local.b
	local.v[2] = 0
	local.r = vector_length local.v
}end local.r


//====================================================================
brain local.sid:{
	wait 8					// the stick is still under canopy
	local.lastContact = 0 - 100
	local.lastNade = 0 - 100
	local.lastClear = 0 - 100
	local.holdRef = NIL
	local.holdSince = level.time
	local.phase = 0
	local.boundTeam = 1
	local.boundTick = 0
	local.cc = 0
	local.wave = 0
	local.clrTick = 0
	local.wasContact = 0
	local.prevAlive = 0
	local.shaken = 0
	local.axis = NIL
	waitthread dbg ( "brain start sid=" + local.sid )
	while( 1 ){
		wait 1
		// ---- roster ----
		local.alive = 0
		for( local.k = 1; local.k <= 5; local.k++ ){
			local.a = level.coop_psqM[local.sid][local.k]
			if( local.a != NIL && local.a != NULL ){
				if( isAlive local.a ){
					local.alive++
				} else {
					// a dead man's post goes
					local.pe = local.a.coop_psqPost
					if( local.pe != NIL && local.pe != NULL ){ local.pe remove }
					local.a.coop_psqPost = NIL
				}
			}
		}
		if( local.alive == 0 && ( level.time - level.coop_psqT0[local.sid] ) > 45 ){
			waitthread dbg ( "brain end sid=" + local.sid )
			end
		}
		if( local.alive == 0 ){ continue }
		if( local.alive < local.prevAlive ){
			// MAN DOWN: six seconds in which nobody moves up and everybody in view gets behind something
			local.shaken = level.time + 6
			waitthread dbg ( "tac mandown alive=" + local.alive )
		}
		local.prevAlive = local.alive

		// ---- anchor + facing ----
		local.anc = waitthread anchor local.sid
		if( level.coop_paraHoldPos != NIL ){
			local.apos = level.coop_paraHoldPos
			local.ayaw = 0
			if( level.coop_paraHoldYaw != NIL ){ local.ayaw = level.coop_paraHoldYaw }
		} else {
			if( local.anc == NIL ){ continue }
			local.apos = local.anc.origin
			local.v = local.anc.velocity
			local.v[2] = 0
			local.vl = vector_length local.v
			if( local.vl > 60 ){
				local.va = vector_toangles local.v
				local.ayaw = local.va[1]
			} else {
				local.ayaw = local.anc.viewangles[1]
			}
		}
		level.coop_psqApos[local.sid] = local.apos
		level.coop_psqAyaw[local.sid] = local.ayaw

		// ---- holding? (anchor within 160u of one spot for 6s) ----
		if( local.holdRef == NIL ){ local.holdRef = local.apos; local.holdSince = level.time }
		local.hd = waitthread flatDist local.apos local.holdRef
		if( local.hd > 160 ){
			local.holdRef = local.apos
			local.holdSince = level.time
		}
		if( ( level.time - local.holdSince ) >= 6 ){ level.coop_psqHolding[local.sid] = 1 } else { level.coop_psqHolding[local.sid] = 0 }

		// ---- contact + nearest known threat ----
		local.thr = NIL
		local.td = 999999
		for( local.k = 1; local.k <= 5; local.k++ ){
			local.a = level.coop_psqM[local.sid][local.k]
			if( local.a == NIL || local.a == NULL ){ continue }
			if( !isAlive local.a ){ continue }
			local.e = local.a.enemy
			if( local.e == NIL || local.e == NULL ){ continue }
			if( !isAlive local.e ){ continue }
			local.lastContact = level.time
			local.d = vector_length( local.e.origin - local.apos )
			if( local.d < local.td ){ local.td = local.d; local.thr = local.e.origin }
		}
		level.coop_psqThreat[local.sid] = local.thr
		if( local.thr != NIL ){
			level.coop_psqLastThr[local.sid] = local.thr
			level.coop_psqLastThrT[local.sid] = level.time
		}
		waitthread trail
		local.inContact = 0
		if( ( level.time - local.lastContact ) < 8 ){ local.inContact = 1 }

		// ---- the way the fight faces: toward the nearest known enemy; it turns only when he is more than 55
		// degrees off it (a wedge that swung with every new target would have the men running under fire)
		if( local.thr != NIL ){
			local.v = local.thr - local.apos
			local.v[2] = 0
			if( vector_length local.v > 32 ){
				local.va = vector_toangles local.v
				if( local.axis == NIL ){ local.axis = local.va[1] }
				local.df = local.va[1] - local.axis
				while( local.df > 180 ){ local.df = local.df - 360 }
				while( local.df < ( 0 - 180 ) ){ local.df = local.df + 360 }
				if( local.df < 0 ){ local.df = 0 - local.df }
				if( local.df > 55 ){ local.axis = local.va[1] }
			}
		}
		if( local.inContact == 0 ){ local.axis = NIL }
		local.cyaw = local.ayaw
		if( local.axis != NIL ){ local.cyaw = local.axis }
		local.cfw = angles_toforward ( 0 local.cyaw 0 )

		// ---- first contact: every man's post is where he stands (nobody runs to a slot under fire) ----
		if( local.inContact == 1 && local.wasContact == 0 ){
			for( local.k = 1; local.k <= 5; local.k++ ){
				local.a = level.coop_psqM[local.sid][local.k]
				if( local.a == NIL || local.a == NULL ){ continue }
				if( !isAlive local.a || local.a.coop_psqMounted == 1 || local.k == 5 ){ continue }
				local.a.coop_psqHp = local.a.health
				waitthread post local.a local.a.origin 180
			}
			waitthread dbg ( "tac contact thr=" + local.thr )
			// ...and for the next 4s every man in view looks for cover at once (one a second is the rule after that),
			// and nobody bounds
			if( level.time >= local.shaken ){ local.shaken = level.time + 4 }
		}
		local.wasContact = local.inContact

		// ---- who suppresses? ----
		local.base = 0
		if( local.inContact == 1 && local.thr != NIL ){ local.base = waitthread baseOfFire local.sid local.thr }
		level.coop_psqBase[local.sid] = local.base

		if( local.phase == 1 ){ local.phase = 0 } else { local.phase = 1 }
		local.boundTick++
		if( local.boundTick >= 3 ){
			local.boundTick = 0
			if( local.boundTeam == 1 ){ local.boundTeam = 0 } else { local.boundTeam = 1 }
		}
		local.cc++
		if( local.cc > 4 ){ local.cc = 1 }

		// ---- per member ----
		local.movers = 0
		for( local.k = 1; local.k <= 4; local.k++ ){
			local.a = level.coop_psqM[local.sid][local.k]
			if( !( waitthread usable local.a ) ){ continue }
			local.team = 0
			if( local.k == 1 || local.k == 3 ){ local.team = 1 }
			local.da = waitthread flatDist local.a.origin local.apos

			if( local.inContact == 0 ){
				// FOLLOW: fire teams leapfrog on alternate ticks; a straggler always moves
				local.a.coop_paraCrouch = 45
				local.a.coop_paraProne = 25
				local.a.coop_psqHp = local.a.health
				if( local.da > 240 ){
					if( local.team == local.phase || local.da > 700 ){
						local.slot = waitthread slotPos local.a local.k local.apos local.ayaw 0
						if( local.slot != NIL ){
							local.ds = waitthread flatDist local.a.origin local.slot
							if( local.ds > 120 ){
								local.a.movedoneradius = 64
								// A man standing in a map cell that holds no pathnode has no path to anywhere
								// (PathSearch::NearestStartNode looks in his own 256u cell only): that is the
								// trooper who came down in a bad spot and never moves. Two orders that got him
								// nowhere and he walks out in a straight line, as far as the ground was traced.
								local.so = local.a.coop_psqOrdO
								local.a.coop_psqOrdO = local.a.origin
								if( local.so != NIL ){
									if( vector_length( local.a.origin - local.so ) < 24 && local.a.pathdist == 0 ){
										local.a.coop_psqNoPath++
									} else {
										local.a.coop_psqNoPath = 0
									}
								}
								if( local.a.coop_psqNoPath >= 2 ){
									local.a.coop_psqNoPath = 0
									thread walkOut local.a local.slot
								} else {
									waitthread post local.a local.slot 320
									local.a runto local.slot
								}
							}
						}
					}
				}
				continue
			}

			// ---- CONTACT ----
			// hit since the last look: PINNED for 4s - he stays down, and gets no order
			if( local.a.health < ( local.a.coop_psqHp - 10 ) ){
				if( level.time >= local.a.coop_psqPinT ){ waitthread dbg ( "tac pinned k=" + local.k + " hp=" + local.a.health ) }
				local.a.coop_psqPinT = level.time + 4
			}
			local.a.coop_psqHp = local.a.health
			// what is between him and the enemy (0 = nothing: he is in plain view)
			local.c = 3
			if( local.thr != NIL ){ local.c = waitthread cov local.a.origin ( local.thr + ( 0 0 56 ) ) }
			if( level.time < local.a.coop_psqPinT ){
				local.a.coop_paraCrouch = 100
				if( local.c == 0 && level.time >= local.a.coop_psqCovT ){
					local.a.coop_psqCovT = level.time + 4
					thread coverCheck local.a 130
				}
				continue
			}
			local.slot = waitthread slotPos local.a local.k local.apos local.cyaw 1
			if( local.slot == NIL ){ continue }
			local.ds = waitthread flatDist local.a.origin local.slot
			// past the players, toward the enemy? Then he comes back.
			local.v = local.a.origin - local.apos
			local.v[2] = 0
			local.al = vector_dot local.v local.cfw
			local.back = 0
			if( local.al > 140 ){ local.back = 1 }
			local.go = 0
			if( local.back == 1 || local.ds > 340 ){
				// he is not where he belongs. Coming back, or catching up from far behind, he always may; moving UP
				// only with a base of fire, his own fire team's turn, two men at most, and nobody just hit
				if( local.back == 1 || local.da > 1100 ){ local.go = 1 }
				if( local.go == 0 && local.base >= 1 && level.time >= local.shaken && local.team == local.boundTeam && local.movers < 2 ){ local.go = 1 }
			}
			if( local.go == 1 ){
				local.movers++
				thread bound local.a local.sid local.slot local.thr local.back
				continue
			}
			if( local.c == 0 ){
				// in plain view: one man a tick looks for cover (every man, when one of them has just gone down)
				if( local.k == local.cc || level.time < local.shaken ){
					if( level.time >= local.a.coop_psqCovT ){
						local.a.coop_psqCovT = level.time + 3
						thread coverCheck local.a 200
					}
				}
			} else if( local.c == 1 ){
				local.a.coop_paraCrouch = 100		// low cover in front of him: down behind it between shots
			} else {
				local.a.coop_paraCrouch = 45
			}
		}

		// ---- the medic's leash is tethered behind the players: he fights from there and does not run at the enemy.
		// (His own loop in paradrop.scr still runs him to a patient - a move order is not leash-bound.)
		local.a = level.coop_psqM[local.sid][5]
		if( local.a != NIL && local.a != NULL ){
			if( isAlive local.a ){
				local.mp = local.apos - ( vector_scale local.cfw 220 )
				waitthread post local.a local.mp 400
			}
		}

		// ---- out of the players' line of fire: in a fight, or while the player is firing ----
		for( local.k = 1; local.k <= 4; local.k++ ){
			local.a = level.coop_psqM[local.sid][local.k]
			if( !( waitthread usable local.a ) ){ continue }
			if( level.time < local.a.coop_psqSideT ){ continue }
			local.p = waitthread inFire local.a.origin
			if( local.p == NIL ){ continue }
			if( local.inContact != 1 && local.p.fireheld != 1 ){ continue }
			local.fw = angles_toforward ( 0 local.p.viewangles[1] 0 )
			local.v = local.a.origin - local.p.origin
			local.v[2] = 0
			local.al = vector_dot local.v local.fw
			local.sd = local.v - ( vector_scale local.fw local.al )
			if( vector_length local.sd < 2 ){ local.sd = angles_toforward ( 0 ( local.p.viewangles[1] - 90 ) 0 ) }
			local.sd = vector_normalize local.sd
			local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.a.origin + ( vector_scale local.sd 110 ) + ( 0 0 40 ) )
			if( local.g == NIL ){ continue }
			if( waitthread tight local.g ){ continue }
			local.a.coop_psqSideT = level.time + 5
			waitthread dbg ( "tac lane k=" + local.k + " to=" + local.g )
			thread moveTo local.a local.g 1.5 0 "lane"
		}

		// ---- and out of the .30 cal's: a man in front of its muzzle silences it (mgHold holds the fire for him) ----
		local.gn = level.coop_psqM[local.sid][3]
		if( local.gn != NIL && local.gn != NULL ){
			if( isAlive local.gn && local.gn.coop_psqMounted == 1 && local.gn.coop_psqMgGun != NIL ){
				local.gd = angles_toforward ( 0 local.gn.coop_psqMgYaw 0 )
				for( local.k = 1; local.k <= 4; local.k++ ){
					local.a = level.coop_psqM[local.sid][local.k]
					if( local.k == 3 ){ continue }
					if( !( waitthread usable local.a ) ){ continue }
					if( level.time < local.a.coop_psqSideT ){ continue }
					local.v = local.a.origin - local.gn.coop_psqMgGun
					local.hz = local.v[2] + 40
					if( local.hz < 0 ){ local.hz = 0 - local.hz }
					local.v[2] = 0
					local.al = vector_dot local.v local.gd
					if( local.al <= 0 || local.al > 900 ){ continue }
					if( local.hz > 110 && local.hz > ( local.al * 0.25 ) ){ continue }
					local.sd = local.v - ( vector_scale local.gd local.al )
					local.lat = vector_length local.sd
					// (the gun's whole traverse at his range, and a man's width)
					local.need = 80 + ( local.al * 0.25 )
					if( local.need > 260 ){ local.need = 260 }
					if( local.lat >= local.need ){ continue }
					if( local.lat < 2 ){ local.sd = angles_toforward ( 0 ( local.gn.coop_psqMgYaw - 90 ) 0 ) }
					local.sd = vector_normalize local.sd
					local.step = ( local.need - local.lat ) + 40
					if( local.step > 220 ){ local.step = 220 }
					local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.a.origin + ( vector_scale local.sd local.step ) + ( 0 0 40 ) )
					if( local.g == NIL ){ continue }
					local.a.coop_psqSideT = level.time + 4
					waitthread dbg ( "tac gunlane k=" + local.k + " lat=" + local.lat + " to=" + local.g )
					thread moveTo local.a local.g 2.0 0 "gunlane"
				}
			}
		}

		// ---- officer-wave targets (they hunt players only and never notice AI on their own) ----
		local.wave++
		if( local.wave >= 3 && level.coop_wave_count != NIL ){
			local.wave = 0
			for( local.k = 1; local.k <= 4; local.k++ ){
				local.a = level.coop_psqM[local.sid][local.k]
				if( !( waitthread usable local.a ) ){ continue }
				if( local.a.enemy != NULL ){ continue }
				local.best = NULL
				local.bd = 2000
				for( local.wi = 1; local.wi <= level.coop_wave_count; local.wi++ ){
					local.w = level.coop_wave_actors[local.wi]
					if( local.w == NIL || local.w == NULL ){ continue }
					if( !isAlive local.w ){ continue }
					local.d = vector_length( local.w.origin - local.a.origin )
					if( local.d < local.bd ){
						if( local.a cansee local.w ){ local.bd = local.d; local.best = local.w }
					}
				}
				if( local.best != NULL ){ local.a attackentity local.best }
			}
		}

		// ---- grenades (one per squad per 9s) ----
		if( local.inContact == 1 && ( level.time - local.lastNade ) >= 9 ){
			if( waitthread tryGrenade local.sid ){ local.lastNade = level.time }
		}
		// ---- room clearing (one per squad per 30s): only with a base of fire, and not with a man just down ----
		local.clrTick++
		if( local.clrTick >= 3 && local.inContact == 1 && ( level.time - local.lastClear ) >= 30 && local.base >= 1 && level.time >= local.shaken ){
			local.clrTick = 0
			if( waitthread tryClear local.sid local.apos ){ local.lastClear = level.time }
		}
	}
}end


// wedge slot behind the anchor, grounded and reachable, or NIL
slotPos local.a local.k local.apos local.ayaw local.fight:{
	local.back = 170
	local.side = 150
	if( local.k >= 3 ){ local.back = 320; local.side = 240 }
	if( local.fight == 1 ){
		// in a fight the wedge is flatter and wider: a firing line beside and behind the players
		local.back = 90
		local.side = 190
		if( local.k >= 3 ){ local.back = 200; local.side = 330 }
	}
	if( local.k == 1 || local.k == 3 ){ local.side = 0 - local.side }
	local.fwd = angles_toforward ( 0 local.ayaw 0 )
	local.rgt = angles_toforward ( 0 ( local.ayaw - 90 ) 0 )
	local.p = local.apos - ( vector_scale local.fwd local.back ) + ( vector_scale local.rgt local.side )
	// NOTE: never `canmoveto` here - it is a leash/mindist/interval test against the actor's HOME, not a
	// path test, so it refused nearly every slot in the 2026-10-04 run. runto paths; a dead-end order
	// simply stalls and the next tick re-plans.
	local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.p + ( 0 0 48 ) )
	if( local.g != NIL ){
		local.dz = local.g[2] - local.apos[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz < 120 ){ end local.g }		// not the roof or the cellar under that point
	}
	// half-size wedge
	local.p = local.apos - ( vector_scale local.fwd ( local.back * 0.5 ) ) + ( vector_scale local.rgt ( local.side * 0.5 ) )
	local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.p + ( 0 0 48 ) )
	if( local.g != NIL ){
		local.dz = local.g[2] - local.apos[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz < 120 ){ end local.g }
	}
}end NIL


// scripted move with the enemy think off so the order is obeyed (aimaneuver.scr pattern);
// the enemy think ALWAYS comes back on before this returns
moveTo local.a local.pos local.tmo local.crouch local.why:{
	if( local.a == NIL || local.a == NULL ){ end }
	if( !isAlive local.a ){ end }
	if( local.a.coop_psqBusy == 1 || local.a.coop_psqMounted == 1 ){ end }	// somebody else has him
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.a.movedoneradius = 40
	local.d0 = vector_length( local.a.origin - local.pos )
	waitthread post local.a local.pos 240
	if( local.crouch == 1 ){ local.a crouchto local.pos } else { local.a runto local.pos }
	local.t = 0
	while( local.t < local.tmo ){
		wait 0.25
		local.t = local.t + 0.25
		if( local.a == NULL ){ end }
		if( !isAlive local.a ){ end }
		if( vector_length( local.a.origin - local.pos ) < 56 ){ break }
		if( local.t >= 0.75 ){
			local.v = local.a.velocity
			if( ( local.v[0] * local.v[0] ) + ( local.v[1] * local.v[1] ) < 100 ){ break }
		}
	}
	// his post is where he got to (the leash holds him there; see the header)
	waitthread post local.a local.a.origin 170
	local.a.enableEnemy = 1
	local.a forceactivate
	local.a.coop_psqBusy = 0
	// an order that got him nowhere and found no path (no pathnode in his 256u cell): the second one in a row
	// and he walks out in a straight line (walkOut); if that fails too he is LOST (see walkOut)
	if( local.d0 > 100 && vector_length( local.a.origin - local.pos ) > ( local.d0 - 24 ) && local.a.pathdist == 0 ){
		local.a.coop_psqNoGo++
		if( local.a.coop_psqNoGo >= 2 ){
			local.a.coop_psqNoGo = 0
			thread walkOut local.a local.pos
		}
	} else {
		local.a.coop_psqNoGo = 0
		local.a.coop_psqWoFail = 0
		local.a.coop_psqLost = 0
	}
	waitthread dbg ( "move k=" + local.a.coop_psqK + " why=" + local.why + " left=" + ( vector_length( local.a.origin - local.pos ) ) )
}end


// a line of fire from local.p to an enemy standing at local.thr: clear to within 96u of him
lineTo local.p local.thr:{
	local.e = local.thr + ( 0 0 40 )
	local.d = vector_length( local.e - local.p )
	if( local.d < 97 ){ end 1 }
	local.tr = traced local.p local.e 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
	if( ( local.tr["fraction"] * local.d ) >= ( local.d - 96 ) ){ end 1 }
}end 0


// who suppresses while the others move: 2 = the .30 cal is up with the enemy in its arc and a clear line, 1 = the
// BAR man has a line to him, or two of the others have; 0 = nobody (then nobody moves up)
baseOfFire local.sid local.thr:{
	local.g = level.coop_psqM[local.sid][3]
	if( local.g != NIL && local.g != NULL ){
		if( isAlive local.g && local.g.coop_psqMounted == 1 && local.g.coop_psqMgGun != NIL ){
			local.v = local.thr - local.g.coop_psqMgGun
			local.v[2] = 0
			local.va = vector_toangles local.v
			local.off = local.va[1] - local.g.coop_psqMgYaw
			while( local.off > 180 ){ local.off = local.off - 360 }
			while( local.off < ( 0 - 180 ) ){ local.off = local.off + 360 }
			if( local.off < 0 ){ local.off = 0 - local.off }
			if( local.off <= local.g.coop_psqMgArc ){
				if( waitthread lineTo ( local.g.coop_psqMgGun + ( 0 0 4 ) ) local.thr ){ end 2 }
			}
		}
	}
	local.n = 0
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( !( waitthread usable local.a ) ){ continue }
		if( !( waitthread lineTo ( local.a.origin + ( 0 0 56 ) ) local.thr ) ){ continue }
		if( local.k == 1 ){ end 1 }
		local.n++
	}
	if( local.n >= 2 ){ end 1 }
}end 0


// ONE BOUND toward his place: 300u at most, to cover where there is some near the end of it, while the base of
// fire suppresses (the gun: bursts for the next 4s, mgHold; the others: suppresschance 100). local.back = 1: he is
// past the players and is coming back.
bound local.a local.sid local.slot local.thr local.back:{
	if( !( waitthread usable local.a ) ){ end }
	local.v = local.slot - local.a.origin
	local.v[2] = 0
	local.len = vector_length local.v
	local.to = local.slot
	if( local.len > 300 ){
		local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.a.origin + ( vector_scale local.v ( 300.0 / local.len ) ) + ( 0 0 48 ) )
		if( local.g != NIL ){ local.to = local.g }
	}
	local.cv = 0
	if( local.thr != NIL ){
		local.eye = local.thr + ( 0 0 56 )
		// never nearer the enemy than the players are, less 100u
		local.ap = level.coop_psqApos[local.sid]
		local.lim = waitthread flatDist local.ap local.thr
		local.lim = local.lim - 100
		local.c = waitthread coverNear local.to local.eye local.a 130 local.lim
		if( local.c != NIL ){ local.to = local.c; local.cv = 1 }
	}
	level.coop_psqSupT[local.sid] = level.time + 4
	thread overwatch local.sid local.a 3.5
	waitthread ev "bound" local.a
	waitthread dbg ( "tac bound k=" + local.a.coop_psqK + " back=" + local.back + " cover=" + local.cv + " base=" + level.coop_psqBase[local.sid] + " dist=" + ( vector_length( local.to - local.a.origin ) ) )
	waitthread moveTo local.a local.to 3.5 0 "bound"
	if( local.a == NULL ){ end }
	if( isAlive local.a && local.cv == 1 ){ local.a.coop_paraCrouch = 65 }
}end


// the others lay down suppressing fire while local.mover moves
overwatch local.sid local.mover local.secs:{
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( local.a == NIL || local.a == NULL || local.a == local.mover ){ continue }
		if( isAlive local.a ){ local.a.suppresschance = 100 }
	}
	wait local.secs
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( local.a != NIL && local.a != NULL ){
			if( isAlive local.a ){ local.a.suppresschance = 40 }
		}
	}
}end


//====================================================================
// COVER
//====================================================================
coverCheck local.a local.maxr:{
	if( !( waitthread usable local.a ) ){ end }
	if( local.maxr == NIL ){ local.maxr = 200 }
	local.eye = NIL
	local.e = local.a.enemy
	if( local.e != NIL && local.e != NULL ){
		if( isAlive local.e ){ local.eye = local.e.origin + ( 0 0 56 ) }
	}
	if( local.eye == NIL ){
		local.t = level.coop_psqThreat[local.a.coop_psqSid]
		if( local.t != NIL ){ local.eye = local.t + ( 0 0 56 ) }
	}
	if( local.eye == NIL ){ end }
	if( local.a.position == "prone" ){ end }	// prone is already a small target
	local.c = waitthread cov local.a.origin local.eye
	if( local.c == 1 ){ local.a.coop_paraCrouch = 100; end }
	if( local.c >= 2 ){ end }
	local.lim = waitthread flatDist local.a.origin local.eye
	local.lim = local.lim - 64		// never more than 64u toward him to get there
	local.spot = waitthread coverNear local.a.origin local.eye local.a local.maxr local.lim
	if( local.spot == NIL ){
		// nothing to get behind in reach: he gets small where he is
		local.a.coop_paraCrouch = 100
		local.a.coop_paraProne = 60
		waitthread dbg ( "tac nocover k=" + local.a.coop_psqK )
		end
	}
	local.a.coop_paraCrouch = 65
	waitthread ev "cover" local.a
	waitthread dbg ( "cover k=" + local.a.coop_psqK + " from=" + local.a.origin + " to=" + local.spot )
	waitthread moveTo local.a local.spot 2.5 1 "cover"
	if( local.a == NULL ){ end }
	if( isAlive local.a ){ waitthread post local.a local.a.origin 120 }
}end


// a low obstacle between a spot and the target: blocked at waist height within 72u, clear at 60
lowCoverAt local.g local.eye:{
	local.p = local.g + ( 0 0 28 )
	local.dir = vector_normalize ( local.eye - local.p )
	local.tr = traced local.p ( local.p + ( vector_scale local.dir 72 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["fraction"] >= 1.0 ){ end 0 }
	local.q = local.g + ( 0 0 60 )
	local.dir = vector_normalize ( local.eye - local.q )
	local.tr = traced local.q ( local.q + ( vector_scale local.dir 120 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["fraction"] < 1.0 ){ end 0 }
}end 1


// what a man standing at local.g has between him and an enemy's eye at local.eye (solid world only):
// 0 = nothing - he is in plain view; 1 = LOW cover: hidden to the waist by something within 72u that he can fire
// over; 2 = out of sight behind something within 220u (a corner, a wall); 3 = out of sight, the blocker far off
cov local.g local.eye:{
	if( waitthread lowCoverAt local.g local.eye ){ end 1 }
	local.p = local.g + ( 0 0 44 )
	local.d = vector_length( local.eye - local.p )
	if( local.d < 1 ){ end 0 }
	local.tr = traced local.p local.eye 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["fraction"] >= 1.0 ){ end 0 }
	local.d1 = local.tr["fraction"] * local.d
	local.q = local.g + ( 0 0 70 )
	local.tr = traced local.q local.eye 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["fraction"] >= 1.0 ){ end 0 }
	if( local.d1 < 220 ){ end 2 }
}end 3


// a doorway, a corridor, a gap: something within 56u on BOTH sides at chest height, along either axis
tight local.g:{
	local.c = local.g + ( 0 0 40 )
	for( local.j = 0; local.j < 2; local.j++ ){
		local.d = angles_toforward ( 0 ( local.j * 90 ) 0 )
		local.n = ( 0 0 0 ) - local.d
		local.w1 = waitthread mgFree local.c local.d 56
		local.w2 = waitthread mgFree local.c local.n 56
		if( local.w1 < 55 && local.w2 < 55 ){ end 1 }
	}
}end 0


// the player whose muzzle local.g is in front of (within 420u down his aim, 30u + 4% to the side), or NIL
inFire local.g:{
	local.r = NIL
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL ){ continue }
		if( !isAlive local.p || local.p.dmteam == "spectator" ){ continue }
		local.fw = angles_toforward ( 0 local.p.viewangles[1] 0 )
		local.v = local.g - local.p.origin
		local.dz = local.v[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz > 90 ){ continue }
		local.v[2] = 0
		local.al = vector_dot local.v local.fw
		if( local.al < 20 || local.al > 420 ){ continue }
		local.lat = vector_length( local.v - ( vector_scale local.fw local.al ) )
		if( local.lat < ( 30 + ( local.al * 0.04 ) ) ){ local.r = local.p; break }
	}
}end local.r


// the nearest cover round local.ctr (rings of 64u out to local.maxr) against an enemy's eye at local.eye: low cover
// he can fire over first, a corner second; never where a mate or a player already is, never in a doorway, never in
// front of a player's muzzle, never nearer the enemy than local.lim. NIL = none.
coverNear local.ctr local.eye local.a local.maxr local.lim:{
	local.best = NIL
	local.bs = 999999
	for( local.r = 0; local.r <= local.maxr; local.r = local.r + 64 ){
		for( local.j = 0; local.j < 8; local.j++ ){
			if( local.r == 0 && local.j > 0 ){ break }
			local.c = local.ctr + ( vector_scale ( angles_toforward ( 0 ( ( local.j * 45 ) + ( local.r * 0.3 ) ) 0 ) ) local.r )
			local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.c + ( 0 0 48 ) )
			if( local.g == NIL ){ continue }
			local.dz = local.g[2] - local.ctr[2]
			if( local.dz < 0 ){ local.dz = 0 - local.dz }
			if( local.dz > 70 ){ continue }
			local.dg = waitthread flatDist local.g local.eye
			if( local.dg < local.lim ){ continue }
			local.h = waitthread cov local.g local.eye
			if( local.h != 1 && local.h != 2 ){ continue }
			if( waitthread crowded local.g local.a 80 ){ continue }
			if( waitthread tight local.g ){ continue }
			local.p = waitthread inFire local.g
			if( local.p != NIL ){ continue }
			local.s = local.r + ( vector_length( local.g - local.a.origin ) * 0.5 )
			if( local.h == 2 ){ local.s = local.s + 90 }
			if( local.s < local.bs ){ local.bs = local.s; local.best = local.g }
		}
		if( local.best != NIL && local.r >= 64 ){ break }
	}
}end local.best


// another trooper (or a player) already within r of the spot
crowded local.g local.self local.r:{
	if( local.self == NIL || local.self == NULL ){ end 0 }
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p != NULL ){
			if( vector_length( local.p.origin - local.g ) < local.r ){ end 1 }
		}
	}
	local.sid = local.self.coop_psqSid
	if( local.sid == NIL ){ end 0 }
	for( local.k = 1; local.k <= 5; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( local.a == NIL || local.a == NULL || local.a == local.self ){ continue }
		if( vector_length( local.a.origin - local.g ) < local.r ){ end 1 }
	}
}end 0


//====================================================================
// GRENADES
//====================================================================
// target point safe from friendlies? (thrower 450, players 450, any allied actor 400)
nadeSafe local.t local.thrower local.selfMin:{
	if( local.selfMin == NIL ){ local.selfMin = 450 }
	if( vector_length( local.t - local.thrower.origin ) < local.selfMin ){ end 0 }
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		if( vector_length( local.p.origin - local.t ) < 450 ){ end 0 }
	}
	if( level.coop_psqN != NIL ){
		for( local.s = 1; local.s <= level.coop_psqN; local.s++ ){
			for( local.k = 1; local.k <= 5; local.k++ ){
				local.a = level.coop_psqM[local.s][local.k]
				if( local.a == NIL || local.a == NULL ){ continue }
				if( vector_length( local.a.origin - local.t ) < 400 ){ end 0 }
			}
		}
	}
	local.arr = level.coop_actorArray["american"]
	if( local.arr != NIL ){
		for( local.i = 1; local.i <= local.arr.size; local.i++ ){
			local.a = local.arr[local.i]
			if( local.a == NIL || local.a == NULL ){ continue }
			if( vector_length( local.a.origin - local.t ) < 400 ){ end 0 }
		}
	}
}end 1


tryGrenade local.sid:{
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.a = level.coop_psqM[local.sid][local.k]
		if( !( waitthread usable local.a ) ){ continue }
		if( ( level.time - local.a.coop_psqNadeT ) < 20 ){ continue }
		local.e = local.a.enemy
		if( local.e == NIL || local.e == NULL ){ continue }
		if( !isAlive local.e ){ continue }
		local.d = vector_length( local.e.origin - local.a.origin )
		if( local.d < 450 || local.d > 1000 ){ continue }
		// worth a grenade: he is behind cover, or not alone
		local.worth = 0
		if( !( local.a cansee local.e ) ){ local.worth = 1 }
		if( local.worth == 0 ){
			local.en = waitthread enemiesNear local.e.origin 260
			if( local.en >= 2 ){ local.worth = 1 }
		}
		if( local.worth == 0 ){ continue }
		if( !( waitthread nadeSafe local.e.origin local.a 450 ) ){ continue }
		thread throwNade local.a local.e.origin "fight"
		end 1
	}
}end 0


enemiesNear local.pos local.r:{
	local.n = 0
	local.arr = level.coop_actorArray["german"]
	if( local.arr == NIL ){ end 0 }
	for( local.i = 1; local.i <= local.arr.size; local.i++ ){
		local.g = local.arr[local.i]
		if( local.g == NIL || local.g == NULL ){ continue }
		if( !isAlive local.g ){ continue }
		if( vector_length( local.g.origin - local.pos ) < local.r ){ local.n++ }
	}
}end local.n


// returns 1 if a grenade left his hand
throwNade local.a local.t local.why:{
	if( !( waitthread usable local.a ) ){ end 0 }
	local.a.coop_psqBusy = 1
	local.a.coop_psqNadeT = level.time
	local.a.enableEnemy = 0
	local.look = spawn script_origin
	local.look.origin = local.t
	local.a turnto local.look
	wait 0.4
	local.look remove
	local.ok = 0
	if( local.a != NULL && isAlive local.a ){
		local.selfMin = 450
		if( local.why == "room" ){ local.selfMin = 300 }	// frag radius 256 (m2fgrenade_base.txt); he is immune and behind the wall
		if( waitthread nadeSafe local.t local.a local.selfMin ){		// re-check: people move
			local.a.ammo_grenade = 1
			local.gs = local.a calcgrenadetoss local.t
			if( local.gs != NIL && local.gs != "" ){
				local.a immune grenade			// attacker == self is the one hit the engine does not filter
				if( local.gs == "anim/grenadetoss.scr" ){
					local.a anim_scripted grenade_toss
				} else {
					local.a anim_scripted grenade_throw
				}
				local.ok = 1
				waitthread ev "nade" local.a
				waitthread dbg ( "nade k=" + local.a.coop_psqK + " why=" + local.why + " dist=" + ( vector_length( local.t - local.a.origin ) ) + " mode=" + local.gs )
				wait 1.5
			} else {
				waitthread dbg ( "nade k=" + local.a.coop_psqK + " why=" + local.why + " nopath" )
			}
		}
	}
	if( local.a == NULL ){ end local.ok }
	if( !isAlive local.a ){ end local.ok }
	local.a.ammo_grenade = 0
	if( local.ok == 1 ){ local.a anim "idle" }	// end the scripted clip the proven way (medic recipe)
	local.a.enableEnemy = 0
	local.a.enableEnemy = 1
	local.a forceactivate
	local.a.coop_psqBusy = 0
	if( local.ok == 1 ){ thread nadeImmuneOff local.a }
}end local.ok


nadeImmuneOff local.a:{
	wait 5			// fuse + margin
	if( local.a != NULL ){ local.a removeimmune grenade }
}end


//====================================================================
// ROOM CLEARING
//====================================================================
// under a roof and walled in on at least 3 sides
indoors local.pos:{
	local.h = local.pos + ( 0 0 64 )
	local.tr = traced local.h ( local.h + ( 0 0 448 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["fraction"] >= 1.0 ){ end 0 }
	local.w = 0
	for( local.j = 0; local.j < 4; local.j++ ){
		local.d = angles_toforward ( 0 ( local.j * 90 ) 0 )
		local.p = local.pos + ( 0 0 48 )
		local.tr = traced local.p ( local.p + ( vector_scale local.d 448 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
		if( local.tr["fraction"] < 1.0 ){ local.w++ }
	}
	if( local.w >= 3 ){ end 1 }
}end 0


tryClear local.sid local.apos:{
	local.arr = level.coop_actorArray["german"]
	if( local.arr == NIL ){ end 0 }
	// an indoor enemy near the squad, with no player already inside with him
	local.tgt = NIL
	local.bd = 1100
	for( local.i = 1; local.i <= local.arr.size; local.i++ ){
		local.g = local.arr[local.i]
		if( local.g == NIL || local.g == NULL ){ continue }
		if( !isAlive local.g ){ continue }
		local.d = vector_length( local.g.origin - local.apos )
		if( local.d >= local.bd ){ continue }
		if( !( waitthread indoors local.g.origin ) ){ continue }
		local.near = 0
		for( local.p = 1; local.p <= $player.size; local.p++ ){
			if( $player[local.p] != NULL ){
				if( vector_length( $player[local.p].origin - local.g.origin ) < 300 ){ local.near = 1 }
			}
		}
		if( local.near == 1 ){ continue }
		local.bd = local.d
		local.tgt = local.g
	}
	if( local.tgt == NIL ){ end 0 }
	// entry pair: the Thompson and the BAR first; the man with the .30 cal on his back and the sniper last
	local.ord[1] = 2
	local.ord[2] = 1
	local.ord[3] = 3
	local.ord[4] = 4
	local.m1 = NIL
	local.m2 = NIL
	for( local.i = 1; local.i <= 4; local.i++ ){
		local.a = level.coop_psqM[local.sid][local.ord[local.i]]
		if( !( waitthread usable local.a ) ){ continue }
		if( vector_length( local.a.origin - local.tgt.origin ) > 1500 ){ continue }
		if( local.m1 == NIL ){ local.m1 = local.a } else if( local.m2 == NIL ){ local.m2 = local.a }
	}
	if( local.m1 == NIL ){ end 0 }
	// stack point: walk out from him toward the stack until the sky opens (the wall/door line),
	// then 80u further, on the ground
	local.cen = local.m1.origin
	if( local.m2 != NIL ){ local.cen = vector_scale ( local.m1.origin + local.m2.origin ) 0.5 }
	local.dir = local.cen - local.tgt.origin
	local.dir[2] = 0
	local.dir = vector_normalize local.dir
	local.stack = NIL
	for( local.s = 64; local.s <= 640; local.s = local.s + 48 ){
		local.p = local.tgt.origin + ( vector_scale local.dir local.s )
		local.h = local.p + ( 0 0 64 )
		local.tr = traced local.h ( local.h + ( 0 0 448 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
		if( local.tr["fraction"] >= 1.0 ){
			local.stack = waitthread coop_mod/officer.scr::coop_find_ground ( local.p + ( vector_scale local.dir 80 ) + ( 0 0 48 ) )
			break
		}
	}
	if( local.stack == NIL ){ end 0 }
	thread clearRoom local.sid local.tgt local.stack local.dir local.m1 local.m2
}end 1


clearRoom local.sid local.tgt local.stack local.dir local.m1 local.m2:{
	local.va = vector_toangles local.dir
	local.rgt = angles_toforward ( 0 ( local.va[1] - 90 ) 0 )
	local.s1 = local.stack
	local.s2 = local.stack + ( vector_scale local.dir 64 ) + ( vector_scale local.rgt 24 )
	waitthread dbg ( "clear stack tgt=" + local.tgt.entnum + " at=" + local.tgt.origin + " stack=" + local.stack )
	waitthread ev "clear" local.m1
	// 1. STACK (both men, enemy think off so they do not peel away)
	if( local.m2 != NIL ){ thread moveTo local.m2 local.s2 8.0 0 "stack" }
	waitthread moveTo local.m1 local.s1 8.0 0 "stack"
	if( local.tgt == NULL ){ waitthread dbg "clear done result=gone_before_entry"; end }
	if( !isAlive local.tgt ){ waitthread dbg "clear done result=dead_before_entry"; end }
	if( local.m1 == NULL ){ end }
	if( !isAlive local.m1 ){ end }
	wait 1
	// 2. FRAG IN (only when safe; a failed toss path just means no grenade)
	local.thrown = 0
	if( waitthread nadeSafe local.tgt.origin local.m1 300 ){
		local.thrown = waitthread throwNade local.m1 local.tgt.origin "room"
	}
	if( local.thrown == 1 ){ wait 2.5 }
	if( local.tgt == NULL ){ waitthread dbg ( "clear done result=frag_killed thrown=" + local.thrown ); end }
	if( !isAlive local.tgt ){ waitthread dbg ( "clear done result=frag_killed thrown=" + local.thrown ); end }
	// 3. ENTER - run in, open up as soon as they see him
	waitthread dbg ( "clear enter thrown=" + local.thrown )
	thread enter local.m1 local.tgt
	if( local.m2 != NIL ){ wait 0.6; thread enter local.m2 local.tgt }
	local.t = 0
	while( local.t < 15 ){
		wait 0.5
		local.t = local.t + 0.5
		if( local.tgt == NULL ){ break }
		if( !isAlive local.tgt ){ break }
	}
	if( local.tgt == NULL ){ waitthread dbg "clear done result=cleared"; end }
	if( !isAlive local.tgt ){ waitthread dbg "clear done result=cleared"; end }
	waitthread dbg "clear done result=timeout"
}end


enter local.a local.tgt:{
	if( !( waitthread usable local.a ) ){ end }
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.a.movedoneradius = 64
	local.a runto local.tgt.origin
	local.t = 0
	while( local.t < 6 ){
		wait 0.25
		local.t = local.t + 0.25
		if( local.a == NULL ){ end }
		if( !isAlive local.a ){ end }
		if( local.tgt == NULL ){ break }
		if( !isAlive local.tgt ){ break }
		local.d = vector_length( local.a.origin - local.tgt.origin )
		if( local.d < 160 ){ break }
		if( local.d < 500 ){
			if( local.a cansee local.tgt ){ break }
		}
	}
	local.a.enableEnemy = 1
	if( local.tgt != NULL ){
		if( isAlive local.tgt ){ local.a attackentity local.tgt }
	}
	local.a forceactivate
	waitthread post local.a local.a.origin 200
	local.a.coop_psqBusy = 0
}end


//====================================================================
// .30 CAL
//====================================================================
// THE .30 CAL EMPLACEMENT (bug-3562). User 2026-10-12: "he kinda just stands with it over his
// shoulder mounted on nothing (without a bipod at that)", then, on the first fix: "I think it makes
// more sense for him to go to the nearest existing cover he could prop it to with a bipod and
// suppress enemies or place the sandbag with 30 cal where he can suppress enemies", and "a small
// sandbag as support as a worst case scenario as long as its never in the path of progress".
//
// So, in this order:
//   A  COVER. The nearest thing already in the map that the bipod can stand on and that he can
//      fire over at the enemy: a low wall, sandbags, a crate, a sill, a bank. "Can stand on" = a
//      traced, solid, level WORLD surface under both bipod feet, 21-53u above the ground he will
//      be on (the engine blends his crouched and standing gun pose from that height: 38.7u from
//      feet to gun = crouched, 71.8u = standing), with room over it and a free seat behind it.
//   C  A SANDBAG REST he puts down himself (three bags, 25.8u, not solid) with the bipod on it, on
//      near-level open ground - only when no cover qualifies, never where players have walked or
//      straight ahead of the squad (mgLane), never in a gap (mgOpen), never on the Omaha maps.
//   B  the Breakthrough tripod on open ground is kept behind a switch (coop_paraMgTripod 1); the
//      user asked for cover or sandbags, so it is off.
// Every site needs a FIELD OF FIRE that was traced from the gun (mgFire): to the known enemy, or
// to where he was last seen, or down the squad's line of advance - a nearer site without one
// loses to a farther one with it. And he must be able to GET there (mgReach): a path from where he
// stands (the engine only paths from and to a 256u map cell that holds a pathnode - a man who
// lands in one that has none can never path, which is why the walk-up used to fail), or a straight
// walk over ground that was traced. No reachable site = he stays a rifleman, gun on his back.
// The seat is where the engine will put him (Actor::ThinkHoldGun_TurretGun: 59-62u behind the
// pivot, 9-10u to its left, hull swept down from 18u over his feet) and it is swept over the
// whole traverse; the traverse is narrowed to what is free (30-45 degrees either side).
// While he is on it (mgHold): the turret's own track / suppress cycle fires at what he sees and
// at where he last saw it; an enemy only the squad knows is suppressed in bursts by script; he
// holds fire while a player or a squad mate is in front of the muzzle; he packs up when the squad
// moves on, when the support is gone, or when the enemy has been out of his arc or masked for 25s
// and the gun has not fired for 20 (the next search then re-sites him).
// The bags, the mount and the ammo can are NOT solid: nothing put down can block anyone.
// Test hooks (never set by the game): level.coop_psqMgForce = "A" / "B" / "C" allows only that mode.
// Content masks: a SUPPORT is solid world geometry (1). SPACE is free only if nothing is in it -
// solid, fence, player / weapon clip (335873; 466945 adds monster clip, for his hull). A FIELD OF
// FIRE is stopped by solid, fence or weapon clip (270337).
//=========================================================================
gunner local.a local.sid:{
	wait 1
	if( local.a == NULL ){ end }
	// carried: the M1919 on his back (the imported .30 cal's own holster tag + offsets)
	local.prop = spawn script_model
	local.prop model "models/weapons/30calportable.tik"
	local.prop notsolid
	local.prop attach local.a "Bip01 Spine2" 1 ( 8 -7.75 6.5 )
	local.prop.angles = ( 0 185 -25 )
	local.a.coop_psqProp = local.prop
	local.a.coop_psqMgFails = 0
	local.a.coop_psqMgFired = 0
	local.fired = 0
	local.gun = NIL
	local.crate = NIL
	local.sup = NIL
	local.bag = NIL
	local.cool = 0
	while( local.a != NULL ){
		// what he has set up (mgSetup writes it, mgPackup and mgGiveUp clear it)
		local.gun = local.a.coop_psqGun
		local.crate = local.a.coop_psqCrate
		local.sup = local.a.coop_psqSup
		local.bag = local.a.coop_psqBag
		if( !isAlive local.a ){ break }
		wait 1
		if( local.a == NULL ){ break }
		if( local.a.coop_psqMounted != 1 ){
			local.near = 1
			if( level.coop_psqApos[local.sid] != NIL ){
				if( vector_length( local.a.origin - level.coop_psqApos[local.sid] ) > 700 ){ local.near = 0 }	// the search is round him: not while he is elsewhere
			}
			if( level.coop_psqHolding[local.sid] == 1 && local.a.coop_psqBusy != 1 && level.time >= local.cool && local.near == 1 && local.a.coop_psqBeltOut != 1 ){
				local.f = waitthread mgPlan local.a local.sid
				if( local.a == NULL ){ break }
				if( local.f == 1 ){
					local.a.coop_psqMgFails = 0
					waitthread mgSetup local.a local.sid
					if( local.a == NULL ){ break }
					local.gun = local.a.coop_psqGun
					local.crate = local.a.coop_psqCrate
					local.sup = local.a.coop_psqSup
					local.bag = local.a.coop_psqBag
					if( local.a.coop_psqMounted != 1 ){ local.cool = level.time + 12 }
				} else {
					local.a.coop_psqMgFails++
					local.cool = level.time + 10
				}
			}
		} else {
			local.why = waitthread mgTend local.a local.sid
			if( local.a == NULL ){ break }
			if( local.why != "stay" ){
				waitthread dbg ( "mg leave why=" + local.why )
				if( local.why == "belt_out" ){ local.a.coop_psqBeltOut = 1 }	// no rounds left: a rifleman from here on
				waitthread mgPackup local.a
				local.gun = NIL
				local.crate = NIL
				local.sup = NIL
				local.bag = NIL
				local.cool = level.time + 4
			}
		}
	}
	// he is gone. The gun on his back goes with him; a gun he had SET UP stays where it is, with its
	// mount, its bags and its can, for the players (user 2026-10-12: "if he dies on it, it should
	// stay there and players should be able to mount it with a finite amount of ammo and overheat
	// mechanic")
	if( local.prop != NULL ){ local.prop remove }
	if( local.gun != NIL && local.gun != NULL ){
		waitthread mgLeft local.gun local.fired
	} else {
		if( local.crate != NIL && local.crate != NULL ){ local.crate remove }
		if( local.sup != NIL && local.sup != NULL ){ local.sup remove }
		if( local.bag != NIL && local.bag != NULL ){ local.bag remove }
	}
}end


// The gun he died at becomes the players'. It is an ordinary TurretGun, so everything a player gets
// on the mod's other mounted guns he gets here from the engine (TurretGun::P_TurretUsed /
// P_ThinkActive): Use mounts it and Use again leaves it, one player at a time (a second player's
// Use does nothing while it has an owner), the barrel heats and locks out, and the belt count is
// on the mounted-gun HUD. What is set here: the BELT - what he had left of a 250-round belt
// (his own fire is not counted by the engine, so it is reckoned in mgHold: 11 rounds a second of
// bursts) and never less than 25. The ammo box does not refill it (nothing but M3L3's own script
// writes a belt): it is a found weapon and the can beside it is set dressing. Nothing puts a
// trooper back on it - no other member runs the gunner thread - so it stays the players'. It goes
// with the map; nothing else removes it.
mgLeft local.gun local.fired:{
	// what is left of the belt he was on: the engine counts his rounds (coopaibelt). 125 on an older game.dll.
	local.left = waitthread coop_mod/parasquad_gun.scr::ammo local.gun
	if( local.left == NIL ){ local.left = 125 }
	if( local.left < 25 ){ local.left = 25 }
	local.gun targettype "none"
	local.gun stopFiring
	local.gun clearAimTarget
	local.gun coopammo local.left
	local.gun setPlayerUsable 1
	if( level.coop_psqLeftN == NIL ){ level.coop_psqLeftN = 0 }
	level.coop_psqLeftN++
	level.coop_psqLeftGun[level.coop_psqLeftN] = local.gun
	waitthread dbg ( "mg left for the players belt=" + local.left + " fired=" + local.fired + " gun=" + local.gun.origin )
}end


// the top surface under local.p (looked for from local.up above it to local.down below it):
// WORLD geometry only - a crate that can be pushed, a vehicle or a door is not a place to leave a
// gun - and never from inside solid. Returns its height, or NIL.
mgSurf local.p local.up local.down:{
	local.r = NIL
	if( level.coop_psqWorldNum == NIL ){
		local.w = $world
		if( local.w == NULL ){ end local.r }
		level.coop_psqWorldNum = local.w.entnum
	}
	local.s = local.p + ( 0 0 local.up )
	local.e = local.p - ( 0 0 local.down )
	local.tr = traced local.s local.e 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	if( local.tr["startSolid"] == 1 ){ end local.r }
	if( local.tr["allSolid"] == 1 ){ end local.r }
	if( local.tr["fraction"] >= 1.0 ){ end local.r }
	if( local.tr["entityNum"] != level.coop_psqWorldNum ){ end local.r }
	local.h = local.tr["endpos"]
	local.r = local.h[2]
}end local.r


// free distance from local.p along local.dir, up to local.max
mgFree local.p local.dir local.max:{
	local.tr = traced local.p ( local.p + ( vector_scale local.dir local.max ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 335873
	local.d = local.tr["fraction"] * local.max
}end local.d


// 1 when a man kneeling at local.sg facing local.yaw is not in anybody's way: open on both sides
// and behind, and standing on one level (no stair, no bridge edge beside him). local.strict = the
// sandbag rest: wider still. When in doubt the answer is 0.
mgOpen local.sg local.yaw local.strict:{
	local.dir = angles_toforward ( 0 local.yaw 0 )
	local.rgt = angles_toforward ( 0 ( local.yaw - 90 ) 0 )
	local.lft = ( 0 0 0 ) - local.rgt
	local.bck = ( 0 0 0 ) - local.dir
	local.c = local.sg + ( 0 0 40 )
	local.wl = waitthread mgFree local.c local.lft 130
	local.wr = waitthread mgFree local.c local.rgt 130
	local.wb = waitthread mgFree local.c local.bck 130
	local.needW = 150
	local.needB = 64
	if( local.strict == 1 ){
		local.needW = 220
		local.needB = 96
	}
	if( ( local.wl + local.wr ) < local.needW ){ end 0 }
	if( local.wl < 40 || local.wr < 40 ){ end 0 }
	if( local.wb < local.needB ){ end 0 }
	// the ground beside and behind him is the ground he is on
	local.o[1] = vector_scale local.lft 32
	local.o[2] = vector_scale local.rgt 32
	local.o[3] = vector_scale local.bck 44
	for( local.i = 1; local.i <= 3; local.i++ ){
		local.z = waitthread mgSurf ( local.sg + local.o[local.i] ) 30 40
		if( local.z == NIL ){ end 0 }
		local.dz = local.z - local.sg[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz > 16 ){ end 0 }
	}
}end 1


// where the fire is wanted: the enemy the squad knows now, else where one was last known (up to
// 15s ago), else 1200u down the squad's line of advance. The kind goes into level.coop_psqAimKind.
mgAim local.sid:{
	local.t = level.coop_psqThreat[local.sid]
	if( local.t != NIL ){
		level.coop_psqAimKind = "enemy"
		end local.t
	}
	local.t = level.coop_psqLastThr[local.sid]
	if( local.t != NIL ){
		if( ( level.time - level.coop_psqLastThrT[local.sid] ) < 15 ){
			level.coop_psqAimKind = "last"
			end local.t
		}
	}
	level.coop_psqAimKind = "advance"
	local.r = level.coop_psqApos[local.sid] + ( vector_scale ( angles_toforward ( 0 level.coop_psqAyaw[local.sid] 0 ) ) 1200 )
}end local.r


// the field of fire from a gun pivot at local.gp toward local.aim: 0 = none, else a quality
// 0.6 .. 1.5 (how much of the line is clear, plus the flanks). Traced, never assumed.
mgFire local.gp local.aim local.kind:{
	local.q = local.gp + ( 0 0 4 )
	local.v = local.aim - local.gp
	local.dz = local.v[2]
	local.v[2] = 0
	local.dist = vector_length local.v
	if( local.dist < 120 ){ end 0 }
	local.va = vector_toangles local.v
	local.yaw = local.va[1]
	local.c = 0
	if( local.kind == "advance" ){
		// level, and once more 5 degrees up (rising ground is not a wall)
		local.e = local.q + ( vector_scale ( angles_toforward ( 0 local.yaw 0 ) ) 800 )
		local.tr = traced local.q local.e 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
		local.c = local.tr["fraction"]
		if( local.c < 0.6 ){
			local.tr = traced local.q ( local.e + ( 0 0 70 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
			if( local.tr["fraction"] > local.c ){ local.c = local.tr["fraction"] }
		}
		if( local.c < 0.6 ){ end 0 }
	} else {
		// the gun's pitch stops at 25 degrees up and 12 down (pitchCaps in mgSetup); planned to 22 up
		if( local.dz > ( local.dist * 0.40 ) ){ end 0 }
		if( local.dz < ( 0 - ( local.dist * 0.21 ) ) ){ end 0 }
		local.e = local.aim + ( 0 0 40 )
		local.tr = traced local.q local.e 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
		local.c = local.tr["fraction"]
		// clear to within 96u of him (he may be behind something low himself)
		if( ( local.c * local.dist ) < ( local.dist - 96 ) ){ end 0 }
	}
	local.fl = 0
	for( local.s = 0; local.s < 2; local.s++ ){
		local.sy = local.yaw + 18
		if( local.s == 1 ){ local.sy = local.yaw - 18 }
		local.e = local.q + ( vector_scale ( angles_toforward ( 0 local.sy 0 ) ) 450 )
		local.tr = traced local.q local.e 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
		if( local.tr["fraction"] >= 0.7 ){ local.fl++ }
	}
	if( local.fl < 1 ){ end 0 }
	local.r = local.c + ( local.fl * 0.25 )
}end local.r


// where the engine seats a gunner at a gun pivot local.gp turned to local.yaw, his feet at height
// local.gz (Actor::ThinkHoldGun_TurretGun, the branch for a gun at or under standing height)
mgSeat local.gp local.yaw local.gz:{
	local.hp = local.gp[2] - local.gz
	local.cw = ( 71.8 - local.hp ) / 33.1
	if( local.cw > 1.0 ){ local.cw = 1.0 }
	if( local.cw < 0 ){ local.cw = 0 }
	local.back = 62.4 - ( local.cw * 3.0 )
	local.left = 10.3 - ( local.cw * 1.6 )
	local.s = local.gp - ( vector_scale ( angles_toforward ( 0 local.yaw 0 ) ) local.back ) + ( vector_scale ( angles_toforward ( 0 ( local.yaw + 90 ) 0 ) ) local.left )
	local.s[2] = local.gz
}end local.s


// his hull at a seat, as the engine sweeps it (from 18u over his feet), and the ground under it
mgSeatFree local.s:{
	local.q = local.s + ( 0 0 18 )
	local.tr = traced local.q ( local.q + ( 0 0 1 ) ) 1023 ( -15 -15 0 ) ( 15 15 92 ) 466945
	if( local.tr["startSolid"] == 1 || local.tr["allSolid"] == 1 || local.tr["fraction"] < 1.0 ){ end 0 }
	local.z = waitthread mgSurf local.s 18 30
	if( local.z == NIL ){ end 0 }
	local.dz = local.z - local.s[2]
	if( local.dz < 0 ){ local.dz = 0 - local.dz }
	if( local.dz > 10 ){ end 0 }
}end 1


// a player or a squad mate in front of a muzzle at local.pos pointing along local.dir
playerInFront local.pos local.dir:{
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		local.v = local.p.origin - local.pos
		// (a man more than 110u under or over the muzzle is not in front of it: the gun's pitch is 12 degrees down,
		// 25 up)
		local.hz = local.v[2] + 40
		local.hs = 0.5
		if( local.hz < 0 ){ local.hz = 0 - local.hz; local.hs = 0.25 }
		local.v[2] = 0
		local.along = vector_dot local.v local.dir
		if( local.along <= 0 || local.along > 1500 ){ continue }
		if( local.hz > 110 && local.hz > ( local.along * local.hs ) ){ continue }
		local.lat = vector_length( local.v - ( vector_scale local.dir local.along ) )
		if( local.lat < 128 ){ end 1 }
	}
}end 0


mateInFront local.pos local.dir local.sid local.self:{
	for( local.k = 1; local.k <= 5; local.k++ ){
		local.m = level.coop_psqM[local.sid][local.k]
		if( local.m == NIL || local.m == NULL ){ continue }
		if( local.m == local.self ){ continue }
		if( !isAlive local.m ){ continue }
		local.v = local.m.origin - local.pos
		local.hz = local.v[2] + 40
		local.hs = 0.5
		if( local.hz < 0 ){ local.hz = 0 - local.hz; local.hs = 0.25 }
		local.v[2] = 0
		local.along = vector_dot local.v local.dir
		if( local.along <= 0 || local.along > 900 ){ continue }
		if( local.hz > 110 && local.hz > ( local.along * local.hs ) ){ continue }
		local.lat = vector_length( local.v - ( vector_scale local.dir local.along ) )
		if( local.lat < ( 56 + ( local.along * 0.12 ) ) ){ end 1 }
	}
}end 0


// where the players have been (one mark per 72u a player moves, the last 48): the lanes they use
trail:{
	if( level.coop_psqTrN == NIL ){ level.coop_psqTrN = 0; level.coop_psqTrI = 0 }
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL ){ continue }
		if( !isAlive local.p || local.p.dmteam == "spectator" ){ continue }
		if( local.p.coop_psqTr != NIL ){
			if( vector_length( local.p.origin - local.p.coop_psqTr ) < 72 ){ continue }
		}
		local.p.coop_psqTr = local.p.origin
		level.coop_psqTrI++
		if( level.coop_psqTrI > 48 ){ level.coop_psqTrI = 1 }
		level.coop_psqTr[level.coop_psqTrI] = local.p.origin
		if( level.coop_psqTrN < 48 ){ level.coop_psqTrN++ }
	}
}end


// 1 when local.g is on the way: where a player has walked, or straight ahead of the squad
mgLane local.g local.sid:{
	if( level.coop_psqTrN != NIL ){
		for( local.i = 1; local.i <= level.coop_psqTrN; local.i++ ){
			local.v = local.g - level.coop_psqTr[local.i]
			local.dz = local.v[2]
			if( local.dz < 0 ){ local.dz = 0 - local.dz }
			local.v[2] = 0
			if( local.dz < 80 && vector_length local.v < 110 ){ end 1 }
		}
	}
	local.fwd = angles_toforward ( 0 level.coop_psqAyaw[local.sid] 0 )
	local.v = local.g - level.coop_psqApos[local.sid]
	local.v[2] = 0
	local.along = vector_dot local.v local.fwd
	if( local.along > ( 0 - 60 ) && local.along < 420 ){
		local.lat = vector_length( local.v - ( vector_scale local.fwd local.along ) )
		if( local.lat < 100 ){ end 1 }
	}
}end 0


// a straight walk from local.s to local.e, taken 32u at a time along the ground: ground under every
// step (never more than 18u up or 28u down from the last one), and room for his hull from each
// step to the next (18u up, so that it rides over a step; solid, fence and every clip)
mgLine local.s local.e:{
	local.v = local.e - local.s
	local.v[2] = 0
	local.len = vector_length local.v
	if( local.len < 8 ){ end 1 }
	local.d = vector_scale local.v ( 1.0 / local.len )
	local.n = int( ( local.len + 31 ) / 32 )
	local.prev = local.s
	for( local.i = 1; local.i <= local.n; local.i++ ){
		local.r = local.i * 32
		if( local.r > local.len ){ local.r = local.len }
		local.p = local.s + ( vector_scale local.d local.r )
		local.p[2] = local.prev[2]
		local.tr = traced ( local.p + ( 0 0 18 ) ) ( local.p - ( 0 0 28 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
		if( local.tr["fraction"] >= 1.0 || local.tr["startSolid"] == 1 ){ end 0 }
		local.p = local.tr["endpos"]
		local.tr = traced ( local.prev + ( 0 0 18 ) ) ( local.p + ( 0 0 18 ) ) 1023 ( -14 -14 0 ) ( 14 14 52 ) 466945
		if( local.tr["fraction"] < 1.0 || local.tr["startSolid"] == 1 ){ end 0 }
		local.prev = local.p
	}
	local.dz = local.prev[2] - local.e[2]
	if( local.dz < 0 ){ local.dz = 0 - local.dz }
	if( local.dz > 24 ){ end 0 }
}end 1


// can he get to local.pos? 1 = the path graph takes him, 2 = a straight walk, 3 = the graph to
// level.coop_psqVia and straight from there, 0 = no. He is left walking toward it.
// (pathdist is the length of the path the engine found for the last move order, 0 for none.)
mgReach local.a local.pos:{
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.a.movedoneradius = 24
	level.coop_psqVia = NIL
	level.coop_psqPd = 0
	local.d = waitthread flatDist local.a.origin local.pos
	if( local.d < 64 ){
		if( waitthread mgLine local.a.origin local.pos ){ end 2 }
	}
	local.a runto local.pos
	wait 0.3
	if( local.a == NULL ){ end 0 }
	if( !isAlive local.a ){ end 0 }
	local.pd = local.a.pathdist
	level.coop_psqPd = local.pd
	if( local.pd > 0 && local.pd < ( ( local.d * 3 ) + 300 ) ){ end 1 }
	if( waitthread mgLine local.a.origin local.pos ){ end 2 }
	// the last leg on foot: the graph to a point 64 .. 192u short of it, then straight
	local.v = local.a.origin - local.pos
	local.v[2] = 0
	if( vector_length local.v > 1 ){
		local.dir = vector_normalize local.v
		for( local.r = 64; local.r <= 192; local.r = local.r + 64 ){
			if( local.r >= local.d ){ break }
			local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.pos + ( vector_scale local.dir local.r ) + ( 0 0 40 ) )
			if( local.g == NIL ){ continue }
			if( !( waitthread mgLine local.g local.pos ) ){ continue }
			local.a runto local.g
			wait 0.3
			if( local.a == NULL ){ end 0 }
			if( !isAlive local.a ){ end 0 }
			local.pd = local.a.pathdist
			if( local.pd > 0 && local.pd < ( ( local.d * 3 ) + 300 ) ){
				level.coop_psqVia = local.g
				level.coop_psqPd = local.pd
				end 3
			}
		}
	}
}end 0


// one reason a place was refused (counted; printed per place with coop_paraDebug 2)
mgNo local.why local.g:{
	if( level.coop_psqR[local.why] == NIL ){ level.coop_psqR[local.why] = 0 }
	level.coop_psqR[local.why] = level.coop_psqR[local.why] + 1
	if( getcvar( "coop_paraDebug" ) == "2" ){ println( "^~^~^ PSQ t=" + level.time + " mg no why=" + local.why + " at=" + local.g ) }
}end


// keep a site that passed everything (level.coop_psqC*): local.mode, the gun pivot, the mount,
// the bags, the seat, the yaw, the free traverse, the top's height and the field of fire
mgKeep local.mode local.gun local.sup local.bag local.seat local.yaw local.arc local.top local.fof local.walk:{
	if( level.coop_psqCn >= 40 ){ end }
	level.coop_psqCn++
	local.i = level.coop_psqCn
	local.score = local.walk + ( ( 1.5 - local.fof ) * 150 )
	if( local.mode == "C" ){ local.score = local.score + 5000 }	// cover always beats the bags
	if( local.mode == "B" ){ local.score = local.score + 9000 }
	level.coop_psqCs[local.i] = local.score
	level.coop_psqCm[local.i] = local.mode
	level.coop_psqCg[local.i] = local.gun
	level.coop_psqCu[local.i] = local.sup
	level.coop_psqCb[local.i] = local.bag
	level.coop_psqCt[local.i] = local.seat
	level.coop_psqCy[local.i] = local.yaw
	level.coop_psqCx[local.i] = local.arc
	level.coop_psqCh[local.i] = local.top
	level.coop_psqCf[local.i] = local.fof
	level.coop_psqCd[local.i] = 0
}end


// the tests every kind of site shares, from the gun pivot down to the seat. Keeps it if it passes.
mgSite local.a local.sid local.mode local.g local.gun local.sup local.bag local.fyaw local.top local.aim local.kind:{
	local.dir = angles_toforward ( 0 local.fyaw 0 )
	// room over the gun
	local.tr = traced local.gun ( local.gun + ( 0 0 30 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
	if( local.tr["fraction"] < 1.0 || local.tr["startSolid"] == 1 ){ waitthread mgNo "headroom" local.g; end 0 }
	// the ground he will be on, and the gun at a height his pose reaches
	local.s0 = waitthread mgSeat local.gun local.fyaw ( local.gun[2] - 50 )
	local.s0[2] = local.g[2]
	local.gz = waitthread mgSurf local.s0 30 40
	if( local.gz == NIL ){ waitthread mgNo "seatground" local.g; end 0 }
	local.hp = local.gun[2] - local.gz
	if( local.hp < 38.2 || local.hp > 71.8 ){ waitthread mgNo "height" local.g; end 0 }
	local.fof = waitthread mgFire local.gun local.aim local.kind
	if( local.fof <= 0 ){ waitthread mgNo "nofire" local.g; end 0 }
	// the seat over the traverse: straight, then as far round as it stays free
	local.seat = waitthread mgSeat local.gun local.fyaw local.gz
	if( !( waitthread mgSeatFree local.seat ) ){ waitthread mgNo "seat" local.g; end 0 }
	local.arc = 0
	for( local.o = 15; local.o <= 45; local.o = local.o + 15 ){
		local.s1 = waitthread mgSeat local.gun ( local.fyaw + local.o ) local.gz
		local.s2 = waitthread mgSeat local.gun ( local.fyaw - local.o ) local.gz
		if( !( waitthread mgSeatFree local.s1 ) ){ break }
		if( !( waitthread mgSeatFree local.s2 ) ){ break }
		local.arc = local.o
	}
	if( local.arc < 30 ){ waitthread mgNo "arc" local.g; end 0 }
	// nothing between him and the gun
	local.q = local.seat + ( 0 0 ( local.hp - 4 ) )
	local.tr = traced local.q ( local.gun - ( vector_scale local.dir 24 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 335873
	if( local.tr["fraction"] < 1.0 || local.tr["startSolid"] == 1 ){ waitthread mgNo "reach" local.g; end 0 }
	local.strict = 0
	if( local.mode == "C" ){ local.strict = 1 }
	if( !( waitthread mgOpen local.seat local.fyaw local.strict ) ){ waitthread mgNo "gap" local.g; end 0 }
	if( waitthread crowded local.seat local.a 72 ){ waitthread mgNo "crowded" local.g; end 0 }
	if( waitthread playerInFront local.gun local.dir ){ waitthread mgNo "player_in_front" local.g; end 0 }
	if( waitthread mateInFront local.gun local.dir local.sid local.a ){ waitthread mgNo "squad_in_front" local.g; end 0 }
	local.walk = waitthread flatDist local.a.origin local.seat
	waitthread mgKeep local.mode local.gun local.sup local.bag local.seat local.fyaw local.arc local.top local.fof local.walk
}end 1


// one piece of ground local.g: is there cover in front of it to rest the gun on (A), or is it a
// place for the sandbags (C) or the tripod (B)?
mgTry local.a local.sid local.g local.aim local.kind local.bags local.tripod:{
	local.v = local.aim - local.g
	local.v[2] = 0
	if( vector_length local.v < 150 ){ end }
	local.va = vector_toangles local.v
	local.fyaw = local.va[1]
	local.dir = angles_toforward ( 0 local.fyaw 0 )
	local.rgt = angles_toforward ( 0 ( local.fyaw - 90 ) 0 )
	local.force = level.coop_psqMgForce
	// ---- A: something solid ahead at shin height, within 120u
	local.p = local.g + ( 0 0 20 )
	local.tr = traced local.p ( local.p + ( vector_scale local.dir 120 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
	local.dw = 0
	if( local.tr["fraction"] < 1.0 && local.tr["startSolid"] != 1 ){ local.dw = local.tr["fraction"] * 120 }
	if( local.dw > 0 ){
		if( local.force != NIL && local.force != "A" ){ end }
		if( local.tr["entityNum"] != level.coop_psqWorldNum ){ waitthread mgNo "not_world" local.g; end }
		// its top, 9u in from the face (5u for a thin wall): both bipod feet (11u either side) and
		// 3u before and behind them, all there and all level
		local.done = 0
		local.why = "tall"
		for( local.n = 0; local.n < 2; local.n++ ){
			local.ins = 9
			if( local.n == 1 ){ local.ins = 5 }
			local.c0 = local.g + ( vector_scale local.dir ( local.dw + local.ins ) )
			local.c0[2] = local.g[2] + 40
			local.s0 = waitthread mgSurf local.c0 26 22
			if( local.s0 == NIL ){ continue }
			local.why = "not_level"
			local.pr[1] = local.c0 + ( vector_scale local.rgt 11 )
			local.pr[2] = local.c0 - ( vector_scale local.rgt 11 )
			local.pr[3] = local.c0 - ( vector_scale local.dir 3 )
			local.pr[4] = local.c0 + ( vector_scale local.dir 3 )
			local.ok = 1
			for( local.k = 1; local.k <= 4; local.k++ ){
				local.sk = waitthread mgSurf local.pr[local.k] 26 22
				if( local.sk == NIL ){ local.ok = 0; break }
				local.dz = local.sk - local.s0
				if( local.dz < 0 ){ local.dz = 0 - local.dz }
				if( local.dz > 3 ){ local.ok = 0; break }
			}
			if( local.ok != 1 ){ continue }
			// nothing standing on it (a fence on a wall is not a rest; a player clip over it is nothing)
			local.why = "top_blocked"
			local.q = local.c0
			local.q[2] = local.s0 + 2
			local.tr = traced local.q ( local.q + ( 0 0 28 ) ) 1023 ( -6 -6 0 ) ( 6 6 2 ) 270337
			if( local.tr["fraction"] < 1.0 || local.tr["startSolid"] == 1 ){ continue }
			local.done = 1
			break
		}
		if( local.done != 1 ){ waitthread mgNo local.why local.g; end }
		local.sup = local.c0
		local.sup[2] = local.s0 + 12.8		// the bipod (drawn at 0.75) hangs 12.8u below its origin: feet on the surface
		local.gun = local.c0				// the gun turns about its origin: the bipod stands under it
		local.gun[2] = local.s0 + 13.5
		waitthread mgSite local.a local.sid "A" local.g local.gun local.sup local.g local.fyaw ( local.s0 - local.g[2] ) local.aim local.kind
		end
	}
	// ---- open ground: nothing at waist height either (else it is a wall with a gap under it)
	if( local.force == "A" ){ end }
	if( local.bags != 1 && local.tripod != 1 ){ end }
	local.p = local.g + ( 0 0 44 )
	local.tr = traced local.p ( local.p + ( vector_scale local.dir 120 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 335873
	if( local.tr["fraction"] < 1.0 ){ end }
	local.p = local.g + ( 0 0 20 )
	local.tr = traced local.p ( local.p + ( vector_scale local.dir 120 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 335873
	if( local.tr["fraction"] < 1.0 ){ end }
	local.g0 = waitthread mgSurf local.g 20 24
	if( local.g0 == NIL ){ end }
	if( local.tripod == 1 && ( local.force == NIL || local.force == "B" ) ){
		// the tripod's three feet: the single leg toward the gunner (15u back), the pair forward
		local.pr[1] = local.g - ( vector_scale local.dir 15 )
		local.pr[2] = local.g + ( vector_scale local.dir 39 ) + ( vector_scale local.rgt 13 )
		local.pr[3] = local.g + ( vector_scale local.dir 39 ) - ( vector_scale local.rgt 13 )
		local.ok = 1
		for( local.k = 1; local.k <= 3; local.k++ ){
			local.sk = waitthread mgSurf local.pr[local.k] 20 24
			if( local.sk == NIL ){ local.ok = 0; break }
			local.dz = local.sk - local.g0
			if( local.dz < 0 ){ local.dz = 0 - local.dz }
			if( local.dz > 6 ){ local.ok = 0; break }
		}
		if( local.ok == 1 ){
			local.sup = local.g
			local.sup[2] = local.g0 + 49.4	// the tripod hangs 49.4u below its origin
			local.gun = local.g
			local.gun[2] = local.g0 + 50.5
			waitthread mgSite local.a local.sid "B" local.g local.gun local.sup local.g local.fyaw 0 local.aim local.kind
		}
	}
	if( local.bags != 1 ){ end }
	if( local.force != NIL && local.force != "C" ){ end }
	// ---- C: the sandbag rest. The ground under its four corners, within 8u; bedded on the lowest
	local.pr[1] = local.g + ( vector_scale local.dir 17 ) + ( vector_scale local.rgt 19 )
	local.pr[2] = local.g + ( vector_scale local.dir 17 ) - ( vector_scale local.rgt 19 )
	local.pr[3] = local.g - ( vector_scale local.dir 17 ) + ( vector_scale local.rgt 19 )
	local.pr[4] = local.g - ( vector_scale local.dir 17 ) - ( vector_scale local.rgt 19 )
	local.low = local.g0
	local.high = local.g0
	for( local.k = 1; local.k <= 4; local.k++ ){
		local.sk = waitthread mgSurf local.pr[local.k] 20 24
		if( local.sk == NIL ){ waitthread mgNo "bag_ground" local.g; end }
		if( local.sk < local.low ){ local.low = local.sk }
		if( local.sk > local.high ){ local.high = local.sk }
	}
	if( ( local.high - local.low ) > 8 ){ waitthread mgNo "bag_slope" local.g; end }
	if( level.coop_psqMgForce != "C" ){
		if( waitthread mgLane local.g local.sid ){ waitthread mgNo "lane" local.g; end }
	}
	local.bag = local.g
	local.bag[2] = local.low
	local.sup = local.g
	local.sup[2] = local.low + 25.8 + 12.8		// the bags (drawn at 1.2) are 25.8u high
	local.gun = local.g
	local.gun[2] = local.low + 25.8 + 13.5
	waitthread mgSite local.a local.sid "C" local.g local.gun local.sup local.bag local.fyaw 0 local.aim local.kind
}end


// find him a place (see the header). Looks at the ground round HIM - he has to walk there - on
// seven rings out to 432u, takes the sites that pass in order of how near they are (cover before
// bags), and commits to the first one he can get to. Writes the plan into local.a.coop_psqMg*.
mgPlan local.a local.sid:{
	if( level.coop_psqPlanBusy == 1 ){ end 0 }
	level.coop_psqPlanBusy = 1
	// he is the planner's from here on: the brain gives a busy man no order. (A bound or a room-clearing order
	// that started during the search took him off the walk-up - 2026-10-12, m3l2: "mg walk how=2 left=42 ok=0".)
	local.a.coop_psqBusy = 1
	local.t0 = level.time
	local.apos = level.coop_psqApos[local.sid]
	local.aim = waitthread mgAim local.sid
	local.kind = level.coop_psqAimKind
	local.mp = level.coop_mapname
	local.bags = 1
	if( local.mp == "m3l1a" || local.mp == "m3l1b" || local.mp == "e3l1" || local.mp == "e3l2" || local.mp == "obj_team3" || local.mp == "obj/obj_team3" ){ local.bags = 0 }
	local.tripod = 0
	if( getcvar( "coop_paraMgTripod" ) == "1" || level.coop_psqMgForce == "B" ){ local.tripod = 1 }
	level.coop_psqCn = 0
	level.coop_psqR = NIL
	level.coop_psqR["tested"] = 0
	if( level.coop_psqWorldNum == NIL ){
		local.w = $world
		if( local.w != NULL ){ level.coop_psqWorldNum = local.w.entnum }
	}
	local.ctr = local.a.origin
	local.n = 0
	for( local.r = 0; local.r <= 432; local.r = local.r + 72 ){
		for( local.j = 0; local.j < 12; local.j++ ){
			if( local.r == 0 && local.j > 0 ){ break }
			local.c = local.ctr + ( vector_scale ( angles_toforward ( 0 ( ( local.j * 30 ) + ( local.r * 0.2 ) ) 0 ) ) local.r )
			local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.c + ( 0 0 48 ) )
			if( local.g == NIL ){ continue }
			local.dz = local.g[2] - local.ctr[2]
			if( local.dz < 0 ){ local.dz = 0 - local.dz }
			if( local.dz > 120 ){ continue }
			if( ( waitthread flatDist local.g local.apos ) > 520 ){ continue }
			level.coop_psqR["tested"] = level.coop_psqR["tested"] + 1
			// the bags are not carried far: only within 300u of him
			local.b = local.bags
			if( local.r > 300 ){ local.b = 0 }
			waitthread mgTry local.a local.sid local.g local.aim local.kind local.b local.tripod
			local.n++
			if( local.n >= 4 ){
				local.n = 0
				waitframe
				if( local.a == NULL ){ level.coop_psqPlanBusy = 0; end 0 }
				if( !isAlive local.a ){ level.coop_psqPlanBusy = 0; end 0 }
			}
		}
	}
	if( level.coop_psqCn == 0 && local.kind != "advance" ){
		// no place round him from which the gun sees the enemy himself: a place that covers the ground TOWARD him
		// (800u clear down that line) is the next best thing - the gun is up when he shows
		local.v = local.aim - local.apos
		local.v[2] = 0
		if( vector_length local.v > 200 ){
			local.kind = "advance"
			local.aim = local.apos + ( vector_scale ( vector_normalize local.v ) 1200 )
			local.aim[2] = local.apos[2]
			local.n = 0
			for( local.r = 0; local.r <= 432; local.r = local.r + 72 ){
				for( local.j = 0; local.j < 12; local.j++ ){
					if( local.r == 0 && local.j > 0 ){ break }
					local.c = local.ctr + ( vector_scale ( angles_toforward ( 0 ( ( local.j * 30 ) + ( local.r * 0.2 ) ) 0 ) ) local.r )
					local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.c + ( 0 0 48 ) )
					if( local.g == NIL ){ continue }
					local.dz = local.g[2] - local.ctr[2]
					if( local.dz < 0 ){ local.dz = 0 - local.dz }
					if( local.dz > 120 ){ continue }
					if( ( waitthread flatDist local.g local.apos ) > 520 ){ continue }
					local.b = local.bags
					if( local.r > 300 ){ local.b = 0 }
					waitthread mgTry local.a local.sid local.g local.aim local.kind local.b local.tripod
					local.n++
					if( local.n >= 4 ){
						local.n = 0
						waitframe
						if( local.a == NULL ){ level.coop_psqPlanBusy = 0; end 0 }
						if( !isAlive local.a ){ level.coop_psqPlanBusy = 0; end 0 }
					}
				}
			}
		}
	}
	// best first, and the first he can reach
	local.found = 0
	local.tried = 0
	while( local.tried < 6 ){
		local.bi = 0
		local.bs = 999999
		for( local.i = 1; local.i <= level.coop_psqCn; local.i++ ){
			if( level.coop_psqCd[local.i] == 1 ){ continue }
			if( level.coop_psqCs[local.i] < local.bs ){ local.bs = level.coop_psqCs[local.i]; local.bi = local.i }
		}
		if( local.bi == 0 ){ break }
		level.coop_psqCd[local.bi] = 1
		// the seat he set out for and did not reach in the last minute: not again
		if( local.a.coop_psqMgBadSeatT != NIL ){
			if( level.time < local.a.coop_psqMgBadSeatT ){
				if( vector_length( level.coop_psqCt[local.bi] - local.a.coop_psqMgBadSeat ) < 48 ){ continue }
			}
		}
		local.tried++
		local.how = waitthread mgReach local.a level.coop_psqCt[local.bi]
		if( local.a == NULL ){ level.coop_psqPlanBusy = 0; end 0 }
		if( !isAlive local.a ){ level.coop_psqPlanBusy = 0; end 0 }
		local.wd = waitthread flatDist local.a.origin level.coop_psqCt[local.bi]
		local.line = "mode=" + level.coop_psqCm[local.bi] + " gun=" + level.coop_psqCg[local.bi] + " yaw=" + level.coop_psqCy[local.bi] + " top=" + level.coop_psqCh[local.bi] + " fire=" + local.kind + ":" + level.coop_psqCf[local.bi] + " arc=" + level.coop_psqCx[local.bi] + " seat=" + level.coop_psqCt[local.bi] + " walk=" + local.wd + " path=" + level.coop_psqPd
		if( local.how == 0 ){
			waitthread dbg ( "mg refuse why=unreachable " + local.line )
			continue
		}
		local.found = 1
		local.a.coop_psqMgMode = level.coop_psqCm[local.bi]
		local.a.coop_psqMgGun = level.coop_psqCg[local.bi]
		local.a.coop_psqMgSup = level.coop_psqCu[local.bi]
		local.a.coop_psqMgBag = level.coop_psqCb[local.bi]
		local.a.coop_psqMgStand = level.coop_psqCt[local.bi]
		local.a.coop_psqMgYaw = level.coop_psqCy[local.bi]
		local.a.coop_psqMgArc = level.coop_psqCx[local.bi]
		local.a.coop_psqMgTop = level.coop_psqCh[local.bi]
		local.a.coop_psqMgHow = local.how
		local.a.coop_psqMgVia = level.coop_psqVia
		local.a.coop_psqMgKind = local.kind
		waitthread dbg ( "mg site how=" + local.how + " " + local.line + " of=" + level.coop_psqCn )
		break
	}
	if( local.found != 1 ){
		// he was sent toward the ones that failed: stop him, give him back to the fight
		local.a runto local.a.origin
		local.a.enableEnemy = 1
		local.a forceactivate
		waitthread post local.a local.a.origin 200
		local.a.coop_psqBusy = 0
	}
	// why the rest were refused
	local.wn[1] = "tall"; local.wn[2] = "not_level"; local.wn[3] = "top_blocked"; local.wn[4] = "not_world"; local.wn[5] = "headroom"
	local.wn[6] = "seatground"; local.wn[7] = "height"; local.wn[8] = "nofire"; local.wn[9] = "seat"; local.wn[10] = "arc"
	local.wn[11] = "reach"; local.wn[12] = "gap"; local.wn[13] = "crowded"; local.wn[14] = "player_in_front"; local.wn[15] = "squad_in_front"
	local.wn[16] = "bag_ground"; local.wn[17] = "bag_slope"; local.wn[18] = "lane"
	local.s = ""
	for( local.i = 1; local.i <= 18; local.i++ ){
		local.c = level.coop_psqR[local.wn[local.i]]
		if( local.c != NIL ){ local.s = local.s + " " + local.wn[local.i] + "=" + local.c }
	}
	local.word = "mg nosite"
	if( local.found == 1 ){ local.word = "mg plan" }
	waitthread dbg ( local.word + " aim=" + local.kind + " ground=" + level.coop_psqR["tested"] + " passed=" + level.coop_psqCn + " tried=" + local.tried + " bags=" + local.bags + " refused:" + local.s + " secs=" + ( level.time - local.t0 ) )
	level.coop_psqPlanBusy = 0
}end local.found


// set a piece down (or pick it up): local.e travels between local.h above local.to and local.to in
// local.t seconds, 20 steps a second. script_model has no working moveto - the origin is stepped.
mgLower local.e local.to local.h local.t local.up:{
	local.n = int( local.t * 20 )
	if( local.n < 1 ){ local.n = 1 }
	for( local.i = 1; local.i <= local.n; local.i++ ){
		if( local.e == NIL || local.e == NULL ){ end }
		local.f = ( local.i * 1.0 ) / ( local.n * 1.0 )
		if( local.up != 1 ){ local.f = 1.0 - local.f }
		local.e.origin = local.to + ( 0 0 ( local.h * local.f ) )
		wait 0.05
	}
}end


// one leg of the walk: local.straight = over an info_waypoint (no path graph), else by the graph.
// Returns how far from local.pos he ended (flat).
mgLeg local.a local.pos local.straight local.rad local.tmo:{
	local.way = NIL
	local.a.movedoneradius = local.rad
	if( local.straight == 1 ){
		local.way = spawn info_waypoint
		local.way.origin = local.pos
		local.a runto local.way
	} else {
		local.a runto local.pos
	}
	local.o0 = local.a.origin
	local.t = 0
	local.stall = 0
	while( local.t < local.tmo ){
		wait 0.25
		local.t = local.t + 0.25
		if( local.a == NULL ){ break }
		if( !isAlive local.a ){ break }
		local.d = waitthread flatDist local.a.origin local.pos
		if( local.d < ( local.rad + 6 ) ){ break }
		// stalled = he is not moving (NOT 'the straight distance is not shrinking': a path round a building grows it)
		if( vector_length( local.a.origin - local.o0 ) > 5 ){ local.stall = 0 } else { local.stall = local.stall + 0.25 }
		local.o0 = local.a.origin
		if( local.stall >= 2.0 ){ break }
	}
	if( local.way != NIL && local.way != NULL ){ local.way remove }
	local.r = 99999
	if( local.a != NULL ){ local.r = waitthread flatDist local.a.origin local.pos }
}end local.r


// walk him to the seat the way mgReach found, then the last steps straight onto it. 1 = he is on it.
mgWalk local.a local.pos local.how local.via:{
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.left = 99999
	if( local.how == 3 && local.via != NIL ){
		local.left = waitthread mgLeg local.a local.via 0 28 10
		if( local.a == NULL ){ end 0 }
		if( isAlive local.a ){ local.left = waitthread mgLeg local.a local.pos 1 10 6 }
	} else if( local.how == 2 ){
		local.left = waitthread mgLeg local.a local.pos 1 10 10
	} else {
		// by the path graph: 12s, or what the path's length needs at a run (pathdist is what mgReach read)
		local.tmo = 12
		if( level.coop_psqPd != NIL ){
			if( ( level.coop_psqPd / 140 ) + 4 > local.tmo ){ local.tmo = ( level.coop_psqPd / 140 ) + 4 }
		}
		if( local.tmo > 30 ){ local.tmo = 30 }
		local.left = waitthread mgLeg local.a local.pos 0 28 local.tmo
	}
	if( local.a == NULL ){ end 0 }
	if( !isAlive local.a ){ end 0 }
	// the last steps
	if( local.left > 14 && local.left < 110 ){
		if( waitthread mgLine local.a.origin local.pos ){
			local.left = waitthread mgLeg local.a local.pos 1 10 4
			if( local.a == NULL ){ end 0 }
		}
	}
	local.ok = 0
	if( isAlive local.a ){
		local.ao = local.a.origin
		local.dz = local.ao[2] - local.pos[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.left < 30 && local.dz < 20 ){ local.ok = 1 }
		if( local.ok != 1 ){
			local.a.enableEnemy = 1
			local.a forceactivate
			waitthread post local.a local.a.origin 200
			local.a.coop_psqBusy = 0
		}
	}
	waitthread dbg ( "mg walk how=" + local.how + " left=" + local.left + " ok=" + local.ok )
}end local.ok


// everything put down so far is taken away again, and he goes back to being a rifleman
mgAbort local.a local.why:{
	if( local.a != NULL ){
		if( local.a.coop_psqCrate != NIL && local.a.coop_psqCrate != NULL ){ local.a.coop_psqCrate remove }
		if( local.a.coop_psqSup != NIL && local.a.coop_psqSup != NULL ){ local.a.coop_psqSup remove }
		if( local.a.coop_psqBag != NIL && local.a.coop_psqBag != NULL ){ local.a.coop_psqBag remove }
		local.a.coop_psqCrate = NIL
		local.a.coop_psqSup = NIL
		local.a.coop_psqBag = NIL
		if( local.a.coop_psqProp != NIL && local.a.coop_psqProp != NULL ){ local.a.coop_psqProp show }
		if( isAlive local.a ){
			local.a.enableEnemy = 1
			local.a forceactivate
			waitthread post local.a local.a.origin 200
		}
		local.a.coop_psqBusy = 0
	}
	waitthread dbg ( "mg setup abort=" + local.why )
}end


mgSetup local.a local.sid:{
	local.got = waitthread mgWalk local.a local.a.coop_psqMgStand local.a.coop_psqMgHow local.a.coop_psqMgVia
	if( local.a == NULL ){ end }
	if( !isAlive local.a ){ end }
	if( local.got != 1 ){
		local.wd = waitthread flatDist local.a.origin local.a.coop_psqMgStand
		// not planned again for a minute (mgPlan)
		local.a.coop_psqMgBadSeat = local.a.coop_psqMgStand
		local.a.coop_psqMgBadSeatT = level.time + 60
		waitthread dbg ( "mg setup abort=not_reached left=" + local.wd )
		end
	}
	local.yaw = local.a.coop_psqMgYaw
	local.dir = angles_toforward ( 0 local.yaw 0 )
	if( waitthread playerInFront local.a.coop_psqMgGun local.dir ){
		waitthread mgAbort local.a "player_in_front"
		end
	}
	local.mode = local.a.coop_psqMgMode
	local.bag = NIL
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.a.coop_psqCrate = NIL
	local.a.coop_psqSup = NIL
	local.a.coop_psqBag = NIL
	local.look = spawn script_origin
	local.look.origin = local.a.coop_psqMgGun
	local.a turnto local.look
	wait 0.5
	local.look remove
	if( local.a == NULL ){ end }
	if( !isAlive local.a ){ waitthread mgAbort local.a "died"; end }
	// what the plan rests on is looked at once more, now that he is standing there: a surface that
	// has gone (a door swung, a crate was pushed in) means no gun
	local.chk = local.a.coop_psqMgSup
	local.chk[2] = local.a.coop_psqMgGun[2] - 13.5
	if( local.mode == "B" ){ local.chk[2] = local.a.coop_psqMgSup[2] - 49.4 }
	if( local.mode == "C" ){ local.chk = local.a.coop_psqMgBag + ( 0 0 1 ) }
	local.sz = waitthread mgSurf local.chk 10 14
	if( local.sz == NIL ){ waitthread mgAbort local.a "surface_gone"; end }
	local.dz = local.sz - local.chk[2]
	if( local.dz < 0 ){ local.dz = 0 - local.dz }
	if( local.mode != "C" && local.dz > 4 ){ waitthread mgAbort local.a "surface_moved"; end }
	// 1. the sandbags, if this is that kind of place (not solid: see the header)
	if( local.mode == "C" ){
		local.bag = spawn script_model
		local.bag model "models/static/coop_mg_bags.tik"
		local.bag scale 1.2				// 25.8u: the gun low over the bags (see mgTry)
		local.bag notsolid
		local.bag.origin = local.a.coop_psqMgBag + ( 0 0 24 )
		local.bag.angles = ( 0 local.yaw 0 )
		local.a.coop_psqBag = local.bag
		waitthread mgLower local.bag local.a.coop_psqMgBag 24 0.35 0
	}
	if( local.a == NULL ){
		if( local.bag != NIL && local.bag != NULL ){ local.bag remove }
		end
	}
	// 2. the mount: the tripod on the ground, the bipod on anything else
	local.sup = spawn script_model
	if( local.mode == "B" ){
		local.sup model "models/weapons/mg42portable_placed_base.tik"
	} else {
		local.sup model "models/statweapons/mg42_bipod.tik"
		local.sup scale 0.75			// 12.8u, the height of the M1919's own bipod (the MG42 prop is 17.1u)
	}
	local.sup notsolid
	local.sup.origin = local.a.coop_psqMgSup + ( 0 0 16 )
	local.sup.angles = ( 0 local.yaw 0 )
	if( local.mode == "B" ){ local.sup.angles = ( 0 ( local.yaw + 180 ) 0 ) }
	local.a.coop_psqSup = local.sup
	waitthread mgLower local.sup local.a.coop_psqMgSup 16 0.3 0
	if( local.a == NULL ){
		if( local.bag != NIL && local.bag != NULL ){ local.bag remove }
		if( local.sup != NULL ){ local.sup remove }
		end
	}
	// 3. the ammo can on the ground at his right hand (he sits to the left of the gun): clear of
	// his knees over the whole traverse
	local.rgt = angles_toforward ( 0 ( local.yaw - 90 ) 0 )
	local.crate = spawn script_model
	local.crate model "models/static/30cal_crate.tik"
	local.crate notsolid
	local.cp = local.a.coop_psqMgGun - ( vector_scale local.dir 30 ) + ( vector_scale local.rgt 24 )
	local.cp[2] = local.a.coop_psqMgStand[2]
	local.cz = waitthread mgSurf local.cp 30 30
	if( local.cz == NIL ){
		local.cp = local.a.coop_psqMgStand + ( vector_scale local.rgt 34 )
		local.cz = local.a.coop_psqMgStand[2]
	}
	local.cp[2] = local.cz
	local.crate.origin = local.cp + ( 0 0 14 )
	local.crate.angles = ( 0 local.yaw 0 )
	local.a.coop_psqCrate = local.crate
	waitthread mgLower local.crate local.cp 14 0.25 0
	if( local.a == NULL ){
		if( local.bag != NIL && local.bag != NULL ){ local.bag remove }
		if( local.sup != NULL ){ local.sup remove }
		if( local.crate != NULL ){ local.crate remove }
		end
	}
	if( !isAlive local.a ){ waitthread mgAbort local.a "died"; end }
	// 4. the gun, off his back and onto the mount
	local.gun = spawn "models/statweapons/coop_30cal_para.tik"
	if( local.gun == NIL || local.gun == NULL ){ waitthread mgAbort local.a "no_gun"; end }
	if( local.a.coop_psqProp != NIL && local.a.coop_psqProp != NULL ){ local.a.coop_psqProp hide }
	local.gun.origin = local.a.coop_psqMgGun + ( 0 0 10 )
	local.gun.angles = ( 0 local.yaw 0 )
	local.gun startyaw local.yaw	// m_fStartYaw is captured at spawn, before .angles (bunker.scr)
	local.gun targettype "auto"
	local.gun burstFireSettings 1.2 3.0 0.8 2.2
	local.gun aibulletspread 300 300
	local.gun maxYawOffset local.a.coop_psqMgArc
	// pitch: 25 degrees up (upstairs windows), 12 down. His hands stay on the grips over all of it: mgPivot.
	// With nobody on it the gun lies back on its butt (mgRest); it is level before he takes it (mgMount).
	local.gun pitchCaps ( -25 12 0 )
	// the turret's own cycle: track what he sees, then 5s on where he last saw it (a 96 x 40u
	// patch), 3s watching it, then back to the middle
	local.gun convergeTime 1.0
	local.gun suppressTime 5
	local.gun suppressWaitTime 3
	local.gun suppressWidth 96
	local.gun suppressHeight 40
	// the belt, the barrel and the true rate of fire: engine keys of game.dll 1.10.22 (weapturret.cpp, bug-3636..3639),
	// set in a helper file because a command an older game.dll does not know fails the WHOLE file it stands in
	// (TRAPS T1, bug-3423). He carries the belt in the gun and one more.
	if( local.a.coop_psqBelt == NIL ){
		local.a.coop_psqBelt = 250
		local.a.coop_psqBelts = 1
	}
	local.a.coop_psqMgKeys = 0
	local.a.coop_psqReload = 0
	local.kk = waitthread coop_mod/parasquad_gun.scr::belt local.gun local.a.coop_psqBelt
	if( local.kk == 1 ){
		local.a.coop_psqMgKeys = 1
		// with the keys he fires at the gun's own 10 rounds a second (without: one round a server frame, 40 a second,
		// which is what the wide cone and the long bursts above were chosen for): bursts of 5-9, a tighter cone
		local.gun burstFireSettings 0.5 0.9 1.0 2.2
		local.gun aibulletspread 150 150
	}
	// set down, it lies back on its butt until he is behind it
	local.rp = waitthread mgRest local.a.coop_psqMgGun local.yaw
	local.gun.coop_psqRest = local.rp
	waitthread mgRestSet local.gun local.rp
	local.a.coop_psqGun = local.gun
	waitthread mgLower local.gun local.a.coop_psqMgGun 10 0.3 0
	if( local.a == NULL ){
		if( local.bag != NIL && local.bag != NULL ){ local.bag remove }
		if( local.sup != NULL ){ local.sup remove }
		if( local.crate != NULL ){ local.crate remove }
		if( local.gun != NULL ){ local.gun remove }
		end
	}
	if( local.gun == NULL ){ waitthread mgAbort local.a "no_gun"; end }
	local.gun.origin = local.a.coop_psqMgGun
	// remember his own thinks for the pack-up, then onto the gun
	local.a.coop_psqT1 = local.a.type_idle
	local.a.coop_psqT2 = local.a.type_attack
	local.a.coop_psqT3 = local.a.type_disguise
	local.a.coop_psqT4 = local.a.type_grenade
	thread mgPivot local.gun local.sup local.mode local.yaw
	local.ok = waitthread mgMount local.a local.gun local.sid
	if( local.a == NULL ){ end }
	if( local.ok != 1 ){
		// (a man who died in these last moments leaves it where it stands: the gunner thread hands it to the players)
		if( isAlive local.a ){
			waitthread dbg "mg setup abort=not_seated"
			waitthread mgPackup local.a
		}
		end
	}
	waitthread ev "mg" local.a
	local.go = local.gun.origin
	local.ao = local.a.origin
	waitthread dbg ( "mg setup k=1 mode=" + local.mode + " gun=" + local.go + " yaw=" + local.yaw + " arc=" + local.a.coop_psqMgArc + " top=" + local.a.coop_psqMgTop + " seat=" + local.ao + " hp=" + ( local.go[2] - local.ao[2] ) + " pos=" + local.a.position )
}end


// once a second while he is on the gun: "stay", else why he leaves it
mgTend local.a local.sid:{
	local.gun = local.a.coop_psqGun
	if( local.gun == NIL || local.gun == NULL ){ end "gun_gone" }
	local.apos = level.coop_psqApos[local.sid]
	if( level.coop_psqHolding[local.sid] != 1 ){
		if( vector_length( local.apos - local.gun.origin ) > 560 ){ end "squad_moved_on" }
	}
	// the belt: out = the second belt goes in (4s with the gun silent), and when that is gone too he packs up
	if( local.a.coop_psqMgKeys == 1 && local.a.coop_psqReload != 1 ){
		local.am = waitthread coop_mod/parasquad_gun.scr::ammo local.gun
		if( local.am != NIL ){
			local.a.coop_psqBelt = local.am
			if( local.am == 0 ){
				if( local.a.coop_psqBelts < 1 ){ end "belt_out" }
				local.a.coop_psqBelts--
				thread mgReload local.a local.gun
				end "stay"
			}
		}
	}
	// what the gun stands on is still there
	if( local.a.coop_psqMgMode == "A" ){
		local.chk = local.gun.origin - ( 0 0 13.5 )
		if( local.gun.coop_psqBase != NIL ){ local.chk = local.gun.coop_psqBase - ( 0 0 13.5 ) }
		local.sz = waitthread mgSurf local.chk 10 14
		if( local.sz == NIL ){ end "support_gone" }
		local.dz = local.sz - local.chk[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz > 4 ){ end "support_gone" }
	}
	// the fight: is the enemy the squad knows still in front of this gun, and is the line open?
	local.thr = level.coop_psqThreat[local.sid]
	if( local.thr == NIL ){
		local.a.coop_psqMgBad = 0
		end "stay"
	}
	// (not while he has a target of his own in sight: the gun is doing its work)
	local.e = local.a.enemy
	if( local.e != NIL && local.e != NULL ){
		if( isAlive local.e ){
			if( local.a cansee local.e ){
				local.a.coop_psqMgBad = 0
				end "stay"
			}
		}
	}
	local.v = local.thr - local.gun.origin
	local.v[2] = 0
	local.dist = vector_length local.v
	local.va = vector_toangles local.v
	local.off = local.va[1] - local.a.coop_psqMgYaw
	while( local.off > 180 ){ local.off = local.off - 360 }
	while( local.off < ( 0 - 180 ) ){ local.off = local.off + 360 }
	if( local.off < 0 ){ local.off = 0 - local.off }
	local.bad = ""
	if( local.off > ( local.a.coop_psqMgArc + 10 ) ){ local.bad = "enemy_out_of_arc" }
	if( local.bad == "" && local.dist > 96 ){
		local.q = local.gun.origin + ( 0 0 4 )
		local.tr = traced local.q ( local.thr + ( 0 0 40 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
		if( ( local.tr["fraction"] * local.dist ) < ( local.dist - 150 ) ){ local.bad = "enemy_masked" }
	}
	if( local.bad == "" ){
		local.a.coop_psqMgBad = 0
		end "stay"
	}
	// (a gun that has fired in the last 20s is doing its work where it is: the squad's NEAREST enemy can be masked
	// from it while it keeps another one's head down)
	if( local.a.coop_psqMgFireT != NIL ){
		if( ( level.time - local.a.coop_psqMgFireT ) < 20 ){
			local.a.coop_psqMgBad = 0
			end "stay"
		}
	}
	local.a.coop_psqMgBad++
	if( local.a.coop_psqMgBad >= 25 ){ end local.bad }
}end "stay"


// a new belt: the gun is silent for 4s (mgHold holds it), then it has 250 rounds again
mgReload local.a local.gun:{
	local.a.coop_psqReload = 1
	waitthread dbg ( "mg newbelt left=" + local.a.coop_psqBelts )
	wait 4
	if( local.a == NULL || local.gun == NULL ){ end }
	local.gun coopammo 250
	local.a.coop_psqBelt = 250
	local.a.coop_psqReload = 0
}end


// four times a second while he is on the gun: hold fire with a friend in front of the muzzle, and
// suppress an enemy only the squad knows (the turret's own cycle covers the ones he sees himself)
mgHold local.a local.gun local.sid:{
	local.held = 0
	local.next = level.time + 2
	local.tgt = spawn script_origin
	local.watch = 0
	local.hot = 0
	local.lastSee = level.time - 100
	while( local.a != NULL && local.gun != NULL ){
		if( !isAlive local.a ){ break }
		if( local.a.coop_psqMounted != 1 || local.a.coop_psqGun != local.gun ){ break }
		local.dir = angles_toforward ( 0 local.gun.angles[1] 0 )
		local.blk = waitthread playerInFront local.gun.origin local.dir
		if( local.blk != 1 ){ local.blk = waitthread mateInFront local.gun.origin local.dir local.sid local.a }
		local.hw = "friend_in_front"
		if( local.blk != 1 && local.a.coop_psqReload == 1 ){ local.blk = 1; local.hw = "new_belt" }
		if( local.blk != 1 && local.a.coop_psqMgKeys == 1 ){
			// the barrel: he stops at 45 of 100 and lets it bleed to 12 (the engine locks a cooked gun for 2s);
			// while the squad is bounding on his fire he takes it to 70
			local.ht = waitthread coop_mod/parasquad_gun.scr::heat local.gun
			if( local.ht != NIL ){
				local.cap = 45
				local.st = level.coop_psqSupT[local.sid]
				if( local.st != NIL ){
					if( level.time < local.st ){ local.cap = 70 }
				}
				if( local.hot == 1 ){
					if( local.ht > 12 ){ local.blk = 1; local.hw = "barrel_hot" } else { local.hot = 0 }
				} else if( local.ht >= local.cap ){
					local.hot = 1
					local.blk = 1
					local.hw = "barrel_hot"
				}
			}
		}
		if( local.blk == 1 && local.held != 1 ){
			local.gun targettype "none"
			local.gun stopFiring
			local.gun clearAimTarget
			local.held = 1
			local.watch = 0
			waitthread dbg ( "mg hold fire=" + local.hw )
		}
		if( local.blk != 1 && local.held == 1 ){
			local.gun targettype "auto"
			local.held = 0
			local.next = level.time + 1
			waitthread dbg "mg hold fire=clear"
		}
		local.e = local.a.enemy
		local.own = 0
		if( local.e != NIL && local.e != NULL ){
			if( isAlive local.e ){ local.own = 1 }
		}
		local.sees = 0
		if( local.own == 1 ){
			if( local.a cansee local.e ){ local.sees = 1 }
		}
		if( local.sees == 1 ){
			local.lastSee = level.time
			local.a.coop_psqMgFireT = level.time
		}
		if( local.held != 1 && local.sees == 1 ){
			// a target of his own in sight: the turret's own cycle tracks and fires (about 58% of the time)
			if( local.watch == 1 ){
				local.gun clearAimTarget
				local.gun targettype "auto"
				local.watch = 0
				waitthread dbg "mg track"
			}
		}
		if( local.held != 1 && local.watch != 1 && ( level.time - local.lastSee ) > 9 ){
			// nobody in his sight for 9s (the turret has fired its 5s at where he lost him and waited its 3):
			// he WATCHES - the gun level, down the middle of his arc. Left to itself the engine now turns the gun
			// to a "default position" whose pitch points at the first player, wherever he is
			// (TurretGun::AI_MoveToDefaultPosition), and the grips leave the gunner's hands.
			local.wp = local.gun.origin + ( vector_scale ( angles_toforward ( 0 local.a.coop_psqMgYaw 0 ) ) 600 )
			local.tgt.origin = local.wp
			local.gun targettype "none"
			local.gun stopFiring
			local.gun setAimTarget local.tgt
			local.watch = 1
			waitthread dbg "mg watch"
		}
		if( local.held != 1 && level.time >= local.next ){
			local.lt = level.coop_psqLastThr[local.sid]
			if( local.sees != 1 && local.lt != NIL ){
				if( ( level.time - level.coop_psqLastThrT[local.sid] ) < 12 ){
					// inside his arc, and the first 250u of the line free
					local.v = local.lt - local.gun.origin
					local.v[2] = 0
					local.dist = vector_length local.v
					local.va = vector_toangles local.v
					local.off = local.va[1] - local.a.coop_psqMgYaw
					while( local.off > 180 ){ local.off = local.off - 360 }
					while( local.off < ( 0 - 180 ) ){ local.off = local.off + 360 }
					if( local.off < 0 ){ local.off = 0 - local.off }
					local.fd = vector_normalize local.v
					local.q = local.gun.origin + ( 0 0 4 )
					local.tr = traced local.q ( local.q + ( vector_scale local.fd 250 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 270337
					local.ok = 1
					if( local.off > local.a.coop_psqMgArc || local.dist < 200 || local.tr["fraction"] < 1.0 ){ local.ok = 0 }
					if( local.ok == 1 ){
						if( waitthread playerInFront local.gun.origin local.fd ){ local.ok = 0 }
					}
					if( local.ok == 1 ){
						if( waitthread mateInFront local.gun.origin local.fd local.sid local.a ){ local.ok = 0 }
					}
					if( local.ok == 1 ){
						local.jx = ( randomfloat 80 ) - 40
						local.jy = ( randomfloat 80 ) - 40
						local.jz = 24 + ( randomfloat 30 )
						local.to = local.lt
						local.to[0] = local.to[0] + local.jx
						local.to[1] = local.to[1] + local.jy
						local.to[2] = local.to[2] + local.jz
						local.tgt.origin = local.to
						local.gun targettype "none"
						local.gun setAimTarget local.tgt
						wait 0.5
						if( local.gun == NULL ){ break }
						local.gun startFiring
						local.a.coop_psqMgFireT = level.time
						waitthread dbg ( "mg suppress at=" + local.tgt.origin + " age=" + ( level.time - level.coop_psqLastThrT[local.sid] ) )
						local.t = 0.6 + ( randomfloat 0.4 )
						local.st = level.coop_psqSupT[local.sid]
						if( local.st != NIL ){
							if( level.time < local.st ){ local.t = 1.5 + ( randomfloat 1.0 ) }
						}
						while( local.t > 0 ){
							wait 0.25
							local.t = local.t - 0.25
							if( local.gun == NULL || local.a == NULL ){ break }
							local.dir = angles_toforward ( 0 local.gun.angles[1] 0 )
							if( waitthread playerInFront local.gun.origin local.dir ){ break }
							if( waitthread mateInFront local.gun.origin local.dir local.sid local.a ){ break }
						}
						if( local.gun == NULL ){ break }
						// the burst is over: he keeps the gun on that place (the watch), until he sees a man himself
						local.gun stopFiring
						local.watch = 1
					}
				}
			}
			local.next = level.time + 2 + ( randomfloat 2.5 )
			// a bound is on (bound sets this): keep their heads down, burst on burst
			local.st = level.coop_psqSupT[local.sid]
			if( local.st != NIL ){
				if( level.time < local.st ){ local.next = level.time + 0.5 }
			}
		}
		wait 0.25
	}
	if( local.tgt != NULL ){ local.tgt remove }
	if( local.gun != NULL ){
		if( local.held == 1 || local.watch == 1 ){
			local.gun stopFiring
			local.gun clearAimTarget
			local.gun targettype "auto"
		}
	}
}end


mgPackup local.a:{
	if( local.a == NULL ){ end }
	local.a.coop_psqBusy = 1
	local.pg = local.a.coop_psqGun
	if( local.pg != NIL && local.pg != NULL ){ local.pg.coop_psqPivot = 0 }
	local.a type_idle local.a.coop_psqT1
	local.a type_attack local.a.coop_psqT2
	local.a type_disguise local.a.coop_psqT3
	local.a type_grenade local.a.coop_psqT4
	local.a physics_on
	local.a.coop_psqMounted = 0
	local.a.enableEnemy = 0
	wait 0.4		// hands off the gun
	if( local.a == NULL ){ end }
	// the set-down in reverse: gun, mount, sandbags, can
	local.gun = local.a.coop_psqGun
	if( local.gun != NIL && local.gun != NULL ){
		waitthread mgLower local.gun local.gun.origin 10 0.25 1
		if( local.gun != NULL ){ local.gun remove }
	}
	if( local.a == NULL ){ end }
	if( local.a.coop_psqProp != NIL && local.a.coop_psqProp != NULL ){ local.a.coop_psqProp show }
	local.sup = local.a.coop_psqSup
	if( local.sup != NIL && local.sup != NULL ){
		waitthread mgLower local.sup local.sup.origin 16 0.25 1
		if( local.sup != NULL ){ local.sup remove }
	}
	if( local.a == NULL ){ end }
	local.bag = local.a.coop_psqBag
	if( local.bag != NIL && local.bag != NULL ){
		waitthread mgLower local.bag local.bag.origin 24 0.3 1
		if( local.bag != NULL ){ local.bag remove }
	}
	if( local.a == NULL ){ end }
	if( local.a.coop_psqCrate != NIL && local.a.coop_psqCrate != NULL ){ local.a.coop_psqCrate remove }
	local.a.coop_psqGun = NIL
	local.a.coop_psqCrate = NIL
	local.a.coop_psqSup = NIL
	local.a.coop_psqBag = NIL
	if( isAlive local.a ){
		local.a unholster
		local.a.enableEnemy = 1
		local.a forceactivate
		waitthread post local.a local.a.origin 200
	}
	local.a.coop_psqBusy = 0
	waitthread dbg "mg packup k=1"
}end


// off the gun: his own thinks back (the first lines of mgPackup, for a man who will come back to it)
mgOff local.a:{
	local.a type_idle local.a.coop_psqT1
	local.a type_attack local.a.coop_psqT2
	local.a type_disguise local.a.coop_psqT3
	local.a type_grenade local.a.coop_psqT4
	local.a physics_on
	local.a.coop_psqMounted = 0
}end


// THE REST. With nobody on it a bipod gun lies back on its butt, muzzle up (user 2026-10-12: "when no one is using
// that 30 cal it should be facing upward"). How far: the underside of the gun - a line from 2u under the pivot to the
// lowest corner of the stock, 63.4u behind the pivot and 8.2u under the bore (models/statweapons/30cal at 0.52) - is
// swung down in 2 degree steps until the world is in its way: the ground behind the rest, or the near edge of the
// cover it stands on. 31 degrees on the sandbags (the bags themselves are clear of it to 46). The engine's own
// drop (TurretGun::ThinkIdle) tests a point 56u back ON the bore line and stops 13 degrees later, the stock 11u in
// the ground. With nothing in the way (a sill at chest height) it stops at 60. Returns the gun's pitch: negative =
// muzzle up.
mgRest local.gp local.yaw:{
	local.r = 60
	for( local.t = 2; local.t <= 60; local.t = local.t + 2 ){
		local.ang = ( ( 0 - local.t ) local.yaw 0 )
		local.f = angles_toforward local.ang
		local.u = angles_toup local.ang
		local.p0 = local.gp - ( vector_scale local.u 2 )
		local.p1 = local.gp - ( vector_scale local.f 63.4 ) - ( vector_scale local.u 8.2 )
		local.tr = traced local.p0 local.p1 1023 ( 0 0 0 ) ( 0 0 0 ) 1
		if( local.tr["fraction"] < 1.0 || local.tr["startSolid"] == 1 ){
			local.r = local.t - 2
			break
		}
	}
	if( local.r < 6 ){ local.r = 6 }
	local.r = 0 - local.r
}end local.r


// the pitch an unmanned gun eases to: the engine key (game.dll 1.10.22, eased), else the retail idle limit (the
// engine's own drop, stopped there)
mgRestSet local.gun local.p:{
	local.kk = waitthread coop_mod/parasquad_gun.scr::rest local.gun local.p
	if( local.kk != 1 ){ local.gun maxIdlePitch local.p }
}end


// he takes the gun (global/mg42_active.scr gunner recipe). The gun is LEVEL before his hands go on it - it tipped
// during the set-down once and stayed tipped under them, and his hand was at his face - and goes back to its rest
// only when nobody holds it. 1 = he is on it.
mgMount local.a local.gun local.sid:{
	waitthread mgRestSet local.gun 0
	local.t = 0
	while( local.t < 1.2 ){
		wait 0.05
		local.t = local.t + 0.05
		if( local.gun == NULL || local.a == NULL ){ end 0 }
		local.gp = local.gun.angles[0]
		if( local.gp > 180 ){ local.gp = local.gp - 360 }
		if( local.gp > ( 0 - 1.5 ) && local.gp < 1.5 ){ break }
	}
	if( !isAlive local.a ){ end 0 }
	// onto the seat the engine will hold him on: it sweeps his hull down from 18u over his FEET, so
	// a seat on ground a little higher than where he stopped would never take him
	local.a.origin = local.a.coop_psqMgStand
	local.a turret local.gun
	local.a type_idle "machinegunner"
	local.a type_attack "machinegunner"
	local.a type_disguise "machinegunner"
	local.a type_grenade "machinegunner"
	local.a physics_off
	local.a.enableEnemy = 1
	local.a forceactivate
	local.a.coop_psqMounted = 1
	local.a.coop_psqBusy = 0
	local.a.coop_psqMgBad = 0
	local.gun.coop_psqMan = local.a
	local.rp = local.gun.coop_psqRest
	waitthread mgRestSet local.gun local.rp
	thread mgHold local.a local.gun local.sid
	thread mgNade local.a local.gun local.sid
	// is he AT the gun? Where the engine cannot seat him it leaves him where he stopped, hands on
	// nothing. Then there is no gun.
	wait 0.6
	if( local.a == NULL || local.gun == NULL ){ end 0 }
	if( !isAlive local.a ){ end 0 }
	local.base = local.gun.origin
	if( local.gun.coop_psqBase != NIL ){ local.base = local.gun.coop_psqBase }
	local.seat = waitthread mgSeat local.base local.gun.angles[1] local.a.coop_psqMgStand[2]
	local.off = waitthread flatDist local.a.origin local.seat
	if( local.off > 14 ){
		waitthread dbg ( "mg mount not_seated off=" + local.off )
		end 0
	}
}end 1


// THE GUN UNDER PITCH. The engine holds a gunner's hands 39u behind the gun's pivot on the gun's own line
// (Actor::ThinkHoldGun_TurretGun) and blends his pose between standing and crouched to put them there. The crouched
// pose is as low as he gets: hands 38.7u over his feet. A LOW gun pitched UP takes its grips under that - 39u x the
// sine of the pitch, 8u at 12 degrees, 13u at 20: firing at an upstairs window his hand was at his helmet. So the gun
// is lifted by what is missing: he raises the muzzle with the grips where they are, and the bipod, fast to the
// barrel, comes off its rest with it. Pitched down, or on a gun high enough for the blend, the engine's pose follows
// and nothing moves. A PLAYER on a low gun has one crouched clip and no blend: on the lowest guns it follows him
// down as well (the bipod's feet press up to 9u into the bags).
// Every frame while somebody is on it, four times a second otherwise. Lives as long as the gun; mgPackup ends it.
mgPivot local.gun local.sup local.mode local.yaw0:{
	local.base = local.gun.origin
	local.gun.coop_psqBase = local.base
	local.gun.coop_psqPivot = 1
	local.sb = NIL
	if( local.mode != "B" && local.sup != NIL && local.sup != NULL ){ local.sb = local.sup.origin }
	local.cur = 0
	local.last = 0
	while( local.gun != NULL ){
		if( local.gun.coop_psqPivot != 1 ){ break }
		// whose feet: the trooper on it, else a player on it
		local.fz = NIL
		local.pl = 0
		local.a = local.gun.coop_psqMan
		if( local.a != NIL && local.a != NULL ){
			if( isAlive local.a ){
				if( local.a.coop_psqMounted == 1 && local.a.coop_psqGun == local.gun ){ local.fz = local.a.origin[2] }
			}
		}
		if( local.fz == NIL ){
			for( local.i = 1; local.i <= $player.size; local.i++ ){
				local.p = $player[local.i]
				if( local.p == NULL ){ continue }
				if( local.p.turret == local.gun ){
					local.fz = local.p.origin[2]
					local.pl = 1
					break
				}
			}
		}
		local.want = 0
		local.f = angles_toforward local.gun.angles
		if( local.fz != NIL ){
			local.sink = 39 * local.f[2]
			local.room = local.base[2] - local.fz - 38.7
			if( local.room < 0 ){ local.room = 0 }
			if( local.sink > local.room ){ local.want = local.sink - local.room }
			if( local.pl == 1 && local.sink < 0 && local.room < 3 ){
				local.want = local.sink
				if( local.want < ( 0 - 9 ) ){ local.want = 0 - 9 }
			}
			if( local.want > 18 ){ local.want = 18 }
		}
		// 3u a frame at most (a man who has just taken it)
		local.d = local.want - local.cur
		if( local.d > 3 ){ local.d = 3 }
		if( local.d < ( 0 - 3 ) ){ local.d = 0 - 3 }
		local.cur = local.cur + local.d
		if( local.cur != 0 || local.last != 0 ){
			local.k = local.cur / 4.0
			if( local.k < 0 ){ local.k = 0 - local.k }
			if( local.k > 1 ){ local.k = 1 }
			// up by what the grips sank, back by what the turn brought them forward
			local.fl = local.f
			local.fl[2] = 0
			local.back = 39 * ( 1.0 - ( vector_length local.fl ) ) * local.k
			local.o = local.base - ( vector_scale ( angles_toforward ( 0 local.gun.angles[1] 0 ) ) local.back )
			local.o[2] = local.base[2] + local.cur
			local.gun.origin = local.o
			if( local.sb != NIL && local.sup != NULL ){
				local.gp = local.gun.angles[0]
				if( local.gp > 180 ){ local.gp = local.gp - 360 }
				local.dy = local.gun.angles[1] - local.yaw0
				while( local.dy > 180 ){ local.dy = local.dy - 360 }
				while( local.dy < ( 0 - 180 ) ){ local.dy = local.dy + 360 }
				local.sup.origin = local.sb + ( local.o - local.base )
				local.sup.angles = ( ( local.gp * local.k ) ( local.yaw0 + ( local.dy * local.k ) ) 0 )
			}
			local.last = local.cur
		}
		if( local.fz == NIL && local.cur == 0 ){ wait 0.25 } else { waitframe }
	}
	// the pack-up takes everything from where it was set down
	if( local.gun != NULL ){ local.gun.origin = local.base }
	if( local.sb != NIL && local.sup != NULL ){
		local.sup.origin = local.sb
		local.sup.angles = ( 0 local.yaw0 0 )
	}
}end


// THE MOUNTED GUNNER AND A GRENADE. On the gun his grenade think is the machine gunner's (the retail recipe), and for
// an American that one does nothing: he sat through it. Script has no way to ask the engine what grenade a man has
// seen, so the entity table is looked through, 64 slots a frame (all of it in under a second): a projectile that has
// come to rest - not one in flight, his own squad throws them past him - within 300u of him.
mgNade local.a local.gun local.sid:{
	local.i = 0
	while( local.a != NULL && local.gun != NULL ){
		if( !isAlive local.a ){ break }
		if( local.a.coop_psqMounted != 1 || local.a.coop_psqGun != local.gun ){ break }
		local.hit = NIL
		for( local.n = 0; local.n < 64; local.n++ ){
			local.i++
			if( local.i >= 1024 ){ local.i = 1 }
			local.e = getentbyentnum local.i
			if( local.e == NULL ){ continue }
			if( local.e.classname != "Projectile" ){ continue }
			if( vector_length( local.e.origin - local.a.origin ) > 300 ){ continue }
			if( ( vector_length local.e.velocity ) > 200 ){ continue }
			local.hit = local.e
			break
		}
		if( local.hit != NIL ){
			thread mgFlee local.a local.gun local.sid local.hit
			break
		}
		waitframe
	}
}end


// he lets go of the gun and gets 300u away from the grenade - straight away from it, else round in 45 degree steps,
// over ground that was looked at (mgLine) -, stays there until it has gone off, walks back and takes the gun again.
// A gun he cannot get back to, or that a player took meanwhile, is the players' (mgGiveUp).
mgFlee local.a local.gun local.sid local.nade:{
	local.np = local.nade.origin
	local.seat = local.a.origin
	local.a.coop_psqBusy = 1
	waitthread dbg ( "mg nade at=" + local.np + " d=" + ( vector_length( local.np - local.seat ) ) )
	waitthread mgOff local.a
	local.a.enableEnemy = 0
	local.v = local.seat - local.np
	local.v[2] = 0
	if( vector_length local.v < 8 ){ local.v = angles_toforward ( 0 ( local.gun.angles[1] + 180 ) 0 ) }
	local.va = vector_toangles local.v
	local.to = NIL
	for( local.i = 0; local.i < 5; local.i++ ){
		local.h = int( ( local.i + 1 ) / 2 ) * 45
		if( ( local.i - ( int( local.i / 2 ) * 2 ) ) == 0 ){ local.h = 0 - local.h }
		local.c = local.seat + ( vector_scale ( angles_toforward ( 0 ( local.va[1] + local.h ) 0 ) ) 300 )
		local.cz = waitthread mgSurf local.c 40 60
		if( local.cz == NIL ){ continue }
		local.c[2] = local.cz
		if( !( waitthread mgLine local.seat local.c ) ){ continue }
		local.to = local.c
		break
	}
	wait 0.25		// hands off the gun
	if( local.a == NULL ){ end }
	if( !isAlive local.a ){ end }
	local.a unholster
	if( local.to != NIL ){
		local.left = waitthread mgLeg local.a local.to 1 24 3.5
	} else {
		waitthread dbg "mg nade nowhere_to_go"
	}
	// until it has gone off
	local.t = 0
	while( local.nade != NULL && local.t < 6 ){
		wait 0.25
		local.t = local.t + 0.25
	}
	wait 0.8
	if( local.a == NULL ){ end }
	if( !isAlive local.a ){ end }
	// back to the gun, if it is still his to take
	local.ok = 0
	if( local.gun != NULL ){
		local.free = 1
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p == NULL ){ continue }
			if( local.p.turret == local.gun ){ local.free = 0 }
		}
		if( local.free == 1 ){
			local.straight = 0
			local.rad = 28
			if( waitthread mgLine local.a.origin local.seat ){
				local.straight = 1
				local.rad = 10
			}
			local.left = waitthread mgLeg local.a local.seat local.straight local.rad 8
			if( local.a == NULL ){ end }
			if( !isAlive local.a ){ end }
			if( local.left > 14 && local.left < 110 ){
				if( waitthread mgLine local.a.origin local.seat ){ local.left = waitthread mgLeg local.a local.seat 1 10 4 }
			}
			if( local.a == NULL ){ end }
			if( !isAlive local.a ){ end }
			if( local.left < 30 && local.gun != NULL ){
				local.ok = waitthread mgMount local.a local.gun local.sid
				if( local.a == NULL ){ end }
				if( !isAlive local.a ){ end }
				if( local.ok != 1 ){ waitthread mgOff local.a }
			}
		}
	}
	waitthread dbg ( "mg nade back=" + local.ok )
	if( local.ok != 1 ){ waitthread mgGiveUp local.a local.gun }
}end


// the gun stays where it is, for the players; he is a rifleman from here on
mgGiveUp local.a local.gun:{
	if( local.gun != NULL ){ waitthread mgLeft local.gun 0 }
	if( local.a == NULL ){ end }
	local.a.coop_psqGun = NIL
	local.a.coop_psqCrate = NIL
	local.a.coop_psqSup = NIL
	local.a.coop_psqBag = NIL
	local.a.coop_psqBeltOut = 1
	if( isAlive local.a ){
		local.a unholster
		local.a.enableEnemy = 1
		local.a forceactivate
		waitthread post local.a local.a.origin 200
	}
	local.a.coop_psqBusy = 0
	waitthread dbg "mg given up"
}end



// Is HE on the path network? 1 when the engine finds him a path to anywhere that is known to be on it: the point he
// landed on (tested before the jump, paradrop.scr::coop_para_lz), a squad mate, the anchor. (A path search starts
// in his own 256u map cell: with no pathnode there he has no path to anywhere - that is the man to rescue. A
// destination in such a cell fails the same way and says nothing about him.)
onNet local.a:{
	local.sid = local.a.coop_psqSid
	local.n = 0
	local.t[1] = NIL
	if( level.coop_paraLzN[local.sid] != NIL ){
		local.lz = level.coop_paraLz[local.sid][local.a.coop_psqK]
		if( local.lz != NIL ){ local.n++; local.t[local.n] = local.lz }
	}
	for( local.k = 1; local.k <= 5; local.k++ ){
		local.m = level.coop_psqM[local.sid][local.k]
		if( local.m == NIL || local.m == NULL || local.m == local.a ){ continue }
		if( !isAlive local.m ){ continue }
		if( local.n < 3 ){ local.n++; local.t[local.n] = local.m.origin }
	}
	if( level.coop_psqApos[local.sid] != NIL ){ local.n++; local.t[local.n] = level.coop_psqApos[local.sid] }
	local.r = 0
	for( local.i = 1; local.i <= local.n; local.i++ ){
		if( vector_length( local.t[local.i] - local.a.origin ) < 150 ){ continue }
		local.a runto local.t[local.i]
		wait 0.3
		if( local.a == NULL ){ end 0 }
		if( !isAlive local.a ){ end 0 }
		if( local.a.pathdist > 0 ){ local.r = 1; break }
	}
	local.a runto local.a.origin
}end local.r


// (see the brain, FOLLOW) a straight walk toward local.to for a man the path graph cannot move: all
// the way when the line is good (mgLine: his hull, and ground every 32u), else as far as it is in
// steps of 96u, up to 480u. The enemy think is off for the walk and always comes back on.
walkOut local.a local.to:{
	if( !( waitthread usable local.a ) ){ end }
	local.a.coop_psqBusy = 1
	local.a.enableEnemy = 0
	local.goal = NIL
	if( waitthread mgLine local.a.origin local.to ){
		local.goal = local.to
	} else {
		local.v = local.to - local.a.origin
		local.v[2] = 0
		local.len = vector_length local.v
		if( local.len > 1 ){
			local.dir = vector_normalize local.v
			for( local.r = 96; local.r <= 480; local.r = local.r + 96 ){
				if( local.r >= local.len ){ break }
				local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.a.origin + ( vector_scale local.dir local.r ) + ( 0 0 40 ) )
				if( local.g == NIL ){ break }
				if( !( waitthread mgLine local.a.origin local.g ) ){ break }
				local.goal = local.g
			}
		}
	}
	if( local.goal == NIL ){
		// no line toward where he was sent: back onto the path network on foot - the point he landed on (tested
		// before the jump), else the nearest squad mate he can walk straight to
		local.sid = local.a.coop_psqSid
		if( level.coop_paraLzN[local.sid] != NIL ){
			local.lz = level.coop_paraLz[local.sid][local.a.coop_psqK]
			if( local.lz != NIL ){
				local.ld = vector_length( local.lz - local.a.origin )
				if( local.ld > 40 && local.ld < 700 ){
					if( waitthread mgLine local.a.origin local.lz ){ local.goal = local.lz }
				}
			}
		}
		if( local.goal == NIL ){
			for( local.k = 1; local.k <= 5; local.k++ ){
				local.m = level.coop_psqM[local.sid][local.k]
				if( local.m == NIL || local.m == NULL || local.m == local.a ){ continue }
				if( !isAlive local.m ){ continue }
				local.md = vector_length( local.m.origin - local.a.origin )
				if( local.md < 80 || local.md > 600 ){ continue }
				if( waitthread mgLine local.a.origin local.m.origin ){ local.goal = local.m.origin; break }
			}
		}
	}
	local.left = 0 - 1
	if( local.goal != NIL ){ local.left = waitthread mgLeg local.a local.goal 1 40 8 }
	if( local.a == NULL ){ end }
	if( isAlive local.a ){
		local.a.enableEnemy = 1
		local.a forceactivate
		waitthread post local.a local.a.origin 200
	}
	local.a.coop_psqBusy = 0
	// no walkable line, or the walk went nowhere: twice in a row and he is LOST - there is no way out of where
	// he stands that this script can find. paradrop.scr's last resort (coop_paradrop_landing_check) reads this.
	if( local.goal == NIL || local.left > 200 ){
		local.a.coop_psqWoFail++
		if( local.a.coop_psqWoFail >= 2 ){
			// ...unless it is the PLACE he was sent to that is off the network, not he
			local.a.coop_psqBusy = 1
			local.net = waitthread onNet local.a
			if( local.a == NULL ){ end }
			local.a.coop_psqBusy = 0
			if( local.net == 1 ){ local.a.coop_psqWoFail = 0 } else { local.a.coop_psqLost = 1 }
		}
	} else {
		local.a.coop_psqWoFail = 0
		local.a.coop_psqLost = 0
	}
	waitthread dbg ( "walkout k=" + local.a.coop_psqK + " goal=" + ( local.goal != NIL ) + " left=" + local.left + " lost=" + local.a.coop_psqLost )
}end
