//[208] HZM coop - CORPSE DESPAWN. Dead AI bodies fade out and are removed after coop_corpseLife seconds
//so the battlefield doesn't pile up with corpses (especially with enemy count-scaling). Threaded once per
//AI death from coop_mod/aihandler.scr::actorHandler. The officer (boss) body is kept. Uses 'remove' (not
//'delete' - butler.scr notes delete can cause issues). cvar coop_corpseLife: seconds before despawn,
//0 = disabled (default 25, set in autoexec.cfg).
//=========================================================================
despawn local.ent:{
//=========================================================================
	if( local.ent == NULL ){ end }
	if( level.coop_officer != NULL && local.ent == level.coop_officer ){ end }	// keep the boss body

	local.life = int( getcvar "coop_corpseLife" )
	if( local.life <= 0 ){ end }		// 0 / unset = disabled

	// wait out the corpse lifetime (1s ticks so we bail cheaply if the body is already gone)
	local.t = 0
	while( local.ent != NULL && local.t < local.life ){
		wait 1
		local.t++
	}
	if( local.ent == NULL ){ end }

	// fade the body out over ~1.3s, then remove it
	local.a = 1.0
	while( local.ent != NULL && local.a > 0.0 ){
		local.a = local.a - 0.075
		if( local.a < 0.0 ){ local.a = 0.0 }
		local.ent alpha local.a
		waitframe
	}
	if( local.ent != NULL ){ local.ent remove }
}end
