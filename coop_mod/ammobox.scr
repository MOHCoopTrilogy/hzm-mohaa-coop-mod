// HZM coop - player-deployable AMMO BOX.
// - Each player may drop ONE box per MATCH. The drop flag lives on the LEVEL keyed by player entnum,
//   so it persists across that player's respawns but resets on map change (= once per match).
// - DROP-ONLY: once placed, a box can NEVER be picked back up (not even by its owner) - the USE
//   action only ever triggers a refill. The crate is a plain notsolid script_model, so the script
//   branch was the ONLY pick-up path; it has been removed (2026-07-05).
// - Each player gets TWO refills per box (live-tunable via cvar coop_ammobox_refills, default 2).
//   Counts are tracked per box + per player on the level: coop_ammobox_uses[boxslot][entnum].
//   entnum = the client slot number (stable for the whole connection, unlike the 1-indexed $player
//   array position, which shifts when someone disconnects). A quick reconnect reuses the slot, so
//   counts survive reconnect-farming - same keying the drop limit (coop_ammobox_dropped) already uses.
// - Deployed via the "Coop Ammo Box" keybind (player.scr dispatch arrayIndex 16).
// Modeled on coop_mod/cover.scr (the sandbag deploy) + the proven ihuddraw per-client HUD pattern.

//=========================================================================
ammobox_place local.player:{
//=========================================================================
	if( level.coop_noDeployables == 1 ){ end }		//HZM coop: map disabled deployables (e.g. t2l2 ride)
	if( local.player == NULL ){ end }
	local.key = local.player.entnum
	if( level.coop_ammobox_dropped[local.key] == 1 ){
		local.player iprint "You have already deployed your ammo box this mission!" 1
		end
	}
	if( local.player.flags["coop_dbno_active"] == 1 ){ end }

	// pick a spot a short distance in front of the player; shorten if a wall is closer (same trace idea
	// as the sandbag deploy, but we don't REQUIRE a wall - an ammo box goes on open floor).
	local.eyepos   = local.player.origin + (0 0 40)
	local.fwd      = angles_toforward local.player.viewangles
	local.traceend = local.eyepos + (local.fwd * 96)
	local.result   = traced (local.eyepos) (local.traceend)
	local.frac     = local.result["fraction"]
	local.dist     = 64
	if( local.frac < 1.0 ){ local.dist = (local.frac * 96) - 24 }
	if( local.dist < 24 ){ local.dist = 24 }

	local.fwdflat = local.fwd
	local.fwdflat[2] = 0
	local.pos = local.player.origin + (local.fwdflat * local.dist)

	local.cang = ( 0 0 0 )
	local.cang[1] = local.player.viewangles[1]

	local.crate = spawn script_model
	local.crate model "models/static/50cal_crate.tik"	// real WW2 wooden ammo crate (stenciled ".50 CAL"). Alts: 30cal_crate / 45cal_crate / miscobj/ammocrate
	local.crate scale 2					// bigger / more visible (user) - tune 1.5..2.5
	local.crate.origin = local.pos
	local.crate.angles = local.cang
	local.crate droptofloor
	local.crate notsolid
	// 3D drop thud from the CRATE so ALL players hear it with distance falloff (not a per-client sound)
	local.crate playsound coop_ammobox_drop

	local.slot = level.coop_ammobox_count
	if( local.slot == NIL ){ local.slot = 0 }
	local.slot++
	level.coop_ammobox_count = local.slot
	level.coop_ammobox_visual[local.slot] = local.crate
	level.coop_ammobox_owner[local.slot]  = local.key	// entnum of the deployer (informational only - a placed box is drop-only, never reclaimable)

	level.coop_ammobox_dropped[local.key] = 1
	local.player iprint "Ammo box deployed - each squadmate can resupply from it twice." 1
}end


// Refill a MODERATE (~half loadout) amount per weapon. Tunable live via cvar coop_ammobox_amount
// (a PERCENT of these base amounts; default 100). All-integer math (no float/string coercion, no %).
//=========================================================================
ammobox_refill local.player:{
//=========================================================================
	if( local.player == NULL ){ end }
	local.pct = int( getcvar( "coop_ammobox_amount" ) )
	if( local.pct <= 0 ){ local.pct = 100 }

	// precompute each amount into a local (the mod's convention - avoids inline expressions as cmd args)
	local.a = int( 20 * local.pct / 100 )
	local.player ammo "rifle" local.a
	local.a = int( 60 * local.pct / 100 )
	local.player ammo "smg" local.a
	local.a = int( 60 * local.pct / 100 )
	local.player ammo "mg" local.a
	local.a = int( 16 * local.pct / 100 )
	local.player ammo "pistol" local.a
	local.a = int( 12 * local.pct / 100 )
	local.player ammo "shotgun" local.a
	local.a = int( 2 * local.pct / 100 )
	local.player ammo "grenade" local.a
	local.a = int( 1 * local.pct / 100 )
	local.player ammo "heavy" local.a
}end


// Per-client HUD: ammo-box availability icon (slot 45) + a 1/0 "available" count (slot 46).
//=========================================================================
ammobox_hud_monitor local.player:{
//=========================================================================
	local.last = 0 - 1

	ihuddraw_virtualsize local.player 45 1
	ihuddraw_align       local.player 45 left bottom
	ihuddraw_shader      local.player 45 "textures/hud/coop_ammobox_icon"
	ihuddraw_rect        local.player 45 76 -62 16 16
	ihuddraw_alpha       local.player 45 1

	ihuddraw_virtualsize local.player 46 1
	ihuddraw_align       local.player 46 left bottom
	ihuddraw_font        local.player 46 "verdana-14"
	ihuddraw_color       local.player 46 1 1 1
	ihuddraw_rect        local.player 46 94 -60 0 0
	ihuddraw_alpha       local.player 46 1

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.key = local.player.entnum
		local.avail = 1
		if( level.coop_ammobox_dropped[local.key] == 1 ){ local.avail = 0 }
		if( local.avail != local.last ){
			ihuddraw_string local.player 46 ("" + local.avail)
			local.last = local.avail
		}
		wait 0.2
	}

	ihuddraw_alpha  local.player 45 0
	ihuddraw_alpha  local.player 46 0
	ihuddraw_string local.player 46 ""
}end


// Per-client proximity + USE interaction: when near a deployed box, show a "[USE] Resupply" hint;
// each USE press refills the player once and bumps their per-box count (max coop_ammobox_refills,
// default 2). At the limit the hint flips to "depleted" and a USE press only shows a deny message.
// A placed box can NEVER be picked back up (drop-only) - there is no owner special case. (slot 47)
//=========================================================================
ammobox_proximity_monitor local.player:{
//=========================================================================
	local.hintstate = 0	// 0 = none, 1 = "[USE] resupply", 2 = "depleted"

	ihuddraw_virtualsize local.player 47 1
	ihuddraw_align       local.player 47 center bottom
	ihuddraw_font        local.player 47 "verdana-14"
	ihuddraw_color       local.player 47 1 1 1
	ihuddraw_rect        local.player 47 0 -36 0 0
	ihuddraw_alpha       local.player 47 0

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.f = 0
		while( local.f < 5 ){
			waitframe
			local.f++
		}
		if( local.player == NULL || local.player.flags["coop_isActive"] != 1 ){ end }

		// nearest deployed box within range
		local.nearslot = NIL
		local.neardist = 96
		if( level.coop_ammobox_count != NIL ){
			local.i = 1
			while( local.i <= level.coop_ammobox_count ){
				local.bx = level.coop_ammobox_visual[local.i]
				if( local.bx != NIL && local.bx != NULL ){
					local.d = vector_length( local.bx.origin - local.player.origin )
					if( local.d < local.neardist ){
						local.neardist = local.d
						local.nearslot = local.i
					}
				}
				local.i++
			}
		}

		if( local.nearslot != NIL ){
			local.key = local.player.entnum

			// this player's refill count on THIS box so far (NIL-safe read - NIL arithmetic poisons expressions)
			local.n = level.coop_ammobox_uses[local.nearslot][local.key]
			if( local.n == NIL ){ local.n = 0 }

			// refills each player gets per box - live-tunable, same recipe as coop_ammobox_amount
			local.maxn = int( getcvar( "coop_ammobox_refills" ) )
			if( local.maxn <= 0 ){ local.maxn = 2 }

			if( local.n >= local.maxn ){
				// this player has exhausted THIS box: deny. No pick-up path exists (drop-only).
				if( local.hintstate != 2 ){
					ihuddraw_string local.player 47 "Ammo box depleted (no resupplies left for you)"
					ihuddraw_alpha  local.player 47 0.55
					local.hintstate = 2
				}
				if( local.player.useheld == 1 ){
					local.msg = ( "No resupply - you already used this ammo box " + local.maxn + " times." )
					local.player iprint local.msg 1
					// consume the hold so the deny message doesn't repeat every poll
					while( local.player != NULL && local.player.useheld == 1 ){ waitframe }
				}
			} else {
				if( local.hintstate != 1 ){
					ihuddraw_string local.player 47 "[USE] Resupply ammo"
					ihuddraw_alpha  local.player 47 0.85
					local.hintstate = 1
				}
				if( local.player.useheld == 1 ){
					waitthread ammobox_refill local.player
					local.n++
					level.coop_ammobox_uses[local.nearslot][local.key] = local.n
					local.player playsound coop_sandbag_place
					local.msg = ( "Ammo resupplied! (" + local.n + " of " + local.maxn + ")" )
					local.player iprint local.msg 1
					// [302] HZM XP - +10 to the box OWNER when a TEAMMATE resupplies (max 7/map)
					local.oen = level.coop_ammobox_owner[local.nearslot]
					if( local.oen != NIL && local.oen != local.player.entnum ){
						if( level.coop_xp_boxpay == NIL ){ level.coop_xp_boxpay = 0 }
						if( level.coop_xp_boxpay < 7 ){
							local.bi = 1
							while( local.bi <= $player.size ){
								if( $player[local.bi] != NULL && $player[local.bi].entnum == local.oen ){
									level.coop_xp_boxpay = level.coop_xp_boxpay + 1
									thread coop_mod/xp.scr::xp_award $player[local.bi] 10 "support"
									break
								}
								local.bi++
							}
						}
					}
					if( local.n >= local.maxn ){
						ihuddraw_string local.player 47 "Ammo box depleted (no resupplies left for you)"
						ihuddraw_alpha  local.player 47 0.55
						local.hintstate = 2
					}
					// consume the hold: ONE press = ONE refill (a held USE must not chain refills)
					while( local.player != NULL && local.player.useheld == 1 ){ waitframe }
				}
			}
		} else {
			if( local.hintstate != 0 ){
				ihuddraw_alpha local.player 47 0
				local.hintstate = 0
			}
		}
	}

	ihuddraw_alpha local.player 47 0
}end
