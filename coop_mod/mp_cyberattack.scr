//=========================================================================
// MP_CYBERATTACK.SCR - CYBER ATTACK, an MP game MODE. This LOADS the real UberMod v8 Cyber Attack
// (ubermode/cybersnd.scr) via the shared loader core coop_mod/mp_cybersnd.scr - it is NOT a
// reimplementation. Cyber Attack is UberMod's attack/defend bomb variant (one team carries the bomb
// from a central spawn to the enemy's bombsite); it shares the mode script with Search & Destroy and
// differs only in the g_ubergametype selector ("cyb") and the authored per-map bomb data. Added [user
// 2026-09-16, "Import both, real mod"] as the fourth genuine UberMod mode (with bb/snd/ft) - it was
// previously missing entirely. See mp_cybersnd.scr for the full design + coop-safety notes.
//
// This is an MP file (coop_mod/mp*.scr in MP_MANIFEST), guarded end to end by level.coop_mpRun, which
// ONLY coop_mod/mp.scr sets and which a level load wipes - so nothing here can run on a coop map.
// mp.scr dispatches through its seam (a switch on level.coop_mpMode):
//     mp.scr::mp_modeInit    -> mode_init   (pre-spawn: hand off to the shared loader with mode "cyb")
//     mp.scr::mp_modeGiveKit -> mode_onSpawn (no-op: the real mod owns the player, so no armory kit)
//     mp.scr::mp_modeTick    -> mode_think   (no-op)
//     mp.scr::mp_modeOnDeath -> mode_onDeath (no-op)
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end


//Liveness probe (TRAPS T1).
alive:{
	end 1
}end


//isOn guard.
isOn:{
	if( level.coop_mpRun != 1 ){ end 0 }
	if( level.coop_mpMode != "cyberattack" ){ end 0 }
	end 1
}end


//PRE-SPAWN INIT - load the real UberMod Cyber Attack for this map.
mode_init:{
	if( level.coop_mpRun != 1 ){ end }
	waitthread coop_mod/mp_cybersnd.scr::mode_init "cyb"
}end


//SPAWN / THINK / DEATH EDGES - no-ops. The real mod (ubermode/cybersnd.scr) owns the player end to end.
mode_onSpawn local.p:{
	end
}end


mode_think local.p:{
	end
}end


mode_onDeath local.p:{
	end
}end
