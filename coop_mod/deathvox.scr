//=========================================================================
// HZM coop - varied DEATH VOICES (+ native-VO mute for AI).
//
// play <ent> [muteNative]:
//   Plays one random grunt from the "Death Sounds Reborn" pool (334 aliases, HUMAN deaths only
//   coop_deathvox1..334 in ubersound/coop_deathvox.scr, files in sound/coop_deathvox/)
//   on <ent>, on CHAN_AUTO. If muteNative==1 (AI deaths), it also silences the actor's
//   native German/Italian death VO (voice/dialog channels) for a short window so ONLY the
//   varied pool is heard. Players call it without muteNative (they have no native death VO).
//
// Called from coop_mod/aihandler.scr (every AI death, muteNative=1) and
// coop_mod/player.scr::manageDead (every player death).
//=========================================================================
play local.ent local.muteNative:{
//=========================================================================
	if( local.ent == NULL ){ end }

	// random 1..334 inline (matches the proven officer.scr pattern; a variable randomint arg / NIL
	// level var was producing a NIL alias -> "Sound: NIL needs an alias" -> no death sound).
	local.alias = "coop_deathvox" + ( ( randomint 334 ) + 1 )
	local.ent playsound local.alias		// CHAN_AUTO (per the alias) - survives the native-VO mute below

	if( local.muteNative == 1 ){
		thread coop_mod/deathvox.scr::muteNativeVO local.ent
	}
}end

//=========================================================================
// Silence the actor's native death VO. It is triggered from the death animation a moment after
// death, so we stop the voice/dialog channels every frame for ~1s to catch it whenever it fires.
// CHAN_VOICE=4, CHAN_DIALOG_SECONDARY=7, CHAN_DIALOG=8 (the new pool is on CHAN_AUTO=0, untouched).
//=========================================================================
muteNativeVO local.ent:{
//=========================================================================
	if( local.ent == NULL ){ end }
	local.endt = level.time + 1.0
	while( local.ent != NULL && level.time < local.endt ){
		local.ent stopsound 4
		local.ent stopsound 7
		local.ent stopsound 8
		waitframe
	}
}end
