//=========================================================================
// HZM coop - varied DEATH VOICES (+ native-VO mute for AI).
//
// play <ent> [muteNative]:
//   Plays one random grunt from the "Death Sounds Reborn" pool (334 aliases, HUMAN deaths only
//   coop_deathvox1..334 in ubersound/coop_deathvox.scr, files in sound/coop_deathvox/)
//   on <ent>, on CHAN_AUTO. If muteNative==1 (AI deaths), it also silences the actor's
//   native German/Italian death VO (voice/dialog channels) for a short window so ONLY the
//   varied pool is heard. Players call it without muteNative (they have no native death VO).
//
// Called from coop_mod/aihandler.scr (every AI death, muteNative=1) and
// coop_mod/player.scr::manageDead (every player death).
//=========================================================================
play local.ent local.muteNative:{
//=========================================================================
	if( local.ent == NULL ){ end }

	// HZM coop - PROXIMITY GATE (2026-07-03): only play the varied grunt (+ mute native VO) if a player is
	// within coop_deathvox_range (default 1500u) of the dying entity. Off-screen / distant AI deaths
	// (reinforcements, friendly-fire, scripted set-pieces) then keep their quieter native German death cry
	// instead of broadcasting a "random" grunt across the map. A dying PLAYER is distance 0 to itself, so its
	// own death grunt always plays. Range is a live cvar so it can be tuned without a rebuild.
	local.range = 1500
	if( getcvar( "coop_deathvox_range" ) != "" ){ local.range = float( getcvar( "coop_deathvox_range" ) ) }
	// HZM coop - DISTANCE BANDS (2026-07-04): find the closest player and pick by band -
	// near = full grunt pool, mid = muffled distant scream (coop_deathvoxfar pool), beyond
	// coop_deathvox_farRange = native VO only (old behavior past the gate).
	local.farRange = 3500
	if( getcvar( "coop_deathvox_farRange" ) != "" ){ local.farRange = float( getcvar( "coop_deathvox_farRange" ) ) }
	local.mindist = 999999
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){
			local.d = vector_length( $player[local.i].origin - local.ent.origin )
			if( local.d < local.mindist ){ local.mindist = local.d }
		}
		local.i++
	}
	if( local.mindist > local.farRange ){ end }
	if( local.mindist > local.range ){
		// FAR BAND: faint muffled scream, native VO muted so the two do not stack
		local.alias = "coop_deathvoxfar" + ( ( randomint 16 ) + 1 )
		local.ent playsound local.alias
		if( local.muteNative == 1 ){
			thread coop_mod/deathvox.scr::muteNativeVO local.ent
		}
		end
	}

	// random 1..484 inline (matches the proven officer.scr pattern; a variable randomint arg / NIL
	// level var was producing a NIL alias -> "Sound: NIL needs an alias" -> no death sound).
	//[user 07-13] 334 Death Sounds Reborn + 150 MOH Frontline efforts (dv_335..dv_484)
	local.alias = "coop_deathvox" + ( ( randomint 484 ) + 1 )
	local.ent playsound local.alias		// CHAN_AUTO (per the alias) - survives the native-VO mute below

	if( local.muteNative == 1 ){
		thread coop_mod/deathvox.scr::muteNativeVO local.ent
	}
}end

//=========================================================================
// Silence the actor's native death VO. It is triggered from the death animation a moment after
// death, so we stop the voice/dialog channels every frame for ~1s to catch it whenever it fires.
// CHAN_VOICE=4, CHAN_DIALOG_SECONDARY=7, CHAN_DIALOG=8 (the new pool is on CHAN_AUTO=0, untouched).
//=========================================================================
muteNativeVO local.ent:{
//=========================================================================
	if( local.ent == NULL ){ end }
	local.endt = level.time + 1.0
	while( local.ent != NULL && level.time < local.endt ){
		local.ent stopsound 4
		local.ent stopsound 7
		local.ent stopsound 8
		waitframe
	}
}end
