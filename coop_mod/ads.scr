// HZM coop - AIM DOWN SIGHTS support (per-player), dedicated ADS button (RMB by default).
//
// The ADS VISUALS are engine-side (gun-raise + zoom + weapon-fov/near-clip in cgame/renderer). This
// per-player loop only handles the MOVEMENT SLOWDOWN: while the ADS button is HELD (the engine exposes
// it as player.coopadsheld, decoupled from secondary-fire/bash), the player moves a lot slower so aiming
// is deliberate. moveSpeedScale is a SETTER PROPERTY (not a
// command) - use "local.player.moveSpeedScale = <mult>" (it sets the default speed multiplier slot;
// 1.0 = normal). Started per spawn from player.scr::manageAliveSpawning.
//
// Tunable: edit the 0.4 below (fraction of normal speed while aiming; lower = slower).
//=========================================================================
coop_ads_monitor local.player:{
//=========================================================================
	if( local.player == NULL ){ end }
	local.slow = 0
	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		// dead/downed players move normally (no ADS slowdown)
		if( !isAlive local.player || local.player.flags["coop_dbno_active"] == 1 ){
			if( local.slow == 1 ){ local.player.moveSpeedScale = 1; local.slow = 0 }
			wait 0.2
			continue
		}
		if( local.player.coopadsheld == 1 ){
			// ADS button held -> aim -> move a lot slower (set once on transition)
			if( local.slow == 0 ){
				local.player.moveSpeedScale = 0.3
				local.slow = 1
			}
		} else {
			// ADS released -> normal speed
			if( local.slow == 1 ){
				local.player.moveSpeedScale = 1
				local.slow = 0
			}
		}
		waitframe
	}
	if( local.slow == 1 && local.player != NULL ){ local.player.moveSpeedScale = 1 }
}end
