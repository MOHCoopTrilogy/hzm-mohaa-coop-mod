//[bug-2770] Has this player MASTERED local.base (its per-weapon bit set in the carried mastered set)?
//A weapon with no variant / no index is UNGATED (returns 1) - nothing to gate. Mirrors coop's
//loadout_finMastered: a finish variant only shows on a gun you have mastered. Mastery is earned by
//per-weapon kills (mp_progression.scr::credit) and persists in the v3 blob (coop_mpMasterStr).
mpfin_mastered local.p local.base:{
	if( local.p == NULL ){ end 0 }
	waitthread mpfin_init
	local.idx = level.coop_mpFinIdx[local.base]
	if( local.idx == NIL ){ end 1 }
	local.str = local.p.flags["coop_mpMasterStr"]
	if( local.str == NIL || local.str == "" ){ end 0 }
	if( local.idx >= local.str.size ){ end 0 }
	if( local.str[local.idx] == "1" ){ end 1 }
}end 0

//[killchal-next 2026-10-20] PER-GUN FINISHES. How many kills this player has with the gun at index local.idx.
mpfin_count local.p local.idx:{
	local.c = local.p.flags[( "coop_mpGC" + local.idx )]
	if( local.c == NIL ){ local.c = 0 }
}end local.c

//Kills the gun at local.idx needs for finish number local.fid (1 gold .. 7 desert): the standard ladder, or the slow one for launchers.
mpfin_need local.idx local.fid:{
	waitthread mpfin_init
	local.n = level.coop_mpFinNeed[local.fid]
	if( level.coop_mpFinSlow[local.idx] == 1 ){ local.n = level.coop_mpFinNeedSlow[local.fid] }
	if( local.n == NIL ){ local.n = 0 }
}end local.n

//Is finish local.fin (gold, chrome ...) OPEN on gun local.base for this player? Yes when the gun's own kill count reached the rung, or when the
//LEGACY snapshot (coop_mpFinLeg: the finishes the player held when per-gun ladders began, set once in mp_progression.scr::mpfin_snapshot) has the
//finish AND the gun is mastered (the old rule, kept so nothing earned is re-locked). A base with no finish index is ungated.
mpfin_open local.p local.base local.fin:{
	if( local.p == NULL ){ end 0 }
	waitthread mpfin_init
	local.idx = level.coop_mpFinIdx[local.base]
	if( local.idx == NIL ){ end 1 }
	local.fid = level.coop_mpFinNo[local.fin]
	if( local.fid == NIL ){ end 0 }
	local.need = waitthread mpfin_need local.idx local.fid
	local.cnt = waitthread mpfin_count local.p local.idx
	if( local.need > 0 && local.cnt >= local.need ){ end 1 }
	local.leg = local.p.flags["coop_mpFinLeg"]
	if( local.leg != NIL ){
		if( local.leg.size >= local.fid ){
			if( local.leg[( local.fid - 1 )] == "1" ){
				local.m = waitthread mpfin_mastered local.p local.base
				if( local.m == 1 ){ end 1 }
			}
		}
	}
}end 0

//Is finish local.fin open on ANY gun of this player's? (the MP pick is one finish for the whole kit; resolve() decides per gun at spawn)
mpfin_openAny local.p local.fin:{
	if( local.p == NULL ){ end 0 }
	waitthread mpfin_init
	for( local.i = 0; local.i < level.coop_mpFinIdxN; local.i++ ){
		local.b = level.coop_mpFinBaseOf[local.i]
		if( local.b != NIL ){
			local.o = waitthread mpfin_open local.p local.b local.fin
			if( local.o == 1 ){ end 1 }
		}
	}
}end 0

//"37 / 100 MP40 kills" - this gun's progress toward finish local.fin.
mpfin_prog local.p local.base local.fin:{
	local.t = ""
	if( local.p == NULL ){ end local.t }
	waitthread mpfin_init
	local.idx = level.coop_mpFinIdx[local.base]
	local.fid = level.coop_mpFinNo[local.fin]
	if( local.idx == NIL || local.fid == NIL ){ end local.t }
	local.need = waitthread mpfin_need local.idx local.fid
	local.cnt = waitthread mpfin_count local.p local.idx
	if( local.cnt > local.need ){ local.cnt = local.need }
	local.t = ( "" + local.cnt + " / " + local.need + " " + level.coop_mpFinName[local.idx] + " kills" )
}end local.t

//The progress line of the player's MOST-used gun toward finish local.fin (the refusal text of a locked pick).
mpfin_best local.p local.fin:{
	local.t = ""
	if( local.p == NULL ){ end local.t }
	waitthread mpfin_init
	local.bi = 0
	local.bc = -1
	for( local.i = 0; local.i < level.coop_mpFinIdxN; local.i++ ){
		local.c = waitthread mpfin_count local.p local.i
		if( local.c > local.bc ){ local.bc = local.c; local.bi = local.i }
	}
	local.bb = level.coop_mpFinBaseOf[local.bi]
	if( local.bb == NIL ){ end local.t }
	local.t = waitthread mpfin_prog local.p local.bb local.fin
}end local.t

//Called by mp_progression.scr::credit after a gun's count went up: a rung reached = a finish just opened on this gun.
mpfin_crossed local.p local.idx local.cnt:{
	if( local.p == NULL ){ end }
	for( local.f = 1; local.f <= 7; local.f++ ){
		local.n = waitthread mpfin_need local.idx local.f
		if( local.n > 0 && local.n == local.cnt ){
			local.p iprint ( level.coop_mpFinName[local.idx] + ": " + level.coop_mpFinLabel[local.f] + " finish unlocked (" + local.cnt + " kills)" ) 1
		}
	}
}end

//Resolve a weapon give to its finish variant IF the player has earned + picked that finish AND has
//MASTERED that specific weapon (bug-2770). Returns the variant tik, or the base unchanged. The pick is
//the server flag coop_mpFinSel; finUnlocked re-checks the finish is earned; mpfin_mastered gates per-gun.
resolve local.p local.base:{
	local.out = local.base
	if( local.p == NULL || local.base == NIL || local.base == "" ){ end local.out }
	if( level.coop_mpRun != 1 ){ end local.out }
	waitthread mpfin_init
	local.fin = local.p.flags["coop_mpFinSel"]
	if( local.fin == NIL || local.fin == "" ){ end local.out }
	local.fo = waitthread mpfin_open local.p local.base local.fin
	if( local.fo != 1 ){ end local.out }
	local.var = level.coop_mpFinVar[( local.base + "|" + local.fin )]
	if( local.var != NIL && local.var != "" ){ local.out = local.var }
}end local.out
