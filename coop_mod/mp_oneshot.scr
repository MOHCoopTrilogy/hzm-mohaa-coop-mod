//=========================================================================
// MP_ONESHOT.SCR - the ONE-SHOT KILL (instagib) modifier (user 2026-09-16). A host toggle
// (coop_mpOneShot 0/1) that composes on TOP of every MP game mode - a modifier row, like Hardcore and the
// weapon presets, not a mode of its own. One effect: on the spawn edge every player's health (and max) is
// pinned to 1, so ANY hit from ANY weapon is lethal. It stacks with every mode and with Hardcore.
//
// WHY HEALTH=1 (and not a damage hook): `health <n>` also writes max_health (entity.cpp:1938 - the same
// behaviour mp.scr's header and mp_hardcore.scr document), and it lives on the shared spawn edge, so it is
// the one lever that makes one hit lethal for EVERY weapon (even a single pistol tap ~20 dmg) on EVERY mode
// with no per-weapon table and no engine change. Trade-off: fall/other environmental damage is also lethal
// at 1 hp - acceptable for an instagib rule (and the spawn-protection invulnerable window still applies).
//
// This is an MP file (coop_mod/mp*.scr is in MP_MANIFEST), guarded end to end by level.coop_mpRun, which
// ONLY coop_mod/mp.scr sets and which a level load wipes - so NOTHING here can run on a coop map.
// mp.scr::mp_onSpawn calls ::onSpawn on the shared spawn edge, AFTER the kit give and AFTER Hardcore's
// half-health, so one-shot wins when both are on.
//
// ISOLATION: reads only the MP-owned host toggle coop_mpOneShot (coop_mp*, isolation clause 12c); sets
// health PER PLAYER, never a cvar, so it cannot follow anyone into coop (clause 4); names no coop cvar,
// coop_lo, ui/loadout or coop_mod-only path; calls no coop code; never giveInventory / changeGameType / the
// coop_health cvar.
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main. Kept so an accidental exec is a no-op.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end


//Liveness probe (TRAPS T1, mirrors mp_hardcore.scr::alive). If this file parse-kills, ::onSpawn is
//unreachable and the modifier simply stays off - nobody is pinned to 1 hp, health is stock.
alive:{
	end 1
}end


//Is the host toggle ON? coop_mpOneShot is MP-owned and read-only here. "" (never registered) or "0" -> off.
//int() is computed into a local BEFORE end - a function call in the `}end <expr>` return position is NOT
//evaluated by this engine (bug-2603, TRAPS T1), so never put one there. Returns 1/0.
isOn:{
	local.s = getcvar( "coop_mpOneShot" )
	if( local.s == "" ){ local.s = "0" }
	local.v = int( local.s )
	if( local.v != 0 ){ local.v = 1 }
}end local.v


//SPAWN EDGE - PIN HEALTH TO 1. Called from mp.scr::mp_onSpawn AFTER the kit give (which set health 100) and
//AFTER mp_hardcore.scr::onSpawn (which may have set 50), so this OVERRIDES both to 1 when One-Shot is on.
//PER PLAYER, never a cvar. Composes with every mode because it lives on the shared spawn edge.
onSpawn local.p:{
	if( local.p == NULL ){ end }
	local.os = waitthread isOn
	if( local.os != 1 ){ end }
	local.p health 1
	println( "^~^~^ MPOS oneshot e" + local.p.entnum + " hp=1" )
}end
