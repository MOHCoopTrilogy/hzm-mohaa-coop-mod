//========================================================================================
// HZM Coop - BUILD MODE (dev tool). Full docs: _research/build_mode.md
// Allied-actor + animation extension: _research/build_actor_anims.md (coop_mod/buildmode_actors.scr).
//
// In-game object placement for map development: browse a catalog of ~300 stock models
// (coop_mod/buildmode_catalog.scr) PLUS 76 allied player actors with a selectable, prop-bearing
// idle animation (buildmode_actors.scr), preview the current model as a translucent ghost at
// the aim point, place / rotate / scale / remove real script_models live, with the AI
// ignoring the builder (notarget + nodamage, developer.scr recipe). Every placement is
// captured to coop_mod/save/build_<map>.dat (homepath) in ready-to-paste script form and
// mirrored to the console as machine-parseable ^~^~^ BUILD_ lines.
//
// ACTIVATION (listen server host, requires coop_dev 1):
//   exec coop_mod/cfg/buildmode.cfg      - binds numpad, seta coop_build_boot 1, coop_build 1
//   (first-ever use: restart the map afterwards so main.scr threads the monitor;
//    coop_build_boot is archived, so every later map is armed automatically)
//   exec coop_mod/cfg/buildmode_stop.cfg - coop_build 0 + unbind (placements/file kept)
//
// WIRING - one line in main.scr next to the coop_maptest hooks (applied by the operator):
//   if( getcvar( "coop_build_boot" ) == "1" ){ thread coop_mod/buildmode.scr::coop_build_monitor }
//
// CONTROL BUS: the cfg binds every key to  set coop_build_cmd <action> ; the session loop
// polls the cvar each frame, executes the action and clears it (cvar bus, same idea as
// the coop_maptest cvars). Listen-server only: a client "set" writes the shared cvar
// table only when client and server are the same process.
//
// HUD: ihuddraw slots 54-59 (verified free 2026-07-07: 31-39 dbno/medkit, 40-47
// cover/ammobox, 50-53 officer, 60 weather, 62-69 xp; 54-59 were only PENCILED for the
// unbuilt lobby plan - if the lobby lands later, move one of the two).
//========================================================================================


// Threaded from main.scr at map init when coop_build_boot == "1". Idles cheaply until
// coop_build == 1 AND coop_dev == 1 and a host player is active, then runs the session.
//=========================================================================
coop_build_monitor:{
//=========================================================================
	if( level.coop_build_monitorOn == 1 ){ end }
	level.coop_build_monitorOn = 1

	waitthread coop_mod/main.scr::waitForMainScript
	waitthread coop_mod/buildmode_catalog.scr::catalog_init
	waitthread coop_mod/buildmode_actors.scr::actor_catalog_init		//HZM coop BUILD MODE: append the ALLIED ACTORS category + anim catalog
	waitthread coop_mod/buildmode_sounds.scr::sound_catalog_init		//HZM coop BUILD MODE: parallel SOUND-emitter catalog (SOUND mode)
	waitthread coop_mod/blueprint.scr::bp_catalogRefresh		//HZM coop BLUEPRINT: append saved templates to STRUCTURES (bp_index.dat)

	while( 1 ){
		if( getcvar( "coop_build" ) == "1" ){
			if( int( getcvar( "coop_dev" ) ) != 1 ){
				if( level.coop_build_devWarned != 1 ){
					level.coop_build_devWarned = 1
					println "^~^~^ BUILD_BLOCKED coop_dev is not 1 - build mode is dev-gated"
				}
			}else{
				local.player = waitthread coop_build_findHost
				if( local.player != NIL && local.player != NULL ){
					waitthread coop_build_session local.player
				}
			}
		}
		wait 0.5
	}
}end


// Returns the active host player (entnum 0 -> flags["coop_isHost"], set in player.scr),
// or NIL when none is connected/active yet.
//=========================================================================
coop_build_findHost:{
//=========================================================================
	local.found = NIL
	local.i = 1
	while( local.i <= $player.size ){
		if( local.found == NIL && $player[local.i] != NULL ){
			if( $player[local.i].flags["coop_isHost"] == 1 && $player[local.i].flags["coop_isActive"] == 1 ){
				local.found = $player[local.i]
			}
		}
		local.i++
	}
}end local.found


// One build session: runs while coop_build == 1 and the builder stays valid.
//=========================================================================
coop_build_session local.player:{
//=========================================================================
	level.coop_build_active = 1
	level.coop_build_hudDirty = 1

	// [user 07-09] keep the build HUD (slots 54-61) FULLY visible - the activity HUD-fade multiplies every
	// ihuddraw element's alpha (build slots are < 100 so they are NOT in the lobby fade-exemption). Build mode
	// is host-only (listen server), so the shared cvar reaches cgame directly. Restored on exit.
	if( level.coop_build_prevHudFade == NIL ){ level.coop_build_prevHudFade = getcvar "coop_hudFade" }
	setcvar "coop_hudFade" "0"

	// [user 07-09] build mode: banish the officer boss + guards/waves so building is undisturbed.
	// Spawning is also gated on coop_build in officer.scr; this clears anyone already in the world.
	thread coop_mod/officer.scr::coop_officer_buildSuppress

	// state defaults (persist across sessions within one map; level vars clear on map change)
	if( level.coop_build_cat == NIL ){ level.coop_build_cat = 1 }
	if( level.coop_build_idx == NIL ){ level.coop_build_idx = 1 }
	if( level.coop_build_count == NIL ){ level.coop_build_count = 0 }
	if( level.coop_build_scale == NIL ){ level.coop_build_scale = 1.0 }
	if( level.coop_build_zofs == NIL ){ level.coop_build_zofs = 0 }
	if( level.coop_build_dist == NIL ){ level.coop_build_dist = 0 }		//HZM coop BUILD MODE: aim-ray push/pull offset (units; -=closer, +=farther)
	// SOUND-mode state (parallel to the model/actor state; '\' toggles level.coop_build_mode)
	if( level.coop_build_mode == NIL ){ level.coop_build_mode = "object" }
	if( level.coop_build_sndcat == NIL ){ level.coop_build_sndcat = 1 }
	if( level.coop_build_sndidx == NIL ){ level.coop_build_sndidx = 1 }
	if( level.coop_build_sndvol == NIL ){ level.coop_build_sndvol = 1.0 }
	if( level.coop_build_sndmin == NIL ){ level.coop_build_sndmin = 200 }
	if( level.coop_build_sndtype == NIL ){ level.coop_build_sndtype = "loop" }
	if( level.coop_build_sndcount == NIL ){ level.coop_build_sndcount = 0 }
	if( level.coop_build_pitch == NIL ){ level.coop_build_pitch = 0 }
	if( level.coop_build_solid == NIL ){ level.coop_build_solid = 0 }
	if( level.coop_build_yaw == NIL ){ level.coop_build_yaw = int( local.player.viewangles[1] ) }
	if( level.coop_build_animIdx == NIL ){ level.coop_build_animIdx = 1 }		//HZM coop BUILD MODE: selected actor animation (actor category only)
	if( level.coop_build_snap == NIL ){ level.coop_build_snap = 0 }		//HZM coop BLUEPRINT: grid snap (x/y block grid + 45 deg yaw), SEMICOLON toggles
	if( level.coop_build_name == NIL ){ level.coop_build_name = "" }	//[user 07-21] first HUD paint can beat the first ghost spawn - NIL here concat-killed the paint thread (qconsole 18:36:23)

	// capture file: continue any existing capture for this map (never clobber old sessions)
	level.coop_build_file = "coop_mod/save/build_" + level.coop_mapname + ".dat"
	if( level.coop_build_basetext == NIL ){
		local.prev = fs_read_content ( level.coop_build_file )
		if( local.prev == NIL || local.prev == "" ){
			level.coop_build_basetext = "// HZM coop BUILD MODE capture for map " + level.coop_mapname + "\n// paste-ready script blocks; bake recipe in _research/build_mode.md\n\n"
		}else{
			level.coop_build_basetext = local.prev
		}
	}

	// protect the builder so the AI never engages (developer.scr recipe: notarget event +
	// scripted god via nodamage - the "god" console cmd is cheat-gated, the event path is not)
	local.player notarget 1
	local.player nodamage

	setcvar "coop_build_cmd" ""
	local.player iprint "BUILD MODE: ON (numpad controls)" 1
	println( "^~^~^ BUILD_ON " + level.coop_mapname )
	println "^~^~^ BUILD_HELP KP4/KP6 model, KP1/KP3 category, [ / ] anim (ALLIED ACTORS cat), KP7/KP9 yaw -/+15, KP_SLASH/KP_STAR pitch -/+15, KP8/KP2 raise/lower, , / . closer/farther, KP_PLUS/KP_MINUS scale, KP5 reset, KP0 solid toggle, KP_ENTER place, KP_DEL undo, SEMICOLON snap, ' bpmark; console: set coop_build_bpname <n> + coop_build_cmd bpsave / bpremove"

	thread coop_build_hud local.player
	waitthread coop_build_ghostRefresh local.player

	while( getcvar( "coop_build" ) == "1" && local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.cmd = getcvar( "coop_build_cmd" )
		if( local.cmd != "" ){
			setcvar "coop_build_cmd" ""
			waitthread coop_build_doCmd local.player local.cmd
		}
		waitthread coop_build_ghostFollow local.player
		waitframe
	}

	// exit: drop the ghost, restore the builder (placed objects + capture file are kept)
	if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){ level.coop_build_ghost delete }
	level.coop_build_ghost = NIL
	level.coop_build_active = 0
	// [user 07-09] restore the HUD-fade setting the builder had before build mode
	if( level.coop_build_prevHudFade != NIL ){
		setcvar "coop_hudFade" level.coop_build_prevHudFade
		level.coop_build_prevHudFade = NIL
	}
	if( local.player != NULL ){
		local.player notarget 0
		local.player takedamage
		local.player iprint "BUILD MODE: OFF" 1
	}
	println( "^~^~^ BUILD_OFF placed " + level.coop_build_count )
}end


// Dispatch one control-bus action.
//=========================================================================
coop_build_doCmd local.player local.cmd:{
//=========================================================================
	// [user 07-09] SOUND mode: '\' toggles object<->sound; when in sound mode the whole numpad bus
	// is reinterpreted by buildmode_sounds.scr::coop_snd_doCmd (see that file's header for the map).
	if( local.cmd == "modeswap" ){
		if( level.coop_build_mode == "sound" ){ level.coop_build_mode = "object" }
		else{
			level.coop_build_mode = "sound"
			waitthread coop_mod/buildmode_sounds.scr::coop_snd_loadDefaults
		}
		waitthread coop_build_ghostRefresh local.player
		local.player iprint ( "BUILD MODE: " + level.coop_build_mode ) 1
		level.coop_build_hudDirty = 1
		end
	}
	if( level.coop_build_mode == "sound" ){
		waitthread coop_mod/buildmode_sounds.scr::coop_snd_doCmd local.player local.cmd
		level.coop_build_hudDirty = 1
		end
	}
	if( local.cmd == "next" ){
		level.coop_build_idx++
		if( level.coop_build_idx > level.coop_build_itemcount[level.coop_build_cat] ){ level.coop_build_idx = 1 }
		waitthread coop_build_ghostRefresh local.player
	}
	else if( local.cmd == "prev" ){
		level.coop_build_idx--
		if( level.coop_build_idx < 1 ){ level.coop_build_idx = level.coop_build_itemcount[level.coop_build_cat] }
		waitthread coop_build_ghostRefresh local.player
	}
	else if( local.cmd == "catnext" ){
		level.coop_build_cat++
		if( level.coop_build_cat > level.coop_build_catcount ){ level.coop_build_cat = 1 }
		level.coop_build_idx = 1
		// [user 07-18] COVER categories (COVER OBJECTS + 1936 COVER) default to SOLID (they exist to build working cover)
		if( level.coop_build_catIsCover[level.coop_build_cat] == 1 ){ level.coop_build_solid = 1 }
		waitthread coop_build_ghostRefresh local.player
		local.player iprint ( "CAT " + level.coop_build_cat + "/" + level.coop_build_catcount + ":  " + level.coop_build_catname[level.coop_build_cat] ) 1
	}
	else if( local.cmd == "catprev" ){
		level.coop_build_cat--
		if( level.coop_build_cat < 1 ){ level.coop_build_cat = level.coop_build_catcount }
		level.coop_build_idx = 1
		if( level.coop_build_catIsCover[level.coop_build_cat] == 1 ){ level.coop_build_solid = 1 }
		waitthread coop_build_ghostRefresh local.player
		local.player iprint ( "CAT " + level.coop_build_cat + "/" + level.coop_build_catcount + ":  " + level.coop_build_catname[level.coop_build_cat] ) 1
	}
	else if( local.cmd == "yawplus" ){
		local.step = 15
		if( level.coop_build_snap == 1 ){ local.step = 45 }		//HZM coop BLUEPRINT: 45 deg steps while snapped
		level.coop_build_yaw = level.coop_build_yaw + local.step
		if( level.coop_build_yaw >= 360 ){ level.coop_build_yaw = level.coop_build_yaw - 360 }
	}
	else if( local.cmd == "yawminus" ){
		local.step = 15
		if( level.coop_build_snap == 1 ){ local.step = 45 }
		level.coop_build_yaw = level.coop_build_yaw - local.step
		if( level.coop_build_yaw < 0 ){ level.coop_build_yaw = level.coop_build_yaw + 360 }
	}
	else if( local.cmd == "pitchplus" ){
		level.coop_build_pitch = level.coop_build_pitch + 15
		if( level.coop_build_pitch >= 360 ){ level.coop_build_pitch = level.coop_build_pitch - 360 }
	}
	else if( local.cmd == "pitchminus" ){
		level.coop_build_pitch = level.coop_build_pitch - 15
		if( level.coop_build_pitch < 0 ){ level.coop_build_pitch = level.coop_build_pitch + 360 }
	}
	else if( local.cmd == "up" ){
		level.coop_build_zofs = level.coop_build_zofs + 2
		if( level.coop_build_zofs > 256 ){ level.coop_build_zofs = 256 }
	}
	else if( local.cmd == "down" ){
		level.coop_build_zofs = level.coop_build_zofs - 2
		if( level.coop_build_zofs < -64 ){ level.coop_build_zofs = -64 }
	}
	else if( local.cmd == "closer" ){
		level.coop_build_dist = level.coop_build_dist - 16
		if( level.coop_build_dist < -256 ){ level.coop_build_dist = -256 }
	}
	else if( local.cmd == "farther" ){
		level.coop_build_dist = level.coop_build_dist + 16
		if( level.coop_build_dist > 1024 ){ level.coop_build_dist = 1024 }
	}
	else if( local.cmd == "scaleup" ){
		level.coop_build_scale = waitthread coop_build_round1 ( level.coop_build_scale + 0.1 )
		//[user 07-17] cap raised 5.0 -> 8.0 so GEOMETRY boxes reach FULL STANDING COVER: the unit cube is
		// ~16u at scale 1, so 3.0 = ~48u crouch cover, 4.0 = ~64u chest-high (the baked map crates), and
		// 6.0-8.0 = 96-128u full standing cover / walls. Cover mechanics are trace-based vs solid bbox,
		// so a SOLID-placed box works with lean/blindfire/low-cover at the right height.
		if( level.coop_build_scale > 8.0 ){ level.coop_build_scale = 8.0 }
		if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){ level.coop_build_ghost scale level.coop_build_scale }
	}
	else if( local.cmd == "scaledown" ){
		level.coop_build_scale = waitthread coop_build_round1 ( level.coop_build_scale - 0.1 )
		if( level.coop_build_scale < 0.1 ){ level.coop_build_scale = 0.1 }
		if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){ level.coop_build_ghost scale level.coop_build_scale }
	}
	else if( local.cmd == "reset" ){
		level.coop_build_yaw = int( local.player.viewangles[1] )
		level.coop_build_pitch = 0
		level.coop_build_zofs = 0
		level.coop_build_dist = 0
		level.coop_build_scale = 1.0
		if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){ level.coop_build_ghost scale 1.0 }
	}
	else if( local.cmd == "solid" ){
		if( level.coop_build_solid == 1 ){ level.coop_build_solid = 0 }
		else{ level.coop_build_solid = 1 }
	}
	else if( local.cmd == "animprev" ){
		if( level.coop_build_cat == level.coop_build_actorCat ){
			level.coop_build_animIdx--
			if( level.coop_build_animIdx < 1 ){ level.coop_build_animIdx = level.coop_build_animCount }
			waitthread coop_build_ghostRefresh local.player
		}
	}
	else if( local.cmd == "animnext" ){
		if( level.coop_build_cat == level.coop_build_actorCat ){
			level.coop_build_animIdx++
			if( level.coop_build_animIdx > level.coop_build_animCount ){ level.coop_build_animIdx = 1 }
			waitthread coop_build_ghostRefresh local.player
		}
	}
	//HZM coop BLUEPRINT: snap toggle + template capture/remove bus actions
	else if( local.cmd == "snap" ){
		if( level.coop_build_snap == 1 ){ level.coop_build_snap = 0 }
		else{
			level.coop_build_snap = 1
			level.coop_build_yaw = waitthread coop_mod/blueprint.scr::bp_snapYaw level.coop_build_yaw
		}
		local.player iprint ( "SNAP: " + level.coop_build_snap ) 1
	}
	else if( local.cmd == "bpmark" ){
		waitthread coop_mod/blueprint.scr::bp_mark local.player
	}
	else if( local.cmd == "bpsave" ){
		waitthread coop_mod/blueprint.scr::bp_save local.player
	}
	else if( local.cmd == "bpremove" ){
		waitthread coop_mod/blueprint.scr::bs_removeAimed local.player
	}
	else if( local.cmd == "place" ){
		waitthread coop_build_place local.player
	}
	else if( local.cmd == "undo" ){
		waitthread coop_build_undo local.player
	}
	level.coop_build_hudDirty = 1
}end


// Round to 1 decimal (scale steps drift with float math otherwise).
//=========================================================================
coop_build_round1 local.v:{
//=========================================================================
	local.r = int( ( local.v * 10 ) + 0.5 ) / 10.0
}end local.r


// (Re)spawn the preview ghost with the currently selected catalog model.
//=========================================================================
coop_build_ghostRefresh local.player:{
//=========================================================================
	if( level.coop_build_mode == "sound" ){
		waitthread coop_mod/buildmode_sounds.scr::coop_snd_ghostRefresh local.player
		end
	}
	if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){
		// detach any actor prop first so it is removed with the ghost (removeattachedmodel
		// posts EV_Remove on the child; delete alone would orphan it)
		if( level.coop_build_ghostPropTag != NIL && level.coop_build_ghostPropTag != "" ){
			level.coop_build_ghost removeattachedmodel level.coop_build_ghostPropTag
		}
		level.coop_build_ghost delete
	}
	level.coop_build_ghostPropTag = ""
	level.coop_build_tik = level.coop_build_item[level.coop_build_cat][level.coop_build_idx]
	level.coop_build_name = waitthread coop_mod/strings.scr::remove level.coop_build_tik "models/"

	//[user 07-21] STRUCTURES category: composed multi-piece builds (bunker.scr labels, not
	//tik paths) - preview as a single anchor cube at the aim point; the real placement
	//threads the labelled builder.
	local.gtik = level.coop_build_tik
	if( level.coop_build_cat == level.coop_build_structCat ){
		local.gtik = "models/coop_build/box_concrete.tik"
		//[user 07-21] the cube is only an AIM MARKER - say so, or the item reads as broken
		level.coop_build_name = level.coop_build_tik + "  [KP_ENTER = BUILD IT HERE]"
		local.player iprint ( "STRUCTURE TEMPLATE: cube = aim marker. KP_ENTER builds " + level.coop_build_tik ) 1
	}

	local.g = spawn script_model model local.gtik
	local.g notsolid
	local.g alpha 0.55
	if( level.coop_build_scale != 1.0 ){ local.g scale level.coop_build_scale }
	level.coop_build_ghost = local.g

	// ALLIED ACTORS category: attach the selected anim's prop (if any) + animate the ghost so the
	// preview PLAYS the pose. Same alias/prop the placed actor + the lobby importer will use.
	if( level.coop_build_cat == level.coop_build_actorCat ){
		local.ptik = level.coop_build_animProp[level.coop_build_animIdx]
		local.ptag = level.coop_build_animTag[level.coop_build_animIdx]
		if( local.ptik != NIL && local.ptik != "" && local.ptag != NIL && local.ptag != "" ){
			local.g attachmodel local.ptik local.ptag
			level.coop_build_ghostPropTag = local.ptag
		}
		thread coop_mod/buildmode_actors.scr::coop_build_ghostAnimLoop local.g
	}

	level.coop_build_hudDirty = 1
	waitthread coop_build_ghostFollow local.player
}end


// Per-frame: trace along the view (cover.scr::cover_place recipe - eye at origin+54,
// angles_toforward, traced) and park the ghost at the hit point + z offset.
//=========================================================================
coop_build_ghostFollow local.player:{
//=========================================================================
	if( level.coop_build_ghost == NIL || level.coop_build_ghost == NULL ){ end }
	if( local.player == NULL ){ end }

	local.eyepos = local.player.origin + ( 0 0 54 )
	local.fwd = angles_toforward local.player.viewangles
	local.scaled = local.fwd * 512
	local.traceend = local.eyepos + local.scaled
	local.result = traced ( local.eyepos ) ( local.traceend )
	local.frac = local.result["fraction"]
	local.hitpos = local.result["endpos"]
	if( local.frac >= 1.0 ){
		// nothing within reach - float the ghost at fixed range
		local.scaled = local.fwd * 450
		local.hitpos = local.eyepos + local.scaled
	}
	// push/pull the park point along the aim ray (,/. = closer/farther); dist 0 = auto-snap to surface
	if( level.coop_build_dist != 0 ){
		local.dvec = local.fwd * level.coop_build_dist
		local.hitpos = local.hitpos + local.dvec
	}
	//HZM coop BLUEPRINT: optional grid snap (x/y to the block grid; z opt-in via coop_build_snapz)
	if( level.coop_build_snap == 1 ){
		local.hitpos = waitthread coop_mod/blueprint.scr::bp_snapPos local.hitpos
	}
	local.hitpos[2] = local.hitpos[2] + level.coop_build_zofs

	local.ang = ( 0 0 0 )
	local.ang[0] = level.coop_build_pitch
	local.ang[1] = level.coop_build_yaw

	level.coop_build_ghost.origin = local.hitpos
	level.coop_build_ghost.angles = local.ang
	level.coop_build_lastpos = local.hitpos
	level.coop_build_lastang = local.ang
}end


// Place a real script_model at the ghost position and capture it.
//=========================================================================
coop_build_place local.player:{
//=========================================================================
	if( level.coop_build_mode == "sound" ){
		waitthread coop_mod/buildmode_sounds.scr::coop_snd_place local.player
		end
	}
	if( level.coop_build_lastpos == NIL ){ end }
	local.n = level.coop_build_count + 1

	//[user 07-21] STRUCTURES: thread the composed builder at the ghost pos/yaw, capture a
	//one-line paste-ready call, and skip the single-model path entirely.
	if( level.coop_build_cat == level.coop_build_structCat ){
		local.sx = level.coop_build_lastpos[0]
		local.sy = level.coop_build_lastpos[1]
		local.sz = level.coop_build_lastpos[2]
		//[user 07-21 v2] the current build scale rides along as a whole-structure size
		//multiplier - KP+/- sizes forts the same way it sizes props
		//[agent 07-21] BLUEPRINT: "bp:" items = saved templates (blueprint.scr); builders run
		//waitthread (not thread) so bs_register has finished and the sid is known for unit-undo.
		//Ghost freezes ~8-15 frames during a build - accepted tradeoff (design doc section 8).
		local.pfx = waitthread coop_mod/strings.scr::left 3 level.coop_build_tik
		if( local.pfx == "bp:" ){
			local.bpname = waitthread coop_mod/strings.scr::remove level.coop_build_tik "bp:"
			waitthread coop_mod/blueprint.scr::bp_place level.coop_build_lastpos level.coop_build_yaw local.bpname level.coop_build_scale
		}
		else if( level.coop_build_tik == "bunker_pillbox" ){ waitthread coop_mod/bunker.scr::bunker_pillbox level.coop_build_lastpos level.coop_build_yaw level.coop_build_scale }
		else if( level.coop_build_tik == "bunker_nest" ){ waitthread coop_mod/bunker.scr::bunker_nest level.coop_build_lastpos level.coop_build_yaw level.coop_build_scale }
		else if( level.coop_build_tik == "bunker_wall" ){ waitthread coop_mod/bunker.scr::bunker_wall level.coop_build_lastpos level.coop_build_yaw level.coop_build_scale }
		else if( level.coop_build_tik == "bunker_tower" ){ waitthread coop_mod/bunker.scr::bunker_tower level.coop_build_lastpos level.coop_build_yaw level.coop_build_scale }
		else{ local.player iprint "unknown structure" 1 ; end }
		//HZM coop BLUEPRINT: a refused template place (missing file / budget) must not be
		//recorded or captured - the sid would point at an OLDER structure and undo would eat it
		if( local.pfx == "bp:" && level.coop_bp_lastPlaceOk != 1 ){
			local.player iprint ( "blueprint place failed: " + local.bpname + " (see console)" ) 1
			end
		}
		//HZM coop BLUEPRINT: record as a unit (builder just registered -> sid = coop_bs_count)
		waitthread coop_mod/blueprint.scr::bp_record local.n level.coop_build_tik level.coop_build_lastpos level.coop_build_yaw 0 level.coop_build_scale 1 "struct"
		level.coop_bp_sid[local.n] = level.coop_bs_count
		local.block = "// coop_build STRUCTURE #" + local.n + " " + level.coop_build_tik + "\n"
		if( local.pfx == "bp:" ){
			local.block = local.block + "thread coop_mod/blueprint.scr::bp_place ( " + local.sx + " " + local.sy + " " + local.sz + " ) " + level.coop_build_yaw + " \"" + local.bpname + "\" " + level.coop_build_scale + "\n\n"
		}else{
			local.block = local.block + "thread coop_mod/bunker.scr::" + level.coop_build_tik + " ( " + local.sx + " " + local.sy + " " + local.sz + " ) " + level.coop_build_yaw + " " + level.coop_build_scale + "\n\n"
		}
		level.coop_build_dumpline[local.n] = local.block
		level.coop_build_count = local.n
		waitthread coop_build_save
		println( "^~^~^ BUILD_PLACE_STRUCT " + local.n + " " + level.coop_build_tik + " org " + local.sx + " " + local.sy + " " + local.sz + " yaw " + level.coop_build_yaw )
		local.player iprint ( "built " + level.coop_build_tik + " #" + local.n ) 1
		end
	}

	local.isActor = 0
	if( level.coop_build_cat == level.coop_build_actorCat ){ local.isActor = 1 }

	local.m = spawn script_model model level.coop_build_tik
	local.m.origin = level.coop_build_lastpos
	local.m.angles = level.coop_build_lastang
	if( level.coop_build_scale != 1.0 ){ local.m scale level.coop_build_scale }
	if( level.coop_build_solid == 1 ){ local.m solid }
	else{ local.m notsolid }

	// [bug-829] SOLID HULL AT SCALE: in MOHAA 'scale' resizes only the VISUAL mesh - the collision
	// bbox stays the model's BASE bounds (engine entity.cpp setScale never touches r.mins/r.maxs), so
	// a scaled SOLID object clips at its tiny unscaled size and the cover system's world traces walk
	// straight through the big visual (a scale-8 box renders ~128u but clips at ~16u). Fix: resize the
	// solid hull with setsize = base_bounds * scale. The base bounds are read off the already-loaded
	// GHOST (the just-spawned model's 'model' keyvalue is POSTED, so its getmins/getmaxs can still be
	// zero this same frame). Non-actor props only - skeletal actors keep their own bounds.
	local.didSetsize = 0
	if( local.isActor == 0 && level.coop_build_solid == 1 ){
		if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){
			local.smins = level.coop_build_ghost.getmins * level.coop_build_scale
			local.smaxs = level.coop_build_ghost.getmaxs * level.coop_build_scale
			if( local.smaxs[2] - local.smins[2] > 0 ){
				local.m setsize local.smins local.smaxs
				local.didSetsize = 1
			}
		}
	}

	// resolve the actor anim + prop (empty for a plain prop placement)
	local.anim = ""
	local.ptik = ""
	local.ptag = ""
	local.hasProp = 0
	if( local.isActor == 1 ){
		local.anim = level.coop_build_animAlias[level.coop_build_animIdx]
		if( local.anim == NIL ){ local.anim = "coop_act_idle" }
		local.ptik = level.coop_build_animProp[level.coop_build_animIdx]
		local.ptag = level.coop_build_animTag[level.coop_build_animIdx]
		if( local.ptik == NIL ){ local.ptik = "" }
		if( local.ptag == NIL ){ local.ptag = "" }
		if( local.ptik != "" && local.ptag != "" ){ local.hasProp = 1 }
		if( local.hasProp == 1 ){
			local.m attachmodel local.ptik local.ptag
			local.m.coop_buildPropTag = local.ptag
		}
		// animate live (the proven lobby recipe; the placed actor loops its pose)
		local.m.coop_sceneAnim = local.anim
		local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate
	}

	level.coop_build_ent[local.n] = local.m
	level.coop_build_count = local.n

	//HZM coop BLUEPRINT: structured record (template capture + unit undo); kind "model"
	//pieces are what bp_save templates - actors are recorded but skipped (v1 geometry-only)
	local.kind = "model"
	if( local.isActor == 1 ){ local.kind = "actor" }
	waitthread coop_mod/blueprint.scr::bp_record local.n level.coop_build_tik level.coop_build_lastpos level.coop_build_yaw level.coop_build_pitch level.coop_build_scale level.coop_build_solid local.kind

	// capture: paste-ready script block (spaces inside the parens keep vector literals
	// safe from the paren-minus parse killer when pasted back into a map script)
	local.px = level.coop_build_lastpos[0]
	local.py = level.coop_build_lastpos[1]
	local.pz = level.coop_build_lastpos[2]
	if( local.isActor == 1 ){
		// ACTOR block: spawns the skinned model, attaches the prop, threads the shared scene
		// animator. Paste into coop_mod/lobby.scr::spawnSceneActors (or any coop map) - see
		// _research/build_actor_anims.md.
		local.block = "// coop_build ACTOR #" + local.n + " " + level.coop_build_tik + " anim " + local.anim + "\n"
		local.block = local.block + "local.m = spawn script_model\n"
		local.block = local.block + "local.m model \"" + level.coop_build_tik + "\"\n"
		local.block = local.block + "local.m.origin = ( " + local.px + " " + local.py + " " + local.pz + " )\n"
		local.block = local.block + "local.m.angles = ( " + level.coop_build_pitch + " " + level.coop_build_yaw + " 0 )\n"
		if( level.coop_build_scale != 1.0 ){ local.block = local.block + "local.m scale " + level.coop_build_scale + "\n" }
		if( level.coop_build_solid == 1 ){ local.block = local.block + "local.m solid\n" }
		else{ local.block = local.block + "local.m notsolid\n" }
		if( local.hasProp == 1 ){ local.block = local.block + "local.m attachmodel \"" + local.ptik + "\" \"" + local.ptag + "\"\n" }
		local.block = local.block + "local.m.coop_sceneAnim = \"" + local.anim + "\"\n"
		local.block = local.block + "local.m thread coop_mod/lobby.scr::coop_sceneActorAnimate\n"
		local.block = local.block + "\n"
	}else{
		local.block = "// coop_build #" + local.n + " " + level.coop_build_tik + "\n"
		local.block = local.block + "local.m = spawn script_model\n"
		local.block = local.block + "local.m model \"" + level.coop_build_tik + "\"\n"
		local.block = local.block + "local.m.origin = ( " + local.px + " " + local.py + " " + local.pz + " )\n"
		local.block = local.block + "local.m.angles = ( " + level.coop_build_pitch + " " + level.coop_build_yaw + " 0 )\n"
		if( level.coop_build_scale != 1.0 ){ local.block = local.block + "local.m scale " + level.coop_build_scale + "\n" }
		if( level.coop_build_solid == 1 ){ local.block = local.block + "local.m solid\n" }
		else{ local.block = local.block + "local.m notsolid\n" }
		if( local.didSetsize == 1 ){ local.block = local.block + "local.m setsize ( " + local.smins[0] + " " + local.smins[1] + " " + local.smins[2] + " ) ( " + local.smaxs[0] + " " + local.smaxs[1] + " " + local.smaxs[2] + " )\n" }
		local.block = local.block + "\n"
	}
	level.coop_build_dumpline[local.n] = local.block

	waitthread coop_build_save
	if( local.isActor == 1 ){
		println( "^~^~^ BUILD_PLACE_ACTOR " + local.n + " " + level.coop_build_tik + " anim " + local.anim + " prop " + local.ptik + " tag " + local.ptag + " org " + local.px + " " + local.py + " " + local.pz + " ang " + level.coop_build_pitch + " " + level.coop_build_yaw + " 0 scale " + level.coop_build_scale + " solid " + level.coop_build_solid )
		local.player iprint ( "placed actor #" + local.n + " " + level.coop_build_name + " (" + local.anim + ")" ) 1
	}else{
		println( "^~^~^ BUILD_PLACE " + local.n + " " + level.coop_build_tik + " org " + local.px + " " + local.py + " " + local.pz + " ang " + level.coop_build_pitch + " " + level.coop_build_yaw + " 0 scale " + level.coop_build_scale + " solid " + level.coop_build_solid )
		local.player iprint ( "placed #" + local.n + " " + level.coop_build_name ) 1
	}
}end


// Remove the most recent placement (entity + capture line) and rewrite the file.
//=========================================================================
coop_build_undo local.player:{
//=========================================================================
	if( level.coop_build_count < 1 ){
		local.player iprint "BUILD: nothing to undo" 1
		end
	}
	local.n = level.coop_build_count
	//HZM coop BLUEPRINT: structure placements undo as a UNIT (registry delete, batched)
	if( level.coop_bp_kind[local.n] == "struct" ){
		waitthread coop_mod/blueprint.scr::bs_remove level.coop_bp_sid[local.n] local.player
	}else{
		local.m = level.coop_build_ent[local.n]
		if( local.m != NIL && local.m != NULL ){
			// detach an actor prop first so it is removed with the model, not orphaned
			if( local.m.coop_buildPropTag != NIL && local.m.coop_buildPropTag != "" ){
				local.m removeattachedmodel local.m.coop_buildPropTag
			}
			local.m delete
		}
	}
	waitthread coop_mod/blueprint.scr::bp_unrecord local.n
	level.coop_build_ent[local.n] = NIL
	level.coop_build_dumpline[local.n] = NIL
	level.coop_build_count = local.n - 1

	waitthread coop_build_save
	println( "^~^~^ BUILD_UNDO " + local.n )
	local.player iprint ( "removed #" + local.n ) 1
}end


// Rewrite the whole capture file: prior sessions (basetext) + this session's blocks.
// fs_write_content lands in the homepath: %APPDATA%/openmohaa/maintt/coop_mod/save/
//=========================================================================
coop_build_save:{
//=========================================================================
	local.txt = level.coop_build_basetext
	local.i = 1
	while( local.i <= level.coop_build_count ){
		if( level.coop_build_dumpline[local.i] != NIL ){ local.txt = local.txt + level.coop_build_dumpline[local.i] }
		local.i++
	}
	fs_write_content ( level.coop_build_file ) ( local.txt )
	println( "^~^~^ BUILD_SAVED " + level.coop_build_file + " count " + level.coop_build_count )
}end


// Build-mode readout on ihuddraw slots 54-59 (+ 61 = actor anim line). See header slot audit.
//=========================================================================
coop_build_hud local.player:{
//=========================================================================
	local.i = 54
	while( local.i <= 59 ){
		ihuddraw_virtualsize local.player local.i 1
		ihuddraw_align       local.player local.i left top
		ihuddraw_font        local.player local.i "verdana-14"
		ihuddraw_alpha       local.player local.i 0.85
		local.i++
	}
	ihuddraw_color local.player 54 1 0.85 0.25
	ihuddraw_rect  local.player 54 8 128 0 0
	ihuddraw_color local.player 55 0.8 0.8 0.8
	ihuddraw_rect  local.player 55 8 144 0 0
	ihuddraw_color local.player 56 1 1 1
	ihuddraw_rect  local.player 56 8 158 0 0
	ihuddraw_color local.player 57 0.8 0.8 0.8
	ihuddraw_rect  local.player 57 8 172 0 0
	ihuddraw_color local.player 58 0.6 0.9 0.6
	ihuddraw_rect  local.player 58 8 186 0 0
	ihuddraw_color local.player 59 0.55 0.55 0.55
	ihuddraw_rect  local.player 59 8 202 0 0
	ihuddraw_alpha local.player 59 0.6

	// slot 61 = ACTOR anim readout (only shown while the ALLIED ACTORS category is selected).
	// 61 is free between 60 (weather) and 62-69 (xp); see header slot audit.
	ihuddraw_virtualsize local.player 61 1
	ihuddraw_align       local.player 61 left top
	ihuddraw_font        local.player 61 "verdana-14"
	ihuddraw_color       local.player 61 0.6 0.85 1
	ihuddraw_rect        local.player 61 8 216 0 0
	ihuddraw_alpha       local.player 61 0

	ihuddraw_string local.player 54 "BUILD MODE"
	ihuddraw_string local.player 59 "KP4/6 model KP1/3 cat  [ / ] anim  KP7/9 yaw KP8/2 z  , / . dist  KP+/- scale KP0 solid KPEnter place KPDel undo  ; snap  ' bpmark"

	while( level.coop_build_active == 1 && local.player != NULL ){
		if( level.coop_build_hudDirty == 1 ){
			level.coop_build_hudDirty = 0
			if( level.coop_build_mode == "sound" ){
				// SOUND-mode readout
				ihuddraw_string local.player 54 "BUILD MODE [SOUND]"
				ihuddraw_string local.player 55 ( "SND CAT " + level.coop_build_sndcat + "/" + level.coop_build_sndcatcount + ": " + level.coop_build_sndcatname[level.coop_build_sndcat] )
				ihuddraw_string local.player 56 ( "[" + level.coop_build_sndidx + "/" + level.coop_build_snditemcount[level.coop_build_sndcat] + "] " + level.coop_build_snddisp[level.coop_build_sndcat][level.coop_build_sndidx] )
				ihuddraw_string local.player 57 ( "vol " + level.coop_build_sndvol + " min " + level.coop_build_sndmin + " zofs " + level.coop_build_zofs + " dist " + level.coop_build_dist + " type " + level.coop_build_sndtype )
				ihuddraw_string local.player 58 ( "sounds placed " + level.coop_build_sndcount )
				ihuddraw_string local.player 61 ( "KP4/6 sound KP1/3 cat  KP+/- vol  KP*// radius  KP0 loop/oneshot  KPEnter drop  \\ back to OBJECT" )
				ihuddraw_alpha  local.player 61 0.85
			}else{
				ihuddraw_string local.player 55 ( "CAT " + level.coop_build_cat + "/" + level.coop_build_catcount + ": " + level.coop_build_catname[level.coop_build_cat] )
				ihuddraw_string local.player 56 ( "[" + level.coop_build_idx + "/" + level.coop_build_itemcount[level.coop_build_cat] + "] " + level.coop_build_name )
				ihuddraw_string local.player 57 ( "yaw " + level.coop_build_yaw + " pitch " + level.coop_build_pitch + " zofs " + level.coop_build_zofs + " dist " + level.coop_build_dist + " scale " + level.coop_build_scale + " solid " + level.coop_build_solid + " snap " + level.coop_build_snap )
				ihuddraw_string local.player 58 ( "placed " + level.coop_build_count + " -> " + level.coop_build_file )

				// actor anim line (54 title gets an [ACTOR] tag too)
				if( level.coop_build_cat == level.coop_build_actorCat ){
					ihuddraw_string local.player 54 "BUILD MODE [ACTOR]"
					local.propnote = ""
					if( level.coop_build_animProp[level.coop_build_animIdx] != NIL && level.coop_build_animProp[level.coop_build_animIdx] != "" ){ local.propnote = "  +prop" }
					ihuddraw_string local.player 61 ( "ANIM [" + level.coop_build_animIdx + "/" + level.coop_build_animCount + "] " + level.coop_build_animName[level.coop_build_animIdx] + local.propnote )
					ihuddraw_alpha  local.player 61 0.85
				}else{
					ihuddraw_string local.player 54 "BUILD MODE"
					ihuddraw_alpha  local.player 61 0
				}
			}
		}
		wait 0.15
	}

	// hide everything on exit
	local.i = 54
	while( local.i <= 59 ){
		ihuddraw_alpha  local.player local.i 0
		ihuddraw_string local.player local.i ""
		local.i++
	}
	ihuddraw_alpha  local.player 61 0
	ihuddraw_string local.player 61 ""
}end
