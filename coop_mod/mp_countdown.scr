//=========================================================================
// MP_COUNTDOWN.SCR - COUNTDOWN, an MP game MODE. This LOADS the real "Countdown" mod (imported htr/ radio
// engine) - it is NOT a reimplementation. Countdown: each team has a doomsday timer; while your team holds
// the enemy's RADIO, THEIR timer ticks down; when a team's timer hits zero, that team's players explode and
// they lose the round. The radio drops when its holder dies, and respawns to a new spot if left idle.
//
// The htr/ engine (setup/radio/player_radio/player_scan/camera/hud + strings/mapdesc/nagle/get_weapon deps)
// was imported verbatim under the private htr/ namespace; the per-map radio spawn origins were harvested into
// htr/countdown_maps.scr (generated by docs/tools/gen_countdown_maps.py) and served to htr/setup.scr::getorigin
// in place of the mod's own countdown/<map>.scr lookup. We do NOT ship the mod's global/ambient.scr (it would
// override our MP framework hook), and we DISABLED its changemap (it used bsptransition + g_gametype 0 - both
// crash/coop hazards); our framework owns map rotation.
//
// This is an MP file (coop_mod/mp*.scr is in MP_MANIFEST), guarded end to end by level.coop_mpRun, which ONLY
// coop_mod/mp.scr sets and which a level load wipes - so NOTHING here can run on a coop map. It uses the armory
// (mp_modeUsesArmory stays 1). mp.scr dispatches through its seam (a switch on level.coop_mpMode):
//     mp.scr::mp_modeInit    -> mode_init   (pre-spawn: enable + start the htr engine for this map)
//     mp.scr::mp_modeGiveKit -> mode_onSpawn (deploy the armory kit; the engine owns the radio/HUD)
//     mp.scr::mp_modeTick / mp_modeOnDeath   (no-ops: htr/player_scan.scr self-manages every player)
//
// ISOLATION: calls only mp_armory.scr (MP_MANIFEST) and the private htr/ namespace (admitted as an MP callee,
// like alienx/ and ubermode/); htr names no coop_mp*/coop_lo/coop_health token or ui/loadout tree. The radio
// engine touches g_gametype only inside its own win path (camera.scr: a momentary flip-to-4-for-teamwin, the
// same changeGameType shape coop uses, then restored) and only while this MP mode runs; it can never reach coop.
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end


//Liveness probe (TRAPS T1).
alive:{
	end 1
}end


//isOn guard.
isOn:{
	if( level.coop_mpRun != 1 ){ end 0 }
	if( level.coop_mpMode != "countdown" ){ end 0 }
	end 1
}end


//PRE-SPAWN INIT. Enable the mod's cvar and start the real htr engine. It runs at Level::ServerSpawned (the
//E4 hook), so we set level.hzmArenaSpawned=1 to skip htr/setup.scr's internal `level waittill spawn` (which
//would throw "invalid waittill" once the edge is gone - the flag makes it a clean skip, upstream behaviour
//is unchanged). getorigin returns NIL on a map with no radio data, and the engine ends itself there.
mode_init:{
	if( level.coop_mpRun != 1 ){ end }

	local.map = getcvar( "mapname" )
	setcvar "countdown" "1"
	level.hzmArenaSpawned = 1
	println( "^~^~^ MPCD starting Countdown on " + local.map )

	exec htr/setup.scr::main
}end


//SPAWN EDGE. Deploy through the armory so the weapon preset is inherited (players need to fight for the
//radio); the htr engine attaches the radio/bomb + drives the HUD itself.
mode_onSpawn local.p:{
	if( local.p == NULL ){ end }
	waitthread coop_mod/mp_armory.scr::giveKit local.p
}end


//THINK / DEATH EDGES - no-ops. htr/player_scan.scr self-manages every player (bomb attach + HUD), and
//htr/radio.scr handles the radio drop on death.
mode_think local.p:{
	end
}end


mode_onDeath local.p:{
	end
}end
