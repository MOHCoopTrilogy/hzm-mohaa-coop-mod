//=========================================================================
// MP.SCR - the multiplayer entry point. NOT the coop framework.
//
// [user 2026-09-09] "id like to plan out the multiplayer to work with the Loadout... just selecting
// a Team Axis or Allies and spawn in with your loadout" / "I cannot stress this enough we need to
// make sure this does not in any way impact the coop mod or experience itself."
//
// Full design: _research/mp_loadout_plan_v1.md. Isolation contract, enforced by
// docs/tools/check_mp_isolation.py and gated in build.ps1: docs/tools/check_mp_isolation.py.
//
//=========================================================================
// WHAT THIS FILE DELIBERATELY DOES NOT DO, each one a measured hazard
//=========================================================================
// * It does NOT call coop_mod/main.scr::main. That path force-joins allies (main.scr:411-437
//   throbtexts "Only allies are allowed in Coop!" and joins for you) with no gametype gate
//   anywhere in coop_mod - every level.gametype test in the whole mod is == 0 / != 0.
// * It does NOT call itemhandler.scr::giveInventory. That wraps its give in
//   main.scr::changeGameType 0 0 / 2 0, which ends in setcvar g_gametype <n> - so on a live MP
//   server it would briefly zero the gametype and then restore it to a HARDCODED 2, silently
//   converting an Objective, Round, TOW or Liberation server into Team Match on the first spawn.
//   A plain takeall + give is used instead.
// * It does NOT write the coop_health CVAR. server.scr:238 re-seeds level.coop_health from that
//   cvar on EVERY map with a prevCoopHealth memo, so writing it would follow the player into the
//   next COOP map and give every coop player MP health. Health is set PER PLAYER at spawn.
// * It does NOT write coop_lockLoadout. server.scr:28 seeds it only when EMPTY, so once an MP map
//   set it to 0 it would stay 0 for every coop map for the life of the server process.
// * It does NOT touch any ui/*.urc. The stock weapon picker is left exactly as it is and simply
//   never gets a chance to matter, because this file sets the weapon class itself. That keeps the
//   blast radius on coop at literally zero files.
// * [user 2026-09-13, bug-2571] It does NOT use the COOP ARMORY, in any form - no loadoutpick.scr, challenges.scr,
//   xp.scr, helmet.scr, gloves.scr or loadoutskins.scr call. Committing MP picks through loadout_set wrote coop client
//   state on every join (finish chips, padlocks, Axis guns archived as unlocked), and the user has since decided MP
//   gets its OWN Allied and Axis armories: "I don't want allies having access to any non-allied weapons". Until those
//   exist, MP players spawn with the engine's stock class kit. check_mp_isolation.py clause 10 enforces this.
//=========================================================================


//=========================================================================
// Entry. Hooked from global/ambient.scr, which BOTH coop maps and stock MP maps exec - so the
// refusal guard below is load-bearing, not decoration.
//=========================================================================
main:{
	//THE REFUSAL GUARD. Clause 2 of the isolation contract. Even if the ambient.scr hook is ever
	//edited wrongly, this file will not run on a coop map. A guard that exists only at the call
	//site is one careless edit away from being gone.
	if( level.coop_mainScriptLoaded == 1 ){
		println( "^~^~^ MP refused to start - coop is loaded on this map" )
		end
	}

	//[E4, MP armories slice 2] On a map that runs global/ambient.scr, ambient.scr:22 already set
	//level.gametype from g_gametype just above its hook. On a SCRIPT-LESS or third-party MP map the
	//game.dll mp_mapscript_hook (level.cpp Level::ServerSpawned) execs this DIRECTLY and ambient never
	//ran, so level.gametype is NIL here - seed it from g_gametype exactly as ambient does. game.dll
	//gates that hook so it can never fire on a coop map, and the refusal guard above is the backstop.
	if( level.gametype == NIL ){ level.gametype = int( getcvar( g_gametype ) ) }

	//Never single-player.
	if( level.gametype == 0 ){ end }

	//Idempotent - ambient.scr has its own run-once flag, but a map that execs it twice (or ambient AND
	//the E4 hook on the same map) must not start two pollers.
	if( level.coop_mpRun == 1 ){ end }
	level.coop_mpRun = 1

	//[MP modes slice 1] THE MODE SCAFFOLD. The host picks the MP game mode with the cvar coop_mpMode:
	//   "" / "none"  -> today's behaviour EXACTLY (the armory deathmatch path below, byte-identical)
	//   "gungame"    -> FFA Gun Game (coop_mod/mp_gungame.scr)
	//This is a READ only. coop_mp* is MP-owned (isolation clause 12c) and a level load wipes level vars,
	//so the mode can never follow anyone into coop. The dispatch SEAM is three switch labels below -
	//mp_modeGiveKit (spawn-edge kit), mp_modeTick (per-tick), mp_modeOnDeath (death edge) - each a
	//switch on level.coop_mpMode; a later mode adds a case and its own coop_mod/mp_<mode>.scr.
	level.coop_mpMode = "none"
	local.mode = getcvar( "coop_mpMode" )
	if( local.mode != "" && local.mode != "none" ){ level.coop_mpMode = local.mode }

	//[MP presets slice 2] THE WEAPON PRESET MODIFIER (decisions M3/M4/M5). A host cvar that MASKS which
	//primary weapon CLASSES the armory will deploy, and it composes with EVERY armory-based mode (M5 -
	//it is a modifier row, not a mode of its own):
	//   "" / "none"     -> no restriction (today's behaviour EXACTLY)
	//   "rifles"        -> rifle-class primaries only
	//   "snipers"       -> Sniper-class primaries only (P3: the Sniper class is scoped bolt-action AND
	//                      scoped semi-auto rifles; a scoped fully-auto counts toward its base class)
	//   "riflesnipers"  -> both rifle and Sniper classes
	//PISTOLS AND GRENADES STAY LEGAL under every preset (M4). This is a READ only, exactly like the mode
	//above: coop_mp* is MP-owned (isolation clause 12c) and a level load wipes level vars, so the preset
	//can never follow anyone into coop. mp_armory.scr reads level.coop_mpPreset and composes it into its
	//OWN classBanned path (the roster/degrade path it already runs); mp.scr never masks weapons itself.
	//NO-OP for a mode that owns a fixed ladder: Gun Game (M9) hands out its own tier weapons and bypasses
	//the armory, so the preset does not touch its ladder this slice.
	level.coop_mpPreset = "none"
	local.preset = getcvar( "coop_mpPreset" )
	if( local.preset != "" && local.preset != "none" ){ level.coop_mpPreset = local.preset }

	//[user 2026-09-13, bug-2564] THE COOP FEEL IN MULTIPLAYER - "put all of it into pvp".
	//
	//1. game.* constants. variables.scr seeds these on coop maps only, and weaponstate.scr reads both
	//   (`wait game.ms` on every raise) - unseeded, every weapon raise is a Script Error. game.* persists across
	//   maps, and variables.scr assigns the same values on the next coop map, so this cannot leak.
	if( game.true == NIL ){
		game.ms = 0.0005
		game.true = bool 1
		game.false = !game.true
	}

	//2. THE COOP ANIMATION SET - prone, the ADS raise, sprint, limp and the cover poses live only in
	//   coop_mod/player_legs.st and player_Torso.st. ambient.scr put retail global/mike back just above this
	//   hook. level.coop_stateFileReset = 1 stops weaponstate.scr:9-17 reverting it on the first weapon raise.
	//   No leak: server.scr:23 sets the same value on every coop map, and ambient.scr resets it on the next
	//   non-coop map before this hook runs again. Without it prone was LIVE with no animation - a 0.35x-spread
	//   crouch that nobody could see.
	setcvar "g_statefile" "coop_mod/player"
	level.coop_stateFileReset = 1

	//3. The coop torso's KILLED state now runs player.scr::manageDead (events.scr playerdeath), and 0 sends it
	//   down coop's own last-man-standing-off path. NIL would compare and misbehave.
	level.coop_lmsLives = 0

	//4. STUCK IN SPECTATE AFTER COOP. main.scr's disableAllWeaponsOnMenu sets exactly this value
	//   (itemhandler.scr:3485, every weapon class banned); dmflags is not archived and survives a map change,
	//   so after any coop map in this process primarydmweapon was refused and nobody could spawn. Only that
	//   exact value is cleared - a server's own dmflags are left alone. Coop sets it again on its next map.
	if( int( getcvar( "dmflags" ) ) == 532676608 ){ setcvar "dmflags" "0" }

	//[MP armories slice 2] Liveness probe (TRAPS T1). If coop_mod/mp_armory.scr parse-kills, ::alive is
	//unreachable and returns NIL, so level.coop_mpArmoryLive stays 0 and every edge below keeps today's
	//stock rifle deploy - a bad token in the armory strands nobody in spectate.
	level.coop_mpArmoryLive = 0
	local.armLive = waitthread coop_mod/mp_armory.scr::alive
	if( local.armLive == 1 ){ level.coop_mpArmoryLive = 1 }

	println( "^~^~^ MP init gametype=" + level.gametype + " map=" + level.script + " armory=" + level.coop_mpArmoryLive + " mode=" + level.coop_mpMode + " preset=" + level.coop_mpPreset )
	thread mp_manage
}end


//=========================================================================
// The per-player poll.
//
// DELIBERATELY A POLL, not the engine's player_spawned delegate. The delegate exists
// (scriptthread.cpp registers registerev / event_subscribe) and would give a cleaner post-equip
// hook, but the label-argument form is unverified in this codebase - nothing in the mod's whole
// .scr tree uses it - and an unverified builtin in the one file that must never misbehave is a bad
// trade. Polling is the shape player.scr::manage has used since [200]. Revisit once the delegate
// has been proven on a throwaway label.
//=========================================================================
mp_manage:{
	//let the first clients finish connecting
	wait 1

	while( 1 ){
		//$player.size is -1 on an EMPTY array, never 0, so this loop simply does not run with
		//nobody connected. Never test .size == 0 in this engine.
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p == NULL ){ continue }
			waitthread mp_tickPlayer local.p
		}
		wait 0.5
	}
}end


//=========================================================================
// One player, one tick. Two edges are watched: the TEAM flip, and the SPAWN.
//=========================================================================
mp_tickPlayer local.p:{
	if( local.p == NULL ){ end }

	// ---- name bus ----------------------------------------------------------------------------
	//[armory slice 2] When the armory is live the dispatcher owns the name bus: it reads the ,q pick
	//markers (which mp_cleanName would otherwise strip before they were seen) and then cleans the name.
	//[MP modes slice 1] A game MODE bypasses the armory entirely (Gun Game owns its own kit), so the
	//armory name bus is skipped when a mode is active and the name is simply cleaned instead. When
	//coop_mpMode == "none" this is byte-identical to before (armoryLive gate unchanged).
	if( level.coop_mpMode == "none" && level.coop_mpArmoryLive == 1 ){
		waitthread coop_mod/mp_armory.scr::tickPlayer local.p
		if( local.p == NULL ){ end }
	}
	//[bug-2571] No armory: a saved name can carry coop armory tokens (" ,w136" and friends) from the
	//main-menu armory. They are STRIPPED so they never reach the scoreboard, and nothing is committed.
	else if( waitthread coop_mod/main.scr::containsText local.p.netname " ," 0 ){
		thread mp_cleanName local.p
	}

	// ---- edge 1: the player picked a team -------------------------------------------------
	local.team = local.p.dmteam
	if( local.team == NIL ){ local.team = "" }

	local.prevTeam = local.p.flags["coop_mpTeam"]
	if( local.prevTeam == NIL ){ local.prevTeam = "" }

	if( local.team != local.prevTeam ){
		local.p.flags["coop_mpTeam"] = local.team

		if( local.team != "" && local.team != "spectator" ){
			//And deploy him. The engine will not let a player leave spectator until dm_primary
			//holds a legal CLASS, and the mod's own ui override leaves the stock picker empty -
			//so set the class here rather than making him find a menu that has no content.
			//EventPrimaryDMWeapon self-deploys (EndSpectator + Respawn) in the same command.
			waitthread mp_deploy local.p
		}
	}

	// ---- edge 2: he just came alive -------------------------------------------------------
	local.alive = 0
	//[bug-2564] health alone is NOT alive: a spectator carries full health (player.cpp:11115-11117), so this used
	//to fire mp_onSpawn on the spectator before he picked a team, and his real first spawn was never an edge.
	if( local.p.health > 0 && !local.p.isSpectator ){ local.alive = 1 }

	local.wasAlive = local.p.flags["coop_mpAlive"]
	if( local.wasAlive == NIL ){ local.wasAlive = 0 }

	local.p.flags["coop_mpAlive"] = local.alive

	//[bug-2564] the falling edge ends this life: the monitors stop (they loop only while coop_isActive is 1),
	//exactly as player.scr::manageDead does at :1624 - belt and braces for any death path that skips it - and
	//the next life is owed a kit again
	if( local.alive == 0 && local.wasAlive == 1 ){
		local.p.flags["coop_isActive"] = 0 - 2
		//[MP modes slice 1] the death edge - the per-"kill" mode seam (the victim just died).
		if( level.coop_mpMode != "none" ){
			waitthread mp_modeOnDeath local.p
			if( local.p == NULL ){ end }
		}
	}

	if( local.alive == 1 && local.wasAlive == 0 ){
		waitthread mp_onSpawn local.p
		if( local.p == NULL ){ end }
	}

	//[MP modes slice 1] the per-tick mode seam. Runs for every player every poll so a mode can watch
	//kills/tiers even for players who did not die this tick (Gun Game reads the getkills delta here).
	if( level.coop_mpMode != "none" ){
		waitthread mp_modeTick local.p
		if( local.p == NULL ){ end }
	}
}end


//=========================================================================
// Get him out of spectate with a legal weapon class.
//
// "rifle" is the safe default: it is the one class no shipped dmflags configuration bans, and
// EventPrimaryDMWeapon REFUSES and returns without writing dm_primary if the class is banned -
// which would park the player in spectate permanently rather than fail loudly.
//=========================================================================
mp_deploy local.p:{
	if( local.p == NULL ){ end }

	if( local.p == NULL ){ end }
	local.p primarydmweapon "rifle"

	//[bug-2564] THE STRAY CURSOR. Joining a team with an empty dm_primary makes the engine stuff
	//`wait 250;pushmenu SelectPrimaryWeapon` (player.cpp:11406), and the mod's own ui override makes that an empty
	//shell that still takes the mouse. A bare `popmenu 0` here landed BEFORE that push, or inside PushMenu's lock
	//where PopMenu returns silently (uimenu.cpp:550/599). Server stufftext APPENDS to the client's buffer and
	//`wait` pauses the whole buffer, so these run after the engine's push has completed; the second pop covers a
	//first one that lands inside the lock. CG_IsStatementAllowed checks each ;-separated statement, and both wait
	//and popmenu are on its allow list.
	local.p stufftext "wait 300;popmenu 0;wait 300;popmenu 0"

	//If that was refused he is still a spectator a moment later. "auto" picks a random ALLOWED
	//class and self-deploys, so it cannot be refused by a ban.
	wait 1
	if( local.p == NULL ){ end }
	if( local.p.dmteam == "spectator" ){ end }
	//[bug-2564] isSpectator, not health - a spectator has FULL health (player.cpp:11115), so the old test never
	//saw a refused deploy at all
	if( !local.p.isSpectator ){ end }
	//Objective, Round, TOW and Liberation hold a teamed player in spectate until the next wave; re-rolling his
	//class there would be wrong. Team Match (2) spawns at once, so only there does "still spectating" mean refused.
	if( level.gametype != 2 ){ end }

	println( "^~^~^ MP deploy fallback for e" + local.p.entnum + " - rifle was refused" )
	local.p primarydmweapon "auto"
}end


//=========================================================================
// Every respawn, after the engine has already handed out the stock class kit.
//
// Health FIRST, because `health <n>` also writes max_health (entity.cpp:1938 - the same behaviour
// dbno.scr:191 documents from the other direction, where a bare `health 100` silently collapsed a
// coop player's max from 750). That is exactly what is wanted here: MP is a 100 HP game.
//=========================================================================
mp_onSpawn local.p:{
	if( local.p == NULL ){ end }

	//[user 2026-09-09] MP health is 100, not coop's 750. PER PLAYER - see the header for why the
	//cvar route would follow him into the next coop map.
	//[armory slice 2] When the armory is live the dispatcher hands out the committed kit (or the free
	//starter / a bot's random free-tier gun) with `takeall` + `item`, tops up ammo, AND sets health 100
	//in the same give. Never giveInventory / changeGameType (header) and never the coop_health cvar
	//(clause 4). Without a live armory, health alone - the engine's stock class kit stands.
	//[MP modes slice 1] a game MODE owns the spawn kit and bypasses the armory entirely (Gun Game
	//hands out the current-tier weapon with its own takeall + item + ammo + health 100).
	if( level.coop_mpMode != "none" ){
		waitthread mp_modeGiveKit local.p
		if( local.p == NULL ){ end }
	}
	else if( level.coop_mpArmoryLive == 1 ){
		waitthread coop_mod/mp_armory.scr::giveKit local.p
		if( local.p == NULL ){ end }
	}
	else{
		local.p health 100
	}

	//[user 2026-09-13, bug-2564] THIS LIFE'S MONITORS - the ones coop starts from player.scr manageSetup /
	//manageAliveSpawning: the ADS walk slowdown, wounded breathing, tinnitus and the injured muffle. Each loops
	//only while coop_isActive == 1 and exits once a death sets it to -2, so one assignment per life starts them
	//and one death ends them - no stacking. coop_limpWarn has no such gate and loops for the player's whole
	//connection, so it is started exactly once per player.
	//NOT coop_isHost, ever: that flag unlocks dev godmode, noclip and give_all (developer.scr).
	local.p.flags["coop_isActive"] = 1
	thread coop_mod/ads.scr::coop_ads_monitor local.p
	thread coop_mod/painbreath.scr::wounded_monitor local.p
	thread coop_mod/tinnitus.scr::coop_tinnitus_monitor local.p
	thread coop_mod/tinnitus.scr::coop_injured_muffle_monitor local.p
	if( local.p.flags["coop_mpLimpWarn"] != 1 ){
		local.p.flags["coop_mpLimpWarn"] = 1
		thread coop_mod/player.scr::coop_limpWarn local.p
	}

	//the same audio safety net coop runs on every (re)spawn (player.scr:1357/1366): a muffle or a duck cut short
	//by a death must never leave this player's world sound stuck down. Defaulted, because on a server without
	//the mod's autoexec an empty value would set s_volume to nothing.
	local.bv = getcvar( "coop_tinnitusBaseVol" )
	if( local.bv == "" ){ local.bv = "0.9" }
	local.p stufftext ( "s_volume " + local.bv )
	local.p stufftext "s_sfxduck 1"

	//[armory slice 2] the kit itself is given above via mp_armory.scr::giveKit when the armory is live.
}end


//=========================================================================
// [bug-2571] STRIP COOP ARMORY TOKENS FROM A MULTIPLAYER NAME.
//
// Replaces mp_giveKit / mp_kitIfDue / mp_hostSeed / mp_readPicks, which committed MP picks through the coop armory
// (loadoutpick.scr::loadout_set) and so wrote coop client state on every join. A player's saved name can still carry
// ,w / ,f tokens from the main-menu armory, so the name is cleaned - playerCleanName is a pure string helper that cuts
// at the first " ," - and NOTHING is committed.
//
// Coop's own dispatcher (player.scr::manageNamechange / playerNameCommand) never runs here and must not: it also
// serves teleport-onto-player, a free DBNO heal and ammo crates to any client who types the token.
// A busy flag and a one-second hold keep two polls from cleaning the same name twice before the client answers.
//=========================================================================
mp_cleanName local.p:{
	if( local.p == NULL ){ end }
	if( local.p.flags["coop_mpCleaning"] == 1 ){ end }
	local.p.flags["coop_mpCleaning"] = 1

	local.clean = waitthread coop_mod/player.scr::playerCleanName local.p.netname
	if( local.p == NULL ){ end }
	if( local.clean != NIL && local.clean != "" ){
		local.p stufftext ( "set name " + local.clean )
	}

	wait 1
	if( local.p != NULL ){ local.p.flags["coop_mpCleaning"] = NIL }
}end


//=========================================================================
// [MP modes slice 1] THE MODE DISPATCH SEAM. Three labels, each a switch on level.coop_mpMode, are
// the only places mp.scr knows a specific mode. A later mode (Rifles preset, KOTH, S&D, LMS, ...)
// adds a `case "<mode>":` in each and ships its own coop_mod/mp_<mode>.scr with mode_onSpawn /
// mode_think / mode_onDeath. Keeping the seam here (rather than a dynamic file name, which the engine
// cannot thread) means mp.scr stays the single owner of the poll and the edges.
//=========================================================================

//spawn-edge kit: the mode owns the give (called from mp_onSpawn)
mp_modeGiveKit local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_onSpawn local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_onSpawn local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_onSpawn local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_onSpawn local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_onSpawn local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_onSpawn local.p
			break
	}
}end

//per-tick hook: the mode watches kills/tiers (called from mp_tickPlayer every poll)
mp_modeTick local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_think local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_think local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_think local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_think local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_think local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_think local.p
			break
	}
}end

//death-edge hook: the victim just died (called from mp_tickPlayer on the alive->dead edge)
mp_modeOnDeath local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_onDeath local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_onDeath local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_onDeath local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_onDeath local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_onDeath local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_onDeath local.p
			break
	}
}end
