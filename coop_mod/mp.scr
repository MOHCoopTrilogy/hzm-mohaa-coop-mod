//=========================================================================
// MP.SCR - the multiplayer entry point. NOT the coop framework.
//
// [user 2026-09-09] "id like to plan out the multiplayer to work with the Loadout... just selecting
// a Team Axis or Allies and spawn in with your loadout" / "I cannot stress this enough we need to
// make sure this does not in any way impact the coop mod or experience itself."
//
// Full design: _research/mp_loadout_plan_v1.md. Isolation contract, enforced by
// docs/tools/check_mp_isolation.py and gated in build.ps1: docs/tools/check_mp_isolation.py.
//
//=========================================================================
// WHAT THIS FILE DELIBERATELY DOES NOT DO, each one a measured hazard
//=========================================================================
// * It does NOT call coop_mod/main.scr::main. That path force-joins allies (main.scr:411-437
//   throbtexts "Only allies are allowed in Coop!" and joins for you) with no gametype gate
//   anywhere in coop_mod - every level.gametype test in the whole mod is == 0 / != 0.
// * It does NOT call itemhandler.scr::giveInventory. That wraps its give in
//   main.scr::changeGameType 0 0 / 2 0, which ends in setcvar g_gametype <n> - so on a live MP
//   server it would briefly zero the gametype and then restore it to a HARDCODED 2, silently
//   converting an Objective, Round, TOW or Liberation server into Team Match on the first spawn.
//   A plain takeall + give is used instead.
// * It does NOT write the coop_health CVAR. server.scr:238 re-seeds level.coop_health from that
//   cvar on EVERY map with a prevCoopHealth memo, so writing it would follow the player into the
//   next COOP map and give every coop player MP health. Health is set PER PLAYER at spawn.
// * It does NOT write coop_lockLoadout. server.scr:28 seeds it only when EMPTY, so once an MP map
//   set it to 0 it would stay 0 for every coop map for the life of the server process.
// * It does NOT touch any ui/*.urc. The stock weapon picker is left exactly as it is and simply
//   never gets a chance to matter, because this file sets the weapon class itself. That keeps the
//   blast radius on coop at literally zero files.
// * [user 2026-09-13, bug-2571] It does NOT use the COOP ARMORY, in any form - no loadoutpick.scr, challenges.scr,
//   xp.scr, helmet.scr, gloves.scr or loadoutskins.scr call. Committing MP picks through loadout_set wrote coop client
//   state on every join (finish chips, padlocks, Axis guns archived as unlocked), and the user has since decided MP
//   gets its OWN Allied and Axis armories: "I don't want allies having access to any non-allied weapons". Until those
//   exist, MP players spawn with the engine's stock class kit. check_mp_isolation.py clause 10 enforces this.
//=========================================================================


//=========================================================================
// Entry. Hooked from global/ambient.scr, which BOTH coop maps and stock MP maps exec - so the
// refusal guard below is load-bearing, not decoration.
//=========================================================================
main:{
	//THE REFUSAL GUARD. Clause 2 of the isolation contract. Even if the ambient.scr hook is ever
	//edited wrongly, this file will not run on a coop map. A guard that exists only at the call
	//site is one careless edit away from being gone.
	if( level.coop_mainScriptLoaded == 1 ){
		println( "^~^~^ MP refused to start - coop is loaded on this map" )
		end
	}

	//[E4, MP armories slice 2] On a map that runs global/ambient.scr, ambient.scr:22 already set
	//level.gametype from g_gametype just above its hook. On a SCRIPT-LESS or third-party MP map the
	//game.dll mp_mapscript_hook (level.cpp Level::ServerSpawned) execs this DIRECTLY and ambient never
	//ran, so level.gametype is NIL here - seed it from g_gametype exactly as ambient does. game.dll
	//gates that hook so it can never fire on a coop map, and the refusal guard above is the backstop.
	if( level.gametype == NIL ){ level.gametype = int( getcvar( g_gametype ) ) }

	//Never single-player.
	if( level.gametype == 0 ){ end }

	//Idempotent - ambient.scr has its own run-once flag, but a map that execs it twice (or ambient AND
	//the E4 hook on the same map) must not start two pollers.
	if( level.coop_mpRun == 1 ){ end }
	level.coop_mpRun = 1

	//[user 2026-09-25] "5 minutes is good": MP bodies linger coop_mpCorpseLinger (engine default now 300s, capped at
	//coop_mpCorpseMax bodies - body.cpp). Every existing profile saved the OLD default 45 (CVAR_ARCHIVE), so lift exactly
	//that value here; a host who chose anything else keeps it. MP-owned cvar set inside mp.scr (isolation clause 12c).
	if( getcvar( "coop_mpCorpseLinger" ) == "45" ){ setcvar "coop_mpCorpseLinger" "300" }

	//[MP modes slice 1] THE MODE SCAFFOLD. The host picks the MP game mode with the cvar coop_mpMode:
	//   "" / "none"  -> today's behaviour EXACTLY (the armory deathmatch path below, byte-identical)
	//   "gungame"    -> FFA Gun Game (coop_mod/mp_gungame.scr)
	//This is a READ only. coop_mp* is MP-owned (isolation clause 12c) and a level load wipes level vars,
	//so the mode can never follow anyone into coop. The dispatch SEAM is three switch labels below -
	//mp_modeGiveKit (spawn-edge kit), mp_modeTick (per-tick), mp_modeOnDeath (death edge) - each a
	//switch on level.coop_mpMode; a later mode adds a case and its own coop_mod/mp_<mode>.scr.
	level.coop_mpMode = "none"
	local.mode = getcvar( "coop_mpMode" )
	if( local.mode != "" && local.mode != "none" ){ level.coop_mpMode = local.mode }

	//[MP presets slice 2] THE WEAPON PRESET MODIFIER (decisions M3/M4/M5). A host cvar that MASKS which
	//primary weapon CLASSES the armory will deploy, and it composes with EVERY armory-based mode (M5 -
	//it is a modifier row, not a mode of its own):
	//   "" / "none"     -> no restriction (today's behaviour EXACTLY)
	//   "rifles"        -> rifle-class primaries only
	//   "snipers"       -> Sniper-class primaries only (P3: the Sniper class is scoped bolt-action AND
	//                      scoped semi-auto rifles; a scoped fully-auto counts toward its base class)
	//   "riflesnipers"  -> both rifle and Sniper classes
	//PISTOLS AND GRENADES STAY LEGAL under every preset (M4). This is a READ only, exactly like the mode
	//above: coop_mp* is MP-owned (isolation clause 12c) and a level load wipes level vars, so the preset
	//can never follow anyone into coop. mp_armory.scr reads level.coop_mpPreset and composes it into its
	//OWN classBanned path (the roster/degrade path it already runs); mp.scr never masks weapons itself.
	//NO-OP for a mode that owns a fixed ladder: Gun Game (M9) hands out its own tier weapons and bypasses
	//the armory, so the preset does not touch its ladder this slice.
	level.coop_mpPreset = "none"
	local.preset = getcvar( "coop_mpPreset" )
	if( local.preset != "" && local.preset != "none" ){ level.coop_mpPreset = local.preset }

	//[MP Spawn Protection] Register an MP DEFAULT of ON (a few seconds of post-spawn invulnerability that
	//drops the moment the player fires) the FIRST time an MP map runs and the host never chose. Only seeds
	//when the cvar is unset ("") - a host who set coop_mpSpawnProtect 0/1 by console keeps their value. This
	//is a setcvar on an MP-owned cvar (coop_mp*, clause 12c) inside mp.scr, which only ever runs on an MP
	//map, so it cannot change a coop server. The mechanic + duration live in coop_mod/mp_spawnprotect.scr
	//(coop_mpSpawnProtTime seconds, default 3); mp_onSpawn calls it on the shared spawn edge.
	if( getcvar( "coop_mpSpawnProtect" ) == "" ){ setcvar "coop_mpSpawnProtect" "1" }

	//[user 2026-09-13, bug-2564] THE COOP FEEL IN MULTIPLAYER - "put all of it into pvp".
	//
	//1. game.* constants. variables.scr seeds these on coop maps only, and weaponstate.scr reads both
	//   (`wait game.ms` on every raise) - unseeded, every weapon raise is a Script Error. game.* persists across
	//   maps, and variables.scr assigns the same values on the next coop map, so this cannot leak.
	if( game.true == NIL ){
		game.ms = 0.0005
		game.true = bool 1
		game.false = !game.true
	}

	//2. THE COOP ANIMATION SET - prone, the ADS raise, sprint, limp and the cover poses live only in
	//   coop_mod/player_legs.st and player_Torso.st. ambient.scr put retail global/mike back just above this
	//   hook. level.coop_stateFileReset = 1 stops weaponstate.scr:9-17 reverting it on the first weapon raise.
	//   No leak: server.scr:23 sets the same value on every coop map, and ambient.scr resets it on the next
	//   non-coop map before this hook runs again. Without it prone was LIVE with no animation - a 0.35x-spread
	//   crouch that nobody could see.
	setcvar "g_statefile" "coop_mod/player"
	level.coop_stateFileReset = 1

	//3. The coop torso's KILLED state now runs player.scr::manageDead (events.scr playerdeath), and 0 sends it
	//   down coop's own last-man-standing-off path. NIL would compare and misbehave.
	level.coop_lmsLives = 0

	//4. STUCK IN SPECTATE AFTER COOP. main.scr's disableAllWeaponsOnMenu sets exactly this value
	//   (itemhandler.scr:3485, every weapon class banned); dmflags is not archived and survives a map change,
	//   so after any coop map in this process primarydmweapon was refused and nobody could spawn. Only that
	//   exact value is cleared - a server's own dmflags are left alone. Coop sets it again on its next map.
	if( int( getcvar( "dmflags" ) ) == 532676608 ){ setcvar "dmflags" "0" }

	//[user 2026-09-18] ENGINE-ENFORCE the weapon preset via dmflags - the airtight layer. The armory preset
	//(presetBansClass) only gates the ARMORY; a player using the stock weapon menu, or a weapon pickup, is
	//gated by the engine DF_WEAPON_NO_* dmflags bits (player.cpp UserSelectWeapon / PrimaryDMWeapon). So we
	//rebuild the class bits (22-28) from level.coop_mpPreset on EVERY arena load - dmflags is not archived and
	//otherwise inherits a stale coop/rifle-only ban across map changes (that is why FT/Dom were rifle-only).
	//Non-weapon dmflags bits are preserved. Bit map: rifle 1<<22, sniper 1<<23, smg 1<<24, mg 1<<25,
	//rocket/heavy 1<<26, shotgun 1<<27, landmine 1<<28; mask of all seven = 532676608.
	local.dfCur = int( getcvar( "dmflags" ) )
	local.dfBase = ( local.dfCur - ( local.dfCur & 532676608 ) )
	local.dfBan = 0
	if( level.coop_mpPreset == "rifles" ){ local.dfBan = 528482304 }        //rifle only (bans sniper+smg+mg+rocket+shotgun+landmine)
	else if( level.coop_mpPreset == "snipers" ){ local.dfBan = 524288000 }  //sniper only
	else if( level.coop_mpPreset == "riflesnipers" ){ local.dfBan = 520093696 } //rifle + sniper only
	setcvar "dmflags" ( "" + ( local.dfBase + local.dfBan ) )

	//[MP armories slice 2] Liveness probe (TRAPS T1). If coop_mod/mp_armory.scr parse-kills, ::alive is
	//unreachable and returns NIL, so level.coop_mpArmoryLive stays 0 and every edge below keeps today's
	//stock rifle deploy - a bad token in the armory strands nobody in spectate.
	level.coop_mpArmoryLive = 0
	local.armLive = waitthread coop_mod/mp_armory.scr::alive
	if( local.armLive == 1 ){ level.coop_mpArmoryLive = 1 }

	//level.script is set by the engine when it runs the map script; on a force-arena map (Push on an SP
	//map, mp_force_arena) that script is skipped, so it is NIL here - use the mapname so the debug line
	//never throws a concat error. A NIL in a `+` chain is a Script Error that aborts the whole statement.
	local.mapDbg = level.script
	if( local.mapDbg == NIL ){ local.mapDbg = getcvar( "mapname" ) }
	println( "^~^~^ MP init gametype=" + level.gametype + " map=" + local.mapDbg + " armory=" + level.coop_mpArmoryLive + " mode=" + level.coop_mpMode + " preset=" + level.coop_mpPreset )

	//[MP bot auto-fill slice] Host-configurable bot BACKFILL (coop_mod/mp_bots.scr). Seeds the LATCHED
	//bot-slot ceiling up-front - sv_maxbots is CVAR_LATCH and gates Recast nav, so it must be > 0 at MAP
	//LOAD for bots to exist and a raise to the fill target only grows the cap next map - then starts the
	//fill manager. No-op unless the host set coop_mpBotFill > 0. Works for EVERY mode (incl. "none") and
	//every MP map because it lives here in the MP framework, guarded end-to-end on coop_mpRun. It writes
	//ONLY the engine sv_* bot cvars (sv_maxbots/sv_numbots/sv_minPlayers - none of them coop state) and
	//reads the MP-owned coop_mpBot* host cvars; it never touches coop's AI / aihandler.
	waitthread coop_mod/mp_bots.scr::seedMaxbots
	thread coop_mod/mp_bots.scr::manage

	//[MP WALK SPEED = COOP PACE, user 2026-09-15] Every MP mode now walks at the SAME speed as coop by
	//default - the tactical pace sv_dmspeedmult 0.6 (matching autoexec.cfg / start_server.cfg), NOT the
	//old full-DM 1.1 (which was 287*1.1 = ~316 vs coop's 287*0.6 = ~172). A host "FAST RUN" toggle
	//(coop_mpFastRun 1) bumps the multiplier to coop_mpFastRunMult (default 0.8 = ~230) - noticeably
	//quicker than the coop crawl but well short of full DM, so the coop SPRINT burst still earns its
	//keep. sv_runspeed stays at the engine default 287 (Hardcore lowers it to 200 and restores it; since
	//BOTH the base and Hardcore scale by dmspeedmult, Hardcore stays ~70% of whatever base is set here,
	//so its relative feel is preserved automatically). Set here in main, so it covers EVERY mode. These
	//cvars persist across maps, so setting them explicitly each MP boot stops a prior coop/Hardcore value
	//following the session; start_server.cfg mirrors the coop values back on return to coop.
	setcvar "sv_runspeed" "287"
	local.mpSpeed = "0.6"
	if( getcvar( "coop_mpFastRun" ) == "1" ){
		local.mpSpeed = getcvar( "coop_mpFastRunMult" )
		if( local.mpSpeed == "" ){ local.mpSpeed = "0.8" }
	}
	setcvar "sv_dmspeedmult" local.mpSpeed
	println( "^~^~^ MP walkspeed dmspeedmult=" + local.mpSpeed + " fastrun=" + getcvar( "coop_mpFastRun" ) )

	//[bug-2712] COOP INSTANT-REGEN LEAK -> everyone invulnerable in MP. coop sets g_healrate 100000
	//(server.cfg / start_server.cfg, and itemhandler.scr re-applies it) so health packs apply instantly and
	//players never chase pickups. The engine treats BOTH 0 and very large values as INSTANT heal
	//(player.cpp/health.cpp), so in PvP every player AND bot heals bullet damage faster than it lands - the
	//whole server is invulnerable to sustained fire, and only a single burst that exceeds one frame's heal (a
	//grenade) can kill. This is the real cause of the "nothing dies" reports (the DBNO 9999 pool was a second
	//layer, now default off). Reset to the MP-normal GRADUAL rate each MP boot; like sv_runspeed above it
	//persists across maps and start_server.cfg mirrors the coop value back on return to coop. NEVER 0 (0 is
	//also instant).
	local.hrWas = getcvar( "g_healrate" )
	setcvar "g_healrate" "10"
	println( "^~^~^ MP g_healrate reset to 10 (was " + local.hrWas + " - coop instant-regen leak, bug-2712)" )

	//[MP Hardcore modifier slice] The HARDCORE host toggle (coop_mpHardcore 0/1) - a modifier that composes
	//with EVERY mode, like the weapon presets. Its manager publishes the serverinfo flag g_mpHardcore (the
	//cgame hides the crosshair + health/stamina chrome when set) and lowers sv_runspeed while on, restoring
	//it when off. Guarded end-to-end on coop_mpRun (only reachable from here, which set it) and a run-once
	//flag; a no-op when the host never enables it. Half health is applied per player from mp_onSpawn below.
	thread coop_mod/mp_hardcore.scr::manage

	//[MP Single-Round Ammo modifier] Subscribe player_killed once so a kill refills the killer to one round
	//(the spawn-edge cap is applied per player in mp_onSpawn). One-Shot needs no manager (pure spawn edge).
	//Both are host toggles that compose on top of every compatible mode; guarded end-to-end on coop_mpRun.
	thread coop_mod/mp_oneammo.scr::init

	//[MP realism toggles slice] The four host "realism" toggles (coop_mpNoAds / coop_mpNoProne /
	//coop_mpNoCover / coop_mpNo3p). Its manager composes them into the serverinfo bitmask g_mpRealismOff
	//(the engine drops the ADS view / blocks prone-cover / forces first person per bit, MP-only). Guarded
	//end-to-end on coop_mpRun (only reachable from here, which set it) and a run-once flag; a no-op when the
	//host enables none of them. Composes with every mode, like Hardcore and the weapon presets.
	thread coop_mod/mp_realism.scr::manage

	//[DBNO default OFF - 2026-09-18] DBNO raises every player/bot to a 9999 absorption pool (mp_dbno.scr) so a
	//lethal hit becomes a DOWN. But the down/death trigger does not fire reliably in MP, so the pool just makes
	//EVERYONE effectively invulnerable ("nothing takes damage"). Until the down is fixed, DBNO must NOT default
	//on - it breaks combat in every MP mode. It stays a host toggle (Host Rules checkbox); a host who sets it
	//explicitly still gets it. Medkits are unaffected and keep their default-on.
	if( getcvar( "coop_mpDbno" ) == "" ){ setcvar "coop_mpDbno" "0" }
	if( getcvar( "coop_mpMedkits" ) == "" ){ setcvar "coop_mpMedkits" "1" }

	//[Dynamic Weather in MP - 2026-09-18] Host toggle coop_mpWeather. MP maps load script-less so the coop weather
	//starter + per-map theme never run; mp_weather.scr supplies both and reaches the shared coop renderer (MP->MP,
	//then the allowlisted weather.scr::coop_weather_init). There is NO menu row for it yet (bug-2936) - console only.
	//HISTORY: default OFF after bug-2710 (a listen-client crash loading m2l1 Push, pinned on SNOW, which bug-2796 now
	//skips in MP); ON briefly (bug-2936); OFF again (bug-2939) because weather's spawn wait took the COOP branch of
	//replace.scr::waitTillSpawn on a CAMPAIGN-map arena and booted the coop framework mid-match, re-teaming every
	//player and bot to Allies at coop health 750.
	//[2026-09-26, bug-2968] DEFAULT ON. Fixed at the root: waitTillSpawn, global/weather.scr and weather's MP entry
	//never touch coop main while coop_mpRun is set. Proven by headless 10-bot Push soaks on m4l2 (rain) and e1l1
	//(sand): no coop main load, teams 5/5 throughout, kills, Script Errors at the weather-off baseline. Snow maps
	//still skip weather (mp_weather.scr). A host turns it off with coop_mpWeather 0.
	if( getcvar( "coop_mpWeather" ) == "" ){ setcvar "coop_mpWeather" "1" }
	thread coop_mod/mp_weather.scr::mp_weather_init

	//[MP Progression slice 1] Kill-attribution session counters. THREADED (not waitthread) and in its
	//own file: it subscribes to the player_killed delegate, which the mp.scr header flags as unproven
	//here - so a throw there is a Script Error that skips only its own statement and never touches this
	//poll. A no-op today beyond crediting in-memory counters; slice 3 signs+carries them (arch A),
	//slice 4/5 turn them into challenges and armory unlocks. Guarded end-to-end on coop_mpRun.
	thread coop_mod/mp_progression.scr::init

	//[user 2026-09-16] CLEAR CAMPAIGN AI. Modes on the SP campaign maps launch them as script-less arenas
	//(sv_mpForceArena), so the map SCRIPT that would set up/patrol the AI never runs - but the bsp's own
	//`Actor` entities still spawn and, with no script, attack the player on sight. MP has no AI by design, so
	//sweep them here before the first player spawns. Guarded by coop_mpRun (this whole thread), so coop AI is
	//never touched; MP bots are class "Player", not "Actor", so they are untouched too. No-op on the dm/mp_*
	//and mohdm* maps (no Actors). Re-swept briefly to catch any that finish spawning a frame or two late.
	waitthread mp_clearArenaAI

	//[user 2026-09-21] ARENA FIXUP: the ported SP maps run script-less, so a vehicle the SP script would have
	//DRIVEN AWAY (tanks/trucks/half-tracks) stays frozen solid in a path/chokepoint and bots pile against it
	//("stuck on the tank"). Walk the entity list and make every scenic vehicle non-solid so bots/players pass
	//through. BEFORE mp_vehicles::onMapInit, so it only touches the map's pre-placed props, never the drivable/
	//mannable vehicles that mode adds. Self-gated on coop_mpRun; a no-op on the dm/mohdm* maps (no such props).
	waitthread coop_mod/mp_arenafix.scr::mp_arenafix

	//[MP mode ONE-TIME init, pre-spawn] Some modes must set up the level BEFORE the first player spawns
	//(e.g. Push on the converted SP maps has to script-spawn its team spawn points - those bsps carry
	//none, so without this the first spawn has nowhere to go). Runs here in main (prespawn), guarded on
	//coop_mpRun; a no-op for modes with no init. Separate from the per-player mp_modeGiveKit seam.
	waitthread mp_modeInit

	//[bug-2786/2794] START ENVIRONMENTAL AMBIENCE FOR EVERY MODE. Previously only mp_push.scr called
	//mp_ambience::start, so Freeze Tag / rifles / every non-push arena was dead silent. DEFERRED (not called
	//here at prespawn) because the levelwide emitter must spawn/anchor AFTER the level is populated - doing it
	//at prespawn made it spawn/anchor on none and threw script errors. Push starts its own positional bed in
	//its mode init; mp_ambStartDeferred covers the other modes once a player exists (or after a grace).
	thread mp_ambStartDeferred

	//[DMG PROBE] global health tracer for the "nothing dies" investigation. Threaded once here; gated per
	//iteration on coop_mpDmgProbe so it is silent until enabled AND then immediately watches every ALREADY-alive
	//player/bot (a per-spawn probe cannot, because the stuck-invulnerable entities never respawn to attach it).
	thread mp_dmgProbeLoop

	//[MP Vehicles] cross-mode emplacements/pickups (host toggle coop_mpVehicles). AFTER mp_modeInit so any
	//script-spawned team spawns exist; a no-op unless enabled and the map has an authored layout. Guarded
	//on coop_mpRun inside the file, so it can never touch a coop map.
	waitthread coop_mod/mp_vehicles.scr::onMapInit

	//[user 2026-09-18] TIMED server map rotation (coop_mpRotate 1). Self-gates + resumes its banked elapsed
	//time across the per-match reloads; a no-op on listen play (cvar unset). Push keeps its own side-swap
	//rotation (mp_push.scr) and does not set coop_mpRotate.
	thread coop_mod/mp_rotate.scr::rotateTimer

	thread mp_manage
}end


//=========================================================================
// The per-player poll.
//
// DELIBERATELY A POLL, not the engine's player_spawned delegate. The poll watches PER-PLAYER STATE
// every tick (team/alive edges, mode ticks), not just discrete events, so it is the right shape here
// regardless - and polling is what player.scr::manage has used since [200]. NOTE: the delegate form is
// no longer unproven - coop_mod/mp_progression.scr subscribes to `player_killed` and it was verified
// firing (self=victim, 11 args) on a 2026-09-14 bot match. So a future event-driven hook is now a
// viable option for discrete edges; this poll stays for the per-tick state it owns.
//=========================================================================
//=========================================================================
// [bug-2794] Deferred environmental-ambience start for the non-Push modes. Calling mp_ambience::start at
// prespawn (from mp.scr::main) made its levelwide emitter spawn/anchor on `none` (no players, model not
// ready) and threw 'loopsound applied to NIL'. Wait until the level is populated (or a short grace for a
// bot-only lobby), then start it once. Push starts its own positional bed in its mode init; the
// coop_mpAmbienceOn guard inside start() keeps this a no-op if that already ran.
//=========================================================================
mp_ambStartDeferred:{
	local.t = 0
	while( level.coop_mpRun == 1 && local.t < 30 ){
		if( level.coop_mpAmbienceOn == 1 ){ end }
		if( $player != NULL && $player.size >= 1 ){
			waitthread coop_mod/mp_ambience.scr::start
			end
		}
		wait 0.5
		local.t = ( local.t + 1 )
	}
	if( level.coop_mpRun == 1 && level.coop_mpAmbienceOn != 1 ){
		waitthread coop_mod/mp_ambience.scr::start
	}
}end


mp_manage:{
	//let the first clients finish connecting
	wait 1

	while( 1 ){
		//$player.size is -1 on an EMPTY array, never 0, so this loop simply does not run with
		//nobody connected. Never test .size == 0 in this engine.
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p == NULL ){ continue }
			waitthread mp_tickPlayer local.p
		}
		wait 0.5
	}
}end


//=========================================================================
// One player, one tick. Two edges are watched: the TEAM flip, and the SPAWN.
//=========================================================================
mp_tickPlayer local.p:{
	if( local.p == NULL ){ end }

	//[bug-3198, bug-3162] MP SESSION FLAG FROM THE FIRST TICK, not only from the first spawn. cgame's hzm_armory (F7)
	//opens the side's MP armory only while the client cvar coop_mp_session is 1, CG_Init zeroes it on every
	//connect, and mp_onSpawn used to be its only setter - so a spectator, or a player held in the armory before
	//deploying, got the COOP armory. Same recipe as coop's compass flag (player.scr ::manage, coop_isCoopSession):
	//re-push every 2 s, because a stuff sent before the client's cgame is up is lost. Humans only; plain set.
	if( isBot( local.p ) != 1 ){
		if( local.p.flags["coop_mpSessNext"] == NIL ){ local.p.flags["coop_mpSessNext"] = 0 }
		if( level.time >= local.p.flags["coop_mpSessNext"] ){
			local.p.flags["coop_mpSessNext"] = level.time + 2
			local.p stufftext "set coop_mp_session 1"
		}
	}

	// ---- name bus ----------------------------------------------------------------------------
	//[armory slice 2] When the armory is live the dispatcher owns the name bus: it reads the ,q pick
	//markers (which mp_cleanName would otherwise strip before they were seen) and then cleans the name.
	//[MP modes slice 1] A game MODE bypasses the armory entirely (Gun Game owns its own kit), so the
	//armory name bus is skipped when a mode is active and the name is simply cleaned instead. When
	//coop_mpMode == "none" this is byte-identical to before (armoryLive gate unchanged).
	//[user 2026-09-16] the armory drives EVERY mode that deploys the committed loadout (not just "none"):
	//in a game mode the player used to be force-deployed and the loadout screen slammed shut before they
	//could pick (mp_deploy's popmenu). Now the same hold/commit path runs for any armory-using mode.
	local.usesArmory = waitthread mp_modeUsesArmory
	if( level.coop_mpArmoryLive == 1 && local.usesArmory == 1 ){
		waitthread coop_mod/mp_armory.scr::tickPlayer local.p
		if( local.p == NULL ){ end }
	}
	//[bug-2571] No armory: a saved name can carry coop armory tokens (" ,w136" and friends) from the
	//main-menu armory. They are STRIPPED so they never reach the scoreboard, and nothing is committed.
	else if( waitthread coop_mod/main.scr::containsText local.p.netname " ," 0 ){
		thread mp_cleanName local.p
	}

	// ---- edge 1: the player picked a team -------------------------------------------------
	local.team = local.p.dmteam
	if( local.team == NIL ){ local.team = "" }

	local.prevTeam = local.p.flags["coop_mpTeam"]
	if( local.prevTeam == NIL ){ local.prevTeam = "" }

	if( local.team != local.prevTeam ){
		local.p.flags["coop_mpTeam"] = local.team

		if( local.team != "" && local.team != "spectator" ){
			//[user 2026-09-15] HOLD IN THE ARMORY instead of force-spawning. Old behaviour deployed a
			//rifle here the instant you joined, which spawned you out from under the armory the E5 engine
			//redirect had just opened - so the loadout screen "disappeared quickly" with no time to pick.
			//Now a HUMAN on the armory DM path (mode none, armory live) is instead handed to the armory's
			//own hold: it keeps you in spectate with the screen open, and mp_armory.scr::tickPlayer deploys
			//you when you press DONE/DEPLOY (the ,qad marker) or after the 25s idle timeout. A BOT (no UI),
			//an actual game MODE (the mode owns the kit), or a parse-killed armory (coop_mpArmoryLive 0)
			//all keep the immediate stock deploy - so nobody is ever stranded in spectate (TRAPS T1).
			local.usesArmory = waitthread mp_modeUsesArmory
			if( level.coop_mpArmoryLive == 1 && local.usesArmory == 1 && isBot( local.p ) != 1 ){
				waitthread coop_mod/mp_armory.scr::onTeamFlip local.p
			} else {
				//The engine will not let a player leave spectator until dm_primary holds a legal CLASS, and
				//the mod's ui override leaves the stock picker empty; EventPrimaryDMWeapon self-deploys.
				waitthread mp_deploy local.p
			}
		}
	}

	// ---- edge 2: he just came alive -------------------------------------------------------
	local.alive = 0
	//[bug-2564] health alone is NOT alive: a spectator carries full health (player.cpp:11115-11117), so this used
	//to fire mp_onSpawn on the spectator before he picked a team, and his real first spawn was never an edge.
	if( local.p.health > 0 && !local.p.isSpectator ){ local.alive = 1 }

	local.wasAlive = local.p.flags["coop_mpAlive"]
	if( local.wasAlive == NIL ){ local.wasAlive = 0 }

	local.p.flags["coop_mpAlive"] = local.alive

	//[bug-2564] the falling edge ends this life: the monitors stop (they loop only while coop_isActive is 1),
	//exactly as player.scr::manageDead does at :1624 - belt and braces for any death path that skips it - and
	//the next life is owed a kit again
	if( local.alive == 0 && local.wasAlive == 1 ){
		local.p.flags["coop_isActive"] = 0 - 2
		//[MP modes slice 1] the death edge - the per-"kill" mode seam (the victim just died).
		if( level.coop_mpMode != "none" ){
			waitthread mp_modeOnDeath local.p
			if( local.p == NULL ){ end }
		}
	}

	if( local.alive == 1 && local.wasAlive == 0 ){
		waitthread mp_onSpawn local.p
		if( local.p == NULL ){ end }
	}

	//[MP modes slice 1] the per-tick mode seam. Runs for every player every poll so a mode can watch
	//kills/tiers even for players who did not die this tick (Gun Game reads the getkills delta here).
	if( level.coop_mpMode != "none" ){
		waitthread mp_modeTick local.p
		if( local.p == NULL ){ end }
	}
}end


//=========================================================================
// Get him out of spectate with a legal weapon class.
//
// "rifle" is the safe default: it is the one class no shipped dmflags configuration bans, and
// EventPrimaryDMWeapon REFUSES and returns without writing dm_primary if the class is banned -
// which would park the player in spectate permanently rather than fail loudly.
//=========================================================================
mp_deploy local.p:{
	if( local.p == NULL ){ end }

	if( local.p == NULL ){ end }
	local.p primarydmweapon "rifle"

	//[bug-2564] THE STRAY CURSOR. Joining a team with an empty dm_primary makes the engine stuff
	//`wait 250;pushmenu SelectPrimaryWeapon` (player.cpp:11406), and the mod's own ui override makes that an empty
	//shell that still takes the mouse. A bare `popmenu 0` here landed BEFORE that push, or inside PushMenu's lock
	//where PopMenu returns silently (uimenu.cpp:550/599). Server stufftext APPENDS to the client's buffer and
	//`wait` pauses the whole buffer, so these run after the engine's push has completed; the second pop covers a
	//first one that lands inside the lock. CG_IsStatementAllowed checks each ;-separated statement, and both wait
	//and popmenu are on its allow list.
	local.p stufftext "wait 300;popmenu 0;wait 300;popmenu 0"

	//If that was refused he is still a spectator a moment later. "auto" picks a random ALLOWED
	//class and self-deploys, so it cannot be refused by a ban.
	wait 1
	if( local.p == NULL ){ end }
	if( local.p.dmteam == "spectator" ){ end }
	//[bug-2564] isSpectator, not health - a spectator has FULL health (player.cpp:11115), so the old test never
	//saw a refused deploy at all
	if( !local.p.isSpectator ){ end }
	//Objective, Round, TOW and Liberation hold a teamed player in spectate until the next wave; re-rolling his
	//class there would be wrong. Team Match (2) spawns at once, so only there does "still spectating" mean refused.
	if( level.gametype != 2 ){ end }

	println( "^~^~^ MP deploy fallback for e" + local.p.entnum + " - rifle was refused" )
	local.p primarydmweapon "auto"
}end


//=========================================================================
// [user 2026-09-16] Does the current MP mode let the player choose an armory LOADOUT? "none" (DM/TDM) and
// every objective/round mode that deploys the committed kit through mp_armory.scr::giveKit DO -> the
// armory hold + name-bus run for them, so a player can pick before spawning. Gun Game owns a fixed tier
// ladder and Prop Hunt assigns role kits (props are weaponless), so those keep the immediate stock deploy.
// Returns 1/0 (int into a local before end - bug-2603).
//=========================================================================
mp_modeUsesArmory:{
	local.v = 1
	if( level.coop_mpMode == "gungame" ){ local.v = 0 }
	if( level.coop_mpMode == "prophunt" ){ local.v = 0 }
	if( level.coop_mpMode == "buildabase" ){ local.v = 0 }
	if( level.coop_mpMode == "snd" ){ local.v = 0 }
	if( level.coop_mpMode == "cyberattack" ){ local.v = 0 }
}end local.v


//=========================================================================
// Every respawn, after the engine has already handed out the stock class kit.
//
// Health FIRST, because `health <n>` also writes max_health (entity.cpp:1938 - the same behaviour
// dbno.scr:191 documents from the other direction, where a bare `health 100` silently collapsed a
// coop player's max from 750). That is exactly what is wanted here: MP is a 100 HP game.
//=========================================================================
mp_onSpawn local.p:{
	if( local.p == NULL ){ end }

	//[user 2026-09-09] MP health is 100, not coop's 750. PER PLAYER - see the header for why the
	//cvar route would follow him into the next coop map.
	//[armory slice 2] When the armory is live the dispatcher hands out the committed kit (or the free
	//starter / a bot's random free-tier gun) with `takeall` + `item`, tops up ammo, AND sets health 100
	//in the same give. Never giveInventory / changeGameType (header) and never the coop_health cvar
	//(clause 4). Without a live armory, health alone - the engine's stock class kit stands.
	//[MP modes slice 1] a game MODE owns the spawn kit and bypasses the armory entirely (Gun Game
	//hands out the current-tier weapon with its own takeall + item + ammo + health 100).
	if( level.coop_mpMode != "none" ){
		waitthread mp_modeGiveKit local.p
		if( local.p == NULL ){ end }
	}
	else if( level.coop_mpArmoryLive == 1 ){
		waitthread coop_mod/mp_armory.scr::giveKit local.p
		if( local.p == NULL ){ end }
	}
	else{
		local.p health 100
	}

	//[MP Hardcore modifier slice] HALF HEALTH. Runs AFTER the kit give above (which set health 100), so it
	//overrides to 50 when the host enabled Hardcore. Per player, never a cvar - it cannot follow anyone into
	//coop (header / isolation clause 4). Composes with every mode because it sits on the shared spawn edge.
	waitthread coop_mod/mp_hardcore.scr::onSpawn local.p
	if( local.p == NULL ){ end }

	//[MP One-Shot modifier] INSTAGIB. Runs AFTER Hardcore's half-health, so at 1 hp it wins when both are on -
	//any hit from any weapon is then lethal. Per player, never a cvar; composes with every mode on this edge.
	waitthread coop_mod/mp_oneshot.scr::onSpawn local.p
	if( local.p == NULL ){ end }

	//[MP Single-Round Ammo modifier] Cap the primary to one round (refill on kill). AFTER the kit give, and a
	//no-op on the modes that own their weapons (Gun Game / Prop Hunt / Build-A-Base / S&D / Cyber Attack).
	waitthread coop_mod/mp_oneammo.scr::onSpawn local.p
	if( local.p == NULL ){ end }

	//[user 2026-09-13, bug-2564] THIS LIFE'S MONITORS - the ones coop starts from player.scr manageSetup /
	//manageAliveSpawning: the ADS walk slowdown, wounded breathing, tinnitus and the injured muffle. Each loops
	//only while coop_isActive == 1 and exits once a death sets it to -2, so one assignment per life starts them
	//and one death ends them - no stacking. (The coop_limpWarn red banner that used to start here is retired:
	//[user 2026-09-27] the injury cues are loading-screen hints now.)
	//NOT coop_isHost, ever: that flag unlocks dev godmode, noclip and give_all (developer.scr).
	local.p.flags["coop_isActive"] = 1
	//[user 2026-09-17] These are FIRST-PERSON immersion effects (ADS walk-slow, wounded breathing, tinnitus,
	//injured muffle, limp) - they only make sense for a HUMAN behind the screen. On BOTS they are pointless
	//and actively harmful: the wounded-breath "cough" was audible to nearby humans (the reported "injured
	//cough at full health" was actually OTHER injured bots), and the limp slowed bots so they struggled to
	//move. So start them for humans only; a bot gets none of them. Coop is untouched (this is the MP path).
	if( isBot( local.p ) != 1 ){
		thread coop_mod/ads.scr::coop_ads_monitor local.p
		thread coop_mod/painbreath.scr::wounded_monitor local.p
		thread coop_mod/tinnitus.scr::coop_tinnitus_monitor local.p
		thread coop_mod/tinnitus.scr::coop_injured_muffle_monitor local.p
	}

	//the same audio safety net coop runs on every (re)spawn (player.scr:1357/1366): a muffle or a duck cut short
	//by a death must never leave this player's world sound stuck down. Defaulted, because on a server without
	//the mod's autoexec an empty value would set s_volume to nothing.
	local.bv = getcvar( "coop_tinnitusBaseVol" )
	if( local.bv == "" ){ local.bv = "0.9" }
	local.p stufftext ( "s_volume " + local.bv )
	local.p stufftext "s_sfxduck 1"

	//[user 2026-09-17] MODERN COMPASS in MP: switch on the top compass bar for this client - the SAME bar coop
	//uses. cgame's CG_DrawCompassBar honours coop_mpCompass as the MP analog of coop_isCoopSession (engine hook
	//mp_compass_session), so MP gets the modern bar + objective/teammate markers in place of the stock round
	//ring. Client cvar; cgame zeroes it on a map change and this re-sets it each spawn (respawns are frequent,
	//and it stays set once it lands). Plain set, never seta - it must never reach the player's config. coop_mp*
	//token = MP-owned, legal in an MP file. Respects the player's coop_compassBar pref (off = they keep the ring).
	local.p stufftext "set coop_mpCompass 1"

	//[bug-3080] MP ARMORY ON F7. cgame's hzm_armory (the F7 bind) opens this side's MP armory only while the client
	//cvar coop_mp_session is 1 - otherwise it falls through to the COOP armory. CG_Init zeroes it on every connect
	//(so a session never leaks into coop), and nothing set it: the armories plan's setter was never written. Set it
	//here, the same way and for the same reasons as coop_mpCompass above: plain set, re-sent on every spawn.
	local.p stufftext "set coop_mp_session 1"

	//[MP DBNO / Medkits host toggles] Both are PORTS of the coop systems into MP-owned files
	//(coop_mod/mp_dbno.scr, coop_mod/mp_medkits.scr) - they call no coop code and touch no coop state.
	//Run LAST on the spawn edge so max_health is final (the mode/armory kit set 100, Hardcore may have
	//dropped it to 50): mp_dbno reads it as the interception ceiling, mp_medkits as the heal ceiling.
	//Each is a no-op unless its host cvar (coop_mpDbno / coop_mpMedkits) is on; DBNO also stands aside
	//under Freeze Tag (that mode already replaces death with a revivable state). Both files self-guard
	//their per-life monitors on coop_mpRun via level state, so nothing here can leak into coop.
	waitthread coop_mod/mp_dbno.scr::onSpawn local.p
	if( local.p == NULL ){ end }
	waitthread coop_mod/mp_medkits.scr::onSpawn local.p
	if( local.p == NULL ){ end }

	//[MP Spawn Protection host toggle] Brief post-spawn invulnerability (coop_mpSpawnProtect seconds, 0 =
	//off), dropped the moment the player fires. MP-owned port (coop_mod/mp_spawnprotect.scr); a no-op
	//unless the host enabled it; self-guarded on coop_mpRun + the coop_isActive life flag so it never
	//leaks past a life or into coop. Runs last so it wraps the fully-kitted player.
	waitthread coop_mod/mp_spawnprotect.scr::onSpawn local.p
	if( local.p == NULL ){ end }

	//[armory slice 2] the kit itself is given above via mp_armory.scr::giveKit when the armory is live.
}end


//[DMG PROBE] global singleton. Scans every connected player/bot at 10 Hz and prints each health CHANGE, so a
//playtest log shows exactly what happens when a shot connects: health that never drops = damage not landing;
//health that dips then climbs back = a heal. Gated per iteration on coop_mpDmgProbe so it is silent (near-zero
//cost) until the host sets coop_mpDmgProbe 1, and it then watches entities that are ALREADY alive. Per-player
//last-seen health lives in a flag; cleared when the probe is off so re-enabling starts fresh.
mp_dmgProbeLoop:{
	if( level.coop_mpDmgProbeLoopOn == 1 ){ end }
	level.coop_mpDmgProbeLoopOn = 1
	while( level.coop_mpRun == 1 ){
		if( getcvar( "coop_mpDmgProbe" ) == "1" ){
			for( local.i = 1; local.i <= $player.size; local.i++ ){
				local.p = $player[local.i]
				if( local.p == NULL ){ continue }
				local.h = local.p.health
				local.prev = local.p.flags["coop_mpDmgProbeLast"]
				if( local.prev != NIL && local.h != local.prev ){
					println( "^~^~^ DMGPROBE e" + local.p.entnum + " team=" + local.p.dmteam + " alive=" + ( isAlive local.p ) + " hp " + local.prev + " -> " + local.h )
				}
				local.p.flags["coop_mpDmgProbeLast"] = local.h
			}
		}
		wait 0.1
	}
}end


//=========================================================================
// [bug-2571] STRIP COOP ARMORY TOKENS FROM A MULTIPLAYER NAME.
//
// Replaces mp_giveKit / mp_kitIfDue / mp_hostSeed / mp_readPicks, which committed MP picks through the coop armory
// (loadoutpick.scr::loadout_set) and so wrote coop client state on every join. A player's saved name can still carry
// ,w / ,f tokens from the main-menu armory, so the name is cleaned - playerCleanName is a pure string helper that cuts
// at the first " ," - and NOTHING is committed.
//
// Coop's own dispatcher (player.scr::manageNamechange / playerNameCommand) never runs here and must not: it also
// serves teleport-onto-player, a free DBNO heal and ammo crates to any client who types the token.
// A busy flag and a one-second hold keep two polls from cleaning the same name twice before the client answers.
//=========================================================================
mp_cleanName local.p:{
	if( local.p == NULL ){ end }
	if( local.p.flags["coop_mpCleaning"] == 1 ){ end }
	local.p.flags["coop_mpCleaning"] = 1

	local.clean = waitthread coop_mod/player.scr::playerCleanName local.p.netname
	if( local.p == NULL ){ end }
	if( local.clean != NIL && local.clean != "" ){
		local.p stufftext ( "set name " + local.clean )
	}

	wait 1
	if( local.p != NULL ){ local.p.flags["coop_mpCleaning"] = NIL }
}end


//=========================================================================
// [MP modes slice 1] THE MODE DISPATCH SEAM. Three labels, each a switch on level.coop_mpMode, are
// the only places mp.scr knows a specific mode. A later mode (Rifles preset, KOTH, S&D, LMS, ...)
// adds a `case "<mode>":` in each and ships its own coop_mod/mp_<mode>.scr with mode_onSpawn /
// mode_think / mode_onDeath. Keeping the seam here (rather than a dynamic file name, which the engine
// cannot thread) means mp.scr stays the single owner of the poll and the edges.
//=========================================================================

//=========================================================================
// CLEAR CAMPAIGN AI on an MP arena. See the call site in main: force-arena launches SP campaign maps
// script-less, so the map's AI setup never runs but the bsp's `Actor` entities still spawn and attack.
// One synchronous sweep now (single frame - safe in main), then a short threaded re-sweep for stragglers.
//=========================================================================
mp_clearArenaAI:{
	if( level.coop_mpRun != 1 ){ end }
	waitthread mp_sweepAI
	thread mp_clearArenaAILate
}end


//one full pass: delete every live "Actor" (AI) entity. getentarray "classname" returns nothing at runtime
//(maptest_phase2/wounded notes), so walk entnums with getentbyentnum. `delete` routes to Actor::Remove.
mp_sweepAI:{
	local.n = 0
	local.max = int( getcvar( "maxentities" ) )
	if( local.max <= 0 ){ local.max = 1024 }
	local.i = 0
	while( local.i < local.max ){
		local.e = getentbyentnum local.i
		if( local.e != NULL && local.e != NIL ){
			if( local.e.classname == "Actor" ){
				local.e delete
				local.n = ( local.n + 1 )
			}
		}
		local.i = ( local.i + 1 )
	}
	if( local.n > 0 ){ println( "^~^~^ MP cleared " + local.n + " campaign AI" ) }
}end


//re-sweep for a few frames: a handful of bsp actors can finish spawning a frame or two after ServerSpawned.
mp_clearArenaAILate:{
	if( level.coop_mpRun != 1 ){ end }
	local.k = 0
	while( local.k < 6 ){
		waitframe
		if( level.coop_mpRun != 1 ){ end }
		waitthread mp_sweepAI
		local.k = ( local.k + 1 )
	}
}end


//one-time pre-spawn init: the mode sets up the level before any player spawns (called once from main).
//Only modes that need it declare a mode_init; the rest are absent from this switch and it is a no-op.
mp_modeInit:{
	switch( level.coop_mpMode ){
		case "push":
			waitthread coop_mod/mp_push.scr::mode_init
			break
		case "baseassault":
			waitthread coop_mod/mp_baseassault.scr::mode_init
			break
		case "prophunt":
			waitthread coop_mod/mp_prophunt.scr::mode_init
			break
		case "buildabase":
			waitthread coop_mod/mp_buildabase.scr::mode_init
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_init
			break
		case "cyberattack":
			waitthread coop_mod/mp_cyberattack.scr::mode_init
			break
		case "countdown":
			waitthread coop_mod/mp_countdown.scr::mode_init
			break
	}
}end


//spawn-edge kit: the mode owns the give (called from mp_onSpawn)
mp_modeGiveKit local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_onSpawn local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_onSpawn local.p
			break
		case "cyberattack":
			waitthread coop_mod/mp_cyberattack.scr::mode_onSpawn local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_onSpawn local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_onSpawn local.p
			break
		case "domination":
			waitthread coop_mod/mp_domination.scr::mode_onSpawn local.p
			break
		case "countdown":
			waitthread coop_mod/mp_countdown.scr::mode_onSpawn local.p
			break
		case "assassination":
			waitthread coop_mod/mp_assassination.scr::mode_onSpawn local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_onSpawn local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_onSpawn local.p
			break
		case "demolition":
			waitthread coop_mod/mp_demolition.scr::mode_onSpawn local.p
			break
		case "ctf":
			waitthread coop_mod/mp_ctf.scr::mode_onSpawn local.p
			break
		case "buildabase":
			waitthread coop_mod/mp_buildabase.scr::mode_onSpawn local.p
			break
		case "baseassault":
			waitthread coop_mod/mp_baseassault.scr::mode_onSpawn local.p
			break
		case "prophunt":
			waitthread coop_mod/mp_prophunt.scr::mode_onSpawn local.p
			break
	}
}end

//per-tick hook: the mode watches kills/tiers (called from mp_tickPlayer every poll)
mp_modeTick local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_think local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_think local.p
			break
		case "cyberattack":
			waitthread coop_mod/mp_cyberattack.scr::mode_think local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_think local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_think local.p
			break
		case "domination":
			waitthread coop_mod/mp_domination.scr::mode_think local.p
			break
		case "countdown":
			waitthread coop_mod/mp_countdown.scr::mode_think local.p
			break
		case "assassination":
			waitthread coop_mod/mp_assassination.scr::mode_think local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_think local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_think local.p
			break
		case "demolition":
			waitthread coop_mod/mp_demolition.scr::mode_think local.p
			break
		case "ctf":
			waitthread coop_mod/mp_ctf.scr::mode_think local.p
			break
		case "buildabase":
			waitthread coop_mod/mp_buildabase.scr::mode_think local.p
			break
		case "prophunt":
			waitthread coop_mod/mp_prophunt.scr::mode_think local.p
			break
		case "baseassault":
			waitthread coop_mod/mp_baseassault.scr::mode_think local.p
			break
	}
}end

//death-edge hook: the victim just died (called from mp_tickPlayer on the alive->dead edge)
mp_modeOnDeath local.p:{
	if( local.p == NULL ){ end }
	switch( level.coop_mpMode ){
		case "gungame":
			waitthread coop_mod/mp_gungame.scr::mode_onDeath local.p
			break
		case "snd":
			waitthread coop_mod/mp_snd.scr::mode_onDeath local.p
			break
		case "cyberattack":
			waitthread coop_mod/mp_cyberattack.scr::mode_onDeath local.p
			break
		case "lms":
			waitthread coop_mod/mp_lms.scr::mode_onDeath local.p
			break
		case "koth":
			waitthread coop_mod/mp_koth.scr::mode_onDeath local.p
			break
		case "domination":
			waitthread coop_mod/mp_domination.scr::mode_onDeath local.p
			break
		case "countdown":
			waitthread coop_mod/mp_countdown.scr::mode_onDeath local.p
			break
		case "assassination":
			waitthread coop_mod/mp_assassination.scr::mode_onDeath local.p
			break
		case "push":
			waitthread coop_mod/mp_push.scr::mode_onDeath local.p
			break
		case "freezetag":
			waitthread coop_mod/mp_freezetag.scr::mode_onDeath local.p
			break
		case "demolition":
			waitthread coop_mod/mp_demolition.scr::mode_onDeath local.p
			break
		case "ctf":
			waitthread coop_mod/mp_ctf.scr::mode_onDeath local.p
			break
		case "buildabase":
			waitthread coop_mod/mp_buildabase.scr::mode_onDeath local.p
			break
		case "prophunt":
			waitthread coop_mod/mp_prophunt.scr::mode_onDeath local.p
			break
		case "baseassault":
			waitthread coop_mod/mp_baseassault.scr::mode_onDeath local.p
			break
	}
}end
