//=========================================================================
// MP_MAPTITLES.SCR - thematic display titles for the single-player campaign maps run as MP Push arenas
// (user 2026-09-19: "have actual map names versus things like t3l1... thematic, reflect the theater/combat").
// RULE (user 2026-09-23): creative names are welcome, but a REAL place name must be where the mission actually is -
// verify against the map's own worldspawn "message" title (bug-2851: Monte Battaglia/Gothic Line/Fort Schmerzen/
// Casbah/Algiers/Emmerich/Saint-Lo/Dog Green were invented and several were wrong).
// title(map) returns the display name for the rotation announce, the Push HUD and (later) the map picker;
// an unknown map falls back to its raw id so nothing ever shows blank. Pure read-only string lookup.
//=========================================================================

//canary (TRAPS T1).
alive:{
	end 1
}end

title local.map:{
	local.m = local.map
	//--- Live Push maps ---
	if( local.m == "m1l2b" ){ end "Desert Ambush" }		// N. Africa - wreck the Opel supply convoy
	if( local.m == "m2l1"  ){ end "Frozen Harbor" }		// Norway snow - the gated naval base
	if( local.m == "m3l3"  ){ end "Tank Alley" }		// Normandy town - street fight past the wrecked Tiger
	if( local.m == "m4l1"  ){ end "Hedgerow" }			// Normandy countryside - church-to-church advance
	if( local.m == "m4l2"  ){ end "The Rail Yard" }		// Normandy - convoy, rails & bunker line
	if( local.m == "m5l1a" ){ end "Sniper's Gauntlet" }	// official "Sniper's Last Stand - Outskirts" (town unnamed in-game)
	if( local.m == "m5l1b" ){ end "The Old Town" }		// official "Sniper's Last Stand - City Hall"
	//--- Tier-1 (BSP-derived) Push maps ---
	if( local.m == "t3l1"  ){ end "Fall of Berlin" }		// Berlin - flak guns & rubble streets
	if( local.m == "t2l1"  ){ end "Bastogne" }			// Ardennes snow - town crossroads
	if( local.m == "t2l3"  ){ end "Ardennes Frost" }		// Ardennes snow - woods & road
	if( local.m == "t2l4"  ){ end "Flak Alley" }		// Ardennes snow - the gun line
	if( local.m == "m5l2a" ){ end "Tiger Hunt" }		// official "The Hunt for the King Tiger - Destroyed Village"
	if( local.m == "m5l2b" ){ end "Country Road" }		// official "The Hunt for the King Tiger - Country Road"
	if( local.m == "m3l1b" ){ end "Omaha Bluffs" }		// official "Omaha Beach - Inside the Bunker"
	//--- Tier-2 (BSP-derived) Push maps ---
	if( local.m == "m2l3"  ){ end "Night Train" }		// snow - the train-yard escape
	if( local.m == "m1l3a" ){ end "Desert Road" }		// N. Africa - official level "Lighting the Torch - Desert Road"
	if( local.m == "m1l3b" ){ end "The Airfield" }		// N. Africa - official level "Grounding the Airfield"
	if( local.m == "e1l1"  ){ end "Kasserine Pass" }	// Tunisia - the tank gate
	if( local.m == "e3l1"  ){ end "Cassino Approach" }	// official "Italy - Monte Cassino I"
	if( local.m == "e3l2"  ){ end "Monte Cassino" }		// official "Italy - Monte Cassino II"
	if( local.m == "e3l3"  ){ end "The River Line" }	// official "Italy - Anzio" (creative title, no place claimed)
	if( local.m == "t1l1"  ){ end "Normandy Breakout" }	// official "Normandy" (no town named in-game)
	if( local.m == "t1l2"  ){ end "Bocage" }			// Normandy - hedgerow town
	if( local.m == "t1l3"  ){ end "River Crossing" }	// Normandy - the boat & bridge assault
	if( local.m == "m5l3"  ){ end "Rocket Facility" }	// the V-2 rocket works
	//fallback: raw map id, so a not-yet-titled map still shows something
	end local.map
}end local.map
