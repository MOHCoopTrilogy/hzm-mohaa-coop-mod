//[214] HZM coop - TAKE COVER v1 (player cover system).
//
// One bindable toggle (name-append bus index 26, marker " ,c1" - see ui/BIND.SCR
// "Coop: Take Cover" and player.scr::playerNameCommand). All the real logic is
// ENGINE-side: this script only asks/releases via the Player event
//   <player> coop_setcover 1|0
// and reads back local.player.coop_incover (0 none / 1 requested-no-pose /
// 2 standing back-to-wall / 3 crouched low cover). Player::TickCoopCover
// (openmohaa-hzm/code/fgame/player.cpp) validates the pose with world traces
// every frame and drops it on movement/jump/death/mount, so this thread never
// needs a monitor loop. Poses + blind fire are statemap states
// (coop_mod/player_legs.st COVER_* / player_Torso.st COVER_TORSO) playing the
// AI cornering anims aliased in models/player/base/anims_shared.txt.
//
// NOTE: this file is NOT the sandbag deployable - that is coop_mod/cover.scr.
//=========================================================================
coop_cover_toggle local.player:{
//=========================================================================
	if(local.player == NULL){ println "^~^~^ TAKECOVER: no player"; end }
	if(!isAlive local.player){ println "^~^~^ TAKECOVER: blocked (dead)"; end }
	if(local.player.dmteam == "spectator"){ println "^~^~^ TAKECOVER: blocked (spectator)"; end }
	if(local.player.flags["coop_dbno_active"] == 1){ println "^~^~^ TAKECOVER: blocked (dbno)"; end }
	if(local.player.turret != NULL){ println "^~^~^ TAKECOVER: blocked (turret)"; end }
	if(local.player.vehicle != NULL){ println "^~^~^ TAKECOVER: blocked (vehicle)"; end }

	// already covered (or requested) - release
	if(local.player.coop_incover > 0){
		local.player coop_setcover 0
		local.player iprint "Cover released"
		println "^~^~^ TAKECOVER: released"
		end
	}

	// request - the engine validates IMMEDIATELY inside the event (and clears the
	// request itself when nothing coverable is around), so the read-back below is
	// authoritative feedback for this exact press.
	local.player coop_setcover 1

	if(local.player.coop_incover == 0){
		local.player iprint "No cover here - face a low wall, sandbags or crates to crouch behind" 1
		println "^~^~^ TAKECOVER: no valid pose"
		end
	}
	// wall (standing back-to-wall) cover was removed for being crash-prone; only LOW/crouch remains
	local.player iprint "In cover - hold FIRE to blind-fire over the top"
	println "^~^~^ TAKECOVER: engaged LOW"
}end
