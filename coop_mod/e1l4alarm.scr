//==========================================================================================================//
// coop_mod/e1l4alarm.scr
// COOP: make the e1l4 ("sneak aboard the ship" / Bizerte harbor) alarm SILENCEABLE, the way the shared
// alarm system (global/alarm_system.scr) lets players re-pull the switch to shut it off on other coop maps.
//
// e1l4 uses its OWN bespoke "cover blown" alarm in maps/e1l4/Ship.scr, which made the alarm switch
// nottriggerable the instant it sounded - so players could never quiet the blaring sirens + flashing lights.
// In coop we leave $alarm_switch_trigger live and turn it into a TOGGLE (wired from Ship.scr::AlarmSounded):
//   - alarm on  -> using the switch SILENCES the sirens + flashing (coop_alarmSilence)
//   - alarm off -> using it again RE-SOUNDS the alert   (coop_alarmResound)
// Cover stays blown either way (level.alarmSounded stays latched, disguises stay gone) - this only quiets or
// restarts the active alert, exactly like re-pulling the switch on the global/alarm_system.scr maps.
//==========================================================================================================//

//=========================================================================
coop_alarmToggle:{
//=========================================================================
	// the switch trigger can fire more than once per interaction - debounce so one use = one toggle
	if( level.coop_e1l4AlarmBusy == 1 ){ end }
	level.coop_e1l4AlarmBusy = 1

	if( level.alarm == 1 ){
		waitthread coop_alarmSilence
	}
	else{
		waitthread coop_alarmResound
	}

	wait 2
	level.coop_e1l4AlarmBusy = 0
}end

//=========================================================================
coop_alarmSilence:{
//=========================================================================
	level.alarm = 0
	level.alarmlights = 0
	level.sirenson = 0

	// stop the looping siren - PlayAlarmSound parks the loop on the $siren emitter's .soundorigin model
	if( $siren != NULL ){
		if( $siren.soundorigin != NULL && $siren.soundorigin != NIL ){
			$siren.soundorigin stoploopsound
		}
	}

	// stop the flashing red lights: light_e1l4.scr 'start' loops now watch level.coop_e1l4FlashOff
	level.coop_e1l4FlashOff = 1

	iprintlnbold_noloc( "^3Alarm silenced." )
}end

//=========================================================================
coop_alarmResound:{
//=========================================================================
	level.alarm = 1
	level.alarmlights = 1
	level.sirenson = 1

	level.coop_e1l4FlashOff = 0
	thread maps/e1l4/light_e1l4.scr::StartFlashing
	$siren thread maps/e1l4/ship.scr::PlayAlarmSound

	iprintlnbold_noloc( "^1Alarm sounding!" )
}end

//=========================================================================
// Called once (coop only) the first time the alarm sounds - arms a short cooldown so a switch trigger that
// double-fires on the same interaction can't sound-then-instantly-silence the alarm.
//=========================================================================
coop_onAlarmSounded:{
//=========================================================================
	level.coop_e1l4AlarmBusy = 1
	wait 3
	level.coop_e1l4AlarmBusy = 0
}end
