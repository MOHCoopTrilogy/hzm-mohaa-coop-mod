//coop_mpRun-guarded; a compile canary on every MP boot.
alive:{
	end 1
}end

//Spawn the authored vehicle layout for the current map (lowercased mapname). Returns 1 if this map
//has an authored layout, 0 otherwise.
seed local.map:{
	if( level.coop_mpRun != 1 ){ end 0 }
	level.coop_mpVehSeeded = 0
	switch( local.map ){
		case "m1l3a":
			waitthread seed_m1l3a
			level.coop_mpVehSeeded = 1
			break
		case "m1l3b":
			waitthread seed_m1l3b
			level.coop_mpVehSeeded = 1
			break
		case "m4l1":
			waitthread seed_m4l1
			level.coop_mpVehSeeded = 1
			break
		case "m5l2a":
			waitthread seed_m5l2a
			level.coop_mpVehSeeded = 1
			break
		case "m5l3":
			waitthread seed_m5l3
			level.coop_mpVehSeeded = 1
			break
	}
	end level.coop_mpVehSeeded
}end level.coop_mpVehSeeded

