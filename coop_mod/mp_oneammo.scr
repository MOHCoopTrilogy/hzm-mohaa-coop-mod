//=========================================================================
// MP_ONEAMMO.SCR - the SINGLE-ROUND AMMO modifier (user 2026-09-16). A host toggle (coop_mpOneAmmo 0/1)
// that, combined with the One-Shot modifier, gives the classic "One in the Chamber": you carry one round,
// a kill tops you back up to one, an empty gun leaves you on the knife. A modifier row, like Hardcore.
//
// COMPOSES ONLY WITH THE WEAPON-NEUTRAL MODES. The five modes that OWN their weapons - Gun Game, Prop Hunt,
// Build-A-Base, Search & Destroy, Cyber Attack (mp.scr::mp_modeUsesArmory == 0) - manage their own kits, so
// this modifier is a deliberate no-op there (checked in ::compatible). On the armory / standard modes (DM,
// TDM, KOTH, LMS, Freeze Tag, Push, Demolition, CTF, Base Assault) it caps every gun ammo pool to 1 on the
// spawn edge and refills the KILLER back to 1 on each kill (via the engine player_killed delegate).
//
// This is an MP file (coop_mod/mp*.scr is in MP_MANIFEST), guarded end to end by level.coop_mpRun, which
// ONLY coop_mod/mp.scr sets and which a level load wipes - so NOTHING here can run on a coop map.
// mp.scr::main threads ::init (subscribes player_killed); mp.scr::mp_onSpawn calls ::onSpawn.
//
// ISOLATION: reads only the MP-owned host toggle coop_mpOneAmmo (coop_mp*, isolation clause 12c); sets ammo
// PER PLAYER via the entity `ammo` command, never a cvar, so it cannot follow anyone into coop (clause 4);
// names no coop cvar, coop_lo, ui/loadout or coop_mod-only path; calls no coop code; never
// giveInventory / changeGameType / the coop_health cvar.
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main. Kept so an accidental exec is a no-op.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end


//Liveness probe (TRAPS T1). If this file parse-kills, ::onSpawn / ::init are unreachable and the modifier
//simply stays off - ammo is stock.
alive:{
	end 1
}end


//Is the host toggle ON? coop_mpOneAmmo is MP-owned and read-only here. "" or "0" -> off. int() into a local
//BEFORE end (bug-2603, TRAPS T1). Returns 1/0.
isOn:{
	local.s = getcvar( "coop_mpOneAmmo" )
	if( local.s == "" ){ local.s = "0" }
	local.v = int( local.s )
	if( local.v != 0 ){ local.v = 1 }
}end local.v


//Does THIS mode allow the modifier? No on the five weapon-owning modes (they set mp_modeUsesArmory 0);
//yes on everything else. Returns 1/0.
compatible:{
	local.v = 1
	if( level.coop_mpMode == "gungame" ){ local.v = 0 }
	if( level.coop_mpMode == "prophunt" ){ local.v = 0 }
	if( level.coop_mpMode == "buildabase" ){ local.v = 0 }
	if( level.coop_mpMode == "snd" ){ local.v = 0 }
	if( level.coop_mpMode == "cyberattack" ){ local.v = 0 }
}end local.v


//Cap every gun ammo pool on a player to 1 (so whatever primary they hold has one round). Knife has no pool.
//A pool name the engine does not know is a harmless no-op, so listing the full class set is safe.
capOne local.p:{
	if( local.p == NULL ){ end }
	local.p ammo "rifle" 1
	local.p ammo "smg" 1
	local.p ammo "sniper" 1
	local.p ammo "heavy" 1
	local.p ammo "pistol" 1
	local.p ammo "mg" 1
	local.p ammo "shotgun" 1
	local.p ammo "bar" 1
}end


//SPAWN EDGE. Called from mp.scr::mp_onSpawn AFTER the kit give. Caps the player to a single round when the
//modifier is on and the mode is compatible. PER PLAYER, never a cvar.
onSpawn local.p:{
	if( local.p == NULL ){ end }
	local.oa = waitthread isOn
	if( local.oa != 1 ){ end }
	local.ok = waitthread compatible
	if( local.ok != 1 ){ end }
	waitthread capOne local.p
	println( "^~^~^ MPOA oneammo e" + local.p.entnum + " capped=1" )
}end


//ONE-TIME INIT (threaded from mp.scr::main). Subscribe the engine player_killed delegate so a kill refills
//the KILLER back to one round. Guarded + run-once so a map that inits twice does not double-subscribe.
init:{
	if( level.coop_mpRun != 1 ){ end }
	if( level.coop_mpOaInit == 1 ){ end }
	level.coop_mpOaInit = 1
	event_subscribe "player_killed" "onKill"
	println( "^~^~^ MPOA init subscribed player_killed" )
}end


//KILL CALLBACK. self = victim; local.attacker = killer (same 11-arg delegate shape as mp_progression::onKill).
//Refill the attacker back to one round on a valid PvP kill, when the modifier is on and the mode compatible.
onKill local.attacker local.dmg local.inflictor local.pos local.dir local.norm local.knock local.dflags local.mod local.loc local.victim:{
	if( level.coop_mpRun != 1 ){ end }
	local.oa = waitthread isOn
	if( local.oa != 1 ){ end }
	local.ok = waitthread compatible
	if( local.ok != 1 ){ end }
	if( local.attacker == NULL ){ end }
	if( local.attacker == self ){ end }          //suicide, not a kill reward
	if( local.mod == 4 ){ end }                   //MOD_TELEFRAG
	local.atk = local.attacker.dmteam
	if( local.atk == NIL || local.atk == "" || local.atk == "spectator" ){ end }
	waitthread capOne local.attacker
}end
