//=========================================================================
// HZM coop - SHARED CUTSCENE LOCK  (bug-4094)
//
// ONE place that makes every player a pure spectator of a scripted scene, and gives everything back.
//
//   waitthread coop_mod/cutscene.scr::cut_lock [maxSeconds]     before the first fade / cut
//   waitthread coop_mod/cutscene.scr::cut_cam <camera>          instead of a bare `cuecamera`
//   waitthread coop_mod/cutscene.scr::cut_unlock                under black, where the scene ends
//
// WHAT A LOCK IS (all of it per player, re-asserted every 0.25s by cut_watch):
//   freezeplayer       the vanilla recipe (level.playerfrozen): PMF_FROZEN for everyone and the
//                      weapon-class keys (1-6) go dead (Player::EventUseWeaponClass).
//   freezecontrols 1   no move / look / FIRE / use. Player::CondAttackPrimary and the secondary
//                      and button conditionals all return false while m_bFrozen is set, so the
//                      trigger is dead and nothing needs stripping. m_bFrozen resets on a coop
//                      respawn, which is why this is a loop and not a one-shot.
//   weapon pin         weapnext / weapprev (mouse wheel) are NOT gated by either freeze, so the
//                      weapon held at lock time is recorded and re-selected whenever it changes
//                      (the bust.scr recipe: use + activatenewweapon). The view is a camera, so
//                      the 0.25s of flicker is never on screen. Restored exactly at unlock.
//   coop_cineHud 5     the engine's NON-ARCHIVED, SELF-EXPIRING hold (cg_drawtools.cpp): hides the
//                      crosshair, brace pip, hit marker, bleed ring, loot icons, compass, health
//                      frame and the event feed. A 5s hold re-armed every 0.25s: if this thread
//                      ever dies the HUD is back in 5s on its own. (m2l2b's old `ui_crosshair 0`
//                      stufftext was silently filtered on the client and never worked - and
//                      ui_crosshair is CVAR_ARCHIVE, so a working one would have latched it off.)
//   drawhud 0          the stock engine HUD (PMF_NO_HUD); a respawn clears it, hence the loop.
//   nodamage           nobody dies in their own cutscene. Only players WE put into it are put
//                      back (takedamage), and an admin-god player is left alone.
//   cuecamera <cam>    late joiners and respawned players are re-cued to the CURRENT camera.
//
// RANK STAR / XP BAR (2026-10-20): the Allied team star bottom-left (cgame CG_DrawPlayerTeam) ignored PMF_NO_HUD and the
// hold - engine fix: it now honours both. The XP rank bar / promotion emblem and the challenge toast are script ihuddraw,
// which neither gate hides: xp.scr / challenges.scr do not draw them while level.coop_cutLocked == 1. Other script
// ihuddraw (mission item icons, credits) is deliberately NOT hidden by the lock.
//
// LATE JOINERS / RESPAWNS: cut_watch walks $player every pass, so a player who connects, or whose
// body is rebuilt, mid-scene is locked within 0.25s.
//
// SAFETY: the lock has a hard life (default 240s). If the scene thread dies without calling
// cut_unlock the watcher releases everybody itself. Nested locks are counted: only the outermost
// cut_unlock releases.
//=========================================================================

cut_lock local.maxsec:{
	if( level.gametype == 0 ){ end }
	if( level.coop_cutDepth == NIL ){ level.coop_cutDepth = 0 }
	level.coop_cutDepth = level.coop_cutDepth + 1
	if( level.coop_cutDepth > 1 ){ end }
	if( local.maxsec == NIL ){ local.maxsec = 240 }
	level.coop_cutLocked = 1
	if( level.coop_cutSeq == NIL ){ level.coop_cutSeq = 0 }
	level.coop_cutSeq = level.coop_cutSeq + 1
	level.coop_cutT0 = level.time
	println( "^~^~^ CUTLOCK on max=" + local.maxsec )
	freezeplayer
	waitthread cut_pass
	thread cut_watch level.coop_cutSeq local.maxsec
}end

cut_cam local.cam:{
	if( local.cam == NULL || local.cam == NIL ){ end }
	level.coop_cutCam = local.cam
	if( level.coop_cutCamSeq == NIL ){ level.coop_cutCamSeq = 0 }
	level.coop_cutCamSeq = level.coop_cutCamSeq + 1
	cuecamera local.cam
	//everyone present is now on this camera; a body that appears later has an older stamp
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		if( $player[local.i] != NULL && $player[local.i] != NIL ){
			$player[local.i].flags["coop_cutCamSeq"] = level.coop_cutCamSeq
		}
	}
}end

cut_watch local.seq local.maxsec:{
	while( level.coop_cutLocked == 1 && level.coop_cutSeq == local.seq ){
		if( ( level.time - level.coop_cutT0 ) > local.maxsec ){
			println( "^~^~^ CUTLOCK watchdog expired - releasing everybody" )
			level.coop_cutDepth = 1
			waitthread cut_unlock
			end
		}
		wait 0.25
		if( level.coop_cutLocked == 1 && level.coop_cutSeq == local.seq ){ waitthread cut_pass }
	}
}end

//the model of the weapon in the player's hands, or "none" for empty hands ("" is not trusted: it can read back as NIL)
cut_heldModel local.p:{
	local.nm = "none"
	local.w = waitthread coop_mod/itemhandler.scr::returnActiveWeapon local.p
	if( local.w != NULL && local.w != NIL ){ local.nm = local.w.model }
}end local.nm

//put the recorded weapon back in the player's hands if something (a wheel scroll) changed it
cut_pinWeapon local.p:{
	if( !isAlive local.p ){ end }
	local.want = local.p.flags["coop_cutWeap"]
	if( local.want == NIL ){ end }
	local.have = waitthread cut_heldModel local.p
	if( local.have == local.want ){ end }
	if( local.want == "none" ){
		local.p safeholster 1
	}else{
		local.p use local.want
		local.p activatenewweapon "dual"
	}
}end

//one idempotent sweep over every connected player
cut_pass:{
	if( level.coop_cutLocked != 1 ){ end }
	drawhud 0
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		if( local.p.flags["coop_cutLocked"] != 1 ){
			local.p.flags["coop_cutLocked"] = 1
			if( isAlive local.p ){
				local.hm = waitthread cut_heldModel local.p
				local.p.flags["coop_cutWeap"] = local.hm
			}
			if( local.p.flags["coop_adminGod"] != 1 ){
				local.p nodamage
				local.p.flags["coop_cutNoDmg"] = 1
			}
			println( "^~^~^ CUTLOCK player e" + local.p.entnum + " locked weap=[" + local.p.flags["coop_cutWeap"] + "]" )
		}
		local.p freezecontrols 1
		local.p stufftext "coop_cineHud 5"
		waitthread cut_pinWeapon local.p
		if( level.coop_cutCam != NULL && level.coop_cutCam != NIL ){
			if( local.p.flags["coop_cutCamSeq"] != level.coop_cutCamSeq ){
				local.p.flags["coop_cutCamSeq"] = level.coop_cutCamSeq
				cuecamera level.coop_cutCam
			}
		}
	}
}end

cut_unlock:{
	if( level.coop_cutDepth == NIL || level.coop_cutDepth <= 0 ){ end }
	level.coop_cutDepth = level.coop_cutDepth - 1
	if( level.coop_cutDepth > 0 ){ end }
	level.coop_cutLocked = 0
	level.coop_cutCam = NIL
	releaseplayer
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		//release EVERY connected player, locked-by-us or not: a hold that never reached somebody
		//costs nothing, a lock that is never released is a soft-lock
		local.p stufftext "coop_cineHud 0"
		if( local.p.flags["coop_cutLocked"] == 1 ){
			waitthread cut_pinWeapon local.p
			local.p freezecontrols 0
			if( local.p.flags["coop_cutNoDmg"] == 1 ){ local.p takedamage }
			local.p.flags["coop_cutLocked"] = 0
			local.p.flags["coop_cutNoDmg"] = 0
			local.p.flags["coop_cutCamSeq"] = 0
			local.p.flags["coop_cutWeap"] = NIL
		}
	}
	drawhud 1
	println( "^~^~^ CUTLOCK off" )
}end
