//=========================================================================
// carrier.scr - [bug-3360/bug-3416] the ONLY place the engine command coop_carrier is written.
//=========================================================================
// coop_carrier (fgame/scriptslave.cpp, engine f3400fba) hands a script strafing gun's projectiles to the actor
// that carries it, so the round skips him and Sentient::ArmorDamage's same-team filter keeps it off his squad.
// Morpheus resolves command names at COMPILE time and an unknown one fails the WHOLE file, so written inline it
// took all of officer.scr (no officer, no waves) and the anim corner scripts down on an older game.dll. Isolated
// here, an old game.dll fails only THIS file: the caller's waitthread becomes a runtime Script Error that skips
// that one statement, and the gun simply keeps its stock ownership. Same recipe as dbno_bleed.scr.
// Keep anything else out of this file for exactly that reason.
//=========================================================================

set local.gun local.carrier:{
	if( local.gun == NIL || local.gun == NULL ){ end }
	if( local.carrier == NIL || local.carrier == NULL ){ end }
	local.gun coop_carrier local.carrier
}end
