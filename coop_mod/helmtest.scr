//========================================================================================
// HZM dev probe (TEMPORARY): verify the retail sethelmet/pophelmet mechanic end to end.
// Gated by cvar coop_helmtest (default unset). Greppable output lines: ^~^~^ HELMTEST
//
// Expected if the mechanic WORKS (german_afrika_private has sethelmet ... 0.1):
//   health start = 100, after first 10dmg helmet-hit = 99 (0.1x helmet multiplier),
//   after pophelmet + second 10dmg helmet-hit = ~49-59 (4-5x bare-head multiplier).
// Expected if sethelmet is NOT applied: first hit already lands 40-50 damage.
//========================================================================================
main:
	wait 8	//let map load + coop init settle

	iprintlnbold "^~^~^ HELMTEST spawning german_afrika_private"
	spawn models/human/german_afrika_private.tik origin ( 0 0 64 ) targetname "coop_helmtest_ai"
	waitframe

	local.ai = $coop_helmtest_ai
	if (local.ai == NULL || local.ai == NIL){
		iprintlnbold "^~^~^ HELMTEST FAIL spawn came back NULL"
		end
	}

	local.ai health 100
	waitframe
	iprintlnbold( "^~^~^ HELMTEST health start = " + local.ai.health )

	// helmet-location hit while (supposedly) wearing the helmet
	local.ai damage $world 10 $world local.ai.origin ( 0 0 0 ) ( 0 0 1 ) 0 0 18 1
	waitframe
	iprintlnbold( "^~^~^ HELMTEST after 10dmg helmet-hit = " + local.ai.health )

	// pop explicitly, then hit the same location again - should now use the bare-head multiplier
	local.ai pophelmet
	waitframe
	iprintlnbold "^~^~^ HELMTEST pophelmet called"

	local.ai damage $world 10 $world local.ai.origin ( 0 0 0 ) ( 0 0 1 ) 0 0 18 1
	waitframe
	iprintlnbold( "^~^~^ HELMTEST after 10dmg popped-hit = " + local.ai.health )

	// holster check: with the TIK holster data live, the engine WEAPDBG line should log
	// holster=1 tag='Bip01 Spine2' (was tag='' = silently hidden)
	local.ai holster
	wait 0.3

	local.ai remove

	// PART 2: full killing blow at helmet location through the coop pain-buffer pipeline.
	// Expect anim/killed.scr's pop block to fire (breadcrumb ^~^~^ HELMPOP in the log).
	iprintlnbold "^~^~^ HELMTEST part2 spawning victim for helmet-location kill"
	spawn models/human/german_afrika_private.tik origin ( 0 0 64 ) targetname "coop_helmtest_ai2"
	waitframe
	local.ai2 = $coop_helmtest_ai2
	if (local.ai2 == NULL || local.ai2 == NIL){
		iprintlnbold "^~^~^ HELMTEST FAIL part2 spawn came back NULL"
		end
	}

	wait 2	//give aihandler's manage loop time to attach the coop pain handler

	local.ai2 damage $world 20000 $world local.ai2.origin ( 0 0 0 ) ( 0 0 1 ) 0 0 18 1
	wait 1

	if (isAlive local.ai2){
		iprintlnbold( "^~^~^ HELMTEST part2 victim SURVIVED, health = " + local.ai2.health )
	}else{
		iprintlnbold "^~^~^ HELMTEST part2 victim killed (check for HELMPOP line above)"
	}

	// PART 3: smoke-load the new gear/helmet variant tiks (TIKI parse errors show in console)
	spawn models/human/german_waffenss_shutze_gear.tik origin ( 0 0 64 ) targetname "coop_helmtest_m1"
	spawn models/coop_helmets/coop_helmet_net_cig.tik origin ( 0 0 64 ) targetname "coop_helmtest_m2"
	spawn models/coop_helmets/coop_helmet_ltnt.tik origin ( 0 0 64 ) targetname "coop_helmtest_m3"
	waitframe

	if ($coop_helmtest_m1){
		iprintlnbold "^~^~^ HELMTEST gear-variant spawned OK"
		$coop_helmtest_m1 remove
	}else{
		iprintlnbold "^~^~^ HELMTEST FAIL gear-variant NULL"
	}
	if ($coop_helmtest_m2){
		iprintlnbold "^~^~^ HELMTEST net_cig helmet spawned OK"
		$coop_helmtest_m2 remove
	}else{
		iprintlnbold "^~^~^ HELMTEST FAIL net_cig NULL"
	}
	if ($coop_helmtest_m3){
		iprintlnbold "^~^~^ HELMTEST ltnt helmet spawned OK"
		$coop_helmtest_m3 remove
	}else{
		iprintlnbold "^~^~^ HELMTEST FAIL ltnt NULL"
	}

	iprintlnbold "^~^~^ HELMTEST done"
end
