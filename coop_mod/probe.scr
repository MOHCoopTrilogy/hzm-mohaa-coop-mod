//=========================================================================
// COOP PROBE BUS - one diagnostic channel for everything this mod added.
//=========================================================================
// [user 2026-08-22] "I would also build an extremely comprehensive probing system we can
// start turning on and off easily... it should probably cover everything we have added in
// this game that is not vanilla... We need it to be able to understand extreme context of
// every situation."
//
// WHY THIS EXISTS. The m1l1 investigation stalled on a tracker that could not answer the
// only question that mattered. coop_aiBehav reported `surrender=21` for a session in which
// the user saw nobody surrender - but behav_bump is a GLOBAL EVENT COUNTER with no actor
// identity, and the surrender loop bumps it every 2.5s per surrendered man. 21 bumps is one
// actor sitting there for ~52 seconds, and there was no way to tell that from the log. Of
// the 14 probe kinds in a 1.3 MB session log, exactly two carried an entity number.
//
// THE RULE THIS ENCODES: an aggregate counter tells you a number changed. It never tells you
// WHICH, WHEN, or IN WHAT STATE - and those are the only three things a diagnosis needs.
// Every record here carries identity and time. Counters are derived by the reader
// (docs/tools/probe_read.py), never by the emitter.
//
//-------------------------------------------------------------------------
// USING IT
//-------------------------------------------------------------------------
//   coop_probe <mask>        bitmask. DEFAULT 129 - it starts on its own, no console needed.
//                            Live: change it mid-map and the next poll picks it up.
//                            coop_probe 0 turns it off.
//   coop_probe 1             actors only
//   coop_probe 255           everything
//   coop_probe 0             off
//
// SELF-STARTING. coop_defaults.cfg seeds 129 (actor + census) with a 10s census, so a normal
// session - and every bug report a player sends - carries full per-entity context with no
// setup. The census is the only part with a real cost (one entity-table walk plus a record
// per living actor); 10s is cheap, 2s is what a live repro wants.
//   coop_probeInterval <s>   census period, default 5
//   coop_probeFilter <str>   only entities whose targetname/model CONTAIN <str> (substring)
//
//   CHANNELS          bit   what it records
//     actor             1   spawn, personality, variant roll, surrender, convert, death,
//                           team flips, scene-marker detection, re-arm bounces
//     anim              2   anim_scripted / motion anim requests and refusals
//     weapon            4   give / holster / unholster / variant / ammo
//     sound             8   alias plays and misses
//     script           16   map script events, coop callbacks, scene gates
//     player           32   spawn, loadout, health, dbno, state transitions
//     feature          64   cover, ADS, sprint, ragdoll and the rest of the feel work
//    census           128   periodic FULL-WORLD snapshot - every actor, every field
//
// The census is the one to reach for first. It answers "which enemies are flagged
// surrendered / disabled / engaging, right now" without needing the event that caused it to
// have been instrumented in advance - which is the failure mode that cost this investigation
// a day.
//
//-------------------------------------------------------------------------
// RECORD FORMAT - parse with docs/tools/probe_read.py
//-------------------------------------------------------------------------
//   ^~^~^ PRB <chan>.<event> t=<levelTime> ent=<n> tn=<targetname> tm=<team> hp=<health> ...
//
// Keeps the established ^~^~^ prefix so maptest_monitor.ps1 and the existing watchers still
// see it. Strictly key=value after the event name, so a reader never has to guess.
//
// TRAPS HONOURED HERE:
//  * coop_probe is seeded in coop_defaults.cfg. Script getcvar CREATES an unregistered cvar
//    EMPTY and permanently defeats any later engine default (bug-1669, which killed limping,
//    tinnitus and gore-drip). Anything engine-side reading this must ALSO pre-register it in
//    G_InitGame.
//  * The mask is decoded ONCE into level flags. Call sites test a level var, never getcvar -
//    a getcvar per record on a hot path would cost more than the thing being measured.
//  * Decoding is done by descending subtraction, not bitwise ops, which Morpheus does not
//    reliably provide.
//  * enableEnemy is NOT reported: it is a lone EV_SETTER and READING it throws (bug-2034).
//    coop_aiDisabled is our readable mirror. threatbias IS readable (real EV_GETTER).
//=========================================================================

//=========================================================================
prb_init:{
//=========================================================================
// Called from main.scr::main, which must complete in ONE FRAME - so no wait/waitframe here.
//
// SELF-START, AND WHY IT IS DONE HERE RATHER THAN ONLY IN THE CFG. coop_defaults.cfg is
// exec'd by the CLIENT before its saved config - so on a DEDICATED server it never runs at
// all, and the probe stayed dark there while working fine on a listen server. Listen-only is
// a defect in this project by standing rule, and a diagnostic that is absent from dedicated
// servers is absent from exactly the runs nobody is watching.
// Seeding the value here covers both, because main.scr::main runs on every host. An explicit
// choice always wins: only an EMPTY value is replaced, so `coop_probe 0` stays 0 and any
// number the user set stays theirs. (Reading an unregistered cvar creates it empty - bug-1669
// - which is precisely the state being repaired one line later.)
	if( getcvar( "coop_probe" ) == "" ){ setcvar "coop_probe" "129" }
	if( getcvar( "coop_probeInterval" ) == "" ){ setcvar "coop_probeInterval" "10" }

	level.coop_prbActor   = 0
	level.coop_prbAnim    = 0
	level.coop_prbWeapon  = 0
	level.coop_prbSound   = 0
	level.coop_prbScript  = 0
	level.coop_prbPlayer  = 0
	level.coop_prbFeature = 0
	level.coop_prbCensus  = 0
	level.coop_prbAny     = 0
	level.coop_prbFilter  = ""
	level.coop_prbSeq     = 0
	//[P3] prb_poll compares the freshly-read mask against this on its FIRST pass. Leaving it
	//unset relies on an int-vs-unset compare behaving; if that ever throws, the Script Error
	//SKIPS the statement, the body never runs, and the bus silently never arms - the exact
	//silent-veto shape this tool exists to catch, inside the tool itself. 0-1 can never be a
	//real mask, so the first poll always differs and always arms.
	level.coop_prbMask    = 0 - 1
	thread prb_poll
}end

//=========================================================================
prb_poll:{
//=========================================================================
// Re-read the mask every second so the user can flip channels mid-map from the console
// without reloading. One getcvar per second is free; one per record would not be.
	while( 1 ){
		local.m = int( getcvar "coop_probe" ) + 0
		if( local.m != level.coop_prbMask ){
			level.coop_prbMask = local.m
			waitthread prb_decode local.m
			level.coop_prbFilter = getcvar "coop_probeFilter"
			println( "^~^~^ PRB probe.mask t=" + int( level.time ) + " mask=" + local.m + " actor=" + level.coop_prbActor + " anim=" + level.coop_prbAnim + " weapon=" + level.coop_prbWeapon + " sound=" + level.coop_prbSound + " script=" + level.coop_prbScript + " player=" + level.coop_prbPlayer + " feature=" + level.coop_prbFeature + " census=" + level.coop_prbCensus + " filter=" + level.coop_prbFilter )
			if( level.coop_prbCensus == 1 && level.coop_prbCensusOn != 1 ){
				level.coop_prbCensusOn = 1
				thread prb_censusLoop
			}
		}
		wait 1
	}
}end

//=========================================================================
prb_decode local.m:{
//=========================================================================
// Descending subtraction, so this needs only >= and -. Morpheus has no dependable bitwise
// AND, and a wrong decode would silently enable the wrong channel - which is the exact class
// of silent-veto bug this whole system exists to catch.
	level.coop_prbCensus = 0
	if( local.m >= 128 ){ level.coop_prbCensus = 1
		local.m = local.m - 128 }
	level.coop_prbFeature = 0
	if( local.m >= 64 ){ level.coop_prbFeature = 1
		local.m = local.m - 64 }
	level.coop_prbPlayer = 0
	if( local.m >= 32 ){ level.coop_prbPlayer = 1
		local.m = local.m - 32 }
	level.coop_prbScript = 0
	if( local.m >= 16 ){ level.coop_prbScript = 1
		local.m = local.m - 16 }
	level.coop_prbSound = 0
	if( local.m >= 8 ){ level.coop_prbSound = 1
		local.m = local.m - 8 }
	level.coop_prbWeapon = 0
	if( local.m >= 4 ){ level.coop_prbWeapon = 1
		local.m = local.m - 4 }
	level.coop_prbAnim = 0
	if( local.m >= 2 ){ level.coop_prbAnim = 1
		local.m = local.m - 2 }
	level.coop_prbActor = 0
	if( local.m >= 1 ){ level.coop_prbActor = 1
		local.m = local.m - 1 }
	level.coop_prbAny = 0
	if( level.coop_prbMask > 0 ){ level.coop_prbAny = 1 }
}end

//=========================================================================
prb_id local.e:{
//=========================================================================
// The standard identity block. EVERY actor-bearing record carries this, because a record
// without identity cannot be correlated with any other record - which is what made the old
// tracker unusable.
	if( local.e == NULL || local.e == NIL ){ end ( "ent=NULL" ) }
	local.s = "ent=" + local.e.entnum
	local.tn = local.e.targetname
	if( local.tn == NIL || local.tn == "" ){ local.tn = "-" }
	local.s = local.s + " tn=" + local.tn
	local.tm = local.e.team
	if( local.tm == NIL || local.tm == "" ){ local.tm = "-" }
	local.s = local.s + " tm=" + local.tm
	local.hp = local.e.health
	if( local.hp == NIL ){ local.hp = 0 - 1 }
	local.s = local.s + " hp=" + int( local.hp )
	end ( local.s )
}end

//=========================================================================
prb_pass local.e:{
//=========================================================================
// coop_probeFilter: when set, only entities whose targetname or model contain the substring
// are reported. A busy map emits thousands of records a minute; without a filter the signal
// for one actor is unreadable.
	if( level.coop_prbFilter == NIL || level.coop_prbFilter == "" ){ end (1) }
	if( local.e == NULL || local.e == NIL ){ end (0) }
	local.tn = local.e.targetname
	if( local.tn != NIL && local.tn != "" ){
		if( waitthread coop_mod/main.scr::containsText local.tn level.coop_prbFilter 0 ){ end (1) }
	}
	local.md = local.e.model
	if( local.md != NIL && local.md != "" ){
		if( waitthread coop_mod/main.scr::containsText local.md level.coop_prbFilter 0 ){ end (1) }
	}
	end (0)
}end

//=========================================================================
prb local.ev local.e local.extra:{
//=========================================================================
// The one emit call. Gate at the CALL SITE on the channel's level var before threading this,
// so a disabled channel costs a single level-var read rather than a thread spawn.
	if( local.e != NULL && local.e != NIL ){
		if( !(waitthread prb_pass local.e) ){ end }
	}
	if( local.extra == NIL ){ local.extra = "" }
	level.coop_prbSeq = level.coop_prbSeq + 1
	println( "^~^~^ PRB " + local.ev + " t=" + int( level.time ) + " n=" + level.coop_prbSeq + " " + ( waitthread prb_id local.e ) + " " + local.extra )
}end

//=========================================================================
prb_actorSnap local.a:{
//=========================================================================
// FULL per-actor state. This is the record that would have ended the m1l1 hunt on day one:
// it reports every coop-owned flag that any of our systems can set, so a wrongly-flagged
// actor is visible WITHOUT the system that flagged him having been instrumented.
	if( local.a == NULL || local.a == NIL ){ end }
	if( !(waitthread prb_pass local.a) ){ end }

	local.x = ""
	// --- what the MAP declared about him (scene markers) ---------------------------------
	local.v = local.a.coop_aiDisabled
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " aiDis=" + local.v
	local.v = local.a.no_idle
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " noIdle=" + local.v
	// threatbias IS readable - real EV_GETTER at sentient.cpp:469. -6969 = THREATBIAS_IGNOREME
	local.v = local.a.threatbias
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " tbias=" + local.v
	local.v = local.a.flags["coop_sceneActor"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " scene=" + local.v

	// --- what OUR systems did to him -----------------------------------------------------
	local.v = local.a.flags["coop_surrendered"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " surr=" + local.v
	local.v = local.a.coop_converted
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " conv=" + local.v
	//[P2] coop_personality is written NOWHERE in the mod (0 sites). The personality roll
	//stores its result in flags["coop_role"] (17 sites, officer.scr) with a separate latch.
	local.v = local.a.flags["coop_role"]
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " role=" + local.v
	local.v = local.a.flags["coop_personality_set"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " persSet=" + local.v
	//[P1] flags["..."], NOT a direct property. coop_actorActualHealth is written as a FLAG at
	//8 sites and as a property at ZERO, so the property read returned NIL and hpReal printed
	//-1 for every actor on every census - the one field the m1l1 hunt actually needed. Caught
	//because the headless run showed hpReal=-1 on 110 consecutive rows; Part 2 of this same
	//file had the correct form all along.
	local.v = local.a.flags["coop_actorActualHealth"]
	if( local.v == NIL ){ local.v = 0 - 1 }
	local.x = local.x + " hpReal=" + int( local.v )
	local.v = local.a.flags["coop_actorStopPainHandler"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " stopPain=" + local.v
	//.nolongpain and an absent pain handler are the two gates that strand a buffered actor at
	//full engine health - the documented bullet sponge (aihandler.scr:350).
	local.v = local.a.nolongpain
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " noLongPain=" + local.v
	local.v = local.a.max_health
	if( local.v == NIL ){ local.v = 0 - 1 }
	local.x = local.x + " hpMax=" + int( local.v )

	// --- what he is doing right now ------------------------------------------------------
	local.v = local.a.weapon
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " wp=" + local.v
	local.v = local.a.weapongroup
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " wg=" + local.v
	local.v = local.a.position
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " pos=" + local.v
	local.v = local.a.type_attack
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " atk=" + local.v

	// --- WHO is he fighting? -------------------------------------------------------------
	// The single most valuable field in this record, and the one the old tracker lacked.
	// coop_aiBehav counted `engaging` over level.coop_actorArray["german"], but an actor's
	// .enemy can be a PLAYER or another ACTOR - so "engaging=12" could mean twelve germans
	// shooting at the players, or twelve germans fighting the map's own allied cast, and
	// those two have opposite fixes. The m1l1 investigation could not tell them apart.
	local.en = 0
	local.ec = "-"
	local.et = "-"
	local.ee = "-"
	if( local.a.enemy != NULL && local.a.enemy != NIL ){
		local.en = 1
		local.ee = local.a.enemy.entnum
		local.ec = local.a.enemy.classname
		if( local.ec == NIL || local.ec == "" ){ local.ec = "-" }
		local.et = local.a.enemy.team
		if( local.et == NIL || local.et == "" ){ local.et = "-" }
	}
	local.x = local.x + " hasEnemy=" + local.en + " foeEnt=" + local.ee + " foeCls=" + local.ec + " foeTm=" + local.et

	//[user 2026-08-22, bug-2059] THE FIELDS TODAY ACTUALLY NEEDED. Every one of these is here
	//because its absence cost a diagnosis:
	// org/dist/see - the probe recorded WHERE NOTHING WAS. The leading explanation for the m1l1
	//   aggro is that the coop player is VISIBLE where retail's scripted passenger was not, and
	//   that was untestable: no position, no sightline, in 29,796 records. `see` is the direct
	//   answer - can this actor actually see a player right now.
	// tdis/tidl/alrm - coop_isProtectedActor keys on type_disguise, type_idle and alarmthread,
	//   and an adversarial review showed those are TIME-VARYING (the engine demotes a sentry to
	//   "salute" once he accepts papers). Modelling protection from the log was guesswork.
	// supp - coop_suppressedAt is what coop_suppress_react keys on. The crouched-patroller
	//   diagnosis was an inference I could never prove.
	local.v = local.a.origin
	local.x = local.x + " org=" + int( local.v[0] ) + "," + int( local.v[1] ) + "," + int( local.v[2] )
	local.pp = waitthread coop_mod/replace.scr::player_closestTo local.a
	local.dist = 0 - 1
	local.see = 0
	if( local.pp != NULL && local.pp != NIL ){
		local.dist = int( vector_length( local.pp.origin - local.a.origin ) )
		if( local.a cansee local.pp ){ local.see = 1 }
	}
	local.x = local.x + " dist=" + local.dist + " see=" + local.see
	local.v = local.a.type_disguise
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " tdis=" + local.v
	local.v = local.a.type_idle
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " tidl=" + local.v
	local.v = 0
	if( local.a.alarmthread != NIL ){ local.v = 1 }
	local.x = local.x + " alrm=" + local.v
	local.v = local.a.coop_suppressedAt
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " supp=" + int( local.v )

	waitthread prb "actor.snap" local.a local.x
}end

//=========================================================================
prb_censusLoop:{
//=========================================================================
// Periodic full-world sweep. Bounded and OFF by default: it walks the entity table, which is
// up to 2048 slots, so it runs on a timer rather than per frame and exits the moment the
// channel is switched off.
	while( level.coop_prbCensus == 1 ){
		waitthread prb_census
		local.iv = int( getcvar "coop_probeInterval" ) + 0
		if( local.iv < 1 ){ local.iv = 5 }
		wait local.iv
	}
	level.coop_prbCensusOn = 0
}end

//=========================================================================
prb_census:{
//=========================================================================
	local.maxent = int( getcvar "maxentities" )
	if( local.maxent <= 0 ){ local.maxent = 1024 }
	local.i = 0
	local.nAct = 0
	local.nSurr = 0
	local.nDis = 0
	local.nEng = 0
	local.nSee = 0
	while( local.i < local.maxent ){
		local.e = getentbyentnum local.i
		if( local.e != NULL && local.e != NIL ){
			if( local.e.classname == "Actor" && isAlive local.e ){
				local.nAct++
				if( local.e.flags["coop_surrendered"] == 1 ){ local.nSurr++ }
				if( local.e.coop_aiDisabled == 1 ){ local.nDis++ }
				if( local.e.enemy != NULL && local.e.enemy != NIL ){ local.nEng++ }
				//[bug-2059] the headline number the whole investigation lacked: how many actors
				//can SEE a player this instant. If the aggro tracks sightlines rather than any
				//script state, this is the column that will show it.
				local.cp = waitthread coop_mod/replace.scr::player_closestTo local.e
				if( local.cp != NULL && local.cp != NIL ){
					if( local.e cansee local.cp ){ local.nSee++ }
				}
				waitthread prb_actorSnap local.e
			}
		}
		local.i++
	}
	//[bug-2052] players too. prb_playerSnap existed but nothing ever called it, so the census
	//has been reporting a world with no players in it - and the player's own state is exactly
	//what the m1l1 disguise question turns on.
	local.pi = 1
	while( local.pi <= $player.size ){
		if( $player[local.pi] != NULL ){
			waitthread prb_playerSnap $player[local.pi]
		}
		local.pi++
	}
	println( "^~^~^ PRB census.total t=" + int( level.time ) + " actors=" + local.nAct + " surrendered=" + local.nSurr + " aiDisabled=" + local.nDis + " engaging=" + local.nEng + " canSeePlayer=" + local.nSee )
}end

//=========================================================================
prb_playerSnap local.p:{
//=========================================================================
	if( local.p == NULL || local.p == NIL ){ end }
	local.x = ""
	local.v = local.p.health
	if( local.v == NIL ){ local.v = 0 - 1 }
	local.x = local.x + " hp=" + int( local.v )
	local.v = local.p.flags["coop_dbno_active"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " dbno=" + local.v
	local.v = local.p.flags["coop_isActive"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " active=" + local.v
	local.v = local.p.weapon
	if( local.v == NIL || local.v == "" ){ local.v = "-" }
	local.x = local.x + " wp=" + local.v
	//[user 2026-08-22, bug-2052] THE NUMBER THAT DECIDES THE DISGUISE. Retail m1l1 does
	//`$player threatbias -100`; coop's DEFAULT is level.coop_threatbias = 10 (variables.scr:80),
	//which is POSITIVE - the opposite of a disguise - and player.scr:1116 applies whatever that
	//level var holds on every spawn. If a player ever spawns while it is still 10, they are the
	//highest-priority target on the map for the rest of it, which would explain why it never
	//mattered what KIND of german was shooting: they were all just picking the best target.
	//threatbias is readable (real EV_GETTER, sentient.cpp:469). -6969 = IGNOREME.
	local.v = local.p.threatbias
	if( local.v == NIL ){ local.v = "NIL" }
	local.x = local.x + " tbias=" + local.v
	local.x = local.x + " lvlTbias=" + level.coop_threatbias
	//[bug-2059] position and facing - without these the visibility question cannot be asked at
	//all, and it is currently the leading explanation for the whole m1l1 aggro.
	local.v = local.p.origin
	local.x = local.x + " org=" + int( local.v[0] ) + "," + int( local.v[1] ) + "," + int( local.v[2] )
	local.v = local.p.viewangles
	local.x = local.x + " yaw=" + int( local.v[1] )
	local.v = 0
	if( local.p.is_disguised == 1 ){ local.v = 1 }
	local.x = local.x + " disg=" + local.v
	local.v = local.p.flags["coop_busted"]
	if( local.v == NIL ){ local.v = 0 }
	local.x = local.x + " busted=" + local.v
	local.x = local.x + " lvlAlarm=" + level.alarm + " lvlDisg=" + level.coop_enableDisguises

	waitthread prb "player.snap" local.p local.x
}end

//=========================================================================
// PART 2 - ON-DEMAND ENTITY DUMP  (restored; predates the bus)
//=========================================================================
// [user 2026-08-03] bug-1311 - for the e2l1 "statue" enemy and any future can-not-explain
// entity. Driven entirely over rcon so the tester never gets debug homework
// (docs/21-user-preferences.md):
//
//     rcon set coop_probe list    <- dump every actor-ish entity within 500u of any player
//     rcon set coop_probe hurt    <- same dump PLUS a hurt-1 test
//
// [2026-08-22] This label was accidentally overwritten when the bus was added and is restored
// here. main.scr:168 threads ::boot, so losing it would have thrown on the next map load.
// Both interfaces share the coop_probe cvar without colliding: a NUMERIC value is the bus
// mask, a WORD is a one-shot command. The command restores the previous mask when it is done
// instead of hard-setting 0, so firing a dump no longer silently switches the bus off.
//=========================================================================
boot:{
//=========================================================================
	while(1){
		local.cmd = getcvar("coop_probe")
		if(local.cmd == "list" || local.cmd == "hurt"){
			local.restore = level.coop_prbMask
			if( local.restore == NIL ){ local.restore = 0 }
			setcvar "coop_probe" ("" + local.restore)
			waitthread coop_probe_dump local.cmd
		}
		wait 0.5
	}
}end

//=========================================================================
coop_probe_dump local.cmd:{
//=========================================================================
	println("^~^~^ PROBE START mode=" + local.cmd + " map=" + getcvar("mapname"))
	local.maxentities = int(getcvar("maxentities"))
	local.found = 0

	for(local.i = 0; local.i < local.maxentities; local.i++){
		local.ent = getentbyentnum local.i

		if(local.ent != NULL && local.ent.model != NIL && local.ent.health != NIL){
			//skip the players themselves
			local.isplayer = 0
			for(local.p = 1; local.p <= $player.size; local.p++){
				if($player[local.p] && local.ent.entnum == $player[local.p].entnum){
					local.isplayer = 1
				}
			}

			if(local.isplayer == 0 && waitthread coop_mod/replace.scr::withinDistanceOf local.ent 500){
				local.found++
				local.vec = local.ent.origin
				local.msg = "^~^~^ PROBE ent=" + local.ent.entnum + " tn='" + local.ent.targetname + "' class=" + local.ent.classname
				local.msg = local.msg + " model=" + local.ent.model + " hp=" + local.ent.health
				//[user 2026-08-22] REAL hp too. The coop pain system buffers every german's
				//ENGINE health to coop_aiBuffer (1000) and moves his authored hp into
				//coop_actorActualHealth, restoring the buffer as damage lands - so `.health`
				//alone reads 1000 whether he is healthy, nearly dead, or genuinely immune. On
				//m1l1 that made intro_papers and intro_papers2 both report a flat 1000 and both
				//be scored "damage-proof" when only the pain-handler state could say.
				local.real = local.ent.flags["coop_actorActualHealth"]
				if( local.real == NIL ){ local.real = "-" }
				local.msg = local.msg + " hpReal=" + local.real
				local.msg = local.msg + " @ " + int(local.vec[0]) + " " + int(local.vec[1]) + " " + int(local.vec[2])
				println(local.msg)

				if(local.cmd == "hurt" && local.ent.health > 0){
					local.before = local.ent.health
					local.rbefore = local.ent.flags["coop_actorActualHealth"]
					local.ent hurt 1
					waitframe
					if(local.ent != NULL && local.ent != NIL){
						local.rafter = local.ent.flags["coop_actorActualHealth"]
						//A BUFFERED actor absorbs the hit in coop_actualHealth while .health is
						//restored, so judge on whichever field is actually tracking him.
						if( local.rbefore != NIL && local.rafter != NIL ){
							if( local.rafter >= local.rbefore ){
								println("^~^~^ PROBE ent=" + local.ent.entnum + " HURT-1 RESULT: NO DAMAGE TAKEN (buffered, hpReal " + local.rbefore + " -> " + local.rafter + ") <-- damage-proof, pain handler not decrementing")
							}else{
								println("^~^~^ PROBE ent=" + local.ent.entnum + " HURT-1 RESULT: damage ok (buffered, hpReal " + local.rbefore + " -> " + local.rafter + ")")
							}
						}else if(local.ent.health >= local.before){
							println("^~^~^ PROBE ent=" + local.ent.entnum + " HURT-1 RESULT: NO DAMAGE TAKEN (hp " + local.before + " -> " + local.ent.health + ") <-- damage-proof")
						}else{
							println("^~^~^ PROBE ent=" + local.ent.entnum + " HURT-1 RESULT: damage ok (hp " + local.before + " -> " + local.ent.health + ")")
						}
					}else{
						println("^~^~^ PROBE HURT-1 RESULT: entity died/removed from 1 damage")
					}
				}
			}
		}
	}

	println("^~^~^ PROBE END found=" + local.found)
}end
