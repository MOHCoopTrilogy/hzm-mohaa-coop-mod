//-------------------------------------------------------------------------
//[user 07-16] Is this cosmetic available to local.player? A token is LOCKED
// only if it is in the gated set (cosmetic_gatedBuild) AND has not been earned.
// Everything outside the gated set (base looks, the 48 lobby-only extras, the
// free starters) is always free. Used by armory_skin_cycle / helmet_cycle /
// lobbySkinCycle so no path can equip a gated cosmetic before it is unlocked.
//-------------------------------------------------------------------------
cosmetic_isUnlocked local.player local.token:{
	if( local.player == NULL ){ end 0 }
	waitthread cosmetic_gatedBuild
	if( level.coop_cosmeticGatedTok[local.token] != 1 ){ end 1 }		//not gated -> free
	//[user 07-17] the unlock record loads LAZILY (first kill / challenges menu) - ensure it's present
	//before reading, or every EARNED cosmetic reads locked until the player's first kill (same bug the
	//weapon gate had - loadoutpick bug-646). chal_ensure early-outs once loaded, so per-item calls are cheap.
	waitthread coop_mod/challenges.scr::chal_ensure local.player
	local.u = local.player.flags["coop_chal_unlocks"]
	if( local.u == NIL || local.u == "" ){ end 0 }
	local.hay = "|" + local.u + "|"
	if( waitthread coop_mod/main.scr::containsText local.hay ("|" + local.token + "|") 0 ){ end 1 }
}end 0
