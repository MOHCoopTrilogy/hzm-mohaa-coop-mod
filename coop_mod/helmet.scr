	//[user 08-07] bug-1545 HATLESS BODIES - GENERATED, do not hand-edit (scratchpad/nohat_build.py).
	//Every armory skin now ships a models/player/<skin>_nohat.tik twin with the head-covering
	//skelmodel/surface lines deleted at source, so a chosen helmet is the ONLY thing on the head
	//(the old runtime nodraw whitelist could never cover a skin nobody had looked at yet, and the
	//armory 3D preview - a UI charRender widget - has no surface control at all).
	//  coop_skinBase["<skin>_nohat"]  = the base roster name, so a worn hatless body is still
	//                                   recognised as its roster skin by the unlock/heal checks.
	//  coop_skinStdHelmet["<skin>"]   = the coop_helmets piece that reproduces the headgear that
	//                                   was removed - THIS is what "Standard Issue" now attaches,
	//                                   so the default look of every skin is unchanged. Empty
	//                                   string = the skin was already bare-headed.
	level.coop_skinBase["allied_101st_captain_nohat"] = "allied_101st_captain"
	level.coop_skinStdHelmet["allied_101st_captain"] = "models/coop_helmets/coop_std_us_helmet_captain_snw.tik"
	level.coop_skinBase["allied_101st_infantry_nohat"] = "allied_101st_infantry"
	level.coop_skinStdHelmet["allied_101st_infantry"] = "models/coop_helmets/coop_std_us_pfc_snow_helmet1.tik"
