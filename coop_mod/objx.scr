//=========================================================================
// objx.scr - HZM coop EXTRA MISSION OBJECTIVES (objectives-next, 2026-10-18; docs/proposals/objectives_ch1-3_2026-10-18)
//
// Shared mechanics for the extra chapter 1-3 objectives. WHAT exists on a map is DATA (docs/tools/objx_points.json ->
// coop_mod/objx_points.scr, generated by docs/tools/gen_objx.py); this file is the mechanics, written once:
//
//   HUD side line   "Additional Objectives" rows 3..5 of the objectives panel (coop_so3..so5 cvars, coop_obj_push), re-sent on
//                   spawn / late join. The vanilla objective list and the officer + radio lines (rows 1-2) are never touched.
//   hold            a timed defence of a zone. The clock, defend-zone rules, marker ring, waves and HUD are the counter-attack's
//                   own helpers (coop_counter.scr, branch alarmplace-next): it counts only while someone stands in the zone,
//                   pauses, winds back, and the zone is "lost" when enemies sit in an empty one.
//   charge          hold-in-reach plant (3 s), armed charge, fuse, blast (the m1l2b / officer-radio recipe). TODO(iconprompts-next):
//                   when coop_mod/actprompt.scr is merged, show the HD hold ring here instead of the feed text + stopwatch.
//   radio           a destroyable radio set (rnf_radio_destroy recipe): gunfire / grenades or a planted charge. While a set
//                   stands and another has fallen, the garrison is called on a timer.
//   intel           a pickup (documents on a prop) counted to a total.
//   escort          a freed prisoner who follows the squad to a destination.
//
// REQUIRED: every objective must be done before the mission can end (objx_gate, called from missioncomplete.scr::main). The gate
// never blocks a VANILLA objective: it only holds the final hand-off, force-starts anything whose trigger was skipped, and waives
// an objective that makes no progress for coop_objxFailsafe seconds so a broken prop can never soft-lock a map.
//
//   coop_objx 0/1           master switch (default 1)
//   coop_objxDebug 0/1      greppable ^~^~^ OBJX lines (default 1)
//   coop_objxFailsafe 600   seconds of the exit gate with no progress before the remaining objectives are waived
//   coop_objxHoldSecs <n>   test override of a hold length (0 = data value, scaled by players)
//   coop_objxWaveGap 30     seconds between hold waves
//   coop_objxFuse 8         charge fuse
//
// Never runs on: Omaha, stealth / disguise maps, lobbies, briefings, map-tester runs, MP arena runs.
//=========================================================================

ox_log local.txt:{
	if( getcvar( "coop_objxDebug" ) != "0" ){ println( "^~^~^ OBJX " + local.txt ) }
}end


// "" when objectives may run on this map, else the reason they may not
ox_blocked:{
	local.m = level.coop_mapname
	if( local.m == NIL ){ end "nomap" }
	if( level.coop_mpRun == 1 ){ end "mp" }
	if( level.coop_lobbyMap == 1 ){ end "lobby" }
	local.mt = getcvar( "coop_maptest" )
	if( local.mt != "0" && local.mt != "" ){ end "maptest" }
	if( level.coop_stealthMap == 1 ){ end "stealth" }
	if( level.coop_enableDisguises ){ end "disguise" }
	if( local.m == "m3l1a" || local.m == "m3l1b" ){ end "omaha" }
	if( waitthread coop_mod/main.scr::containsText local.m "briefing" 0 ){ end "briefing" }
}end ""


// objective index of an id (0 = unknown)
ox_index local.id:{
	for( local.k = 1; local.k <= level.objx_n; local.k++ ){
		if( level.objx_id[local.k] == local.id ){ end local.k }
	}
}end 0


// 1 when every objective of the map is done (or the map has none / the system is off)
objx_alldone:{
	if( level.objx_active != 1 ){ end 1 }
	if( level.objx_doneN >= level.objx_n ){ end 1 }
}end 0


//=========================================================================
// ENTRY - threaded from main.scr::main on every map; returns at once unless the map has an entry in objx_points.scr
//=========================================================================
objx_init:{
	if( getcvar( "coop_objx" ) == "0" ){ end }
	if( level.objx_initRan == 1 ){ end }
	level.objx_initRan = 1
	// map scripts set their stealth / disguise flags a little after main.scr::main: look again once they have
	wait 3
	local.why = waitthread ox_blocked
	if( local.why != "" ){
		if( local.why != "briefing" && local.why != "lobby" ){ waitthread ox_log ( "blocked on " + level.coop_mapname + ": " + local.why ) }
		end
	}
	local.n = waitthread coop_mod/objx_points.scr::ox_load level.coop_mapname
	if( local.n < 1 ){ end }
	waitthread coop_mod/replace.scr::waitForPlayer
	level.objx_active = 1
	level.objx_doneN = 0
	level.objx_gateActive = 0
	level.objx_lastProg = level.time
	for( local.i = 1; local.i <= local.n; local.i++ ){
		level.objx_stat[local.i] = 1
		level.objx_prog[local.i] = 0
		level.objx_need[local.i] = 0
	}
	for( local.k = 1; local.k <= level.objx_itn; local.k++ ){
		level.objx_rd_dead[local.k] = 0
	}
	waitthread ox_log ( "armed " + level.coop_mapname + " objectives=" + local.n + " items=" + level.objx_itn + " players=" + ( waitthread coop_mod/coop_counter.scr::counter_players ) )
	thread ox_player_watch
	for( local.i = 1; local.i <= local.n; local.i++ ){
		thread ox_arm local.i
	}
}end


// wait for an objective's start condition, then start it
ox_arm local.i:{
	local.w = level.objx_when[local.i]
	local.arg = level.objx_arg[local.i]
	if( local.w == "trigger" ){
		local.t = $( local.arg )
		if( local.t == NULL || local.t == NIL ){
			waitthread ox_log ( "trigger " + local.arg + " is missing on " + level.coop_mapname + " - starting " + level.objx_id[local.i] + " now" )
		} else {
			local.t waittill trigger
		}
	}
	if( local.w == "after" ){
		local.j = waitthread ox_index local.arg
		while( local.j > 0 && level.objx_stat[local.j] != 3 ){ wait 0.5 }
	}
	waitthread ox_activate local.i
}end


//=========================================================================
// HUD side lines
//=========================================================================

// store + send one objective's line (all players)
ox_set local.i local.status local.text:{
	local.ln = level.objx_line[local.i]
	level.objx_lstat[local.ln] = local.status
	level.objx_ltext[local.ln] = local.text
	waitthread coop_mod/objectives.scr::coop_obj_push local.ln local.status local.text
}end


// re-send every stored line to one player (spawn / late join, after obj_setup.cfg wiped the cvars)
ox_repush_player local.ent:{
	if( local.ent == NULL || local.ent == NIL ){ end }
	for( local.ln = 3; local.ln <= 5; local.ln++ ){
		local.st = level.objx_lstat[local.ln]
		local.tx = level.objx_ltext[local.ln]
		if( local.st == NIL || local.tx == NIL ){ continue }
		waitthread coop_mod/objectives.scr::coop_obj_push_one local.ent local.ln local.st local.tx
	}
}end


ox_repush_delayed:{
	wait 1
	waitthread ox_repush_player self
}end


ox_player_watch:{
	while( 1 ){
		level waittill playerspawn
		local.sp = parm.other
		if( local.sp != NULL && local.sp != NIL ){ local.sp thread ox_repush_delayed }
	}
}end


// a per-player obj_setup.cfg may run just after a push: send again a few times
ox_reassert:{
	for( local.n = 0; local.n < 4; local.n++ ){
		wait 2.5
		for( local.ln = 3; local.ln <= 5; local.ln++ ){
			local.st = level.objx_lstat[local.ln]
			local.tx = level.objx_ltext[local.ln]
			if( local.st == NIL || local.tx == NIL ){ continue }
			waitthread coop_mod/objectives.scr::coop_obj_push local.ln local.st local.tx
		}
	}
}end


//=========================================================================
// life cycle
//=========================================================================
ox_activate local.i:{
	if( level.objx_stat[local.i] != 1 ){ end }
	level.objx_stat[local.i] = 2
	level.objx_t0[local.i] = level.time
	level.objx_lastProg = level.time
	local.id = level.objx_id[local.i]
	waitthread ox_log ( "ACTIVE " + local.id + " type=" + level.objx_type[local.i] + " t=" + level.time )
	waitthread ox_set local.i 2 level.objx_text[local.i]
	waitthread coop_mod/feed.scr::feed_all 1 ( "objx_new_" + local.id ) ( "New objective: " + level.objx_text[local.i] )
	exec coop_mod/replace.scr::playsound objective_text
	thread ox_reassert
	local.ty = level.objx_type[local.i]
	if( local.ty == "intel" ){ thread ox_intel_start local.i }
	if( local.ty == "hold" ){ thread ox_hold_run local.i }
	if( local.ty == "radio" ){ thread ox_radio_start local.i }
	if( local.ty == "escort" ){ thread ox_escort_start local.i }
}end


ox_done local.i:{
	if( level.objx_stat[local.i] == 3 ){ end }
	level.objx_stat[local.i] = 3
	level.objx_doneN = level.objx_doneN + 1
	level.objx_lastProg = level.time
	level.objx_tdone[local.i] = level.time
	local.el = level.time - level.objx_t0[local.i]
	waitthread ox_log ( "DONE " + level.objx_id[local.i] + " took=" + local.el + "s done=" + level.objx_doneN + "/" + level.objx_n + " t=" + level.time )
	waitthread ox_set local.i 3 level.objx_donetext[local.i]
	waitthread coop_mod/feed.scr::feed_all 1 ( "objx_done_" + level.objx_id[local.i] ) level.objx_donetext[local.i]
	exec coop_mod/replace.scr::playsound objective_text
	if( level.objx_doneN >= level.objx_n ){
		waitthread ox_log ( "ALL DONE " + level.objx_n + " objectives t=" + level.time )
		waitthread coop_mod/feed.scr::feed_all 1 "objx_all" "All extra objectives complete"
	}
}end


// the mission-end hand-off waits here (missioncomplete.scr::main). Returns once every objective is done.
objx_gate:{
	if( level.objx_active != 1 ){ end }
	if( level.objx_doneN >= level.objx_n ){ end }
	level.objx_gateActive = 1
	waitthread ox_log ( "GATE closed: " + level.objx_doneN + "/" + level.objx_n + " done at t=" + level.time )
	// an objective whose trigger the squad bypassed is started now
	for( local.i = 1; local.i <= level.objx_n; local.i++ ){
		if( level.objx_stat[local.i] == 1 ){
			waitthread ox_log ( "GATE force-start " + level.objx_id[local.i] )
			waitthread ox_activate local.i
		}
	}
	waitthread coop_mod/feed.scr::feed_exitRefused NULL
	local.fs = 600
	if( getcvar( "coop_objxFailsafe" ) != "" ){ local.fs = int( getcvar( "coop_objxFailsafe" ) ) }
	if( local.fs < 30 ){ local.fs = 30 }
	local.nextfeed = level.time + 45
	local.seenDone = level.objx_doneN
	level.objx_lastProg = level.time
	while( level.objx_doneN < level.objx_n ){
		wait 1
		if( level.objx_doneN != local.seenDone ){
			local.seenDone = level.objx_doneN
			level.objx_lastProg = level.time
		}
		if( level.time >= local.nextfeed ){
			waitthread coop_mod/feed.scr::feed_all 0 "objx_gate" "Finish the extra objectives before you leave"
			local.nextfeed = level.time + 45
		}
		if( ( level.time - level.objx_lastProg ) >= local.fs ){
			waitthread ox_log ( "GATE failsafe after " + local.fs + "s without progress: waiving the rest" )
			for( local.i = 1; local.i <= level.objx_n; local.i++ ){
				if( level.objx_stat[local.i] != 3 ){
					level.objx_stat[local.i] = 2
					waitthread ox_done local.i
				}
			}
		}
	}
	waitthread ox_log ( "GATE open t=" + level.time )
	level.objx_gateActive = 0
}end


//=========================================================================
// props
//=========================================================================
// a static prop / pickup model at an authored spot
ox_spawn_model local.k:{
	local.e = spawn script_model
	local.e model level.objx_it_model[local.k]
	local.e.origin = level.objx_it_pos[local.k]
	local.yw = level.objx_it_yaw[local.k]
	local.e.angles = ( 0 local.yw 0 )
}end local.e


//=========================================================================
// INTEL: documents on a prop; counted to the total
//=========================================================================
ox_intel_start local.i:{
	local.cnt = 0
	for( local.k = 1; local.k <= level.objx_itn; local.k++ ){
		if( level.objx_it_o[local.k] != local.i ){ continue }
		if( level.objx_it_kind[local.k] == "prop" ){
			local.pr = waitthread ox_spawn_model local.k
			level.objx_it_ent[local.k] = local.pr
		}
		if( level.objx_it_kind[local.k] == "pickup" ){
			local.cnt = local.cnt + 1
			thread ox_pickup_run local.i local.k
		}
	}
	level.objx_need[local.i] = local.cnt
	if( local.cnt < 1 ){ waitthread ox_done local.i }
}end


ox_pickup_run local.i local.k:{
	local.vis = waitthread ox_spawn_model local.k
	level.objx_it_ent[local.k] = local.vis
	local.vis rendereffects "+fullbright"
	local.trig = spawn trigger_use
	local.trig.origin = level.objx_it_pos[local.k] + ( 0 0 10 )
	local.trig solid
	local.trig setsize ( -44 -44 -20 ) ( 44 44 60 )
	waitthread coop_mod/feed.scr::feed_all 1 ( "objx_find_" + level.objx_id[local.i] ) ( "Find " + level.objx_it_label[local.k] + " and press Use" )
	local.p = NULL
	while( local.p == NULL ){
		local.trig waittill trigger
		local.p = parm.other
		if( local.p == NIL ){ local.p = NULL }
		if( local.p != NULL ){
			if( local.p.classname != "Player" ){ local.p = NULL }
		}
	}
	local.p playsound pickup_papers
	local.trig remove
	if( local.vis != NULL ){ local.vis remove }
	level.objx_prog[local.i] = level.objx_prog[local.i] + 1
	level.objx_lastProg = level.time
	waitthread ox_log ( "PICKUP " + level.objx_id[local.i] + " " + level.objx_prog[local.i] + "/" + level.objx_need[local.i] + " by " + local.p.netname )
	waitthread coop_mod/feed.scr::feed_all 1 ( "objx_got_" + level.objx_id[local.i] ) ( local.p.netname + " recovered " + level.objx_it_label[local.k] )
	if( level.objx_prog[local.i] >= level.objx_need[local.i] ){
		waitthread ox_done local.i
	} else {
		waitthread ox_set local.i 2 ( level.objx_text[local.i] + " [" + level.objx_prog[local.i] + "/" + level.objx_need[local.i] + "]" )
	}
}end


//=========================================================================
// HOLD: a timed defence of a zone (the counter-attack's zone, clock, ring, HUD and wave helpers)
//=========================================================================
// 4+ players: the data value; 2 players: 70 percent; 1 player: 45 percent
ox_hold_scale:{
	local.pc = waitthread coop_mod/coop_counter.scr::counter_players
	local.f = 1.0
	if( local.pc <= 1 ){
		local.f = 0.45
	} else if( local.pc == 2 ){
		local.f = 0.7
	}
}end local.f


// one hold wave: size and cap from the counter-attack's rules (players -> men, men alive), from the objective's AUTHORED entry points
// (cycled, level.objx_sp_*), else the counter-attack's own planned entry. Returns the men made.
ox_wave local.i local.wave:{
	local.m = 0
	for( local.s = 1; local.s <= level.objx_spn; local.s++ ){
		if( level.objx_sp_o[local.s] == local.i ){ local.m = local.m + 1 }
	}
	if( local.m < 1 ){
		local.made = waitthread coop_mod/coop_counter.scr::counter_wave local.wave
		end local.made
	}
	local.pc = waitthread coop_mod/coop_counter.scr::counter_players
	if( local.pc < 1 ){ end 0 }
	local.n = waitthread coop_mod/coop_counter.scr::counter_wavesize local.pc
	local.cap = 14
	if( getcvar( "coop_counterCap" ) != "" ){ local.cap = int( getcvar( "coop_counterCap" ) ) }
	if( local.cap < 1 ){ local.cap = 14 }
	local.alive = waitthread coop_mod/coop_counter.scr::counter_alive
	if( ( local.alive + local.n ) > local.cap ){ local.n = local.cap - local.alive }
	if( local.n < 1 ){
		waitthread ox_log ( "HOLD wave " + local.wave + " skipped: cap " + local.cap + " alive " + local.alive )
		end 0
	}
	local.pick = ( local.wave - 1 ) - ( int( ( local.wave - 1 ) / local.m ) * local.m ) + 1
	local.c = 0
	local.pos = NIL
	for( local.s = 1; local.s <= level.objx_spn; local.s++ ){
		if( level.objx_sp_o[local.s] != local.i ){ continue }
		local.c = local.c + 1
		if( local.c == local.pick ){ local.pos = level.objx_sp_pos[local.s] }
	}
	local.made = waitthread coop_mod/coop_counter.scr::counter_squad local.pos local.n local.wave "counter"
	waitthread ox_log ( "HOLD wave " + local.wave + " players=" + local.pc + " want=" + local.n + " made=" + local.made + " alive=" + ( waitthread coop_mod/coop_counter.scr::counter_alive ) + " entry=" + local.pick + " at=" + local.pos )
}end local.made


// distance from the zone centre to the nearest living wave man (-1 = none), for the log
ox_foe_near:{
	local.best = 0 - 1
	if( level.coop_counterN == NIL ){ end local.best }
	for( local.q = 1; local.q <= level.coop_counterN; local.q++ ){
		local.a = level.coop_counterActors[local.q]
		if( local.a == NULL || local.a == NIL ){ continue }
		if( !( isAlive local.a ) ){ continue }
		local.d = vector_length ( local.a.origin - level.coop_czSel )
		if( local.best < 0 || local.d < local.best ){ local.best = local.d }
	}
}end local.best


ox_hold_run local.i:{
	local.f = waitthread ox_hold_scale
	local.total = int( level.objx_secs[local.i] * local.f )
	local.ov = getcvar "coop_objxHoldSecs"
	if( local.ov != "" && local.ov != "0" ){ local.total = int( local.ov ) }
	if( local.total < 15 ){ local.total = 15 }
	local.gap = 30
	if( getcvar( "coop_objxWaveGap" ) != "" ){ local.gap = int( getcvar( "coop_objxWaveGap" ) ) }
	if( local.gap < 5 ){ local.gap = 5 }
	local.emptyGrace = 10
	if( getcvar( "coop_counterGrace" ) != "" ){ local.emptyGrace = int( getcvar( "coop_counterGrace" ) ) }
	if( local.emptyGrace < 1 ){ local.emptyGrace = 1 }
	local.loseTime = 30
	if( getcvar( "coop_counterLoseTime" ) != "" ){ local.loseTime = int( getcvar( "coop_counterLoseTime" ) ) }
	if( local.loseTime < 3 ){ local.loseTime = 3 }

	// the zone the counter-attack helpers read
	level.coop_czSel = level.objx_zpos[local.i]
	level.coop_czSelR = level.objx_zr[local.i]
	level.coop_czSelName = level.objx_zname[local.i]
	level.coop_czSrc = "objx"
	waitthread ox_log ( "HOLD " + level.objx_id[local.i] + " zone=" + level.coop_czSelName + " at=" + level.coop_czSel + " r=" + level.coop_czSelR + " total=" + local.total + "s players=" + ( waitthread coop_mod/coop_counter.scr::counter_players ) )
	thread coop_mod/coop_counter.scr::counter_marker_start
	waitthread coop_mod/feed.scr::feed_all 1 "objx_hold_go" ( "Reach " + level.coop_czSelName + " and hold it" )

	// the clock starts when the first defender stands in the zone
	while( ( waitthread coop_mod/coop_counter.scr::counter_inside ) < 1 ){ wait 0.5 }
	waitthread coop_mod/feed.scr::feed_all 0 "objx_hold" ( "Hold the position - the fleet is answering. Defend: " + level.coop_czSelName )
	for( local.pi = 1; local.pi <= $player.size; local.pi++ ){
		local.pp = $player[local.pi]
		if( local.pp == NULL || local.pp == NIL ){ continue }
		local.pp playsound coop_radio_on
	}

	local.remaining = local.total
	local.t0 = level.time
	local.last = level.time
	local.nextwave = level.time + 10
	local.wave = 0
	local.emptyT = 0
	local.loseT = 0
	local.state = "hold"
	local.lostN = 0
	local.nextlog = level.time
	while( local.remaining > 0 ){
		wait 0.25
		if( level.time >= local.nextwave && local.remaining > 10 ){
			local.wave = local.wave + 1
			waitthread ox_wave local.i local.wave
			local.nextwave = level.time + local.gap + ( randomint 11 )
		}
		local.now = level.time
		local.dt = local.now - local.last
		local.last = local.now

		local.inside = waitthread coop_mod/coop_counter.scr::counter_inside
		local.prev = local.state
		if( local.inside > 0 ){
			local.emptyT = 0
			local.loseT = 0
			local.remaining = local.remaining - local.dt
			local.state = "hold"
			level.objx_lastProg = level.time
		} else {
			local.emptyT = local.emptyT + local.dt
			if( local.emptyT < local.emptyGrace ){
				local.state = "paused"
			} else {
				local.state = "rewind"
				local.remaining = local.remaining + local.dt
				if( local.remaining > local.total ){ local.remaining = local.total }
			}
			if( ( waitthread coop_mod/coop_counter.scr::counter_foes_inzone ) > 0 ){
				local.loseT = local.loseT + local.dt
			}
			if( local.loseT >= local.loseTime ){
				local.lostN = local.lostN + 1
				local.remaining = local.total
				local.emptyT = 0
				local.loseT = 0
				local.state = "lost"
				local.nextwave = level.time + 10
				waitthread coop_mod/feed.scr::feed_all 0 "cz_lost" "Defence zone lost - the enemy took the position. Retake it: the defence starts over"
				thread coop_mod/coop_counter.scr::counter_marker_pulse
				waitthread ox_log ( "HOLD zone LOST #" + local.lostN + " t=" + level.time )
			}
		}
		if( local.state != local.prev ){
			waitthread ox_log ( "HOLD state " + local.prev + " -> " + local.state + " remaining=" + local.remaining + " inside=" + local.inside + " t=" + level.time )
		}

		// the ring shows for the first 8 s and whenever a defender is near / outside the edge
		if( level.coop_czPulsing != 1 ){
			if( ( level.time - local.t0 ) < 8 ){
				waitthread coop_mod/coop_counter.scr::counter_ring_set 1
			} else {
				local.near = waitthread coop_mod/coop_counter.scr::counter_edge_near
				waitthread coop_mod/coop_counter.scr::counter_ring_set local.near
			}
		}

		// per-player clock + warning
		local.txt = waitthread coop_mod/coop_counter.scr::counter_clock local.remaining
		for( local.pi = 1; local.pi <= $player.size; local.pi++ ){
			local.pp = $player[local.pi]
			if( local.pp == NULL || local.pp == NIL ){ continue }
			if( local.pp.dmteam == "spectator" ){ continue }
			local.mine = 1
			if( ( waitthread coop_mod/coop_counter.scr::counter_eligible local.pp ) == 1 ){
				if( ( waitthread coop_mod/coop_counter.scr::counter_inzone local.pp.origin ) != 1 ){ local.mine = 0 }
			}
			if( local.mine == 1 ){
				local.pp.flags["coop_czOut"] = NIL
				if( local.state == "rewind" ){
					waitthread coop_mod/coop_counter.scr::counter_hud local.pp ( "HOLD  " + local.txt ) "Zone empty - the clock is winding back" 1 0.45 0.2
				} else if( local.state == "paused" ){
					waitthread coop_mod/coop_counter.scr::counter_hud local.pp ( "HOLD  " + local.txt ) "Zone empty - clock paused" 1 0.8 0.2
				} else {
					waitthread coop_mod/coop_counter.scr::counter_hud local.pp ( "HOLD  " + local.txt ) ( "Hold: " + level.coop_czSelName ) 0.6 1 0.6
				}
			} else {
				waitthread coop_mod/coop_counter.scr::counter_hud local.pp ( "HOLD  " + local.txt ) "RETURN TO THE ZONE" 1 0.3 0.2
				if( local.pp.flags["coop_czOut"] == NIL || level.time >= local.pp.flags["coop_czOut"] ){
					waitthread coop_mod/feed.scr::feed_player local.pp 0 "cz_return" "Return to the defence zone"
					local.pp.flags["coop_czOut"] = level.time + 8
					thread coop_mod/coop_counter.scr::counter_marker_pulse
				}
			}
		}

		if( level.time >= local.nextlog ){
			waitthread ox_log ( "HOLD tick t=" + level.time + " elapsed=" + ( level.time - local.t0 ) + " remaining=" + local.remaining + " state=" + local.state + " inside=" + local.inside + " waves=" + local.wave + " foes=" + ( waitthread coop_mod/coop_counter.scr::counter_alive ) + " nearest=" + ( waitthread ox_foe_near ) )
			local.nextlog = level.time + 5
		}
	}
	waitthread coop_mod/coop_counter.scr::counter_hud_off
	waitthread coop_mod/coop_counter.scr::counter_marker_stop
	waitthread ox_log ( "HOLD clock 0:00 elapsed=" + ( level.time - local.t0 ) + " waves=" + local.wave + " lost=" + local.lostN )
	waitthread ox_done local.i
}end


//=========================================================================
// CHARGE: hold-in-reach plant -> armed charge -> fuse -> blast. Returns 1 when the charge went off at local.pos, 0 when the
// plant was abandoned or the target died first. local.k is the radio / target slot (level.objx_rd_dead[local.k]).
//=========================================================================
ox_plant local.planter local.pos local.k:{
	if( local.planter == NULL || local.planter == NIL ){ end 0 }
	if( local.planter.classname != "Player" ){ end 0 }
	waitthread coop_mod/feed.scr::feed_player local.planter 0 "objx_plant" "Planting the charge - stay at the target"
	local.hold = 3
	// TODO(iconprompts-next): actprompt hold ring for local.hold seconds instead of the native stopwatch
	local.planter stopwatch local.hold
	local.t = 0
	while( local.t < local.hold ){
		wait 0.25
		local.t = local.t + 0.25
		if( local.planter == NULL ){ end 0 }
		if( !isAlive local.planter ){ end 0 }
		if( level.objx_rd_dead[local.k] == 1 ){
			local.planter stopwatch 0
			end 0
		}
		local.d = vector_length ( local.planter.origin - local.pos )
		if( local.d > 150 ){
			local.planter stopwatch 0
			waitthread coop_mod/feed.scr::feed_player local.planter 0 "objx_plant" "Charge cancelled - stay within reach of the target"
			end 0
		}
	}
	local.charge = spawn script_model
	local.charge model "models/items/explosive.tik"
	local.charge.origin = local.pos + ( 0 0 4 )
	local.charge notsolid
	local.charge playsound plantbomb
	local.charge loopsound bombtick
	waitthread coop_mod/feed.scr::feed_all 1 "objx_planted" ( local.planter.netname + " planted a charge" )
	local.fuse = 8
	if( getcvar( "coop_objxFuse" ) != "" ){ local.fuse = int( getcvar( "coop_objxFuse" ) ) }
	if( local.fuse < 2 ){ local.fuse = 2 }
	for( local.pi = 1; local.pi <= $player.size; local.pi++ ){
		local.pp = $player[local.pi]
		if( local.pp != NULL && local.pp != NIL ){ local.pp stopwatch local.fuse }
	}
	wait local.fuse
	local.charge stoploopsound bombtick
	local.charge remove
}end 1


// the blast + fire + smoke at a spot (the rnf_radio_destroy wreck)
ox_boom local.pos:{
	local.e1 = spawn "models/emitters/explosion_bombwall.tik"
	local.e1.origin = local.pos
	local.e1 notsolid
	local.e1 anim start
	radiusdamage local.pos 150 200
	local.fire = spawn "models/emitters/firegood.tik"
	local.fire.origin = local.pos + ( 0 0 8 )
	local.fire notsolid
	local.fire anim start
	local.fire loopsound fire_med
	local.smoke = spawn "models/emitters/linger_smoke.tik"
	local.smoke.origin = local.pos + ( 0 0 12 )
	local.smoke anim start
}end


//=========================================================================
// RADIO sets: gunfire / grenades (health poll) or a planted charge silence a set
//=========================================================================
ox_radio_start local.i:{
	local.cnt = 0
	for( local.k = 1; local.k <= level.objx_itn; local.k++ ){
		if( level.objx_it_o[local.k] != local.i ){ continue }
		if( level.objx_it_kind[local.k] != "radio" ){ continue }
		local.cnt = local.cnt + 1
		thread ox_radio_one local.i local.k
	}
	level.objx_need[local.i] = local.cnt
	waitthread ox_radio_text local.i
	if( local.cnt < 1 ){
		waitthread ox_done local.i
		end
	}
	thread ox_radio_pressure local.i
}end


// "<text> [n remaining]"
ox_radio_text local.i:{
	local.left = level.objx_need[local.i] - level.objx_prog[local.i]
	if( local.left < 1 ){ end }
	waitthread ox_set local.i 2 ( level.objx_text[local.i] + " [" + local.left + " remaining]" )
}end


ox_radio_one local.i local.k:{
	local.ref = level.objx_it_ref[local.k]
	if( local.ref != "" ){
		local.v = $( local.ref )
		if( local.v != NULL && local.v != NIL ){
			local.sz = $( local.ref ).size
			if( local.sz != NIL && local.sz > 1 ){
				// several entities share the name (the retail lump has radio1_sound twice): take them all
				for( local.q = 1; local.q <= local.sz; local.q++ ){
					local.vv = $( local.ref )[local.q]
					if( local.vv != NULL && local.vv != NIL ){
						local.vv stoploopsound
						local.vv remove
					}
				}
			} else {
				local.v stoploopsound
				local.v remove
			}
		}
	}
	local.pos = level.objx_it_pos[local.k]
	local.radio = spawn script_model_realdamage
	local.radio model level.objx_it_model[local.k]
	local.radio.origin = local.pos
	local.yw = level.objx_it_yaw[local.k]
	local.radio.angles = ( 0 local.yw 0 )
	local.radio.health = 1000
	local.radio setsize ( -14 -14 0 ) ( 14 14 22 )
	local.radio solid
	local.radio takedamage
	if( level.objx_it_loop[local.k] != "" ){ local.radio loopsound level.objx_it_loop[local.k] }
	level.objx_rd_ent[local.k] = local.radio

	// the charge option: a pulsing marker + a use trigger beside the set
	local.pulse = spawn script_model
	local.pulse model "models/items/pulse_explosive.tik"
	local.pulse.origin = local.pos + ( 0 0 4 )
	local.pulse notsolid
	local.pulse anim start
	local.tuse = spawn trigger_use
	local.tuse.origin = local.pos + ( 0 0 10 )
	local.tuse solid
	local.tuse setsize ( -30 -30 -10 ) ( 30 30 60 )
	thread ox_radio_charge local.i local.k local.tuse local.pos
	waitthread ox_log ( "RADIO set " + local.k + " armed at " + local.pos )

	// gunfire / grenades: polled health (a script_model_realdamage takes damage; nothing relies on a kill event)
	while( level.objx_rd_dead[local.k] != 1 ){
		wait 0.4
		if( local.radio == NULL ){ break }
		if( local.radio.health < 700 ){ break }
	}
	waitthread ox_radio_down local.i local.k local.pos "shot"
	if( local.pulse != NULL ){ local.pulse delete }
	if( local.tuse != NULL ){ local.tuse remove }
}end


// planted charge on a set: use -> plant -> fuse -> the set goes up
ox_radio_charge local.i local.k local.tuse local.pos:{
	while( level.objx_rd_dead[local.k] != 1 && local.tuse != NULL ){
		local.tuse waittill trigger
		local.planter = parm.other
		if( local.planter == NULL || local.planter == NIL ){ continue }
		if( level.objx_rd_planting[local.k] == 1 ){ continue }
		level.objx_rd_planting[local.k] = 1
		local.ok = waitthread ox_plant local.planter local.pos local.k
		level.objx_rd_planting[local.k] = 0
		if( local.ok == 1 ){
			waitthread ox_radio_down local.i local.k local.pos "charge"
			break
		}
	}
}end


// one set silenced (by whichever path got there first)
ox_radio_down local.i local.k local.pos local.how:{
	if( level.objx_rd_dead[local.k] == 1 ){ end }
	level.objx_rd_dead[local.k] = 1
	local.radio = level.objx_rd_ent[local.k]
	if( local.radio != NULL && local.radio != NIL ){
		local.radio stoploopsound
		local.radio playsound coop_radio_blast
		local.radio remove
	}
	waitthread ox_boom local.pos
	level.objx_prog[local.i] = level.objx_prog[local.i] + 1
	level.objx_lastProg = level.time
	waitthread ox_log ( "RADIO down " + local.k + " (" + local.how + ") " + level.objx_prog[local.i] + "/" + level.objx_need[local.i] + " t=" + level.time )
	waitthread coop_mod/feed.scr::feed_all 1 ( "objx_radio_" + local.k ) "Radio set destroyed"
	if( level.objx_prog[local.i] >= level.objx_need[local.i] ){
		waitthread ox_done local.i
	} else {
		waitthread ox_radio_text local.i
	}
}end


// a set still stands while another has fallen: the garrison is called on a timer
ox_radio_pressure local.i:{
	local.gap = level.objx_gap[local.i]
	if( local.gap < 20 ){ local.gap = 75 }
	if( getcvar( "coop_objxCallGap" ) != "" && getcvar( "coop_objxCallGap" ) != "0" ){ local.gap = int( getcvar( "coop_objxCallGap" ) ) }
	local.next = level.time + local.gap
	local.n = 0
	while( level.objx_stat[local.i] == 2 ){
		wait 2
		if( level.objx_prog[local.i] < 1 ){
			local.next = level.time + local.gap
			continue
		}
		if( level.time >= local.next ){
			local.n = local.n + 1
			waitthread coop_mod/feed.scr::feed_all 0 "objx_call" "A surviving radio operator is calling for help!"
			local.rsnd = "coop_radio_german_reinf" + ( ( randomint 9 ) + 1 )
			for( local.pi = 1; local.pi <= $player.size; local.pi++ ){
				local.pp = $player[local.pi]
				if( local.pp != NULL && local.pp != NIL ){ local.pp playsound local.rsnd }
			}
			local.made = waitthread coop_mod/coop_counter.scr::counter_wave ( 100 + local.n )
			waitthread ox_log ( "RADIO call #" + local.n + " made=" + local.made + " t=" + level.time )
			local.next = level.time + local.gap
		}
	}
}end


//=========================================================================
// ESCORT: a freed prisoner follows the squad to a destination (the zone of the objective).
// Failure handling: if he dies he is stood up again at his start after 10 s; the objective never fails the mission.
//=========================================================================
ox_escort_start local.i:{
	local.k = 0
	for( local.q = 1; local.q <= level.objx_itn; local.q++ ){
		if( level.objx_it_o[local.q] == local.i && level.objx_it_kind[local.q] == "actor" ){ local.k = local.q; break }
	}
	if( local.k < 1 ){
		waitthread ox_done local.i
		end
	}
	local.dest = level.objx_zpos[local.i]
	local.dr = level.objx_zr[local.i]
	local.n = 0
	while( level.objx_stat[local.i] == 2 ){
		local.n = local.n + 1
		local.a = spawn level.objx_it_model[local.k]
		local.a.origin = level.objx_it_pos[local.k]
		local.yw = level.objx_it_yaw[local.k]
		local.a.angles = ( 0 local.yw 0 )
		local.a droptofloor
		local.a american
		local.a ai_off
		local.a.flags["coop_noDbno"] = 1
		local.trig = spawn trigger_use
		local.trig.origin = local.a.origin + ( 0 0 24 )
		local.trig solid
		local.trig setsize ( -48 -48 -24 ) ( 48 48 60 )
		waitthread coop_mod/feed.scr::feed_all 1 "objx_free" ( "Free " + level.objx_it_label[local.k] + " - press Use" )
		local.p = NULL
		while( local.p == NULL ){
			local.trig waittill trigger
			local.p = parm.other
			if( local.p == NIL ){ local.p = NULL }
			if( local.p != NULL ){
				if( local.p.classname != "Player" ){ local.p = NULL }
			}
		}
		local.trig remove
		local.a ai_on
		waitthread coop_mod/feed.scr::feed_all 1 "objx_freed" ( local.p.netname + " freed " + level.objx_it_label[local.k] + " - take him to " + level.objx_zname[local.i] )
		waitthread ox_log ( "ESCORT freed by " + local.p.netname )
		level.objx_lastProg = level.time
		local.arrived = 0
		while( local.arrived == 0 && local.a != NULL && isAlive local.a ){
			wait 0.75
			local.d = vector_length ( local.a.origin - local.dest )
			if( local.d <= local.dr ){
				local.arrived = 1
				break
			}
			// follow the nearest living player; head for the destination once the squad is close
			local.best = NULL
			local.bd = 999999
			for( local.pi = 1; local.pi <= $player.size; local.pi++ ){
				local.pp = $player[local.pi]
				if( local.pp == NULL || local.pp == NIL ){ continue }
				if( !isAlive local.pp ){ continue }
				local.dd = vector_length ( local.pp.origin - local.a.origin )
				if( local.dd < local.bd ){ local.bd = local.dd; local.best = local.pp }
			}
			if( local.best != NULL ){
				level.objx_lastProg = level.time
				if( local.bd > 260 ){
					local.a runto local.best.origin
				}
			}
		}
		if( local.arrived == 1 ){
			if( local.a != NULL ){ local.a ai_off }
			waitthread ox_done local.i
			end
		}
		waitthread coop_mod/feed.scr::feed_all 0 "objx_lost" ( level.objx_it_label[local.k] + " was killed - he will be found again" )
		waitthread ox_log "ESCORT actor died - respawning at the start in 10 s"
		wait 10
	}
}end
