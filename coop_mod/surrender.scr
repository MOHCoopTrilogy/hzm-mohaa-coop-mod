//=========================================================================
// HZM coop - SURRENDER CONVERSION [user 2026-08-19]: "when a german surrenders can you
// hold use at them to convert them to fight on your side?"
//
// Hold USE within arm's reach of a surrendered german for ~0.9s and he joins the allies:
// the scripted surrender pose is released with the officer-poser SAFE EXIT pattern
// (anim idle + enableEnemy bounce + forceactivate - the proven medic-kneel recipe), his
// gun comes back out, team flips to american and the engine AI takes it from there - he
// engages his old friends on his own. One-shot per actor (coop_converted latch, which the
// officer.scr surrender loop also honors so the pose loop stops re-asserting).
//
// USE detection = the dbno.scr revive idiom: poll player.useheld (the only use signal
// vanilla scripts get), FORGIVING - the counter decays instead of resetting, because
// useheld measurably flickers 0 for single frames mid-hold (dbno lesson).
//
// coop_surrenderRecruit 0 disables. Odometer: behav_bump "convert".
//=========================================================================

recruitable local.actor:{
//=========================================================================
	if( local.actor == NULL ){ end }
	if( int( getcvar( "coop_surrenderRecruit" ) ) == 0 ){ end }
	if( local.actor.coop_recruitLoop == 1 ){ end }
	local.actor.coop_recruitLoop = 1

	local.held = 0
	local.shownTo = NULL
	while( local.actor != NULL && isAlive local.actor && local.actor.coop_converted != 1 ){
		local.p = waitthread coop_mod/replace.scr::player_closestTo local.actor
		//[user 2026-08-21] AVAILABILITY PROMPT, the dbno pattern: "we need DBNO text when you
		//approach them that says to hit use to convert enemy." Without it, recruiting is only
		//discoverable by accident. Range-gated on the same 110u the hold itself uses, so the
		//prompt is never shown somewhere the hold would not work. Slot 152: the >=100
		//fade-exempt band is otherwise full; 152 is the one unused literal inside the
		//challenge SR chrome band (150-155), which is MENU/LOBBY-time only - the same
		//never-concurrent reuse dbno's own 216 banner established (hud_slot_map.md).
		local.inRange = 0
		if( local.p != NULL && isAlive local.p && local.p.flags["coop_dbno_active"] != 1 ){
			if( vector_length( local.p.origin - local.actor.origin ) < 110 ){
				local.inRange = 1
			}
		}
		if( local.inRange == 1 && local.p != local.shownTo ){
			//[2026-09-25, bug-2906] every hide below is re-sent and every show claims first: a
			//one-shot hide lost to a REMOTE client strands the prompt (coop_mod/hudresend.scr, TRAPS T8)
			if( local.shownTo != NULL ){
				ihuddraw_alpha local.shownTo 152 0
				thread coop_mod/hudresend.scr::resend local.shownTo 152 152 0
			}
			waitthread coop_mod/hudresend.scr::claim local.p 152 152
			ihuddraw_virtualsize local.p 152 1
			ihuddraw_align       local.p 152 center center
			ihuddraw_font        local.p 152 "verdana-12"
			ihuddraw_color       local.p 152 1 1 1
			ihuddraw_rect        local.p 152 0 -58 0 0
			ihuddraw_string      local.p 152 "Hold [USE] to convert enemy"
			ihuddraw_alpha       local.p 152 1
			local.shownTo = local.p
		}
		if( local.inRange != 1 && local.shownTo != NULL ){
			ihuddraw_alpha local.shownTo 152 0
			thread coop_mod/hudresend.scr::resend local.shownTo 152 152 0
			local.shownTo = NULL
		}
		local.near = 0
		if( local.inRange == 1 && local.p.useheld == 1 ){ local.near = 1 }
		if( local.near == 1 ){
			local.held = local.held + 1
		} else {
			if( local.held > 0 ){ local.held = local.held - 1 }
		}
		if( local.held >= 6 ){
			if( local.shownTo != NULL ){
				ihuddraw_alpha local.shownTo 152 0
				thread coop_mod/hudresend.scr::resend local.shownTo 152 152 0
			}
			waitthread convert local.actor local.p
			end
		}
		wait 0.15
	}
	//teardown: actor died or converted elsewhere while the prompt was up
	if( local.shownTo != NULL ){
		ihuddraw_alpha local.shownTo 152 0
		thread coop_mod/hudresend.scr::resend local.shownTo 152 152 0
	}
}end


convert local.actor local.player:{
//=========================================================================
	if( local.actor == NULL || !(isAlive local.actor) ){ end }
	if( local.actor.coop_converted == 1 ){ end }
	local.actor.coop_converted = 1
	//[user 2026-10-18, surrender-next] A CONVERT IS ALIVE AND ON YOUR SIDE: lift every surrender marker.
	//flags[coop_surrendered] used to stay 1 for life, and aimaneuver/aisquad/reinf/aihandler all refuse to
	//touch (or to RESTORE enableEnemy on) a surrendered man - so whenever any other thread switched his
	//acquisition off he never got it back and stood there doing nothing. The readers that wanted him
	//counted as out of the fight (m3l1b gate) also test coop_converted, so clearing is safe.
	local.actor.flags["coop_surrendered"] = 0
	local.actor threatbias 0

	//release the scripted surrender pose - proven poser SAFE EXIT (officer.scr)
	local.actor anim "idle"
	local.actor.position = "stand"
	//[user 2026-08-21] the surrendered-override star bit ends at conversion: the 'american'
	//command below clears EF_AXIS, so the star then draws through the NORMAL allied path -
	//exactly like a paratrooper. +coopboss stays for life (cgame clears the icon on EF_DEAD).
	local.actor rendereffects "-lightstyledynamiclight"
	local.actor unholster
	local.actor.enableEnemy = 0
	local.actor.enableEnemy = 1
	local.actor forceactivate

	//side swap [bug-1958 SOLVED, live probe 19:40: team read back 'german']: the .team
	//property write is a silent no-op - actors have only a team GETTER. The engine's
	//real mechanism is the 'american' COMMAND (Sentient::EventAmerican): ClearEnemies +
	//DisbandSquadMate + m_Team flip + EF_ALLIES netflag + JoinNearbySquads(1024) - he
	//leaves his german squad and joins the nearest ALLIED squad in one call.
	local.actor american

	//[user 2026-08-23, bug-2088] AND MOVE HIM ON THE COOP LEDGER TOO. The command above flips the
	//engine team, but level.coop_actorArray["german"] is what "are any enemies left" counts, and
	//nothing moved him off it - so a converted man made a kill-them-all objective impossible to
	//finish: unkillable because friendly, uncounted-down because nothing removed him.
	waitthread coop_mod/aihandler.scr::coop_moveActorToTeam local.actor "german" "american"
	//[user 2026-08-24, bug-2091] AND RELEASE THE PER-ACTOR DEATH WAITERS TOO.
	//The ledger move above fixes objectives that count the ARRAY of living germans. It does
	//nothing for maps that gate on a PER-ACTOR waittill death, and m3l1b does exactly that:
	//maps/m3l1b.scr threads one watcher per bunker defender, each waiting on that man to die
	//and then incrementing level.clear_bunker or level.clear_farbunker_gunner. Recruiting one
	//removed a body the map was still waiting to see die.
	//That softlock was ABSOLUTE, not just slow: Sentient::TakeDamage filters same-team damage in
	//every gametype, so once he is american the player cannot kill him by any means to release
	//the waiter, and with no axis left nothing else will either.
	//coop_countasdead fires the death NOTIFICATION only. Health, deadflag, think state, gun and
	//corpse are all untouched, so he keeps fighting for you while the map counts him as handled.
	//Safe against double counting: each map watcher ends after its single increment.
	//convertedWatch below polls isAlive rather than waiting on death, so this does not trip it.
	local.actor coop_countasdead

	//bug-1958 probes: the first live convert stood gunless and allies kept attacking. The
	//team read-back proves whether the mid-life .team setter even takes; the weapon read
	//catches a dead unholster and re-arms him.
	wait 0.2
	if( local.actor == NULL || !(isAlive local.actor) ){ end }
	println ( "^~^~^ CONVERT team=" + local.actor.team + " weapon=" + local.actor.weapon )
	//explicit gun restore [19:40 probe: active item after unholster was BINOCULARS - the
	//holster stash restores whatever was active, not his fighting gun]: re-give the gun
	//stored before the surrender holster, mp40 when nothing was stored.
	local.gun = local.actor.coop_preSurrenderGun
	if( local.gun == NIL || local.gun == "" || local.gun == "Binoculars" ){ local.gun = "models/weapons/mp40.tik" }
	local.actor waitthread coop_mod/aihandler.scr::coop_actorArm local.gun	//[bug-3306] not .weapon= (body-dropping rebuild)
	wait 0.1
	if( local.actor == NULL || !(isAlive local.actor) ){ end }
	local.actor unholster
	if( local.actor.weapon == NIL || local.actor.weapon == "" ){
		local.actor waitthread coop_mod/aihandler.scr::coop_actorArm "models/weapons/mp40.tik"
		local.actor unholster
	}
	//[user 2026-10-18, surrender-next] NO USABLE GUN = NO FIGHT. A recruit whose weapongroup is still "unarmed"
	//(binoculars, empty hand, a re-give that did not take) gets the engine armed-attack think with nothing to fire, which
	//logs "unknown animation unarmed_shoot" and leaves him standing. Give him a Kar98k (his own stored gun failed).
	if( local.actor.weapongroup == "unarmed" || local.actor.weapongroup == NIL || local.actor.weapongroup == "" ){
		local.actor waitthread coop_mod/aihandler.scr::coop_actorArm "models/weapons/kar98.tik"
		local.actor unholster
		println( "^~^~^ CONVERT_KICK ent=" + local.actor.entnum + " why=unarmed-at-convert" )
	}
	//[user 2026-08-20] he stood around doing nothing after conversion. The bounce at the top of
	//this label runs BEFORE the team swap and the gun re-give, so he re-entered his think with
	//no weapon and on the wrong side, and officer.scr's surrender loop had left him in a
	//SCRIPTED anim (THINK_ANIM sits at the IDLE level, so an attack think never installs).
	//Bounce him again LAST - american, armed, and out of the scripted pose.
	local.actor anim "idle"
	local.actor.position = "stand"
	local.actor.enableEnemy = 0
	local.actor.enableEnemy = 1
	local.actor forceactivate

	//[user 2026-08-20] a converted man still counts as ALIVE on the spawner that made him, so
	//objectives gated on "are that spawner's actors dead" (M3L3's clear-the-church) soft lock
	//forever. Track the living converts globally so any such gate can discount them.
	if( level.coop_convertedAlive == NIL ){ level.coop_convertedAlive = 0 }
	level.coop_convertedAlive = level.coop_convertedAlive + 1
	thread convertedWatch local.actor
	thread convertedKick local.actor
	println( "^~^~^ CONVERT_DONE ent=" + local.actor.entnum + " team=" + local.actor.team + " weapon=" + local.actor.weapon )

	thread coop_mod/aibehav.scr::behav_bump "convert"
	if( local.player != NULL ){ waitthread coop_mod/feed.scr::feed_player local.player 2 "recruit" "Recruited - he fights for you now" }
	//a german line on the way up reads as him talking himself into it
	thread coop_mod/aivoice.scr::aivoice_request local.actor "banter" 8
}end

//=========================================================================
// convertedWatch <actor> - hold the global living-convert count honest. A converted man still
// counts as alive on the spawner that made him, so any objective gated on that spawner's
// currentalive would wait for him forever (bug-1972, M3L3's clear-the-church).
//=========================================================================
convertedWatch local.actor:{
	while( local.actor != NULL && isAlive local.actor ){
		wait 1
	}
	if( level.coop_convertedAlive == NIL ){ level.coop_convertedAlive = 0 }
	level.coop_convertedAlive = level.coop_convertedAlive - 1
	if( level.coop_convertedAlive < 0 ){ level.coop_convertedAlive = 0 }
}end

//=========================================================================
// convertedKick <actor> - [user 2026-10-18, surrender-next] WATCHDOG for "converted soldiers sometimes just
// stand there". If a recruit has not moved and has no enemy for coop_surrenderIdleSecs while a fight is on
// near him (a living german with an enemy within 1500u), re-kick his AI the proven way: drop any scripted
// anim, re-give a gun if his hand is empty, bounce enableEnemy, forceactivate. Every kick logs its reason.
//=========================================================================
convertedKick local.actor:{
	local.lim = waitthread srvCvar "coop_surrenderIdleSecs" 5
	if( local.lim <= 0 ){ local.lim = 5 }
	local.lastOrg = local.actor.origin
	local.idle = 0
	local.maxent = int(getcvar "maxentities")
	if( local.maxent <= 0 ){ local.maxent = 1024 }
	while( local.actor != NULL && isAlive local.actor ){
		wait 1
		if( local.actor == NULL || !isAlive local.actor ){ end }
		local.moved = vector_length( local.actor.origin - local.lastOrg )
		local.lastOrg = local.actor.origin
		local.hasEnemy = 0
		if( local.actor.enemy != NULL && local.actor.enemy != NIL ){ local.hasEnemy = 1 }
		//an unarmed recruit is re-armed at once, whatever the idle clock says
		if( local.actor.weapongroup == "unarmed" ){
			local.actor waitthread coop_mod/aihandler.scr::coop_actorArm "models/weapons/kar98.tik"
			local.actor unholster
			println( "^~^~^ CONVERT_KICK ent=" + local.actor.entnum + " why=unarmed-watchdog" )
		}
		if( local.moved < 24 && local.hasEnemy == 0 ){ local.idle++ } else { local.idle = 0 }
		if( local.idle >= local.lim ){
			local.fight = 0
			local.ei = 0
			while( local.ei < local.maxent && local.fight == 0 ){
				local.e = getentbyentnum local.ei
				if( local.e != NULL && local.e != local.actor ){
					if( local.e.classname == "Actor" && isAlive local.e && local.e.team == "german" ){
						if( local.e.enemy != NULL && local.e.enemy != NIL ){
							if( vector_length( local.e.origin - local.actor.origin ) < 1500 ){ local.fight = 1 }
						}
					}
				}
				local.ei++
			}
			if( local.fight == 1 ){
				local.why = ( "idle" + local.idle + "s" )
				if( local.actor.weapon == NIL || local.actor.weapon == "" ){
					local.why = ( local.why + "+nogun" )
					local.actor waitthread coop_mod/aihandler.scr::coop_actorArm "models/weapons/mp40.tik"
				}
				if( local.actor.team != "american" ){
					local.why = ( local.why + "+team=" + local.actor.team )
					local.actor american
				}
				local.actor.flags["coop_surrendered"] = 0
				local.actor threatbias 0
				local.actor unholster
				local.actor anim "idle"
				local.actor.position = "stand"
				//no fight of his own and the squad is far: walk to the nearest player first (a recruit follows his side)
				local.fp = waitthread coop_mod/replace.scr::player_closestTo local.actor
				if( local.actor == NULL || !isAlive local.actor ){ end }
				if( local.fp != NULL && local.fp != NIL ){
					if( vector_length( local.fp.origin - local.actor.origin ) > 350 ){
						local.why = ( local.why + "+follow" )
						local.actor.enableEnemy = 0
						local.actor.movedoneradius = 128
						local.actor runto local.fp.origin
						wait 4
						if( local.actor == NULL || !isAlive local.actor ){ end }
					}
				}
				local.actor.enableEnemy = 0
				local.actor.enableEnemy = 1
				local.actor forceactivate
				println( "^~^~^ CONVERT_KICK ent=" + local.actor.entnum + " why=" + local.why )
				local.idle = 0
			}
		}
	}
}end

//=========================================================================
// srvCvar <name> <default> - integer cvar with a default for an UNSET cvar (a stale autoexec/cfg that predates the
// cvar reads "" which int() makes 0 - for a cap that would silently switch the feature off).
//=========================================================================
srvCvar local.name local.def:{
	local.r = local.def
	local.v = getcvar( local.name )
	if( local.v != "" ){ local.r = int( local.v ) }
}end local.r
