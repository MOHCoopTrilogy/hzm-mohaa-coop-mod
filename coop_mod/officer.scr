// Officer Boss + Radio Station
// Spawns a high-HP German officer who calls reinforcements via radio.
// Destroying the radio stops all future reinforcements.
// Types: 0=infantry 1=MG team 2=sniper 3=grenadiers 4=stuka fake 5=artillery

// =====================================================================
// CENTRAL OFFICER-SPAWN POLICY (keyed by level.coop_mapname)
// =====================================================================
// The officer hook is wired UNCONDITIONALLY in coop_mod/main.scr, so the
// decision of WHETHER / WHEN the officer spawns must live here, not per-map.
// Three buckets:
//
//   "none"     -> officer NEVER spawns. Stealth/disguise/papers missions and
//                 pure cinematic/escort/no-combat maps. e1l4 (papers/disguise)
//                 is the canonical case: the boss used to drop into the
//                 truck-stop and open fire DURING the cinematic intro.
//   "deferred" -> mission begins quiet/stealth then goes loud. The officer
//                 stays dormant until a go-loud signal THIS file can read (a
//                 level alarm flag set by the map script) flips. If the wait
//                 times out, the map behaves as "none" for that session. Maps
//                 with no readable go-loud flag are documented in
//                 officer_spawn_policy.md and kept "none" until a follow-up
//                 adds the hook to the MAP script (forbidden to touch here).
//   "combat"   -> normal combat map. Officer allowed, BUT the intro/ride
//                 timing gates AND the anchor-distance guard below still apply
//                 so it never spawns during an intro nor on the player start.
//
// Unclassified maps default to "combat" so working maps keep their officer.
// ASCII-only; compound conditions kept on one line.
coop_officer_policy:{
	local.m = level.coop_mapname

	// HZM coop pre-mission lobby - no combat phase, so no officer waves / weapon-ban / spawn-policy spam
	if( level.coop_lobbyMap == 1 ){ end "none" }

	// [user 07-18 bug-789] BRIEFING maps (maps/briefing/briefing1-6) are pure slide/cinematic
	// screens - no combat, no spawn infrastructure. The 07-18 12:00 log shows briefing1 got
	// policy=combat, a 25s settle, then a doomed dynamic spawn hunt. Silent-none like the lobby
	// (containsText briefing = the bug-722 challenges guard pattern).
	if( waitthread coop_mod/main.scr::containsText local.m "briefing" 0 ){ end "none" }

	// ---- NONE: pure cinematic / vehicle-only maps with no go-loud combat phase ----
	// Per user rule, NONE is reserved for pure-cinematic or pure-vehicle maps that
	// never expose a stealth->loud combat phase the officer could respond to.
	// t1l1 = plane-ride + barn-crash cinematic intro; vanilla SH with no readable
	// go-loud alarm flag and no stealth structure (pure-cinematic exemption).
	if( local.m == "t1l1" ){ end "none" }
	// m1l3b = on-rails jeep ride (driving level); no stealth/go-loud phase, no officer (user request).
	if( local.m == "m1l3b" ){ end "none" }
	// m2l2b = U-boat bomb-plant + chainspawner ESCAPE set-piece; a boss fight doesn't fit a timed
	// "get out" sequence (was MARGINAL combat-policy w/ dynamic anchor) - officer off (user request).
	if( local.m == "m2l2b" ){ end "none" }
	// m3l1a / m3l1b - officer removed (user request).
	//[user 08-08] t2l3 - user call while playing it: the officer/radio SIDE objectives were
	//showing on a mission that has nothing to do with them. Policy "none" takes the boss AND its
	//two side lines out together (coop_obj_register_delayed gates on this same outcome).
	if( local.m == "t2l3" ){ end "none" }
	if( local.m == "m3l1a" ){ end "none" }
	if( local.m == "m3l1b" ){ end "none" }
	// e3l3 = scripted AB41 convoy ride + railgun set-piece; boss waves fought the pathed
	// vehicle mid-ride (dogs wedged it on a barrier bank) - officer off (user request 2026-07-06).
	if( local.m == "e3l3" ){ end "none" }
	// m5l1a = Sniper's Last Stand (outskirts) - sniper-duel set-piece, no officer boss (user request 2026-07-11).
	if( local.m == "m5l1a" ){ end "none" }

	// ---- DEFERRED: starts quiet/stealth, goes loud on a readable alarm flag ----
	// These stealth/disguise/papers maps set level.alarm (0 -> 1 on go-loud) in
	// their own map scripts; officer.scr polls it without further engine changes.
	// e1l4   = papers/disguise ship infiltration -> Ship.scr::AlarmSounded sets
	//          level.alarm=1 + level.alarmSounded=1 when cover is blown (no map edit).
	// m1l2a  = disguise saluting-checkpoint -> spawnalarmguy sets level.alarm=1
	//          when a spotlight catches the player (cover blown).
	// m1l3c  = lighthouse disguise -> radio_objective sets level.alarm=1 once all
	//          comms equipment is destroyed (the destroy objective spawns combat AI).
	// m2l2a  = U-boat disguise + destroy-Naxos -> global/alarm_system.scr sets
	//          level.alarm=1 on alarm trip (no map edit). Boss ENABLED (officer-enable
	//          batch): coop_feature_boss=1 + authored anchor in officer_positions.scr;
	//          it now spawns at the deep-deck kreigsmarine cluster once the map goes loud.
	// m4l0   = secret farmhouse papers raid -> trigger1 (German siege) sets
	//          level.alarm=1. Boss ENABLED (officer-enable batch): coop_feature_boss=1 +
	//          authored anchor; spawns at the northern enemyspawner line once loud.
	if( local.m == "e1l4" ){ end "deferred" }
	if( local.m == "m1l3c" ){ end "deferred" }
	if( local.m == "m2l2a" ){ end "deferred" }
	if( local.m == "m4l0" ){ end "deferred" }
	if( local.m == "m6l1c" ){ end "deferred" }
	if( local.m == "m6l3c" ){ end "deferred" }

	// ---- COMBAT: combat-from-start maps previously mis-marked NONE ----
	// m2l3 = train-station escape; map sets level.alarm=1 unconditionally at spawn
	//        and combat is immediate (not stealth). Boss ENABLED (officer-enable batch):
	//        coop_feature_boss=1 + authored anchor (avoids the spectator-origin TGA crash
	//        the old SKIP guarded against, since the anchor is now deterministic).
	// e3l4 = bunker defense / repel-the-attack from the first objective; combat from
	//        the start (the medals/outro are only the very end). Boss ENABLED
	//        (officer-enable batch): coop_feature_boss=1 + authored elevated-fortress anchor.
	// m5l2b = tank map. In coop the tank auto-drives so the players are on foot and
	//        global/ai.scr spawns infantry around them -> it warrants an officer.
	//        Reclassified NONE->COMBAT; boss ENABLED (coop_feature_boss=1, anchor already
	//        authored). coop_feature_paradrop stays 0 (no air drop on the tank corridor).
	if( local.m == "m2l3" ){ end "combat" }
	if( local.m == "e3l4" ){ end "combat" }
	if( local.m == "m5l2b" ){ end "combat" }
	// m1l2a = disguise/checkpoint map. Reclassified deferred->combat (user request): the
	// spotlight go-loud trigger was unreliable, so the officer rarely appeared. Now it spawns
	// after the intro at the authored anchor in officer_positions.scr (kept >1000u from the
	// player start so it won't drop into the disguise/checkpoint approach).
	if( local.m == "m1l2a" ){ end "combat" }

	// ---- Default: COMBAT ----
	end "combat"
}end

// Bounded wait for a map go-loud signal. Returns 1 if the level went loud,
// 0 on timeout (caller then treats the map as NONE for this session). Reads
// ONLY level globals set by the map script -- no map edits. level.alarm is the
// shared stealth-alarm flag on m6l1c / m6l3c.
coop_officer_wait_goloud:{
	local.t = 0
	while( local.t < 600 ){
		if( level.alarm != NIL && level.alarm == 1 ){ end 1 }
		if( level.alarmSounded != NIL && level.alarmSounded == 1 ){ end 1 }
		if( level.alarmactive != NIL && level.alarmactive == 1 ){ end 1 }
		wait 1
		local.t++
	}
	end 0
}end


coop_officer_init:{
	//[user 2026-08-11] PER-MAP OPT-OUT. A map sets level.coop_noOfficerWaves = 1 to run without the
	//officer reinforcement wave system entirely. Added for m6l2a, whose own alarmer.scr already
	//spawns reinforcements from ~15 alarm_spawndetector entities - stacking coop officer waves on
	//top of a map that reinforces itself produces two systems fighting over the same fight.
	if( level.coop_noOfficerWaves == 1 ){
		println "^~^~^ OFFICER waves disabled for this map (coop_noOfficerWaves)"
		end
	}
	//[user 08-08] bug-1587 - these three were UNCONDITIONAL iprintlnbold, which prints to every
	//player's screen on every map. The coop_offQuiet gate that silences the rest of this labels
	//messages is set ~30 lines BELOW them, so it never covered these. Dev instrumentation must
	//never reach players - moved behind the same debug switch the other coop scripts use, so the
	//trace is still one cvar away when it is needed.
	if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: init called" }
	if( level.coop_officer != NULL && level.coop_officer_alive == 1 ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: init aborted - officer already exists" }
		end
	}
	if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: init thread started" }

	// Pre-cache officer encounter models so there's no hitch on first spawn.
	// e/t-series maps don't call coop_mod/precache.scr, so we do it here.
	cache models/human/german_waffenss_officer.tik
	cache models/human/german_wehrmact_officer.tik
	cache models/human/german_waffenss_nco.tik
	cache models/human/german_elite_gestapo.tik
	cache models/human/german_Afrika_officer.tik
	cache models/human/german_waffenss_shutze.tik
	cache models/human/german_waffenss_shutze_gear.tik
	cache models/human/german_wehrmact_grenadier.tik
	cache models/human/german_afrika_private.tik
	cache models/miscobj/radio_military.tik
	cache models/furniture/cardtable.tik

	while( !$player ){ wait 1 }

	// Side objectives (officer + radio) are registered right at map start rather than
	// waiting for the officer to actually spawn. Threaded (not inline) with its own
	// internal delay so it NEVER stalls the officer spawn sequence below. coop_obj_register
	// is guarded (runs once), so the later call at officer-spawn becomes a harmless no-op.
	// FIX 3: coop_obj_register_delayed now self-gates on the SAME officer outcome decided
	// below (policy != "none" AND coop_feature_boss != 0), so on no-officer maps it shows
	// nothing instead of two permanently-ACTIVE never-completable lines.
	thread coop_mod/objectives.scr::coop_obj_register_delayed

	// --- Central spawn policy (NONE / DEFERRED / COMBAT) ---
	// Decided BEFORE the intro/ride waits so NONE maps exit instantly and never
	// spawn a boss into a stealth/cinematic sequence (e1l4 truck-stop bug).
	local.policy = exec coop_mod/officer.scr::coop_officer_policy
	// [user 07-18 bug-789] quiet on lobbies AND briefings - no bold spam over the lobby scene / briefing slides
	local.coop_offQuiet = 0
	if( level.coop_lobbyMap == 1 ){ local.coop_offQuiet = 1 }
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "briefing" 0 ){ local.coop_offQuiet = 1 }
	//[user 2026-08-13, bug-1779] was iprintlnbold - internal spawn policy shown to every player at
	//every map start. The other 61 OFFICER:/REINF STATE: prints in this file are already wrapped in
	//level.cMTE_coop_officer; these two escaped. Same gate, console only.
	if( local.coop_offQuiet == 0 && level.cMTE_coop_officer ){ println( "OFFICER: spawn policy = " + local.policy ) }
	if( local.policy == "none" ){
		if( local.coop_offQuiet == 0 && level.cMTE_coop_officer ){ println "OFFICER: policy NONE - officer disabled on this map" }
		end
	}
	if( local.policy == "deferred" ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: policy DEFERRED - holding until the level goes loud" }
		local.wentLoud = exec coop_mod/officer.scr::coop_officer_wait_goloud
		if( local.wentLoud != 1 ){
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: go-loud signal never fired - officer stays disabled this session" }
			end
		}
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: level has gone loud - releasing the officer" }
	}

	// Populate per-map officer config (anchor, instant_spawn, no_airstrikes, canteen, ...) NOW,
	// before the settle waits below read level.coop_officer_instant_spawn. getAnchor only sets
	// level vars + returns the anchor (no waits/spawns), so the later call for the value is harmless.
	exec coop_mod/officer_positions.scr::getAnchor

	// Per-map: on very short maps the officer should appear AT ONCE - skip all the intro/ride
	// settle waits (inTruckCamera probe + the 25s combat-map settle + ridecomplete/RideOver).
	if( level.coop_officer_instant_spawn != 1 ){
	local.t = 0
	while( !$player[1].inTruckCamera && local.t < 5 ){
		wait 0.5
		local.t += 0.5
	}
	if( $player[1].inTruckCamera ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: waiting for truck intro" }
		while( $player[1].inTruckCamera ){ wait 0.5 }
		wait 2
	} else {
		wait 25
	}

	// m1l1 (and any scripted vehicle-ride map) keeps riding/dismounting long AFTER the
	// truck camera is released: inTruckCamera goes false during the papers scene, before
	// the bazooka ambush, the truck explosion, and the actual dismount. Spawning the
	// boss/guards/waves into the truck-stop pocket then collides with the glued,
	// animation-driven ranger actors (they pop in/out and warp to the ground). Gate on
	// the real ride-complete flag. Bounded timeout; on maps that never set it the flag
	// is NIL so this block is skipped and behavior is unchanged.
	if( level.flags[ridecomplete] != NIL && level.flags[ridecomplete] == 0 ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: waiting for truck ride to complete" }
		local.rc = 0
		while( level.flags[ridecomplete] == 0 && local.rc < 90 ){
			wait 1
			local.rc++
		}
		// Let the dismount + bazooka/explosion choreography finish settling.
		wait 8
	}

	// Generalized intro guard: several BT/SH maps gate their scripted vehicle/
	// cinematic intro on level.RideOver (0 during the ride, 1 once it ends) --
	// the same role ridecomplete plays on m1l1. Honor it so a COMBAT map that
	// carries this flag never spawns the boss mid-intro. NIL on maps that don't
	// use it, so the block is skipped and behavior is unchanged.
	if( level.RideOver != NIL && level.RideOver == 0 ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: waiting for scripted ride/intro (RideOver) to finish" }
		local.ro = 0
		while( level.RideOver == 0 && local.ro < 90 ){
			wait 1
			local.ro++
		}
		wait 4
	}
	}	// end intro/ride settle (skipped when level.coop_officer_instant_spawn == 1)

	// Find first living, non-DBNO player - retry until one exists
	local.ref_player = NIL
	while( local.ref_player == NIL ){
		local.k = 1
		while( local.ref_player == NIL && local.k <= $player.size ){
			local.pk = $player[local.k]
			if( local.pk != NULL ){
				if( local.pk.health > 0 && local.pk.flags["coop_dbno_active"] != 1 ){
					local.ref_player = local.pk
				}
			}
			local.k++
		}
		if( local.ref_player == NIL ){
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: init waiting for a living player" }
			wait 1
		}
	}
	if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: using player " + local.ref_player.targetname + " as reference") }

	if( level.coop_mapStartOrigin == NIL ){
		level.coop_mapStartOrigin = local.ref_player.origin
	}

	if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: wait complete, finding spawn" }

	// --- Stage 0: Try authored anchor from positions table ---
	local.base_pos = NIL
	local.authored = exec coop_mod/officer_positions.scr::getAnchor
	if( local.authored != NIL ){
		local.base_pos = local.authored
		if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: authored anchor at " + local.base_pos) }
		if( level.coop_officer_verify_ingame == 1 ){
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: VERIFY_INGAME - check encounter in-game before shipping" }
		}
	} else {
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: no authored anchor, using dynamic selection" }
	}

	// Guard: getAnchor may have failed before setting z_tol (e.g. parse error in positions.scr)
	if( level.coop_officer_z_tol == NIL ){
		level.coop_officer_z_tol = 192
	}

	// --- Stage 1: Try $alarmspawner first (nav-valid authored positions) ---
	if( local.base_pos == NIL ){
		if( $alarmspawner != NULL ){
			local.numAlarm = $alarmspawner.size
			if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: " + local.numAlarm + " alarmspawner(s) on map") }
			local.bestAlarmDist = 0
			local.k = 1
			while( local.k <= local.numAlarm ){
				local.alarm = $alarmspawner[local.k]
				if( local.alarm != NULL ){
					local.z_ref = level.coop_mapStartOrigin[2]
					if( level.coop_officer_z_ref != NIL ){ local.z_ref = level.coop_officer_z_ref }
					local.zdiff = local.alarm.origin[2] - local.z_ref
					if( local.zdiff < 0 ){ local.zdiff = 0 - local.zdiff }
					if( local.zdiff <= level.coop_officer_z_tol ){
						local.adist = vector_length( local.alarm.origin - level.coop_mapStartOrigin )
						if( local.adist >= 1500 && local.adist > local.bestAlarmDist ){
							local.bestAlarmDist = local.adist
							local.base_pos = local.alarm.origin
						}
					}
				}
				local.k++
			}
			if( local.base_pos != NIL ){
				if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: alarmspawner selected at " + local.base_pos + " dist " + local.bestAlarmDist) }
			} else {
				if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: alarmspawners present but none passed filter" }
			}
		} else {
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: no $alarmspawner on this map" }
		}
	}

	// --- Fallback: farthest living German enemy on same floor ---
	if( local.base_pos == NIL ){
		local.numCandidates = 0
		local.enemyArray = level.coop_actorArray["german"]
		if( local.enemyArray != NIL ){
			local.z_ref = level.coop_mapStartOrigin[2]
			if( level.coop_officer_z_ref != NIL ){ local.z_ref = level.coop_officer_z_ref }
			for( local.i = 1; local.i <= local.enemyArray.size; local.i++ ){
				local.ent = local.enemyArray[local.i]
				if( local.ent != NULL && isAlive local.ent ){
					local.zdiff = local.ent.origin[2] - local.z_ref
					if( local.zdiff < 0 ){ local.zdiff = 0 - local.zdiff }
					if( local.zdiff <= level.coop_officer_z_tol ){
						local.cdist = vector_length( local.ent.origin - level.coop_mapStartOrigin )
						if( local.cdist >= 1500 ){
							local.numCandidates++
							local.candidates[local.numCandidates] = local.ent
							local.distances[local.numCandidates] = local.cdist
						}
					}
				}
			}
		}
		if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: enemy fallback candidates: " + local.numCandidates) }

		// Secondary fallback: if the Z filter excluded every actor (player stranded in a
		// transition shaft far in Z from the map's AI -- m4l1 / m6l3c style on maps that
		// lack a baked anchor), retry distance-only with no Z constraint so the boss still
		// spawns instead of silently skipping the encounter.
		if( local.numCandidates == 0 && local.enemyArray != NIL ){
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: Z filter found 0 candidates - retrying without Z constraint" }
			for( local.i = 1; local.i <= local.enemyArray.size; local.i++ ){
				local.ent = local.enemyArray[local.i]
				if( local.ent != NULL && isAlive local.ent ){
					local.cdist = vector_length( local.ent.origin - level.coop_mapStartOrigin )
					if( local.cdist >= 1500 ){
						local.numCandidates++
						local.candidates[local.numCandidates] = local.ent
						local.distances[local.numCandidates] = local.cdist
					}
				}
			}
			if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: no-Z fallback candidates: " + local.numCandidates) }
		}

		local.spawn_ent = NIL
		local.bestDist = 0
		if( local.numCandidates > 0 ){
			local.sorted = 0
			while( !local.sorted ){
				local.sorted = 1
				for( local.j = 1; local.j < local.numCandidates; local.j++ ){
					local.next = local.j + 1
					if( local.distances[local.j] > local.distances[local.next] ){
						local.tmp_d = local.distances[local.j]
						local.distances[local.j] = local.distances[local.next]
						local.distances[local.next] = local.tmp_d
						local.tmp_e = local.candidates[local.j]
						local.candidates[local.j] = local.candidates[local.next]
						local.candidates[local.next] = local.tmp_e
						local.sorted = 0
					}
				}
			}
			local.spawn_ent = local.candidates[local.numCandidates]
			local.bestDist = local.distances[local.numCandidates]
		}

		if( local.spawn_ent != NIL ){
			if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: enemy fallback at " + local.spawn_ent.targetname + " " + local.spawn_ent.origin + " dist " + local.bestDist) }
			local.base_pos = local.spawn_ent.origin
		} else {
			// No authored anchor, no alarmspawner, no valid enemy actors -- map has no
			// suitable spawn infrastructure. Skip the boss rather than spawning at the
			// player's position (player-relative spawn causes a renderer crash on some
			// maps because the model TGA is loaded the instant it enters the view frustum).
			if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: no valid spawn infrastructure - skipping boss on this map" }
			end
		}
	}

	// --- Anchor-distance guard (never spawn on the player's start / vehicle-stop
	// / intro location) ---
	// The dynamic paths already require >=1500u from mapStartOrigin, but an
	// authored anchor is trusted blindly. Enforce a hard minimum here for ALL
	// paths so a mis-authored or too-close anchor can't drop the boss into the
	// spawn/intro pocket (the e1l4-class failure). Below the floor, skip the
	// boss rather than spawn on the players.
	local.minSpawnDist = 1000
	if( level.coop_mapStartOrigin != NIL && local.base_pos != NIL ){
		local.startDist = vector_length( local.base_pos - level.coop_mapStartOrigin )
		if( local.startDist < local.minSpawnDist ){
			if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: spawn pos " + int(local.startDist) + "u from player start (< " + local.minSpawnDist + ") - skipping boss") }
			end
		}
	}

	// Per-map feature toggle: skip the entire boss/radio encounter on maps that disable it
	// (vehicle/rail/cinematic). Default coop_feature_boss=1 keeps AA behavior unchanged.
	if( level.coop_feature_boss == 0 ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: boss disabled for this map (coop_feature_boss=0) - skipping" }
		end
	}

	//[209] HZM coop - HOLD GATE: maps can set level.coop_officer_hold = 1 during scripted
	//sequences (e3l3 AB41 convoy ride: boss waves + attack dogs piling into the pathed
	//vehicle mid-barrier-smash wedged it on the bank). The officer waits here until the
	//map clears the flag - all reinforcement waves inherently wait with him.
	//[user 07-09] BUILD MODE: never spawn the boss while the host is building (coop_build 1).
	//The officer parks here until build mode ends, then spawns normally - so build sessions
	//started at map load (the usual case) never see him at all.
	while( level.coop_officer_hold == 1 || getcvar( "coop_build" ) == "1" ){
		wait 2
	}
	//[user 07-21] per-map radio position override: lets the OFFICER anchor move while the
	//radio station (table/radio/canteen) stays at its established spot (e1l2: user relocating
	//the boss away from the walled SW corner but keeping the radio there).
	local.radio_pos = local.base_pos
	if( level.coop_officer_radio_pos != NIL ){ local.radio_pos = level.coop_officer_radio_pos }
	thread coop_radio_init local.radio_pos
	if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER: spawn pos found, spawning" }
	thread coop_officer_spawn local.base_pos
}end


// Theater -> model resolver. role = "officer"|"infantry"|"elite"|"sniper"|"grenadier"|"at"|"mg"|"handler"|"dog"
// Defaults to the exact AA WaffenSS/Wehrmacht set so AA maps are byte-identical in behavior.
// level.coop_theater is set in officer_positions.scr::getAnchor (default "aa").
// PRESERVED SPELLING: "german_wehrmact_*" is the lowercase 8-char game-typo form that
// currently loads on m4l3 -- do not "correct" it.
coop_model_for local.role:{
	local.th = level.coop_theater
	if( local.th == NIL ){ local.th = "aa" }

	// Theater-agnostic roles (AA pak, reachable in every theater).
	if( local.role == "dog" ){ end "models/animal/german_shepherd.tik" }
	if( local.role == "handler" ){ end "models/human/german_hund_hundpatrol.tik" }

	//[user 2026-08-14] SNIPERS NEED A SNIPER MODEL. The "sniper" role has always fallen through
	//to ordinary infantry in every theater, so a sniper wave produced men who were snipers only
	//by their weapon. That is also why both sniper challenges could never be earned: the kill
	//classifier (challenges.scr::chal_factionOf) identifies a victim by MODEL PATH, and no actor
	//model anywhere in the trilogy contained "sniper" - so fac_sniper could never be returned by
	//anything, on any map. One model closes both holes at once, and the wave code at :2360 was
	//already asking for this role.
	//Theater-agnostic on purpose: the model is in the bundled HRRTM pack rather than a retail
	//pak, so it is equally available everywhere, and a marksman reads the same in any theater.
	if( local.role == "sniper" ){ end "models/human/german_wehrmact_sniper.tik" }

	if( local.th == "afrika" ){
		if( local.role == "officer" ){ end "models/human/german_Afrika_officer.tik" }
		if( local.role == "elite" ){ end "models/human/german_afrika_private.tik" }
		if( local.role == "grenadier" ){ end "models/human/german_afrika_grenadier_nowrap.tik" }
		// infantry / sniper / at / mg / bodyguard fallthrough
		end "models/human/german_afrika_private.tik"
	}
	if( local.th == "wehr" || local.th == "russ" ){
		if( local.role == "officer" ){ end "models/human/german_wehrmact_officer.tik" }
		if( local.role == "elite" ){ end "models/human/german_waffenss_shutze.tik" }
		if( local.role == "grenadier" ){ end "models/human/german_wehrmact_grenadier.tik" }
		//[user 07-13] ~1 in 3 plain infantry get the grenadier-webbing gear variant (silhouette variety)
		if( randomint 3 == 0 ){ end "models/human/german_waffenss_shutze_gear.tik" }
		end "models/human/german_waffenss_shutze.tik"
	}

	// Default theater "aa" (WaffenSS): exact current model set.
	if( local.role == "officer" ){ end "models/human/german_waffenss_officer.tik" }
	if( local.role == "elite" ){ end "models/human/german_elite_sentry.tik" }
	//[user 07-13] ~1 in 3 plain infantry get the grenadier-webbing gear variant (silhouette variety)
	if( randomint 3 == 0 ){ end "models/human/german_waffenss_shutze_gear.tik" }
	end "models/human/german_waffenss_shutze.tik"
}end


// Returns a randomized officer skin TIK for the current theater. AA keeps its 4-skin pool
// (waffenss_officer / waffenss_nco / wehrmact_officer / elite_gestapo); other theaters
// return their single command-rank model.
coop_officer_skin:{
	local.th = level.coop_theater
	if( local.th == NIL ){ local.th = "aa" }
	if( local.th == "afrika" ){ end "models/human/german_Afrika_officer.tik" }
	if( local.th == "wehr" || local.th == "russ" ){ end "models/human/german_wehrmact_officer.tik" }
	// AA pool -- 4 skins all from pak0; colonel replaced with waffenss_nco (colonel is maintt-only)
	local.r_skin = randomint 4
	if( local.r_skin == 1 ){ end "models/human/german_waffenss_nco.tik" }
	if( local.r_skin == 2 ){ end "models/human/german_wehrmact_officer.tik" }
	if( local.r_skin == 3 ){ end "models/human/german_elite_gestapo.tik" }
	end "models/human/german_waffenss_officer.tik"
}end


coop_officer_spawn local.pos:{
	// Random officer skin -- theater-aware (AA keeps the original 4-skin pool).
	local.officer_model = exec coop_mod/officer.scr::coop_officer_skin

	// For authored anchors: officer spawns 100u forward from anchor; dynamic: at anchor itself
	local.officer_pos = local.pos
	if( level.coop_officer_anchor != NIL ){
		local.officer_pos = local.pos + (100 0 0)
	}
	local.gnd = exec coop_mod/officer.scr::coop_find_ground local.officer_pos
	if( local.gnd != NIL ){
		local.zdiff = local.gnd[2] - local.officer_pos[2]
		if( local.zdiff < 0 ){ local.zdiff = 0 - local.zdiff }
		if( local.zdiff > 128 ){ local.gnd = NIL }
	}
	if( local.gnd == NIL ){ local.gnd = local.officer_pos }
	local.officer = spawn local.officer_model
	local.officer.origin = local.gnd
	local.officer droptofloor
	// Per-map authored facing (officer_positions.scr coop_officer_anchor_ang). Set BEFORE the
	// bodyguards spawn (they place behind the officer relative to his facing) so both are oriented.
	if( level.coop_officer_anchor_ang != NIL ){
		local.officer.angles = ( 0 level.coop_officer_anchor_ang 0 )
	}
	local.officer.health = 1200	// [209] -20% HP (was 1500)
	local.officer.flags["coop_actorStopPainHandler"] = 1
	local.officer.accuracy = 70	// [209] softened (was 85)
	local.officer.sight = 2400	// [209] shorter vision range
	local.officer gun "stg44"
	local.officer.leash = 2048
	local.officer.enableEnemy = 1
	local.officer dontdropweapons
	local.officer attackplayer
	local.officer.nosurprise = 1
	local.officer.nolongpain = 1
	local.officer german
	local.officer forceactivate
	local.officer rendereffects "+coopboss"
	// OFFICER tag for the cgame eagle icon. Uses "+additivedynamiclight" (RF_ADDITIVE_DLIGHT):
	// it is NOT set by default on sentients (unlike preciseshadow, which is -> every actor
	// AND player got the eagle), has no visual effect without an attached dynamic light,
	// and the existing game.dll already supports the token. cgame draws the Reichsadler for
	// any coopboss actor carrying this flag; everyone else keeps the swastika/star.
	local.officer rendereffects "+additivedynamiclight"
	thread coop_mark_boss local.officer
	// Overhead marker (eagle) is drawn by cgame CG_ActorOverheadIcon (RT_SPRITE world
	// sprite) off these flags -- no script-side billboard needed.
	println "OFFICER: rendereffects coopboss set"
	level.coop_officer = local.officer
	level.coop_officer_alive = 1
	level.coop_officer_medkit_used = 0
	level.coop_officer_threshold_reset = 0
	level.coop_officer_busy = 0
	level.coop_wave_recalls = 0
	level.coop_officer_canteens = 0
	level.coop_officer_heals = 0			// [318] lifetime FULL-HEAL retreats used (cap = coop_officerMaxHeals)
	level.coop_officer_healCapNoted = 0		// [318] one-shot "cap reached" diagnostic latch
	level.coop_officer_lastseen = level.time
	forcemusic "action"
	println ("OFFICER SPAWNED HP: " + local.officer.health)
	iprintlnbold "Intel reports a High-Ranking Officer is visiting this area."
	iprintlnbold "Be cautious of his reinforcements he brought with him."
	// Per-map officer-spawn TUTORIAL (indexed array of short lines; off when unset).
	if( level.coop_officer_spawn_tutorial[1] != NIL ){
		local.stl = 1
		while( level.coop_officer_spawn_tutorial[local.stl] != NIL ){
			iprintlnbold level.coop_officer_spawn_tutorial[local.stl]
			local.stl++
		}
	}
	local.dist_x = int(local.pos[0])
	local.dist_y = int(local.pos[1])
	println ("Officer spotted at position " + local.dist_x + " " + local.dist_y)
	local.officer playsound coop_radio_on
	thread coop_radio_broadcast
	thread coop_officer_combat_music	// dynamic combat music while the officer can see players
	thread coop_officer_idle_talk	// 1-2 German campaign lines while he's still idle/unspotted
	// Bodyguards spawn behind the officer and run to the radio to defend it (no roof drops next to the radio)
	local.ofwd = angles_toforward local.officer.angles
	local.guard_back = local.officer.origin - (local.ofwd * 250)
	local.guard1_pos = local.guard_back + (0 80 0)
	local.guard2_pos = local.guard_back + (0 -80 0)
	//[310] player-scaled guard detail: 2 authored (= 2-player baseline), 1 solo, up to 4 (cap)
	local.bgn = exec coop_mod/officer.scr::coop_reinf_count 2 "coop_officerSquadPer" 1 4
	level.coop_bodyguard_n = local.bgn
	thread coop_spawn_bodyguard local.guard1_pos 1
	if( local.bgn >= 2 ){ thread coop_spawn_bodyguard local.guard2_pos 2 }
	local.bgi = 3
	while( local.bgi <= local.bgn ){
		local.gext = exec coop_mod/officer.scr::coop_spread_pos local.guard_back local.bgi
		thread coop_spawn_bodyguard local.gext local.bgi
		local.bgi++
	}
	if( level.cMTE_coop_officer ){ iprintlnbold ("OFFICER: spawned " + local.bgn + " bodyguards") }
	thread coop_officer_bodyguard_monitor
	thread coop_officer_retreat_monitor local.officer
	thread coop_officer_reinforcements local.officer
	thread coop_officer_death_monitor local.officer
	thread coop_officer_hp_logger local.officer
	thread coop_officer_guard_radio local.officer
	thread coop_officer_brain local.officer
	thread coop_officer_marker
	thread coop_mod/objectives.scr::coop_obj_register
}end


// Re-assert the coop boss render flag over the first ~1.5s after spawn,
// in case the engine sets the actor's default renderfx after our spawn script runs.
coop_mark_boss local.ent:{
	local.n = 0
	while( local.n < 6 && local.ent != NULL ){
		local.ent rendereffects "+coopboss"
		wait 0.25
		local.n++
	}
}end


// [user 07-09] BUILD MODE cleanup: remove the officer, his bodyguards and any already-spawned
// reinforcement-wave soldiers so the builder is left in peace. Called from buildmode.scr when a
// build session starts (the spawn itself is separately gated on coop_build in the hold loop, so
// this only matters when build mode is toggled AFTER the officer already appeared). Setting
// coop_officer_alive = 0 stops every officer thread (guard/brain/waves/monitors all loop on it)
// and blocks new waves. Uses 'remove' not 'delete' per the corpse.scr/butler.scr actor rule.
coop_officer_buildSuppress:{
	level.coop_officer_alive = 0
	if( level.coop_officer != NIL && level.coop_officer != NULL ){ level.coop_officer remove }
	level.coop_officer = NULL
	if( level.coop_bodyguard_n != NIL ){
		local.i = 1
		while( local.i <= level.coop_bodyguard_n ){
			if( level.coop_bodyguards[local.i] != NIL && level.coop_bodyguards[local.i] != NULL ){
				level.coop_bodyguards[local.i] remove
			}
			local.i++
		}
	}
	if( level.coop_wave_count != NIL ){
		local.i = 1
		while( local.i <= level.coop_wave_count ){
			if( level.coop_wave_actors[local.i] != NIL && level.coop_wave_actors[local.i] != NULL ){
				level.coop_wave_actors[local.i] remove
			}
			local.i++
		}
	}
}end


coop_spawn_bodyguard local.pos local.idx:{
	local.gnd = exec coop_mod/officer.scr::coop_find_ground local.pos
	if( local.gnd != NIL ){
		local.bgdz = local.gnd[2] - local.pos[2]
		if( local.bgdz < 0 ){ local.bgdz = 0 - local.bgdz }
		if( local.bgdz > 128 ){ local.gnd = NIL }
	}
	//[user 2026-08-17] "officers bodyguard spawned under the map again". The old fallback used
	//local.pos - the very position the ground trace had just REJECTED - and leaned on droptofloor,
	//which does nothing when there is no floor beneath. That is how a guard ends up under the world.
	//Fall back to the OFFICER's own position instead: he is standing on ground that demonstrably
	//exists. Note coop_voidWatch cannot save this case - it kills actors that FALL 2500u below their
	//spawn, and one that spawns under the map never descends any further.
	if( local.gnd == NIL ){
		local.gnd = local.pos
		if( level.coop_officer != NIL && level.coop_officer != NULL ){
			local.gnd = level.coop_officer.origin
		}
	}
	local.gmodel = exec coop_mod/officer.scr::coop_model_for "infantry"
	local.guard = spawn local.gmodel
	local.guard.coop_xpClass = "guard"	// [302] HZM XP - kill-class bonus tag
	local.guard.origin = local.gnd
	local.guard droptofloor
	local.guard.health = 640	// [209] -20% HP (was 800)
	local.guard.flags["coop_actorStopPainHandler"] = 1
	local.guard.accuracy = 60	// [209] softened (was 70)
	local.guard.sight = 2200	// [209] shorter vision range
	local.guard.leash = 2048
	local.guard.enableEnemy = 1
	local.guard gun "stg44"
	local.guard.nosurprise = 1
	exec coop_mod/officer.scr::coop_reinf_scale local.guard	//[310] player-count health/accuracy
	local.guard forceactivate
	local.guard rendereffects "+coopboss"
	thread coop_mark_boss local.guard
	thread coop_wave_glow local.guard
	level.coop_bodyguards[local.idx] = local.guard
	// Run to the radio and defend it alongside the officer
	if( level.coop_radio != NIL && level.coop_radio != NULL ){
		local.guard.movedoneradius = 96
		local.guard runto level.coop_radio.origin
		local.guard waittill movedone
	}
	local.guard attackplayer
}end


// Keeps the officer active (anti-stuck) and tethered near the radio whenever he is not healing/retreating.
coop_officer_guard_radio local.officer:{
	while( isAlive local.officer && level.coop_officer_alive == 1 ){
		wait 2
		if( isAlive local.officer && level.coop_officer_alive == 1 ){
			if( level.coop_officer_busy != 1 ){
				// keepalive: prevent the 60s think-window freeze and idle-stuck behaviour, and keep him engaging
				local.officer forceactivate
				local.officer.enableEnemy = 1
				local.officer attackplayer
				if( level.coop_radio != NIL && level.coop_radio != NULL ){
					local.gdist = vector_length( local.officer.origin - level.coop_radio.origin )
					if( local.gdist > 700 ){
						level.coop_officer_busy = 1
						local.officer.enableEnemy = 0
						local.officer.movedoneradius = 128
						local.officer runto level.coop_radio.origin
						local.officer waittill movedone
						local.officer.enableEnemy = 1
						local.officer attackplayer
						level.coop_officer_busy = 0
					}
				}
			}
		}
	}
}end


// Announces when both of the officer's bodyguards are dead.
// Officer self-preservation brain: tracks how long since he last saw a player and runs the
// canteen sip (unseen 10s, +50% HP, max 3) and the conditional retreat-to-heal (<=50% HP, unseen 30s, 50% chance).
coop_officer_brain local.officer:{
	local.canteen_armed = 1
	local.retreat_rolled = 0
	while( isAlive local.officer && level.coop_officer_alive == 1 ){
		wait 1
		if( isAlive local.officer && level.coop_officer_alive == 1 ){
			local.sees = 0
			if( exec coop_mod/replace.scr::player_anyCanBeSeen local.officer 3000 ){ local.sees = 1 }
			if( local.sees == 1 ){
				level.coop_officer_lastseen = level.time
				local.canteen_armed = 1
				local.retreat_rolled = 0
			}
			local.unseen = level.time - level.coop_officer_lastseen

			if( level.coop_officer_busy != 1 ){
				// Under 40% HP and out of contact: retreat to a health post (full heal + back to radio).
				// [318] BOUNDED: only while he still has heal-retreats left in his lifetime budget
				// (coop_officerMaxHeals, def 2). At the cap he simply stops retreating and keeps
				// fighting - he is NOT made passive, and the canteen sip below is still available
				// (itself capped at 3), so the fall-through degrades gracefully instead of stranding him.
				local.wantheal = 0
				if( local.officer.health < 480 && local.unseen >= 8 && local.retreat_rolled == 0 ){ local.wantheal = 1 }
				if( local.wantheal == 1 ){
					if( (exec coop_mod/officer.scr::coop_officer_healsLeft) == 0 ){
						local.wantheal = 0
						exec coop_mod/officer.scr::coop_officer_healcap_note "cap_reached_brain"
					}
				}
				if( local.wantheal == 1 ){
					local.retreat_rolled = 1
					iprintlnbold "Recon reports the Officer has slipped away to find a health post!"
					thread coop_officer_medkit_retreat local.officer
				} else {
					// Canteen sip: guaranteed once per unseen episode when under 50% HP, small heal, max 3
					if( local.unseen >= 6 && local.canteen_armed == 1 && level.coop_officer_canteens < 3 && local.officer.health < 600 ){
						local.canteen_armed = 0
						thread coop_officer_canteen local.officer
					}
				}
			}
		}
	}
}end


// Officer drinks from a canteen to recover 50% of his max health (out of combat).
coop_officer_canteen local.officer:{
	if( level.coop_officer_busy == 1 ){ end }
	if( !isAlive local.officer ){ end }
	level.coop_officer_busy = 1
	level.coop_officer_canteens++
	local.officer playsound coop_officer_drink
	iprintlnbold "The Officer is drinking from his canteen to recover!"
	wait 2
	if( isAlive local.officer && level.coop_officer_alive == 1 ){
		local.newhp = local.officer.health + 100
		if( local.newhp > 1500 ){ local.newhp = 1500 }
		local.officer.health = local.newhp
		local.officer gore_reset 100	// HZM coop - gore tier 1: canteen sip washes some blood off
	}
	level.coop_officer_busy = 0
}end


coop_officer_bodyguard_monitor:{
	//[310] player-scaled guard detail: wait for however many guards were requested
	// (level.coop_bodyguard_n - can be 1 solo) to be assigned, then watch exactly that many so a
	// smaller detail never false-fires the "you killed a bodyguard" wave call at spawn.
	local.bgn = level.coop_bodyguard_n
	if( local.bgn == NIL || local.bgn < 1 ){ local.bgn = 2 }
	local.t = 0
	local.got = 0
	while( local.got < local.bgn && local.t < 10 ){
		local.got = 0
		local.bgw = 1
		while( local.bgw <= local.bgn ){
			if( level.coop_bodyguards[local.bgw] != NULL ){ local.got++ }
			local.bgw++
		}
		if( local.got < local.bgn ){
			wait 0.5
			local.t += 0.5
		}
	}
	if( local.got == 0 ){ end }
	local.prev = local.got
	while( level.coop_officer_alive == 1 ){
		local.alive = 0
		local.bgk = 1
		while( local.bgk <= local.bgn ){
			if( level.coop_bodyguards[local.bgk] != NULL && isAlive level.coop_bodyguards[local.bgk] ){ local.alive++ }
			local.bgk++
		}
		if( local.alive < local.prev ){
			// a bodyguard just died -- officer calls reinforcements
			local.prev = local.alive
			iprintlnbold "You eliminated one of the Officer's bodyguards! He calls for reinforcements!"
			thread coop_reinf_call_wave_gated level.coop_officer
		}
		if( local.alive == 0 ){ break }
		wait 1
	}
	if( level.coop_officer_alive == 1 ){
		iprintlnbold "The Officer's bodyguards have been eliminated!"
	}
}end


coop_radio_broadcast:{
	local.snd = "coop_radio_chatter"
	if( randomint 2 == 1 ){ local.snd = "coop_radio_chatter_2" }
	local.pi = 1
	while( local.pi <= $player.size ){
		$player[local.pi] playsound local.snd
		local.pi++
	}
}end


coop_officer_retreat_monitor local.officer:{
	while( isAlive local.officer ){
		local.officer waittill damage
		if( local.officer != NULL ){
			if( local.officer.health < 100 ){
				if( level.coop_radio != NIL && level.coop_radio != NULL ){
					local.officer.enableEnemy = 0
					local.officer runto level.coop_radio.origin
					local.officer waittill movedone
					local.officer.enableEnemy = 1
				}
			}
		}
	}
}end


//[318] HZM coop - LIFETIME BUDGET for the officer's full-heal retreats. The retreat itself is a
// deliberate boss mechanic (he slips away, heals to full, comes back) and is kept - it is only
// BOUNDED here, because with nothing but line-of-sight gating him he could heal to full forever.
// coop_officerMaxHeals: how many COMPLETED full heals he gets per life. Default 2. 0 disables the
// heal-retreat outright; a NEGATIVE value restores the old unlimited behaviour. Naming/format
// matches the other officer cvars (coop_officerScale / coop_officerBasePc / coop_officerHealthPct),
// which are likewise read inline with an empty-string fallback rather than registered in a cfg.
coop_officer_maxheals:{
	local.m = getcvar "coop_officerMaxHeals"
	if( local.m == "" ){ end 2 }		// same empty-string fallback the other coop_officer* cvars use
	local.m = int( local.m )
	end local.m
}end


// Returns 1 while the officer may still spend a full-heal retreat, 0 once the budget is used up.
coop_officer_healsLeft:{
	local.max = exec coop_mod/officer.scr::coop_officer_maxheals
	if( local.max < 0 ){ end 1 }				// negative cvar = unlimited (legacy behaviour)
	local.used = level.coop_officer_heals
	if( local.used == NIL ){ local.used = 0 }		// NIL and NULL are different - guard the unset case
	if( local.used >= local.max ){ end 0 }
	end 1
}end


// Machine-parseable heal diagnostic ("^~^~^ " prefix, watched by maptest_monitor.ps1 /
// maptest_watchdog.ps1). GATED behind the officer trace flag (level.cMTE_coop_officer = 1) exactly
// like the rest of officer.scr's tracing, so a normal game prints nothing at all.
coop_officer_healdiag local.what:{
	if( level.cMTE_coop_officer ){
		local.used = level.coop_officer_heals
		if( local.used == NIL ){ local.used = 0 }
		local.max = exec coop_mod/officer.scr::coop_officer_maxheals
		local.hp = 0
		if( level.coop_officer != NULL && level.coop_officer != NIL ){ local.hp = level.coop_officer.health }
		println( "^~^~^ OFFICERHEAL " + local.what + " used=" + local.used + " max=" + local.max + " hp=" + local.hp )
	}
}end


// One-shot version of the above: latches level.coop_officer_healCapNoted so the 1 Hz officer brain
// cannot spam the trace once the budget is gone. Explicit NIL guard - the latch is initialised at
// officer spawn, but comparing an unset (none) var against an int throws "Cannot cast none to float".
coop_officer_healcap_note local.what:{
	if( level.coop_officer_healCapNoted == NIL ){ level.coop_officer_healCapNoted = 0 }
	if( level.coop_officer_healCapNoted == 1 ){ end }
	level.coop_officer_healCapNoted = 1
	exec coop_mod/officer.scr::coop_officer_healdiag local.what
}end


coop_officer_medkit_retreat local.officer:{
	// Repeatable, but BOUNDED: re-triggered when the officer drops to poor health (re-armed after a
	// full heal), up to coop_officerMaxHeals completed full heals per life. See coop_officer_maxheals.
	if( level.coop_officer_busy == 1 ){ end }			// already retreating/healing - don't stack another
	if( local.officer == NULL || !isAlive local.officer || level.coop_officer_alive != 1 ){ end }
	// [318] budget check BEFORE claiming BUSY, so a refused retreat leaves the busy accounting
	// completely untouched and he just carries on fighting (the guard_radio keepalive keeps
	// forceactivate/attackplayer running for him because busy stays 0).
	if( (exec coop_mod/officer.scr::coop_officer_healsLeft) == 0 ){
		exec coop_mod/officer.scr::coop_officer_healcap_note "retreat_refused_cap"
		end
	}
	level.coop_officer_busy = 1					// claim BUSY now so threshold/brain calls can't interrupt the heal

	// Scan for nearest health item on this map
	local.maxent = int(getcvar "maxentities")
	if( local.maxent <= 0 ){ local.maxent = 1024 }
	local.ei = 0
	local.best_pos = NIL
	local.best_dist = 999999
	local.far_pos = NIL
	local.far_dist = 0
	local.german_near = 0
	// "behind" = away from the players, so he never rushes toward them to heal. Direction from the
	// officer TO the nearest player (flat XY); a medkit is behind when its offset has a NEGATIVE dot.
	local.bb_pos = NIL		// nearest medkit BEHIND
	local.bb_dist = 999999
	local.bf_pos = NIL		// furthest medkit BEHIND
	local.bf_dist = 0
	local.np = exec coop_mod/officer.scr::coop_nearest_player_pos
	local.fx = 0
	local.fy = 0
	if( local.np != NIL ){
		local.fx = local.np[0] - local.officer.origin[0]
		local.fy = local.np[1] - local.officer.origin[1]
	}
	while( local.ei < local.maxent ){
		local.e = getentbyentnum local.ei
		if( local.e != NULL ){
			if( local.e.classname == "Health" ){
				local.d = vector_length( local.e.origin - local.officer.origin )
				if( local.d < local.best_dist ){
					local.best_dist = local.d
					local.best_pos = local.e.origin
				}
				if( local.d > local.far_dist ){
					local.far_dist = local.d
					local.far_pos = local.e.origin
				}
				// is this medkit BEHIND the officer (away from the players)?
				local.mx = local.e.origin[0] - local.officer.origin[0]
				local.my = local.e.origin[1] - local.officer.origin[1]
				local.dot = (local.fx * local.mx) + (local.fy * local.my)
				if( local.np == NIL || local.dot < 0 ){
					if( local.d < local.bb_dist ){
						local.bb_dist = local.d
						local.bb_pos = local.e.origin
					}
					if( local.d > local.bf_dist ){
						local.bf_dist = local.d
						local.bf_pos = local.e.origin
					}
				}
			} else if( local.e.classname == "Actor" && local.e != local.officer ){
				// count living German support near the officer (reinforcements / map allies)
				if( isAlive local.e && local.e.team == "german" ){
					if( vector_length( local.e.origin - local.officer.origin ) < 1500 ){ local.german_near = local.german_near + 1 }
				}
			}
		}
		local.ei++
	}

	if( local.best_pos == NIL ){
		if( level.cMTE_coop_officer ){ iprintlnbold "OFFICER MEDKIT: no health entity found on this map - retreat skipped" }
		level.coop_officer_busy = 0
		end
	}

	// ALWAYS prefer a medkit BEHIND him (away from the players) so he retreats to heal instead of
	// charging them. Among behind options: alone -> FURTHEST behind (safest); with support -> NEAREST
	// behind. If nothing is behind him, fall back to the furthest overall (still avoids rushing them).
	local.heal_pos = local.best_pos
	if( local.bb_pos != NIL ){
		if( local.german_near == 0 ){
			local.heal_pos = local.bf_pos
			iprintlnbold "Recon reports the Officer, with no support nearby, is slipping away to a distant aid post!"
		} else {
			local.heal_pos = local.bb_pos
			iprintlnbold "Recon reports the Officer is falling back to a health post - stop him before he heals!"
		}
	} else if( local.far_pos != NIL ){
		local.heal_pos = local.far_pos
		iprintlnbold "Recon reports the Officer is slipping away to a health post - stop him before he heals!"
	} else {
		iprintlnbold "Recon reports the Officer is retreating to a health post - stop him before he heals!"
	}
	level.coop_officer_busy = 1
	level.coop_xp_heal_pending = 1	// [302] HZM XP - killing him before the full heal pays the heal-denied bonus
	local.officer.enableEnemy = 0
	local.officer.movedoneradius = 64
	local.timer = level.time + 35
	// [user 07-18] PATHING FIX: issue runto ONCE, re-issue ONLY when genuinely stalled (pain cleared the
	// path), detected by origin delta. Re-issuing every tick re-allocated the destination waypoint each
	// poll -> walk-back-and-forth stutter. Still robust vs pain interruption (a real stall re-asserts).
	local.prev = local.officer.origin
	local.officer forceactivate
	local.officer runto local.heal_pos
	while( isAlive local.officer && level.coop_officer_alive == 1 && level.time < local.timer ){
		wait 0.4
		if( vector_length( local.officer.origin - local.heal_pos ) < 200 ){ break }
		if( vector_length( local.officer.origin - local.prev ) < 24 ){ local.officer forceactivate ; local.officer runto local.heal_pos }
		local.prev = local.officer.origin
	}
	if( !isAlive local.officer || level.coop_officer_alive != 1 ){ level.coop_officer_busy = 0; end }

	// [user 2026-08-07] ARRIVAL GATE. The loop above exits on ANY of three conditions, and only death
	// was checked - so when local.timer ran out with the medkit unreached (blocked path, kit behind
	// geometry, stall recovery never got him moving) he fell straight into the heal phase and topped
	// up 1280 HP from wherever he was standing. The retreat is meant to BE the cost of the heal;
	// on a timeout it was free, and invisible to the players who had just fought him down.
	// No refund needed: the budget is only spent on a COMPLETED heal further below, so a failed
	// retreat costs him nothing and he can try again when the threshold re-arms.
	if( vector_length( local.officer.origin - local.heal_pos ) > 300 ){
		exec coop_mod/officer.scr::coop_officer_healdiag "retreat_failed_unreached"
		level.coop_officer_busy = 0
		local.officer.enableEnemy = 1
		local.officer forceactivate
		local.officer attackplayer
		end
	}

	// reached the health post: DEFEND while healing - he shoots back (NOT invincible; players can still
	// kill/interrupt him), while the threshold loop stays quiet (no new reinforcement calls) until full HP.
	local.officer.enableEnemy = 1
	local.officer forceactivate
	local.officer attackplayer
	//[user 2026-08-18] "when the officer retreats to heal it should take him a longer time to
	//get fully healed... at least 1 full minute". Was 10 ticks x 128 HP - full in 10 seconds,
	//which made the interrupt window a formality. The heal is now METERED across the whole
	//minute regardless of arrival HP (per-tick = deficit / 60), so reaching full before 60
	//seconds is impossible and the players' window to deny it is the minute itself. He still
	//shoots back and can still be killed throughout; the completed-heal hard-set below is
	//unchanged and still only runs if he survives the entire minute.
	local.heal_ticks = 0
	local.heal_per = (1200 - local.officer.health) / 60
	if( local.heal_per < 1 ){ local.heal_per = 1 }
	while( isAlive local.officer && local.heal_ticks < 60 ){
		local.new_hp = local.officer.health + local.heal_per
		if( local.new_hp > 1200 ){ local.new_hp = 1200 }
		local.officer.health = local.new_hp
		wait 1
		local.heal_ticks++
	}
	if( !isAlive local.officer || level.coop_officer_alive != 1 ){ end }

	local.officer.health = 1200	// [209] -20% HP (was 1500)
	local.officer gore_reset	// HZM coop - gore tier 1: full heal = clean uniform + stop dripping
	// [318] spend one unit of the lifetime heal budget. Counted HERE, on a COMPLETED full heal, so a
	// retreat that the players interrupt (they killed him on the way) never costs him a charge.
	if( level.coop_officer_heals == NIL ){ level.coop_officer_heals = 0 }
	level.coop_officer_heals++
	exec coop_mod/officer.scr::coop_officer_healdiag "full_heal"
	if( (exec coop_mod/officer.scr::coop_officer_healsLeft) == 0 ){
		exec coop_mod/officer.scr::coop_officer_healdiag "budget_exhausted"
	}
	iprintlnbold "The Officer has been fully healed! Thresholds reset!"
	level.coop_xp_heal_pending = 0	// [302] HZM XP - heal completed, denial window over
	level.coop_officer_threshold_reset = 1
	// Top priority after healing: haul straight back to the radio
	if( level.coop_radio != NIL && level.coop_radio != NULL ){
		local.officer.movedoneradius = 128
		local.rtimer = level.time + 20
		// [user 07-18] PATHING FIX: issue runto once, re-issue only when stalled (see heal-retreat loop).
		local.prev = local.officer.origin
		local.officer forceactivate
		local.officer runto level.coop_radio.origin
		while( isAlive local.officer && level.coop_officer_alive == 1 && level.time < local.rtimer ){
			wait 0.4
			if( vector_length( local.officer.origin - level.coop_radio.origin ) < 200 ){ break }
			if( vector_length( local.officer.origin - local.prev ) < 24 ){ local.officer forceactivate ; local.officer runto level.coop_radio.origin }
			local.prev = local.officer.origin
		}
	}
	level.coop_officer_busy = 0
	local.officer.enableEnemy = 1
	local.officer forceactivate
	local.officer attackplayer
}end


coop_officer_reinforcements local.officer:{
	// Per-map feature toggle: skip reinforcement waves entirely (default coop_feature_waves=1
	// keeps AA behavior). Officer still exists/fights, just calls no waves.
	if( level.coop_feature_waves == 0 ){
		if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: waves disabled for this map (coop_feature_waves=0)" }
		level.coop_reinforcements_active = 0
		end
	}
	if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: thread started" }
	level.coop_reinforcements_active = 1

	// STATE: IDLE - poll until officer has spotted a player
	if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: idle - waiting for first contact" }
	while( isAlive local.officer && level.coop_officer_alive == 1 ){
		if( local.officer.enemy != NULL ){ break }
		if( exec coop_mod/replace.scr::player_anyCanBeSeen local.officer 3000 ){ break }
		wait 0.5
	}
	if( !isAlive local.officer || level.coop_officer_alive != 1 ){ end }

	if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: spotted - first wave" }
	thread coop_reinf_call_wave_gated local.officer

	// HP thresholds. 75% / 50% = call a reinforcement wave IN PLACE (he keeps fighting - no chained
	// retreat-to-radio runs). POOR HEALTH (30%) = auto-call the BATTALION once + fall back to HEAL.
	// While he is busy (retreating/healing) NO threshold fires, and nothing re-fires until a FULL heal
	// re-arms them (coop_officer_threshold_reset, set at the end of coop_officer_medkit_retreat).
	local.thresh75   = 1125
	local.thresh50   = 750
	local.thresh_poor = 450
	local.t75_done   = 0
	local.t50_done   = 0
	local.poor_done  = 0

	if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: active - monitoring HP thresholds" }
	while( isAlive local.officer && level.coop_officer_alive == 1 ){
		if( level.coop_radio_destroyed == 1 ){
			if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: radio destroyed, halting" }
			end
		}
		if( level.coop_officer_threshold_reset == 1 ){
			level.coop_officer_threshold_reset = 0
			local.t75_done  = 0
			local.t50_done  = 0
			local.poor_done = 0
		}
		// Never fire while he is retreating/healing/otherwise busy - this is the "no chain of calls
		// before he retreats, and no reinforcement calls during healing" behavior.
		if( level.coop_officer_busy == 1 ){
			wait 0.2
			continue
		}
		local.hp = local.officer.health
		local.fired = 0
		// POOR HEALTH preempts everything: battalion + heal, then quiet until fully healed.
		if( local.fired == 0 && local.poor_done == 0 && local.hp <= local.thresh_poor ){
			local.poor_done = 1
			local.t50_done  = 1
			local.t75_done  = 1
			local.fired     = 1
			if( level.coop_feature_battalion != 0 ){
				if(level.cMTE_coop_officer){ iprintlnbold ("REINF STATE: poor health (HP " + local.hp + ") - BATTALION called, falling back to heal") }
				thread coop_spawn_battalion
			} else {
				if(level.cMTE_coop_officer){ iprintlnbold ("REINF STATE: poor health (HP " + local.hp + ") - reinforcements called, falling back to heal") }
				thread coop_call_reinforcements
			}
			// [318] the fall-back-to-heal only happens while he still has heal-retreats left
			// (coop_officerMaxHeals, def 2). At the cap he stays put and keeps fighting; the
			// battalion/wave above is still called, and the thresholds stay latched exactly as they
			// already do whenever a retreat gets interrupted - no new state, nothing to strand him.
			if( (exec coop_mod/officer.scr::coop_officer_healsLeft) == 1 ){
				thread coop_officer_medkit_retreat local.officer
			} else {
				exec coop_mod/officer.scr::coop_officer_healcap_note "cap_reached_threshold"
			}
		}
		if( local.fired == 0 && local.t50_done == 0 && local.hp <= local.thresh50 ){
			local.t50_done = 1
			local.t75_done = 1
			local.fired    = 1
			if(level.cMTE_coop_officer){ iprintlnbold ("REINF STATE: threshold hit at HP " + local.hp + " (50%) - reinforcement wave") }
			thread coop_call_reinforcements
		}
		if( local.fired == 0 && local.t75_done == 0 && local.hp <= local.thresh75 ){
			local.t75_done = 1
			local.fired    = 1
			if(level.cMTE_coop_officer){ iprintlnbold ("REINF STATE: threshold hit at HP " + local.hp + " (75%) - reinforcement wave") }
			thread coop_call_reinforcements
		}
		wait 0.1
	}
}end


coop_reinf_retreat_and_wave local.officer:{
	if( level.coop_radio == NULL || level.coop_radio_destroyed == 1 ){
		if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: no radio, calling wave in place" }
		thread coop_reinf_call_wave_gated local.officer
		end
	}
	local.radio_pos = level.coop_radio.origin
	level.coop_officer_busy = 1
	local.officer.enableEnemy = 0
	local.officer.movedoneradius = 64
	local.timer = level.time + 15
	local.break = 0
	while( isAlive local.officer && level.coop_officer_alive == 1 && local.break == 0 && level.time < local.timer ){
		local.officer forceactivate
		local.officer runto local.radio_pos
		wait 0.4		// poll + re-issue instead of waittill movedone - robust vs pain/path interruption under fire
		if( vector_length( local.officer.origin - local.radio_pos ) < 128 ){
			if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: reached radio, calling wave" }
			local.break = 1
		}
	}
	if( !isAlive local.officer || level.coop_officer_alive != 1 ){
		level.coop_officer_busy = 0
		end
	}
	if( local.break == 0 ){ if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: retreat timeout, calling wave anyway" } }
	level.coop_officer_busy = 0
	local.officer.enableEnemy = 1
	thread coop_reinf_call_wave_gated local.officer
}end


coop_reinf_call_wave_gated local.officer:{
	if( !(exec coop_mod/replace.scr::player_anyCanBeSeen local.officer 3000) ){
		if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: wave postponed, no sight" }
		while( isAlive local.officer && level.coop_officer_alive == 1 ){
			wait 0.5
			if( exec coop_mod/replace.scr::player_anyCanBeSeen local.officer 3000 ){ break }
		}
		if( !isAlive local.officer || level.coop_officer_alive != 1 ){ end }
		if(level.cMTE_coop_officer){ iprintlnbold "REINF STATE: sight restored, firing postponed wave" }
	}
	// German radio alarm from the radio itself when reinforcements are called (loud).
	if( level.coop_radio != NIL && level.coop_radio != NULL ){
		local.rsnd = "coop_radio_german_reinf" + ((randomint 9) + 1)	// 1..9 - real variety (same-name aliases don't pool)
		level.coop_radio playsound local.rsnd
	}
	//[311] FRONTLINE score layer - wave-called sting (cooldown-gated in flmusic.scr)
	thread coop_mod/flmusic.scr::fl_sting_wave
	thread coop_call_reinforcements
}end


coop_find_ground local.pos:{
	//[user 2026-08-21] REINFORCEMENTS WERE ENDING UP UNDER THE MAP. Screenshot: two officer
	//reinforcements floating in the void below the world, which is also why m3l3 logged 347
	//pathfinding failures - an actor beneath the geometry can never reach a patrol node.
	//
	//This traced straight down 512u and accepted whatever it hit, with no check that the START
	//point was even in open space. A scatter candidate landing inside a wall, inside a crate, or
	//just past a ledge would still report a "floor": either the underside of the geometry it was
	//already embedded in, or a surface hundreds of units below. The actor then spawned inside solid,
	//the engine pushed it out, and it fell through the world.
	//
	//Three rejects now, all cheap:
	//  startSolid/allSolid - the candidate is embedded in geometry, so there is no valid ground here
	//  fraction >= 1       - nothing below at all (unchanged; this was the only guard before)
	//  a 300u drop cap     - a floor further down than that is a different storey or the void, not
	//                        the spot we were asked to scatter around
	local.tr = traced (local.pos + (0 0 4)) (local.pos + (0 0 -512))
	if( local.tr["startSolid"] == 1 ){ end NIL }
	if( local.tr["allSolid"] == 1 ){ end NIL }
	if( local.tr["fraction"] >= 1.0 ){ end NIL }
	local.gp = local.tr["endpos"]
	if( (local.pos[2] - local.gp[2]) > 300 ){ end NIL }
	end local.gp
}end


// Periodic German combat barks for a reinforcement actor. Dogs are skipped.
// A global cooldown keeps the squad's chatter occasional (not every soldier at once).
// CONTEXTUAL German barks: reinforcements/bodyguards only bark when they actually have
// an enemy (local.actor.enemy = engine current-target getter) -- a shout on first
// contact, then sparse barks during the fight, and SILENCE otherwise. No more random
// idle chatter. Global cooldown prevents the squad from overlapping/spamming.
coop_german_bark_loop local.actor:{
	if( local.actor == NULL ){ end }
	// Per-map feature toggle: contextual German VO (default coop_feature_voice=1 = AA behavior).
	if( level.coop_feature_voice == 0 ){ end }
	if( local.actor.model == "models/animal/german_shepherd.tik" ){ end }
	// Only bark while the actor actually has an enemy, and cap ALL german barks to one per
	// 12s GLOBALLY. A single hard cooldown (no contact/sustained split) so a flickering
	// .enemy can't re-trigger "first contact" lines over and over -- that was the soldier
	// that "wouldn't shut up" after the paradrop.
	while( local.actor != NULL && isAlive local.actor ){
		wait 2
		if( local.actor == NULL || !isAlive local.actor ){ end }
		if( local.actor.enemy != NULL ){
			if( level.coop_germanbark_time == NIL ){ level.coop_germanbark_time = 0 }
			if( (level.time - level.coop_germanbark_time) >= 12 ){
				level.coop_germanbark_time = level.time
				local.actor playsound coop_german_bark
			}
		}
	}
}end


coop_wave_glow local.actor:{
	// Ensure EF_AXIS is set so the cgame overhead boss-icon draws on this actor
	if( local.actor != NULL ){ local.actor german }

	// Overhead swastika is drawn by cgame CG_ActorOverheadIcon (RT_SPRITE) off the
	// "+coopboss" flag the wave spawners set -- no script-side billboard needed.

	// Occasional situational German combat barks (skips dogs).
	thread coop_german_bark_loop local.actor

	// (Red test glow removed -- the overhead swastika icon marks reinforcements now.)
}end


// HZM coop - ANTI-STUCK push toward a player. Advancing AI sometimes wedges on a wall/corner because the
// fanned-out offset destination lands behind geometry, or the path funnels them into a corner. This:
//   (1) makes the destination WALL-SAFE: trace from the player out to the fan-offset point; if a wall is
//       between them the offset spot is unreachable, so pull the destination back toward the player.
//   (2) detects NO-PROGRESS (wedged): if the actor barely moved since the last advance poll, count it;
//       after a couple of stuck polls, abandon the offset and run straight to the player's own origin
//       (always navmesh-reachable - a player stands there) and forceactivate to force a fresh path.
// Per-actor state is kept on writable coop_* members (never engine-reserved names). Call each advance poll.
coop_push_toward local.actor local.target local.offdir local.lat:{
	if( local.actor == NULL || !isAlive local.actor ){ end }
	if( local.target == NULL ){ end }

	local.want = local.target.origin + (vector_scale local.offdir local.lat)
	local.tr   = traced (local.target.origin + (0 0 32)) (local.want + (0 0 32))
	local.dest = local.want
	if( local.tr["fraction"] < 1.0 ){
		local.shorten = local.lat * local.tr["fraction"] * 0.7
		local.dest = local.target.origin + (vector_scale local.offdir local.shorten)
	}

	local.moved = 9999
	if( local.actor.coop_lastpos != NIL ){
		local.moved = vector_length( local.actor.origin - local.actor.coop_lastpos )
	}
	if( local.moved < 24 ){
		if( local.actor.coop_stuckcount == NIL ){ local.actor.coop_stuckcount = 0 }
		local.actor.coop_stuckcount = local.actor.coop_stuckcount + 1
	} else {
		local.actor.coop_stuckcount = 0
	}

	if( local.actor.coop_stuckcount >= 2 ){
		// wedged: head straight for the player's reachable spot + force a fresh path
		local.dest = local.target.origin
		local.actor forceactivate
		local.actor.coop_stuckcount = 0
	}

	local.actor.movedoneradius = 200
	local.actor runto local.dest
	local.actor.coop_lastpos = local.actor.origin
}end


coop_wave_hunt local.actor:{
	wait 0.5
	if( local.actor == NULL || !isAlive local.actor ){ end }
	//[209] register on the level-wide wave roster so allied AI (paratroopers) can be handed
	//these as enemies - waves are player-locked and never shoot AI, so the damage-driven
	//notice path stays silent without this (see paradrop.scr follow loop + fgame attackentity)
	if( level.coop_wave_count == NIL ){ level.coop_wave_count = 0 }
	level.coop_wave_count++
	level.coop_wave_actors[level.coop_wave_count] = local.actor
	local.actor.nosurprise = 1
	local.actor forceactivate
	// Per-trooper STANDOFF (how close it pushes before letting its own think fight) + a lateral FAN
	// so the squad disperses instead of all stacking onto one player. Cover/flank roles hang back
	// further so the native type_attack "cover" can take over (seek cover + crouch + space out).
	local.standoff = 350
	if( local.actor.flags["coop_role"] == "cover" ){ local.standoff = 900 }
	if( local.actor.flags["coop_role"] == "flank" ){ local.standoff = 700 }
	local.slot = local.actor.flags["coop_squadSlot"]
	if( local.slot == NIL ){ local.slot = randomint 6 }
	local.offang = ( 0 0 0 )
	local.offang[1] = local.slot * 60
	local.offdir = angles_toforward local.offang
	wait 1
	if( local.actor == NULL || !isAlive local.actor ){ end }
	while( local.actor != NULL && isAlive local.actor ){
		local.np = waitthread coop_mod/replace.scr::player_closestTargetable local.actor
		if( local.np != NULL ){
			local.nd = vector_length( local.actor.origin - local.np.origin )
			if( local.nd > local.standoff ){
				// advance toward an OFFSET point around the player (fan out) - wall-safe + anti-stuck
				waitthread coop_push_toward local.actor local.np local.offdir 220
			} else {
				// in engagement range: let the actor's own think (cover / turret) fight from here
				local.actor attackplayer
				local.actor.coop_stuckcount = 0
				local.actor.coop_lastpos = local.actor.origin
			}
		}
		// POLL + re-issue (never `waittill movedone` - pain interruption under fire hangs it)
		wait 1.5
	}
}end


// Returns 1 if wave type local.t (0-7) is permitted by level.coop_wave_mask, else 0.
// MOHAA has no bitwise AND, so test bit t via integer division/modulo:
//   bit set  <=>  int(mask / 2^t) is odd.
coop_wave_allowed local.t:{
	local.mask = level.coop_wave_mask
	if( local.mask == NIL ){ end 1 }
	local.pow = 1
	if( local.t == 1 ){ local.pow = 2 }
	if( local.t == 2 ){ local.pow = 4 }
	if( local.t == 3 ){ local.pow = 8 }
	if( local.t == 4 ){ local.pow = 16 }
	if( local.t == 5 ){ local.pow = 32 }
	if( local.t == 6 ){ local.pow = 64 }
	if( local.t == 7 ){ local.pow = 128 }
	local.q = int( local.mask / local.pow )
	local.half = int( local.q / 2 )
	if( (local.q - (local.half * 2)) == 1 ){ end 1 }
	end 0
}end


coop_call_reinforcements:{
	if( level.coop_officer == NULL ){ end }
	//[209] REINFORCEMENT COOLDOWN - every wave call (HP thresholds, bodyguard deaths)
	//funnels through here; the officer can no longer spam waves while his HP drains.
	//Live-tunable: coop_officerWaveCooldown seconds (empty/invalid = default 45).
	local.cd = getcvar "coop_officerWaveCooldown"
	if( local.cd == "" ){ local.cd = 45 }
	local.cd = int( local.cd )
	if( local.cd <= 0 ){ local.cd = 45 }
	if( level.coop_officer_lastWaveTime != NIL ){
		if( level.time < (level.coop_officer_lastWaveTime + local.cd) ){
			iprintlnbold "The Officer barks into his radio - but his reinforcements are not ready yet!"
			end
		}
	}
	level.coop_officer_lastWaveTime = level.time
	//[user 2026-08-08] "Ring of Steel": the whole squad dug into deployed sandbags at the moment the
	//officer calls a wave in. Evaluated on the CALL, not on the wave being wiped out - there is no
	//"this wave is broken" event anywhere in this file (waves are spawned and then merge into the
	//general AI population), and inventing per-wave AI tracking for one challenge is not worth it.
	//"Ready before it lands" is the same coordination feat and is exactly measurable right here.
	thread coop_mod/challenges.scr::chal_ring_of_steel
	local.fwd = angles_toforward level.coop_officer.angles
	if( level.coop_officer_reinf_zone != NIL ){
		local.spawn_base = level.coop_officer_reinf_zone
	} else {
		local.spawn_base = level.coop_officer.origin - (local.fwd * 500)
	}
	local.spawn_pos = exec coop_mod/officer.scr::coop_find_ground local.spawn_base
	if( local.spawn_pos != NIL ){
		local.sz_diff = local.spawn_pos[2] - level.coop_officer.origin[2]
		if( local.sz_diff < 0 ){ local.sz_diff = 0 - local.sz_diff }
		// HZM COOP: per-map Z tolerance. Default 128 rejects reinf zones on a different
		// floor than the officer (avoids bad spawns). Maps whose authored reinf_zone is
		// intentionally on another level (e.g. m1l2a) set level.coop_officer_reinf_ztol
		// high in officer_positions.scr so the zone is honored without the per-wave warning.
		local.ztol = 128
		if( level.coop_officer_reinf_ztol != NIL ){ local.ztol = level.coop_officer_reinf_ztol }
		if( local.sz_diff > local.ztol ){
			if(level.cMTE_coop_officer){ iprintlnbold ("REINF: spawn Z diff " + int(local.sz_diff) + " too large, using officer pos") }
			local.spawn_pos = NIL
		}
	}
	if( local.spawn_pos == NIL ){
		local.safe_fallback = level.coop_officer.origin + (local.fwd * -300)
		local.spawn_pos = exec coop_mod/officer.scr::coop_find_ground local.safe_fallback
	}
	if( local.spawn_pos == NIL ){
		if(level.cMTE_coop_officer){ iprintlnbold "REINF: no valid ground for spawn, aborting wave" }
		end
	}
	// Wave-mask reroll: only dispatch wave types whose bit is set in level.coop_wave_mask
	// (default 255 = all 8 allowed). Reroll up to 16 times; if nothing allowed, fall back
	// to infantry (type 1, always-safe on-foot squad). No bitwise op in MOHAA -> bit test
	// via coop_wave_allowed (division/modulo arithmetic).
	local.r = randomint 8
	local.tries = 0
	while( !(exec coop_mod/officer.scr::coop_wave_allowed local.r) && local.tries < 16 ){
		local.r = randomint 8
		local.tries++
	}
	if( !(exec coop_mod/officer.scr::coop_wave_allowed local.r) ){
		local.r = 1
	}
	// Top-down strikes -- Stuka (4) AND Artillery (5) -- may ONLY be called if the officer
	// can actually SEE a player who is OUTDOORS (open sky overhead), and must be aimed at
	// THAT player. Never strike a player the officer can't see, and never strike when no
	// seen player has open sky (e.g. the sub pen interior). If there's no seen-outdoor
	// player, reroll to an on-foot infantry squad (type 1). local.strike_target carries the
	// locked aim point into the dispatch below. Done before the dispatch so type 1 fires.
	local.strike_target = NIL
	if( local.r == 4 || local.r == 5 ){
		if( level.coop_officer_no_airstrikes == 1 ){
			// per-map: NO Stuka/Artillery on this map (e.g. interior sub-pen) -> on-foot squad instead
			local.r = 1
		} else {
			local.strike_p = exec coop_mod/officer.scr::coop_officer_visible_outdoor_player
			if( local.strike_p == NIL ){
				local.r = 1
			} else {
				local.strike_target = local.strike_p.origin
			}
		}
	}
	thread coop_radio_broadcast
	//[user 2026-08-17] XP wave window opens HERE (the wave dispatcher, not the officer-spotted
	//broadcast at :601). This file deliberately has no wave-boundary event - its own note says the
	//waves merge into the general population - so xp.scr builds one by watching the
	//coop_xpClass="reinf" population drain back to zero.
	thread coop_mod/xp.scr::xp_wave_begin

	//[user 2026-08-14] CHALLENGE "The Full Deck" - face down all eight kinds of reinforcement the
	//officer can call. The stat existed and the challenge shipped, but nothing ever wrote it, so it
	//sat at 0/8 forever looking earnable. Wired HERE rather than at the pick above because local.r
	//is only final at this point: the wave-mask reroll and the Stuka/Artillery outdoor check can
	//both rewrite it to type 1, and crediting the rolled type would credit a wave that was never
	//actually dispatched. Latched per type per player, so repeat waves of one kind count once.
	local.fdi = 1
	while( local.fdi <= $player.size ){
		local.fdp = $player[local.fdi]
		if( local.fdp != NULL && local.fdp != NIL ){
			if( local.fdp.flags[ "coop_chalDeck_" + local.r ] != 1 ){
				local.fdp.flags[ "coop_chalDeck_" + local.r ] = 1
				thread coop_mod/challenges.scr::chal_bump local.fdp "evt_full_deck" 1
			}
		}
		local.fdi++
	}

	if( local.r == 0 ){
		iprintlnbold "Recon reports the Officer has deployed an Elite Squad to hunt you down and eliminate you."
		thread coop_spawn_elite_squad local.spawn_pos
	}
	if( local.r == 1 ){
		iprintlnbold "Recon reports the Officer has deployed a Wehrmacht Squad to hunt you down and eliminate you."
		thread coop_spawn_infantry_squad local.spawn_pos
	}
	if( local.r == 2 ){
		iprintlnbold "Recon reports the Officer has deployed an Elite Sniper to hunt you down and eliminate you."
		thread coop_spawn_sniper local.spawn_pos
	}
	if( local.r == 3 ){
		iprintlnbold "Recon reports the Officer has deployed a Grenadier Squad to hunt you down and eliminate you."
		thread coop_spawn_grenadiers local.spawn_pos
	}
	if( local.r == 4 ){
		iprintlnbold "Recon reports the Officer has called in a Stuka dive bomber onto your position."
		thread coop_stuka_attack local.strike_target
	}
	if( local.r == 5 ){
		iprintlnbold "Recon reports the Officer has called in an Artillery barrage onto your position."
		thread coop_artillery_barrage local.strike_target
	}
	if( local.r == 6 ){
		iprintlnbold "Recon reports the Officer has deployed an Anti-Tank Team to hunt you down and eliminate you."
		thread coop_spawn_at_team local.spawn_pos
	}
	if( local.r == 7 ){
		iprintlnbold "Recon reports the Officer has unleashed attack dogs to hunt you down."
		thread coop_spawn_dogs local.spawn_pos
	}
}end


//[310] HZM coop - OFFICER REINFORCEMENT PLAYER-SCALING. Effective player count for the officer
// system: live players, honoring the same solo-test override as the generic AI scaler
// (coop_aiScaleTest 1 = a lone host counts as 2 - REQUIRED to see scaling solo) and capped by
// level.coop_maxPlayerScalar (variables.scr, def 4) so a huge lobby doesn't scale forever.
coop_reinf_pc:{
	local.pc = 1
	if( $player != NULL && $player.size > 0 ){ local.pc = $player.size }
	if( getcvar "coop_aiScaleTest" == "1" && local.pc < 2 ){ local.pc = 2 }
	local.cap = level.coop_maxPlayerScalar
	if( local.cap == NIL || local.cap < 1 ){ local.cap = 4 }
	if( local.pc > local.cap ){ local.pc = local.cap }
	end local.pc
}end


//[310] HZM coop - scaled UNIT COUNT for a wave/battalion. The AUTHORED base numbers are the
// coop_officerBasePc-player experience (def 2): n = base + (pc - basePc) * per, so SOLO play
// fields SMALLER units than authored and 3-4 players field bigger ones. per comes from the named
// cvar (local.pername; empty/invalid = local.perdef), floor 1, hard-limited by local.cap (squads
// are limited by their monitor slots). If the LIVE german count is already at the entity-budget
// hardcap (level.coop_aiScaleHardCap, shared with the generic count-scaler), never exceed the
// authored base - the base wave always spawns, only the extras yield.
coop_reinf_count local.base local.pername local.perdef local.cap:{
	local.n = local.base
	if( getcvar "coop_officerScale" == "0" ){ end local.n }
	local.pc = exec coop_mod/officer.scr::coop_reinf_pc
	local.bp = getcvar "coop_officerBasePc"
	if( local.bp == "" ){ local.bp = 2 }
	local.bp = int( local.bp )
	if( local.bp < 1 ){ local.bp = 2 }
	if( local.pc == local.bp ){ end local.n }
	local.per = getcvar local.pername
	if( local.per == "" ){ local.per = local.perdef }
	local.per = int( local.per )
	if( local.per <= 0 ){ local.per = local.perdef }
	local.n = local.base + ((local.pc - local.bp) * local.per)
	if( local.n < 1 ){ local.n = 1 }
	if( local.cap != NIL && local.n > local.cap ){ local.n = local.cap }
	if( level.coop_aiScaleHardCap != NIL && level.coop_actorArray["german"] != NIL && level.coop_actorArray["german"].size >= level.coop_aiScaleHardCap ){
		if( local.n > local.base ){ local.n = local.base }
	}
	end local.n
}end


//[310] HZM coop - scale ONE reinforcement trooper's HEALTH + ACCURACY by player count. Call right
// after the spawner sets its authored .health/.accuracy/gun (same tick as spawn). Works for BOTH
// health systems: flagged (coop_actorStopPainHandler) troops keep plain .health; unflagged troops
// get the scaled value snapshotted into coop_actorActualHealth by aihandler::initialisePainVars a
// frame later (scaled health is kept under 700 so the >700 re-clamp there never fires).
// The AUTHORED stats are the coop_officerBasePc-player experience (def 2): extra = pc - basePc
// can be NEGATIVE, so a SOLO player faces weaker/less accurate troops than authored. HEALTH:
// +/-coop_officerHealthPct% per player step (def 35, floor 25hp). ACCURACY: moves
// coop_officerAccPct% (def 15) of the remaining range to 100 per step (floor 20) - gentler than
// the generic aihandler curve, which is DISABLED for these actors (coop_actorStopAccuracy) so the
// two systems never double-scale. coop_waveActor=1 also excludes officer troops from the generic
// per-spawn cloner (aihandler::coop_tryDuplicateActor) - coop_reinf_count is the single count
// authority for officer content.
// [user 2026-08-17] VOID GUARD. "If any officer reinforcements ever fall under the map how can we
// ensure they just get killed?" A reinforcement that drops through geometry keeps falling forever:
// it stays ALIVE, so the wave's alive-count never frees up and no replacement spawns - the fight
// quietly thins out and the officer stops reinforcing.
//
// Killed, not removed, and killed the proven way (allysquad.scr:244-248: takedamage -> health 1 ->
// kill) so every death monitor and counter that is waiting on it actually fires. 'remove' would
// leave those latches hanging, which is the bug this is meant to prevent.
//
// The test is relative to where the actor SPAWNED, so it needs no per-map floor: nothing legitimately
// descends coop_voidDrop (2500u default) below its own spawn point. Cliff maps stay safe.
coop_voidWatch local.actor:{
	if( local.actor == NULL || local.actor == NIL ){ end }
	local.drop = 2500
	local.c = getcvar( "coop_voidDrop" )
	if( local.c != "" ){
		if( local.c != "0" ){ local.drop = int( local.c ) }
	}
	local.z0 = local.actor.origin[2]
	local.floor = local.z0 - local.drop

	while( local.actor != NULL ){
		wait 2
		if( local.actor == NULL ){ end }
		if( !isAlive local.actor ){ end }
		local.z = local.actor.origin[2]
		if( local.z < local.floor ){
			println( "^~^~^ VOIDKILL " + local.actor.targetname + " fell to " + local.z + " from " + local.z0 )
			local.actor takedamage
			local.actor.health = 1
			local.actor kill
			end
		}
	}
}end

coop_reinf_scale local.actor:{
	thread coop_voidWatch local.actor
	if( local.actor == NULL ){ end }
	local.actor.flags["coop_waveActor"] = 1
	if( getcvar "coop_officerScale" == "0" ){ end }
	local.actor.flags["coop_actorStopAccuracy"] = 1
	local.pc = exec coop_mod/officer.scr::coop_reinf_pc
	local.bp = getcvar "coop_officerBasePc"
	if( local.bp == "" ){ local.bp = 2 }
	local.bp = int( local.bp )
	if( local.bp < 1 ){ local.bp = 2 }
	local.extra = local.pc - local.bp
	if( local.extra == 0 ){ end }
	local.hpct = getcvar "coop_officerHealthPct"
	if( local.hpct == "" ){ local.hpct = 35 }
	local.hpct = int( local.hpct )
	if( local.hpct <= 0 ){ local.hpct = 35 }
	local.hp = local.actor.health
	if( local.hp > 0 ){
		local.hp = int( local.hp + ((local.hp * local.hpct * local.extra) / 100) )
		if( local.hp < 25 ){ local.hp = 25 }
		if( local.hp > 690 ){ local.hp = 690 }
		local.actor.health = local.hp
	}
	local.apct = getcvar "coop_officerAccPct"
	if( local.apct == "" ){ local.apct = 15 }
	local.apct = int( local.apct )
	if( local.apct <= 0 ){ local.apct = 15 }
	local.acc = local.actor.accuracy
	if( local.acc > 0 && local.acc < 100 ){
		local.acc = int( local.acc + (((100 - local.acc) * local.apct * local.extra) / 100) )
		if( local.acc < 20 ){ local.acc = 20 }
		if( local.acc > 100 ){ local.acc = 100 }
		local.actor.accuracy = local.acc
	}
}end


// Returns a SCATTERED ground position around local.anchor for the local.i-th trooper, so a
// squad/battalion never pops in stacked inside each other (they used to spawn in a tight straight
// line and droptofloor on top of one another). Fans them on a widening spiral (angle via
// angles_toforward - no sin/cos needed) plus a little random jitter, then drops to floor.
coop_spread_pos local.anchor local.i:{
	// HARDENED (2026-06-27): the old `rad = 64 + i*24` was UNCAPPED - a 5th death battalion (idx up to
	// 49) reached ~1240u and flung troopers into walls/void where they spawned stuck/invisible (the
	// "missing battalions"). Now: CAP the radius (wrap the ring so it never exceeds ~360), and on each
	// candidate REJECT spots that drop to a very different floor; retry a few jittered candidates, and
	// fall back to the anchor itself (guaranteed valid) if all fail. Keeps squads near + reachable.
	local.try = 0
	while( local.try < 6 ){
		local.ring = local.i + (local.try * 3)
		// ring mod 6 (no % operator in MOHAA -> divide/multiply) so radius cycles 80..360, never huge
		local.half = int( local.ring / 6 )
		local.step = local.ring - (local.half * 6)
		local.ang = ( 0 0 0 )
		local.ang[1] = (local.ring * 75) + (randomint 40)	// fan + jitter the angle each ring/retry
		local.dir = angles_toforward local.ang
		local.rad = 80 + (local.step * 56)			// CAPPED: 80 to 360 units
		local.p = local.anchor + (vector_scale local.dir local.rad)
		local.p[0] = local.p[0] + ((randomint 48) - 24)
		local.p[1] = local.p[1] + ((randomint 48) - 24)
		local.gnd = exec coop_mod/officer.scr::coop_find_ground local.p
		if( local.gnd != NIL ){
			local.zd = local.gnd[2] - local.anchor[2]
			if( local.zd < 0 ){ local.zd = 0 - local.zd }
			//[user 2026-08-21] REACHABILITY, not just floor height. A candidate can sit on perfectly
			//good ground and still be on the far side of a wall from the anchor - which is how a
			//reinforcement ends up somewhere it can never path out of. The anchor is known navigable,
			//so require clear line of sight from it (chest height, both ends) before accepting.
			if( local.zd <= 180 ){
				//assign first, then test - every other sighttrace/traced call in the project takes
				//this shape and an inline call in a condition is not worth the parse risk.
				local.clear = sighttrace (local.anchor + (0 0 40)) (local.gnd + (0 0 40)) 1
				if( local.clear ){
					end local.gnd
				}
			}
		}
		local.try++
	}
	// all candidates failed -> use the anchor itself (the officer/reinf-zone spot is known navigable)
	local.fg = exec coop_mod/officer.scr::coop_find_ground local.anchor
	if( local.fg == NIL ){ local.fg = local.anchor }
	end local.fg
}end

//[208] HZM coop - per-trooper PERSONALITY roll, set ONCE at spawn (no per-actor loop - the engine runs
//the behavior). ~35% AGGRESSIVE (rush in, long leash, no first-contact freeze), ~40% COVER (native
//type_attack "cover" = real cover-seek + crouch-at-cover + squad spacing + reload-fallback, hold at
//range), ~25% FLANKER (cover think, the mover offsets it to a side). Only safe engine props (NO prone -
//engine stub/crash; crouch comes for free at cover AI_DUCK nodes). Tagged coop_personality_set so the
//hurt manager (coop_reinf_brain) can later send it to cover + canteen.
//=========================================================================
//=========================================================================
// [user 2026-08-10] A4 - PROTECTED ACTORS (master plan v2 Step 4). Returns 1 for an actor that
// some OTHER system owns and the coop AI-enrichment layer must not rewrite.
//
// A3 measured the damage on m2l2a: coop_apply_personality fired on 55 actors and its prone roll
// hit suckyfatty (the CARD TABLE man), guy1 (a Naxos watcher) and ai_alarm (an ALARM RUNNER).
// coop_prone_shooter sets enableEnemy = 0, which actor.cpp:8608-8626 converts into a forced IDLE
// plus SetEnemy(NULL) even out of a DISGUISE think, then locks a looped anim_scripted pose for
// the whole life of the actor - invisible to every thinkstate probe, which is why three rounds of
// script-side detectors never saw it.
//
// KEY CHOICE, forced by measurement: A3 showed hasAlarm=0 on ALL 55 actors, because
// alarm_system_setup does not run until 23 SECONDS after personalities are applied. An
// alarmthread-based exemption would therefore have matched NOTHING at the only moment it matters.
// So the tests below lead with keys that exist AT PERSONALITY TIME (targetname, type_attack,
// type_disguise) and keep alarmthread only as a late-arriving bonus for re-checks after a yield.
//
// Structural tests are map-agnostic; the per-map name list is supplied by the map itself in
// level.coop_sceneActorNames, so this shared label stays generic. Phase C initScene will also set
// flags["coop_sceneActor"], which is honoured here already.
//=========================================================================
coop_isProtectedActor local.actor:{
	if( local.actor == NULL || local.actor == NIL ){ end (0) }
	if( getcvar( "coop_disgAggroParity" ) == "0" ){ end (0) }

	//Phase C tag (NIL today, set by stealth.scr::initScene later)
	if( local.actor.flags["coop_sceneActor"] == 1 ){ end (1) }

	//[user 2026-08-22, bug-2033] STRUCTURAL: AI ALREADY SWITCHED OFF = SCENERY.
	//After m1l1 (bug-2032) the user asked whether other scripted scenes took the same break.
	//They did: an audit (docs/tools/audit_scene_actors.py) found 34 maps using scene markers
	//with no protection, including 19 disabled Wehrmacht bunker actors on m3l1b, 9 on m3l2 and
	//7 on m2l3. Naming every one of them by hand across the trilogy would be slow and would
	//certainly miss some.
	//
	//global/disable_ai.scr is exactly one line - `self.enableEnemy = 0` - so a map that has
	//deliberately switched an actor's AI off has already SAID it is scenery, in a form we can
	//read. Honour that directly and every such actor on every map, present and future, is
	//covered without a per-map list.
	//
	//This matters because coop_apply_personality does not merely add flavour: its cover/flank
	//branches OVERWRITE type_attack (~65% of rolls) and the prone branch locks a scripted pose,
	//so a scene actor loses the very think the map set for him.
	//
	//Safe against false positives: our own systems that zero enableEnemy (surrender, the prone
	//branch) act LATER than the personality roll, and an actor they have downed should be
	//exempt anyway. The per-map name list stays as the answer for actors disabled only after
	//the roll - which is why m1l1, m2l2a and m6l2a keep theirs.
	//[bug-2034] was `local.actor.enableEnemy == 0`. enableEnemy is WRITE-ONLY in this engine:
	//reading it throws "Cannot set a read-only variable", and a Script Error SKIPS THE
	//STATEMENT rather than killing the thread (TRAPS) - so the guard silently never ran while
	//spamming 136 errors a map. The state is now recorded where it is SET instead, by our
	//global/disable_ai.scr override, into a plain custom property that can be read back.
	if( local.actor.coop_aiDisabled == 1 ){ end (1) }

	//the alarm-runner set: 14 actors literally share the targetname "ai_alarm" on m2l2a, and
	//proning one of them means the alarm cannot be rung properly
	if( local.actor.targetname == "ai_alarm" ){ end (1) }

	//an actor the alarm system owns, by either the early or the late key
	if( local.actor.type_attack == "alarm" ){ end (1) }
	if( local.actor.alarmthread != NIL ){ end (1) }

	//A papers checker: rewriting his think means he can never be shown papers again.
	//[user 2026-08-10] SCOPED TO DISGUISE MAPS - measured correction. type_disguise "salute" is
	//effectively the MAP-EDITOR DEFAULT, not a marker: it is set on 44/54 ai entities in m1l1,
	//47/52 in m1l2a and 42/43 in m5l3 (BSP entity-lump counts). Exempting on it unconditionally
	//switched the coop AI-dynamics personality system OFF across most of the game - a silent
	//regression of a shipped feature, caught by the cross-map check before it reached a playtest.
	//sentry/officer/rover ARE rare and meaningful (m2l2a: 3 + 2 + 0; the three combat maps: 0),
	//so they stay unconditional; only "salute" needs the disguise-map scope. level.coop_enableDisguises
	//is set by exactly m2l2a, m2l2b and e1l4 - the maps where a saluter is a live papers checker.
	local.td = local.actor.type_disguise
	if( local.td == "sentry" ){ end (1) }
	if( local.td == "officer" ){ end (1) }
	if( local.td == "rover" ){ end (1) }
	//[user 2026-08-12] MEASURED: 4642 "Path not found in Actor::MoveToPatrolCurrentNode" in one
	//two-hour m6l2a session, 2410 of them on targetname 'enemy'. Same mechanism as bug-1649 on m2l2a,
	//at ~34x the volume, and the reason m6l2a's AI do not keep their authored jobs.
	//CAUSE: coop_apply_personality runs ~1s after actor spawn (bug-1648), and on an OPT-IN stealth map
	//coop_enableDisguises is still FALSE then - it is not set until a player takes the uniform cache,
	//which may be minutes later or never. So this clause protected nobody on m6l1c or m6l2a, ~40 of 44
	//disguise-keyed actors took the personality roll, and ~12% ended up prone with enableEnemy = 0.
	//A proned papers checker can never be shown papers again.
	//coop_stealthCapable is the map saying "a saluter here MAY become a live checker later", set at map
	//load rather than at pickup. m2l2a/m2l2b/e1l4 are unaffected: they set coop_enableDisguises at load,
	//so the left operand was already true for them and the right one is simply never set.
	if( local.td == "salute" && ( level.coop_enableDisguises || level.coop_stealthCapable ) ){ end (1) }

	//per-map named scene actors (set by the map; absent everywhere else, so this is inert)
	if( level.coop_sceneActorNames != NIL ){
		local.tn = local.actor.targetname
		for( local.i = 1; local.i <= level.coop_sceneActorNames.size; local.i++ ){
			if( local.tn == level.coop_sceneActorNames[local.i] ){ end (1) }
		}
	}
}end (0)

//=========================================================================
coop_attach_dynamics local.actor:{
//=========================================================================
// [user 2026-08-22, bug-2045] The three AI-dynamics monitors used to be threaded from the
// FALL-THROUGH of coop_isProtectedActor, which made a PREDICATE attach behaviour. Asking
// "is this actor protected?" armed him. That predicate has NINE callers and only the
// personality one wanted the attachment, so seven others were silently arming actors:
//   * coop_variantRoll (aihandler.scr) runs on EVERY actor with no team gate - which is how
//     an ALLY ended up flagged surrendered with a "hold USE to convert enemy" prompt over him
//     (16 census rows, tm=american surr=1, 2026-08-22 capture).
//   * aimaneuver.scr:92 sweeps every german every 2 SECONDS FOREVER, so this spawned three
//     fresh threads per german per sweep - one of them an unbounded while(alive) loop holding
//     two full maxentities walks. That is a thread leak, and the likeliest cause of the
//     "atrocious" lag the user reported, which I had wrongly blamed on the probe.
//   * wounded.scr threads it on every SURVIVED pain hit - three more per non-lethal bullet.
//
// Now attachment is explicit, happens exactly once per actor, and keeps the protection
// semantics it always had: protected actors are still skipped, because this label asks the
// predicate itself.
//
// DELIBERATELY NOT TEAM-GATED, and this is not an oversight. coop_suppress_react and
// coop_arrival_slide whitelist bar/thompson/sten (officer.scr, ~4845/4930) - ALLIED weapon
// groups - so they are meant to run on allies, and paradrop.scr:338 calls the personality
// path on deliberately-allied actors (paradrop.scr:306-310 explains why). A blanket german
// gate here would silently reverse both. The one behaviour that genuinely must never touch an
// ally - surrendering to the player - is gated inside coop_squad_surrender instead.
//
// ALSO NOT gated on coop_aiDynamic: these three carry their own cvars (coop_aiSlideChance,
// coop_aiSurrenderChance), and making independently-configured features depend on a fourth
// switch is the silent-veto shape in TRAPS T3.
	if( local.actor == NULL || local.actor == NIL ){ end }
	if( local.actor.flags["coop_dynAttached"] == 1 ){ end }
	local.actor.flags["coop_dynAttached"] = 1
	if( waitthread coop_isProtectedActor local.actor ){ end }

	//arrival slide: some movers throw a baseball slide into their first stop
	//(misc/takecover_slide - 885u of travel retail never played). One-shot monitor.
	if( (randomint 100) < (int(getcvar "coop_aiSlideChance") + 0) ){
		thread coop_arrival_slide local.actor
	}
	//suppression reaction: the engine stamps self.coop_suppressedAt when the player's fire
	//cracks near this AI (weaputils.cpp) - turns that into a visible dive-to-crouch.
	thread coop_suppress_react local.actor
	//"if they are the last soldier in their squad they should surrender"
	thread coop_squad_surrender local.actor
}end

coop_apply_personality local.actor:{
//=========================================================================
	if( local.actor == NULL || !isAlive local.actor ){ end }

	//[user 08-07] MACHINEGUNNERS ARE EXEMPT. This is what made "he gets off the MG42 and runs"
	//happen on every gunner in the game, and it is our own doing, not retail: the "cover" and
	//"flank" branches below do `type_attack "cover"`, which OVERWRITES the machinegunner think an
	//MG42 gunner needs to stay on his gun, and the prone branch locks him into a scripted pose.
	//With this called on every german actor that is ~65% overwritten + ~12% proned, so only about
	//a third of gunners ever kept their gun - and which third was a dice roll, which is why it
	//looked random and unrelated to where the player was standing.
	//A man bolted to a fixed weapon has no use for a flank/cover/prone role anyway.
	if( local.actor.type_idle == "machinegunner" ){ end }
	if( local.actor.type_attack == "machinegunner" ){ end }

	//[user 2026-08-10] A4: never roll a personality for an actor another system owns.
	if( waitthread coop_isProtectedActor local.actor ){
		if( getcvar( "coop_aggroDebug" ) == "1" ){
			println( "^~^~^ PERSSKIP actor=" + local.actor.targetname )
		}
		end
	}

	//[user 2026-08-10] A3 INSTRUMENT (master plan v2 Step 4). This label is the DOMINANT scene-actor
	//writer and no earlier plan revision named it: aihandler.scr threads it for EVERY german while
	//coop_aiDynamic is 1 (seeded on), it exempts only machinegunners, ~12% of rolls prone the actor
	//with enableEnemy = 0 (which forces IDLE out of a DISGUISE think and NULLs the enemy - a proned
	//papers checker can never be shown papers again) and ~60% of the rest overwrite the
	//type_attack "alarm" that the map and alarm_system force-assign.
	//Prints only. hasAlarm is a 0/1 boolean for the same const-array reason as the HURT print.
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		local.persAlarm = 0
		if( local.actor.alarmthread != NIL ){ local.persAlarm = 1 }
		println( "^~^~^ PERS actor=" + local.actor.targetname + " type=" + local.actor.type_attack + " hasAlarm=" + local.persAlarm )
	}

	if( local.actor.flags["coop_personality_set"] == 1 ){ end }
	local.actor.flags["coop_personality_set"] = 1
	local.roll = randomint 100
	// ~12% PRONE SHOOTER -- only weapongroups that actually have prone anims (bazooka/grenade/mg42/
	// generic have none -> they fall through to a normal role). Crash-safe: a cosmetic scripted prone
	// pose + a decoupled gun entity for the real bullets; the actor never runs the attack.scr prone
	// loop that crashes the server.
	//[bug-1852] TUNABLE PRONE SHARE. Measured this session: the prone path works end to end - role
	//assigned, protection passed (protect=0), pose issued, and mp40_prone_shoot / rifle_prone_shoot
	//both exist in the game data. What was wrong was the BELIEF that it was broken: AIBEHAV reports
	//prone=0 even in the same second a trace shows "posing wg=mp40 role=prone", and bug-1103 was
	//declared verified on that counter. The user simply never sees it because 12% is rare and a
	//poser stands again after ~4s without a visible target.
	//coop_aiProneChance is the percentage; 0 disables prone entirely.
	local.pchance = 12
	local.pc = getcvar( "coop_aiProneChance" )
	if( local.pc != "" ){ local.pchance = int( local.pc ) }
	local.pthresh = 100 - local.pchance
	if( local.roll >= local.pthresh && local.pchance > 0 ){
		// PRONE SHOOTER (~12%). Do NOT gate the DECISION on a live weapongroup read at this spawn frame -
		// the active MAIN weapon slot is usually still empty here (weapongroup reads "unarmed"), so the old
		// group test failed, the roll degraded to the flank else-branch, and the coop_personality_set latch
		// meant it never re-rolled once armed (bug: prone=0 in every tracker sample). coop_prone_shooter
		// waits for the weapon to populate, THEN validates the group (crash-safe: never poses unsupported).
		local.actor.flags["coop_role"] = "prone"
		local.actor.leash = 2048
		thread coop_prone_shooter local.actor
		end
	}
	if( local.roll < 35 ){
		local.actor.flags["coop_role"] = "aggr"
		local.actor.leash = 4096
		local.actor.nosurprise = 1
	} else if( local.roll < 75 ){
		local.actor.flags["coop_role"] = "cover"
		local.actor type_attack "cover"
		local.actor.leash = 1536
		local.actor.mindist = 400
		local.actor.maxdist = 1600
	} else {
		local.actor.flags["coop_role"] = "flank"
		local.actor type_attack "cover"
		local.actor.leash = 2560
	}
}end

//[209] HZM coop - CRASH-SAFE PRONE SHOOTER. The actor is locked into a cosmetic scripted prone pose
// via anim_scripted, which suspends its normal AI think -- so it NEVER enters the attack.scr prone/
// crouch branch that tight-spins and crashes the server (see [[attack_scr_aiprone_fix]]). The real
// bullets come from a decoupled script_aimedstrafinggunfire pinned at the prone muzzle (the SAME proven
// pattern as the panzerschreck gunner + the Stuka MG strafe). The actor is NOT made invincible (user:
// not invincible). If it loses sight of every player for a while it stands up the proven safe way
// (hard-cut idle + enableEnemy bounce + forceactivate, per the medic-kneel exit) and re-engages.
//=========================================================================
coop_prone_shooter local.actor:{
//=========================================================================
	wait 0.5
	if( local.actor == NULL || !isAlive local.actor ){ end }
	if( local.actor.flags["coop_surrendered"] == 1 ){ end }	//[user 2026-08-20] never pull a surrendered (holstered) man back into a combat pose
	//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
	if( local.actor.coop_aiDisabled == 1 ){ end }
	// Wait for the active MAIN weapon slot to populate. weapongroup reads "unarmed" until the engine
	// finishes assigning/drawing the weapon (Holster does NOT clear the slot), so a single read at spawn
	// is unreliable - retry ~2s before deciding. This is what makes the prone role actually appear.
	local.wg = local.actor.weapongroup
	local.tries = 0
	while( ( local.wg == "unarmed" || local.wg == "" || local.wg == NIL ) && local.tries < 8 ){
		wait 0.25
		if( local.actor == NULL || !isAlive local.actor ){ end }
		local.wg = local.actor.weapongroup
		local.tries++
	}
	// DIAG (coop_aiBehav): capture what weapongroup a prone-rolled actor actually resolves to, so the
	// whitelist below can be corrected to the real German AI strings instead of guessed (why prone is rare).
	if( getcvar( "coop_aiBehav" ) != "0" && getcvar( "coop_aiBehav" ) != "" ){
		println( "^~^~^ PRONEDBG wg=" + local.wg + " tries=" + local.tries )
	}
	// Only groups with a real <wg>_prone_shoot anim can pose; anything else (bazooka/grenade/mg42/
	// generic) or still-unarmed after the wait -> a moving cover role (never a broken anim_scripted).
	if( local.wg != "rifle" && local.wg != "mp40" && local.wg != "mp44" && local.wg != "bar" && local.wg != "thompson" && local.wg != "vickers" && local.wg != "pistol" && local.wg != "sten" ){
		local.actor.flags["coop_role"] = "cover"
		local.actor type_attack "cover"
		end
	}
	//[user 2026-08-10] A3 INSTRUMENT (master plan v2 Step 4). Three constraints, all deliberate:
	//(1) NOT called PRONEDBG - a ^~^~^ PRONEDBG print already ships ~10 lines above and reusing the
	//name makes the acceptance grep ambiguous; (2) placed BELOW the weapongroup reject, because the
	//shipped print sits above it and therefore fires for actors that never pose - which is not what
	//this measures; (3) gated on coop_aggroDebug, the convention the rest of these probes use - the
	//shipped print is gated on coop_aiBehav, which the test recipe never sets, so it is silent.
	//[user 2026-08-10] A4 RE-CHECK. This label YIELDS while it waits for a weapongroup, so an actor
	//can acquire its alarmthread / type_attack "alarm" between the entry test and here - which is
	//exactly the 23-second window A3 measured. Re-test, and on a hit leave WITHOUT WRITING ANYTHING:
	//the ordinary reject path below sets type_attack "cover", which would overwrite the very
	//assignment we are protecting.
	if( waitthread coop_isProtectedActor local.actor ){
		if( getcvar( "coop_aggroDebug" ) == "1" ){
			println( "^~^~^ PRONESKIP actor=" + local.actor.targetname )
		}
		end
	}
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ PRONEPOSE actor=" + local.actor.targetname + " wg=" + local.wg )
	}
	// lock the prone pose; enableEnemy 0 + anim_scripted stops the normal think (no attack.scr crash)
	local.actor.enableEnemy = 0
	local.actor anim_scripted (local.wg + "_prone_shoot")
	// The entity that actually fires. CRITICAL (bug-1185): this class is NOT hitscan - GunFire()
	// always calls ProjectileAttack(), and "bulletdamage" is dead code it accepts and ignores.
	// With no override it defaults to models/projectiles/stukaround.tik (a dive-bomber HE round)
	// at firedelay 0.05 = 20 explosive rounds/sec, aimed straight at the player. That is what was
	// insta-killing players from a prone rifleman with no plane overhead and no officer in sight.
	// Both the projectile AND the fire rate must be set explicitly for a man-portable weapon.
	local.gun = spawn script_aimedstrafinggunfire
	local.gun.origin = local.actor.origin + (0 0 20)
	local.gun projectile "models/projectiles/coop_ai_rifleround.tik"
	local.gun firedelay 0.9			// bolt/semi cadence, NOT the 0.05 default
	local.gun bulletspread 16 16
	local.gun tracerfreq 0
	local.gun bulletdamage 12		// ignored by the engine; kept for intent/readability
	local.lostsight = 0
	local.refresh = 0
	while( local.actor != NULL && isAlive local.actor ){
		// keep the gun at the prone muzzle; re-issue the pose occasionally so it doesn't revert
		local.gun.origin = local.actor.origin + (0 0 20)
		local.refresh++
		if( local.refresh >= 8 ){
			local.actor anim_scripted (local.wg + "_prone_shoot")
			local.refresh = 0
		}
		local.target = waitthread coop_mod/replace.scr::player_closestTargetable local.actor
		if( local.target != NULL && (local.actor cansee local.target) ){
			local.lostsight = 0
			local.gun aimtarget local.target
			local.gun on
			wait 1.5
			local.gun off
		} else {
			local.gun off
			local.lostsight++
			if( local.lostsight >= 10 ){ break }	// [user 2026-08-18] ~8s (was ~4s): posers were too fleeting to ever be SEEN prone
			wait 0.75
		}
	}
	// SAFE EXIT (proven medic-kneel pattern): break the scripted CLIP with a one-frame stand idle,
	// bounce enableEnemy 0 -> 1 to force the engine out of the scripted-anim state, forceactivate.
	local.gun off
	local.gun remove
	if( local.actor != NULL && isAlive local.actor ){
		local.actor anim "idle"
		//[user 2026-08-18] exit to CROUCH, not stand - a poser who loses sight sinks to a knee
		//instead of popping bolt upright, which reads far more natural and keeps him lower
		local.actor.position = "crouch"
		//[user 2026-08-21, bug-2024] never bounce a surrendered man back to live AI
		if( local.actor.flags["coop_surrendered"] == 1 ){ end }
		//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
		if( local.actor.coop_aiDisabled == 1 ){ end }
		local.actor.enableEnemy = 0
		local.actor.enableEnemy = 1
		local.actor forceactivate
		local.actor.flags["coop_personality_set"] = 0	// let it pick up a normal role next
		waitthread coop_apply_personality local.actor
		//[user 2026-08-06] bug-1479 - 'attackplayer' ScriptErrors "player doesn't exist" whenever
		//gentity slot 0 is empty: Actor::EventAttackPlayer tests G_GetEntity(0), which is slot 0 ONLY,
		//and in coop the players occupy whatever slots they get. This threw 666 times across 48 maps -
		//the most widespread error in the mod's own code - and because ScriptError aborts the event
		//BEFORE ForceAttackPlayer runs, the actor stood up from the prone-shooter state with no enemy
		//at all. 'attackentity' takes a real Sentient and returns silently on a bad target, and
		//player_closestTo ends $player under gametype 0, so single-player behaviour is unchanged.
		//(The only thing attackplayer adds is m_bForceAttackPlayer, which merely suppresses disguise
		//recognition - irrelevant here, and disguises do not work in MP anyway.)
		local.coopplr = exec coop_mod/replace.scr::player_closestTo local.actor
		if( local.coopplr != NULL && local.coopplr != NIL ){
			local.actor attackentity local.coopplr
		}
	}
}end

// New reinforcement type: a 10-man Battalion (mixed loadout) that spawns deep in the map
// on/near a distant enemy and marches to protect the officer/radio.
coop_spawn_battalion:{
	if( level.coop_officer == NULL ){ end }

	// Spawn anchor: PREFER the authored reinforcement zone - it's navmesh-verified (the normal
	// waves spawn there and reach the players). The old "farthest living German from the officer"
	// anchor could land the battalion in a navmesh-disconnected spot where it never reached the
	// fight (looked like it never spawned). Falls back to farthest-German, then a directed offset.
	local.anchor = level.coop_officer_reinf_zone
	local.far = 0
	local.arr = level.coop_actorArray["german"]
	if( local.anchor == NIL && local.arr != NIL ){
		local.i = 1
		while( local.i <= local.arr.size ){
			local.e = local.arr[local.i]
			if( local.e != NULL && isAlive local.e ){
				local.d = vector_length( local.e.origin - level.coop_officer.origin )
				if( local.d > local.far ){
					local.far = local.d
					local.anchor = local.e.origin
				}
			}
			local.i++
		}
	}
	if( local.anchor == NIL ){
		// fallback: 1500u from the officer, directed away from the nearest player
		local.np = exec coop_mod/officer.scr::coop_nearest_player_pos
		if( local.np != NIL ){
			local.away = level.coop_officer.origin - local.np
			local.away[2] = 0
			local.away = vector_normalize local.away
			local.anchor = level.coop_officer.origin + (local.away * 1500)
		} else {
			local.afwd = angles_toforward level.coop_officer.angles
			local.anchor = level.coop_officer.origin - (local.afwd * 1500)
		}
	}

	// Destination to protect: the radio if it still stands, otherwise the officer
	local.dest = level.coop_officer.origin
	if( level.coop_radio != NIL && level.coop_radio != NULL ){ local.dest = level.coop_radio.origin }

	iprintlnbold "Recon reports the Officer has summoned a BATTALION! They are converging to protect him!"

	//[310] player-scaled battalion: 10 base + coop_officerBattalionPer (def 3) per extra player
	local.bn = exec coop_mod/officer.scr::coop_reinf_count 10 "coop_officerBattalionPer" 3 22
	level.coop_battalion_n = local.bn
	local.n = 0
	while( local.n < local.bn ){
		local.sgnd = exec coop_mod/officer.scr::coop_spread_pos local.anchor local.n

		local.bmodel = exec coop_mod/officer.scr::coop_model_for "infantry"
		local.b = spawn local.bmodel
		local.b.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
		local.b.origin = local.sgnd
		local.b droptofloor
		local.b.health = 120
		local.b.flags["coop_actorStopPainHandler"] = 1
		local.b.accuracy = 70
		local.b.leash = 4096
		local.b.enableEnemy = 1

		// Mixed loadout across the 10 troops
		if( local.n == 0 ){
			local.b gun "mauser kar 98d sniper"
			local.b.accuracy = 100
		} else if( local.n == 1 ){
			local.b gun "panzerschrek"
		} else if( local.n == 2 || local.n == 3 ){
			local.b gun "shotgun"
		} else if( local.n == 4 || local.n == 5 ){
			local.b gun "stg44"
		} else if( local.n == 6 || local.n == 7 ){
			local.b gun "mp40"
		} else {
			local.b gun "mauser kar 98k"
		}

		exec coop_mod/officer.scr::coop_reinf_scale local.b	//[310] player-count health/accuracy (after the gun table so the lead sniper's 100 acc stands)
		local.b rendereffects "+coopboss"
		local.b forceactivate
		thread coop_wave_glow local.b
		thread coop_battalion_march local.b local.dest
		if( local.n == 1 ){ thread coop_at_rocket_loop local.b }
		level.coop_battalion[local.n + 1] = local.b
		local.n++
	}
	thread coop_battalion_monitor
}end


// A battalion trooper marches to the protect-point, then holds and fights there.
coop_battalion_march local.actor local.dest:{
	wait 0.5
	if( local.actor == NULL || !isAlive local.actor ){ end }
	local.actor.movedoneradius = 200
	local.actor forceactivate
	local.actor runto local.dest
	local.actor waittill movedone
	if( local.actor == NULL || !isAlive local.actor ){ end }
	local.actor attackplayer
	while( local.actor != NULL && isAlive local.actor && level.coop_officer_alive == 1 ){
		local.actor attackplayer
		wait 3
	}
}end


// Announces when the whole battalion is wiped out.
coop_battalion_monitor:{
	wait 2
	//[310] watch however many troopers the scaled battalion actually spawned (solo can be < 10)
	local.bn = level.coop_battalion_n
	if( local.bn == NIL || local.bn < 1 ){ local.bn = 10 }
	while( level.coop_officer_alive == 1 ){
		local.alive = 0
		local.k = 1
		while( local.k <= local.bn ){
			if( level.coop_battalion[local.k] != NULL && isAlive level.coop_battalion[local.k] ){ local.alive++ }
			local.k++
		}
		if( local.alive == 0 ){ break }
		wait 2
	}
	if( level.coop_officer_alive == 1 ){
		iprintlnbold "The Battalion has been wiped out!"
	}
}end


coop_spawn_elite_squad local.pos:{
	local.i = 0
	local.count = 0
	local.last_pos = local.pos
	local.sq1 = NIL
	local.sq2 = NIL
	local.sq3 = NIL
	local.sq4 = NIL
	local.sq5 = NIL
	local.sq6 = NIL
	//[310] player-scaled squad: 3 base + coop_officerSquadPer (def 1) per extra player, cap 6
	local.nt = exec coop_mod/officer.scr::coop_reinf_count 3 "coop_officerSquadPer" 1 6
	while( local.i < local.nt ){
		local.gnd = exec coop_mod/officer.scr::coop_spread_pos local.pos local.i
		if( local.gnd != NIL ){
			local.smodel = exec coop_mod/officer.scr::coop_model_for "elite"
			local.s = spawn local.smodel
			local.s.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
			local.s.origin = local.gnd
			local.s droptofloor
			local.s.health = 100
			local.s.accuracy = 60
			local.s.leash = 4096
			local.s.enableEnemy = 1
			local.s.ammo_grenade = 3
			local.wrand = randomint 4
			if( local.wrand == 0 || local.wrand == 1 ){
				local.s gun "shotgun"
			} else if( local.wrand == 2 ){
				local.s gun "mauser kar 98k"
			} else {
				local.s gun "stg44"
			}
			exec coop_mod/officer.scr::coop_reinf_scale local.s	//[310] player-count health/accuracy
			local.s attackplayer
			local.s rendereffects "+coopboss"
			local.s.flags["coop_squadSlot"] = local.i
			waitthread coop_apply_personality local.s
			thread coop_wave_hunt local.s
			thread coop_wave_glow local.s
			if( local.i == 0 ){ local.sq1 = local.s }
			else if( local.i == 1 ){ local.sq2 = local.s }
			else if( local.i == 2 ){ local.sq3 = local.s }
			else if( local.i == 3 ){ local.sq4 = local.s }
			else if( local.i == 4 ){ local.sq5 = local.s }
			else { local.sq6 = local.s }
			local.count++
			local.last_pos = local.gnd
		}
		local.i++
	}
	if( local.count > 0 ){
		thread coop_elite_smoke_barrage local.last_pos
		thread coop_squad_monitor local.sq1 local.sq2 local.sq3 "Elite Squad" local.sq4 local.sq5 local.sq6
	}
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave elite squad spawned " + local.count + " at " + int(local.last_pos[0]) + " " + int(local.last_pos[1])) }
}end


//[310] extra trailing slots a4-a6 AFTER the label so pre-scaling callers keep working unchanged;
// player-scaled squads pass their extra members there.
coop_squad_monitor local.a1 local.a2 local.a3 local.label local.a4 local.a5 local.a6:{
	while( level.coop_officer_alive == 1 ){
		local.allDead = 1
		if( local.a1 != NULL && isAlive local.a1 ){ local.allDead = 0 }
		if( local.a2 != NULL && isAlive local.a2 ){ local.allDead = 0 }
		if( local.a3 != NULL && isAlive local.a3 ){ local.allDead = 0 }
		if( local.a4 != NULL && isAlive local.a4 ){ local.allDead = 0 }
		if( local.a5 != NULL && isAlive local.a5 ){ local.allDead = 0 }
		if( local.a6 != NULL && isAlive local.a6 ){ local.allDead = 0 }
		if( local.allDead == 1 ){ break }
		wait 2
	}
	if( level.coop_officer_alive == 0 ){ end }
	iprintlnbold (local.label + " eliminated.")
	// 70% chance the officer calls a fresh wave when a squad is wiped out -- max 2 such recalls
	if( level.coop_wave_recalls == NIL ){ level.coop_wave_recalls = 0 }
	if( level.coop_wave_recalls < 2 && randomint 10 < 7 ){
		level.coop_wave_recalls++
		iprintlnbold "Recon reports the Officer is calling another wave to replace his losses!"
		thread coop_reinf_call_wave_gated level.coop_officer
	}
}end


coop_elite_smoke_barrage local.pos:{
	local.j = 0
	while( local.j < 2 ){
		wait (10 + randomint 8)

		local.xoff = randomint 160 - 80
		local.yoff = randomint 160 - 80
		local.spos = local.pos
		local.spos[0] = local.pos[0] + local.xoff
		local.spos[1] = local.pos[1] + local.yoff

		local.pop = spawn "models/fx/M18_Smoke_GrenadeExplosion.tik"
		local.pop.origin = local.spos
		local.pop anim start
		local.pop notsolid

		local.cloud = spawn "models/emitters/tehao_thickSmoke.tik"
		local.cloud.origin = local.spos
		local.cloud anim start
		local.cloud notsolid

		wait 20
		if( local.cloud != NULL ){ local.cloud remove }

		local.j++
	}
}end


// Type 1: Wehrmacht Squad -- 3 infantry with mixed (working) weapons that hunt the players.
// Replaces the old MG42 nest (scrapped: the turret gunner floated and never fired).
coop_spawn_infantry_squad local.pos:{
	local.i = 0
	local.count = 0
	local.last_pos = local.pos
	local.s1 = NIL
	local.s2 = NIL
	local.s3 = NIL
	local.s4 = NIL
	local.s5 = NIL
	local.s6 = NIL
	//[310] player-scaled squad: 3 base + coop_officerSquadPer (def 1) per extra player, cap 6
