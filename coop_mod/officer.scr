			local.s.flags["coop_actorStopPainHandler"] = 1
			local.s.accuracy = 65
			local.s.leash = 4096
			local.s.enableEnemy = 1
			if( local.i == 0 ){
				local.s gun "mp40"
			} else if( local.i == 1 ){
				local.s gun "mauser kar 98k"
			} else {
				local.s gun "stg44"
			}
			exec coop_mod/officer.scr::coop_reinf_scale local.s	//[310] player-count health/accuracy
			local.s attackplayer
			local.s rendereffects "+coopboss"
			local.s.flags["coop_squadSlot"] = local.i
			waitthread coop_apply_personality local.s
			thread coop_wave_hunt local.s
			thread coop_wave_glow local.s
			if( local.i == 0 ){ local.s1 = local.s }
			else if( local.i == 1 ){ local.s2 = local.s }
			else if( local.i == 2 ){ local.s3 = local.s }
			else if( local.i == 3 ){ local.s4 = local.s }
			else if( local.i == 4 ){ local.s5 = local.s }
			else { local.s6 = local.s }
			local.count++
			local.last_pos = local.gnd
