}end


// DEPRECATED (scrapped) -- floated the gunner and never fired. Kept unreferenced; do not dispatch.
// Type 1: MG42 Nest -- real TurretGun + true MachineGunner state (turret AI fires at the gunner's enemy) + mobile spotter
coop_spawn_mg_team local.pos:{
	local.gnd = exec coop_mod/officer.scr::coop_find_ground local.pos
	if( local.gnd == NIL ){ local.gnd = local.pos }

	// Aim the emplacement at the nearest living player (turret still auto-tracks within its arc)
	local.yaw = 0
	if( level.coop_officer != NULL ){ local.yaw = level.coop_officer.angles[1] }
	local.np = NIL
	local.best_d = 999999
	local.pi = 1
	while( local.pi <= $player.size ){
		if( $player[local.pi] != NULL && isAlive $player[local.pi] ){
			local.d = vector_length( $player[local.pi].origin - local.gnd )
			if( local.d < local.best_d ){
				local.best_d = local.d
				local.np = $player[local.pi]
			}
		}
		local.pi++
	}
	if( local.np != NIL ){
		local.aim_ang = vector_toangles ( local.np.origin - local.gnd )
		local.yaw = local.aim_ang[1]
	}

	// Spawn the real MG42 emplacement
	local.turret = spawn "models/statweapons/mg42_gun.tik"
	local.turret.origin = local.gnd
	local.turret droptofloor
	local.turret.angles = (0 local.yaw 0)

	// Gunner -- true MachineGunner; engine holsters his weapon, snaps him onto the turret, turret fires at his enemy
	local.mg = spawn "models/human/german_waffenss_shutze.tik"
	local.mg.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.mg.origin = local.gnd
	local.mg.health = 150
	local.mg.flags["coop_actorStopPainHandler"] = 1
	local.mg.accuracy = 80
	local.mg.enableEnemy = 1
	local.mg type_idle "machinegunner"
	local.mg type_attack "machinegunner"
	local.mg type_disguise "machinegunner"
	local.mg type_grenade "machinegunner"
	local.mg turret local.turret
	local.mg rendereffects "+coopboss"
	local.mg forceactivate
	local.mg attackplayer
	thread coop_wave_glow local.mg

	// Spotter -- mobile mp40 guard so the nest is not a lone static target
	local.spot_pos = local.gnd + (64 0 0)
	local.spot_gnd = exec coop_mod/officer.scr::coop_find_ground local.spot_pos
	if( local.spot_gnd == NIL ){ local.spot_gnd = local.gnd }
	local.spot = spawn "models/human/german_waffenss_shutze.tik"
	local.spot.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.spot.origin = local.spot_gnd
	local.spot droptofloor
	local.spot.health = 120
	local.spot.flags["coop_actorStopPainHandler"] = 1
	local.spot.accuracy = 65
	local.spot.leash = 2048
	local.spot.enableEnemy = 1
	local.spot gun "mp40"
	local.spot attackplayer
	local.spot rendereffects "+coopboss"
	thread coop_wave_hunt local.spot
	thread coop_wave_glow local.spot

	thread coop_squad_monitor local.mg local.spot NIL "MG42 Nest"
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave MG42 nest spawned at " + int(local.gnd[0]) + " " + int(local.gnd[1])) }
}end


coop_spawn_sniper local.pos:{
	// Prefer spawning on a distant enemy deep in the map (far from players); fall back to a push from the officer
	local.sniper_pos = local.pos
	local.got_far = 0
	local.far = exec coop_mod/officer.scr::coop_far_spawner_anchor
	local.np = exec coop_mod/officer.scr::coop_nearest_player_pos
	// Per-map: when waves are forced to the reinf zone, the sniper spawns there too (sniper_pos
	// stays = local.pos, the reinf zone) - its distant-anchor logic lands it off-map on some maps.
	// Sniper-specific override: coop_officer_sniper_at_zone (NIL = follow waves_at_zone) lets a map
	// keep the sniper on its distant perch even when the other waves are zoned ("all except sniper").
	local.sniperAtZone = level.coop_officer_waves_at_zone
	if( level.coop_officer_sniper_at_zone != NIL ){ local.sniperAtZone = level.coop_officer_sniper_at_zone }
	if( local.sniperAtZone != 1 ){
		if( local.far != NIL ){
			if( local.np == NIL ){
				local.sniper_pos = local.far
				local.got_far = 1
			} else {
				if( vector_length( local.far - local.np ) > 1500 ){
					local.sniper_pos = local.far
					local.got_far = 1
				}
			}
		}
		if( local.got_far == 0 && level.coop_officer != NULL ){
			local.away = angles_toforward level.coop_officer.angles
			if( local.np != NIL ){
				local.away = level.coop_officer.origin - local.np
				local.away[2] = 0
				local.away = vector_normalize local.away
			}
			local.far_pos = level.coop_officer.origin + (local.away * 1200)
			local.far_gnd = exec coop_mod/officer.scr::coop_find_ground local.far_pos
			if( local.far_gnd != NIL ){ local.sniper_pos = local.far_gnd }
		}
	}
	local.gnd = exec coop_mod/officer.scr::coop_find_ground local.sniper_pos
	if( local.gnd == NIL ){
		local.gnd = exec coop_mod/officer.scr::coop_find_ground local.pos
	}
	if( local.gnd == NIL ){
		if(level.cMTE_coop_officer){ iprintlnbold "REINF: wave sniper - no ground, skipped" }
		end
	}
	local.snmodel = exec coop_mod/officer.scr::coop_model_for "sniper"
	local.sniper = spawn local.snmodel
	local.sniper.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.sniper.origin = local.gnd
	local.sniper droptofloor
	local.sniper.health = 120
	local.sniper.accuracy = 100
	local.sniper gun "mauser kar 98d sniper"
	local.sniper.mindist = 800
	local.sniper.maxdist = 3500
	local.sniper.leash = 6000
	local.sniper.noticescale = 100
	local.sniper.nosurprise = 1
	local.sniper.movedoneradius = 450
	local.sniper.enableEnemy = 1
	exec coop_mod/officer.scr::coop_reinf_scale local.sniper	//[310] player-count health (accuracy already 100 - no-op there)
	local.sniper forceactivate
	local.sniper attackplayer
	local.sniper rendereffects "+coopboss"
	thread coop_wave_glow local.sniper
	thread coop_sniper_approach local.sniper
	thread coop_squad_monitor local.sniper NIL NIL "Elite Sniper"
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave sniper spawned 1 at " + int(local.gnd[0]) + " " + int(local.gnd[1])) }
}end


// Moves the sniper to within sniping range of the nearest player (but not into close quarters), then holds and fires.
coop_sniper_approach local.sniper:{
	wait 0.5
	while( local.sniper != NULL && isAlive local.sniper && level.coop_officer_alive == 1 ){
		local.np = exec coop_mod/officer.scr::coop_nearest_player_pos
		if( local.np != NIL ){
			local.d = vector_length( local.np - local.sniper.origin )
			if( local.d > 1400 ){
				local.dir = local.np - local.sniper.origin
				local.dir[2] = 0
				local.dir = vector_normalize local.dir
				local.dest = local.np - (local.dir * 1100)
				local.dgnd = exec coop_mod/officer.scr::coop_find_ground local.dest
				if( local.dgnd != NIL ){
					local.sniper.movedoneradius = 256
					local.sniper forceactivate
					local.sniper runto local.dgnd
					local.sniper waittill movedone
				}
			}
			if( local.sniper != NULL && isAlive local.sniper ){ local.sniper attackplayer }
		}
		wait 3
	}
}end


// Returns the origin of the living German actor farthest from the officer (deep in the map), or NIL.
coop_far_enemy_anchor:{
	local.anchor = NIL
	local.far = 0
	if( level.coop_officer == NULL ){ end NIL }
	// Measure distance from the nearest PLAYER so reinforcements spawn well away from them
	local.ref = exec coop_mod/officer.scr::coop_nearest_player_pos
	if( local.ref == NIL ){ local.ref = level.coop_officer.origin }
	local.arr = level.coop_actorArray["german"]
	if( local.arr != NIL ){
		local.i = 1
		while( local.i <= local.arr.size ){
			local.e = local.arr[local.i]
			if( local.e != NULL && isAlive local.e ){
				local.d = vector_length( local.e.origin - local.ref )
				if( local.d > local.far ){
					local.far = local.d
					local.anchor = local.e.origin
				}
			}
			local.i++
		}
	}
	end local.anchor
}end


// Returns the map spawn point farthest from the nearest player.
// Priority: $enemyspawner > $alarmspawner > live actor (coop_far_enemy_anchor).
// Use this for dog/sniper spawns so they land at authored positions, not on top of live enemies.
coop_far_spawner_anchor:{
	local.ref = exec coop_mod/officer.scr::coop_nearest_player_pos
	if( local.ref == NIL && level.coop_officer != NULL ){ local.ref = level.coop_officer.origin }
	local.anchor = NIL
	local.best_d = 0

	// --- Try $enemyspawner ---
	if( $enemyspawner != NULL ){
		local.ns = $enemyspawner.size
		local.k = 1
		while( local.k <= local.ns ){
			local.s = $enemyspawner[local.k]
			if( local.s != NULL ){
				local.d = 9999
				if( local.ref != NIL ){ local.d = vector_length( local.s.origin - local.ref ) }
				if( local.d > local.best_d ){
					local.best_d = local.d
					local.anchor = local.s.origin
				}
			}
			local.k++
		}
	}

	// --- Try $alarmspawner ---
	if( local.anchor == NIL && $alarmspawner != NULL ){
		local.na = $alarmspawner.size
		local.k = 1
		while( local.k <= local.na ){
			local.s = $alarmspawner[local.k]
			if( local.s != NULL ){
				local.d = 9999
				if( local.ref != NIL ){ local.d = vector_length( local.s.origin - local.ref ) }
				if( local.d > local.best_d ){
					local.best_d = local.d
					local.anchor = local.s.origin
				}
			}
			local.k++
		}
	}

	// --- Fall back to farthest live actor ---
	if( local.anchor == NIL ){
		local.anchor = exec coop_mod/officer.scr::coop_far_enemy_anchor
	}

	end local.anchor
}end


coop_spawn_grenadiers local.pos:{
	local.i = 0
	local.count = 0
	local.last_pos = local.pos
	local.g1 = NIL
	local.g2 = NIL
	local.g3 = NIL
	local.g4 = NIL
	local.g5 = NIL
	local.g6 = NIL
	//[310] player-scaled squad: 2 base + coop_officerSquadPer (def 1) per extra player, cap 6
	local.nt = exec coop_mod/officer.scr::coop_reinf_count 2 "coop_officerSquadPer" 1 6
	while( local.i < local.nt ){
		local.gnd = exec coop_mod/officer.scr::coop_spread_pos local.pos local.i
		if( local.gnd != NIL ){
			local.gmodel = exec coop_mod/officer.scr::coop_model_for "grenadier"
			local.g = spawn local.gmodel
			local.g.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
			local.g.origin = local.gnd
			local.g droptofloor
			local.g.health = 100
			local.g.accuracy = 65
			local.g gun "mp40"
			local.g type_grenade "grenade"
			local.g.ammo_grenade = 5
			local.g.leash = 4096
			local.g.enableEnemy = 1
			exec coop_mod/officer.scr::coop_reinf_scale local.g	//[310] player-count health/accuracy
			local.g forceactivate
			local.g attackplayer
			local.g rendereffects "+coopboss"
			// hunt the players (actively push in from the reinf zone like other waves - leash 1536
			// was too short to reach a distant reinf zone, so they just stood) + scripted grenade lob
			thread coop_wave_glow local.g
			local.g.flags["coop_squadSlot"] = local.i
			waitthread coop_apply_personality local.g
			thread coop_wave_hunt local.g
			thread coop_grenade_lob_loop local.g
			if( local.i == 0 ){ local.g1 = local.g }
			else if( local.i == 1 ){ local.g2 = local.g }
			else if( local.i == 2 ){ local.g3 = local.g }
			else if( local.i == 3 ){ local.g4 = local.g }
			else if( local.i == 4 ){ local.g5 = local.g }
			else { local.g6 = local.g }
			local.count++
			local.last_pos = local.gnd
		}
		local.i++
	}
	if( local.count > 0 ){
		thread coop_squad_monitor local.g1 local.g2 local.g3 "Grenadier Squad" local.g4 local.g5 local.g6
	}
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave grenadiers spawned " + local.count + " at " + int(local.last_pos[0]) + " " + int(local.last_pos[1])) }
}end


// Returns local.center displaced by a random FLAT ring offset: radius uniform in
// [local.minr, local.maxr], random direction (angles_toforward - no sin/cos in MOHAA).
// Shared by the officer Stuka bomb stick and the artillery barrage so their impacts
// bracket an AREA around the aim point (area denial) instead of landing on it.
coop_strike_scatter local.center local.minr local.maxr:{
	local.ang = ( 0 0 0 )
	local.ang[1] = randomint 360
	local.dir = angles_toforward local.ang
	local.span = local.maxr - local.minr
	if( local.span < 1 ){ local.span = 1 }
	local.rad = local.minr + (randomint local.span)
	local.p = local.center + (vector_scale local.dir local.rad)
	end local.p
}end


// Type 4: Stuka flyover -- visible dive bomber via origin lerp + MG strafing + timed bomb
// NOTE: spawn ClassName "key" "value" keyvalue syntax is NOT valid in MOHAA script.
// All spawns use bare classname; properties set via assignment or command afterward.
// HZM coop - SHARED AERIAL BOMBING RUN (used by BOTH the player's binoc strike AND the officer's
// airstrike wave). A plane flies a BANKED, DIVING arc: in high+far, descends LOW over the target
// (nose-down), drops a stick of real falling bombs, then climbs away (nose-up). Attitude (pitch+yaw)
// follows the flight and it BANKS into the turn, so it reads like a real bomb run instead of a flat
// slide. The whole envelope (altitude + approach length) AUTO-SCALES from the map's $world.farplane so
// the plane stays INSIDE the fog/far-clip and is actually visible on EVERY map WITHOUT touching the fog.
// Origin-stepped (the proven mover; runtime flypath/SplinePath is a future upgrade - see [[plane_bomber_research]]).
//   local.target = ground impact point     local.fwd = flat approach dir (NIL = random)
//   local.strafe = 1 to add the MG strafe   local.model = plane .tik (NIL = Allied C-47)
//   local.leadin = seconds of AUDIBLE approach before the dive begins (NIL/0 = dive
//                  immediately, the old behavior). The plane spawns further out along the
//                  approach axis and cruises in with its engine loop running, so players
//                  HEAR it coming that long before the attack run (officer stuka passes
//                  8.2 -> first impact ~10.2s after the drone starts).
//   local.wide   = 1 = officer AREA-DENIAL scatter for the bomb stick (see coop_drop_bombs);
//                  NIL/0 = the tight player-called (binoc) stick, unchanged.
coop_air_bombing_run local.target local.fwd local.strafe local.model local.leadin local.wide:{
	if( local.target == NIL ){ end }
	if( local.model == NIL ){ local.model = "models/vehicles/p47fly.tik" }	// P-47 fighter-bomber - matches the mission's own bombing plane (global/bomber.scr default)
	if( local.leadin == NIL ){ local.leadin = 0 }
	if( local.wide == NIL ){ local.wide = 0 }
	if( local.fwd == NIL ){ local.fwd = angles_toforward ( 0 (randomint 360) 0 ) }
	local.fwd[2] = 0
	local.fwd = vector_normalize local.fwd
	local.fwdang = vector_toangles local.fwd
	local.side   = angles_toleft local.fwdang

	// --- per-map visible envelope from the farplane (fog end). 0/NIL = unlimited -> assume 8000. ---
	local.fp = $world.farplane
	if( local.fp == NIL ){ local.fp = 0 }
	local.fpeff = local.fp
	if( local.fpeff <= 0 ){ local.fpeff = 8000 }
	local.budget   = local.fpeff * 0.7
	local.alt      = local.budget * 0.45
	if( local.alt > 1100 ){ local.alt = 1100 }
	local.approach = local.budget * 0.55
	if( local.approach > 2600 ){ local.approach = 2600 }
	if( local.approach < 900 ){ local.approach = 900 }

	// --- ceiling clamp: never punch a real roof (a SURF_SKY hit overhead is fine - keep alt). ---
	local.upt = traced (local.target + (0 0 16)) (local.target + (0 0 4096))
	if( local.upt["fraction"] < 1.0 ){
		local.sf = local.upt["surfaceFlags"]
		if( local.sf == NIL ){ local.sf = 0 }
		local.q  = int( local.sf / 4 )
		local.hb = int( local.q / 2 )
		if( (local.q - (local.hb * 2)) != 1 ){
			local.room = (local.upt["fraction"] * 4096) - 96
			if( local.alt > local.room ){ local.alt = local.room }
		}
	}

	// --- no room for a visible pass (cramped interior) -> just deliver the bombs, skip the flyover ---
	if( local.alt < 250 ){
		if( local.leadin > 0 ){
			// no flyover possible, but the warning still has to arrive >=leadin early:
			// audible engine drone above the target for the whole lead-in, then the stick.
			// (loopsound needs a modeled entity to transmit -> fx/dummy, the glow pattern)
			local.warn = spawn script_model
			local.warn model "models/fx/dummy.tik"
			local.warn.origin = local.target + ( 0 0 200 )
			local.warn notsolid
			local.warn loopsound coop_stuka_engine
			wait local.leadin
			local.warn stoploopsound
			local.warn delete
		}
		thread coop_drop_bombs local.target local.fwd 700 local.wide
		end
	}

	local.lowalt = local.alt * 0.4		// how low it dives over the target
	local.bowamt = local.approach * 0.22	// lateral bow so the bank visibly reads

	local.faroff    = vector_scale local.fwd local.approach
	local.startp    = local.target - local.faroff
	local.startp[2] = local.target[2] + local.alt
	local.endp      = local.target + local.faroff
	local.endp[2]   = local.target[2] + local.alt
	local.span = local.endp - local.startp

	// Long audible approach leg (warning time): spawn further out along the approach
	// axis and cruise in for local.leadin seconds. Capped at 6000u so the entity stays
	// well inside server transmit range (the engine LOOPSOUND rides the entity state,
	// so the plane must transmit for players to hear the drone growing louder). Beyond
	// the farplane the plane is fog-culled anyway: heard first, then it emerges.
	local.legdist = 0
	if( local.leadin > 0 ){
		local.arcspeed = (local.approach * 2) / 3.55
		local.legdist = local.arcspeed * local.leadin
		if( local.legdist > 6000 ){ local.legdist = 6000 }
	}
	local.holdp = local.startp - (vector_scale local.fwd local.legdist)

	local.plane = spawn script_model
	if( local.plane == NULL ){ end }	//[user 08-02] entity-pool guard
	local.plane model local.model
	local.plane.origin = local.holdp
	local.plane.angles = local.fwdang
	local.plane notsolid
	if( local.strafe == 1 ){
		// looped so the drone runs the WHOLE approach+dive (one-shot ended too early);
		// stoploopsound at the end of the run already handles it
		local.plane loopsound coop_stuka_engine
	} else {
		local.plane loopsound coop_c47_approach
	}

	if( local.legdist > 0 ){
		local.legticks = int( local.leadin * 10 )
		if( local.legticks < 1 ){ local.legticks = 1 }
		local.legstep = vector_scale local.fwd (local.legdist / local.legticks)
		local.k = 0
		while( local.plane != NULL && local.k < local.legticks ){
			local.plane.origin = local.plane.origin + local.legstep
			wait 0.1
			local.k++
		}
		if( local.plane == NULL ){
			// plane vanished mid-approach: still deliver the (already warned) stick
			thread coop_drop_bombs local.target local.fwd local.lowalt local.wide
			end
		}
		local.plane.origin = local.startp
		// classic dive/flyby scream as the attack run begins (vanilla m1l3b strafing-run wav)
		local.plane playsound coop_stuka_dive
	}

	if( local.strafe == 1 ){ thread coop_stuka_mg_strafe local.plane local.target }
	// release the bomb stick once the plane is overhead (tied to its live position)
	thread coop_bombrun_release local.plane local.target local.fwd local.lowalt local.wide

	local.prevpos = NIL
	local.prevyaw = NIL
	local.i = 0
	while( local.plane != NULL && local.i <= 70 ){
		local.frac = local.i / 70.0
		local.u = (2 * local.frac) - 1
		if( local.u < 0 ){ local.u = 0 - local.u }
		local.dip = 1 - local.u			// 1 over the target, 0 at the ends (a shallow V dive)

		local.along = vector_scale local.span local.frac
		local.pos   = local.startp + local.along
		local.drop  = (local.alt - local.lowalt) * local.dip
		local.pos[2] = local.target[2] + local.alt - local.drop
		local.bowscale = local.bowamt * local.dip
		local.bow = vector_scale local.side local.bowscale
		local.pos = local.pos + local.bow

		if( local.prevpos != NIL ){
			local.vel = local.pos - local.prevpos
			local.ang = vector_toangles local.vel
			if( local.prevyaw != NIL ){
				local.dy = local.ang[1] - local.prevyaw
				if( local.dy > 180 ){ local.dy = local.dy - 360 }
				if( local.dy < (0 - 180) ){ local.dy = local.dy + 360 }
				local.roll = local.dy * 5		// bank INTO the turn
				if( local.roll > 35 ){ local.roll = 35 }
				if( local.roll < (0 - 35) ){ local.roll = 0 - 35 }
				local.ang[2] = 0 - local.roll
			}
			local.plane.angles = local.ang
			local.prevyaw = local.ang[1]
		}
		local.plane.origin = local.pos
		local.prevpos = local.pos
		wait 0.05
		local.i++
	}

	if( local.plane != NULL ){
		local.plane stoploopsound
		local.plane delete
	}
}end


// Officer (German) airstrike wave: a Stuka diving bomb run + MG strafe on a SEEN-OUTDOOR player.
// Thin wrapper over the shared coop_air_bombing_run (German plane + strafe). target_pos is the locked
// seen-outdoor position from coop_officer_visible_outdoor_player (never a player the officer can't see).
coop_stuka_attack local.target_pos:{
	//[user 2026-08-08] bug-1596 group B - defined in v1.2.1, never bumped.
	//"Not Today, Fritz" half one. Set on the CALL, not the impact: the feat is having been under
	//it, and a player who dies to the dive still had a Stuka dive happen on their map.
	level.coop_sawStuka = 1
	if( local.target_pos == NIL ){ end }
	local.fwd = angles_toforward level.coop_officer.angles
	//[209] 8.2s audible approach leg + 1 = officer area-denial bomb scatter. The engine drone
	//starts ~10.2s before the first impact (dive adds ~2s), per the 10s-warning requirement.
	// [user 2026-08-20] "we need to hear the plane coming at least 10 seconds before those bombs
	// hit, the sound should be pretty loud too as a warning". Was 8.2s of approach leg. The bombs
	// release once the plane is overhead, part-way through the dive, so the TOTAL warning is the
	// lead-in plus roughly half the dive - but 8.2 was short enough that players reported being
	// surprised. 12s puts the audible warning comfortably past 10 even if the dive is clipped
	// short by terrain. The drone alias was also made louder and longer-ranged (ubersound.scr).
	waitthread coop_air_bombing_run local.target_pos local.fwd 1 "models/vehicles/stuka_strafe.tik" 12 1
}end


coop_stuka_bomb_drop local.drop_pos:{
	local.snd = spawn script_origin
	local.snd.origin = local.drop_pos
	local.snd playsound coop_stuka_bomb

	wait 2

	local.emitter = spawn "models/emitters/mortar_dirt_dustcloud.tik"
	local.emitter.origin = local.drop_pos
	local.emitter anim start
	local.emitter notsolid
	radiusdamage local.drop_pos 300 350
	local.emitter playsound coop_stuka_hit

	wait 4
	local.emitter remove
	local.snd remove
}end


coop_stuka_mg_strafe local.stuka local.aim_pos:{
	if( local.stuka == NULL ){ end }

	local.aim = spawn script_origin
	local.aim.origin = local.aim_pos

	local.gun1 = spawn script_aimedstrafinggunfire
	local.gun1 attach local.stuka tag_barrel1
	local.gun1 aimtarget local.aim
	local.gun1 firedelay 0.15	// bug-1185: default 0.05 = 20 HE rounds/sec PER GUN. Unsurvivable.
	local.gun1 bulletspread 24 24
	local.gun1 tracerfreq 1
	local.gun1 bulletdamage 15
	local.gun1 on

	local.gun2 = spawn script_aimedstrafinggunfire
	local.gun2 attach local.stuka tag_barrel2
	local.gun2 aimtarget local.aim
	local.gun2 firedelay 0.15	// bug-1185: see gun1
	local.gun2 bulletspread 24 24
	local.gun2 tracerfreq 1
	local.gun2 bulletdamage 15
	local.gun2 on

	// HZM fix (bug-1172): "bulletdamage 15" above is dead code - ScriptSimpleStrafingGunfire's
	// ProjectileAttack() call (weaputils.cpp) never receives a damage parameter at all, so real
	// damage comes entirely from the fired projectile's own tik (defaults to
	// models/projectiles/stukaround.tik, a dive-bomber explosive round, at a ~20rd/sec/gun
	// fire rate with no script-exposed way to slow it). Vanilla uses this same
	// script_aimedstrafinggunfire pattern for a sweeping flyover with built-in cover; this coop
	// wave attack aimtarget-locks it directly onto the player's exact position for the full
	// duration, so the vanilla-tolerable rate become up to ~80 explosive impacts homed on one
	// spot. Cut burst length so a locked-on player has a real chance to break line of sight
	// instead of eating the whole barrage.
	wait 0.5

	local.gun1 off
	local.gun2 off
	local.gun1 remove
	local.gun2 remove
	local.aim remove
}end


// Type 5: Artillery barrage -- 3 staggered impacts around target.
// Returns the origin of the living player nearest the officer, or NIL if none.
coop_nearest_player_pos:{
	local.center = NIL
	local.best_d = 999999
	local.pi = 1
	while( local.pi <= $player.size ){
		if( $player[local.pi] != NULL && isAlive $player[local.pi] ){
			local.d = 0
			if( level.coop_officer != NULL ){
				local.d = vector_length( $player[local.pi].origin - level.coop_officer.origin )
			}
			if( local.d < local.best_d ){
				local.best_d = local.d
				local.center = $player[local.pi].origin
			}
		}
		local.pi++
	}
	end local.center
}end


// Returns the player entity the officer has direct LOS to, or the nearest player as fallback.
// Used for air-based attacks so they track the spotted player rather than always player 1.
coop_officer_visible_player:{
	local.nearest = NIL
	local.best_d = 999999
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL && isAlive local.p ){
			if( level.coop_officer != NULL && level.coop_officer cansee local.p ){
				end local.p
			}
			if( level.coop_officer != NULL ){
				local.d = vector_length( local.p.origin - level.coop_officer.origin )
				if( local.d < local.best_d ){
					local.best_d = local.d
					local.nearest = local.p
				}
			}
		}
		local.pi++
	}
	end local.nearest
}end


// Returns 1 if local.pos has open sky overhead (outdoors), 0 if a real ceiling is
// within 2048u. CRITICAL: on outdoor maps the up-trace HITS the sky brush (it is solid
// to traces), so a low fraction alone reads as "indoors" everywhere the skybox is below
// 2048u (e.g. m1l2a). So also check the hit surface for SURF_SKY (0x4) and treat a sky
// hit as outdoors. MOHAA has no bitwise AND -> test the 0x4 bit via int div/modulo
// (same trick as coop_wave_allowed): bit set <=> int(flags/4) is odd.
coop_hasOpenSky local.pos:{
	local.tr = traced (local.pos + (0 0 4)) (local.pos + (0 0 2048))
	if( local.tr["fraction"] >= 0.9 ){ end 1 }		// nothing close overhead -> outdoors
	local.sf = local.tr["surfaceFlags"]
	if( local.sf == NIL ){ local.sf = 0 }
	local.q = int( local.sf / 4 )
	local.half = int( local.q / 2 )
	if( (local.q - (local.half * 2)) == 1 ){ end 1 }	// hit the sky brush -> outdoors
	end 0
}end

// Returns a player the officer can SEE *and* who is OUTDOORS (open sky overhead), else NIL.
// NO nearest/last-resort fallback -- top-down strikes must never target a player the
// officer can't see, and never fire when everyone seen is under a roof.
coop_officer_visible_outdoor_player:{
	local.found = NIL
	if( level.coop_officer == NULL ){ end local.found }
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL && isAlive local.p ){
			if( level.coop_officer cansee local.p ){
				if( (exec coop_mod/officer.scr::coop_hasOpenSky local.p.origin) == 1 ){
					local.found = local.p
					end local.found
				}
			}
		}
		local.pi++
	}
	end local.found
}end


coop_artillery_barrage local.target_pos:{
	//[user 2026-08-08] bug-1596 group B - defined in v1.2.1, never bumped.
	//"Not Today, Fritz" half two.
	level.coop_sawArty = 1
	// target_pos is the locked SEEN-OUTDOOR player position chosen by the reinforcement
	// gate. The barrage lands on that spot (with per-shell scatter) and does NOT re-track to
	// the nearest player, so it can never chase a player the officer can't see / who ducked
	// indoors. Bail if somehow nil -- never strike blind.
	if( local.target_pos == NIL ){ end }
	//[209] 10s WARNING before the first impact (user: hear the strike coming way earlier).
	//Incoming call sounds at the aim point immediately, repeats at T+8, first shell lands at
	//T+10. Follow-up shells keep the tighter 2s whistle rhythm so the barrage stays scary.
	local.snd = spawn script_origin
	local.snd.origin = local.target_pos
	local.snd playsound coop_arty_incoming
	wait 8
	if( local.snd == NULL ){ end }
	local.snd playsound coop_arty_incoming
	wait 2
	local.i = 0
	while( local.i < 3 ){
		//[209] impact scattered in a 250-700u ring around the locked target (was a +/-130
		//box - effectively pinpoint); ground-snapped so shells never burst mid-air on slopes
		local.hit = exec coop_mod/officer.scr::coop_strike_scatter local.target_pos 250 700
		local.gnd = exec coop_mod/officer.scr::coop_find_ground local.hit
		if( local.gnd != NIL ){ local.hit = local.gnd }
		local.snd.origin = local.hit
		local.snd playsound coop_arty_hit
		local.emitter = spawn "models/emitters/mortar_dirt_dustcloud.tik"
		local.emitter.origin = local.hit
		local.emitter anim start
		local.emitter notsolid
		radiusdamage local.hit 200 300
		wait 4
		local.emitter remove
		local.i++
		if( local.i < 3 ){
			// telegraph the next shell at the locked aim point
			local.snd.origin = local.target_pos
			local.snd playsound coop_arty_incoming
			wait 2
		}
	}
	local.snd remove
}end


// Type 6: AT Team -- panzerschreck gunner + mp40 loader (both normal AI)
coop_spawn_at_team local.spawn_pos:{
	local.gnd1 = exec coop_mod/officer.scr::coop_find_ground local.spawn_pos
	if( local.gnd1 == NIL ){ local.gnd1 = local.spawn_pos }
	local.off2 = local.spawn_pos + (50 0 0)
	local.gnd2 = exec coop_mod/officer.scr::coop_find_ground local.off2
	if( local.gnd2 == NIL ){ local.gnd2 = local.gnd1 }

	// AT Gunner -- panzerschreck; engages the player via normal AI
	local.atgmodel = exec coop_mod/officer.scr::coop_model_for "at"
	local.gunner = spawn local.atgmodel
	local.gunner.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.gunner.origin = local.gnd1
	local.gunner droptofloor
	local.gunner health 150
	local.gunner.accuracy = 70
	local.gunner.leash = 4096
	local.gunner.enableEnemy = 1
	local.gunner gun "panzerschrek"
	local.gunner.flags["coop_actorStopPainHandler"] = 1
	exec coop_mod/officer.scr::coop_reinf_scale local.gunner	//[310] player-count health/accuracy
	local.gunner rendereffects "+coopboss"
	local.gunner forceactivate
	thread coop_wave_glow local.gunner
	local.gunner attackplayer
	thread coop_at_rocket_loop local.gunner

	// Loader -- mp40 guard, normal AI
	local.atlmodel = exec coop_mod/officer.scr::coop_model_for "infantry"
	local.loader = spawn local.atlmodel
	local.loader.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.loader.origin = local.gnd2
	local.loader droptofloor
	local.loader health 150
	local.loader.accuracy = 65
	local.loader.leash = 4096
	local.loader.enableEnemy = 1
	local.loader gun "mp40"
	local.loader.flags["coop_actorStopPainHandler"] = 1
	exec coop_mod/officer.scr::coop_reinf_scale local.loader	//[310] player-count health/accuracy
	local.loader attackplayer
	local.loader rendereffects "+coopboss"
	thread coop_wave_glow local.loader
	local.loader.flags["coop_squadSlot"] = 3
	waitthread coop_apply_personality local.loader
	thread coop_wave_hunt local.loader

	thread coop_squad_monitor local.gunner local.loader NIL "AT Team"
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave AT team spawned at " + int(local.gnd1[0]) + " " + int(local.gnd1[1])) }
}end


// Drives the panzerschreck gunner's fire: a script_aimedstrafinggunfire that launches real rocket
// projectiles at the nearest player. Scripted actor weapon-fire is impossible (no fire command),
// so the gunfire entity supplies the rockets. Gated on line-of-sight + min range to avoid self-blast.
coop_at_rocket_loop local.gunner:{
	wait 1
	if( local.gunner == NULL || !isAlive local.gunner ){ end }
	local.gun = spawn script_aimedstrafinggunfire
	local.gun.origin = local.gunner.origin + (0 0 48)
	local.gun projectile "models/projectiles/panzerschreckshell.tik"
	local.gun firedelay 30
	local.gun bulletspread 12 12
	local.gun tracerfreq 0
	while( local.gunner != NULL && isAlive local.gunner && level.coop_officer_alive == 1 ){
		local.gun.origin = local.gunner.origin + (0 0 48)
		local.target = NIL
		local.best_d = 999999
		local.pi = 1
		while( local.pi <= $player.size ){
			if( $player[local.pi] != NULL && isAlive $player[local.pi] ){
				local.d = vector_length( $player[local.pi].origin - local.gunner.origin )
				if( local.d < local.best_d ){
					local.best_d = local.d
					local.target = $player[local.pi]
				}
			}
			local.pi++
		}
		local.canfire = 0
		if( local.target != NIL && local.best_d > 400 ){
			if( local.gunner cansee local.target ){ local.canfire = 1 }
		}
		if( local.canfire == 1 ){
			local.gun aimtarget local.target
			local.gun off
			local.gunner playsound coop_panzerschreck_fire
			local.gun fire
			wait 4
		} else {
			local.gun off
			wait 1
		}
	}
	local.gun off
	local.gun remove
}end


// Scripted grenade lob for grenadiers -- launches real grenade projectiles at the nearest visible
// player so grenades reliably go off (autonomous AI grenade-throwing is unreliable here).
coop_grenade_lob_loop local.thrower:{
	wait 1
	if( local.thrower == NULL || !isAlive local.thrower ){ end }
	local.gun = spawn script_aimedstrafinggunfire
	local.gun.origin = local.thrower.origin + (0 0 48)
	local.gun projectile "models/projectiles/steilhandgranate_ai.tik"
	local.gun firedelay 30
	local.gun bulletspread 30 30
	local.gun tracerfreq 0
	local.tcount = 3
	while( local.thrower != NULL && isAlive local.thrower && level.coop_officer_alive == 1 ){
		local.gun.origin = local.thrower.origin + (0 0 48)
		local.target = NIL
		local.best_d = 999999
		local.pi = 1
		while( local.pi <= $player.size ){
			if( $player[local.pi] != NULL && isAlive $player[local.pi] ){
				local.d = vector_length( $player[local.pi].origin - local.thrower.origin )
				if( local.d < local.best_d ){
					local.best_d = local.d
					local.target = $player[local.pi]
				}
			}
			local.pi++
		}
		local.canthrow = 0
		if( local.target != NIL && local.best_d > 400 && local.best_d < 1400 ){
			if( local.thrower cansee local.target ){ local.canthrow = 1 }
		}
		if( local.canthrow == 1 ){
			local.tcount++
			if( local.tcount >= 4 ){
				// every 4th throw is a smoke grenade -- guaranteed visible cloud at the target
				local.tcount = 0
				local.spos = local.target.origin
				local.pop = spawn "models/fx/M18_Smoke_GrenadeExplosion.tik"
				local.pop.origin = local.spos
				local.pop anim start
				local.pop notsolid
				local.cloud = spawn "models/emitters/tehao_thickSmoke.tik"
				local.cloud.origin = local.spos
				local.cloud anim start
				local.cloud notsolid
				thread coop_smoke_cleanup local.pop local.cloud
				wait 5
			} else {
				local.gun aimtarget local.target
				local.gun off
				local.gun fire
				wait 5
			}
		} else {
			local.gun off
			wait 1
		}
	}
	local.gun off
	local.gun remove
}end


// Removes a thrown smoke cloud after it has lingered.
coop_smoke_cleanup local.pop local.cloud:{
	wait 16
	if( local.pop != NULL ){ local.pop remove }
	if( local.cloud != NULL ){ local.cloud remove }
}end


// Type 7: Attack Dogs -- 2 German shepherds + handler
coop_spawn_dogs local.spawn_pos:{
	// Dogs spawn well away from the players at authored map positions, then hunt in
	local.np = exec coop_mod/officer.scr::coop_nearest_player_pos
	local.far = exec coop_mod/officer.scr::coop_far_spawner_anchor
	// Per-map: when waves are forced to the reinf zone, the dogs spawn there too (spawn_pos stays
	// = the passed reinf zone) - their distant-anchor logic lands them off-map on some maps.
	if( level.coop_officer_waves_at_zone != 1 ){
		if( local.np != NIL ){
			if( local.far != NIL ){
				if( vector_length( local.far - local.np ) > vector_length( local.spawn_pos - local.np ) ){ local.spawn_pos = local.far }
			}
			// guarantee distance from the nearest player so they never drop on top of you
			local.cd = vector_length( local.spawn_pos - local.np )
			if( local.cd < 1400 ){
				local.away = local.spawn_pos - local.np
				local.away[2] = 0
				if( vector_length( local.away ) < 1 ){ local.away = (1 0 0) }
				local.away = vector_normalize local.away
				local.try = local.np + (local.away * 1600)
				local.try_gnd = exec coop_mod/officer.scr::coop_find_ground local.try
				if( local.try_gnd != NIL ){ local.spawn_pos = local.try_gnd }
			}
		} else {
			if( local.far != NIL ){ local.spawn_pos = local.far }
		}
	}
	local.dog_pos1 = exec coop_mod/officer.scr::coop_find_ground local.spawn_pos
	if( local.dog_pos1 == NIL ){ local.dog_pos1 = local.spawn_pos }
	local.off2 = local.spawn_pos + (128 0 0)
	local.dog_pos2 = exec coop_mod/officer.scr::coop_find_ground local.off2
	if( local.dog_pos2 == NIL ){ local.dog_pos2 = local.spawn_pos }
	local.off3 = local.spawn_pos + ( -128 0 0)
	local.handler_pos = exec coop_mod/officer.scr::coop_find_ground local.off3
	if( local.handler_pos == NIL ){ local.handler_pos = local.spawn_pos }

	//[310] player-scaled pack: 2 base dogs + coop_officerSquadPer (def 1) per extra player, cap 5
	local.dn = exec coop_mod/officer.scr::coop_reinf_count 2 "coop_officerSquadPer" 1 5

	local.dog1 = spawn "models/animal/german_shepherd.tik"
	local.dog1.origin = local.dog_pos1
	local.dog1 droptofloor
	local.dog1.health = 150
	exec coop_mod/officer.scr::coop_reinf_scale local.dog1	//[310] player-count health
	local.dog1.leash = 4096
	local.dog1.enableEnemy = 1
	local.dog1 rendereffects "+coopboss"
	local.dog1 forceactivate
	local.dog1 attackplayer
	thread coop_wave_glow local.dog1
	thread coop_dog_hunt local.dog1

	// stagger the second dog so the pair don't run in lockstep and clip into each other
	//[310] solo fields a single dog (local.dn 1) - skip the authored second
	local.dog2 = NIL
	if( local.dn >= 2 ){
		wait 3
		if( level.coop_officer_alive != 1 ){ end }
		local.dog2 = spawn "models/animal/german_shepherd.tik"
		local.dog2.origin = local.dog_pos2
		local.dog2 droptofloor
		local.dog2.health = 150
		exec coop_mod/officer.scr::coop_reinf_scale local.dog2	//[310] player-count health
		local.dog2.leash = 4096
		local.dog2.enableEnemy = 1
		local.dog2 rendereffects "+coopboss"
		local.dog2 forceactivate
		local.dog2 attackplayer
		thread coop_wave_glow local.dog2
		thread coop_dog_hunt local.dog2
	}

	local.hmodel = exec coop_mod/officer.scr::coop_model_for "handler"
	local.handler = spawn local.hmodel
	local.handler.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
	local.handler.origin = local.handler_pos
	local.handler droptofloor
	local.handler health 150
	local.handler gun "mp40"
	local.handler.flags["coop_actorStopPainHandler"] = 1	//[310] was set as an entity VAR (typo) - never actually opted out
	exec coop_mod/officer.scr::coop_reinf_scale local.handler	//[310] player-count health/accuracy
	local.handler rendereffects "+coopboss"
	thread coop_wave_glow local.handler
	thread coop_wave_hunt local.handler

	//[310] extra pack dogs for bigger lobbies (slots 3-5), staggered like dog2 so they don't lockstep
	local.dog3 = NIL
	local.dog4 = NIL
	local.dog5 = NIL
	local.di = 3
	while( local.di <= local.dn ){
		wait 2
		if( level.coop_officer_alive != 1 ){ break }
		local.dpx = exec coop_mod/officer.scr::coop_spread_pos local.spawn_pos local.di
		local.dx = spawn "models/animal/german_shepherd.tik"
		local.dx.origin = local.dpx
		local.dx droptofloor
		local.dx.health = 150
		exec coop_mod/officer.scr::coop_reinf_scale local.dx
		local.dx.leash = 4096
		local.dx.enableEnemy = 1
		local.dx rendereffects "+coopboss"
		local.dx forceactivate
		local.dx attackplayer
		thread coop_wave_glow local.dx
		thread coop_dog_hunt local.dx
		if( local.di == 3 ){ local.dog3 = local.dx }
		else if( local.di == 4 ){ local.dog4 = local.dx }
		else { local.dog5 = local.dx }
		local.di++
	}

	thread coop_squad_monitor local.dog1 local.dog2 local.handler "Attack Dogs" local.dog3 local.dog4 local.dog5
	if(level.cMTE_coop_officer){ iprintlnbold ("REINF: wave Dogs spawned at " + int(local.dog_pos1[0]) + " " + int(local.dog_pos1[1])) }
}end


coop_dog_hunt local.dog:{
	wait 0.5
	if( local.dog == NULL || !isAlive local.dog ){ end }
	//[209] dogs join the wave roster too - paratroopers should shoot incoming attack dogs
	if( level.coop_wave_count == NIL ){ level.coop_wave_count = 0 }
	level.coop_wave_count++
	level.coop_wave_actors[level.coop_wave_count] = local.dog
	local.dog.movedoneradius = 200
	local.bark_cd = 0
	while( local.dog != NULL && isAlive local.dog ){
		// actively charge the nearest player (was attackplayer-only, so distant dogs just barked)
		local.dog exec coop_mod/replace.scr::runtoClosestVisible
		local.dog waittill movedone
		if( local.dog == NULL || !isAlive local.dog ){ end }
		local.dog attackplayer
		if( local.bark_cd <= 0 ){
			local.dog playsound dog_bark
			local.bark_cd = 3 + (randomint 3)
		} else {
			local.bark_cd--
		}
		wait 1
	}
}end


//====================================================================
// ME2 - OFFICER-DEATH SURVIVOR REACTION (coop_deathReact, default off). Killing the officer visibly
// galvanizes nearby germans: most turn aggressive + push the players (REVENGE), a minority fall back to
// regroup (PANIC - only when the tactical-retreat stack is on). Reuses the proven aggr-advance + re-engaging
// tactical-retreat primitives; NEVER the despawn-flee (that would strand an "eliminate all enemies" gate).
// Radius-scoped + concurrency-capped so it's a reaction, not a whole-map stampede.
//====================================================================
coop_officer_death_reaction local.dead_pos:{
	if( getcvar "coop_deathReact" != "1" ){ end }
	wait 0.3
	local.arr = level.coop_actorArray["german"]
	if( local.arr == NIL ){ end }
	local.radius = 1200
	local.r2 = local.radius * local.radius
	local.cap = 10
	local.nearby = 0
	local.panic = 0
	local.revenge = 0
	for( local.i = 1; local.i <= local.arr.size; local.i++ ){
		local.e = local.arr[local.i]
		if( local.e == NIL || local.e == NULL ){ continue }
		if( !isAlive local.e ){ continue }
		if( level.coop_officer != NULL && local.e == level.coop_officer ){ continue }
		if( local.e.flags["coop_actorStopPainHandler"] == 1 ){ continue }
		if( local.e.flags["coop_limping"] == 1 ){ continue }
		if( local.e.flags["coop_role"] == "prone" ){ continue }
		if( local.e.turret != NULL ){ continue }
		local.dx = local.e.origin[0] - local.dead_pos[0]
		local.dy = local.e.origin[1] - local.dead_pos[1]
		local.d2 = ( local.dx * local.dx ) + ( local.dy * local.dy )
		if( local.d2 > local.r2 ){ continue }
		if( local.nearby >= local.cap ){ break }
		local.nearby = local.nearby + 1
		if( ( randomint 100 ) < 30 && getcvar "coop_retreatEnable" == "1" ){
			// PANIC: force the re-engaging tactical retreat (arm the pain-streak, clear the cooldown)
			local.e.coop_painStreak = 9
			local.e.coop_retreatNext = 0
			thread coop_mod/wounded.scr::coop_checkTacticalRetreat local.e
			local.panic = local.panic + 1
		} else {
			// REVENGE: turn aggressive + push the players (aimaneuver's aggr-advance carries the move)
			local.e.flags["coop_role"] = "aggr"
			local.e.leash = 4096
			local.e.nosurprise = 1
			local.e attackplayer
			local.e forceactivate
			local.revenge = local.revenge + 1
		}
	}
	if( getcvar "coop_aiBehav" != "0" && getcvar "coop_aiBehav" != "" ){
		println( "^~^~^ DEATHREACT nearby=" + local.nearby + " panic=" + local.panic + " revenge=" + local.revenge )
	}
}end

coop_officer_death_monitor local.officer:{
	local.officer waittill death
	level.coop_officer_alive = 0
	level.coop_reinforcements_active = 0
	// [302] HZM XP - officer kill (150 killer / 50 squad) + heal-denied bonus if he died
	// inside the retreat-to-heal window (level.coop_xp_heal_pending)
	thread coop_mod/xp.scr::xp_officer_killed local.officer
	// [303] HZM CHALLENGES - officer-kill challenge progress
	thread coop_mod/challenges.scr::chal_officer_killed local.officer
	// [303] "Mein Kampf" feat: the officer was blown up by his OWN reinforcements - an EXPLOSIVE
	// death (grenade=14 / rocket=16) dealt by a non-player AI (not himself). Bait his men into
	// nading you next to him and their splash finishes him.
	if( local.officer.fact != NIL && local.officer.fact != NULL ){
		//[user 07-17] bug-723 (audit): the attacker must be one of HIS OWN men (axis) - an allied
		// paratrooper's grenade/rocket finishing the officer is not "his own reinforcements".
		if( ( local.officer.fact.meansofdeath == 14 || local.officer.fact.meansofdeath == 16 ) && local.officer.fact.attacker != NULL && local.officer.fact.attacker != local.officer && local.officer.fact.attacker.classname != "Player" && local.officer.fact.attacker.team == "german" ){
			thread coop_mod/challenges.scr::chal_mein_kampf
		}
	}
	forcemusic "success"
	iprintlnbold "The officer has been eliminated!"
	iprintlnbold "Plant explosives on the radio to stop reinforcements permanently!"
	thread coop_mod/objectives.scr::coop_obj_officer_done
	local.officer playsound coop_radio_off
	local.dead_pos = local.officer.origin
	thread coop_officer_death_drops local.dead_pos
	thread coop_officer_death_reaction local.dead_pos	// ME2: nearby survivors panic/revenge (coop_deathReact)
	thread coop_replacement_officer_watch
	thread coop_radio_bomb_enable
	// HZM COOP: per-map avenging battalion (set in officer_positions.scr). Spawns at a fixed
	// point and rushes the players to engage. Off (NIL) on maps that don't set it.
	if( level.coop_officer_death_battalion_pos != NIL ){
		local.bmsg = "Enemy reinforcements are storming in to avenge the officer!"
		if( level.coop_officer_death_battalion_hold == 1 ){ local.bmsg = "The officer's men have dug in nearby - watch for an ambush." }
		thread coop_spawn_death_battalion level.coop_officer_death_battalion_pos level.coop_officer_death_battalion_ang local.bmsg level.coop_officer_death_battalion_hold 0
	}
	// optional SECOND death battalion (per-map). Seed 1 = wider scatter ring so it doesn't stack on the first.
	if( level.coop_officer_death_battalion_pos2 != NIL ){
		thread coop_spawn_death_battalion level.coop_officer_death_battalion_pos2 level.coop_officer_death_battalion_ang2 "" level.coop_officer_death_battalion_hold 1
	}
	// optional THIRD / FOURTH death battalions (per-map). Distinct seeds keep their scatter rings apart.
	if( level.coop_officer_death_battalion_pos3 != NIL ){
		thread coop_spawn_death_battalion level.coop_officer_death_battalion_pos3 level.coop_officer_death_battalion_ang3 "" level.coop_officer_death_battalion_hold 2
	}
	if( level.coop_officer_death_battalion_pos4 != NIL ){
		thread coop_spawn_death_battalion level.coop_officer_death_battalion_pos4 level.coop_officer_death_battalion_ang4 "" level.coop_officer_death_battalion_hold 3
	}
	if( level.coop_officer_death_battalion_pos5 != NIL ){
		thread coop_spawn_death_battalion level.coop_officer_death_battalion_pos5 level.coop_officer_death_battalion_ang5 "" level.coop_officer_death_battalion_hold 4
	}
}end


// HZM COOP DYNAMIC COMBAT MUSIC: when the officer can SEE a player, smoothly segue the current
// map track into a RANDOM Frontline combat track; when he loses sight for a few seconds, segue
// back to the base track. Started at officer spawn; reverts + ends when the officer dies. Only
// runs where the base track is known (level.coop_music_track) so it can revert cleanly.
// HZM COOP: the officer mutters 1-2 German campaign lines while he's still idle (before he has
// spotted any player). First-time only - it runs once at spawn; the 2nd line is skipped the moment
// he can see a player. Positional on the officer (heard when you're near him).
coop_officer_idle_talk:{
	if( level.coop_officer == NULL ){ end }
	wait 0.75
	if( level.coop_officer == NULL || !isAlive level.coop_officer ){ end }
	local.isnd = "coop_officer_idle" + ((randomint 4) + 1)
	level.coop_officer playsound local.isnd
	wait 4
	if( level.coop_officer == NULL || !isAlive level.coop_officer ){ end }
	// only a second line if he STILL hasn't seen a player
	if( !(exec coop_mod/replace.scr::player_anyCanBeSeen level.coop_officer 3000) ){
		local.isnd = "coop_officer_idle" + ((randomint 4) + 1)
		level.coop_officer playsound local.isnd
	}
}end


coop_officer_combat_music:{
	if( level.coop_officer == NULL ){ end }
	if( level.coop_music_track == NIL ){ end }	// base track unknown -> don't swap (can't revert)

	// Combat-music pool ("roll of the dice"). Add Manor House Rally once its file is in
	// sound/music/  (level.coop_combat_tracks[3] = "sound/music/<file>.mp3"; bump the count to 3).
	level.coop_combat_tracks[1] = "sound/music/Sturmgeist.mp3"
	level.coop_combat_tracks[2] = "sound/music/Halftrack.mp3"
	level.coop_combat_tracks[3] = "sound/music/ManorHouseRally.mp3"
	level.coop_combat_track_count = 3
	level.coop_combatmusic_active = 0

	while( level.coop_officer != NULL && level.coop_officer_alive == 1 ){
		local.sees = 0
		if( exec coop_mod/replace.scr::player_anyCanBeSeen level.coop_officer 3000 ){ local.sees = 1 }
		if( local.sees == 1 ){
			level.coop_officer_lastseen = level.time
			if( level.coop_combatmusic_active == 0 ){
				level.coop_combatmusic_active = 1
				level.coop_music_saved = level.coop_music_track	// base track to revert to
				local.pick = randomint( level.coop_combat_track_count ) + 1
				waitthread coop_mod/replace.scr::tmsegue level.coop_combat_tracks[local.pick]
				level.coop_officer_combat_track = level.coop_combat_tracks[local.pick]	//[user 07-17] for the fade-out's map-owns-music check
				level.coop_officer_musicvol = 1						//[user 07-17] tracked so death/fade paths start from the REAL volume
			}
		} else if( level.coop_combatmusic_active == 1 ){
			if( (level.time - level.coop_officer_lastseen) > 6 ){
				//[user 07-17] lost sight: SLOW 15s interruptible fade into the base track (was an abrupt
				//0.5s dip). If he re-spots a player mid-fade the boss track swells back up instead.
				waitthread coop_officer_music_fadeout
			}
		}
		wait 0.5
	}

	// officer dead/gone -> FADE the officer combat music OUT cleanly (user request) instead of the quick
	// snap-back. Long fade to silence, a beat of quiet as the boss falls, then ease the map's base track
	// back in. (tmvolume is whitelisted on this build, so tmfade works.)
	if( level.coop_combatmusic_active == 1 ){
		level.coop_combatmusic_active = 0
		//[user 07-17] start the death-fade from the TRACKED volume (a sight-loss fade may already be
		//partway down); tmfade from a hardcoded 1 would snap the volume back up for a beat.
		local.dv = level.coop_officer_musicvol
		if( local.dv == NIL ){ local.dv = 1 }
		waitthread coop_mod/replace.scr::tmfade local.dv 0 3	// fade the officer track down to silence (~3s)
		waitthread coop_mod/replace.scr::tmstop			// then stop it
		wait 2							// quiet beat after the officer is killed
		// HZM coop - ONLY restore the pre-fight ambient track if the MAP hasn't started its own post-officer-death
		// music. Many maps play e.g. mus_<map>_DeadOfficer via tmstart the instant the officer dies; since tmstart
		// now records level.coop_music_track, a mismatch here means the map owns the music -> restarting the old
		// track on top of it was the "music loops over and over after the officer dies" bug. Defer to the map.
		//[user 2026-08-21, bug-2023] "music never really kicks back on after the officer music
		//finishes." It could not: this guard compared coop_music_track against coop_music_SAVED
		//(the pre-fight base track) - but our own tmsegue routes through tmstartloop, which
		//records coop_music_track = THE COMBAT TRACK. The two differ BY CONSTRUCTION, so the
		//restore was unreachable on the death path, every time. The map-owns-music intent needs
		//the comparison the sight-loss fadeout already uses: is the LAST-STARTED track still OUR
		//combat track? Yes -> nothing else took over -> restore. No -> a map script started its
		//own post-death music -> defer. (tmstop clears coop_musicCommand, not coop_music_track,
		//so the value survives the fade/stop above.)
		if( level.coop_music_saved != NIL && level.coop_music_track == level.coop_officer_combat_track ){
			waitthread coop_mod/replace.scr::tmvolume 0
			waitthread coop_mod/replace.scr::tmstartloop level.coop_music_saved
			waitthread coop_mod/replace.scr::tmfade 0 1 1.5	// ease the base/ambient track back in
		}
	}
}end


//[user 07-17] SIGHT-LOSS MUSIC FADE: ramp the boss track down over ~15s in small steps, watching for
// a re-spot every step. Re-spotted -> swell the SAME boss track back to full (2s) and stay in combat
// (returns with combatmusic still active). Fade completes -> switch to the saved base track and ease it
// in (~3s), clearing the combat flag. Officer dies mid-fade -> bail; the death path picks up from the
// tracked volume (coop_officer_musicvol). One music channel = fade-through, no true crossfade.
//=========================================================================
coop_officer_music_fadeout:{
//=========================================================================
	local.steps = 30					// 30 x 0.5s = ~15 seconds
	local.vol = level.coop_officer_musicvol
	if( local.vol == NIL ){ local.vol = 1 }
	local.step = local.vol / local.steps
	local.i = 0
	while( local.i < local.steps ){
		if( level.coop_officer == NULL || level.coop_officer_alive != 1 ){ end }	// death path takes over
		if( exec coop_mod/replace.scr::player_anyCanBeSeen level.coop_officer 3000 ){
			// re-spotted mid-fade: swell the boss track back up and stay in combat
			level.coop_officer_lastseen = level.time
			waitthread coop_mod/replace.scr::tmfade local.vol 1 2
			level.coop_officer_musicvol = 1
			end
		}
		local.vol = local.vol - local.step
		if( local.vol < 0 ){ local.vol = 0 }
		level.coop_officer_musicvol = local.vol
		waitthread coop_mod/replace.scr::tmvolume local.vol
		wait 0.5
	}

	// fade complete: hand the channel back. If the MAP started its own track mid-fight (coop_music_track
	// no longer the combat track we started), defer to the map - just restore the volume for its track.
	level.coop_combatmusic_active = 0
	if( level.coop_music_saved != NIL && level.coop_music_track == level.coop_officer_combat_track ){
		waitthread coop_mod/replace.scr::tmvolume 0
		waitthread coop_mod/replace.scr::tmstartloop level.coop_music_saved
		waitthread coop_mod/replace.scr::tmfade 0 1 3	// ease the level's own track back in
	} else {
		waitthread coop_mod/replace.scr::tmfade 0 1 1.5	// map owns the music now - just bring volume back
	}
	level.coop_officer_musicvol = 1
}end


// HZM COOP: an avenging battalion that spawns at a FIXED point AFTER the officer dies and
// pushes toward the players to engage (replaces the vanilla spotlight-alarm door spawns that
// don't fire reliably in coop). Unlike coop_spawn_battalion (which protects the live officer),
// this is NOT gated on coop_officer_alive -- the officer is already dead.
coop_spawn_death_battalion local.pos local.ang local.msg local.hold local.seed:{
	if( local.pos == NIL ){ end }
	if( local.ang == NIL ){ local.ang = 0 }
	if( local.seed == NIL ){ local.seed = 0 }	// scatter offset: a 2nd battalion at the same spot uses a wider ring so it doesn't stack on the 1st
	// local.hold==1 -> they GUARD the spawn area and engage on sight (ambush), no rush.
	wait 2
	if( local.msg != NIL && local.msg != "" ){ iprintlnbold local.msg }
	level.coop_death_battalion_count = 0
	//[310] player-scaled: 10 base + coop_officerBattalionPer (def 3) per extra player
	local.dbn = exec coop_mod/officer.scr::coop_reinf_count 10 "coop_officerBattalionPer" 3 22
	local.n = 0
	while( local.n < local.dbn ){
		local.idx = local.n + (local.seed * 10)
		local.sgnd = exec coop_mod/officer.scr::coop_spread_pos local.pos local.idx

		local.bmodel = exec coop_mod/officer.scr::coop_model_for "infantry"
		local.b = spawn local.bmodel
		local.b.coop_xpClass = "reinf"	// [302] HZM XP - kill-class bonus tag
		local.b.origin = local.sgnd
		local.b droptofloor
		local.b.angles = ( 0 local.ang 0 )
		local.b.health = 120
		local.b.flags["coop_actorStopPainHandler"] = 1
		local.b.accuracy = 70
		if( local.hold == 1 ){ local.b.leash = 768 } else { local.b.leash = 4096 }	// hold = stay near spawn
		local.b.enableEnemy = 1
		local.b german

		// Mixed loadout
		if( local.n == 0 || local.n == 1 ){
			local.b gun "stg44"
		} else if( local.n == 2 || local.n == 3 || local.n == 4 ){
			local.b gun "mp40"
		} else if( local.n == 5 ){
			local.b gun "shotgun"
		} else {
			local.b gun "mauser kar 98k"
		}

		exec coop_mod/officer.scr::coop_reinf_scale local.b	//[310] player-count health/accuracy
		local.b rendereffects "+coopboss"
		local.b forceactivate
		thread coop_wave_glow local.b
		local.b.flags["coop_squadSlot"] = local.n
		if( local.hold == 1 ){
			// dug-in ambush: seek cover but STAY near the spawn (keep the tight 768 leash). Tag it so
			// the hurt manager (coop_reinf_brain) still covers it (canteen + fall-back-to-cover).
			local.b type_attack "cover"
			local.b.flags["coop_role"] = "cover"
			local.b.flags["coop_personality_set"] = 1
			thread coop_idle_patrol local.b
		} else {
			// RUSH / objective wave: force a pure PUSH role -- NO cover/flank/prone roll (those make
			// them hang back at range; user wants objective waves to inevitably push in). The march
			// drives them toward the players unopposed by a cover think. Still tagged coop_personality_set
			// so the hurt manager (coop_reinf_brain) can fall them back to cover + canteen if badly hurt.
			local.b.flags["coop_role"] = "aggr"
			local.b.nosurprise = 1
			local.b.flags["coop_personality_set"] = 1
		}
		// hold: enableEnemy + forceactivate alone makes them guard and engage on SIGHT (no march).
		// else: actively push toward the players.
		if( local.hold != 1 ){ thread coop_death_battalion_march local.b }
		local.n++
	}
}end


// HZM coop - IDLE LIVELINESS for dug-in (hold) death-battalion troopers: a native small-radius PATROL so
// they pace + scan instead of standing brain-dead until shot. type_idle "patrol" controls only the IDLE
// think - their type_attack "cover" still governs COMBAT, and the engine auto-switches idle->attack the
// instant they spot a player (Think_Patrol -> CheckForThinkStateTransition), so this NEVER weakens their
// reaction. A single script_origin node is relocated within a small radius of their post each cycle; the
// engine drives + interrupts the movement (NOT a scripted runto), so it's combat-safe. lookaroundangle
// widens the native head-scan (#3, "look around"). Combat-safe + reliable.
coop_idle_patrol local.actor:{
	wait ( 1 + (randomfloat 3) )		// settle after spawn + desync the squad
	if( local.actor == NULL || !isAlive local.actor ){ end }
	local.home = local.actor.origin
	local.node = spawn script_origin
	local.node.origin = local.home
	local.actor.coop_patnode = local.node
	local.actor type_idle "patrol"
	local.actor lookaroundangle 120		// wide head-scan while idle/patrolling (engine default is 45)
	while( local.actor != NULL && isAlive local.actor ){
		if( local.actor.enemy == NULL ){	// only re-task while idle; combat (type_attack cover) takes over otherwise
			local.ang = ( 0 0 0 )
			local.ang[1] = randomint 360
			local.dir = angles_toforward local.ang
			local.rad = 64 + (randomint 160)	// small radius (64..224u) - they pace their post, don't wander off
			local.dest = local.home + (vector_scale local.dir local.rad)
			local.gnd = waitthread coop_mod/officer.scr::coop_find_ground local.dest
			if( local.gnd != NIL ){ local.node.origin = local.gnd } else { local.node.origin = local.dest }
			local.actor patrolpath local.node
		}
		wait ( 4 + (randomfloat 5) )		// re-task every ~4-9s (walk to node, scan, then a new point)
	}
	if( local.node != NULL ){ local.node remove }
}end


// One avenging/assault trooper for a RUSH (hold=0) battalion or objective wave: INEVITABLY push toward
// the players. Even cover-role troops that hang back briefly get re-issued a runto so they close the
// distance (user: objective waves that hang back must push in). Poll + re-issue (never waittill movedone
// - pain hang). Dispersed by squad slot so they don't blob onto one point.
coop_death_battalion_march local.actor:{
	wait 0.5
	if( local.actor == NULL || !isAlive local.actor ){ end }
	// STORM IN. The default attack think is "turret" (stand still + shoot) - THAT is why these objective
	// troops hung back at the shed and only trickled in. Switch them to the native "runandshoot" think
	// (advance toward the enemy WHILE firing, then settle into cover/turret once close - actor_runandshoot.cpp).
	// High leash so they path across the whole map; nosurprise so they don't freeze on first contact.
	local.actor.leash = 8192
	local.actor.nosurprise = 1
	local.actor type_attack "runandshoot"
	local.actor forceactivate
	local.actor attackplayer
	local.actor.coop_lastpos = local.actor.origin
	local.slot = local.actor.flags["coop_squadSlot"]
	if( local.slot == NIL ){ local.slot = randomint 6 }
	// per-trooper jittered approach vector (used only by the anti-stuck nudge so they fan out, not conga)
	local.offang = ( 0 0 0 )
	local.offang[1] = (local.slot * 60) + ((randomint 50) - 25)
	local.offdir = angles_toforward local.offang
	local.lat = 180 + (randomint 220)
	// WATCHDOG: let runandshoot drive the advance; only step in when a trooper has clearly WEDGED (made
	// almost no progress since the last check) AND is still far - then nudge it toward the nearest player
	// (wall-safe / unstick) and hand control straight back to runandshoot.
	while( local.actor != NULL && isAlive local.actor ){
		wait ( 2.5 + (randomfloat 1.0) )
		if( local.actor == NULL || !isAlive local.actor ){ end }
		local.moved = vector_length( local.actor.origin - local.actor.coop_lastpos )
		local.actor.coop_lastpos = local.actor.origin
		if( local.moved < 40 ){
			local.np = waitthread coop_mod/replace.scr::player_closestTargetable local.actor
			if( local.np != NULL ){
				local.nd = vector_length( local.actor.origin - local.np.origin )
				if( local.nd > 220 ){
					waitthread coop_push_toward local.actor local.np local.offdir local.lat
					local.actor type_attack "runandshoot"	// restore advance-fire after the runto
					local.actor attackplayer
				}
			}
		}
	}
}end


coop_radio_init local.pos:{
	// No lateral offset - pos is confirmed navigable (actor origin); trace only for floor height
	local.table_gnd = exec coop_mod/officer.scr::coop_find_ground local.pos
	if( local.table_gnd == NIL ){ local.table_gnd = local.pos }
	local.table = spawn script_model
	local.table model "models/furniture/cardtable.tik"
	local.table.origin = local.table_gnd
	local.table droptofloor
	local.table notsolid
	level.coop_radio_table = local.table
	local.radio = spawn script_model
	//[user 2026-08-15, bug-1816] PUBLISH THE RADIO. This spawned the model and then dropped the
	//reference on the floor - level.coop_radio was read in a dozen places and assigned in NONE, so
	//it was NIL for the whole map. Every consumer guards on `!= NIL && != NULL` and therefore did
	//nothing, silently:
	//  * coop_radio_bomb_enable ends at its first line, so after the officer dies there is no red
	//    pulse marker and no trigger_use - the player is told "plant explosives on the radio" and
	//    given nothing to plant on. That is the reported symptom.
	//  * the officer's own retreat-to-radio and the bodyguard-at-radio positioning (this file at
	//    :704, :723, :870, :1095) never ran either.
	//  * coop_radio_bomb_destroy reads level.coop_radio to blow it up, so the objective could not
	//    have completed even if a charge had somehow been planted.
	//The destroy path already sets it back to NULL, which is what makes the omission obvious in
	//hindsight: the clear was written, the assign was not.
	level.coop_radio = local.radio
	local.radio model "models/miscobj/radio_military.tik"
	local.radio.origin = local.table_gnd + (26 0 50)	//[user 2026-08-07] Occasional German traffic over the set. Rebuilt after the first version
	//flooded the console - three separate faults, all mine:
	//  1. den_scripted_M3L1_* aliases are DEFINED but their wavs are in no pak, so every line was
	//     "Can't read sound file". Now uses coop_av_de_* - our own shipped German VO.
	//  2. playsound_wait needs the alias length registered in coop_mod/sound.scr or it warns
	//     "length of NIL" every call. Plain playsound needs no registry.
	//  3. playsound_wait BLOCKS on sounddone, which never arrives for a sound that failed to load -
	//     that is what collapsed the 25-65s spacing into a flood. Plain playsound cannot stall.
	//Plus a single-instance guard: coop_radio_init runs per officer spawn, so every wave was
	//stacking another chatter thread on top of the last.
	thread coop_radio_chatter
	//premise, not just the wiring" miss as the flak turret and the cannonsmoke spawn.
	// Radio cannot be destroyed by gunfire - must use planted explosive after officer dies

	// HZM COOP: optional healing canteen beside the radio, enabled PER-MAP via
	// level.coop_officer_player_canteen (set in officer_positions.scr; default off). Used on
	// maps where the officer ends up far from any placed medkit/canteen. item_25_healthbox.tik
	// is a functional, RESPAWNING Health pickup (classname Health + coop itemhandler).
	// NOTE: this also becomes the officer's nearest "health post" - coop_officer_medkit_retreat
	// scans for the nearest classname Health entity - so he can heal here too (to full, scripted;
	// the kit's amount is irrelevant). That's intended.
	if( level.coop_officer_player_canteen == 1 ){
		// A functional, respawning medkit on the FLOOR so players can heal during the officer
		// fight (the boss can be far from the map's placed medkits). It's a plain classname
		// Health item on the ground - reachable floor origin - so the officer's heal-retreat
		// treats it exactly like any other map medkit (no crate, no elevation/solidity issues).
		// Position from per-map level.coop_officer_canteen_pos (officer_positions.scr); falls
		// back to beside the radio table if unset.
		local.mpos = level.coop_officer_canteen_pos
		if( local.mpos == NIL ){ local.mpos = local.table_gnd + (0 48 0) }
		local.medkit = spawn "models/items/item_50_healthbox.tik"
		if( local.medkit != NULL ){
			local.medkit.origin = local.mpos
			local.medkit droptofloor
			local.medkit show
			local.medkit triggerable
			level.coop_officer_canteen = local.medkit
		}
	}
}end


// Boss healthbar SCRAPPED per user (2026-06-24) -- the on-screen bar looked bad; will
// revisit with a different approach later. Stub kept so the spawn-time
// `thread coop_officer_hp_logger` call stays valid. No HUD draw, no HP screen spam.
coop_officer_hp_logger local.officer:{
	// intentionally empty
}end


coop_officer_marker:{
	// (Red test glow removed -- the overhead eagle icon marks the officer now.)
}end


// === OFFICER DEATH REWARDS ===

// Spawns smoke grenade pickup + binoculars trigger_use at officer death position.
coop_officer_death_drops local.dead_pos:{
	wait 0.5
	// Per-map feature toggles: paradrop (smoke) and binoculars reward can each be disabled.
	// Defaults (both 1) keep AA behavior: officer drops both rewards.
	local.do_para = 1
	if( level.coop_feature_paradrop == 0 ){ local.do_para = 0 }
	// HZM COOP: per-map disable of the officer's SMOKE reward ONLY (the paradrop SYSTEM stays
	// active so a tutorial/placed smoke still works). m1l2a sets this 0 - smoke is taught at the
	// hostage tutorial instead, so the officer shouldn't also drop one.
	//[user 2026-08-17] the gate is verifiably in the shipped pk3 and the drop fired anyway, so print
	//what the flag actually holds at death. Unconditional - this has to answer in one run.
	if( level.coop_officer_smoke_drop == 0 ){ local.do_para = 0 }
	local.do_binoc = 1
	if( level.coop_feature_binoc == 0 ){ local.do_binoc = 0 }

	if( local.do_para == 1 && local.do_binoc == 1 ){
		iprintlnbold "The officer dropped a Signal Smoke Grenade and Binoculars!"
	} else if( local.do_para == 1 ){
		iprintlnbold "The officer dropped a Signal Smoke Grenade!"
	} else if( local.do_binoc == 1 ){
		iprintlnbold "The officer dropped a pair of Binoculars!"
	}

	if( local.do_para == 1 ){
		// Smoke grenade - offset to the left so it doesn't stack with binoculars
		local.smoke_pos = local.dead_pos + (60 0 0)
		// Visible smoke model + a touch trigger that GIVES the weapon via "player item"
		// (the clean Sentient::giveItem path). We deliberately do NOT spawn the smoke as a
		// world Weapon the player walks onto: that routes through the engine's
		// Weapon::PickupWeapon grenade-class special-case, which strips the player's
		// existing grenade-class weapon (the German Stielhandgranate). Giving it like the
		// binoculars avoids that path entirely. See coop_smoke_reward_pickup below.
		local.smoke_vis = spawn script_model
		local.smoke_vis model "models/weapons/coop_smoke_grenade.tik"
		local.smoke_vis.origin = local.smoke_pos
		local.smoke_vis notsolid
		local.smoke_vis rendereffects "+fullbright"
		// trigger_USE (press Use to pick up), like the binoculars - not a walk-over trigger_multiple
		local.smoke_trig = spawn trigger_use
		local.smoke_trig.origin = local.smoke_pos
		local.smoke_trig solid
		local.smoke_trig setsize ( -16 -16 0) (16 16 48)
		thread coop_smoke_reward_pickup local.smoke_trig local.smoke_vis
		// Slight yellow glow so the pickup object is easy to spot (no smoke emitted).
		local.smoke_glow = spawn script_model
		local.smoke_glow model "models/fx/dummy.tik"
		local.smoke_glow.origin = local.smoke_pos + (0 0 8)
		local.smoke_glow light (1 0.9 0.2)
		local.smoke_glow lightRadius 150
		local.smoke_glow lightOn
		local.smoke_glow notsolid
		level.coop_smoke_beacon = local.smoke_glow
	}

	if( local.do_binoc == 1 ){
		// Binoculars - visible pickup model + press Use to equip
		local.binoc_pos = local.dead_pos + (0 -60 0)
		local.binoc_vis = spawn script_model
		local.binoc_vis model "models/items/binoculars.tik"
		local.binoc_vis.origin = local.binoc_pos
		local.binoc_vis notsolid
		local.binoc_vis rendereffects "+fullbright"
		local.binoc = spawn trigger_use
		local.binoc.origin = local.binoc_pos
		local.binoc solid
		local.binoc setsize ( -12 -12 0) (12 12 40)
		thread coop_spawn_binoc_glow local.binoc_pos
		thread coop_binoc_wait_pickup local.binoc local.binoc_vis
	}
}end


// Fired when a player presses Use on the smoke pickup trigger (trigger_use, like the binoculars).
//
// ROOT CAUSE of the "German grenades vanish" bug:
// The Signal Smoke shares the engine grenade weapon_class (weapontype
// "grenade") with the German Stielhandgranate. When the smoke was spawned as a
// world Weapon the player walked onto, the engine picked it up through
// Weapon::PickupWeapon (weapon.cpp). In MP gametypes that path has a
// grenade-class special-case (the "hasclass = false" block) that forces a new
// grenade pickup AND drives the engine's grenade weapon_class reselection,
// which dropped the player's OTHER grenade-class weapon (the Stielhandgranate)
// and its "grenade" ammo. Vanilla M18 + American frags avoid this because they
// are GIVEN at spawn via Sentient::giveItem, not auto-picked-up mid-game.
//
// FIX: give the smoke the same clean way the binoculars are given -- a touch
// trigger that runs "player item models/weapons/coop_smoke_grenade.tik"
// (Sentient::giveItem). That never enters Weapon::PickupWeapon's grenade-class
// branch, so no grenade-slot reselection is forced and the German
// Stielhandgranate + its grenade ammo are preserved. The smoke still enters the
// inventory as a throwable grenade-class weapon, so it can be equipped and
// thrown exactly like a vanilla M18, and its SmokeGrenade projectile still
// fires the engine paradrop hook (weaputils.cpp -> paradrop.scr smokeDropZone).
coop_smoke_reward_pickup local.trig local.vis:{
	local.trig waittill trigger
	local.player = parm.other
	if( local.player == NULL || local.player.classname != "Player" ){ end }
	// Defensive one-shot guard scoped to THIS trigger (so it never blocks a
	// separate smoke reward elsewhere on the map). We remove the trigger right
	// after, so it cannot re-fire.
	if( local.trig == NULL || local.trig.flags["coop_smoke_taken"] == 1 ){ end }
	local.trig.flags["coop_smoke_taken"] = 1
	local.trig remove
	if( local.vis != NULL ){ local.vis delete }
	local.player item models/weapons/coop_smoke_grenade.tik
	level.coop_paradrop_armed = 1
	level.coop_smoke_player = local.player
	// Remove the locator beacon now that it's been found.
	if( level.coop_smoke_beacon != NULL ){ level.coop_smoke_beacon delete }
	iprintlnbold (local.player.netname + " picked up the Signal Smoke!")
	iprintlnbold "Signal Smoke ready! Equip grenades and throw - Allied paradrop falls where it hits!"
	thread coop_smoke_hud_show
	thread coop_smoke_owner_watch local.player	// drop it again if this owner dies before throwing it
}end


// Fired when a player presses Use on the binoculars trigger.
// Gives the real binoculars weapon so it can be equipped and fired.
coop_binoc_wait_pickup local.binoc local.binoc_vis:{
	local.binoc waittill trigger
	local.player = parm.other
	if( local.player == NULL || local.binoc == NULL ){ end }
	if( local.player.classname != "Player" ){ end }
	// Block if someone already holds it. A binoc DROPPED by a dead owner sets given=0 (see
	// coop_binoc_owner_watch), so this re-pickup passes through.
	if( level.coop_binoc_given == 1 ){
		local.binoc remove
		end
	}
	if( local.binoc_vis != NULL ){ local.binoc_vis delete }
	local.binoc remove
	if( level.coop_binoc_beacon != NULL ){ level.coop_binoc_beacon delete }	// remove the red under-glow
	// First-ever pickup grants 3 strikes; a re-pickup (dropped, carried over) keeps the remaining
	// count - coop_binoc_uses is a global that persists, so only initialize it when still NIL.
	local.firstPickup = 0
	if( level.coop_binoc_uses == NIL ){
		local.firstPickup = 1
		level.coop_binoc_uses = 3
	}
	level.coop_binoc_given = 1
	level.coop_binoc_owner = local.player
	local.player item weapons/coop_binoculars.tik
	if( local.firstPickup == 1 ){
		iprintlnbold (local.player.netname + " picked up Binoculars!")
		// Per-map tutorial is an INDEXED array of short lines (iprintlnbold has no word-wrap).
		if( level.coop_binoc_tutorial_msg[1] != NIL ){
			local.tl = 1
			while( level.coop_binoc_tutorial_msg[local.tl] != NIL ){
				iprintlnbold level.coop_binoc_tutorial_msg[local.tl]
				local.tl++
			}
		} else {
			iprintlnbold "Equip binoculars from pistol slot, aim and fire [LMB] to call bombing runs! (3 strikes)"
		}
	} else {
		iprintlnbold (local.player.netname + " recovered the Binoculars! (" + level.coop_binoc_uses + " strikes left)")
	}
	// Support checks in: "Give me a target / Awaiting coordinates, over." (heard by ALL players)
	thread coop_radio_all "coop_radio_standby"
	thread coop_binoc_update_hud local.player
	thread coop_binoc_owner_watch local.player	// drop them again if this owner dies with strikes left
}end


// Removes a head-attached faction marker the moment the actor dies (detach_at_death
// only detaches it, leaving it floating - this removes it cleanly).
// Spawn a free-floating billboard marker and keep it parked in WORLD space directly
// above the actor's head every tick, deleting it when the actor dies. This replaces
// attachmodel-to-"Bip01 Head": attachmodel applies its offset in the head bone's LOCAL
// frame (attach_use_angles=true, entity.cpp:3750), and that bone's axes aren't world-up,
// so the marker sat off to the side. A world-space follow is position-exact and lets the
// TIKI's own scale (0.8) define size independent of any bone quirk.
coop_track_marker local.actor local.mdl:{
	if( local.actor == NULL ){ end }
	local.mk = spawn script_model
	local.mk model local.mdl
	local.mk notsolid
	local.mk.origin = local.actor.origin + (0 0 80)
	// Hold position above the head until the actor dies (or is freed).
	while( local.actor != NULL && isAlive local.actor ){
		local.mk.origin = local.actor.origin + (0 0 80)
		wait 0.05
	}
	if( local.mk != NULL ){ local.mk delete }
}end


// Plays a radio-chatter alias on EVERY player so all coop players hear shared radio comms
// (radio is "in your ear" - played on each player so each hears it at full volume).
coop_radio_all local.alias:{
	// HZM coop - radio framing: a short squelch/static burst leads every radio call (batch-2 asset)
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){ $player[local.i] playsound coop_radio_static }
		local.i++
	}
	wait 0.35
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){ $player[local.i] playsound local.alias }
		local.i++
	}
}end

// Called by the engine hook in weapon.cpp when the binoculars fire.
// local.player = shooter, local.target = world hit point from aim trace.
binoculars_fired local.player local.target:{
	if( level.coop_binoc_uses == NIL ){ end }
	if( level.coop_binoc_uses <= 0 ){ end }
	// 10s cooldown between strikes. The C++ fire hook bypasses the weapon's
	// firedelay bookkeeping, so enforce the gap here (silent - no countdown).
	if( level.coop_binoc_laststrike != NIL && (level.time - level.coop_binoc_laststrike) < 10 ){ end }
	// Sky check on the TARGET (not the player) so a doorway shot is correctly blocked.
	// Uses coop_hasOpenSky, which treats a SURF_SKY hit as outdoors -- a plain up-trace
	// hits the skybox brush and falsely reads "indoors" everywhere on outdoor maps.
	// coop_binoc_skyCheck 0 = allow strikes ANYWHERE (skip the open-sky requirement). Handy on bridge / urban
	// maps like t1l2 where most aim points have structure (bridge deck, roofs) overhead so the honest trace
	// correctly reports "no clear sky" - set it 0 there to bomb freely.
	if( getcvar "coop_binoc_skyCheck" != "0" && (exec coop_mod/officer.scr::coop_hasOpenSky local.target) != 1 ){
		thread coop_radio_all "coop_radio_standby"
		iprintlnbold "Negative - no clear sky above target coordinates. Strike request denied."
		end
	}
	level.coop_binoc_laststrike = level.time
	// [user 08-07] radiusdamage (what the bomb blast uses) hardcodes its attacker to `world` at
	// the ENGINE level (scriptthread.cpp EventRadiusDamage) - there is no script-side way to make
	// an air-strike kill attribute to the calling player through the normal kill-credit pipeline.
	// Record who/where/when here instead; aihandler.scr::addKillToPlayer checks this window for
	// any death NOT already attributed to a player (see xp.scr::xp_airstrike_kill).
	level.coop_airstrike_caller = local.player
	level.coop_airstrike_pos = local.target
	level.coop_airstrike_time = level.time
	// CONFIRMED (target accepted, opposite of the denial above): all players hear the call-in.
	thread coop_radio_all "coop_radio_airstrike_req"
	thread coop_mod/xp.scr::xp_support_call local.player "bombing"	// [302] HZM XP - called in a strike
	thread coop_mod/challenges.scr::chal_support_call local.player "airstrike"	// [303] HZM CHALLENGES - air-strike task
	level.coop_binoc_uses = level.coop_binoc_uses - 1
	if( level.coop_binoc_uses > 0 ){
		iprintlnbold ("Fire mission requested... (" + level.coop_binoc_uses + " strikes remaining)")
		thread coop_binoc_update_hud local.player
	} else {
		iprintlnbold "Final fire mission requested... Bombing Run expended."
		thread coop_binoc_update_hud local.player
		// Unequip + remove the Bombing Run weapon shortly after the final shot fires.
		thread coop_binoc_remove_now local.player
	}
	// The whole cinematic (radio exchange -> plane run-in -> bombs) is sequenced so the
	// voice lines never overlap and the bombs land only after the plane is overhead.
	thread coop_bombing_run_sequence local.target
}end


// Bombing-run cinematic, sequenced so nothing overlaps:
//   request VO -> (pause) -> HQ confirmation VO -> (pause) -> plane runs in -> bombs fall.
coop_bombing_run_sequence local.target:{
	// Red smoke marks the target the instant it's called (planesmokeplumered = base Pak0).
	local.marker = spawn "models/emitters/planesmokeplumered.tik"
	local.marker.origin = local.target
	local.marker anim start
	local.marker notsolid

	// 1) The fire-mission request call-in is now played at the CONFIRM moment (binoculars_fired),
	//    so all players hear it the instant the target is accepted. Wait out that ~6.3s clip plus
	//    a natural pause before HQ replies (timing unchanged so bombs still land on cue).
	wait 7.5

	// 2) HQ radioman's confirmation back over the radio (all players). Let it play out.
	local.rp = 1
	while( local.rp <= $player.size ){
		if( $player[local.rp] != NULL ){
			$player[local.rp] playsound coop_radio_static
			$player[local.rp] playsound coop_radio_airstrike_resp
		}
		local.rp++
	}
	wait 3.5

	// 3) The C-47 runs in on a banked, diving arc and drops the stick (the shared bombing-run system).
	//    Altitude/approach auto-scale from the map farplane so it stays inside the fog (fog preserved)
	//    and is visible on every map. Allied plane, no MG strafe (strafe=0).
	local.fwd = angles_toforward ( 0 (randomint 360) 0 )
	// [user 2026-08-20] this call passed NO lead-in, so it defaulted to 0 and the player-called
	// strike arrived with no audible approach whatsoever - the bombs simply appeared. Shorter
	// than the German Stuka lead-in on purpose: this one is friendly and the caller already knows
	// it is coming, so the warning exists for everyone ELSE on the team rather than as a threat
	// cue, and a long delay would just make calling it feel unresponsive.
	waitthread coop_air_bombing_run local.target local.fwd 0 "models/vehicles/p47fly.tik" 5	// P-47 - same plane this mission's own bombing run uses

	if( local.marker != NULL ){ local.marker delete }
}end


// Waits until the bombing-run plane is roughly overhead the target, then releases the
// bomb stick. Range-gated off the plane's live position (like bomber.scr::bombdrop).
//[2026-08-21] local.wide was MISSING from this parameter list while officer.scr:2817 passed it
//as a fifth argument, so it was silently dropped here and then arrived NIL in coop_drop_bombs -
//meaning the officer AREA-DENIAL spread below has never once run on the normal flight path. The
//two secondary paths pass it correctly, which is exactly why it survived unnoticed.
coop_bombrun_release local.plane local.center local.fwd local.alt local.wide:{
	// Release the instant the plane CROSSES the target along the flight axis (project the flat
	// plane->target vector onto fwd). Radial-distance detection was wrong with the new banked run:
	// the lateral bow means the plane is offset sideways at overhead and never gets within a small
	// radial threshold, so bombs dropped only after the plane was deleted. Axis-projection is robust
	// regardless of the bow: 'ahead' goes from -approach (run-in) up through 0 (over target) to +.
	local.go = 0
	while( local.plane != NULL && local.go == 0 ){
		local.hd = local.plane.origin - local.center
		local.hd[2] = 0
		local.ahead = (local.hd[0] * local.fwd[0]) + (local.hd[1] * local.fwd[1])
		if( local.ahead >= 0 ){ local.go = 1 }
		wait 0.05
	}
	thread coop_drop_bombs local.center local.fwd local.alt local.wide
}end


// Walks a stick of real falling bombs along the plane's heading across the target.
coop_drop_bombs local.center local.fwd local.alt local.wide:{
	local.i = 0
	while( local.i < 8 ){
		if( local.wide == 1 ){
			//[209] officer AREA-DENIAL stick: each bomb lands in a 120-700u ring around the
			//aim point (the tight 130u line below read as laser-guided against players)
			local.gx = exec coop_mod/officer.scr::coop_strike_scatter local.center 120 700
		} else {
			//player-called (binoc) stick: unchanged tight line along the approach
			local.offset = vector_scale local.fwd ((local.i * 130) - 450)
			local.gx = local.center + local.offset
			local.gx[0] = local.gx[0] + (randomint 120) - 60
			local.gx[1] = local.gx[1] + (randomint 120) - 60
		}
		local.gnd = exec coop_mod/officer.scr::coop_find_ground local.gx
		if( local.gnd == NIL ){ local.gnd = local.gx }
		thread coop_one_bomb local.gx local.gnd local.alt
		wait 0.14
		local.i++
	}
	// One short-lived scorched crater at the aim point after the whole stick lands (NOT per-bomb).
	thread coop_bomb_aftermath local.center
}end


// One visible bomb: a us_bomb model falls from plane altitude, then explodes on impact.
coop_one_bomb local.airpos local.gnd local.alt:{
	local.b = spawn script_model
	//[user 08-02] NULL-GUARD the spawn. The player bombing run allocates ~22 entities in
	//~2s (8 bombs + 8 blasts + smoke + 3 fires + 2 debris), the densest burst allocator in
	//the mod, against maxentities 2048 == MAX_GENTITIES. When the pool is exhausted `spawn`
	//returns NULL and the very next line dereferenced it. bug-927's root cause was exactly
	//this shape (Entity::attach with a NULL parent).
	if( local.b == NULL ){ end }
	local.b model "models/ammo/us_bomb.tik"
	local.start = local.airpos
	local.start[2] = local.gnd[2] + local.alt
	local.b.origin = local.start
	local.b notsolid
	local.b playsound coop_stuka_bomb
	// Fall by stepping origin straight down (moveto no-ops on script_models here).
	local.bfull = local.gnd - local.start
	local.bdist = vector_length local.bfull
	if( local.bdist < 1 ){ local.bdist = 1 }
	local.bstep = 1900 * 0.05
	local.bdelta = vector_scale local.bfull (local.bstep / local.bdist)
	local.btrav = 0
	while( local.b != NULL && local.btrav < local.bdist ){
		local.b.origin = local.b.origin + local.bdelta
		local.btrav = local.btrav + local.bstep
		wait 0.05
	}
	if( local.b != NULL ){ local.b delete }
	// Impact blast + varied detonation sound.
	local.blast = spawn "models/emitters/explosion_bombwall.tik"
	if( local.blast == NULL ){ end }	//[user 08-02] see note above
	local.blast.origin = local.gnd
	local.blast anim start
	local.blast notsolid
	local.sndroll = randomint 3
	if( local.sndroll == 0 ){
		local.blast playsound explo_large
	} else if( local.sndroll == 1 ){
		local.blast playsound explo_medium
	} else {
		local.blast playsound explo_close
	}
	radiusdamage local.gnd 600 900
}end


// === COOP BOMBING-RUN AFTERMATH ===
// After a bombing-run stick finishes (player binoc strike OR officer airstrike), leave a brief
// scorched crater at the aim point: ONE lingering smoke column, a few ground fires that burn any
// player who lingers in them, and a couple of dirt-debris puffs. Everything self-cleans after a
// random 7-10s so nothing accumulates (perf: at most 1 smoke + 3 fires + 2 debris per strike).
// All FX are notsolid; TIKs (linger_smoke/firegood/explosion_bombdirt) are stock, verified present.
coop_bomb_aftermath local.center:{
	if( local.center == NIL ){ end }
	local.life = 7 + randomfloat 3
	local.deadline = level.time + local.life
	local.cg = exec coop_mod/officer.scr::coop_find_ground local.center
	if( local.cg == NIL ){ local.cg = local.center }

	// One lingering smoke column rising from the crater.
	local.smoke = spawn "models/emitters/linger_smoke.tik"
	if( local.smoke != NULL ){	//[user 08-02] entity-pool guard
	local.smoke.origin = local.cg + (0 0 8)
	local.smoke notsolid
	local.smoke anim start
	}

	// A few scattered ground fires -- each runs its own hurt loop until the deadline.
	local.fi = 0
	while( local.fi < 3 ){
		local.fp = exec coop_mod/officer.scr::coop_strike_scatter local.cg 24 96
		local.fg = exec coop_mod/officer.scr::coop_find_ground local.fp
		if( local.fg == NIL ){ local.fg = local.fp }
		local.fire = spawn "models/emitters/firegood.tik"
		if( local.fire == NULL ){ local.fi++; continue }	//[user 08-02] entity-pool guard
		local.fire.origin = local.fg + (0 0 4)
		local.fire notsolid
		local.fire anim start
		//[user 07-17] bug-717: fire_med is aliascache-gated to m-series/train/t2l1/t2l3 only, so the bombing
		// aftermath was silent on Breakthrough (e) + most Spearhead (t) maps. coop_snd_fire_small is loaded on
		// ALL theaters (maps "m e t dm obj train") - use it so the crater fires sound everywhere.
		local.fire loopsound coop_snd_fire_small
		local.fire thread coop_fire_hurt local.deadline
		local.fi++
	}

	// A couple of dirt-debris puffs for weight -- purely visual, they just expire.
	local.di = 0
	while( local.di < 2 ){
		local.dp = exec coop_mod/officer.scr::coop_strike_scatter local.cg 16 72
		local.dg = exec coop_mod/officer.scr::coop_find_ground local.dp
		if( local.dg == NIL ){ local.dg = local.dp }
		local.deb = spawn "models/emitters/explosion_bombdirt.tik"
		if( local.deb == NULL ){ local.di++; continue }	//[user 08-02] entity-pool guard
		local.deb.origin = local.dg
		local.deb notsolid
		local.deb anim start
		local.deb thread coop_fx_expire local.deadline
		local.di++
	}

	// Hold the smoke column for the crater's lifetime, then clear it (fires + debris self-clean).
	wait local.life
	if( local.smoke != NULL ){
		local.smoke stoploopsound
		local.smoke delete
	}
}end


// Runs on a crater fire (self = the fire ent): burns any player standing in the flames every 0.5s
// until the deadline, then removes the fire. 15 dmg per tick over radius 96 = a hazard that clearly
// hurts but never instakills vs coop_health 750 (worst case ~20 ticks = ~300 dmg over the burn).
coop_fire_hurt local.deadline:{
	if( self == NULL ){ end }
	while( self != NULL && level.time < local.deadline ){
		radiusdamage self.origin 15 96
		wait 0.5
	}
	if( self != NULL ){
		self stoploopsound coop_snd_fire_small
		self delete
	}
}end


// Runs on a debris FX ent (self = the debris): waits out its lifetime, then removes it.
coop_fx_expire local.deadline:{
	local.wt = local.deadline - level.time
	if( local.wt > 0 ){ wait local.wt }
	if( self != NULL ){ self delete }
}end


// After the final strike: force the player off the Bombing Run weapon and remove it
// from inventory so it disappears completely and can't be re-equipped.
coop_binoc_remove_now local.player:{
	wait 2
	if( local.player != NULL ){
		// Switch off the binoculars first so the viewmodel clears, then take the item.
		local.player useweaponclass "rifle"
		local.player take "Bombing Run"
	}
	thread coop_binoc_clear_hud local.player
	level.coop_binoc_given = 0
	level.coop_binoc_owner = NULL
}end


// Devastating 10-bomb carpet run at player position.
// === BINOCULARS / SMOKE HUD ===
// Row above medkit/sandbag (y=-82, left bottom):
//   Slot 50-51: Binoculars icon + strike count
//   Slot 52-53: Smoke icon + PARADROP label

// Binoc icon + strike count - shown ONLY to the owner (level.coop_binoc_owner); explicitly
// hidden for everyone else (each ihuddraw_* targets one client, so HUD slots are per-player).
coop_binoc_update_hud local.player:{
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL ){
			if( level.coop_binoc_owner != NULL && local.p == level.coop_binoc_owner ){
				ihuddraw_shader      local.p 50 "textures/hud/artillery"
				ihuddraw_rect        local.p 50 5 -82 16 16
				ihuddraw_align       local.p 50 left bottom
				ihuddraw_alpha       local.p 50 1.0
				ihuddraw_virtualsize local.p 50 1
				ihuddraw_string      local.p 51 (level.coop_binoc_uses + "x")
				ihuddraw_rect        local.p 51 23 -80 0 0
				ihuddraw_align       local.p 51 left bottom
				ihuddraw_color       local.p 51 1.0 1.0 0.0
				ihuddraw_alpha       local.p 51 1.0
				ihuddraw_virtualsize local.p 51 1
			} else {
				ihuddraw_alpha       local.p 50 0
				ihuddraw_alpha       local.p 51 0
			}
		}
		local.pi++
	}
}end


// Clears binoc HUD slots for ALL players.
coop_binoc_clear_hud local.player:{
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL ){
			ihuddraw_alpha local.p 50 0
			ihuddraw_alpha local.p 51 0
		}
		local.pi++
	}
}end


// Smoke/paradrop icon - shown ONLY to the owner (level.coop_smoke_player); hidden for others.
coop_smoke_hud_show:{
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL ){
			if( level.coop_smoke_player != NULL && local.p == level.coop_smoke_player ){
				ihuddraw_shader      local.p 52 "textures/hud/coop_paradrop_icon"
				ihuddraw_rect        local.p 52 40 -82 16 16
				ihuddraw_align       local.p 52 left bottom
				ihuddraw_alpha       local.p 52 1.0
				ihuddraw_virtualsize local.p 52 1
				ihuddraw_font        local.p 53 "verdana-12"
				ihuddraw_string      local.p 53 "PARADROP"
				ihuddraw_rect        local.p 53 58 -78 0 0
				ihuddraw_align       local.p 53 left bottom
				ihuddraw_color       local.p 53 0.5 0.8 1.0
				ihuddraw_alpha       local.p 53 1.0
				ihuddraw_virtualsize local.p 53 1
			} else {
				ihuddraw_alpha       local.p 52 0
				ihuddraw_alpha       local.p 53 0
			}
		}
		local.pi++
	}
}end


// Clears smoke HUD slots for ALL players.
coop_smoke_hud_clear:{
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL ){
			ihuddraw_alpha local.p 52 0
			ihuddraw_alpha local.p 53 0
		}
		local.pi++
	}
}end


// === BINOCULARS / SMOKE DROP-ON-DEATH ===
// If the player carrying the binoculars or the signal smoke dies before using it up, the item is
// re-dropped where they fell so a teammate (or the respawned player) can recover it. The
// binoculars carry over their REMAINING strikes (coop_binoc_uses persists; re-pickup never resets
// it). All server-side; the re-pickups reuse the same clean trigger_use + giveItem path.

// Watches the binoc owner; drop the binocs again if he dies still holding them with strikes left.
coop_binoc_owner_watch local.player:{
	if( local.player == NULL ){ end }
	local.lastpos = local.player.origin
	while( level.coop_binoc_given == 1 && level.coop_binoc_owner == local.player ){
		if( local.player == NULL || !(isAlive local.player) ){ break }
		local.lastpos = local.player.origin
		wait 0.5
	}
	// Only drop if HE died while still the owner with strikes remaining (NOT the normal expended
	// path, which sets given=0 + owner=NULL + uses=0).
	if( level.coop_binoc_owner != local.player ){ end }
	if( level.coop_binoc_uses == NIL || level.coop_binoc_uses <= 0 ){ end }
	level.coop_binoc_given = 0
	level.coop_binoc_owner = NULL
	thread coop_binoc_clear_hud NULL
	thread coop_binoc_spawn_pickup local.lastpos
	iprintlnbold ("The Binoculars were dropped (" + level.coop_binoc_uses + " strikes left) - a teammate can recover them.")
}end

// RED under-glow beacon for a dropped binoculars pickup (mirrors the smoke's glow so the binocs
// are easy to spot). Stored in level.coop_binoc_beacon; deleted on pickup in coop_binoc_wait_pickup.
coop_spawn_binoc_glow local.pos:{
	local.glow = spawn script_model
	local.glow model "models/fx/dummy.tik"
	local.glow.origin = local.pos + (0 0 8)
	local.glow light (1 0 0)		// RED
	local.glow lightRadius 150
	local.glow lightOn
	local.glow notsolid
	level.coop_binoc_beacon = local.glow
}end

// Spawns a fresh binoculars trigger_use pickup at a position (death re-drop).
coop_binoc_spawn_pickup local.pos:{
	local.bpos = exec coop_mod/officer.scr::coop_find_ground local.pos
	if( local.bpos == NIL ){ local.bpos = local.pos }
	local.binoc_vis = spawn script_model
	local.binoc_vis model "models/items/binoculars.tik"
	local.binoc_vis.origin = local.bpos
	local.binoc_vis droptofloor
	local.binoc_vis notsolid
	local.binoc_vis rendereffects "+fullbright"
	local.binoc = spawn trigger_use
	local.binoc.origin = local.binoc_vis.origin
	local.binoc solid
	local.binoc setsize ( -16 -16 0) (16 16 48)
	thread coop_spawn_binoc_glow local.binoc_vis.origin
	thread coop_binoc_wait_pickup local.binoc local.binoc_vis
}end

// Watches the smoke owner; drop the smoke again if he dies BEFORE throwing it (paradrop armed).
coop_smoke_owner_watch local.player:{
	if( local.player == NULL ){ end }
	local.lastpos = local.player.origin
	while( level.coop_paradrop_armed == 1 && level.coop_smoke_player == local.player ){
		if( local.player == NULL || !(isAlive local.player) ){ break }
		local.lastpos = local.player.origin
		wait 0.5
	}
	// Thrown (armed -> 0) or owner changed -> no drop. Only drop if he died still holding it.
	if( level.coop_smoke_player != local.player ){ end }
	if( level.coop_paradrop_armed != 1 ){ end }
	level.coop_smoke_player = NULL
	thread coop_smoke_hud_clear
	thread coop_smoke_spawn_pickup local.lastpos
	iprintlnbold "The Signal Smoke was dropped - a teammate can recover it."
}end

// Spawns a fresh signal-smoke trigger_use pickup at a position (death re-drop).
coop_smoke_spawn_pickup local.pos:{
	local.spos = exec coop_mod/officer.scr::coop_find_ground local.pos
	if( local.spos == NIL ){ local.spos = local.pos }
	local.vis = spawn script_model
	local.vis model "models/weapons/coop_smoke_grenade.tik"
	local.vis.origin = local.spos
	local.vis droptofloor
	local.vis notsolid
	local.vis rendereffects "+fullbright"
	local.trig = spawn trigger_use
	local.trig.origin = local.vis.origin
	local.trig solid
	local.trig setsize ( -16 -16 0) (16 16 48)
	thread coop_smoke_redrop_pickup local.trig local.vis
}end

// Re-pickup of a dropped smoke: re-give via the clean giveItem path, re-arm, re-own, re-watch.
coop_smoke_redrop_pickup local.trig local.vis:{
	local.trig waittill trigger
	local.player = parm.other
	if( local.player == NULL || local.player.classname != "Player" ){ end }
	if( level.coop_smoke_player != NULL ){ end }	// already recovered by someone else
	local.trig remove
	if( local.vis != NULL ){ local.vis delete }
	local.player item models/weapons/coop_smoke_grenade.tik
	level.coop_paradrop_armed = 1
	level.coop_smoke_player = local.player
	iprintlnbold (local.player.netname + " recovered the Signal Smoke!")
	thread coop_smoke_hud_show
	thread coop_smoke_owner_watch local.player
}end


// === RADIO BOMB PLANT ===

// Called when officer dies - places the red explosive indicator + plant trigger on the radio.
coop_radio_bomb_enable:{
	wait 1
	//[user 08-08] bug-1583 - NIL != NULL. An unassigned level var reads NIL, which PASSES an
	//`== NULL` test; the next line then dereferenced it ("Cannot cast 'none' to listener"), the
	//statement was skipped, local.rpos stayed none, and the line after threw again on the vector
	//add - so the radio-bomb marker never spawned. Same family the m3l1b guards fixed; this site
	//was missed. Test BOTH.
	if( level.coop_radio == NIL || level.coop_radio == NULL ){ end }
	local.radio = level.coop_radio
	local.rpos = local.radio.origin

	// Red pulsing explosive indicator on the radio = "plant charges here"
	local.pulse = spawn script_model
	local.pulse model "models/items/pulse_explosive.tik"
	local.pulse.origin = local.rpos + (0 0 4)
	local.pulse notsolid
	local.pulse anim start
	level.coop_radio_pulse = local.pulse

	iprintlnbold "The radio is exposed! Approach it and press Use to plant explosives."

	local.tuse = spawn trigger_use
	local.tuse.origin = local.rpos + (0 0 10)
	local.tuse solid
	local.tuse setsize ( -24 -24 -10) (24 24 60)
	level.coop_radio_tuse = local.tuse

	while( level.coop_radio_destroyed != 1 && local.tuse != NULL ){
		local.tuse waittill trigger
		local.planter = parm.other
		if( local.planter == NULL ){ continue }
		if( level.coop_radio_planting == 1 ){ continue }
		level.coop_radio_planting = 1
		local.tuse solid 0
		thread coop_radio_bomb_countdown local.planter local.rpos
		while( level.coop_radio_planting == 1 ){ wait 0.5 }
		if( level.coop_radio_destroyed == 1 ){ end }
		if( local.tuse != NULL ){ local.tuse solid }
	}
	if( local.tuse != NULL ){ local.tuse remove }
}end


// Plant -> armed charge appears + single stopwatch fuse (same instant) -> explosion.
coop_radio_bomb_countdown local.planter local.rpos:{
	iprintlnbold (local.planter.netname + " planted explosives on the radio!")

	// Swap the red indicator for the armed charge the instant planting begins
	if( level.coop_radio_pulse != NULL ){
		level.coop_radio_pulse delete
		level.coop_radio_pulse = NULL
	}
	local.charge = spawn script_model
	local.charge model "models/items/explosive.tik"
	local.charge.origin = local.rpos + (0 0 4)
	local.charge notsolid
	local.charge playsound plantbomb
	local.charge loopsound bombtick
	level.coop_radio_charge = local.charge

	// One native stopwatch for the whole fuse, shown to every player
	local.fuse = 8
	local.pi = 1
	while( local.pi <= $player.size ){
		local.pp = $player[local.pi]
		if( local.pp != NULL ){ local.pp stopwatch local.fuse }
		local.pi++
	}
	wait local.fuse

	// Detonate
	level.coop_radio_destroyed = 1
	level.coop_radio_planting = 0
	if( level.coop_radio_charge != NULL ){ level.coop_radio_charge stoploopsound bombtick }
	local.radio = level.coop_radio
	if( local.radio != NULL ){
		local.radio stopsound
		// Distinct metallic demolition blast for the radio charge.
		local.radio playsound coop_radio_blast
		local.e1 = spawn "models/emitters/explosion_bombwall.tik"
		local.e1.origin = local.rpos
		local.e1 notsolid
		local.e1 anim start
		radiusdamage local.rpos 150 200
		level.coop_radio = NULL
		// Remove the radio + its table; mark the wreck with FIRE + SMOKE only (no debris
		// prop -- the rubble/table meshes read as junk, so we keep it clean like before).
		local.radio stopsound
		local.radio remove
		local.rubblepos = local.rpos
		if( level.coop_radio_table != NULL ){
			local.rubblepos = level.coop_radio_table.origin
			level.coop_radio_table remove
			level.coop_radio_table = NULL
		}
		// Fire crackle replaces the radio static; fire + smoke FX at the wreck.
		local.fire = spawn "models/emitters/firegood.tik"
		local.fire.origin = local.rubblepos + (0 0 8)
		local.fire notsolid
		local.fire anim start
		local.fire loopsound fire_med
		local.smoke = spawn "models/emitters/linger_smoke.tik"
		local.smoke.origin = local.rubblepos + (0 0 12)
		local.smoke anim start
		if( level.coop_radio_charge != NULL ){ level.coop_radio_charge delete }
		if( level.coop_radio_tuse != NULL ){ level.coop_radio_tuse remove }
	}

	iprintlnbold "Radio destroyed! Reinforcements cannot be called!"
	thread coop_mod/objectives.scr::coop_obj_radio_done
}end


// === REPLACEMENT OFFICER WATCH ===

// After boss dies, 2 surviving German actors become replacement commanders.
coop_replacement_officer_watch:{
	wait 3
	if( $actor == NULL ){ end }

	local.found = 0
	local.i = 1
	while( local.i <= $actor.size && local.found < 2 ){
		local.ent = $actor[local.i]
		if( local.ent != NULL && isAlive local.ent && local.ent != level.coop_officer ){
			if( randomint 10 < 3 ){
				thread coop_replacement_officer_ai local.ent
				local.found++
			}
		}
		local.i++
	}
}end


// Surviving enemy runs to radio to call reinforcements if they spot a player.
coop_replacement_officer_ai local.actor:{
	while( local.actor != NULL && isAlive local.actor ){
		if( level.coop_radio_destroyed == 1 ){ end }
		wait 5
		if( local.actor == NULL || !isAlive local.actor ){ end }

		local.spotted = 0
		local.pi = 1
		while( local.pi <= $player.size && local.spotted == 0 ){
			local.pp = $player[local.pi]
			if( local.pp != NULL && local.pp.health > 0 ){
				if( local.actor canseenoents local.pp ){
					local.spotted = 1
				}
			}
			local.pi++
		}

		if( local.spotted == 1 && level.coop_radio != NIL && level.coop_radio != NULL && level.coop_radio_destroyed != 1 ){
			iprintlnbold "A surviving officer spotted you and is radioing for backup!"
			local.actor.movedoneradius = 200
			local.actor runto level.coop_radio.origin
			local.actor waittill movedone
			if( level.coop_radio_destroyed != 1 ){
				thread coop_reinf_call_wave_gated local.actor
				wait 15
			}
		}
	}
}end


//=========================================================================
// [user 2026-08-07] Radio chatter on the officer's set - German voice traffic over the static.
// Pool is coop_av_de_*: OUR shipped German VO, so the files are guaranteed present, unlike the
// retail den_scripted_M3L1_* set whose audio was never shipped.
// Plain playsound, never playsound_wait - no length registry needed and it cannot stall on a
// sounddone that never comes.
//=========================================================================
coop_radio_chatter:{
	//one per level, however many times the officer (and his radio) respawn
	if( level.coop_radio_chatting == 1 ){ end }
	level.coop_radio_chatting = 1

	local.pool[1] = "coop_av_de_contact"
	local.pool[2] = "coop_av_de_attack"
	local.pool[3] = "coop_av_de_backup"
	local.pool[4] = "coop_av_de_cover"
	local.pool[5] = "coop_av_de_fallback"
	local.pool[6] = "coop_av_de_mandown"
	local.n = 6

	while( level.coop_radio != NIL && level.coop_radio != NULL && level.coop_radio_destroyed != 1 ){
		local.gap = randomint 40
		local.gap = local.gap + 25
		wait local.gap

		if( level.coop_radio == NULL || level.coop_radio_destroyed == 1 ){ break }
		local.i = randomint local.n
		local.i = local.i + 1
		level.coop_radio playsound local.pool[local.i]
	}
	level.coop_radio_chatting = 0
}end

//[user 2026-08-18] Wait for this actor's first real stop after having actually travelled,
//then play the takecover slide (aliased <wg>_diveongrenade - retail's name, it is the
//sprint-and-slide) and hand back to the brain via the proven medic-kneel exit. Bounded:
//gives up after 20s or death. coop_aiSlideChance gates the roll at personality time.
coop_arrival_slide local.actor:{
	if( local.actor == NULL ){ end }
	if( local.actor.flags["coop_surrendered"] == 1 ){ end }	//[user 2026-08-20] never pull a surrendered (holstered) man back into a combat pose
	//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
	if( local.actor.coop_aiDisabled == 1 ){ end }
	local.wg = local.actor.weapongroup
	if( local.wg != "rifle" && local.wg != "mp40" && local.wg != "mp44" && local.wg != "bar" && local.wg != "thompson" ){ end }
	local.moved = 0
	local.prev = local.actor.origin
	local.t = 0
	while( local.actor != NULL && isAlive local.actor && local.t < 40 ){
		wait 0.5
		local.t++
		if( local.actor == NULL ){ end }
		local.d = vector_length( local.actor.origin - local.prev )
		local.prev = local.actor.origin
		local.moved = local.moved + local.d
		if( local.moved > 350 && local.d < 8 ){
			//travelled, now stopped: slide into the spot
			local.actor anim_scripted (local.wg + "_diveongrenade")
			wait 2.1
			if( local.actor == NULL || !isAlive local.actor ){ end }
			local.actor anim "idle"
			local.actor.position = "crouch"
			//[user 2026-08-22, bug-2047] RE-CHECK AT THE POINT OF EFFECT, not just on entry.
			//This label tests coop_aiDisabled when it STARTS, then waits for the actor to travel
			//and stop - and a map sets its scene markers during exactly that window. m1l1
			//disable_ai's the truck friendlies AFTER they spawn, so the entry test passed, the
			//marker landed, and this bounce re-armed them anyway: "guys in the back of my truck
			//are firing at enemies again during the truck drive". The census caught it -
			//ent=103 friendly goes aiDis=0 wg=unarmed at spawn, then aiDis=1 wp=m1 garand
			//hasEnemy=1 pos=crouch.
			//coop_suppress_react and coop_prone_shooter already re-test here (bug-2037); this
			//label was the one that only tested on entry. An entry guard cannot protect against
			//state that arrives after entry.
			if( local.actor.flags["coop_surrendered"] == 1 ){ end }
			if( local.actor.coop_aiDisabled == 1 ){ end }
			local.actor.enableEnemy = 0
			local.actor.enableEnemy = 1
			local.actor forceactivate
			end
		}
	}
}end

//[user 2026-08-18] Suppression-reactive pose. Polls the engine's near-miss stamp; a fresh one
//rolls coop_aiSuppressReact (percent): the actor throws the standtocrouch dive (0.87s, shipped
//unused) and stays low, or - rifleman with a far enemy - drops into the proven prone-shooter.
//Per-actor cooldown so sustained fire cannot chain-stagger him. Personality-attached only, so
//scene actors and alarm runners are already exempt.
//=========================================================================
//[user 2026-08-18] Suppression flavor - fear facial while pinned, alert scan after.
//Decoupled thread so it can never disturb the pose logic in coop_suppress_react.
//=========================================================================
coop_suppress_flavor local.actor:{
//=========================================================================
	if( local.actor == NULL ){ end }
	wait 0.4
	if( local.actor == NULL || !(isAlive local.actor) ){ end }
	//SayManager assumes its Init ran from an attack context - seed the fields when it has not
	//(comparing against a NIL sayimportance threw 38 script errors per boot, 2026-08-19)
	if( local.actor.sayimportance == NIL ){
		local.actor.saying = 0
		local.actor.sayimportance = 0
		local.actor.silent = 0
	}
	local.actor thread anim/SayManager.scr::SayManager facial_idle_fear 6
	//[user 2026-08-19] cut-content: 166 den_fear takes (m-map gated in retail, never played
	//on t/e at all) - the pinned man SOUNDS afraid, not just looks it.
	thread coop_mod/aivoice.scr::aivoice_request local.actor "fear" 10
	thread coop_mod/aibehav.scr::behav_bump "fear"
	wait 2.4
	if( local.actor == NULL || !(isAlive local.actor) ){ end }
	//scan only when he has no live target to fight
	if( local.actor.enemy != NIL && local.actor.enemy != NULL ){ end }
	local.wg = local.actor.weapongroup
	switch( local.wg ){
	case rifle:
	case pistol:
	case mp40:
	case mp44:
	case bar:
	case thompson:
	case sten:
	case vickers:
		break
	default:
		end
	}
	//bug-1955: alert01/02 are TAF_RANDOM takes - the engine registers them under the STEM
	//name and picks a take itself; the numbered names never exist as lookup keys ("unknown
	//animation" x107/session). Request the stem.
	local.a = "_stand_alert"
	local.actor.blendtime = 0.3
	local.actor setmotionanim (local.wg + local.a)
}end

coop_suppress_react local.actor:{
	if( local.actor == NULL ){ end }
	if( local.actor.flags["coop_surrendered"] == 1 ){ end }	//[user 2026-08-20] never pull a surrendered (holstered) man back into a combat pose
	//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
	if( local.actor.coop_aiDisabled == 1 ){ end }
	local.wg = local.actor.weapongroup
	if( local.wg != "rifle" && local.wg != "mp40" && local.wg != "mp44" && local.wg != "bar" && local.wg != "thompson" && local.wg != "sten" ){ end }
	local.next = 0
	while( local.actor != NULL && isAlive local.actor ){
		wait 0.3
		if( local.actor == NULL ){ end }
		local.at = local.actor.coop_suppressedAt
		if( local.at == NIL || local.at == NULL ){ continue }
		if( level.time - local.at > 0.45 ){ continue }
		if( level.time < local.next ){ continue }
		local.next = level.time + 9
		if( (randomint 100) >= (int(getcvar "coop_aiSuppressReact") + 0) ){ continue }
		//[user 2026-08-18] cut-content flavor riding the REAL event: fear on the face while
		//pinned, an alert scan once the fire lifts (was wrongly hung on the watcher START,
		//which fires for every actor at boot - 2026-08-19).
		thread coop_suppress_flavor local.actor
		//long-range rifleman: go prone and shoot back through the proven poser
		if( local.wg == "rifle" && local.actor.enemy != NULL && local.actor.enemy != NIL ){
			if( vector_length( local.actor.enemy.origin - local.actor.origin ) > 800 ){
				thread coop_prone_shooter local.actor
				end
			}
		}
		//everyone else: dive low and stay crouched
		local.actor anim_scripted (local.wg + "_standtocrouch_dive")
		wait 1.0
		if( local.actor == NULL || !isAlive local.actor ){ end }
		local.actor anim "idle"
		local.actor.position = "crouch"
		//[user 2026-08-21, bug-2024] never bounce a surrendered man back to live AI
		if( local.actor.flags["coop_surrendered"] == 1 ){ end }
		//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
		if( local.actor.coop_aiDisabled == 1 ){ end }
		local.actor.enableEnemy = 0
		local.actor.enableEnemy = 1
		local.actor forceactivate
	}
}end

//[user 2026-08-18] LAST MAN OF THE SQUAD SURRENDERS. The squad is the actor's spawn-time
//cohort: same-team soldiers within 700u at personality time, at least two of them, so a lone
//spawn never counts as a massacre survivor. When every mate is dead and he still stands, one
//roll of coop_aiSurrenderChance decides it: he holsters (the anim is the scientist's - empty
//raised hands read right, a waved rifle would not), plays scientist_surrender - the trilogy's
//only hands-up anim, shipped unused - re-asserted like the prone poser so the engine cannot
//drift him out of it, and goes permanently non-hostile. Shooting him still kills him; the
//deathhandler is untouched. Personality-attached only, so scene actors are exempt.
coop_squad_surrender local.actor:{
	if( local.actor == NULL ){ end }
	//[user 2026-08-22, bug-2045] GERMANS ONLY. Nothing here ever checked team, so any path
	//that reached this label could surrender an ALLY - putting "Hold [USE] to convert enemy"
	//over a friendly soldier who is already on your side. Confirmed live: 16 census rows with
	//tm=american surr=1. This is the narrow gate that belongs here; the broad one does not
	//belong in coop_attach_dynamics, see the note there.
	if( local.actor.team != "german" ){ end }
	//[user 2026-08-20] THE OFFICER NEVER SURRENDERS. He is the wave boss - the man the players
	//are hunting, with the eagle marker over his head and his own reinforcement waves - and a
	//boss who throws his hands up ends the encounter with a whimper instead of a fight. The
	//check is repeated after the wait because level.coop_officer is assigned during the spawn
	//window this label deliberately sleeps through.
	if( level.coop_officer != NULL && local.actor == level.coop_officer ){ end }
	wait 2	//let the wave finish spawning so the cohort is complete
	if( local.actor == NULL || !isAlive local.actor ){ end }
	if( level.coop_officer != NULL && local.actor == level.coop_officer ){ end }
	local.n = 0
	local.maxent = int(getcvar "maxentities")
	if( local.maxent <= 0 ){ local.maxent = 1024 }
	local.ei = 0
	while( local.ei < local.maxent && local.n < 6 ){
		local.e = getentbyentnum local.ei
		if( local.e != NULL && local.e != local.actor ){
			if( local.e.classname == "Actor" && isAlive local.e && local.e.team == local.actor.team ){
				if( vector_length( local.e.origin - local.actor.origin ) < 700 ){
					local.n++
					local.mate[local.n] = local.e
				}
			}
		}
		local.ei++
	}
	if( local.n < 2 ){ end }	//no squad, no surrender
	while( local.actor != NULL && isAlive local.actor ){
		wait 1
		if( local.actor == NULL ){ end }
		local.alive = 0
		local.i = 1
		while( local.i <= local.n ){
			if( local.mate[local.i] != NULL && isAlive local.mate[local.i] ){ local.alive++ }
			local.i++
		}
		if( local.alive == 0 ){
			//[user 2026-08-20] "sometimes these germans will also randomly surrender". The cohort
			//is a SNAPSHOT taken 2s after spawn and never updated, so a man who has since walked
			//across the map surrenders the moment those particular three die - even while he is
			//standing in the middle of a fresh squad. Re-check that he is ACTUALLY alone right
			//now before giving up, which is what "last soldier in his squad" was always meant to
			//mean. If company has arrived, keep watching instead of surrendering.
			local.near = 0
			local.ni = 0
			while( local.ni < local.maxent && local.near < 1 ){
				local.ne = getentbyentnum local.ni
				if( local.ne != NULL && local.ne != local.actor ){
					if( local.ne.classname == "Actor" && isAlive local.ne && local.ne.team == local.actor.team ){
						if( local.ne.flags["coop_surrendered"] != 1 ){
							if( vector_length( local.ne.origin - local.actor.origin ) < 700 ){
								local.near = 1
							}
						}
					}
				}
				local.ni++
			}
			if( local.near == 1 ){ continue }
			if( (randomint 100) >= (int(getcvar "coop_aiSurrenderChance") + 0) ){ end }
			if( local.actor.flags["coop_surrendered"] == 1 ){ end }
			//[bug-2037] nor an actor the MAP disabled - that is a scripted scene, not a combatant
			if( local.actor.coop_aiDisabled == 1 ){ end }
			local.actor.flags["coop_surrendered"] = 1
			//[user 2026-08-21] "Still need the allied icon to pop up (same as paratroopers) over
			//their head once they surrender and it should stay until they die." Same wire trick
			//as the officer eagle: +coopboss turns the overhead icon ON, and
			//+lightstyledynamiclight (visually inert without an attached dlight; only ever used
			//on map light entities, never actors) tells cgame "draw the ALLIED STAR even though
			//EF_AXIS is still set" - he is still team german until converted, so without the
			//override he would get the swastika. cgame clears the icon itself on EF_DEAD, which
			//is exactly "stays until they die".
			local.actor rendereffects "+coopboss +lightstyledynamiclight"
			local.actor.enableEnemy = 0
			//[bug-1958] remember his real gun BEFORE the holster - holstering can leave
			//binoculars as the active item, so a later unholster restores the WRONG thing;
			//the recruit path re-gives this explicitly.
			local.actor.coop_preSurrenderGun = local.actor.weapon
			local.actor holster
			wait 0.8
			if( local.actor == NULL || !isAlive local.actor ){ end }
			//[user 2026-08-19] hold USE at him to recruit him (coop_mod/surrender.scr)
			thread coop_mod/surrender.scr::recruitable local.actor
			while( local.actor != NULL && isAlive local.actor && local.actor.coop_converted != 1 ){
				//[user 2026-08-20] HOLSTERED COMBATANT. Nothing outside this label honors
				//flags["coop_surrendered"], and three long-lived per-actor threads
				//(coop_suppress_react, coop_arrival_slide, coop_prone_shooter) all exit with the
				//enableEnemy 0->1 + forceactivate bounce that exists to break an actor OUT of a
				//scripted anim. Bounced while surrendered he keeps the holster, and the engine's
				//armed-attack test is an INVENTORY test, so he gets the NORMAL attack think with
				//an empty hand: runs at the player, frozen in his last armed pose (attack.scr
				//bails on weapongroup "unarmed") and never fires. anim_scripted alone cannot heal
				//it - it only rewrites the IDLE-level think - so re-assert non-hostility FIRST,
				//which drops him back to idle where the scripted anim actually takes.
				//[user 2026-08-21, bug-2024] COMMITMENT. The old loop re-asserted every 2.5s,
				//so any ungated re-arm bought him up to 2.4 SECONDS of live AI - long enough to
				//run, draw his gun or throw a grenade before being yanked back to hands-up,
				//which is exactly the flicker the user described. The known re-arm sites are now
				//gated at the source, and this loop is the backstop: enableEnemy is re-asserted
				//every 0.5s so anything unforeseen gets half a second, not two and a half. The
				//anim re-assert stays at its old 2.5s cadence (every 5th pass) - restarting
				//anim_scripted 2Hz would visibly pop the pose.
				local.actor.enableEnemy = 0
				if( local.reassert == NIL ){ local.reassert = 0 }
				if( local.reassert == 0 ){
					local.actor anim_scripted scientist_surrender
					thread coop_mod/aibehav.scr::behav_bump "surrender"
				}
				local.reassert = local.reassert + 1
				if( local.reassert >= 5 ){ local.reassert = 0 }
				wait 0.5
			}
			end
		}
	}
}end
