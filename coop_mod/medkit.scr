medkit_hud_monitor local.player:{
	local.last_count = -1
	local.prev_hp    = local.player.health

	ihuddraw_virtualsize local.player 36 1
	ihuddraw_align       local.player 36 left bottom
	ihuddraw_shader      local.player 36 "textures/hud/coop_medkit_icon"
	ihuddraw_rect        local.player 36 5 -62 16 16
	ihuddraw_alpha       local.player 36 1

	ihuddraw_virtualsize local.player 37 1
	ihuddraw_align       local.player 37 left bottom
	ihuddraw_font        local.player 37 "verdana-14"
	ihuddraw_color       local.player 37 1 1 1
	ihuddraw_rect        local.player 37 23 -60 0 0
	ihuddraw_alpha       local.player 37 1

	local.maxent = int(getcvar("maxentities"))
	if( local.maxent <= 0 ){ local.maxent = 1024 }
	local.scan_timer = 0

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.count = local.player.flags["coop_medkits"]
		if( local.count == NIL ){ local.count = 0 }
		if( local.count != local.last_count ){
			ihuddraw_string local.player 37 ("" + local.count)
			local.last_count = local.count
		}

		local.prev_hp = local.player.health
		wait 0.1

		if( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
			local.curr_hp = local.player.health
			local.delta   = local.curr_hp - local.prev_hp
			if( local.delta >= 10 && local.delta <= 200 ){
				if( local.player.flags["coop_dbno_active"] != 1 ){
					if( local.player.flags["coop_medkit_in_use"] != 1 ){
						local.cooldown = local.player.flags["coop_medkit_refill_cooldown"]
						if( local.cooldown == NIL || level.time >= local.cooldown ){
							local.medkits = local.player.flags["coop_medkits"]
							if( local.medkits == NIL ){ local.medkits = 0 }
							if( local.medkits < 2 ){
								local.player.flags["coop_medkits"]                = local.medkits + 1
								local.player.flags["coop_medkit_refill_cooldown"] = level.time + 5
								local.player iprint "Medkit refilled!" 1
							}
						}
					}
				}
			}
			if( local.curr_hp >= level.coop_health ){
				if( local.player.flags["coop_dbno_active"] != 1 ){
					if( local.player.flags["coop_medkit_in_use"] != 1 ){
						local.cooldown = local.player.flags["coop_medkit_refill_cooldown"]
						if( local.cooldown == NIL || level.time >= local.cooldown ){
							local.medkits = local.player.flags["coop_medkits"]
							if( local.medkits == NIL ){ local.medkits = 0 }
							if( local.medkits < 2 ){
								if( level.coop_health_ent_count != NIL ){
									local.ci = 1
									while( local.ci <= level.coop_health_ent_count ){
										if( level.coop_health_ents[local.ci] != NIL ){
											local.check_ent = getentbyentnum level.coop_health_ents[local.ci]
											if( local.check_ent == NULL ){
												local.stored_org = level.coop_health_ent_origins[local.ci]
												if( vector_length(local.player.origin - local.stored_org) <= 100 ){
													local.player iprint "Pack detected nearby!" 1
													local.player.flags["coop_medkits"]                = local.medkits + 1
													local.player.flags["coop_medkit_refill_cooldown"] = level.time + 5
													local.player iprint "Medkit refilled!" 1
													level.coop_health_ents[local.ci] = NIL
												}
											}
										}
										local.ci++
									}
								}
							}
						}
					}
				}
			}
			local.scan_timer++
			if( local.scan_timer >= 50 ){
				local.scan_timer = 0
				if( local.player.health >= level.coop_health ){
					//[user 08-02] "at full health you cannot pick up a 2nd medkit" - this gate was
					//"< 1", so the ONLY path that works at full health refused to bank a second kit.
					//The other two paths cannot cover it: the engine returns from Item pickup before
					//ItemPickup() when health >= max_health (fgame/health.cpp), so at full health the
					//pack is never consumed, no heal delta occurs, and the pack entity never vanishes
					//- which is precisely what those two paths watch for. Raised to the same max
					//carry of 2 used everywhere else in this file.
					//Reuse the SAME cooldown + in-use flags the other two pickup paths already use, so
					//the three paths cannot double-grant off one pack. NIL-guarded: an unset flag
					//reads as 'none' and "level.time >= none" throws (the dbno threshold spam shape).
					local.cd3 = local.player.flags["coop_medkit_refill_cooldown"]
					if( local.cd3 == NIL ){ local.cd3 = 0 }
					local.mk3 = local.player.flags["coop_medkits"]
					if( local.mk3 == NIL ){ local.mk3 = 0 }
					if( local.mk3 < 2 && level.time >= local.cd3 && local.player.flags["coop_medkit_in_use"] != 1 ){
						local.si = 0
						while( local.si < local.maxent ){
							local.sent = getentbyentnum local.si
							if( local.sent != NULL ){
								if( local.sent.classname == "Health" ){
									if( vector_length(local.player.origin - local.sent.origin) <= 100 ){
										println "^~^~^ DBNO health_pickup_while_down"
										local.player.flags["coop_medkits"] = local.mk3 + 1
										//CONSUME the pack. Without this the same box could be farmed
										//every scan tick, because at full health the engine never
										//removes it. Cooldown is a second belt for map-placed packs
										//that respawn or that we fail to hide.
										local.sent hide
										local.sent notsolid
										local.player.flags["coop_medkit_refill_cooldown"] = level.time + 5
										local.player iprint ( "Medkit stowed (" + ( local.mk3 + 1 ) + "/2)" ) 1
										local.si = local.maxent
									}
								}
							}
							local.si++
						}
					}
				}
			}
		}
	}

	//[user 2026-08-10] NULL guard: this teardown runs AFTER the display loop above, and that
	//loop exits precisely BECAUSE the player went away (disconnect / spectate / map change).
	//Measured in the 2-player test as "Script Error : Player entity is NULL for ihuddraw_*".
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 36 0
		ihuddraw_alpha  local.player 37 0
		ihuddraw_string local.player 37 ""
	}
}end


medkit_use local.player:{
	if( local.player.flags["coop_dbno_active"] == 1 ){ end }
	if( local.player.flags["coop_medkit_in_use"] == 1 ){ end }
	if( local.player.health >= level.coop_health ){
		local.player iprint "Already at full health" 1
		end
	}
	local.medkits = local.player.flags["coop_medkits"]
	if( local.medkits == NIL ){ local.medkits = 0 }
	if( local.medkits < 1 ){
		local.player iprint "No medkits remaining" 1
		end
	}

	local.player.flags["coop_medkit_in_use"] = 1
	//[user 2026-08-10] play the self-heal on the TORSO ONLY so the legs are untouched.
	local.player forcetorsostate COOP_SELFHEAL
	local.start_origin = local.player.origin
	// [user 07-10] wake the faded HUD the INSTANT the heal starts (before health ticks) so the player
	// can watch their health fill. The cgame HUD-fade watches coop_hudPoke for a change (cg_drawtools.cpp).
	local.player stufftext ( "seta coop_hudPoke " + level.time )
	//[303] HZM CHALLENGES - a medkit heal fails the "Earn This." no-heal feat for this player this level
	thread coop_mod/challenges.scr::chal_on_heal local.player

	ihuddraw_virtualsize local.player 33 1
	ihuddraw_align       local.player 33 center bottom
	ihuddraw_font        local.player 33 "verdana-12"
	ihuddraw_color       local.player 33 1 1 1
	ihuddraw_rect        local.player 33 0 -80 0 0
	ihuddraw_string      local.player 33 "Applying medkit..."
	ihuddraw_alpha       local.player 33 1

	ihuddraw_virtualsize local.player 34 1
	ihuddraw_align       local.player 34 left bottom
	ihuddraw_shader      local.player 34 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 34 0.12 0.12 0.12
	ihuddraw_rect        local.player 34 270 -55 100 6
	ihuddraw_alpha       local.player 34 0.8

	ihuddraw_virtualsize local.player 35 1
	ihuddraw_align       local.player 35 left bottom
	ihuddraw_shader      local.player 35 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 35 0.1 0.9 0.1
	ihuddraw_rect        local.player 35 270 -55 0 6
	ihuddraw_alpha       local.player 35 0.9

	local.heal_frames = 0
	local.prev_health = local.player.health

	while( local.heal_frames < 100 ){
		if( local.player == NULL ){ end }
		if( local.player.flags["coop_isActive"] != 1 ){
			local.player.flags["coop_medkit_in_use"] = NIL
			if( isAlive local.player ){ local.player forcetorsostate STAND }
			end
		}
		if( vector_length(local.player.origin - local.start_origin) > 15 ){
			ihuddraw_alpha  local.player 33 0
			ihuddraw_alpha  local.player 34 0
			ihuddraw_alpha  local.player 35 0
			ihuddraw_string local.player 33 ""
			local.player.flags["coop_medkit_in_use"] = NIL
			if( isAlive local.player ){ local.player forcetorsostate STAND }
			end
		}
		if( local.player.health < local.prev_health - 5 ){
			local.player iprint "Heal interrupted!" 1
			ihuddraw_alpha  local.player 33 0
			ihuddraw_alpha  local.player 34 0
			ihuddraw_alpha  local.player 35 0
			ihuddraw_string local.player 33 ""
			local.player.flags["coop_medkit_in_use"] = NIL
			if( isAlive local.player ){ local.player forcetorsostate STAND }
			end
		}
		if( local.heal_frames == 1 || local.heal_frames == 50 ){
			local.player playsound coop_medkit_cloth
		}
		local.fill_width = local.heal_frames
		ihuddraw_rect local.player 35 270 -55 local.fill_width 6
		local.heal_frames++
		local.prev_health = local.player.health
		waitframe
	}

	local.player health level.coop_health
	local.player gore_reset	// HZM coop - gore tier 1: fully patched up = clean uniform + stop dripping
	local.player.flags["coop_medkits"]      = local.player.flags["coop_medkits"] - 1

	ihuddraw_alpha  local.player 33 0
	ihuddraw_alpha  local.player 34 0
	ihuddraw_alpha  local.player 35 0
	ihuddraw_string local.player 33 ""

	wait 0.1
	local.player.flags["coop_medkit_in_use"] = NIL
	if( isAlive local.player ){ local.player forcetorsostate STAND }
	local.player playsound coop_exhale1
	local.player playsound med_kit
	local.player stufftext ( "s_volume " + getcvar( "coop_tinnitusBaseVol" ) )	// restore world SFX after self-revive
	local.player iprint "You have bandaged yourself up." 1
}end


dbno_selfrevive local.player:{
	local.medkits = local.player.flags["coop_medkits"]
	if( local.medkits == NIL ){ local.medkits = 0 }
	if( local.medkits < 1 ){
		local.player iprint "No medkits - cannot self-revive" 0
		end
	}

	ihuddraw_virtualsize local.player 33 1
	ihuddraw_align       local.player 33 center bottom
	ihuddraw_font        local.player 33 "verdana-12"
	ihuddraw_color       local.player 33 1 1 1
	ihuddraw_rect        local.player 33 0 -80 0 0
	ihuddraw_string      local.player 33 ""
	ihuddraw_alpha       local.player 33 1

	ihuddraw_virtualsize local.player 34 1
	ihuddraw_align       local.player 34 left bottom
	ihuddraw_shader      local.player 34 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 34 0.12 0.12 0.12
	ihuddraw_rect        local.player 34 270 -55 100 6
	ihuddraw_alpha       local.player 34 0

	ihuddraw_virtualsize local.player 35 1
	ihuddraw_align       local.player 35 left bottom
	ihuddraw_shader      local.player 35 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 35 0.1 0.9 0.1
	ihuddraw_rect        local.player 35 270 -55 0 6
	ihuddraw_alpha       local.player 35 0

	ihuddraw_virtualsize local.player 38 1
	ihuddraw_align       local.player 38 center center
	ihuddraw_font        local.player 38 "verdana-12"	//[user 07-16] was handle-23 (huge)
	ihuddraw_color       local.player 38 1 0.4 0.0
	ihuddraw_rect        local.player 38 0 -58 0 0
	ihuddraw_alpha       local.player 38 0
	ihuddraw_string      local.player 38 ""

	ihuddraw_virtualsize local.player 39 1
	ihuddraw_align       local.player 39 center center
	ihuddraw_font        local.player 39 "verdana-12"	//[user 07-16] was verdana-14; WAY smaller
	ihuddraw_color       local.player 39 1 1 0.7
	ihuddraw_rect        local.player 39 0 -28 0 0
	//[user 2026-08-10] HINT REMOVED - it duplicated the downed-player hint that dbno.scr already
	//draws at slot 29 ("Tap [USE]: Medic    Hold [USE]: Self-Revive"), which states BOTH actions in
	//one line and adapts when the player has no medkit. This one said only half of that, so a downed
	//player read two overlapping prompts saying the same thing. Slot 39 is left defined-but-blank
	//rather than deleted, because the completion and teardown paths below still clear it.
	ihuddraw_string local.player 39 ""
	ihuddraw_alpha  local.player 39 0

	local.start_origin = local.player.origin

	while( local.player != NULL && local.player.flags["coop_dbno_active"] == 1 ){
		local.mk = local.player.flags["coop_medkits"]
		if( local.mk == NIL ){ local.mk = 0 }
		// Self-revive only engages with a medkit in hand. With no kit, holding USE is owned by
		// dbno.scr::dbno_letgo_monitor (= give up), so the two never fire on the same hold.
		if( local.player.useheld == 1 && local.mk >= 1 ){
			ihuddraw_string local.player 33 "Hold [USE]: Self-revive (medkit)"
			ihuddraw_alpha  local.player 34 0.8
			ihuddraw_alpha  local.player 35 0.9
			local.player.flags["coop_dbno_healing"] = 1

			local.hold_frames = 0
			local.cancelled   = 0
			ihuddraw_alpha  local.player 38 0
			ihuddraw_string local.player 38 ""

			//[user 2026-08-10] start the get-up: struggle onto the knees and hold there while the
			//medkit is applied. DBNO_GETUP_KNEES rolls into DBNO_GETUP_HOLD on its own.
			local.player forcelegsstate DBNO_GETUP_KNEES
			while( local.player != NULL && local.player.flags["coop_dbno_active"] == 1 && local.player.useheld == 1 && local.cancelled != 1 ){
				if( vector_length(local.player.origin - local.start_origin) > 10 ){
					ihuddraw_string local.player 38 "Cannot move while applying health kit"
					ihuddraw_alpha  local.player 38 1
					local.cancelled = 1
				}
				if( local.hold_frames == 1 || local.hold_frames == 67 || local.hold_frames == 134 ){
					local.player playsound coop_medkit_cloth
				}
				local.fill_width = local.hold_frames * 0.5
				ihuddraw_rect local.player 35 270 -55 local.fill_width 6
				local.hold_frames++

				if( local.hold_frames >= 200 ){
					println ( "^~^~^ DBNO getup_selfrevive p=" + local.player.netname )
					local.player.flags["coop_dbno_letgo"]   = 1
					local.player.flags["coop_medkits"]      = local.player.flags["coop_medkits"] - 1
					local.player.flags["coop_dbno_dead"]    = 1
					local.player.flags["coop_dbno_healing"] = NIL
					local.player.flags["coop_dbno_active"]  = NIL
					//[user 08-02] mirror DBNO into the engine (coop_setdbno) so turret/vehicle mount can refuse it
					if (local.player != NULL){ local.player coop_setdbno 0 }
					//[bug-1236] Hooked HERE - immediately after the state flags flip and BEFORE the ihuddraw
					//block - deliberately. Every revive in the log throws two "Failed execution of command
					//ihuddraw_alpha/ihuddraw_string" errors, because this path clears HUD slots that were never
					//created for it. Anything sequenced AFTER that block is hostage to whether a failed command
					//aborts the running thread. `thread` spawns an independent thread, so re-hatting first means
					//the helmet is restored even if the rest of the revive body dies partway.
					thread coop_mod/helmet.scr::helmet_apply local.player

					ihuddraw_alpha  local.player 33 0
					ihuddraw_alpha  local.player 34 0
					ihuddraw_alpha  local.player 35 0
					ihuddraw_string local.player 33 ""

					ihuddraw_alpha local.player 20 0
					ihuddraw_alpha local.player 27 0
					ihuddraw_alpha local.player 28 0
					ihuddraw_alpha local.player 29 0
					ihuddraw_alpha local.player 31 0
					ihuddraw_alpha local.player 32 0

					local.player stoploopsound coop_dbno_breath1
					local.player stoploopsound coop_dbno_breath2
					local.player stoploopsound coop_dbno_breath3

					local.player modheight "stand"
					local.player forcelegsstate DBNO_GETUP_STAND	//was STAND: rise to the feet, then it exits to STAND itself
					local.player health level.coop_health
					local.player gore_reset	// HZM coop - gore tier 1: revived+healed = clean uniform

					wait 0.1

					//[user 2026-08-02] bug-1293 - RAISE THE SNAPSHOT GUARD BEFORE takeall, not inside
					//coop_ammoRestore. bug-913 added coop_ammoRestorePending so a snapshot tick could not
					//clobber the down-moment ammo with the DEFAULT ammo a re-give hands out - but the flag
					//was only set once coop_ammoRestore itself started, ~60 lines and several waits AFTER
					//the takeall below has already zeroed every pool. The snapshot loop ticks every 0.5s
					//and is gated ONLY on this flag and coop_dbno_active (already cleared by now), so a
					//tick landing in that gap records ZEROES as the saved reserve - and the restore then
					//faithfully re-applies zero. That is the "lost all my ammo after self-revive" report.
					local.player.flags["coop_ammoRestorePending"] = 1

					local.player takeall
					//[user 07-19] e1l3 PAPERS-ONLY DISGUISE: skip the ENTIRE weapon re-give while weapons are
					//locked out (coop_noWeapon) - a self-revived player comes back papers-only (papers are
					//re-given by keyitems.scr::coop_key_guardian -> main.scr::itemGetAll). Mission items below
					//are still restored. This guard closes just before the mission-item block. Cleared in
					//courtyard.scr::enableEnemyOnAll.
					if( !level.coop_noWeapon ){
					local.inv  = local.player.flags["coop_inventoryWeapons"]
					local.gave = 0
					waitthread coop_mod/main.scr::changeGameType 0 0	//[user 07-19] bug-912: revive re-gives can hand out 2 primaries - run under the gametype-0 weapon-give hack like KITBACKFILL/REISSUE so none are dropped
					if( local.inv != NIL ){
						local.wi = 1
						while( local.wi <= local.inv.size ){
							if( local.inv[local.wi] != NIL ){
								local.player item local.inv[local.wi]
								println ( "^~^~^ SELFREV give_inv " + local.inv[local.wi] )
								local.gave = 1
							}
							local.wi++
						}
					}
					//[user 07-16] bug-625: mirror dbno.scr::dbno_ai_revive's chain (bug-618) - the
					//ARMORY PICKS tier was missing here too: a self-revive right after an armory
					//regive (which NILs coop_inventoryWeapons) fell through to the MAP DEFAULT kit,
					//silently losing the player's picked weapons. Priority: registered inv > picks >
					//map default > failsafe.
					if( local.gave != 1 && local.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1 ){
						local.picks = local.player.flags["coop_loWeapons"]
						local.wi = 1
						while( local.wi <= local.picks.size ){
							if( local.picks[local.wi] != NIL ){
								local.player item local.picks[local.wi]
								local.gave = 1
							}
							local.wi++
						}
					}
					if( local.gave != 1 && level.coop_weaponLoadout != NIL ){
						local.wi = 1
						while( local.wi <= level.coop_weaponLoadout.size ){
							if( level.coop_weaponLoadout[local.wi] != NIL ){
								local.player item level.coop_weaponLoadout[local.wi]
								local.gave = 1
							}
							local.wi++
						}
					}
					if( local.gave != 1 ){
						local.player item "weapons/m1_garand.tik"
						local.player item "weapons/colt45.tik"
						local.player item "weapons/frag_grenade.tik"
					}
					//[user 07-28] bug-1204: exact mirror of the dbno.scr::dbno_ai_revive addition - the tiers
					//above are EXCLUSIVE, so a registered inventory of primaries only left the self-revived
					//player with no handgun. Re-issue the armory-picked sidearm on top (SECONDARY weapon class:
					//never collides with the one-primary rule; a no-op when already held). noWrap=1 - already
					//inside the gametype-0 window.
					local.player waitthread coop_mod/itemhandler.scr::coop_giveSidearmPick local.player 1
					//[user 2026-08-11] SILENCED PISTOL SURVIVES A DBNO TOO. dbno_enter does a takeall, and the restore
					//tiers above are EXCLUSIVE - registered inv > picks > map default > failsafe - so on a disguise map
					//the silenced pistol was lost on every revive: it is ADDITIVE (level.coop_silencedOnSpawn), not part
					//of coop_loWeapons, and the map-default tier that does list it never runs once a player has picks -
					//which, since bug-1675/1678 seeds every new player, is everyone. Exactly the shape of bug-1204 one
					//line above, so it is fixed the same way: re-issued unconditionally on top. A pistol is a SECONDARY
					//weapon class so it cannot collide with the one-primary rule, and a re-give of a held weapon is a
					//no-op. Already inside the gametype-0 window here, same as the sidearm re-give.
					if( level.coop_silencedOnSpawn == 1 ){
						local.player item "models/weapons/silencedpistol.tik"
						local.player ammo "pistol" 40
					}
					waitthread coop_mod/main.scr::changeGameType 2 0	//[user 07-19] bug-912: restore team gametype after the revive weapon re-give
					}	//[user 07-19] end coop_noWeapon weapon-give guard (papers-only disguise)
					//[user 07-16] bug-625 / [user 07-19] bug-893: mission-critical map gear (bug-620,
					//e1l2 minedetector etc.) was lost on the self-revive chain. Shared restore re-gives
					//the WEAPON-class detector under the coop weapon-give gametype-0 hack (a bare `item`
					//in gametype 2 did not reliably persist it). Same call as dbno.scr / itemGetAll.
					local.player waitthread coop_mod/main.scr::coop_reissueMissionItems
					if( !level.coop_noWeapon ){ local.player useweaponclass rifle }	//[user 07-19] papers-only: no rifle to raise while locked out
					local.player thread coop_mod/itemhandler.scr::coop_ammoRestore	//[user 07-19] bug-913: revive-in-place re-gives handed DEFAULT ammo - re-apply the exact reserve snapshotted when the player went down (snapshot pauses during DBNO, so it holds the down-moment values)
					thread coop_mod/xp.scr::xp_award local.player 10 "revive"	// [302] HZM XP - self-revive
					wait 0.1
					local.player playsound coop_exhale1
					local.player playsound med_kit
					local.player stufftext ( "s_volume " + getcvar( "coop_tinnitusBaseVol" ) )	// restore world SFX after self-revive
					ihuddraw_alpha  local.player 38 0
					ihuddraw_alpha  local.player 39 0
					ihuddraw_string local.player 38 ""
					ihuddraw_align  local.player 33 center center
					ihuddraw_font   local.player 33 "verdana-14"
					ihuddraw_color  local.player 33 0.4 1.0 0.4
					ihuddraw_rect   local.player 33 0 0 0 0
					ihuddraw_string local.player 33 "You have bandaged yourself up."
					ihuddraw_alpha  local.player 33 1
					wait 3
					if( local.player != NULL ){
						ihuddraw_alpha  local.player 33 0
						ihuddraw_string local.player 33 ""
					}
					end
				}
				waitframe
			}
			//[user 2026-08-10] DBNO_GETUP cancel restore. The user: "you get stuck wherever you are in
			//the new anim". This loop has FOUR exits - moved too far, released USE, no longer downed, or
			//disconnected - and only the SUCCESS path inside it changes legs state (to DBNO_GETUP_STAND).
			//Every other exit left the player frozen in the half-risen kneel, because DBNO_GETUP_HOLD
			//self-transitions forever by design and nothing was putting them back down.
			//So: if the channel ended and they are STILL downed, put them back on the floor.
			//Guarded on coop_dbno_active so a successful revive - which clears that flag before reaching
			//here - is never dragged back down.
			if( local.player != NULL && local.player.flags["coop_dbno_active"] == 1 ){
				local.player forcelegsstate DBNO_IDLE
			}

			if( local.cancelled == 1 ){
				local.player.flags["coop_dbno_healing"] = NIL
				ihuddraw_alpha  local.player 33 0
				ihuddraw_alpha  local.player 34 0
				ihuddraw_alpha  local.player 35 0
				ihuddraw_alpha  local.player 38 0
				ihuddraw_string local.player 33 ""
				ihuddraw_string local.player 38 ""
				local.start_origin = local.player.origin
				local.cancelled    = 0
			}
			else{
				local.player.flags["coop_dbno_healing"] = NIL
				// [209] killed mid-channel? If the kit was at least half applied when the killing
				// shot landed, it still takes effect: consume the kit and stand the player back up
				// where they fell (dbno.scr::dbno_corpse_revive, coop_dbnoCorpseRevive window).
				if( local.player != NULL && local.hold_frames >= 100 && local.player.flags["coop_dbno_corpseTime"] != NIL ){
					if( !isAlive local.player ){
						local.player.flags["coop_medkits"] = local.player.flags["coop_medkits"] - 1
						thread coop_mod/dbno.scr::dbno_corpse_revive local.player
					}
				}
				ihuddraw_rect   local.player 35 220 -55 0 16
				ihuddraw_alpha  local.player 34 0
				ihuddraw_alpha  local.player 35 0
				ihuddraw_alpha  local.player 38 0
				ihuddraw_string local.player 33 ""
				ihuddraw_string local.player 38 ""
			}
		}
		else{
			local.start_origin = local.player.origin
			local.hold_frames  = 0
			ihuddraw_alpha  local.player 33 0
			ihuddraw_alpha  local.player 34 0
			ihuddraw_alpha  local.player 35 0
			ihuddraw_alpha  local.player 38 0
			ihuddraw_string local.player 33 ""
			ihuddraw_string local.player 38 ""
		}
		waitframe
	}

	local.player.flags["coop_dbno_healing"] = NIL
	//[user 2026-08-10] NULL guard: this teardown runs AFTER the display loop above, and that
	//loop exits precisely BECAUSE the player went away (disconnect / spectate / map change).
	//Measured in the 2-player test as "Script Error : Player entity is NULL for ihuddraw_*".
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 33 0
		ihuddraw_alpha  local.player 34 0
		ihuddraw_alpha  local.player 35 0
		ihuddraw_alpha  local.player 38 0
		ihuddraw_alpha  local.player 39 0
		ihuddraw_string local.player 33 ""
		ihuddraw_string local.player 38 ""
	}
}end


coop_scan_health_entities:{
	waitframe

	local.maxent = int(getcvar("maxentities"))
	level.coop_health_ent_count = 0
	local.i = 0
	while( local.i < local.maxent ){
		local.ent = getentbyentnum local.i
		if( local.ent != NULL ){
			if( local.ent.model != NIL ){
				local.is_health = 0
				if( local.ent.model == "models/items/item_25_healthbox.tik" ){ local.is_health = 1 }
				if( local.ent.model == "models/items/item_50_healthbox.tik" ){ local.is_health = 1 }
				if( local.ent.model == "models/items/item_100_healthbox.tik" ){ local.is_health = 1 }
				if( local.ent.model == "models/items/dm_50_healthbox.tik" ){ local.is_health = 1 }
				if( local.is_health == 1 ){
					level.coop_health_ent_count++
					level.coop_health_ents[level.coop_health_ent_count]        = local.i
					level.coop_health_ent_origins[level.coop_health_ent_count] = local.ent.origin
				}
			}
		}
		local.i++
	}

	local.dbg_count = level.coop_health_ent_count
	if( local.dbg_count == NIL ){ local.dbg_count = 0 }
	iprintlnbold ("coop_scan: Found " + local.dbg_count + " health packs")
}end


