// Coop Side Objectives (optional / secondary)
// chrissstrahl-style coop objective wiring, added for HZM coop.
//
// Wires two OPTIONAL secondary objectives into every map that runs the
// coop officer/radio system (coop_mod/officer.scr):
//
//   coop_so1: "Eliminate the High-Ranking Officer"  (completes on officer death)
//   coop_so2: "Destroy the Radio to Stop Reinforcements" (completes on radio destroy)
//
// These are NEVER required to finish a mission. They only drive the dedicated
// secondary lines in the coop objectives HUD (ui/coop_objectives.urc).
//
// IMPORTANT - why dedicated coop_so1/coop_so2 cvars instead of the shared
// coop_o1..coop_o8 objective slots:
//   A trilogy-wide review found map PRIMARY objectives can fill many of the 8
//   shared slots (m4l2 uses 7, e3l2 uses 7/8/9, m4l3 reaches 5) and completed
//   objectives stay drawn. Using shared slots 7/8 caused both visual overlap and
//   a hard cvar collision (e.g. e3l2/m4l2 write coop_o7/coop_o8 for their own
//   primaries). So the side objectives live on their OWN cvars (coop_so1/coop_so2)
//   with their OWN widgets anchored BELOW all 8 primary slots - they can never
//   overlap or collide with any map's objectives. We also no longer call
//   global/objectives.scr::add_objectives (which would write the shared coop_oN
//   vars + native objective slots); these are purely the custom HUD lines.
//
// Status values: 1 = hidden, 2 = active (in progress), 3 = completed.

//=========================================================================
// Push one dedicated secondary line (local.so = 1 officer / 2 radio) to every
// connected player's HUD by setting its coop_so<N> cvars directly.
//   coop_soNd = line visible, coop_soNa = active(white) text, coop_soNs = checkbox.
//=========================================================================
coop_obj_push local.so local.status local.text:{
	local.dval = 1
	local.aval = 0
	local.sval = 0
	if( local.status == 2 ){			// active / in progress
		local.aval = 1
		local.sval = 0
	} else if( local.status == 3 ){		// completed
		local.aval = 0
		local.sval = 1
	} else {							// hidden
		local.dval = 0
	}

	for( local.p = 1; local.p <= $player.size; local.p++ ){
		$player[local.p] stufftext ( "set coop_so" + local.so + "d " + local.dval )
		$player[local.p] stufftext ( "set coop_so" + local.so + "a " + local.aval )
		$player[local.p] stufftext ( "set coop_so" + local.so + "s " + local.sval )
		$player[local.p] stufftext ( "set coop_so" + local.so + " " + local.text )
	}
}end

//=========================================================================
// [user 08-08] Brief left-hand card announcing a newly assigned objective. The mission
// objectives panel (o-key) is opt-in and easy to never open, so a first-time objective could
// be assigned with nothing on screen to say so - "I kept failing the mission and I have no
// idea why". This is the nudge, not a replacement for the panel.
//
// SLOTS 135-149, taken from the block _research/hud_slot_map.md reserves for mid overlays.
// Two reasons that block and not a lower one: nothing else can be on screen in it (bug-553
// was the debrief card and the XP popup fighting over 62-69), and >=100 is FADE-EXEMPT, so a
// toast still shows if the HUD has already faded out after five quiet seconds - which is
// exactly when a new objective tends to land.
//=========================================================================
coop_obj_toast local.player local.key local.text:{
	if( local.player == NULL ){ end }
	if( local.text == NIL || local.text == "" ){ end }
	if( getcvar( "coop_objToast" ) == "0" ){ end }

	//once per objective per player. NIL and 0 both mean "not shown yet".
	if( local.player.flags["coop_objToastSeen" + local.key] == 1 ){ end }
	local.player.flags["coop_objToastSeen" + local.key] = 1

	//queue rather than overlap: two objectives assigned together would otherwise draw on top of
	//each other in the same slots.
	while( level.coop_objToastBusy == 1 ){
		wait 0.5
		if( local.player == NULL ){ end }
	}
	level.coop_objToastBusy = 1

	local.hold = float( getcvar "coop_objToastTime" )
	if( local.hold < 1 ){ local.hold = 6 }

	//heading
	ihuddraw_virtualsize local.player 135 1
	ihuddraw_align       local.player 135 left top
	ihuddraw_font        local.player 135 "facfont-20"
	ihuddraw_color       local.player 135 1 0.85 0.4
	ihuddraw_rect        local.player 135 18 150 300 22
	ihuddraw_string      local.player 135 "NEW OBJECTIVE"
	ihuddraw_alpha       local.player 135 1

	//the objective itself, wrapped with the panel s own wrapper rather than a second one
	local.w = waitthread coop_objWrap local.text 34
	if( local.player == NULL ){ level.coop_objToastBusy = 0; end }

	local.line = 0
	while( local.line < local.w.size ){
		if( local.line > 5 ){ break }	//slots 136-141 only; anything longer is the panel s job
		local.slot = 136 + local.line
		ihuddraw_virtualsize local.player local.slot 1
		ihuddraw_align       local.player local.slot left top
		ihuddraw_font        local.player local.slot "courier-16"
		ihuddraw_color       local.player local.slot 1 1 1
		ihuddraw_rect        local.player local.slot 18 ( 174 + ( local.line * 18 ) ) 300 18
		ihuddraw_string      local.player local.slot local.w[local.line + 1]
		ihuddraw_alpha       local.player local.slot 1
		local.line++
	}

	//[user 08-08] tracking hint. The objectives panel is a toggle most players never discover, so
	//the toast that tells you about a new objective is the natural place to mention it. Named by
	//ACTION rather than a hard-coded key, because it is rebindable and printing "[O]" at someone who
	//moved it is worse than saying nothing.
	ihuddraw_virtualsize local.player 142 1
	ihuddraw_align       local.player 142 left top
	ihuddraw_font        local.player 142 "verdana-12"
	ihuddraw_color       local.player 142 0.75 0.75 0.75
	ihuddraw_rect        local.player 142 18 ( 174 + ( local.line * 18 ) + 6 ) 300 16
	//[user 08-08] bug-1593 - name the ACTUAL key. Only the client knows its own binds, so it
	//publishes the answer as the USERINFO cvar coop_objKey (CL_CoopObjKey_f scans the bind table
	//for "coop_obj" and is re-run on every bind/unbind) - the same userinfo channel challenges.scr
	//already reads. Falls back to naming the ACTION when nothing is bound, which is also what a
	//player running an older client will see, since their exe never sets the cvar.
	local.k = info_valueforkey local.player.userinfo "coop_objKey"
	if( local.k == NIL || local.k == "" ){
		ihuddraw_string      local.player 142 "Bind Coop Objectives in Controls to track them"
	}else{
		ihuddraw_string      local.player 142 ( "Press [" + local.k + "] to track your objectives" )
	}
	ihuddraw_alpha       local.player 142 1

	wait local.hold

	//tear down every slot we touched, whether or not the player survived the hold
	if( local.player != NULL ){
		//[user 08-08] bug-1592 - was `<= 141`, but the tracking hint draws on 142, so it was never
		//cleared and stayed burned on screen for the rest of the map. The teardown range must cover
		//EVERY slot this function can write; 135 heading, 136-141 text, 142 hint.
		local.s = 135
		while( local.s <= 142 ){
			ihuddraw_alpha  local.player local.s 0
			ihuddraw_string local.player local.s ""
			local.s++
		}
	}
	level.coop_objToastBusy = 0
}end


//=========================================================================
// Push one dedicated secondary line to a SINGLE player's HUD (late-join /
// respawn replay). Same cvar writes as coop_obj_push but targeted at one ent.
//=========================================================================
coop_obj_push_one local.ent local.so local.status local.text:{
	if( local.ent == NULL ){ end }
	local.dval = 1
	local.aval = 0
	local.sval = 0
	if( local.status == 2 ){			// active / in progress
		local.aval = 1
		local.sval = 0
	} else if( local.status == 3 ){		// completed
		local.aval = 0
		local.sval = 1
	} else {							// hidden
		local.dval = 0
	}

	local.ent stufftext ( "set coop_so" + local.so + "d " + local.dval )
	local.ent stufftext ( "set coop_so" + local.so + "a " + local.aval )
	local.ent stufftext ( "set coop_so" + local.so + "s " + local.sval )
	local.ent stufftext ( "set coop_so" + local.so + " " + local.text )
}end


//=========================================================================
// FIX 1 / FIX 2: re-push the CURRENT side-objective state to one player.
// Used for late join (player connects after the reassert window) and for
// respawn (obj_setup.cfg re-seeds coop_so* = ""/0 every spawn, and
// obj_reset.cfg never restores them). Only acts when the side objectives
// were actually registered for this map (honors the no-boss gating).
//=========================================================================
coop_obj_repush_player local.ent:{
	if( local.ent == NULL ){ end }
	if( level.coop_sideObjReg != 1 ){ end }

	// [user 07-10] only show the OFFICER line if an officer actually exists (or existed and was
	// killed). Some maps have a non-"none" officer policy but never spawn a boss - that left a
	// permanently-ACTIVE, never-completable "Eliminate the High-Ranking Officer" line.
	if( level.coop_officer != NULL || level.coop_sideObjOfficerDone == 1 ){
		if( level.coop_sideObjOfficerDone == 1 ){
			waitthread coop_obj_push_one local.ent 1 3 "Eliminate the High-Ranking Officer"
		} else {
			waitthread coop_obj_push_one local.ent 1 2 "Eliminate the High-Ranking Officer"
		}
	}
	//[user 08-08] gated like the officer line above. Ungated, this re-pushed the radio ACTIVE on
	//every respawn and late join - which is what made a mission reload "default to destroying the
	//officer's radio".
	if( level.coop_sideObjRadioDone == 1 ){
		waitthread coop_obj_push_one local.ent 2 3 "Destroy the Radio to Stop Reinforcements"
	} else if( level.coop_sideObjOfficerDone == 1 ){
		waitthread coop_obj_push_one local.ent 2 2 "Destroy the Radio to Stop Reinforcements"
	} else {
		waitthread coop_obj_push_one local.ent 2 1 "Destroy the Radio to Stop Reinforcements"
	}
}end


//=========================================================================
// FIX 2 (respawn) + FIX 1 (late join): one watcher per level that re-pushes
// the side lines to any player every time they (re)spawn. Started once from
// coop_obj_register, so it only runs on maps that actually show the lines.
// The short wait lets the per-player obj_setup.cfg/obj_reset.cfg (which wipe
// coop_so*) finish first, so our re-push wins the race.
//=========================================================================
coop_obj_player_watcher:{
	if( level.coop_sideObjWatcher == 1 ){
		end
	}
	level.coop_sideObjWatcher = 1

	while( 1 ){
		level waittill playerspawn
		local.sp = parm.other
		if( local.sp != NULL ){
			local.sp thread coop_obj_repush_delayed
		}
	}
}end


// Helper: wait out the spawn-time obj_setup.cfg reset, then re-push to self.
coop_obj_repush_delayed:{
	wait 1
	waitthread coop_obj_repush_player self
}end


//=========================================================================
// Register both side objectives as ACTIVE, a few seconds into the map (after each
// player's objectives-HUD setup has run). Threaded so it never blocks the officer
// spawn sequence.
//=========================================================================
coop_obj_register_delayed:{
	wait 3

	// FIX 3 (no-boss gating): the two side objectives are the officer + radio lines, so
	// they must only be shown on maps that will actually spawn an officer. Decide the
	// same way officer.scr::coop_officer_init does, BEFORE pushing the lines active:
	//   policy != "none"  AND  coop_feature_boss != 0.
	// coop_officer_policy and getAnchor are both pure (only read level.coop_mapname and
	// set level vars) and idempotent, so calling them here is safe -- officer.scr calls
	// them again later with the same result. On no-officer maps (t1l1, t2l2, t3l2,
	// training, etc.) we leave the side lines hidden instead of stuck permanently ACTIVE.
	// If the boss ever DOES spawn (e.g. a marginal map that finds infrastructure), the
	// register call at officer.scr::coop_officer_spawn still fires and shows the lines.
	local.policy = exec coop_mod/officer.scr::coop_officer_policy
	if( local.policy == "none" ){
		if( !level.coop_lobbyMap ){ iprintlnbold "OBJ: side objectives gated off (officer policy NONE)" }	// silent in the lobby
		end
	}
	// Populate level.coop_feature_boss for this map (getAnchor sets it; default 1).
	exec coop_mod/officer_positions.scr::getAnchor
	if( level.coop_feature_boss == 0 ){
		if( !level.coop_lobbyMap ){ iprintlnbold "OBJ: side objectives gated off (coop_feature_boss=0)" }	// silent in the lobby
		end
	}

	//[user 08-08] bug-1594 - THE RULE, stated universally: these two lines ARE the officer
	//encounter, so they must never appear on a mission where no officer spawns. The policy check
	//above was not sufficient - a map can pass it and still never place a boss (no anchor, no
	//suitable infrastructure), which is exactly how two permanently-ACTIVE, never-completable lines
	//ended up on missions that have nothing to do with an officer. Requiring a live officer here
	//costs nothing, because officer.scr::coop_officer_spawn (officer.scr:607) calls coop_obj_register
	//directly the moment one exists - so the lines appear precisely when the encounter does, on any
	//map, with no per-map list to maintain. The officerDone case still registers, so a completed
	//encounter keeps its lines after the boss is gone.
	if( level.coop_officer == NIL || level.coop_officer == NULL ){
		if( level.coop_sideObjOfficerDone != 1 ){ end }
	}

	waitthread coop_obj_register
}end


coop_obj_register:{
	if( level.coop_sideObjReg == 1 ){
		end
	}
	level.coop_sideObjReg = 1

	if( level.coop_officer != NULL || level.coop_sideObjOfficerDone == 1 ){
		waitthread coop_obj_push 1 2 "Eliminate the High-Ranking Officer"
	}
	//[user 08-08] the radio line used to be pushed ACTIVE here unconditionally, so from map start -
	//and on every reload - "Destroy the Radio to Stop Reinforcements" read as the current objective,
	//before the officer was even engaged. You cannot do it until he is dead (officer.scr only exposes
	//the radio then: "Plant explosives on the radio..."), so it pointed players at something the
	//mission had not unlocked yet. Hidden until coop_obj_officer_done flips it.
	local.rstat = 1
	if( level.coop_sideObjOfficerDone == 1 ){ local.rstat = 2 }
	waitthread coop_obj_push 2 local.rstat "Destroy the Radio to Stop Reinforcements"

	// Re-assert a few times: a per-player obj_setup.cfg that runs slightly AFTER this
	// initial push (spawn timing race) resets the coop_so cvars and would blank the lines.
	thread coop_obj_reassert

	// FIX 1/FIX 2: keep the lines correct for the rest of the map. The reassert loop
	// above only covers the first ~13s, so start a permanent watcher that re-pushes the
	// current state to any player every time they (re)spawn (covers late join AND respawn).
	thread coop_obj_player_watcher
}end


//=========================================================================
// Re-push the active side objectives a few times so a late per-player obj_setup.cfg
// reset can't leave the HUD lines blank. Respects completion status.
//=========================================================================
coop_obj_reassert:{
	local.n = 0
	while( local.n < 5 ){
		wait 2
		if( level.coop_officer != NULL || level.coop_sideObjOfficerDone == 1 ){
			if( level.coop_sideObjOfficerDone == 1 ){
				waitthread coop_obj_push 1 3 "Eliminate the High-Ranking Officer"
			} else {
				waitthread coop_obj_push 1 2 "Eliminate the High-Ranking Officer"
			}
		}
		if( level.coop_sideObjRadioDone == 1 ){
			waitthread coop_obj_push 2 3 "Destroy the Radio to Stop Reinforcements"
		} else {
			//[user 08-08] gated - see the registration site above.
			if( level.coop_sideObjOfficerDone == 1 ){
				waitthread coop_obj_push 2 2 "Destroy the Radio to Stop Reinforcements"
			}
		}
		local.n = local.n + 1
	}
}end


//=========================================================================
// Mark the officer side objective complete (status 3). Safe to call once.
//=========================================================================
coop_obj_officer_done:{
	if( level.coop_sideObjOfficerDone == 1 ){
		end
	}
	level.coop_sideObjOfficerDone = 1

	if( level.coop_sideObjReg != 1 ){
		waitthread coop_obj_register
	}

	// [302] HZM XP - side-obj pushes route through global/objectives.scr too; this flag stops
	// the generic primary-objective award from double-paying (officer XP comes from the death
	// monitor, radio XP from coop_obj_radio_done)
	level.coop_xp_sideObjPush = 1
	waitthread coop_obj_push 1 3 "Eliminate the High-Ranking Officer"
	//[user 08-08] and NOW the radio becomes a real objective - the moment it is actually doable,
	//and the moment officer.scr tells the player to go plant explosives on it.
	if( level.coop_sideObjRadioDone != 1 ){
		waitthread coop_obj_push 2 2 "Destroy the Radio to Stop Reinforcements"
	}
	level.coop_xp_sideObjPush = 0
}end


//=========================================================================
// Mark the radio side objective complete (status 3). Safe to call once.
//=========================================================================
coop_obj_radio_done:{
	if( level.coop_sideObjRadioDone == 1 ){
		end
	}
	level.coop_sideObjRadioDone = 1

	if( level.coop_sideObjReg != 1 ){
		waitthread coop_obj_register
	}

	thread coop_mod/xp.scr::xp_radio_done	// [302] HZM XP - team award (75)
	thread coop_mod/challenges.scr::chal_radio_done	// [303] HZM CHALLENGES - radio side-objective task
	level.coop_xp_sideObjPush = 1
	waitthread coop_obj_push 2 3 "Destroy the Radio to Stop Reinforcements"
	level.coop_xp_sideObjPush = 0
}end


//=========================================================================
// [user 07-11] STALE-OBJECTIVE RECONCILE. The primary-objective client cvars (coop_o1..o8) persist across
// map loads; a map with FEWER objectives than the previous one never overwrites the leftover higher slots,
// and the manager's own obj_reset can be raced/skipped - so a previous mission's objective (e.g. m5l1b's
// "Steal the King Tiger" on coop_o4) can linger on this map's panel. Threaded per (re)spawn from
// player.scr::manageAliveSpawning. A few seconds in (after the map's add_objectives + the manager settle),
// it HIDES every slot the CURRENT map is NOT actively using (level.coopObjectiveN status <= 1 = hidden/
// unset). Active/completed slots (status 2/3) are left alone, and a legit later activation still shows via
// add_objectives, so this only ever clears leftovers - it can never hide a real objective.
//=========================================================================
coop_obj_reconcile local.player:{
	if( local.player == NULL ){ end }
	//[user 07-12] THREE passes (~4s/8s/12s) instead of one: a single 6s pass could be raced by a
	//late objective push (or a healed sender, see global/objectives.scr) re-showing a stale row
	//after the pass already ran. Hides are never permanent - a real add_objectives re-shows the slot.
	local.reconcilePass = 1
	while( local.reconcilePass <= 3 ){
	wait 4
	if( local.player == NULL ){ end }

	if( level.coopObjective1 == NIL ){ level.coopObjective1 = 0 }
	if( level.coopObjective2 == NIL ){ level.coopObjective2 = 0 }
	if( level.coopObjective3 == NIL ){ level.coopObjective3 = 0 }
	if( level.coopObjective4 == NIL ){ level.coopObjective4 = 0 }
	if( level.coopObjective5 == NIL ){ level.coopObjective5 = 0 }
	if( level.coopObjective6 == NIL ){ level.coopObjective6 = 0 }
	if( level.coopObjective7 == NIL ){ level.coopObjective7 = 0 }
	if( level.coopObjective8 == NIL ){ level.coopObjective8 = 0 }

	if( level.coopObjective1 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_1hidden.cfg" ) }
	if( level.coopObjective2 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_2hidden.cfg" ) }
	if( level.coopObjective3 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_3hidden.cfg" ) }
	if( level.coopObjective4 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_4hidden.cfg" ) }
	if( level.coopObjective5 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_5hidden.cfg" ) }
	if( level.coopObjective6 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_6hidden.cfg" ) }
	if( level.coopObjective7 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_7hidden.cfg" ) }
	if( level.coopObjective8 <= 1 ){ local.player stufftext ( "exec ui/coop_objectives/obj_8hidden.cfg" ) }

	local.reconcilePass++
	}
}end


//=========================================================================
// [user 07-11] SCRIPT-DRAWN OBJECTIVES PANEL with real WORD-WRAP + dynamic row spacing. MOHAA's URC UILabel
// can't wrap, so a long objective was cut off (or would overlap the next row). This ihuddraw panel reads the
// same data (level.coopObjectiveN status + level.coopObjectiveNText), wraps each objective to fit the width,
// and stacks them with a Y offset that accounts for each objective's line count - so they never overlap.
// Slots 175-215 (see _research/hud_slot_map.md). coop_objPanel 1 = this panel (URC primary suppressed in
// global/objectives.scr::coop_objectivesSendPlayer); coop_objPanel 0 = the old single-line URC panel.
//=========================================================================

// Word-wrap: return an array of lines (1-indexed), each <= local.maxc chars, split at word boundaries.
// MOHAA string char access is 0-indexed; .size is the length.
coop_objWrap local.text local.maxc:{
	local.nlines = 0
	local.cur = ""
	local.word = ""
	local.len = local.text.size
	local.i = 0
	while( local.i <= local.len ){
		if( local.i < local.len ){
			local.ch = local.text[local.i]
		} else {
			local.ch = " "		// force a flush of the final word
		}
		if( local.ch == " " ){
			if( local.word != "" ){
				local.trial = local.word
				if( local.cur != "" ){ local.trial = local.cur + " " + local.word }
				if( local.trial.size <= local.maxc ){
					local.cur = local.trial
				} else {
					if( local.cur != "" ){
						local.nlines++
						local.lines[local.nlines] = local.cur
					}
					local.cur = local.word		// word starts the next line (an over-long single word just overflows)
				}
				local.word = ""
			}
		} else {
			local.word = local.word + local.ch
		}
		local.i++
	}
	if( local.cur != "" ){
		local.nlines++
		local.lines[local.nlines] = local.cur
	}
	if( local.nlines == 0 ){
		local.lines[1] = local.text
	}
}end local.lines


// Redraw the panel for one player from the current objective state.
coop_objPanel_refresh local.player:{
	if( local.player == NULL ){ end }

	// clear the whole panel slot range first (156-215: bg plates, title bar, checkboxes, text)
	local.s = 156
	while( local.s <= 215 ){
		ihuddraw_alpha  local.player local.s 0
		ihuddraw_string local.player local.s ""
		local.s++
	}
	if( getcvar "coop_objPanel" == "0" ){ end }

	// copy the 8 status + text vars into 0-indexed arrays (no dynamic member access in GameScript)
	local.st[0] = level.coopObjective1
	local.st[1] = level.coopObjective2
	local.st[2] = level.coopObjective3
	local.st[3] = level.coopObjective4
	local.st[4] = level.coopObjective5
	local.st[5] = level.coopObjective6
	local.st[6] = level.coopObjective7
	local.st[7] = level.coopObjective8
	local.tx[0] = level.coopObjective1Text
	local.tx[1] = level.coopObjective2Text
	local.tx[2] = level.coopObjective3Text
	local.tx[3] = level.coopObjective4Text
	local.tx[4] = level.coopObjective5Text
	local.tx[5] = level.coopObjective6Text
	local.tx[6] = level.coopObjective7Text
	local.tx[7] = level.coopObjective8Text

	local.any = 0
	local.oi = 0
	while( local.oi <= 7 ){
		if( local.st[local.oi] != NIL && local.st[local.oi] >= 2 && local.tx[local.oi] != NIL && local.tx[local.oi] != "" ){ local.any = 1 }
		local.oi++
	}
	if( local.any == 0 ){ end }

	// title bar: grey plate + "Mission Objectives:" + separator line - matches ui/coop_objectives.urc
	ihuddraw_virtualsize local.player 156 1
	ihuddraw_align       local.player 156 left top
	ihuddraw_shader      local.player 156 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 156 0.2 0.2 0.2
	ihuddraw_rect        local.player 156 10 20 550 24
	ihuddraw_alpha       local.player 156 0.8

	ihuddraw_virtualsize local.player 157 1
	ihuddraw_align       local.player 157 left top
	ihuddraw_shader      local.player 157 "textures/hud/coop_bar_white"
	ihuddraw_color       local.player 157 0.7 0.7 0.7
	ihuddraw_rect        local.player 157 10 43 550 1
	ihuddraw_alpha       local.player 157 0.6

	ihuddraw_virtualsize local.player 175 1
	ihuddraw_align       local.player 175 left top
	ihuddraw_font        local.player 175 "courier-16"
	ihuddraw_color       local.player 175 1 1 1
	ihuddraw_rect        local.player 175 14 22 540 20
	ihuddraw_string      local.player 175 "Mission Objectives:"
	ihuddraw_alpha       local.player 175 1

	local.curObj = level.coopCurrentObjective
	if( local.curObj == NIL ){ local.curObj = 0 }

	local.y  = 50
	local.bx = 158		// row background-plate slot pool (158-165), drawn BEHIND text (lower slot = behind)
	local.cb = 176		// checkbox slot pool (176-183)
	local.tl = 184		// text-line slot pool (184-215)
	local.oi = 0
	while( local.oi <= 7 ){
		if( local.st[local.oi] != NIL && local.st[local.oi] >= 2 && local.tx[local.oi] != NIL && local.tx[local.oi] != "" ){
			// wrap first so we know how tall this objective's row (and its grey plate) needs to be
			local.lines = waitthread coop_objWrap local.tx[local.oi] 55
			local.rowH  = ( local.lines.size * 18 ) + 4
			local.by    = local.y - 2

			// grey background plate behind the whole (possibly multi-line) row
			if( local.bx <= 165 ){
				ihuddraw_virtualsize local.player local.bx 1
				ihuddraw_align       local.player local.bx left top
				ihuddraw_shader      local.player local.bx "textures/hud/coop_bar_white"
				ihuddraw_color       local.player local.bx 0.2 0.2 0.2
				ihuddraw_rect        local.player local.bx 10 local.by 550 local.rowH
				ihuddraw_alpha       local.player local.bx 0.8
				local.bx++
			}

			// checkbox: filled when completed, empty when active
			if( local.cb <= 183 ){
				if( local.st[local.oi] == 3 ){
					ihuddraw_shader local.player local.cb "textures/OBJECTIVES/filledbox.tga"
				} else {
					ihuddraw_shader local.player local.cb "textures/OBJECTIVES/emptybox.tga"
				}
				ihuddraw_virtualsize local.player local.cb 1
				ihuddraw_align       local.player local.cb left top
				ihuddraw_color       local.player local.cb 1 1 1
				ihuddraw_rect        local.player local.cb 12 local.y 16 16
				ihuddraw_alpha       local.player local.cb 1
				local.cb++
			}

			// colour: completed = grey, current = yellow, active = white
			local.colR = 1
			local.colG = 1
			local.colB = 1
			if( local.st[local.oi] == 3 ){
				local.colR = 0.6
				local.colG = 0.6
				local.colB = 0.6
			} else if( ( local.oi + 1 ) == local.curObj ){
				local.colB = 0
			}

			local.li = 1
			while( local.li <= local.lines.size ){
				if( local.tl <= 215 ){
					ihuddraw_virtualsize local.player local.tl 1
					ihuddraw_align       local.player local.tl left top
					ihuddraw_font        local.player local.tl "courier-16"
					ihuddraw_color       local.player local.tl local.colR local.colG local.colB
					ihuddraw_rect        local.player local.tl 36 local.y 604 18
					ihuddraw_string      local.player local.tl local.lines[local.li]
					ihuddraw_alpha       local.player local.tl 1
					local.tl++
				}
				local.y = local.y + 18
				local.li++
			}
			local.y = local.y + 6		// gap between objectives
		}
		local.oi++
	}
}end


// Per-player watcher (one guarded instance, started per (re)spawn from player.scr::manageAliveSpawning).
// Redraws only when the objective state changes (status / current / count), so it is cheap.
coop_objPanel_monitor local.player:{
	if( local.player == NULL ){ end }
	if( local.player.coop_objPanelRun == 1 ){ end }
	local.player.coop_objPanelRun = 1
	local.lastSig = "init"
	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		if( getcvar "coop_objPanel" != "0" && level.coopObjectivesManager == 1 ){
			local.c = level.coopCurrentObjective
			if( local.c == NIL ){ local.c = 0 }
			local.sig = "" + local.c + "_" + level.coopObjective1 + "_" + level.coopObjective2 + "_" + level.coopObjective3 + "_" + level.coopObjective4 + "_" + level.coopObjective5 + "_" + level.coopObjective6 + "_" + level.coopObjective7 + "_" + level.coopObjective8
			if( local.sig != local.lastSig ){
				local.lastSig = local.sig
				waitthread coop_objPanel_refresh local.player
			}
		}
		else if( getcvar "coop_objPanel" == "0" && local.lastSig != "panel_off" ){
			//[user 07-12] panel disabled (default now) - clear our slots once so a live toggle can
			//never leave the deprecated panel on screen alongside the URC menu (the double-display bug)
			local.lastSig = "panel_off"
			local.s = 156
			while( local.s <= 215 ){
				ihuddraw_alpha  local.player local.s 0
				ihuddraw_string local.player local.s ""
				local.s++
			}
		}
		wait 0.5
	}
	if( local.player != NULL ){
		local.player.coop_objPanelRun = NIL
		local.s = 156
		while( local.s <= 215 ){
			ihuddraw_alpha local.player local.s 0
			local.s++
		}
	}
}end

//=========================================================================
// [user 08-08] Toast one PRIMARY objective to everyone. Hooked from
// global/objectives.scr::add_objectives, which is the channel the maps' own objectives use
// (exec global/obj.scr -> add_objectives). The first version of this was hooked to
// coop_obj_push instead - the coop SIDE-objective bus - which announced the officer/radio
// lines and stayed silent on the actual mission objective. Exactly backwards.
//
// Keyed on the objective INDEX, not its text, so a map that republishes the same line with a
// changing count ("Destroy the Nebelwerfers [3 remaining]") announces once and then updates
// quietly.
//=========================================================================
coop_obj_toast_all local.index local.text:{
	if( local.text == NIL || local.text == "" ){ end }
	if( $player == NULL || $player.size < 1 ){ end }

	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){
			if( $player[local.i].flags["coop_isActive"] == 1 ){
				thread coop_obj_toast $player[local.i] ( "m" + local.index ) local.text
			}
		}
		local.i++
	}
}end
