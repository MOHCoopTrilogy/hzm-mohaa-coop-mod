//GENERATED by docs/tools/gen_push_from_bsp.py -- DO NOT HAND-EDIT (regenerate instead).
//Auto-derived MP Push spawn groups + battle-line zones for campaign maps with no ViPER/Base-Assault
//source data. Harvested from each map's BSP info_pathnode cloud (the AI navmesh). Approximate but
//playable; consumed by coop_mod/mp_push.scr exactly like the ViPER-authored mp_push_maps.scr data.
//Wired from mp_push.scr::push_seedAuthored as the fallback when the ViPER seed returns 0 zones.
//coop_mpRun-guarded; a compile canary on every MP boot.
alive:{
	end 1
}end

//Seed the BSP-derived frontline for the current map. Sets level.coop_mpPushAuthored[..] + N; returns N.
seed local.map:{
	if( level.coop_mpRun != 1 ){ end 0 }
	switch( local.map ){
		case "e1l1":
			waitthread seed_e1l1
			break
		case "e3l1":
			waitthread seed_e3l1
			break
		case "e3l2":
			waitthread seed_e3l2
			break
		case "e3l3":
			waitthread seed_e3l3
			break
		case "m1l3a":
			waitthread seed_m1l3a
			break
		case "m1l3b":
			waitthread seed_m1l3b
			break
		case "m2l3":
			waitthread seed_m2l3
			break
		case "m3l1b":
			waitthread seed_m3l1b
			break
		case "m5l2a":
			waitthread seed_m5l2a
			break
		case "m5l2b":
			waitthread seed_m5l2b
			break
		case "m5l3":
			waitthread seed_m5l3
			break
		case "t1l1":
			waitthread seed_t1l1
			break
		case "t1l2":
			waitthread seed_t1l2
			break
		case "t1l3":
			waitthread seed_t1l3
			break
		case "t2l1":
			waitthread seed_t2l1
			break
		case "t2l3":
			waitthread seed_t2l3
			break
		case "t2l4":
			waitthread seed_t2l4
			break
		case "t3l1":
			waitthread seed_t3l1
			break
	}
	end level.coop_mpPushAuthoredN
}end level.coop_mpPushAuthoredN

