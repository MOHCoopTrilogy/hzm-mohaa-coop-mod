//========================================================================================
// HZM Coop - BUILD MODE : placeable SOUND EMITTERS (catalog + SOUND-mode control bus).
// Companion to coop_mod/buildmode.scr. Aliases live in ubersound/coop_buildsounds.scr
// (auto-registered, all-maps). Full design: _research/build_mode_sounds.md.
//
// A placed emitter is an invisible script_model ("fx/dummy.tik") carrying either a LOOPSOUND
// (positional, all players hear it via the replicated loopSound entity-state - NO "levelwide"
// so it keeps 3D falloff) or a timed ONE-SHOT (playsound on a wait loop). Build mode toggles
// level.coop_build_mode object<->sound ("\" bind); buildmode.scr delegates the numpad bus here.
//========================================================================================

//=========================================================================
// helper: set one catalog cell (alias, display, default volume, default minDist, loop|oneshot)
//=========================================================================
snd_add local.c local.i local.alias local.disp local.vol local.min local.type:{
//=========================================================================
	level.coop_build_snditem[local.c][local.i] = local.alias
	level.coop_build_snddisp[local.c][local.i] = local.disp
	level.coop_build_sndvol0[local.c][local.i] = local.vol
	level.coop_build_sndmin0[local.c][local.i] = local.min
	level.coop_build_sndtype0[local.c][local.i] = local.type
}end


//=========================================================================
// Build the parallel SOUND catalog (mirrors buildmode_catalog.scr / actor_catalog_init).
// Called once from buildmode.scr::coop_build_monitor. Idempotent per map load.
//=========================================================================
sound_catalog_init:{
//=========================================================================
	if( level.coop_build_sndReady == 1 ){ end }

	level.coop_build_sndcatname[1] = "AMBIENCE / NATURE"
	waitthread snd_add 1 1 "coop_snd_wind_trees" "Wind in Trees" 1.0 400 "loop"
	waitthread snd_add 1 2 "coop_snd_wind_strong" "Strong Wind" 1.0 300 "loop"
	waitthread snd_add 1 3 "coop_snd_wind_weak" "Light Breeze" 1.0 400 "loop"
	waitthread snd_add 1 4 "coop_snd_crickets" "Crickets" 1.0 200 "loop"
	waitthread snd_add 1 5 "coop_amb_forest_night" "Forest (night)" 1.0 300 "loop"
	waitthread snd_add 1 6 "coop_amb_night_calm" "Calm Night" 1.0 300 "loop"
	waitthread snd_add 1 7 "coop_amb_country" "Countryside" 1.0 300 "loop"
	level.coop_build_snditemcount[1] = 7

	level.coop_build_sndcatname[2] = "WEATHER"
	waitthread snd_add 2 1 "coop_snd_rain_ext" "Rain (outside)" 1.0 300 "loop"
	waitthread snd_add 2 2 "coop_snd_rain_int" "Rain (inside)" 1.0 200 "loop"
	waitthread snd_add 2 3 "coop_snd_rain_roof" "Rain on Roof" 1.0 200 "loop"
	waitthread snd_add 2 4 "coop_snd_rain_window" "Rain on Window" 1.0 150 "loop"
	waitthread snd_add 2 5 "coop_rain_drip" "Water Dripping" 1.0 160 "loop"
	waitthread snd_add 2 6 "thunder1" "Thunderclap" 1.0 3000 "oneshot"
	waitthread snd_add 2 7 "thunder2" "Thunder (distant)" 1.0 3000 "oneshot"
	level.coop_build_snditemcount[2] = 7

	level.coop_build_sndcatname[3] = "FIRE / ELECTRICAL"
	waitthread snd_add 3 1 "coop_snd_fire_small" "Small Fire" 1.0 160 "loop"
	waitthread snd_add 3 2 "coop_snd_fire_camp" "Campfire" 1.0 200 "loop"
	waitthread snd_add 3 3 "coop_snd_fire_large" "Large Fire" 1.0 400 "loop"
	waitthread snd_add 3 4 "coop_snd_fireplace" "Fireplace" 1.0 150 "loop"
	waitthread snd_add 3 5 "coop_snd_spark" "Electric Spark" 1.0 150 "loop"
	level.coop_build_snditemcount[3] = 5

	level.coop_build_sndcatname[4] = "WATER"
	waitthread snd_add 4 1 "coop_snd_river" "River" 1.0 400 "loop"
	waitthread snd_add 4 2 "coop_snd_waves" "Lapping Waves" 1.0 400 "loop"
	waitthread snd_add 4 3 "coop_snd_wave_crash" "Crashing Waves" 1.0 400 "loop"
	waitthread snd_add 4 4 "coop_amb_surf" "Surf" 1.0 400 "loop"
	waitthread snd_add 4 5 "coop_snd_basementwater" "Standing Water" 1.0 300 "loop"
	waitthread snd_add 4 6 "coop_snd_water_leak" "Water Leak" 1.0 200 "loop"
	level.coop_build_snditemcount[4] = 6

	level.coop_build_sndcatname[5] = "MACHINERY"
	waitthread snd_add 5 1 "coop_snd_machine" "Machine Loop" 1.0 150 "loop"
	waitthread snd_add 5 2 "coop_snd_engine_room" "Engine Room" 1.0 800 "loop"
	waitthread snd_add 5 3 "coop_snd_generator" "Generator" 1.0 200 "loop"
	waitthread snd_add 5 4 "coop_snd_train_idle" "Train Idle" 1.0 1000 "loop"
	level.coop_build_snditemcount[5] = 4

	level.coop_build_sndcatname[6] = "RADIO / SIGNALS"
	waitthread snd_add 6 1 "coop_snd_radio_music" "Radio Music" 1.0 150 "loop"
	waitthread snd_add 6 2 "coop_radio_static_loop" "Radio Static" 1.0 200 "loop"
	waitthread snd_add 6 3 "coop_snd_alarm" "Alarm" 1.0 300 "loop"
	waitthread snd_add 6 4 "coop_snd_siren" "Siren" 1.0 300 "loop"
	waitthread snd_add 6 5 "coop_snd_whistle" "Whistle Blow" 1.0 800 "oneshot"
	waitthread snd_add 6 6 "coop_snd_train_whistle" "Train Whistle" 1.0 1000 "oneshot"
	level.coop_build_snditemcount[6] = 6

	level.coop_build_sndcatname[7] = "WAR / ARTILLERY"
	waitthread snd_add 7 1 "coop_amb_artillery1" "Distant Artillery" 1.0 2000 "oneshot"
	waitthread snd_add 7 2 "thunder3" "Distant Boom" 1.0 3000 "oneshot"
	waitthread snd_add 7 3 "coop_snd_explosion" "Explosion" 1.0 400 "oneshot"
	level.coop_build_snditemcount[7] = 3

	level.coop_build_sndcatname[8] = "DESTRUCTION"
	waitthread snd_add 8 1 "coop_snd_glass_break" "Glass Break" 1.0 200 "oneshot"
	waitthread snd_add 8 2 "coop_glass_bigbreak" "Big Glass Break" 1.0 300 "oneshot"
	waitthread snd_add 8 3 "coop_snd_crate_break" "Wood Crate Break" 1.0 200 "oneshot"
	waitthread snd_add 8 4 "coop_snd_stone_break" "Stone Break" 1.0 200 "oneshot"
	waitthread snd_add 8 5 "coop_snd_tree_fall" "Tree Fall" 1.0 400 "oneshot"
	waitthread snd_add 8 6 "coop_snd_lightpole" "Lightpole Fall" 1.0 300 "oneshot"
	waitthread snd_add 8 7 "coop_snd_vehicle_crash" "Vehicle Crash" 1.0 300 "oneshot"
	level.coop_build_snditemcount[8] = 7

	level.coop_build_sndcatname[9] = "DOORS / MECH"
	waitthread snd_add 9 1 "coop_snd_door_wood" "Wood Door" 1.0 150 "oneshot"
	waitthread snd_add 9 2 "coop_door_lock" "Door Lock" 1.0 200 "oneshot"
	waitthread snd_add 9 3 "coop_snd_door_metal" "Metal Door" 1.0 150 "oneshot"
	waitthread snd_add 9 4 "coop_snd_gate_wood" "Wood Gate" 1.0 200 "oneshot"
	waitthread snd_add 9 5 "coop_snd_barn_door" "Barn Door" 1.0 200 "oneshot"
	waitthread snd_add 9 6 "coop_snd_hanger_door" "Hangar Door" 1.0 400 "oneshot"
	waitthread snd_add 9 7 "coop_snd_switch" "Switch/Lever" 1.0 100 "oneshot"
	level.coop_build_snditemcount[9] = 7

	level.coop_build_sndcatcount = 9
	level.coop_build_sndReady = 1
}end


//=========================================================================
// Load the current selection's default vol/minDist/type into the live edit vars.
//=========================================================================
coop_snd_loadDefaults:{
//=========================================================================
	local.c = level.coop_build_sndcat
	local.i = level.coop_build_sndidx
	level.coop_build_sndvol = level.coop_build_sndvol0[local.c][local.i]
	level.coop_build_sndmin = level.coop_build_sndmin0[local.c][local.i]
	level.coop_build_sndtype = level.coop_build_sndtype0[local.c][local.i]
}end


//=========================================================================
// Audition the current selection LIVE on the ghost so the host hears it while aiming.
// Loops only audition; one-shots stay silent on the ghost (they fire on place).
//=========================================================================
coop_snd_reaudition:{
//=========================================================================
	if( level.coop_build_ghost == NIL || level.coop_build_ghost == NULL ){ end }
	level.coop_build_ghost stoploopsound
	if( level.coop_build_sndtype == "loop" ){
		local.alias = level.coop_build_snditem[level.coop_build_sndcat][level.coop_build_sndidx]
		if( local.alias != NIL && local.alias != "" ){
			level.coop_build_ghost loopsound local.alias level.coop_build_sndvol level.coop_build_sndmin
		}
	}
}end


//=========================================================================
// (Re)spawn the SOUND-mode ghost = a translucent speaker marker + live audition.
//=========================================================================
coop_snd_ghostRefresh local.player:{
//=========================================================================
	if( level.coop_build_ghost != NIL && level.coop_build_ghost != NULL ){ level.coop_build_ghost delete }
	level.coop_build_ghostPropTag = ""
	local.g = spawn script_model model "models/static/speakerbox1.tik"
	local.g notsolid
	local.g alpha 0.55
	level.coop_build_ghost = local.g
	waitthread coop_snd_reaudition
	level.coop_build_hudDirty = 1
	waitthread coop_mod/buildmode.scr::coop_build_ghostFollow local.player
}end


//=========================================================================
// SOUND-mode control bus. buildmode.scr::coop_build_doCmd delegates here when mode == "sound".
//=========================================================================
coop_snd_doCmd local.player local.cmd:{
//=========================================================================
	if( local.cmd == "next" ){
		level.coop_build_sndidx++
		if( level.coop_build_sndidx > level.coop_build_snditemcount[level.coop_build_sndcat] ){ level.coop_build_sndidx = 1 }
		waitthread coop_snd_loadDefaults
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "prev" ){
		level.coop_build_sndidx--
		if( level.coop_build_sndidx < 1 ){ level.coop_build_sndidx = level.coop_build_snditemcount[level.coop_build_sndcat] }
		waitthread coop_snd_loadDefaults
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "catnext" ){
		level.coop_build_sndcat++
		if( level.coop_build_sndcat > level.coop_build_sndcatcount ){ level.coop_build_sndcat = 1 }
		level.coop_build_sndidx = 1
		waitthread coop_snd_loadDefaults
		waitthread coop_snd_reaudition
		local.player iprint ( "SND CAT " + level.coop_build_sndcat + "/" + level.coop_build_sndcatcount + ":  " + level.coop_build_sndcatname[level.coop_build_sndcat] ) 1
	}
	else if( local.cmd == "catprev" ){
		level.coop_build_sndcat--
		if( level.coop_build_sndcat < 1 ){ level.coop_build_sndcat = level.coop_build_sndcatcount }
		level.coop_build_sndidx = 1
		waitthread coop_snd_loadDefaults
		waitthread coop_snd_reaudition
		local.player iprint ( "SND CAT " + level.coop_build_sndcat + "/" + level.coop_build_sndcatcount + ":  " + level.coop_build_sndcatname[level.coop_build_sndcat] ) 1
	}
	else if( local.cmd == "scaleup" ){			// KP+ = volume up
		level.coop_build_sndvol = waitthread coop_mod/buildmode.scr::coop_build_round1 ( level.coop_build_sndvol + 0.1 )
		if( level.coop_build_sndvol > 2.0 ){ level.coop_build_sndvol = 2.0 }
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "scaledown" ){		// KP- = volume down
		level.coop_build_sndvol = waitthread coop_mod/buildmode.scr::coop_build_round1 ( level.coop_build_sndvol - 0.1 )
		if( level.coop_build_sndvol < 0.1 ){ level.coop_build_sndvol = 0.1 }
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "pitchplus" ){		// KP* = radius (minDist) up
		level.coop_build_sndmin = level.coop_build_sndmin + 32
		if( level.coop_build_sndmin > 4000 ){ level.coop_build_sndmin = 4000 }
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "pitchminus" ){		// KP/ = radius (minDist) down
		level.coop_build_sndmin = level.coop_build_sndmin - 32
		if( level.coop_build_sndmin < 32 ){ level.coop_build_sndmin = 32 }
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "solid" ){			// KP0 = LOOP <-> ONESHOT
		if( level.coop_build_sndtype == "loop" ){ level.coop_build_sndtype = "oneshot" }
		else{ level.coop_build_sndtype = "loop" }
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "up" ){				// KP8 raise emitter (shared zofs)
		level.coop_build_zofs = level.coop_build_zofs + 4
		if( level.coop_build_zofs > 256 ){ level.coop_build_zofs = 256 }
	}
	else if( local.cmd == "down" ){				// KP2 lower emitter
		level.coop_build_zofs = level.coop_build_zofs - 4
		if( level.coop_build_zofs < -64 ){ level.coop_build_zofs = -64 }
	}
	else if( local.cmd == "closer" ){			// , pull emitter closer (shared dist)
		level.coop_build_dist = level.coop_build_dist - 16
		if( level.coop_build_dist < -256 ){ level.coop_build_dist = -256 }
	}
	else if( local.cmd == "farther" ){			// . push emitter out
		level.coop_build_dist = level.coop_build_dist + 16
		if( level.coop_build_dist > 1024 ){ level.coop_build_dist = 1024 }
	}
	else if( local.cmd == "reset" ){			// KP5 = vol/radius/pos back to defaults
		waitthread coop_snd_loadDefaults
		level.coop_build_zofs = 0
		level.coop_build_dist = 0
		waitthread coop_snd_reaudition
	}
	else if( local.cmd == "place" ){			// KP_ENTER drop emitter
		waitthread coop_snd_place local.player
	}
	else if( local.cmd == "undo" ){				// KP_DEL undo last emitter
		waitthread coop_snd_undo local.player
	}
	// yawplus/yawminus/animprev/animnext have no SOUND-mode meaning (no-op)
}end


//=========================================================================
// Drop a real emitter at the ghost position, capture a paste-ready block to snd_<map>.dat.
//=========================================================================
coop_snd_place local.player:{
//=========================================================================
	if( level.coop_build_lastpos == NIL ){ end }
	if( level.coop_build_sndcount == NIL ){ level.coop_build_sndcount = 0 }
	if( level.coop_build_sndfile == NIL ){ level.coop_build_sndfile = "coop_mod/save/snd_" + level.coop_mapname + ".dat" }
	if( level.coop_build_sndbasetext == NIL ){
		local.prev = fs_read_content ( level.coop_build_sndfile )
		if( local.prev == NIL || local.prev == "" ){
			level.coop_build_sndbasetext = "// HZM coop BUILD MODE - SOUND emitters for map " + level.coop_mapname + "\n// paste-ready; recipe in _research/build_mode_sounds.md\n\n"
		}else{
			level.coop_build_sndbasetext = local.prev
		}
	}

	local.n = level.coop_build_sndcount + 1
	local.alias = level.coop_build_snditem[level.coop_build_sndcat][level.coop_build_sndidx]
	local.disp = level.coop_build_snddisp[level.coop_build_sndcat][level.coop_build_sndidx]
	local.px = level.coop_build_lastpos[0]
	local.py = level.coop_build_lastpos[1]
	local.pz = level.coop_build_lastpos[2]

	local.m = spawn script_model
	local.m model "fx/dummy.tik"
	local.m.origin = level.coop_build_lastpos
	local.m notsolid

	if( level.coop_build_sndtype == "oneshot" ){
		local.m.coop_sndAlias = local.alias
		local.m.coop_sndEvery = 15
		local.m thread coop_snd_oneshotLoop
		local.block = "// coop_build SOUND #" + local.n + " " + local.alias + "  (" + local.disp + ", oneshot ~15-30s)\n"
		local.block = local.block + "local.m = spawn script_model\n"
		local.block = local.block + "local.m model \"fx/dummy.tik\"\n"
		local.block = local.block + "local.m.origin = ( " + local.px + " " + local.py + " " + local.pz + " )\n"
		local.block = local.block + "local.m notsolid\n"
		local.block = local.block + "local.m.coop_sndAlias = \"" + local.alias + "\"\n"
		local.block = local.block + "local.m.coop_sndEvery = 15\n"
		local.block = local.block + "local.m thread coop_mod/buildmode_sounds.scr::coop_snd_oneshotLoop\n\n"
	}else{
		local.m loopsound local.alias level.coop_build_sndvol level.coop_build_sndmin
		local.block = "// coop_build SOUND #" + local.n + " " + local.alias + "  (" + local.disp + ", loop vol " + level.coop_build_sndvol + " min " + level.coop_build_sndmin + ")\n"
		local.block = local.block + "local.m = spawn script_model\n"
		local.block = local.block + "local.m model \"fx/dummy.tik\"\n"
		local.block = local.block + "local.m.origin = ( " + local.px + " " + local.py + " " + local.pz + " )\n"
		local.block = local.block + "local.m notsolid\n"
		local.block = local.block + "local.m loopsound \"" + local.alias + "\" " + level.coop_build_sndvol + " " + level.coop_build_sndmin + "\n\n"
	}

	level.coop_build_sndent[local.n] = local.m
	level.coop_build_snddumpline[local.n] = local.block
	level.coop_build_sndcount = local.n
	waitthread coop_snd_save
	println( "^~^~^ BUILD_SOUND_PLACE " + local.n + " " + local.alias + " type " + level.coop_build_sndtype + " vol " + level.coop_build_sndvol + " min " + level.coop_build_sndmin + " org " + local.px + " " + local.py + " " + local.pz )
	local.player iprint ( "placed sound #" + local.n + "  " + local.disp ) 1
}end


//=========================================================================
// Remove the most recent emitter + capture line and rewrite the snd file.
//=========================================================================
coop_snd_undo local.player:{
//=========================================================================
	if( level.coop_build_sndcount == NIL || level.coop_build_sndcount < 1 ){
		local.player iprint "BUILD: no sound to undo" 1
		end
	}
	local.n = level.coop_build_sndcount
	local.m = level.coop_build_sndent[local.n]
	if( local.m != NIL && local.m != NULL ){
		local.m stoploopsound
		local.m delete
	}
	level.coop_build_sndent[local.n] = NIL
	level.coop_build_snddumpline[local.n] = NIL
	level.coop_build_sndcount = local.n - 1
	waitthread coop_snd_save
	println( "^~^~^ BUILD_SOUND_UNDO " + local.n )
	local.player iprint ( "removed sound #" + local.n ) 1
}end


//=========================================================================
// Rewrite snd_<map>.dat: prior sessions (basetext) + this session's emitter blocks.
//=========================================================================
coop_snd_save:{
//=========================================================================
	local.txt = level.coop_build_sndbasetext
	local.i = 1
	while( local.i <= level.coop_build_sndcount ){
		if( level.coop_build_snddumpline[local.i] != NIL ){ local.txt = local.txt + level.coop_build_snddumpline[local.i] }
		local.i++
	}
	fs_write_content ( level.coop_build_sndfile ) ( local.txt )
	println( "^~^~^ BUILD_SOUND_SAVED " + level.coop_build_sndfile + " count " + level.coop_build_sndcount )
}end


//=========================================================================
// ONE-SHOT emitter driver (runs on the placed emitter). Fires the alias every
// coop_sndEvery..2x seconds until removed. playsound is emitted at the entity origin
// to all clients in range with the alias's own attenuation.
//=========================================================================
coop_snd_oneshotLoop:{
//=========================================================================
	if( self == NULL ){ end }
	if( self.coop_sndEvery == NIL ){ self.coop_sndEvery = 15 }
	while( self != NULL ){
		local.w = self.coop_sndEvery + randomfloat self.coop_sndEvery
		wait local.w
		if( self == NULL ){ end }
		self playsound self.coop_sndAlias
	}
}end
