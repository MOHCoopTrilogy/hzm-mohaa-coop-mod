// objective_positions.scr
// Per-map data table for the Objective Bonus Drop (objective_drop.scr).
// Mirrors the officer_positions.scr getAnchor pattern: a flat if/else-if chain
// inlined into one label, exec'd in the caller's context (no per-map threads).
//
// FLAGS set by this file (read by objective_drop.scr::coop_objective_drop_init):
//   level.coop_objdrop_enable   int     1 = place a bonus drop on this map (default 0)
//   level.coop_objdrop_origin   vector  world position for the pickup; NIL = TODO/disabled
//
// ELIGIBILITY ("maps that make sense"):
//   Only maps that already support the airstrike/paradrop reward (i.e. NOT
//   coop_feature_boss=0 / coop_feature_paradrop=0 maps, and NOT vehicle /
//   cinematic maps). Vehicle/cinematic skip-maps (m4l0, m5l2b, t2l2, t3l2,
//   t1l1, e3l4) are intentionally NOT listed here -> stay disabled.
//
// COORDS:
//   Where a real, verified objective coord is known, it is filled in and the
//   drop is enabled. Where it is not, the map is left with a clearly-marked
//   TODO, enable=1 but origin=NIL, so the mechanism activates automatically
//   the moment a coord is pasted in (objective_drop.scr no-ops on NIL origin).
//   DO NOT invent coordinates: unknown maps keep origin = NIL.
//
// THIS TABLE IS THE ONLY GATE. Do NOT add a runtime check on level.coop_feature_binoc /
// level.coop_feature_paradrop / level.coop_officer_smoke_drop inside objective_drop.scr: those
// are populated by officer_positions.scr::getAnchor, which officer.scr only reaches at line 206 -
// AFTER `while( !$player )` (166) and AFTER the spawn-policy block (189-201), which returns early
// on a "none" map and can block for minutes on a "deferred" one. coop_objective_drop_init runs at
// first-player + 2s, so it would read NIL on most maps. If a map's officer reward is disabled,
// remove the map from the chain below instead.

getObjectiveDrop:{
	level.coop_objdrop_enable = 0
	level.coop_objdrop_origin = NIL

	local.m = level.coop_mapname

	// =====================================================================
	// SHIPPING WITH A REAL COORD
	// =====================================================================

	if( local.m == "m4l3" ){
		// Objective 2 "Send the false communique": the map-placed pulse radio $objective2
		// (maps/m4l3.scr:1056), class script_model, BSP origin -2894.37 -278.60 264.00 in
		// map_entities/m4l3_entities.txt.
		// REPLACES ( -120 -1066 9 ). That value's only stated provenance was an offset from
		// officer anchor ( -263 -1066 9 ), and officer_positions.scr:109 retired that anchor on
		// 2026-08-14. Nothing in the repo supports the old number now, and it is not near any
		// m4l3 objective - the six objective entities sit at Z 60 / 264 / 260 / 461 / -143 / 168.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( -2894 -279 264 )

	// =====================================================================
	// ELIGIBLE BUT AWAITING A VERIFIED COORD (TODO)
	// enable=1 + origin=NIL: drop auto-activates once a coord is filled in.
	// Paste an objective-area world position (use viewpos in-game) to ship.
	// =====================================================================

	// =====================================================================
	// DERIVED COORDS. Every entry below is the BSP origin of the entity the map's own script
	// hands to global/objectives.scr::add_objectives as that objective's world position. Source
	// is map_entities/<map>_entities.txt (full entity dumps), cited per map. These are entity
	// origins, not measured player positions, so objective_drop.scr ground-snaps them through
	// officer.scr::coop_find_ground and places NOTHING if the snap fails.
	// =====================================================================

	} else if( local.m == "m6l2a" ){
		// Obj 4 "Plant explosives in the radio command post": $cp1_bomb1 (maps/m6l2a.scr:167),
		// class animate_item_radiobomb-pulsating, origin -3775.61 -719.36 51.00.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( -3776 -719 51 )

	} else if( local.m == "m6l3a" ){
		// Obj 3 "Plant explosives on the fuel flow control units": $scene6_fuelbomb1
		// (maps/m6l3a.scr:2095), class script_model, origin -1462.25 -2209.78 -711.00.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( -1462 -2210 -711 )

	} else if( local.m == "m2l1" ){
		// Obj 2 "Steal the research documents": $document1 (maps/m2l1.scr:77), class
		// animate_item_naxosplans1-pulse, origin 448.00 2384.00 678.00.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( 448 2384 678 )

	} else if( local.m == "m5l1a" ){
		// WEAKEST OF THE SET. m5l1a only ever anchors objectives on $ending_point and $leftgate
		// (maps/m5l1a.scr:229-231); $leftgate is a brush gate whose centroid is inside the door,
		// so the only usable marker is $ending_point, class script_origin, origin -527 -1593 168 -
		// which is the SOUTH EDGE OF TOWN, i.e. the exit. The reward therefore arrives late.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( -527 -1593 168 )

	} else if( local.m == "m5l1b" ){
		// Obj 3 "Keep the tank crew alive and infiltrate city hall": $obj2 (maps/m5l1b.scr:145),
		// class script_origin, origin 3168 600 528.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( 3168 600 528 )

	} else if( local.m == "m4l1" ){
		// STAYS OFF. m4l1's only static objective anchor is $altar_button (maps/m4l1.scr:95),
		// class script_object with a BRUSH model *25 - its origin key is the brush centroid,
		// which is inside the button, so coop_find_ground would report startSolid and no-op.
		// The other anchor is level.pilot / $manon, a moving AI. Needs an in-game viewpos.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = NIL   // TODO(coord): m4l1 needs in-game viewpos capture

	} else if( local.m == "m4l2" ){
		// Obj 2 "Bomb Tiger tanks": $bomb01 (maps/m4l2.scr:273), class
		// animate_item_radiobomb-pulsating, origin 4564.66 4148.36 291.96.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( 4565 4148 292 )

	} else if( local.m == "e1l1" ){
		// MEDIUM CONFIDENCE. e1l1.scr has no add_objectives at all; the objectives live in
		// maps/e1l1/objectives.scr. Seize-the-artillery anchors on $scene3Cannon2
		// (maps/e1l1/objectives.scr:305), class turretweapon_german_flak88, origin
		// 981.00 -3819.00 462.00 - a placed gun, so the snap lands on its emplacement floor.
		// Alternative if that reads wrong in game: $reachedBunkerTrigger ( 2848 1192 216 ),
		// but that one is a brush centroid.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( 981 -3819 462 )

	} else if( local.m == "e1l2" ){
		// Destroy-the-hideout objective: $bunkerentrance (maps/e1l2.scr:118), class
		// script_origin, origin 1042 3526 312.
		level.coop_objdrop_enable = 1
		level.coop_objdrop_origin = ( 1042 3526 312 )

	}
	// Any map not listed: enable stays 0 -> no bonus drop (safe default).

	end level.coop_objdrop_enable
}end
