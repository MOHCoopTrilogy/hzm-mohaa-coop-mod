//=========================================================================
// MP_CYBERSND.SCR - shared LOADER CORE for the two real UberMod bomb modes:
//   Search & Destroy   (coop_mod/mp_snd.scr,         mode "snd")
//   Cyber Attack        (coop_mod/mp_cyberattack.scr, mode "cyb")
//
// It LOADS the real UberMod v8 mode (ubermode/cybersnd.scr) - it is NOT a reimplementation. It drives the
// mod exactly as a UberMod map script does: place the map's authored bomb sites + bomb spawn, set the
// mod's g_ubergametype selector, then `exec ubermode/cybersnd.scr::main`. The per-map bomb data was
// harvested verbatim into coop_mod/mp_cybersnd_stations.scr (generated by docs/tools/gen_cybersnd_maps.py).
//
// These modes run on maps launched as script-less MP arenas via the one-shot engine cvar sv_mpForceArena
// (the same path Base Assault and Push use): the 7 mohdm* deathmatch maps carry their own bsp spawns; the
// authored SP campaign maps carry none, so coop_mod/mp_arena_spawns.scr::ensureSpawns injects the reused
// Base Assault / Push team spawns first. mp.scr offers ONLY the maps that have bomb data (mp_snd.scr /
// mp_cyberattack.scr map pickers), so a host can never start these on an unsupported map.
//
// mp.scr dispatches through its seam (a switch on level.coop_mpMode):
//     mp.scr::mp_modeInit -> mode_init  (pre-spawn: inject spawns, place bomb sites, exec the real mode)
// The per-player spawn/think/death edges are deliberately no-ops (see mp_snd.scr / mp_cyberattack.scr):
// ubermode/cybersnd.scr owns the whole player experience (teams, weapons, rounds, victory podium), which is
// why both modes are excluded from mp.scr::mp_modeUsesArmory.
//
// COOP SAFETY (the standing rule: never impact coop). Every entry is gated on level.coop_mpRun, which ONLY
// coop_mod/mp.scr sets and which any level load wipes - so this can never run on a coop map. sv_mpForceArena
// is armed ONLY when a host explicitly picks one of these maps for MP; a normal coop launch never sets it,
// so the campaign maps still load coop untouched. g_ubergametype is a non-coop UberMod cvar; coop reads it
// nowhere. ubermode/cybersnd.scr and its deps name no coop_mp* token, no coop_lo*/coop_health state and no
// ui/loadout tree; the ubermode/ subsystem is admitted as an MP callee in the isolation clause-10 allowlist.
//=========================================================================

//canary (TRAPS T1): if this file parse-kills, mode_init is unreachable and the mode stays off.
alive:{
	end 1
}end


//PRE-SPAWN INIT. Called by mp_snd.scr::mode_init ("snd") and mp_cyberattack.scr::mode_init ("cyb").
mode_init local.mode:{
	if( level.coop_mpRun != 1 ){ end }

	local.map = getcvar( "mapname" )

	//eligibility: cs_eligibleFor returns 1 only for maps that carry this mode's real bomb data.
	local.elig = waitthread coop_mod/mp_cybersnd_stations.scr::cs_eligibleFor local.map local.mode
	if( local.elig != 1 ){
		println( "^~^~^ MPCS map " + local.map + " has no " + local.mode + " bomb data - mode inert here" )
		end
	}

	//the real mod selects its gametype from g_ubergametype. Set it for the whole MP match; coop never reads it.
	setcvar "g_ubergametype" local.mode

	level.coop_mpCsActive = 1
	println( "^~^~^ MPCS starting " + local.mode + " (real UberMod cybersnd) on " + local.map )

	waitthread cs_boot local.map local.mode
}end


//Spawn injection + bomb placement + start the real mode. This runs SYNCHRONOUSLY from mp.scr::main, which
//the E4 mp_mapscript_hook execs at Level::ServerSpawned - i.e. AFTER the level's prespawn/spawn edges have
//already fired. So we do NOT `level waittill prespawn/spawn` here (that throws "invalid waittill" and is
//pointless once the edge is gone); we seed everything immediately, exactly as mp_push.scr does at this same
//point. Any player joins after ServerSpawned, so the spawns + bomb sites are in place before the first spawn.
cs_boot local.map local.mode:{
	//1) inject the reused team spawns (no-op on the mohdm* bsp-spawn maps, which carry their own).
	waitthread coop_mod/mp_arena_spawns.scr::ensureSpawns local.map

	//2) place THIS map's real bomb sites + bomb (the UberMod ::bombsite/::bomb placements), then exec the
	//   real mod. cs_setupFor blocks until the sites are spawned, so main's `level.bombsites` check passes.
	waitthread coop_mod/mp_cybersnd_stations.scr::cs_setupFor local.map local.mode
	exec ubermode/cybersnd.scr::main
	println( "^~^~^ MPCS " + local.mode + " live on " + local.map )
}end
