//========================================================================================
// HZM Coop - BUILD MODE : ALLIED ACTORS + ANIMATION catalog (DATA + ghost animator).
// Companion to coop_mod/buildmode.scr / buildmode_catalog.scr.  Full docs:
//   _research/build_actor_anims.md
//
// actor_catalog_init (called once from buildmode.scr::coop_build_monitor, right after
// buildmode_catalog.scr::catalog_init) appends:
//   * ONE new build category "ALLIED ACTORS" = the 76 MP allied player skins
//     (models/player/*.tik, mirrors the engine PlayerModelPickerClass allied filter and the
//     lobby coop_lobbySkins roster). Its index is stored in level.coop_build_actorCat.
//   * The ANIMATION catalog, parallel arrays 1..level.coop_build_animCount:
//       level.coop_build_animName[a]   - HUD display name
//       level.coop_build_animAlias[a]  - anim alias (aliased in models/player/base/anims_shared.txt)
//       level.coop_build_animProp[a]   - optional prop tik ("" = none)
//       level.coop_build_animTag[a]    - optional attach tag ("" = none)
//
// When the build cursor is on the actor category, buildmode.scr animates the ghost/placed
// script_model (self anim <alias> / waittill animdone loop - the proven lobby mannequin recipe)
// and attaches the anim's prop with 'attachmodel <tik> <tag>' so both the live preview AND the
// saved .dat block carry the prop. Idempotent per map load (level vars clear on map change).
//========================================================================================

//=========================================================================
actor_catalog_init:{
//=========================================================================
	if( level.coop_build_actorReady == 1 ){ end }
	if( level.coop_build_catcount == NIL ){ end }		// catalog_init must have run first

	// ---- new category: ALLIED ACTORS (76 skins) ----
	local.c = level.coop_build_catcount + 1
	level.coop_build_actorCat = local.c
	level.coop_build_catname[local.c] = "ALLIED ACTORS"

	level.coop_build_item[local.c][1] = "models/player/allied_101st_captain.tik"
