//=========================================================================
// HZM coop - AMBIENCE BEDS + COMBAT MIXING (script-only; modeled on weather.scr::coop_weather_sound).
//
// One subtle levelwide ambience LOOP per map, picked from the map's existing weather theme:
//   snow theme        -> coop_amb_wind     (gusty outdoor tree wind)
//   rain / none theme -> coop_amb_country  (light countryside: soft rustle + sparse crickets)
// A map can override with level.coop_ambienceBed = "wind" / "country" / "none" (set in maps/<map>.scr
// next to level.coop_weatherTheme, i.e. AFTER 'waitthread coop_mod/main.scr::main').
//
// The bed volume is a single smoothed value re-issued via the proven loopsound-reissue idiom
// (levelwide loops ignore origin; the emitter is parked on player 1 so it is never stuck at world
// origin). Three live factors multiply the coop_ambienceVol base:
//   COMBAT DUCK  - any player firing or losing health marks combat; the bed ducks to ~30% fast and
//                  swells back over ~10s of calm (dynamic combat mixing, report section 6).
//   INDOOR DUCK  - officer.scr::coop_hasOpenSky poll on the HOST (player 1): under a roof the bed
//                  drops to ~35% so it reads as "the outside, heard from indoors". (A levelwide loop
//                  cannot be filtered per-player from script - this is the simple host-side proxy.)
//   RAIN YIELD   - under real rain (level.raindensity from the native weather) the rain bed owns the
//                  soundscape; this bed ducks out of its way.
// SWEETENERS: every 20-60s of relative calm, one distant-artillery rumble (stock Exp_LeadIn_* via the
// coop_amb_artillery1..4 aliases, numbered-alias randomint pick = the deathvox pattern) fires from a
// far random offset around a random player. Suppressed during rain and active combat.
//
//   coop_ambience 1/0      = master on/off (live; threaded once per map from main.scr::main)
//   coop_ambienceVol 0.5   = bed base volume (the duck factors scale under this)
//=========================================================================

coop_ambience_init:{
	if( int( getcvar "coop_ambience" ) != 1 ){ end }

	// same deferral as weather.scr: the map script sets level.coop_weatherTheme / level.coop_ambienceBed
	// AFTER main.scr::main returns, so wait for prespawn before reading either.
	waitthread coop_mod/replace.scr::waitTillPrespawn

	local.bed = waitthread coop_ambience_pick
	if( local.bed == "none" ){
		println "^~^~^ AMBIENCE coop bed=none (map opted out)"
		end
	}

	level.coop_ambCombatTime = 0 - 1000		// long ago = start calm
	level.coop_ambEnt = spawn script_model
	level.coop_ambEnt model "fx/dummy.tik"
	level.coop_ambEnt notsolid

	thread coop_ambience_combat_monitor
	thread coop_ambience_bed local.bed
	thread coop_ambience_sweetener
	thread coop_ambience_barrage
	println ( "^~^~^ AMBIENCE coop bed=" + local.bed )
}end

//=========================================================================
// Resolve which bed this map gets: per-map override first, else by weather theme.
coop_ambience_pick:{
	if( level.coop_ambienceBed == "none" ){ end "none" }
	if( level.coop_ambienceBed == "wind" ){ end "coop_amb_wind" }
	if( level.coop_ambienceBed == "country" ){ end "coop_amb_country" }
	if( level.coop_ambienceBed == "forest_night" ){ end "coop_amb_forest_night" }
	if( level.coop_ambienceBed == "night_calm" ){ end "coop_amb_night_calm" }
	if( level.coop_ambienceBed == "surf" ){ end "coop_amb_surf" }
	//[311] FRONTLINE distant-war beds (opt-in per map after an audition pass):
	//level.coop_ambienceBed = "fl_beach" / "fl_port" / "fl_town" / "fl_country"
	if( level.coop_ambienceBed == "fl_beach" ){ end "coop_flamb_beach" }
	if( level.coop_ambienceBed == "fl_port" ){ end "coop_flamb_port" }
	if( level.coop_ambienceBed == "fl_town" ){ end "coop_flamb_town" }
	if( level.coop_ambienceBed == "fl_country" ){ end "coop_flamb_country" }
	if( level.coop_ambienceBed == "fl_urbanwar" ){ end "coop_flamb_urbanwar" }
	if( level.coop_ambienceBed == "fl_countrywar" ){ end "coop_flamb_countrywar" }
	if( level.coop_ambienceBed == "fl_industrial" ){ end "coop_flamb_industrial" }

	//[user 07-13] CENTRAL Frontline bed table - map-level defaults assigned after the user's
	//audition pass ("the ambient sounds are nice"). A map's own level.coop_ambienceBed override
	//(above) always wins. Themes follow each map's setting: harbor towns get port water+gulls,
	//occupied towns the quiet town murmur, front-line maps a distant-battle layer, night/rural
	//maps the soft countryside, rail/factory maps the industrial drone.
	local.m = level.coop_mapname
	// AA - Lighting the Torch (coastal N.Africa night)
	if( local.m == "m1l1" ){ end "coop_flamb_port" }
	if( local.m == "m1l2a" || local.m == "m1l2b" ){ end "coop_flamb_country" }
	if( local.m == "m1l3a" || local.m == "m1l3b" ){ end "coop_flamb_country" }
	// AA - Scuttling the U-529 (Trondheim town + U-boat pens + rail escape)
	if( local.m == "m2l1" ){ end "coop_flamb_town" }
	if( local.m == "m2l2a" || local.m == "m2l2b" || local.m == "m2l2c" ){ end "coop_flamb_port" }
	if( local.m == "m2l3" ){ end "coop_flamb_industrial" }
	// AA - Omaha (m3l1a keeps its surf override above)
	if( local.m == "m3l1b" ){ end "coop_flamb_beach" }
	if( local.m == "m3l2" ){ end "coop_flamb_urbanwar" }
	if( local.m == "m3l3a" || local.m == "m3l3b" ){ end "coop_flamb_country" }
	// AA - Behind Enemy Lines (night rural)
	if( local.m == "m4l0" || local.m == "m4l1" || local.m == "m4l2" || local.m == "m4l3" ){ end "coop_flamb_country" }
	// AA - Day of the Tiger (city fighting)
	if( local.m == "m5l1a" || local.m == "m5l1b" ){ end "coop_flamb_urbanwar" }
	if( local.m == "m5l2a" || local.m == "m5l2b" || local.m == "m5l3" ){ end "coop_flamb_urbanwar" }
	// AA - Fort Schmerzen (railgun facility; snowy approach keeps the wind default)
	if( local.m == "m6l3" ){ end "coop_flamb_industrial" }
	// SH - night drop Normandy / Ardennes front / Berlin
	if( local.m == "t1l1" || local.m == "t1l2" || local.m == "t1l3" ){ end "coop_flamb_country" }
	if( local.m == "t2l2" || local.m == "t2l3" || local.m == "t2l4" ){ end "coop_flamb_countrywar" }
	if( local.m == "t3l1" || local.m == "t3l2" ){ end "coop_flamb_urbanwar" }
	// BT - N.Africa desert / Sicily / Italy
	if( local.m == "e1l1" || local.m == "e1l2" || local.m == "e1l3" || local.m == "e1l4" ){ end "coop_amb_wind" }
	if( local.m == "e2l1" ){ end "coop_flamb_beach" }
	if( local.m == "e2l2" ){ end "coop_flamb_countrywar" }
	if( local.m == "e2l3" ){ end "coop_flamb_country" }
	if( local.m == "e3l1" || local.m == "e3l3" ){ end "coop_flamb_country" }
	if( local.m == "e3l2" ){ end "coop_flamb_urbanwar" }
	if( local.m == "e3l4" ){ end "coop_flamb_countrywar" }

	//[bug-1383] ARENA MODE: the rain is switched off, so the wet countryside/war beds would be
	//wrong. coop_arenaAmb picks the replacement bed - default is a calm night. Valid values are
	//the coop_ambience_pick set: wind | country | forest_night | night_calm | surf.
	if( level.coop_arenaMap == 1 || level.coop_buildmap == 1 ){
		local.ab = getcvar "coop_arenaAmb"
		if( local.ab == "wind" ){ end "coop_amb_wind" }
		if( local.ab == "country" ){ end "coop_amb_country" }
		if( local.ab == "forest_night" ){ end "coop_amb_forest_night" }
		if( local.ab == "surf" ){ end "coop_amb_surf" }
		end "coop_amb_forest_night"
	}

	if( level.coop_weatherTheme == "snow" ){ end "coop_amb_wind" }
	end "coop_amb_country"
}end

//=========================================================================
// COMBAT HEAT: cheap, robust proxy - a player FIRING or LOSING HEALTH means a fight is on.
// (Script cannot see cgame near-miss zings or engine-side AI shots; player trigger pulls + damage
// taken cover every real firefight in practice.) Marks level.coop_ambCombatTime = level.time.
coop_ambience_combat_monitor:{
	local.last[1] = 0
	while( 1 ){
		local.i = 1
		while( $player != NULL && local.i <= $player.size ){
			local.p = $player[local.i]
			if( local.p != NULL && isAlive local.p ){
				if( local.p.fireheld == 1 ){
					level.coop_ambCombatTime = level.time
				}
				local.h = local.p.health
				if( local.last[local.i] != NIL && local.h < local.last[local.i] ){
					level.coop_ambCombatTime = level.time
				}
				local.last[local.i] = local.h
			} else {
				local.last[local.i] = 0
			}
			local.i++
		}
		wait 0.5
	}
}end

//=========================================================================
// THE BED: smoothed volume, re-issued every 1.5s (live volume control of a playing loop works by
// re-issuing the loopsound - the weather rain-bed idiom).
coop_ambience_bed local.alias:{
	local.cur = 0		// current smoothed volume fraction (0..1 of base)
	while( 1 ){
		if( int( getcvar "coop_ambience" ) != 1 ){
			level.coop_ambEnt stoploopsound
			local.cur = 0
			wait 3
			continue
		}

		local.base = getcvar "coop_ambienceVol"
		if( local.base == "" ){ local.base = 0.5 } else { local.base = float( local.base ) }
		if( local.base > 1 ){ local.base = 1 }

		// target fraction from the three duck factors
		local.target = 1.0

		// combat duck: hard floor while fighting, swell back after ~10s of calm
		if( ( level.time - level.coop_ambCombatTime ) < 10 ){ local.target = 0.3 }

		// indoor duck: host under a roof -> the bed reads as "outside", quieter
		if( $player != NULL && $player[1] != NULL ){
			if( ( exec coop_mod/officer.scr::coop_hasOpenSky $player[1].origin ) != 1 ){
				local.target = local.target * 0.35
			}
		}

		// rain yield: the rain bed (weather.scr) owns the soundscape while it pours
		local.rd = level.raindensity
		if( local.rd != NIL && local.rd > 3 ){ local.target = local.target * 0.35 }

		// smooth: duck fast (fights start abruptly), recover slowly (~10s swell at 1.5s ticks)
		if( local.target < local.cur ){
			local.cur = local.cur - 0.30
			if( local.cur < local.target ){ local.cur = local.target }
		} else {
			local.cur = local.cur + 0.12
			if( local.cur > local.target ){ local.cur = local.target }
		}

		local.vol = local.base * local.cur
		if( local.vol < 0.03 ){
			level.coop_ambEnt stoploopsound
		} else {
			// keep the levelwide emitter on a player so the loop is never stuck at world origin
			if( $player != NULL && $player[1] != NULL ){ level.coop_ambEnt.origin = $player[1].origin }
			level.coop_ambEnt loopsound local.alias local.vol "levelwide"
		}
		wait 1.5
	}
}end

//=========================================================================
// SWEETENERS: a distant artillery rumble every 20-60s of relative calm, from a far random offset
// around a random player (3D one-shot; the big alias min-dist makes it carry softly to everyone).
coop_ambience_sweetener:{
	while( 1 ){
		wait ( 20 + randomfloat( 40 ) )
		if( int( getcvar "coop_ambience" ) != 1 ){ continue }
		// HZM coop - dedicated knobs for the distant-artillery rumbles (user heard them as "random
		// artillery strikes"). coop_ambArtillery 0 = off; coop_ambArtilleryChance (0..1, def 0.5) =
		// per-cycle roll so they stay rare + unpredictable rather than metronomic.
		if( getcvar( "coop_ambArtillery" ) == "0" ){ continue }
		local.ch = getcvar( "coop_ambArtilleryChance" )
		if( local.ch == "" ){ local.ch = 0.5 }
		if( randomfloat( 1 ) > float( local.ch ) ){ continue }
		if( $player == NULL || $player.size < 1 ){ continue }

		// stay quiet while a fight is running or in the first seconds after (let the aftermath breathe)
		if( ( level.time - level.coop_ambCombatTime ) < 8 ){ continue }

		// heavy rain drowns distant rumbles; the thunder does this job then
		local.rd = level.raindensity
		if( local.rd != NIL && local.rd > 2 ){ continue }

		local.p = $player[ ( randomint $player.size ) + 1 ]
		if( local.p == NULL ){ continue }

		local.pos = local.p.origin
		local.pos[0] = local.pos[0] + ( ( randomint 4000 ) - 2000 )
		local.pos[1] = local.pos[1] + ( ( randomint 4000 ) - 2000 )
		local.pos[2] = local.pos[2] + 400 + ( randomint 400 )

		local.snd = spawn script_origin
		local.snd.origin = local.pos
		local.snd playsound ( "coop_amb_artillery" + ( ( randomint 4 ) + 1 ) )
		wait 6
		if( local.snd != NULL ){ local.snd remove }
	}
}end

//=========================================================================
// [user 08-08] INCOMING BARRAGE - shells landing AROUND the squad. Distinct from the sweetener
// above, which is a distant rumble at 2000-4000 units with no impact: this one lands close enough
// to see and hear, with a whistle-in and a real ground burst.
//
// DELIBERATELY HARMLESS (user call, 08-08). It does no radiusdamage at all - it is pressure and
// atmosphere, not a damage source, so it can never produce an unfair death or a death the player
// could not have avoided. If it should ever bite, that is a one-line addition here, not a redesign.
//
// OFF unless asked for: coop_ambBarrage 1, or level.coop_barrage = 1 from a map that wants it.
// Knobs (all seeded nowhere, so the fallbacks below are the real defaults):
//   coop_ambBarrageGap   seconds between shells, randomised +/- half again   (default 5)
//   coop_ambBarrageMin   closest a shell may land, in units                  (default 400)
//   coop_ambBarrageMax   furthest                                            (default 1400)
//=========================================================================
coop_ambience_barrage:{
	while( 1 ){
		//[user 08-08] per-MAP overrides take precedence over the cvars, so a mission can dial in its
		//own feel (a distant background rumble vs shells walking over your position) without a player
		//having to set anything, and without one map's taste leaking into every other map.
		local.gap = float( getcvar "coop_ambBarrageGap" )
		if( level.coop_barrageGap != NIL && level.coop_barrageGap > 0 ){ local.gap = level.coop_barrageGap }
		if( local.gap < 1 ){ local.gap = 5 }
		wait ( local.gap + randomfloat( local.gap ) )

		local.on = 0
		if( getcvar( "coop_ambBarrage" ) == "1" ){ local.on = 1 }
		if( level.coop_barrage == 1 ){ local.on = 1 }
		if( local.on == 0 ){ continue }
		if( $player == NULL || $player.size < 1 ){ continue }

		local.p = $player[ ( randomint $player.size ) + 1 ]
		if( local.p == NULL ){ continue }
		if( !isAlive local.p ){ continue }

		local.mn = float( getcvar "coop_ambBarrageMin" )
		if( level.coop_barrageMin != NIL && level.coop_barrageMin > 0 ){ local.mn = level.coop_barrageMin }
		if( local.mn < 1 ){ local.mn = 400 }
		local.mx = float( getcvar "coop_ambBarrageMax" )
		if( level.coop_barrageMax != NIL && level.coop_barrageMax > 0 ){ local.mx = level.coop_barrageMax }
		if( local.mx <= local.mn ){ local.mx = local.mn + 1000 }

		//random bearing + distance in the band. Built by ADDITION of a randomised offset rather than
		//a negative literal inside the vector - a bare negative in a vector literal is a parse killer.
		local.span = local.mx - local.mn
		local.dx = local.mn + ( randomint local.span )
		local.dy = local.mn + ( randomint local.span )
		if( ( randomint 2 ) == 1 ){ local.dx = 0 - local.dx }
		if( ( randomint 2 ) == 1 ){ local.dy = 0 - local.dy }

		local.pos = local.p.origin
		local.pos[0] = local.pos[0] + local.dx
		local.pos[1] = local.pos[1] + local.dy
		//put it on the floor, or the burst hangs in the air at player height
		local.pos[2] = waitthread coop_mod/bunker.scr::groundz local.pos

		//whistle first, then the burst - the lead-in is what sells it as incoming
		local.snd = spawn script_origin
		local.snd.origin = local.pos
		local.snd playsound ( "coop_amb_artillery" + ( ( randomint 4 ) + 1 ) )
		wait ( 0.6 + randomfloat( 0.5 ) )

		local.fx = spawn script_model
		local.fx model "models/animate/fx_explosion_mine.tik"
		local.fx.origin = local.pos
		local.fx anim start
		thread coop_barrage_cleanup local.fx local.snd
	}
}end

//=========================================================================
// Retire one barrage shell's fx + sound origin. Separate thread so the loop above keeps its
// cadence instead of blocking for the lifetime of every burst.
//=========================================================================
coop_barrage_cleanup local.fx local.snd:{
	wait 3
	if( local.fx != NIL && local.fx != NULL ){ local.fx remove }
	if( local.snd != NIL && local.snd != NULL ){ local.snd remove }
}end
