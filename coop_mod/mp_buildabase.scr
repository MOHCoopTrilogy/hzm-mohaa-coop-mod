//=========================================================================
// MP_BUILDABASE.SCR - Build-A-Base MP MODE.
//
// This LOADS the real AlienX BaseBuilder (UBER-MODS-v8.00, alienx/basebuild.scr) on the eligible
// BaseBuilder maps. It is NOT a reimplementation - it invokes the actual basebuild mod exactly as a
// UberMod BaseBuilder map script does: `basebuild.scr::main <params>` at the top, then the mod's own
// per-map build stations (`basebuild.scr::basebuild ( origin ) "model" ...`). The 39 maps' station data
// was harvested verbatim from the mod into coop_mod/mp_basebuild_stations.scr (generated by
// docs/tools/gen_basebuild_maps.py from docs/tools/basebuild_stations.tsv).
//
// mp.scr dispatches this through its seam (a switch on level.coop_mpMode):
//     mp.scr::mp_modeInit -> mode_init   (pre-spawn: start basebuild + spawn its stations for this map)
// The per-player spawn/think/death edges are deliberately no-ops: basebuild owns the whole player
// experience (its own build tools, weapon handling, the fight after the build timer), so the mode must
// NOT hand out an armory kit or manage the player - that is why buildabase is excluded from
// mp.scr::mp_modeUsesArmory.
//
// COOP SAFETY (the standing rule: never impact coop). This is an MP file (coop_mod/mp*.scr in
// MP_MANIFEST) and every entry is gated on level.coop_mpRun, which ONLY coop_mod/mp.scr sets and which
// any level load wipes - so basebuild can never run on a coop map. basebuild changes two engine cvars at
// build time (sv_runspeed, g_kblock) and RESTORES both itself at every exit (basebuild.scr:149/265/294),
// and coop re-initialises its own movement speed on load, so neither can follow anyone into coop. The
// alienx/basebuild.scr subsystem is admitted as an MP callee in the isolation contract's clause-10
// allowlist; it names no coop_mp* token, no coop_lo*/coop_health state and no ui/loadout tree.
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main. Kept so an accidental exec is a no-op.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end


//Liveness probe (TRAPS T1). If this file parse-kills, ::alive is unreachable and the mode stays off.
alive:{
	end 1
}end


//isOn guard.
isOn:{
	if( level.coop_mpRun != 1 ){ end 0 }
	if( level.coop_mpMode != "buildabase" ){ end 0 }
	end 1
}end


//=========================================================================
// PRE-SPAWN INIT (mp.scr::mp_modeInit). Start the real BaseBuilder for this map if it is an eligible
// BaseBuilder map, then spawn its build stations once the map is ready.
//=========================================================================
mode_init:{
	if( level.coop_mpRun != 1 ){ end }

	local.map = getcvar( "mapname" )

	//eligibility: bb_mainFor returns the map's basebuild::main args, or "" if the map has no station data.
	local.elig = waitthread coop_mod/mp_basebuild_stations.scr::bb_mainFor local.map
	if( local.elig == "" ){
		println( "^~^~^ MPBAB map " + local.map + " has no BaseBuilder station data - mode inert here" )
		end
	}

	//clear any stale K-block from a prior build round so basebuild starts from a clean baseline.
	setcvar "g_kblock" "0"

	level.coop_mpBabActive = 1
	//tell basebuild.scr::main we are already past the level 'spawn' edge (we run at ServerSpawned via the E4
	//hook), so its internal `level waittill spawn` is skipped instead of throwing "invalid waittill". Neutral
	//flag name (not coop_mp*) so the coop-classified basebuild.scr may read it without tripping isolation.
	level.hzmArenaSpawned = 1
	println( "^~^~^ MPBAB starting BaseBuilder on " + local.map )

	//inject the reused MP team spawns on the SP campaign maps (no-op on the mohdm* deathmatch maps, which
	//carry their own bsp spawns). Without this a campaign-map arena has NO player spawns and a builder has
	//nowhere to spawn - snd/cyberattack (mp_cybersnd.scr) and Base Assault/Push seed the same way.
	waitthread coop_mod/mp_arena_spawns.scr::ensureSpawns local.map

	//start the REAL basebuild mod. It self-syncs on the level 'spawn' event, threads its own build loops,
	//and saves/restores sv_runspeed + g_kblock itself. Standard params (matches the mod's map scripts):
	//buildtime 800, objectlimit 1000, buildspeed 500, takeweaps 1, falldamage 1, countdownhide 0,
	//hudhide 0, consoleprint 0.
	exec alienx/basebuild.scr::main 800 1000 500 1 1 0 0 0

	//spawn this map's real build stations. mp.scr::main runs at Level::ServerSpawned (the E4 hook), i.e.
	//AFTER the prespawn/spawn edges - so we spawn synchronously here rather than `level waittill prespawn`
	//(which would throw "invalid waittill" once the edge is gone), exactly as mp_push.scr / mp_cybersnd.scr
	//seed at this same point. Order preserved: basebuild::main above, then its stations.
	waitthread bab_spawnStations local.map
}end


//Spawn the map's authored build stations. bb_stationsFor runs the mod's exact
//`basebuild.scr::basebuild ( origin ) "model" ...` placements for this map.
bab_spawnStations local.map:{
	waitthread coop_mod/mp_basebuild_stations.scr::bb_stationsFor local.map
	println( "^~^~^ MPBAB BaseBuilder stations placed on " + local.map )
}end


//=========================================================================
// SPAWN / THINK / DEATH EDGES - no-ops. BaseBuilder owns the player experience end to end (build tools,
// weapon strip during the build phase, the fight after), so the seam must not give an armory kit or
// otherwise manage the player here.
//=========================================================================
mode_onSpawn local.p:{
	end
}end


mode_think local.p:{
	end
}end


mode_onDeath local.p:{
	end
}end
