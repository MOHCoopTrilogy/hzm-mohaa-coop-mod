//=========================================================================
// actprompt.scr - ICON ACTION PROMPTS: one call to raise or drop "icon + bound key" under the crosshair
//=========================================================================
// [user 2026-10-18] Every "Press [USE] to ..." text prompt became an icon, in the same slot, size and fade
// as the use-to-loot prompt (cgame cg_coopfeed.c CG_DrawCoopAct). A script no longer draws anything: it
// says WHAT is actionable and cgame draws it, key cap and all, hi-res correct at every resolution.
//
//   waitthread coop_mod/actprompt.scr::show local.player "owner" "heal:hold"
//   waitthread coop_mod/actprompt.scr::hide local.player "owner"
//   waitthread coop_mod/actprompt.scr::hold local.player 3000          // a hold began, 3000 ms long
//   waitthread coop_mod/actprompt.scr::holdend local.player
//   waitthread coop_mod/actprompt.scr::hideAll local.player            // death / spectate / map change
//
//   spec = "<icon>[:hold][:fire][:dim][:cap=Word_Word]"
//     icon  textures/hud/loot/coop_act_<icon>.tga (fixes pak) - a NEW prompt is one new tga, no code
//     hold  show the hold track        fire  show the primary-fire key instead of USE
//     dim   not available right now (icon at 45 %, no key; cap= is the one word under it)
//     cap=  a word beside the key (underscore = space)
//
// OWNER: there is ONE prompt slot per player (it is the crosshair), so show/hide are keyed by a caller name:
// hide only clears the prompt if that owner raised the current one. A loop that is not near anything can
// therefore call hide every tick without wiping another system's prompt. Both are change-only: calling
// show every frame with the same spec sends nothing (one stufftext per CHANGE, never per tick).
//
// Wire: stufftext "set coop_act <spec>" / "set coop_actH <ms>" (coop_* is always admitted from the server,
// qcommon/cmd_filter.c). cgame zeroes both on every CG_Init, so a prompt cannot outlive its map.
// Not usable from MP scripts (MP is out of scope, check_mp_isolation).
//=========================================================================


show local.player local.owner local.spec:{
	if( local.player == NIL || local.player == NULL ){ end }
	if( local.player.flags["coop_actSpec"] == local.spec ){
		local.player.flags["coop_actOwner"] = local.owner
		end
	}
	local.player.flags["coop_actSpec"] = local.spec
	local.player.flags["coop_actOwner"] = local.owner
	local.player stufftext ( "set coop_act " + local.spec )
}end


hide local.player local.owner:{
	if( local.player == NIL || local.player == NULL ){ end }
	if( local.player.flags["coop_actOwner"] != local.owner ){ end }
	local.player.flags["coop_actSpec"] = NIL
	local.player.flags["coop_actOwner"] = NIL
	local.player stufftext "set coop_act 0"
	local.player stufftext "set coop_actH 0"
}end


hideAll local.player:{
	if( local.player == NIL || local.player == NULL ){ end }
	if( local.player.flags["coop_actSpec"] == NIL ){ end }
	local.player.flags["coop_actSpec"] = NIL
	local.player.flags["coop_actOwner"] = NIL
	local.player stufftext "set coop_act 0"
	local.player stufftext "set coop_actH 0"
}end


hold local.player local.ms:{
	if( local.player == NIL || local.player == NULL ){ end }
	local.player stufftext ( "set coop_actH " + int( local.ms ) )
}end


holdFrames local.player local.frames:{
	if( local.player == NIL || local.player == NULL ){ end }
	local.fps = int( getcvar( "sv_fps" ) )
	if( local.fps < 5 ){ local.fps = 20 }
	local.player stufftext ( "set coop_actH " + int( ( local.frames * 1000 ) / local.fps ) )
}end


holdend local.player:{
	if( local.player == NIL || local.player == NULL ){ end }
	local.player stufftext "set coop_actH 0"
}end
