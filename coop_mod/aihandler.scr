//[200] Smithy - this script is called every time an actor enters the world by exec it on their tiki (via shared new_generic_human.tik)
// Note: 'team' for SP actors is either 'german' or 'american'.
//       'german' is all axis actors, including Italian.
//       'american' is all allied actors, including British and Russian.
//       Find number of axis in the level with level.coop_actorArray["german"].size
//       Find number of allies in the level with level.coop_actorArray["american"].size
//       Access actors with level.coop_actorArray[team][index]
//       Turn off accuracy calculations for individual actors with .flags["coop_actorStopAccuracy"] = 1
//       Turn off accuracy calculations for all with level.coop_actorAccuracyCalcs = 0
//		 Turn off custom pain handler for individual actors with flags["coop_actorStopPainHandler"] = 1
//       Turn off custom pain handler for all with level.coop_actorPainHandler = 0
//
//       (internal use only)
//  	 [200] Smithy - added thread functionality. added SP grenade functionality. some other improvements.
// 		 [200] Smithy - added calls to itemhandler.scr for weapon handling purposes
//		 [200] Smithy - added disguise functionality (disguisehandler)
//=========================================================================
main local.thread:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/main->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/aihandler.scr::main"

	if (!waitthread coop_mod/main.scr::inCoopMode){ end } //dont load this if we aren't in coop mode
	if (!self){ end }
	if (local.thread == NIL){ end }
	if (self.classname != "Actor"){ end }

	//println "loading " self.classname

	//make sure main.scr has loaded
	waitthread coop_mod/main.scr::waitForMainScript
	if (!self){ end }

	//[200] Smithy - adds maps we don't want to use the custom pain handler on
	if (!level.coop_painHandlerExclusionInit){
		waitthread painHandlerMapExclusions
	}

	//[200] Smithy - handles cover blown logic if this is a disguise map
	if (!level.coop_disguiseHandlerInit){
		thread disguiseHandler
	}

	wait game.ms // so entities have properly initialised
	if (!self){ end }

	thread local.thread

}end

//[200] Smithy - moved actor stuff out of main into its own func
//does all actor stuff (internal use only)
//=========================================================================
actorHandler:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/actorHandler->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!isAlive self){ end }	

	group.team = self.team

	//store original data
	self.flags["coop_actorAccuracy"] 			= self.accuracy
	self.flags["coop_actorAccuracyRange"] 		= (100 - self.accuracy) //100 is max accuracy
	/* use these in future???
	self.flags["coop_actorHealth"] 				= self.health
	self.flags["coop_actorGun"] 				= self.gun
	self.flags["coop_actorNoticeScale"] 		= self.noticescale
	*/

	if (level.coop_actorPainHandler){ 	//replace painhandler with our own
		thread initialisePainVars
	}

	//HZM coop - register for Frontline battle chatter (flchatter picks living AIs near players)
	thread coop_mod/flchatter.scr::flchatter_register

	//HZM coop - register for the SITUATIONAL voice layer (coop_mod/aivoice.scr): under fire ->
	//"take cover"/"need backup", man down, reload, in-combat taunt. Nationality is resolved from
	//the MODEL there (de/it/us/uk) so a British model never speaks US lines and vice versa.
	thread coop_mod/aivoice.scr::aivoice_register

	//HZM coop - retail wired sethelmet (helmet pops off on head hits) on 131 human models but
	//missed a handful; give the stragglers the same config their wired siblings use.
	if (self.model == "models/human/1st-ranger_engineer.tik" || self.model == "models/human/1st-ranger_sergeant.tik" || self.model == "models/human/1st-ranger_private_prisoner.tik" || self.model == "models/human/allied_oss_man_m1.tik"){
		self sethelmet "models/equipment/usgear/helmet_ranger_private.tik" 150 0.1 "us_helmet"
	}
	
	//[202][hotfix] Smithy - allow us to determine if maps should force weapon drops from actors upon death
	//this is needed because the BT maps often have actors with dontdropweapons set on them individually.
	if (level.coop_forceDropWeapons){ 
		self forcedropweapon
	}

	//[200] Smithy - new func
	if (level.coop_aaMap){ 				// restore any properties that are AA specific
		thread restoreAAProperties
	}
	thread restoreSPProperties 			// restore any properties that are SP specific
	thread updateEnemyDifficulty 		// update this guy's difficulty
	thread leaveTurretUnholstered 		// make sure if he's a gunner that he leaves it unholstered

	thread addActorToArray

	//[user 07-23] DYNAMIC AI: give BASE map enemies the same personality roll (aggressive/cover/flank/
	//prone) that reinforcement replicas + officer waves already get - so normal enemies flank, take
	//cover and push instead of standing as turrets. Enemies only (self.team german); replicas/waves
	//already carry coop_personality_set so the re-call is a cheap no-op. Gated on coop_aiDynamic (off
	//by default until tuned + verified with the coop_aiBehav tracker).
	if( getcvar( "coop_aiDynamic" ) == "1" && self.team == "german" ){
		thread coop_mod/officer.scr::coop_apply_personality self
	}

	thread coop_tryDuplicateActor 		//[208] HZM coop - per-spawn enemy count-scaling by player count

	self waittill death 				//'death' event is unregistered if an AI is killed or if they are removed

	waitframe 							//[200] Smithy - fixes NULL entities in array and other abnormalities

	thread addKillToPlayer
	thread removeActorFromArray

	if (!self){ end }

	//[user 08-02] CANTEEN BELT ON DEATH. The sip's canteen is attached by a frame-4 anim event and
	//detached by script; if the actor dies mid-sip the corpse kept it welded to tag_weapon_left,
	//and corpses persist (coop_corpseLife defaults to 0 = off), so it stayed on the battlefield.
	//removeattachedmodel is idempotent and cheap, so this runs unconditionally on every death.
	if( self.flags["coop_canteenOut"] == 1 ){
		self.flags["coop_canteenOut"] = 0
	}
	self removeattachedmodel "tag_weapon_left"

	//[209] HZM coop - DEATH VOICE fires HERE (past the waitframe + self-null guard), NOT the instant the
	//'death' event resumes. Engine truth (openmohaa actor.cpp Actor::Remove, which BOTH `delete` and
	//`remove` route to): removing a LIVE actor sets health=0 + Unregister(STRING_DEATH) - i.e. it fires
	//this very `waittill death` for a NON-combat REMOVAL (m1l1 intro 'walker' patrol self-deletes after
	//walking; ~27 maps dispose of scenic/intro/cutscene actors the same way) - then Delete()s the entity
	//that SAME frame. A genuine kill instead leaves a persistent CORPSE. So an actor that SURVIVES the
	//waitframe above == a real death (voice it); a removed actor is already gone (self==NULL, ended above)
	//== stays silent. Preserves every combat/scripted KILL voice; kills the "random death grunts at level
	//start". (A health test can't tell them apart - Actor::Remove zeroes health on removal too.)
	thread coop_mod/deathvox.scr::play self 1	//[208] HZM coop - varied death voice + mute native German/Italian death VO (real deaths only)

	thread coop_mod/gurgle.scr::play self		//[209] HZM coop - occasional subtle wet bleed-out gurgle near this fresh corpse (real deaths only - past the same bug-822 guard)

	thread coop_mod/itemhandler.scr::enableWeapon 		//[200] Smithy - make it so their weapon can now be triggered (thus picked up)

	if (level.coop_enableDisguises){
		if (self && self.fact && self.fact.attacker && self.fact.attacker.classname == "Player"){
			thread sentientIsSeen self self.fact.attacker 360
		}
	}

	if (!level.coop_noDropHealth){ 						//[200] Smithy - do our own health drops if the map allows it
		thread coop_mod/itemhandler.scr::handleHealthDrop
	}

	thread coop_mod/corpse.scr::despawn self 			//[208] HZM coop - fade + remove the body after coop_corpseLife sec (0=off)
}end

//[208] HZM coop - PER-SPAWN ENEMY COUNT-SCALING (player-count). Threaded from actorHandler for EVERY
//actor entering the world, so it covers map-preplaced AND scripted/wave/trigger spawns at any time.
//With 2+ players, each ENEMY (german, non-special) rolls a per-player CHANCE to spawn an exact replica
//nearby (staggered + scattered so they don't stack). Recursion-guarded (coop_isReplica) so a clone
//never clones again. Excludes allies, the officer, wave/special actors (coop_actorStopPainHandler -
//these use bespoke health), and turret gunners. Capped by level.coop_aiScaleHardCap (entity budget).
//Tunable cvars: coop_aiScale (1=on, default on; set 0 to disable), coop_aiScaleChance (0-100, def 50).
//=========================================================================
coop_tryDuplicateActor:{
//=========================================================================
	if( self == NULL ){ end }
	if( self.flags["coop_isReplica"] == 1 ){ end }		// recursion guard FIRST: a replica never duplicates
	if( getcvar "coop_aiScale" == "0" ){ end }			// master gate (default ON)
	if( self.team != "german" ){ end }				// enemies only - never allies (team set synchronously)
	// player count (with a solo-dev override: coop_aiScaleTest 1 makes a lone host scale as if 2 players)
	local.pc = 0
	if( $player != NULL ){ local.pc = $player.size }
	if( getcvar "coop_aiScaleTest" == "1" && local.pc < 2 ){ local.pc = 2 }
	if( local.pc < 2 ){ end }					// only when 2+ players (or the test override)

	// let initialisePainVars finish (it stores coop_actorActualHealth + sets self.health=5000) and give a
	// brief spawn delay so replicas never appear the same instant / on top of the original.
	wait 0.3
	if( self == NULL || !isAlive self ){ end }

	// exclude the officer + wave/special actors (bespoke health systems) + turret gunners
	if( self.flags["coop_actorStopPainHandler"] == 1 ){ end }
	if( self.flags["coop_waveActor"] == 1 ){ end }		//[310] officer waves scale their own SIZE (officer.scr coop_reinf_count) - never double-dip
	if( level.coop_officer != NULL && self == level.coop_officer ){ end }
	if( self.turret != NULL ){ end }

	// how many EXTRA copies to roll: scales with player count, capped by coop_maxPlayerScalar
	local.scal = local.pc
	if( level.coop_maxPlayerScalar != NIL && local.scal > level.coop_maxPlayerScalar ){ local.scal = level.coop_maxPlayerScalar }
	local.maxExtra = local.scal - 1
	// [2026-07-24] MORE SQUADS (coop_squadDensity, default 0): extra copies per original beyond the
	// player-count baseline, so each spawn seeds a bigger COHESIVE squad - the replicas spawn scattered
	// near the original, so aisquad.scr groups them into a fighting unit. Bounded by the live hardcap
	// (coop_aiScaleHardCap) for entity-budget safety; the density add itself is capped at +4.
	local.dens = int( getcvar "coop_squadDensity" )
	if( local.dens > 4 ){ local.dens = 4 }
	if( local.dens > 0 ){ local.maxExtra = local.maxExtra + local.dens }
	if( local.maxExtra < 1 ){ end }

	local.chance = int( getcvar "coop_aiScaleChance" )
	if( local.chance <= 0 ){ local.chance = 50 }

	// snapshot the original's loadout: pristine base accuracy + STORED original health (self.health is
	// 5000 now because of the pain handler), model + gun.
	local.omodel = self.model
	if( local.omodel == NIL ){ end }
	local.ogun   = self.gun
	local.oacc   = self.flags["coop_actorAccuracy"]
	local.ohealth = self.flags["coop_actorActualHealth"]
	if( local.ohealth == NIL || local.ohealth <= 0 || local.ohealth >= 1000 ){ local.ohealth = 100 }
	local.oorigin = self.origin
	local.oangles = self.angles
	// HZM coop [configstring-churn]: snapshot the parent's RESOLVED head model + head skin so the replica can
	// reuse the parent's already-registered model configstring instead of the engine minting a fresh RANDOM
	// head/skin combo (a new CS_MODELS slot) for every clone. Getter returns "" if unset - gated on the set side.
	local.ohead = self.headmodel
	local.oskin = self.headskin

	local.made = 0
	local.i = 0
	while( local.i < local.maxExtra ){
		// live-actor hardcap so a full lobby + duplication can't overflow the entity budget
		if( level.coop_aiScaleHardCap != NIL && level.coop_actorArray["german"] != NIL && level.coop_actorArray["german"].size >= level.coop_aiScaleHardCap ){ break }
		if( (randomint 100) < local.chance ){
			thread coop_spawnReplica local.omodel local.ogun local.oacc local.ohealth local.oorigin local.oangles local.made local.ohead local.oskin
			local.made++
			wait 0.2 		// stagger successive copies so they don't pop simultaneously
		}
		local.i++
	}
}end

//[208] HZM coop - spawn ONE enemy replica: same model/gun/health/base-accuracy, scattered ground pos,
//flagged coop_isReplica (set before this thread yields so the clone's own actorHandler won't re-clone),
//then forceactivate + attackplayer. The clone's own actorHandler still runs the full coop pipeline
//(pain handler, accuracy scaling, array registration) - only the duplication sub-step is skipped.
//=========================================================================
coop_spawnReplica local.model local.gun local.acc local.health local.origin local.angles local.idx local.hm local.hs:{
//=========================================================================
	if( local.model == NIL ){ end }
	local.spreadidx = local.idx + 1
	local.gnd = exec coop_mod/officer.scr::coop_spread_pos local.origin local.spreadidx
	if( local.gnd == NIL ){ local.gnd = local.origin }
	local.r = spawn local.model
	if( local.r == NULL ){ end }
	local.r.flags["coop_isReplica"] = 1		// CRITICAL recursion guard - set BEFORE this thread yields
	// HZM coop [configstring-churn]: pin the clone's head model + head skin to the PARENT's resolved pick BEFORE
	// the gun command (whose setModel bakes the weapon+head+skin configstring). With both pinned, the clone's
	// final model string equals the parent's already-registered one - dedupes, no new CS_MODELS slot minted.
	// Gated on non-empty so a parent with an unresolved pick just falls back to the old random behaviour.
	if( local.hm != NIL && local.hm != "" ){ local.r.headmodel = local.hm }
	if( local.hs != NIL && local.hs != "" ){ local.r.headskin = local.hs }
	local.r.origin = local.gnd
	local.r droptofloor
	local.r.angles = local.angles
	local.r.health = local.health
	if( local.acc != NIL ){ local.r.accuracy = local.acc }
	if( local.gun != NIL ){ local.r gun local.gun }
	local.r.leash = 4096
	local.r.enableEnemy = 1
	local.r german
	//[user 2026-08-09] A CLONE MUST NOT BE BORN HOSTILE DURING A STEALTH PHASE. The replica still
	//spawns and still runs the full coop pipeline - it simply is not handed a target, exactly like
	//the guards the disguise already protects you from.
	//[user 2026-08-09] forceactivate ALWAYS - it only makes the actor live, and gating it left
	//clones inert, which reads in-game as "their animations are blocked". Only `attackplayer`,
	//which hands them the player as a target, belongs behind the stealth gate.
	local.r forceactivate
	if( waitthread coop_stealthBlocksAggro NIL ){
		if( getcvar( "coop_aggroDebug" ) == "1" ){ println( "^~^~^ AGGRO BLOCKED replica-spawn" ) }
	}else{
		local.r attackplayer
	}
	// replicas behave naturally too (personality roll + cover think + hurt manager coverage)
	waitthread coop_mod/officer.scr::coop_apply_personality local.r
}end

//[208] HZM coop - shared low-frequency REINFORCEMENT MANAGER. One loop for ALL spawned troopers (not
//per-actor, for performance). When a personality-tagged trooper is BADLY hurt it (once) falls back to
//cover (native type_attack "cover") and drinks from a canteen for a partial heal. Guarded against
//dead/NULL actors. Started once from coop_mod/main.scr::main so it runs on every map.
//=========================================================================
coop_reinf_brain:{
//=========================================================================
	while( 1 ){
		wait 1.5
		local.arr = level.coop_actorArray["german"]
		if( local.arr == NIL ){ continue }
		//[user 2026-07-28] BULLET-SPONGE SWEEP - hoisted per-tick gate, so the cvar is read ONCE per 1.5s
		//tick and NOT once per actor (this loop walks up to ~80 germans). See the block inside the loop.
		//coop_unsponge: 0 = off, 1 = on + "^~^~^ UNSPONGE" log (DEFAULT, unset counts as 1), 2 = on, silent.
		local.unsponge = 1
		local.usc = getcvar "coop_unsponge"
		if( local.usc == "0" ){ local.unsponge = 0 }
		if( local.usc == "2" ){ local.unsponge = 2 }
		local.i = 1
		while( local.i <= local.arr.size ){
			local.a = local.arr[local.i]
			if( local.a != NULL && isAlive local.a ){
				//=================================================================================
				//[user 2026-07-28] BULLET-SPONGE SWEEP ("an AI that takes thousands of rounds").
				//
				//STRUCTURAL CAUSE: initialisePainVars buffers EVERY german's ENGINE health to 5000
				//(see 'self health 5000' below) and moves the real hp into coop_actorActualHealth.
				//The ONLY thing that can ever undo that buffer is the coop pain handler, and the
				//engine reaches it from exactly ONE place - actor.cpp Actor::HandlePain ->
				//ExecuteScript(global/pain.scr) - behind TWO gates:
				//    if (!m_bEnablePain) { return; }        <- 'self.enablePain = 0'
				//    if (!m_bNoLongPain) { ...ExecuteScript... }   <- 'self.nolongpain = 1'
				//So the instant any script flips either one on a buffered body, global/pain.scr
				//stops running, coop_actorActualHealth stops being decremented, the scripted kill
				//at the bottom of handlePain is never issued, and the ONLY way left to drop that
				//actor is chewing the raw 5000 engine hp. That is the bullet sponge. Scripts that
				//ALSO do 'self.health += 10000' on top of the buffer (the retail balcony gags) push
				//it to 15000.
				//
				//WHY A SWEEP AND NOT PER-SITE PATCHES: some offenders are not in this mod at all.
				//maps/e3l2.scr execs global/balconyGuy.scr, which this mod does NOT ship, so the
				//RETAIL Breakthrough copy runs (health += 10000 + nolongpain = 1). We cannot patch
				//what we do not ship, and every future map/gag that touches nolongpain would be a
				//fresh leak. This reconciles by SYMPTOM instead, so it self-heals unknown paths.
				//Fires at most ONCE per actor (it sets coop_actorStopPainHandler, which excludes the
				//actor from its own condition on every later tick). COST on the healthy path, which is
				//what matters with ~80 enemies: 2 flag reads + 1 health read + 1 var read + 1 compare.
				//Everything past the high-water-mark test only runs for a body that is LOSING health
				//without the handler restoring it - i.e. an actor that is already broken.
				//=================================================================================
				//[user 08-02] GATE WIDENED. This used to REQUIRE coop_actorHandledPain, which made the
				//sweep blind to any actor that never completed pain-init - and a live t3l1 session proved
				//the blind spot is real: the player fought an axis actor that soaked an absurd amount of
				//fire with coop_unsponge ON, and the sweep logged ZERO repairs all session. An actor
				//sitting on a big engine-health pile is a sponge whether or not our own flag was ever set,
				//so detect by SYMPTOM only and keep just the stop-flag exclusion.
				if( local.unsponge != 0 && !local.a.flags["coop_actorStopPainHandler"] ){
					//HIGH-WATER MARK. Only ever intervene on a body the players are ACTUALLY shooting, i.e. one
					//whose ENGINE health has dropped below its own peak. Two reasons. (1) SAFETY: map gags routinely
					//park an actor on a big authored health and then poll it for a CHANGE - maps/t1l3.scr does
					//'local.health = self.health' then 'while (local.health == self.health){ waitframe }' - so
					//writing health to an UNTOUCHED actor would trip those gates and play a scripted death nobody
					//earned. (2) EXACTNESS: waiting for the first hit costs the player one bullet and makes the
					//delta below land on precisely the vanilla number. It is also the cheap path: a WORKING pain
					//handler restores health to exactly 5000 after every single hit, so a healthy actor never drops
					//below its own peak and costs one compare per tick.
					local.eng = local.a.health
					if( local.a.coop_unspongePeak == NIL || local.eng > local.a.coop_unspongePeak ){
						local.a.coop_unspongePeak = local.eng
					}
					if( local.eng < local.a.coop_unspongePeak ){
						local.rhp = local.a.flags["coop_actorActualHealth"]
						if( local.rhp == NIL || local.rhp == NULL || local.rhp <= 0 ){ local.rhp = 100 }
						//SLOP for detector 2: german-on-german damage is dropped by the engine BEFORE the
						//nolongpain gate (Actor::HandlePain returns early on IsTeamMate), so friendly fire
						//legitimately walks the buffer down a little with no handler restore. That case is
						//ALREADY self-healed by the "health changed elsewhere" guard in actorPainHandler the
						//moment a player lands a hit, so detector 2 must not beat it to the punch. 500 is
						//more than the biggest single friendly explosion and still only ~14 rifle rounds
						//against a 5000 sponge, i.e. invisible to the player.
						//[user 08-02] The buffer is a CVAR now (coop_aiBuffer, see initialisePainVars), so
						//every detector below must key off the ACTUAL value. Hardcoding 5000 here while the
						//buffer shipped at 1000 would have made detector 2 ("eng > 1000") dead on arrival -
						//i.e. it would have silently switched the whole sweep off.
						local.bufv = local.a.flags["coop_aiBufferVal"]
						if( local.bufv == NIL || local.bufv <= 0 ){
							local.bufv = int( getcvar "coop_aiBuffer" )
							if( local.bufv <= 0 ){ local.bufv = 1000 }
						}
						//lower bound for detector 2: an absolute small script write is NOT a sponge. Scale it
						//with the buffer instead of the old fixed 1000 so the two never invert.
						local.bufLow = local.bufv / 5
						if( local.bufLow < 200 ){ local.bufLow = 200 }
						local.engFloor = local.bufv - local.rhp - 500
						//why: 1 = a script stacked health ON TOP of the 5000 buffer (nothing legitimate ever
						//         raises a buffered actor above 5000 - the handler only writes exactly 5000).
						//     2 = OVER-TANKED: absorbed more raw engine damage than its ENTIRE real hp pool
						//         (plus slop) and STILL sitting on a big pile of engine health. Impossible
						//         while the handler is running. This is the symptom-level catch-all: it covers
						//         enablePain 0 (which has NO script getter, so it cannot be read directly) and
						//         any future detacher nobody has thought of yet. The "> 1000" lower bound
						//         matters: a gag that writes an ABSOLUTE small health (maps/e3l3/scene3.scr
						//         does 'self.health = 500') already un-buffered itself and is NOT a sponge.
						//     3 = nolongpain is set, i.e. the engine dispatch is provably severed (the exact
						//         signal). Checked last because it is a property read, not a local compare.
						local.why = 0
						if( local.eng > local.bufv ){
							local.why = 1
						} else if( local.eng > local.bufLow && local.eng < local.engFloor ){
							local.why = 2
						} else if( local.a.nolongpain == 1 ){
							local.why = 3
						}
						if( local.why > 0 ){
							//RECONCILE. Two cases, split on whether the 5000 buffer is still in there at all.
							//(a) eng > 1000: the buffer is still present, so subtract ONLY its contribution.
							//    (eng - 5000) is whatever the MAP script did on top - 0 for a plain strand,
							//    +10000 for the balcony gags, negative for damage already absorbed. Preserving
							//    that offset is what makes the authored vanilla gates line up exactly as they
							//    do in SP again ('while (self.health > 10000)'); assigning the real hp outright
							//    would fire those gates instantly and break the scripted falls.
							//(b) eng <= 1000: an ABSOLUTE script write already destroyed the buffer (maps/e3l3/
							//    scene3.scr 'self.health = 500', maps/e3l4/Tower.scr '= 10'). Nothing is left to
							//    subtract and that actor is not a sponge - honour the authored number and just
							//    detach the coop accounting so it stops lying about this body.
							//Floor at 1 either way: the sweep NEVER kills anyone by itself, the next bullet does.
							if( local.eng > local.bufLow ){
								local.nhp = local.rhp + local.eng - local.bufv
							} else {
								local.nhp = local.eng
							}
							if( local.nhp < 1 ){ local.nhp = 1 }
							local.a.health = local.nhp
							local.a.flags["coop_actorActualHealth"] = local.nhp
							local.a.flags["coop_actorStopPainHandler"] = 1
							if( local.unsponge == 1 ){
								println "^~^~^ UNSPONGE " local.a " model=" local.a.model " tn=" local.a.targetname " why=" local.why " eng=" local.eng " real=" local.rhp " newhp=" local.nhp " buf=" local.bufv
							}
						}
					}
				}
				if( local.a.flags["coop_personality_set"] == 1 && local.a.flags["coop_hurt_covered"] != 1 && local.a.flags["coop_limping"] != 1 ){
					//[user 2026-07-17] a committed wounded-limper (wounded.scr) is already withdrawing to a
					//medkit - don't ALSO cover-seek + canteen-heal him here (they'd fight the same actor).
					// real HP: pain-handler troops store it in coop_actorActualHealth (self.health is the
					// 5000 buffer); coop_actorStopPainHandler troops use self.health directly.
					local.hp = local.a.flags["coop_actorActualHealth"]
					if( local.hp == NIL ){ local.hp = local.a.health }
					if( local.hp != NIL && local.hp > 0 && local.hp < 40 ){
						//[user 2026-08-10] A3 INSTRUMENT (master plan v2 Step 4). Prints only - no behaviour
						//change - so the next run names which system rewrites a scene actor.
						//hasAlarm is a 0/1 BOOLEAN on purpose: alarmthread is an EV_GETTER returning a const
						//ARRAY when set, and concatenating that into a string throws, which SKIPS the whole
						//println - so a naive print would have emitted lines only for actors with NO
						//alarmthread, i.e. never for the welders, the cower man or the scientists, which are
						//exactly the actors this probe exists to attribute.
						if( getcvar( "coop_aggroDebug" ) == "1" ){
							local.hasAlarm = 0
							if( local.a.alarmthread != NIL ){ local.hasAlarm = 1 }
							println( "^~^~^ HURT actor=" + local.a.targetname + " hp=" + local.hp + " oldtype=" + local.a.type_attack + " hasAlarm=" + local.hasAlarm )
						}
						//[user 2026-08-10] A4: A3 caught this branch hitting suckyfatty (the card man) three
						//times at hp=2 - the seated card-player health - flipping his type_attack around.
						//WRAPPED, NOT `continue`: the enclosing loop is a WHILE (:302) whose index only
						//advances at :484, so a continue here would skip the increment and spin the
						//server forever. In a for-loop continue is safe; in this one it is a hang.
						local.aProt = waitthread coop_mod/officer.scr::coop_isProtectedActor local.a
						if( local.aProt != 1 ){
							local.a.flags["coop_hurt_covered"] = 1
							local.a type_attack "cover"		// fall back to cover (native; crouches at duck nodes)
							thread coop_trooper_canteen local.a
						}
					}
				}
				// IDLE LIVELINESS: a tagged trooper with NO current target (waiting/unaware) mutters in
				// German now and then so they aren't dead-silent before they spot a player. Per-actor
				// cooldown + chance + distance falloff = ambient chatter, not spam. SAFE: playsound does
				// not change the think state, so combat reaction is unaffected.
				// HZM fix (bug-1172): unlike flchatter.scr's taunt/bark system (which hard-blocks the
				// first 15s of a map), this loop had NO map-time gate at all - every personality-tagged
				// trooper near a scripted intro (e.g. m1l1's checkpoint, further multiplied by
				// coop_tryDuplicateActor's enemy-count-scaling clones) independently rolled the same
				// "curious" VO pool on its own cooldown, stacking into constant chatter right at mission
				// start ("bitte" etc., CurD_O_* curious-reaction lines). Match flchatter's own proven gate.
				// [user 2026-07-28] "I want the dialogue to be more logical, not so random ... maybe
				// that will help this random German dialogue I keep hearing that I think is them
				// saying 'Bitte'." THIS LOOP IS THAT SOUND: coop_officer_idle1..4 are
				// sound/dialogue/Generic/G/curious/CurD_O_003a/004a/005a/008a.wav - German CURIOUS
				// reactions ("bitte?" = "come again?") fired as a pure timer roll by EVERY
				// personality-tagged trooper on a 2800-unit radius with no situation behind it.
				// It is now OFF whenever the situational layer is running (coop_aiVoice != 0, the
				// default) - coop_mod/aivoice.scr speaks for these troopers only when something
				// actually happens. Set coop_aiVoice 0 to get the old random mutter back.
				if( getcvar( "coop_aiVoice" ) == "0" && level.time >= 15 && local.a.flags["coop_personality_set"] == 1 && local.a.enemy == NULL ){
					if( local.a.coop_idle_next == NIL || level.time >= local.a.coop_idle_next ){
						local.a.coop_idle_next = level.time + 7 + (randomint 9)
						if( (randomint 100) < 45 ){
							local.r = randomint 4
							if( local.r == 0 ){ local.a playsound coop_officer_idle1 }
							else if( local.r == 1 ){ local.a playsound coop_officer_idle2 }
							else if( local.r == 2 ){ local.a playsound coop_officer_idle3 }
							else { local.a playsound coop_officer_idle4 }
						}
					}
				}
			}
			local.i++
		}
	}
}end

//[208] HZM coop - a badly-hurt trooper drinks from a canteen ONCE for a partial heal, using the same
//pass_canteen_drink anim the escort ally uses (new_generic_human.tik; auto-plays the drink sound +
//attaches the canteen model). Threaded per-actor (rare), so the manager loop never blocks.
//=========================================================================
coop_trooper_canteen local.a:{
//=========================================================================
	if( local.a == NULL || local.a.flags["coop_drank"] == 1 ){ end }
	local.a.flags["coop_drank"] = 1
	wait 1
	if( local.a == NULL || !isAlive local.a ){ end }
	// HZM fix (bug-1199) - THE canteen-stuck-to-the-rifle bug, root-caused from the TIKI:
	// models/human/new_generic_human.tik defines pass_canteen_drink with TWO server frame events -
	//     4   attachmodel models/miscobj/canteen.tik tag_weapon_left
	//     47  removeattachedmodel tag_weapon_left
	// The detach is a FRAME-47 event, so it only fires if the anim actually plays through to
	// frame 47. This is an UPPERANIM on a live combat AI: the moment the actor decides to aim or
	// fire, its own upper-body anim replaces the drink and frame 47 never arrives - so the canteen
	// stays welded to tag_weapon_left (the left-weapon tag, which is why it reads as "stuck to
	// their rifle"). User confirmed seeing exactly this, on a build with no damage-related change
	// in it at all - so DAMAGE WAS NEVER THE CAUSE. An earlier attempt here wrapped the sip in
	// nodamage on that wrong theory; that only bought a hard invulnerability window whose sole
	// release was the next line, so any script error in between would have left the trooper
	// permanently bulletproof. Removed - it fixed nothing and risked a lot.
	// The real fix is to issue the SAME detach the anim would have, unconditionally, from script.
	// Also mirrored into an independent watchdog so a dead thread still cleans up.
	//[user 08-02] Mark the canteen as OUT before issuing the anim, so the watchdog below is bound
	//to actual ownership instead of a wall clock. See the note on coop_trooper_canteen_restore.
	local.a.flags["coop_canteenOut"] = 1
	thread coop_trooper_canteen_restore local.a
	local.a upperanim pass_canteen_drink
	//[user 08-02] DROP IT IF THEY RE-ENGAGE. Was a flat `wait 2.5`. Per the user: "if they can't
	//heal in time, they drop it". Poll in short slices instead, and abort the sip the moment the
	//trooper acquires an enemy - a soldier being shot at does not calmly finish his canteen. This
	//also shortens the window in which the canteen can be left attached at all.
	local.t = 0
	local.interrupted = 0
	while( local.t < 2.5 ){
		if( local.a == NULL || !isAlive local.a ){ break }
		if( local.a.enemy != NULL && local.a.enemy != NIL ){ local.interrupted = 1; break }
		wait 0.25
		local.t = local.t + 0.25
	}
	if( local.interrupted == 1 ){
		//dropped, not drunk: detach and take NO heal. The watchdog keeps sweeping either way.
		if( local.a != NULL ){
			local.a upperanim pass_canteen_end
			local.a removeattachedmodel "tag_weapon_left"
		}
		end
	}
	//[bug-1232] A fixed wait RACES the animation. `upperanim` does not start instantly on a busy
	//combat AI, and the attach is a FRAME-4 event - so a plain removeattachedmodel here can fire
	//BEFORE the canteen is ever attached, and then the anim attaches it afterwards with nothing
	//left to clean it up. That is why the first fix did not hold.
	//Use the AUTHORED completion path instead: new_generic_human.tik defines pass_canteen_end with
	//`enter removeattachedmodel tag_weapon_left` - an ENTER event, not a frame event, so it cannot
	//be missed however the drink was interrupted. Play it, then still issue the explicit detach as
	//a belt, then let the watchdog sweep again later for the case where the anim is pre-empted too.
	if( local.a != NULL ){
		local.a upperanim pass_canteen_end
		local.a removeattachedmodel "tag_weapon_left"
	}
	if( local.a == NULL || !isAlive local.a ){ end }
	// partial heal, once. Heal the field that actually represents this trooper's life.
	if( local.a.flags["coop_actorActualHealth"] != NIL ){
		local.a.flags["coop_actorActualHealth"] = local.a.flags["coop_actorActualHealth"] + 60
	} else {
		local.a.health = local.a.health + 60
	}
	local.a gore_reset 60	// HZM coop - gore tier 1: canteen heal credits the gore counter
}end

//=========================================================================
//[209] HZM coop (bug-1199) - unconditional canteen DETACH for the sip above. The drink anim only
//detaches the canteen on its frame-47 event, which a combat AI routinely never reaches because its
//own upperanim replaces the drink first. This runs in its own thread so that no failure inside
//coop_trooper_canteen - script error, early end, the actor being interrupted - can leave the canteen
//welded to tag_weapon_left. Deliberately outlives the 2.5s sip. removeattachedmodel is idempotent,
//so running alongside the normal detach (or after the anim's own frame 47) is harmless.
//=========================================================================
coop_trooper_canteen_restore local.a:{
//=========================================================================
	//[bug-1232] POLL rather than fire once: the drink anim can start late or be pre-empted and
	//re-issued, so a single sweep at a fixed time can still miss the attach.
	//[user 08-02] The six-pass / ~12s version was still a WALL CLOCK chasing an ANIMATION EVENT,
	//and it lost that race often enough to be reported again. The attach is a frame-4 event on an
	//upperanim; on a busy combat AI `upperanim` can be deferred well past 12s, and once the last
	//sweep had run the canteen was welded for the rest of that actor's life - and then onto its
	//CORPSE, because coop_corpseLife defaults to 0 (corpses persist). That is the actual bug the
	//user kept seeing.
	//The durable shape is to make the clear conditional on the set having been OBSERVED, not on
	//elapsed time: sweep for as long as the actor still owns a canteen (coop_canteenOut), with a
	//hard 60s cap so a leaked flag can never spin forever. One event per second on one rare actor.
	local.n = 0
	while( local.a != NULL && local.n < 60 ){
		if( local.a.flags["coop_canteenOut"] != 1 ){ break }
		local.a removeattachedmodel "tag_weapon_left"
		local.n++
		wait 1
	}
	if( local.a != NULL ){
		local.a removeattachedmodel "tag_weapon_left"
		local.a.flags["coop_canteenOut"] = 0
	}
}end

//[200] Smithy - new func
//restores properties to better reflect SP behavior (internal use only)
//=========================================================================
restoreSPProperties:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/restoreSPProperties->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	//restoreNadeCount func moved to itemhandler.scr. it is also called from global/weapon.scr now.
	//thread restoreNadeCount
}end

//[200] Smithy - new func
//restores properties to better reflect AA behavior (internal use only)
//=========================================================================
restoreAAProperties:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/restoreAAProperties->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(group.team == "american"){
		self.runanimrate = level.coop_aaRunSpeed[group.team]
	}
}end

//adds the actor to the level.coop_actorArray array (internal use only)
//=========================================================================
addActorToArray:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/addActorToArray->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(!isAlive self || self.classname != "Actor"){
		//error ("coop_mod/aihandler.scr::addActorToArray - never call this func from outside aihandler.scr")
		end
	}

	local.index = level.coop_actorArray[group.team].size + 1
	group.actor = self
	level.coop_actorArray[group.team][local.index] = self
}end

//removes the dead or removed actor from the actor array (internal use only)
//=========================================================================
removeActorFromArray:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/removeActorFromArray->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.oldArray[group.team] 		= level.coop_actorArray[group.team]
	local.newArray[group.team][1] 	= NIL
	local.j = 1
	for(local.i = 1; local.i <= local.oldArray[group.team].size; local.i++){
		local.actor = local.oldArray[group.team][local.i]
		if(local.actor != NULL && local.actor != group.actor){     //[200] Smithy - added a NULL check and actor comparison instead of index
			local.newArray[group.team][local.j] = local.actor
			local.j++
		}
	}
	level.coop_actorArray[group.team] = local.newArray[group.team]
}end

//updates the run speed for a specified actor team
//=========================================================================
updateTeamRunSpeed local.team local.speed:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/updateTeamRunSpeed->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if((local.team != "american" && local.team != "german") || local.speed == NIL){ end }
	if(local.speed < 0){ local.speed = 0 }

	level.coop_aaRunSpeed[local.team] = local.speed
	for(local.i = 1; local.i <= level.coop_actorArray[local.team].size; local.i++){
		local.actor = level.coop_actorArray[local.team][local.i]
		local.actor.runanimrate = local.speed
	}
}end

//updates the difficulty variables for individual enemy
//=========================================================================
updateEnemyDifficulty:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/updateEnemyDifficulty->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if($player == NULL || $player.size == 0 || self == NULL || self.classname != "Actor"){ end }
	thread calculateProperties self
}end

//updates the difficulty variables for all existing enemies
//=========================================================================
updateEnemyTeamDifficulty:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/updateEnemyTeamDifficulty->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if($player == NULL || $player.size == 0){ end }

	local.team = "german"
	local.actorArray[local.team] = level.coop_actorArray[local.team]

	if(local.actorArray[local.team] == NIL || local.actorArray[local.team].size == 0){
		end
	}

	for(local.i = 1; local.i <= local.actorArray[local.team].size; local.i++){
		thread calculateProperties local.actorArray[local.team][local.i]
	}
}end


//call all difficulty calculcations. we can use this to add more calculations later (internal use only)
//=========================================================================
calculateProperties local.actor:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/calculateProperties->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(local.actor == NULL || local.actor.classname != "Actor" ){
		//error ("coop_mod/aihandler.scr::calculateProperties - never call this func from outside aihandler.scr")
		end
	}

	if(!local.actor.flags["coop_actorStopAccuracy"] && level.coop_actorAccuracyCalcs){
		thread calculateAccuracy local.actor
	}
	// add more here later ???

}end

//do accuracy calculation (internal use only)
//=========================================================================
calculateAccuracy local.actor:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/calculateAccuracy->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(local.actor == NULL || local.actor.classname != "Actor"){
		//error ("coop_mod/aihandler.scr::calculateAccuracy - never call this func from outside aihandler.scr")
		end
	}
	if(local.actor.flags["coop_actorNewAccuracy"] && local.actor.accuracy != local.actor.flags["coop_actorNewAccuracy"]){
		local.actor.flags["coop_actorStopAccuracy"] = game.true
		println(local.actor + " has had his accuracy changed elsewhere. Ignore accuracy calculations in future.")
		end
	}

	if(level.coop_maxPlayerScalar < 0){
		level.coop_maxPlayerScalar = 0
	}
	local.accuracyMult = $player.size
	if(local.accuracyMult > level.coop_maxPlayerScalar){
		local.accuracyMult = level.coop_maxPlayerScalar
	}

	// reset to original accuracy before calculating extra accuracy
	local.actor accuracy local.actor.flags["coop_actorAccuracy"]

	if(local.accuracyMult > 1){
		local.actor accuracy (local.actor.accuracy + ((local.actor.flags["coop_actorAccuracyRange"] / level.coop_maxPlayerScalar) * local.accuracyMult))
	}

	local.actor.flags["coop_actorNewAccuracy"] = local.actor.accuracy
}end

//sets up our pain variables
//=========================================================================
initialisePainVars:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/initialisePainVars->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(!isAlive self || self.classname != "Actor"){
		//error ("coop_mod/aihandler.scr::initialisePainVars - never call this func from outside aihandler.scr")
		end
	}

	//[200] Smithy - don't do certain actors that use their own health systems
	if (self.team == "american"){
		self.flags["coop_actorStopPainHandler"] = game.true
		end
	}

	//[user 08-02] SOVIET ALLIES COUNT AS ALLIED TOO. The exemption above keys on MOHAA's internal
	//team enum, which only has "american" and "german" - there is no soviet team. Spearhead's
	//Soviet actors are allies in fiction but fall through here as german, so coop buffered their
	//health like an enemy's. That is why t3l1's two riflemen by the Opel truck survive the
	//scripted blast: JeepExplosion does radiusdamage 700, the buffer is coop_aiBuffer (1000), so
	//they walk away at 300 - while in single player they sit on their authored ~100hp and die
	//outright, which is the behaviour the mission is scripted to have.
	//Model test rather than team, mirroring the nationality detection in coop_mod/aivoice.scr and
	//the story-actor blocklist in aivoice_register. Covers soviet_infantry/officer/corporal and
	//the russian_* variants.
	if( self.model != NIL ){
		if( waitthread coop_mod/main.scr::containsText self.model "soviet" 0 ){
			self.flags["coop_actorStopPainHandler"] = game.true
			end
		}
		if( waitthread coop_mod/main.scr::containsText self.model "russian" 0 ){
			self.flags["coop_actorStopPainHandler"] = game.true
			end
		}
	}

	if (self.flags["coop_actorStopPainHandler"]){
		end
	}

	//HZM coop - gag-armored VIP actors (t1l3 colonel/rider etc. use health >= 1000000 as the "essential
	//NPC" convention) must NEVER enter the pain-handler system: the >700 clamp below collapses their armor
	//to 100hp, and the handler's "health changed elsewhere" path then does 'self health 100' + re-applies
	//the damage, so ONE bombing-run hit during an authored takedamage window (t1l3 pretrigger3, colonel
	//standing in front of the second house) kills the mission VIP and breaks the sequence.
	//The flag also excludes them from count-scaling duplication.
	if (self.health > 1000000){
		self.flags["coop_actorStopPainHandler"] = game.true
		end
	}

	self.flags["coop_actorHandledPain"] = game.true

	if (self.health > 700){
		self.health = 100
	}

	//store the health he started with
	//[200] Smithy - improved these conditions
	if(self.flags["coop_actorActualHealth"] == NIL){
		self.flags["coop_actorActualHealth"] = self.health
	}else if(self.flags["coop_actorActualHealth"] <= 0 || self.flags["coop_actorActualHealth"] >= 1000){
		self.flags["coop_actorActualHealth"] = 100
	}

	//[user 2026-07-17] snapshot the real starting HP as the % denominator for the wounded-limp trigger
	//(coop_mod/wounded.scr). self.health is about to be buffered to 5000 below, so it can't be used later.
	self.flags["coop_woundedMaxHp"] = self.flags["coop_actorActualHealth"]

	//[2026-07-23] DEV/TEST ONLY (coop_aiTestHp, default 0/off): multiply the tracked REAL hp so enemies
	//survive the combat bot's lethal fire long enough to exhibit survival behaviors (tactical retreat,
	//prone, wounded-limp) for automated measurement. Never set in shipped cfgs; real play uses base hp.
	local.testhp = int( getcvar "coop_aiTestHp" )
	if( local.testhp > 1 ){
		self.flags["coop_actorActualHealth"] = self.flags["coop_actorActualHealth"] * local.testhp
		self.flags["coop_woundedMaxHp"] = self.flags["coop_actorActualHealth"]
	}

	//we don't want anyone to kill him outright
	//[user 2026-07-28] THIS LINE IS THE BULLET-SPONGE SOURCE. From here on the actor's ENGINE health is a
	//5000 buffer and its REAL hp lives in coop_actorActualHealth; the ONLY thing that can undo that is the
	//coop pain handler, which the engine reaches from exactly ONE place (actor.cpp Actor::HandlePain ->
	//ExecuteScript(global/pain.scr)) behind 'if (!m_bEnablePain) return;' and 'if (!m_bNoLongPain)'. Any
	//script that later sets nolongpain/enablePain 0, or stacks health on top of this, strands the body at
	//~5000 hp. coop_reinf_brain above carries the reconciliation sweep (cvar coop_unsponge) that repairs it.
	//[user 08-02] BUFFER SIZE IS NOW A CVAR, AND MUCH SMALLER BY DEFAULT.
	//Observed live on t3l1: the player hit an axis actor that took an absurd amount of fire and
	//eventually died ("finally killed him"), while coop_unsponge was ON and the repair sweep fired
	//ZERO times all session. So this actor was stranded on the raw buffer and the sweep could not
	//see it - the sweep's own gating is the blind spot, and it is NOT yet root-caused.
	//Until it is, stop the failure mode from being catastrophic: a flat 5000 against a typical real
	//HP of ~100 makes a stranded body FIFTY times tougher than intended. 1000 keeps ample headroom
	//for the pain handler to arbitrate a single large hit (a rifle round is ~30-100, a bazooka a few
	//hundred) while capping the worst case at ~10x instead of ~50x.
	//Set coop_aiBuffer back to 5000 to restore the old behaviour exactly.
	local.buf = int( getcvar "coop_aiBuffer" )
	if( local.buf <= 0 ){ local.buf = 1000 }
	if( local.buf < 300 ){ local.buf = 300 }
	self.flags["coop_aiBufferVal"] = local.buf
	self health local.buf
}end

//handles all AI pain events (handler is global/pain.scr) (internal use only)
//=========================================================================
actorPainHandler local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.dflags local.meansofdeath local.location:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/actorPainHandler->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(!isAlive self || !local.attacker){ end }

	//HZM coop - VIP bail-out (see initialisePainVars): if a gag armored this actor AFTER pain-init already
	//buffered him, his health is now huge and the "changed elsewhere" path below would clobber it to 100
	//and re-apply the damage (instant VIP death). Detach the handler and let the engine damage stand -- a
	//bomb only dents the 4M armor, and t1l3's pretrigger3 health-drop trigger still fires as authored.
	if(self.health > 1000000){
		self.flags["coop_actorStopPainHandler"] = game.true
		end
	}

	if(self.fact){ self.fact delete } // optimised

	self.fact 				= local CreateListener
	self.fact.attacker 		= local.attacker
	self.fact.damage 		= local.damage
	self.fact.inflictor 	= local.inflictor
	self.fact.position 		= local.position
	self.fact.direction 	= local.direction
	self.fact.normal 		= local.normal
	self.fact.knockback 	= local.knockback
	self.fact.dflags 		= local.dflags
	self.fact.meansofdeath 	= local.meansofdeath
	self.fact.location 		= local.location

	// [302] HZM XP - assist ledger + savior stamp. Accumulate player damage per attacker
	// entnum (gaps over 10s reset that attacker's tally); remember who this AI was TARGETING
	// when hit (savior detection: killing an AI that is engaging a teammate). hp0 = health
	// before the first ledgered hit, the 25% assist threshold base.
	if( local.attacker != NULL && local.attacker.classname == "Player" ){
		if( self.coop_xp_hp0 == NIL ){ self.coop_xp_hp0 = self.health + local.damage }
		local.xan = local.attacker.entnum
		if( self.coop_xp_dmgT[local.xan] != NIL && (level.time - self.coop_xp_dmgT[local.xan]) > 10 ){ self.coop_xp_dmg[local.xan] = 0 }
		if( self.coop_xp_dmg[local.xan] == NIL ){ self.coop_xp_dmg[local.xan] = 0 }
		self.coop_xp_dmg[local.xan] = self.coop_xp_dmg[local.xan] + local.damage
		self.coop_xp_dmgT[local.xan] = level.time
		self.fact.enemyAtPain = self.enemy
	}

	group.painHandlerThread = game.true

	//println self.health

	//[200] Smithy - added fix to stop handler for this guy if their health changed elsewhere
	if(self.health != (5000 - self.fact.damage)){
		//iprintlnbold_noloc(self + " health is " + self.health + ". This shouldn't be. Don't use pain handler anymore")
		self.flags["coop_actorStopPainHandler"] = game.true
		self health 100
		self damage self.fact.attacker self.fact.damage self.fact.attacker self.fact.position self.fact.direction self.fact.normal self.fact.knockback self.fact.dflags self.fact.meansofdeath self.fact.location
		end
	}

	self health 5000 				//restore safe health

	if(waitthread friendlyFireCheck){ 	//check if we should ignore pain or not
		end
	}

	thread handlePain 				//actually do the pain

}end

//handle when AI are hurt by their teammates
//this reduces likelihood of teammates accidently killing oneanother.
//as well reducing chance that players can kill allied actors.
//this more reflects SP behaviour.
//will help improve difficulty too.
//(internal use only)
//=========================================================================
friendlyFireCheck:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/friendlyFireCheck->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(!group.painHandlerThread){
		error ("coop_mod/aihandler.scr::friendlyFireCheck - never call this func from outside aihandler.scr")
		end
	}
	
	if (self.fact.attacker.classname == "Player" && self.team == "american"){
		println self " was hurt by player: ignoring pain"
		end(game.true)
	}else if(self.fact.attacker.team == self.team && self.fact.attacker != self && self.fact.inflictor.classname != "BarrelObject"){
		println self " was hurt by teammate: ignoring pain"
		end(game.true)
	}else if(self.fact.attacker == self){
		//println self " was hurt by himself. don't ignore pain!"
	}
}end(game.false)

//actually do pain calculations (internal use only)
//=========================================================================
handlePain:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/handlePain->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if(!group.painHandlerThread){
		error ("coop_mod/aihandler.scr::handlePain - never call this func from outside aihandler.scr")
		end
	}

	self.flags["coop_actorActualHealth"] -= self.fact.damage

	//nope, not enough damage has been done
	if(self.flags["coop_actorActualHealth"] > 0){
		//[user 2026-07-17] survived the hit - maybe break off and limp to the furthest medkit (low HP + roll)
		thread coop_mod/wounded.scr::coop_checkWoundedRetreat self
		//[2026-07-23] survived - maybe make a TACTICAL retreat: mid-HP band, break contact + re-engage
		//(the "they never retreat" ask; gated coop_retreatEnable, layers above the <=30% terminal limp)
		thread coop_mod/wounded.scr::coop_checkTacticalRetreat self
		end
	}

	//fixes melee attacks
	if(self.fact.meansofdeath == 26){
		self.fact.location = 0
	}

	//enough damage has been done to kill this guy!
	self damage self.fact.attacker 150000 self.fact.attacker self.fact.position self.fact.direction self.fact.normal self.fact.knockback self.fact.dflags self.fact.meansofdeath self.fact.location

}end

//exclude our new pain handler on these maps to prevent conflicts and bugs
//you can exclude entire games from this by using first char and wildcard *.
//e.g to exlude all BT maps add e* to coop_painHandlerExclusions in variables.scr
//=========================================================================
painHandlerMapExclusions:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/painHandlerMapExclusions->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	level.coop_painHandlerExclusionInit = game.true

	if (level.coop_painHandlerExclusions[1].size == 1){
		local.array[1] = level.coop_painHandlerExclusions
		level.coop_painHandlerExclusions = local.array
	}

	local.thisMap 	= getcvar("mapname")
	local.firstChar = local.thisMap[0]

	for (local.i = 1; local.i <= level.coop_painHandlerExclusions.size; local.i++){
		local.excludedMap = level.coop_painHandlerExclusions[local.i]
		local.starChar = local.excludedMap[1]
		if (local.starChar == "*"){
			if (local.firstChar == local.excludedMap[0]){
				level.coop_actorPainHandler = game.false
				end
			}
		}else{
			if (level.coop_painHandlerExclusions[local.i] == local.thisMap){
				println("DEV: Map ("+local.thisMap+") is on the PainHandler-Exclusion List.")
				println("DEV: painhander should be off now.")
				level.coop_actorPainHandler = game.false
				end
			}
		}
	}
}end

//the main disguise handler for cover blown logic
//checks whether enemies can see a player while their
//isDisguised flag is false (i.e they have a weapon in hand)
//this func should only run once per map
//=========================================================================
disguiseHandler:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/disguiseHandler->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling

	level.coop_disguiseHandlerInit = game.true
	wait 1 //[200] Smithy - fixes level.coop_enableDisguises not being set on time - should be after init var really
	if (!level.coop_enableDisguises || level.coop_disguiseHandlerThread){ end }

	level.coop_disguiseHandlerThread = local

	while (level.coop_enableDisguises && !level.alarm){
		if ($player){
			local.enemyArray = level.coop_actorArray["german"]
			for (local.i = 1; local.i <= local.enemyArray.size; local.i++){
				local.enemy = local.enemyArray[local.i]
				if (!isAlive local.enemy){ continue }

				if (local.enemy.flags["coop_isAttacking"]){ 							//if i can see him in attack mode, also send me into attack mode
					thread sentientIsSeen local.enemy local.enemy.enemy 360
					continue
				}

				for (local.j = 1; local.j <= $player.size; local.j++){
					local.player 	= $player[local.j]
					//[user 2026-08-10] Step 3: last non-parity reader switched from the MOD flag to the
					//ENGINE flag. coop_isDisguised is written by script and can disagree with what the AI
					//actually reads; is_disguised is the value EnemyIsDisguised() consults.
					//NOTE (Phase C dependency): this loop can never restart after an alarm until Step 21
					//clears level.coop_disguiseHandlerThread - post-alarm this edit is unreachable code.
					local.pdisg = local.player.is_disguised
					if (isAlive local.player && local.player.has_disguise && local.player.flags["coop_hasDisguise"] && local.pdisg != 1 && local.player.dmteam != "spectator"){
						if (local.enemy cansee local.player local.enemy.fov local.enemy.sight){
							if( getcvar( "coop_aggroDebug" ) == "1" ){ println( "^~^~^ AGGRO_SRC disguiseHandler undisguised-player-seen" ) }
							local.enemy thread attackPlayer local.player
							thread sentientIsSeen local.enemy local.player NIL 	//check to see if anyone can see him spot you
							thread sentientIsHeard local.enemy local.player 	//check to see if anyone can hear him spot you
						}
					}
				}
			}
		}
		wait 1 //doesn't have to be super quick, so no need wasting precious resources
	}
}end

//forces an enemy actor to attack the player, even when they are disguised
//=========================================================================
attackPlayer local.player:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/attackPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.enemy = self
	//[user 2026-08-09] AGGRO PROBE + OPTIONAL GUARD.
	//Every path that makes an actor attack a player funnels through here - disguiseHandler,
	//sentientIsSeen, sentientIsHeard and setEnemyAttackStates - so this one place captures the
	//whole aggro surface. It prints the TARGET disguise state because m2l2a aggroes while every
	//disguise flag reads correct, meaning something attacks a player it should treat as its own.
	local.tn = "none"
	local.td = "-"
	if( local.player != NIL && local.player != NULL ){
		local.tn = local.player.netname
		local.td = local.player.flags["coop_isDisguised"]
	}
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ AGGRO actor=" + local.enemy.targetname + " target=" + local.tn + " tgtDisguised=" + local.td + " alarm=" + level.alarm + " enableDisg=" + level.coop_enableDisguises )
	}
	//[user 2026-08-10] ONE AGGRO RULE (master plan v2 Step 3, commit A2).
	//DELETED: the coop_stealthNoAggro / coop_stealthFunnelGuard cvar pair and the inline
	//local.blockAggro construction. Both cvars were seeded 0, so this funnel has been FULLY OPEN
	//in shipped code - the "guard" text above described behaviour that was not running.
	//NOW: the single implementation of the disguise-deference rule, coop_stealthBlocksAggro, which
	//defers per target to the ENGINE is_disguised flag (live per frame in coop since bug-1638).
	//No second parameter and no fail-open: the helper's no-target walk already ends (0) the moment
	//ANY live player is undisguised, so fail-open would buy no aggro and would only open the
	//permanent m_bForceAttackPlayer latch on the one NIL-capable route into this funnel.
	//coop_disgAggroParity 0 skips the gate entirely for every target = exact pre-Phase-A behaviour.
	local.parity = getcvar( "coop_disgAggroParity" )
	if( local.parity != "0" ){
		if( waitthread coop_stealthBlocksAggro local.player ){
			if( getcvar( "coop_aggroDebug" ) == "1" ){
				println( "^~^~^ AGGRO BLOCKED actor=" + local.enemy.targetname + " target=" + local.tn + " tgtDisguised=" + local.td )
			}
			end
		}
	}
	//[user 2026-08-06] bug-1477 - resolves the TODO below: den_head_sighted_a/c/h were never defined
	//anywhere, in the mod or any retail pak (confirmed by direct search) - a genuinely invented name,
	//not a scoping regression. The 'say' dispatch tries multiple lettered-suffix takes for
	//randomization, which is why _a/_c/_h all showed as separately dead despite one call site.
	//den_alarm_12a is real, retail, already scoped "m e t" (BT-compatible out of the box), has 11
	//wav takes under sound/dialogue/Generic/G/sighted/ for natural variety, and is semantically the
	//right category - an enemy voicing that it has spotted its target.
	local.enemy say den_alarm_12a
	local.enemy.enablePain = 1
	local.enemy.flags["coop_isAttacking"] = game.true
	//[user 2026-08-10] Step 3 item 4: attackENTITY when we have a real target. `attackplayer` calls
	//Actor::ForceAttackPlayer, which sets m_bForceAttackPlayer - a ONE-WAY latch cleared only in the
	//Actor constructor (actor.cpp:3092/:9339). EnemyIsDisguised() returns false unconditionally
	//while it is set, so ONE call blinds that actor to every disguise for the rest of the map, and
	//it confirms G_GetEntity(0) - the HOST - rather than the actual offender. attackentity is
	//advisory: it confirms the enemy and lets PassesTransitionConditions_Attack decide, and it does
	//not latch. Bare attackplayer is kept ONLY for the legacy no-target path, where there is no
	//entity to hand it. favoriteenemy is NIL-guarded - it was receiving NIL on that same path.
	if( local.player != NIL && local.player != NULL ){
		local.enemy attackentity local.player
		local.enemy favoriteenemy local.player
	}else{
		local.enemy attackplayer
	}
}end

//checks to see if any enemies can 'hear' this sentient.
//if yes, then force them into attack mode
//does a vector_within using hearing value to simulate hearing distance
//=========================================================================
sentientIsHeard local.sentient local.target:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/sentientIsHeard->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.enemies = level.coop_actorArray["german"]
	for (local.i = 1; local.i <= local.enemies.size; local.i++){
		local.enemy = local.enemies[local.i]
		if (!local.enemy || local.enemy.flags["coop_isAttacking"] || local.enemy == local.sentient){
			continue
		}

		local.awareness = local.enemy.sound_awareness
		if (local.awareness == 0){
			local.awareness = 100.000
		}

		local.inpvs = local.enemy inpvs local.sentient
		if (!local.inpvs){
			local.fullRange = 512		//if their areas aren't connected, just do an arbitrary range
		}else{
			local.fullRange = local.enemy.hearing
			local.halfRange = local.fullRange * 0.5
		}

		//this is how engine behaves. half of hearing range will always be heard
		if (local.inpvs && vector_within local.enemy local.sentient local.halfRange){
			local.enemy thread attackPlayer local.target
			continue
		}
		//if not, check for percentage chance (awareness) to hear at full range
		if (vector_within local.enemy local.sentient local.fullRange){
			if ((randomint(99) + 1) <= local.awareness){
				local.enemy thread attackPlayer local.target
			}
		}
	}
}end

//checks to see if any enemies can see this sentient.
//if yes, then force them to attack players
//=========================================================================
sentientIsSeen local.sentient local.target local.fov:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/sentientIsSeen->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.enemies = level.coop_actorArray["german"]
	for (local.i = 1; local.i <= local.enemies.size; local.i++){
		local.enemy = local.enemies[local.i]
		//no point checking enemies not inside the same PVS (technically the same areaportal)
		if (!local.enemy || local.enemy.flags["coop_isAttacking"] || !local.enemy inpvs local.sentient || local.enemy == local.sentient){
			continue
		}

		if (local.fov == NIL){
			local.fov = local.enemy.fov
		}
		if (local.enemy cansee local.sentient local.fov local.enemy.sight){
			if( getcvar( "coop_aggroDebug" ) == "1" ){ println( "^~^~^ AGGRO_SRC sentientIsSeen" ) }
			local.enemy thread attackPlayer local.target
			//thread sentientIsSeen local.enemy local.target //check to see if anyone can see him spot you
		}
	}
}end

//check if he can see any undisguised players (!isDisguised)
//i.e are they are holding a weapon
//=========================================================================
//[user 2026-08-09] ONE PLACE THAT DECIDES "may an actor go loud on the players right now".
//Measured 01:16 on m2l2a: both disguise flags read 1, alarm 0, and the attacker count still climbed
//0 -> 7 -> 9 -> 15. The disguise-aware guards held (the first two guards ignored the player, as the
//user observed) while other actors reached attack state through RAW `attackplayer` calls that never
//passed through aihandler::attackPlayer: coop_spawnReplica (the count-scaling clones, born hostile),
//aisquad go-loud, and morale berserk. Those three are the "others barging in".
//Returns 1 when aggro must be suppressed. Pass the intended target, or NIL when there is not one.
//=========================================================================
coop_stealthBlocksAggro local.target:{
//=========================================================================
	//[user 2026-08-09] bug-1639 ENGINE PARITY: no cvar window any more. With bug-1638 the engine
	//maintains m_bIsDisguised per frame in coop (holster = disguised, draw = blown), so the gate
	//simply defers to it PER TARGET: scripts never fire attackplayer (the one-way
	//m_bForceAttackPlayer latch, see below) at a player the ENGINE currently counts as disguised.
	//An undisguised player is fair game the same frame.
	if( local.target != NULL && local.target != NIL ){
		if( local.target.classname == "Player" ){
			local.ed = local.target.is_disguised
			if( local.ed == 1 && !level.alarm && level.coop_enableDisguises ){ end (1) }
		}
		end (0)
	}
	if( level.alarm ){ end (0) }
	if( !level.coop_enableDisguises ){ end (0) }
	//[user 2026-08-09] NO PER-TARGET DISGUISE TEST ANY MORE - block for the whole pre-alarm
	//window on a disguise map, whatever the player is wearing right now.
	//WHY: `attackplayer` calls Actor::ForceAttackPlayer(), which sets m_bForceAttackPlayer, and
	//EnemyIsDisguised() returns false unconditionally when that is set. It is a ONE-WAY LATCH -
	//cleared only in the Actor constructor (actor.cpp:3092), never from script. So one call blinds
	//that actor to the disguise permanently.
	//The player is LEGITIMATELY undisguised while walking from the spawn to the papers, so guards
	//that spot them en route were being latched and stayed hostile forever - which is exactly the
	//"they catch me the moment I put the uniform on" report, and why attackers never fell back.
	//Nothing is lost by refusing: the ENGINE still attacks an undisguised player perfectly well
	//through the threat system (actorenemy.cpp:164) - and, unlike this, reversibly. Vanilla never
	//sets the latch at all, which is the behaviour we are trying to match.
	//no specific target: block only while EVERY live player is engine-disguised
	if( level.alarm || !level.coop_enableDisguises ){ end (0) }
	local.anyUn = 0
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p != NULL && isAlive local.p ){
			local.ed = local.p.is_disguised
			if( local.ed != 1 ){ local.anyUn = 1 }
		}
	}
	if( local.anyUn == 0 ){ end (1) }
}end (0)

canseeUndisguisedPlayers:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/canseeUndisguisedPlayers->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.actor 	= self
	local.cansee 	= game.false
	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			local.player = $player[local.i]
			//[user 2026-08-09] bug-1639: ENGINE flag, not the stale mod flag
			local.ed = local.player.is_disguised
			if (local.ed != 1 && local.actor cansee local.player local.actor.fov local.actor.sight){
				local.cansee = game.true
			}
		}
	}
}end (local.cansee)

//checks to see if any enemies in level are in attack state
//=========================================================================
anyEnemiesInAttackState:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/anyEnemiesInAttackState->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= level.coop_actorArray["german"].size; local.i++){
		local.enemy = level.coop_actorArray["german"][local.i]
		if (local.enemy.thinkstate == "attack" || local.enemy.thinkstate == "pain"){
			end (game.true)
		}
	}
}end (game.false)

//this turns any attacking enemies into idle state so that we can
//enable disguises on players. called from itemhandler::giveDisguiseToAll
//their attack state is remembered so AI don't just forget about you when
//handling them inside disguiseHandler
//=========================================================================
resetEnemyThinkstates:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/resetEnemyThinkstates->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= level.coop_actorArray["german"].size; local.i++){
		local.enemy = level.coop_actorArray["german"][local.i]
		if (local.enemy.thinkstate == "attack" || local.enemy.thinkstate == "pain"){
			local.enemy.enableEnemy = 0
			local.enemy.flags["coop_actorResetThinkstate"] 	= game.true
			local.enemy.no_idle 							= game.true
		}
	}
	waitframe
}end

//these are actors that were attacking before resetEnemyThinkstates was called on them
//make sure they continue attacking after we've done processing them
//=========================================================================
setEnemyAttackStates:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/setEnemyAttackStates->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= level.coop_actorArray["german"].size; local.i++){
		local.enemy = level.coop_actorArray["german"][local.i]
		if (local.enemy.flags["coop_actorResetThinkstate"]){
			if( getcvar( "coop_aggroDebug" ) == "1" ){ println( "^~^~^ AGGRO_SRC setEnemyAttackStates restore" ) }
			local.enemy.enableEnemy = 1
			//[user 2026-08-10] Step 3: gate ONLY the aggro line. enableEnemy / no_idle /
			//coop_actorResetThinkstate must be restored UNCONDITIONALLY - this label is their sole
			//restorer, and skipping them would strand every actor it touched.
			//The enemy captured before the reset is already NULL by restore time (actor.cpp:8608-8626
			//NULLs .enemy when enableEnemy went 0), so there is no per-target judgement available -
			//gate on the room instead, which is exactly what the NIL walk of the shared helper does.
			local.skipAggro = 0
			if( getcvar( "coop_disgAggroParity" ) != "0" ){
				if( waitthread coop_stealthBlocksAggro NIL ){ local.skipAggro = 1 }
			}
			if( local.skipAggro != 1 ){ local.enemy attackplayer }
			local.enemy.no_idle 							= game.false
			local.enemy.flags["coop_isAttacking"] 			= game.true
			local.enemy.flags["coop_actorResetThinkstate"] 	= game.false
		}
	}
}end

//Improves unholstering of MG gunners...
//This will help stop any delays with AI running around weaponless
//before the attack.scr hack fix kicks in. We'll keep the other fix as a backup,
//but hopefully this func will execute first, at least most of the time.
//=========================================================================
leaveTurretUnholstered:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/leaveTurretUnholstered->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	//reclaimed this func to call on any AI that have a turret in their arsenal!
	if (self.thread["leaveTurretUnholstered"]){ end } 	//[202][hotfix] Smithy 
	self.thread["leaveTurretUnholstered"] = local 		//[202][hotfix] Smithy 
	wait 2
	if (isAlive self && waitthread isMachineGunner){
		while (isAlive self && waitthread isMachineGunner){		
			wait 1 //wait until they are not a machinegunner. doesn't have to be that fast...
		}
		if (isAlive self){
			self use self.gun
			self activatenewweapon "dual"			
		}
	}
}end

//checks if this guy is a machinegunner
//=========================================================================
isMachineGunner:{
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/isMachineGunner->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.MG = game.true
	local.MG = local.MG && self.type_attack 	== "machinegunner"
	local.MG = local.MG && self.type_idle 		== "machinegunner"
	local.MG = local.MG && self.type_disguise 	== "machinegunner"
	local.MG = local.MG && self.type_grenade 	== "machinegunner"
	local.MG = local.MG && self.turret
}end(local.MG)

//[200] Smithy - we may as well use scoreboard
//this adds a kill to a player if they manage to kill this actor
//=========================================================================
addKillToPlayer:
//=========================================================================
if(level.cMTE_coop_aihandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread aihandler/addKillToPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	waitframe
	if (!self){ end }
	if (self.fact && self.fact.attacker && self.fact.attacker.classname == "Player"){
		self.fact.attacker addkills 1
		//[user 07-17] DDA kill tap (own counter - coop_xp_teamkills is XP-gated; director.scr windows this)
		if( level.coop_dda_kills == NIL ){ level.coop_dda_kills = 0 }
		level.coop_dda_kills++
		// [302] HZM XP - kill + bonuses + assists (reads pain facts, class tag and assist ledger)
		thread coop_mod/xp.scr::xp_ai_killed self self.fact.attacker
		// [303] HZM CHALLENGES - weapon mastery + kill-type challenge progress (self-contained, guarded)
		thread coop_mod/challenges.scr::chal_ai_killed self self.fact.attacker
	} else {
		//[user 08-07] not attributed to a Player - radiusdamage (what the bomb blast uses) always
		//attributes to `world` at the engine level, so this branch is the only way a player-called
		//air strike's kills can ever be credited. See xp.scr::xp_airstrike_kill.
		thread coop_mod/xp.scr::xp_airstrike_kill self
	}
end