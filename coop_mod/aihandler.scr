//=========================================================================
coop_hitReact:{
//=========================================================================
	local.ch = getcvar "coop_aiHitReact"
	if( local.ch == "" ){ local.ch = "55" }
	if( (randomint 100) >= int(local.ch) ){ end }
	if( self == NULL || self == NIL ){ end }
	if( !(isAlive self) ){ end }
	//(bug-1944: a "painhandler != NIL -> end" guard here was ALWAYS true - this function is
	//reached FROM the coop painhandler, so every actor has one by definition and no flinch
	//ever played. Corner/wall fighters need no guard: their custom painhandler replaces the
	//coop one outright, so they never route through here while wall-fighting.)
	if( self.position == "prone" ){ end }
	//throttle: one flinch per man per coop_aiHitReactWait seconds (was a hard-coded 1.2 - now
	//tunable, because judging this feature needs to see it fire more than once a fight)
	if( level.coop_hitReactWait == NIL ){
		//NOTE the project trap (bug-1669): a script getcvar CREATES the cvar empty and then
		//permanently defeats the engine default, so read it, test for empty, and fall back here.
		local.w = getcvar "coop_aiHitReactWait"
		if( local.w == "" ){ local.w = "1.2" }
		level.coop_hitReactWait = float(local.w)
		if( level.coop_hitReactWait < 0.05 ){ level.coop_hitReactWait = 0.05 }
		local.dbg = getcvar "coop_hitReactDebug"
		if( local.dbg == "1" ){ level.coop_hitReactDebug = 1 }
	}
	if( self.coop_hitReactT != NIL && level.time < self.coop_hitReactT ){ end }
	self.coop_hitReactT = level.time + level.coop_hitReactWait
	local.loc = self.fact.location
	if( local.loc == NIL ){ local.loc = 0 }
	//[user 2026-08-20] THE WHOLE TABLE WAS SHIFTED BY ONE AND MIRRORED, so this feature has never
	//once played the right reaction: a right upper-arm hit (7) flinched his BACK, a left arm (8)
	//flinched his RIGHT arm, and a right LEG (9) flinched his LEFT ARM. The engine table is
	//hitloc_t in q_shared.h: 0 HEAD, 1 HELMET, 2 NECK, 3 TORSO_UPPER, 4 TORSO_MID, 5 TORSO_LOWER,
	//6 PELVIS, 7 R_ARM_UPPER, 8 L_ARM_UPPER, 9 R_LEG_UPPER, 10 L_LEG_UPPER, 11 R_ARM_LOWER,
	//12 L_ARM_LOWER, 13 R_LEG_LOWER, 14 L_LEG_LOWER, 15 R_HAND, 16 L_HAND, 17 R_FOOT, 18 L_FOOT.
	local.sfx = "back"
	if( local.loc >= 0 && local.loc <= 2 ){ local.sfx = "head" }
	if( local.loc >= 3 && local.loc <= 6 ){ local.sfx = "back" }
	if( local.loc == 7 || local.loc == 11 || local.loc == 15 ){ local.sfx = "rarm" }
	if( local.loc == 8 || local.loc == 12 || local.loc == 16 ){ local.sfx = "larm" }
	if( local.loc == 9 || local.loc == 10 ){ local.sfx = "leg" }
	if( local.loc == 13 || local.loc == 14 ){ local.sfx = "leg" }
	if( local.loc >= 17 ){ local.sfx = "leg" }
	if( level.coop_hitReactDebug == 1 ){
		println( "^~^~^ HITREACTMAP loc=" + local.loc + " sfx=" + local.sfx + " wg=" + self.weapongroup )
	}
	local.stance = "stand"
	if( self.position == "crouch" ){ local.stance = "crouch" }
	waitthread coop_hitReactInit
	local.wg = self.weapongroup
	if( local.wg == NIL || local.wg == "" ){ end }
	if( level.coop_hitOK[local.wg + "_" + local.stance + "_" + local.sfx] != 1 ){
		local.sfx = "back"
		if( level.coop_hitOK[local.wg + "_" + local.stance + "_" + local.sfx] != 1 ){ end }
	}
	//[user 2026-08-18] arm hits can jar the gun loose - rifle/thompson ship a dropgun flinch
	local.anim = local.wg + "_" + local.stance + "_hit_" + local.sfx
	if( (local.sfx == "larm" || local.sfx == "rarm") && local.stance == "stand" ){
		if( (local.wg == "rifle" || local.wg == "thompson") && (randomint 100) < 30 ){
			local.anim = local.wg + "_pain_dropgun"
			thread coop_mod/aibehav.scr::behav_bump "dropgun"
		}
	}
	self.blendtime = 0.15
	self setmotionanim local.anim
	thread coop_mod/aibehav.scr::behav_bump "hitreact"
}end
