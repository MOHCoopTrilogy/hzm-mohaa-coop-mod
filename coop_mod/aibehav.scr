//====================================================================
// aibehav.scr - HZM coop ENEMY-BEHAVIOR TRACKER (2026-07-23)
//====================================================================
// Measures what the German enemies are ACTUALLY doing so the dynamic-AI
// work (coop_aiDynamic) can be verified UNATTENDED. Gated on coop_aiBehav
// (0=off default, 1=log, 2=log + on-screen readout). Launched from main.scr.
//
// Two signals:
//  ^~^~^ AIBEHAV  (every 4s, instant snapshot): alive/engaging/moving/staticCombat
//     + role split (aggr/cover/flank/prone/none) + thinkstate split.
//  ^~^~^ AIBEHAV2 (every 8s, the RELIABLE movement signal): cumulative distance each
//     ENGAGED enemy travelled over the window - a turret scores ~0, an enemy that
//     repositions scores large, regardless of when we sample. Fields:
//       engagedMoved = engaged enemies that moved at all, repositioned = moved >150u,
//       totalDist / avgDist = ground covered. Baseline (aiDynamic 0) -> repositioned~0;
//       working dynamic AI -> repositioned climbs.
//====================================================================
main:{
	local.tick = 0
	while( getcvar( "coop_aiBehav" ) != "0" && getcvar( "coop_aiBehav" ) != "" ){
		wait 1
		local.tick++
		local.arr = level.coop_actorArray["german"]
		if( local.arr == NIL ){ continue }

		// ---- every tick: accumulate per-enemy displacement WHILE ENGAGED ----
		for( local.i = 1; local.i <= local.arr.size; local.i++ ){
			local.a = local.arr[local.i]
			if( local.a == NIL || local.a == NULL ){ continue }
			if( !isAlive local.a ){ continue }
			local.eng = 0
			if( local.a.thinkstate == "attack" ){ local.eng = 1 }
			if( local.a.enemy != NULL && local.a.enemy != NIL ){ local.eng = 1 }
			if( local.eng == 1 ){
				if( local.a.coop_trkLast != NIL ){
					if( local.a.coop_trkDist == NIL ){ local.a.coop_trkDist = 0 }
					local.a.coop_trkDist = local.a.coop_trkDist + vector_length( local.a.origin - local.a.coop_trkLast )
				}
				local.a.coop_trkLast = local.a.origin
			} else {
				local.a.coop_trkLast = NIL
			}
		}

		// ---- every 4s: instant role/engagement snapshot ----
		if( ( local.tick % 4 ) == 0 ){
			local.alive = 0
			local.engaging = 0
			local.moving = 0
			local.staticCombat = 0
			local.r_aggr = 0
			local.r_cover = 0
			local.r_flank = 0
			local.r_prone = 0
			local.r_none = 0
			local.aggrMoving = 0
			local.aggrStatic = 0
			local.aggrCover = 0
			local.flanked = 0
			local.near = 0
			local.nearEnemy = 0
			local.nearSee = 0
			local.nearEE0 = 0
			local.nearCur = 0			// engaged enemies at the player's SIDE/REAR (the felt "they flanked me")
			for( local.i = 1; local.i <= local.arr.size; local.i++ ){
				local.a = local.arr[local.i]
				if( local.a == NIL || local.a == NULL ){ continue }
				if( !isAlive local.a ){ continue }
				local.alive++
				local.spd = vector_length( local.a.velocity )
				local.eng = 0
				if( local.a.enemy != NULL && local.a.enemy != NIL ){ local.eng = 1; local.engaging++ }
				if( local.spd > 20 ){ local.moving++ }
				if( local.eng == 1 && local.spd <= 20 ){ local.staticCombat++ }
				//[user 2026-08-26] "they all ran up to me and are standing here", with engaging=4 of 27 alive.
				//So they are not failing to ATTACK - they have no enemy at all. The question is whether the
				//ones standing on top of the player can SEE him: near = within 250u of a player, nearEnemy =
				//of those, how many hold an enemy, nearSee = how many pass the actor's OWN cansee with its own
				//fov/sight. near high + nearSee low is a perception failure; near high + nearSee high +
				//nearEnemy low is target ACQUISITION failing downstream of sight.
				if( $player != NULL ){
					local.pp = NIL
					local.pj = 1
					while( local.pj <= $player.size ){
						if( $player[local.pj] != NULL ){
							if( isAlive $player[local.pj] ){
								local.dv = local.a.origin - $player[local.pj].origin
								if( vector_length( local.dv ) < 250 ){ local.pp = $player[local.pj] }
							}
						}
						local.pj = local.pj + 1
					}
					if( local.pp != NIL && local.pp != NULL ){
						//[bug-2117] near=3 nearSee=2 nearEnemy=0 said: they SEE the player and never ACQUIRE.
						//Two new columns decide between the suspects. nearEE0 = near actors whose enableEnemy
						//is OFF (a missed restore by aimaneuver/aisquad/aihandler leaves acquisition disabled
						//while runto still paths them to the player). nearCur = near actors sitting in the
						//CURIOUS thinkstate (investigate-and-stand is exactly curious behaviour). EE0 high =
						//find the missed restore; EE0 zero + cur high = acquisition inputs, not the switch.
						if( local.a.enableEnemy == 0 ){
							local.nearEE0++
							local.eesrc = local.a.flags["coop_ee0src"]
							if( local.eesrc == NIL ){ local.eesrc = "unstamped" }
							println( "^~^~^ EE0NEAR ent=" + local.a.entnum + " src=" + local.eesrc + " surr=" + local.a.flags["coop_surrendered"] + " dis=" + local.a.coop_aiDisabled )
						}
						if( local.a.thinkstate == "curious" ){ local.nearCur++ }
						local.near++
						if( local.eng == 1 ){ local.nearEnemy++ }
						if( local.a cansee local.pp local.a.fov local.a.sight ){ local.nearSee++ }
					}
				}
				local.role = local.a.flags["coop_role"]
				if( local.role == "aggr" ){
					local.r_aggr++
					//[2026-08-30] does the aggr third actually ADVANCE? aggrMoving / aggrStatic split the
					//ENGAGED aggr men by speed. aggrCover counts the ones the engine has already flipped to
					//cover think - coop_aiSuppressCover (actor.cpp:11302) converts THINKSTATE_ATTACK to
					//THINK_COVER on the first near-miss and is sticky, and type_attack is a live EV_GETTER
					//reading m_ThinkMap[THINKSTATE_ATTACK], so this is the honest count. A high aggrCover is
					//the single most likely reason the charge band looks like it did nothing.
					if( local.eng == 1 ){
						if( local.spd > 20 ){ local.aggrMoving++ } else { local.aggrStatic++ }
					}
					if( local.a.type_attack == "cover" ){ local.aggrCover++ }
				}
				else if( local.role == "cover" ){ local.r_cover++ }
				else if( local.role == "flank" ){ local.r_flank++ }
				else if( local.role == "prone" ){ local.r_prone++ }
				else { local.r_none++ }
				// FLANK-SUCCESS: is this engaged enemy in its target player's side/rear hemisphere? That's the
				// felt "they got around me". dot(player_forward, dir_to_enemy) < 0.3 => angle > ~72deg off the
				// player's facing. Measures whether the flank/squad coordination actually produces flanking.
				if( local.eng == 1 ){
					local.tp = local.a.enemy
					// only measure flanking vs a PLAYER target - an enemy's .enemy can be another actor / a
					// stale ref (esp. with 4 players + friendly fire), and .viewangles on a non-player is
					// 'none' -> none-cast spam. classname guard keeps the metric player-only.
					if( local.tp != NULL && local.tp != NIL && isAlive local.tp && local.tp.classname == "Player" ){
						local.fwd = angles_toforward local.tp.viewangles
						local.dir = local.a.origin - local.tp.origin
						local.dl = vector_length( local.dir )
						if( local.dl > 1 ){
							local.dirx = local.dir[0] / local.dl
							local.diry = local.dir[1] / local.dl
							local.dot = ( local.fwd[0] * local.dirx ) + ( local.fwd[1] * local.diry )
							if( local.dot < 0.3 ){ local.flanked = local.flanked + 1 }
						}
					}
				}
			}
			//[user 2026-08-26] "enemies that will literally run to me and stand and do nothing".
			//The documented mechanism for that exact shape is FL_NOTARGET: an actor legitimately names a
			//notarget'd player as .enemy and closes on him, while the engine refuses the attack
			//(actor.cpp:9150). The glue path sets it (main.scr) and unglue clears it, so the pairing looks
			//right on paper - which is exactly why it needs measuring rather than arguing about. ntgt>0
			//with engaging>0 and nobody taking damage is the signature.
			local.ntgt = 0
			local.pi = 1
			while( local.pi <= $player.size ){
				if( $player[local.pi] != NULL ){
					if( $player[local.pi].notarget == 1 ){ local.ntgt = local.ntgt + 1 }
				}
				local.pi = local.pi + 1
			}
			println( "^~^~^ AIBEHAV alive=" + local.alive + " engaging=" + local.engaging + " moving=" + local.moving + " staticCombat=" + local.staticCombat + " flanked=" + local.flanked + " | aggr=" + local.r_aggr + " cover=" + local.r_cover + " flank=" + local.r_flank + " prone=" + local.r_prone + " none=" + local.r_none + " | ntgt=" + local.ntgt + " glue=" + level.coop_playerGlue + " | near=" + local.near + " nearEnemy=" + local.nearEnemy + " nearSee=" + local.nearSee + " nearEE0=" + local.nearEE0 + " nearCur=" + local.nearCur + " | aggrMove=" + local.aggrMoving + " aggrStatic=" + local.aggrStatic + " aggrCover=" + local.aggrCover )
			if( getcvar( "coop_aiBehav" ) == "2" ){
				iprintlnbold( "AI  alive:" + local.alive + "  moving:" + local.moving + "  static:" + local.staticCombat + "   [aggr:" + local.r_aggr + " cover:" + local.r_cover + " flank:" + local.r_flank + "]" )
			}
		}

		// ---- every 8s: cumulative-displacement window (the reliable movement metric) + reset ----
		if( ( local.tick % 8 ) == 0 ){
			local.engMoved = 0
			local.reposition = 0
			local.totalDist = 0
			for( local.i = 1; local.i <= local.arr.size; local.i++ ){
				local.a = local.arr[local.i]
				if( local.a == NIL || local.a == NULL ){ continue }
				if( local.a.coop_trkDist != NIL && local.a.coop_trkDist > 8 ){
					local.engMoved++
					local.totalDist = local.totalDist + local.a.coop_trkDist
					if( local.a.coop_trkDist > 150 ){ local.reposition++ }
				}
				if( local.a != NULL ){ local.a.coop_trkDist = 0 }
			}
			local.avg = 0
			if( local.engMoved > 0 ){ local.avg = int( local.totalDist / local.engMoved ) }
			println( "^~^~^ AIBEHAV2 window=8s engagedMoved=" + local.engMoved + " repositioned=" + local.reposition + " totalDist=" + int( local.totalDist ) + " avgDist=" + local.avg )
		}
	}
}end
//====================================================================
//[user 2026-08-19] BEHAVIOR ODOMETER - "do you have a way to measure that the actors are
//doing these things?" Every restored/new behavior bumps a counter at its fire site; totals
//print as one greppable ^~^~^ AIBEHAV3 line every 30s while coop_aiBehav != 0. Counting is
//always-on (one array increment - free); only the REPORTING is gated, so you can flip
//coop_aiBehav 1 mid-session and see everything that already happened.
//====================================================================
behav_bump local.key:{
	if( level.coop_behavCnt[local.key] == NIL ){ level.coop_behavCnt[local.key] = 0 }
	level.coop_behavCnt[local.key] = level.coop_behavCnt[local.key] + 1
	if( level.coop_behavRepOn != 1 ){
		level.coop_behavRepOn = 1
		thread behav_reportLoop
	}
}end

behav_reportLoop:{
	local.keys[1] = "prone"
	local.keys[2] = "crouch"
	local.keys[3] = "crate"
	local.keys[4] = "crateblind"
	local.keys[5] = "runfire"
	local.keys[6] = "hitreact"
	local.keys[7] = "dropgun"
	local.keys[8] = "crawldeath"
	local.keys[9] = "corner"
	local.keys[10] = "cornernade"
	local.keys[11] = "cornerdeath"
	local.keys[12] = "fear"
	local.keys[13] = "surrender"
	local.keys[14] = "martyr"
	local.keys[15] = "variant"
	local.keys[16] = "g43"
	local.keys[17] = "convert"
	while( 1 ){
		wait 30
		if( getcvar( "coop_aiBehav" ) == "0" || getcvar( "coop_aiBehav" ) == "" ){ continue }
		local.s = "^~^~^ AIBEHAV3"
		for( local.i = 1; local.i <= 17; local.i++ ){
			local.v = level.coop_behavCnt[local.keys[local.i]]
			if( local.v == NIL ){ local.v = 0 }
			local.s = local.s + " " + local.keys[local.i] + "=" + local.v
		}
		println local.s
	}
}end
