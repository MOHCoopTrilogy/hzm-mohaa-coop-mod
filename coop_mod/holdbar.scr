//HZM Coop Mod [user 2026-10-18, hdring] - ONE way to show a hold / timed-action progress bar.
//
//The look is drawn by cgame (cg_hdprogress.c): the HD RING round the crosshair (clockwise fill, empty centre for an icon), palette by action family. The rect you give the pair only sets the FRACTION (fill width / track width); where it is on screen no longer matters. A script only
//says WHAT the action is by giving the huddraw quad a shader name, so every future action (plant / defuse charges, a station,
//a lock) gets the same ring/bar family without any colour or art of its own:
//    family   action                                      colour
//    revive   reviving / being revived / self-revive      coral red
//    heal     medkit on self or a teammate                soft green
//    place    placing or removing sandbags, deployables   amber
//    use      picking something up, using a station       cream
//    objective plant / defuse / sabotage / capture        pale blue
//ihuddraw_color is IGNORED for these shaders (alpha and rect are honoured). Slots: track = slot, fill = slot + 1.
//Give both a slot >= 100 if the player stands still while holding (slots below 100 fade with the calm HUD, bug-1661), and
//wrap show / hide in coop_mod/hudresend.scr::claim / resend (bug-2906) as the existing bars do.
//
//    waitthread coop_mod/holdbar.scr::holdbar_open  local.p 136 "revive" 270 -55 100 6
//    waitthread coop_mod/holdbar.scr::holdbar_set   local.p 136 270 -55 100 6 local.frac
//    waitthread coop_mod/holdbar.scr::holdbar_close local.p 136

holdbar_open local.p local.slot local.family local.x local.y local.w local.h:{
	if( local.p == NULL ){ end }
	local.fs = local.slot + 1

	ihuddraw_virtualsize local.p local.slot 1
	ihuddraw_align       local.p local.slot left bottom
	ihuddraw_shader      local.p local.slot "textures/hud/coop_hold_track"
	ihuddraw_rect        local.p local.slot local.x local.y local.w local.h
	ihuddraw_alpha       local.p local.slot 0.8

	ihuddraw_virtualsize local.p local.fs 1
	ihuddraw_align       local.p local.fs left bottom
	ihuddraw_shader      local.p local.fs ( "textures/hud/coop_hold_" + local.family )
	ihuddraw_rect        local.p local.fs local.x local.y 0 local.h
	ihuddraw_alpha       local.p local.fs 0.9
}end

holdbar_set local.p local.slot local.x local.y local.w local.h local.frac:{
	if( local.p == NULL ){ end }
	if( local.frac < 0 ){ local.frac = 0 }
	if( local.frac > 1 ){ local.frac = 1 }
	local.fs = local.slot + 1
	ihuddraw_rect local.p local.fs local.x local.y ( local.w * local.frac ) local.h
}end

holdbar_close local.p local.slot:{
	if( local.p == NULL ){ end }
	local.fs = local.slot + 1
	ihuddraw_alpha local.p local.slot 0
	ihuddraw_alpha local.p local.fs 0
}end
