// HZM coop [237] - the 3rd-person bind now CYCLES three view modes (user):
//   0 = first person -> 1 = third person SNAPPED (chase, camera follows aim)
//   -> 2 = third person FREE (mouse orbits the camera; WASD moves without turning it).
// The tiny iprint line is the on-screen mode indicator (small corner text, never obnoxious).
coop_thirdperson_monitor local.player:{
	local.tp_mode = 0

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		if( local.player.flags["coop_tp_toggleRequest"] == 1 ){
			local.player.flags["coop_tp_toggleRequest"] = NIL
			local.tp_mode = local.tp_mode + 1
			if( local.tp_mode > 2 ){ local.tp_mode = 0 }

			// [240] order per user: ONE press from first person = FREE CAM (their main mode;
			// body stays put, camera+crosshair orbit), second press = snapped chase.
			if( local.tp_mode == 0 ){
				local.player stufftext ( "set cg_freecam 0\n" )
				waitthread coop_mod/player.scr::set3rdPerson local.player 0
				local.player.flags["coop_thirdperson_active"] = NIL
				local.player iprint "View: First Person"
			}
			else if( local.tp_mode == 1 ){
				local.player stufftext ( "set cg_freecam 1\n" )
				waitthread coop_mod/player.scr::set3rdPerson local.player 1
				local.player.flags["coop_thirdperson_active"] = 1
				local.player iprint "View: Free Cam (body stays put)"
			}
			else{
				local.player stufftext ( "set cg_freecam 0\n" )
				local.player.flags["coop_thirdperson_active"] = 1
				local.player iprint "View: Third Person (chase)"
			}
		}

		waitframe
	}

	// Cleanup: restore first person when player dies or goes inactive
	if( local.player != NULL ){
		if( local.tp_mode != 0 ){
			local.player stufftext ( "set cg_freecam 0\n" )
			waitthread coop_mod/player.scr::set3rdPerson local.player 0
			local.player.flags["coop_thirdperson_active"] = NIL
		}
	}
}end

coop_tp_toggle local.player:{
	if( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.player.flags["coop_tp_toggleRequest"] = 1
	}
}end
