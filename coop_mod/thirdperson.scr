coop_thirdperson_monitor local.player:{
	local.tp_active = 0

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		if( local.player.flags["coop_tp_toggleRequest"] == 1 ){
			local.player.flags["coop_tp_toggleRequest"] = NIL
			if( local.tp_active == 0 ){
				waitthread coop_mod/player.scr::set3rdPerson local.player 1
				local.tp_active = 1
				local.player.flags["coop_thirdperson_active"] = 1
			}
			else{
				waitthread coop_mod/player.scr::set3rdPerson local.player 0
				local.tp_active = 0
				local.player.flags["coop_thirdperson_active"] = NIL
			}
		}

		waitframe
	}

	// Cleanup: restore first person when player dies or goes inactive
	if( local.player != NULL ){
		if( local.tp_active == 1 ){
			waitthread coop_mod/player.scr::set3rdPerson local.player 0
			local.player.flags["coop_thirdperson_active"] = NIL
		}
	}
}end

coop_tp_toggle local.player:{
	if( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		// (removed debug 'iprintlnbold "TP TOGGLE FIRED"' - iprintlnbold can't be invoked on a Player this
		//  way, so it threw a Script Error and spammed the console on every 3rd-person toggle press.)
		local.player.flags["coop_tp_toggleRequest"] = 1
	}
}end
