//=========================================================================
// coop_counter.scr - HZM coop FINAL COUNTER-ATTACK (2026-10-15, docs/proposals/alarm_counterattack_2026-10-15)
//
// Hooked at the top of missioncomplete.scr::main. When the main objectives are done and the mission is about to end, the
// enemy throws a last series of waves at the squad for coop_counterSecs seconds (default 150) and only then does the mission
// complete exactly as before. Waves form up through reinf.scr::rnf_entry (never from a sight line).
//
//   coop_counter 0/1        master switch, DEFAULT 0 (off until the playtest proves it)
//   coop_counterForce 1     debug: acts as coop_counter 1 AND ignores the map exclusions (stealth / noCounter / denied)
//   coop_counterSecs 150    length of the wave window, after the 15 s grace
//   coop_counterWaveGap 30  seconds between waves (+0..10 random)
//   coop_counterCap 14      most counter-attack men alive at once
//   coop_counterDebug 1     greppable ^~^~^ COUNTER lines
//
// Never fires on: briefings / lobbies / map-tester runs, stealth + disguise maps (level.coop_stealthMap,
// level.coop_enableDisguises), maps that set level.coop_noCounter 1, maps in counter_denied (ride / cutscene endings),
// MP arena runs (level.coop_mpRun), or when nobody is alive.
//=========================================================================

counter_log local.txt:{
	if( getcvar( "coop_counterDebug" ) == "1" ){ println( "^~^~^ COUNTER " + local.txt ) }
}end


// living, active players
counter_players:{
	local.n = 0
	if( $player == NULL || $player == NIL ){ end 0 }
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		if( local.p.flags["coop_isActive"] != 1 ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		if( !isAlive local.p ){ continue }
		local.n++
	}
}end local.n


// wave men still alive: local.src "counter" (default) = the final counter-attack, "alarm" = alarm.scr waves
counter_alive local.src:{
	local.n = 0
	local.want = "counter"
	if( local.src != NIL ){ local.want = local.src }
	if( level.coop_counterN == NIL ){ end 0 }
	for( local.i = 1; local.i <= level.coop_counterN; local.i++ ){
		local.a = level.coop_counterActors[local.i]
		if( local.a == NULL || local.a == NIL ){ continue }
		if( !( isAlive local.a ) ){ continue }
		if( local.a.flags["coop_waveSrc"] == local.want ){ local.n++ }
	}
}end local.n


// 1 = this map ends in a ride / cutscene / scripted sequence (or is Omaha, or owns a stealth ending) that a fight would break.
// Audited 2026-10-15 from each map's mission-end call site (BUILD.md step 3). A map not listed here is a plain walk-to-the-trigger ending.
//   ride / vehicle / tank ending : e1l1 (jeep), e2l2 (FinalJeep), e2l3 (tank), e3l3 (K5 train jump), m1l3a m1l3b (jeep),
//                                  m1l3c (truck escape), m2l3 (train leaves), m5l1b m5l2a m5l2b (tank), t3l2 (tank)
//   cutscene / outro ending      : e1l2 (DoOutro), t2l2 (cuecamera), m6l3a (scene7), training
//   stealth / disguise / own alarm: e1l4, m2l2a, m6l1c, m6l2a (also level.coop_stealthMap / coop_enableDisguises)
//   Omaha (never touched)        : m3l1a, m3l1b
counter_denied local.m:{
	if( local.m == "e1l1" || local.m == "e1l2" || local.m == "e1l4" || local.m == "e2l2" || local.m == "e2l3" || local.m == "e3l3" ){ end 1 }
	if( local.m == "m1l3a" || local.m == "m1l3b" || local.m == "m1l3c" || local.m == "m2l2a" || local.m == "m2l3" ){ end 1 }
	if( local.m == "m3l1a" || local.m == "m3l1b" || local.m == "m5l1b" || local.m == "m5l2a" || local.m == "m5l2b" ){ end 1 }
	if( local.m == "m6l1c" || local.m == "m6l2a" || local.m == "m6l3a" || local.m == "t2l2" || local.m == "t3l2" || local.m == "training" ){ end 1 }
}end 0


// "ok" when the counter-attack may run, otherwise the reason it may not
counter_gate local.m local.next:{
	local.force = 0
	if( getcvar( "coop_counterForce" ) == "1" ){ local.force = 1 }
	if( getcvar( "coop_counter" ) != "1" && local.force == 0 ){ end "off" }
	if( level.coop_counterDone == 1 ){ end "done" }
	if( level.coop_mpRun == 1 ){ end "mp" }
	local.mt = getcvar( "coop_maptest" )
	if( local.mt != "0" && local.mt != "" ){ end "maptest" }
	if( level.coop_lobbyMap == 1 ){ end "lobby" }
	if( local.m == NIL ){ end "nomap" }
	// a restart after a failure (m5l3 "bridge destroyed" -> missioncomplete on the SAME map) or a void hop is not a victory
	if( local.next == local.m || local.next == "void" ){ end "restart" }
	if( waitthread coop_mod/main.scr::containsText local.m "briefing" 0 ){ end "briefing" }
	if( waitthread coop_mod/main.scr::containsText local.m "lobby" 0 ){ end "lobby" }
	if( local.force == 0 ){
		if( level.coop_noCounter == 1 ){ end "noCounter" }
		if( level.coop_stealthMap == 1 ){ end "stealth" }
		if( level.coop_enableDisguises ){ end "disguise" }
		if( waitthread counter_denied local.m ){ end "denied" }
	}
	if( ( waitthread counter_players ) < 1 ){ end "noplayers" }
}end "ok"


// players in the squad -> men per wave: 1-2: 4, 3-4: 6, 5+: 8
counter_wavesize local.pc:{
	local.n = 4
	if( local.pc >= 3 ){ local.n = 6 }
	if( local.pc >= 5 ){ local.n = 8 }
}end local.n


// fallback when rnf_entry finds nothing: a ring point 1100-1900u from the living players' centre that has ground
counter_fallback:{
	local.pn = 0
	local.cen = ( 0 0 0 )
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		if( !isAlive local.p ){ continue }
		if( local.p.dmteam == "spectator" ){ continue }
		local.pn++
		local.cen = local.cen + local.p.origin
	}
	if( local.pn < 1 ){ end NIL }
	local.cen = vector_scale local.cen ( 1.0 / local.pn )
	local.a0 = randomint 360
	for( local.t = 0; local.t < 8; local.t++ ){
		local.dir = angles_toforward ( 0 ( local.a0 + ( local.t * 45 ) ) 0 )
		local.rr = 1100 + ( randomint 800 )
		local.c = local.cen + ( vector_scale local.dir local.rr ) + ( 0 0 48 )
		local.g = waitthread coop_mod/officer.scr::coop_find_ground local.c
		if( local.g != NIL ){ end local.g }
	}
}end NIL


// one wave of local.n men at local.pos. Same recipe as officer.scr::coop_spawn_infantry_squad (xp class, arm, scale,
// attackplayer, coop_wave_hunt), tracked in level.coop_counterActors so the cap and the early finish can count them.
counter_squad local.pos local.n local.wave local.src:{
	local.made = 0
	for( local.i = 0; local.i < local.n; local.i++ ){
		local.gnd = exec coop_mod/officer.scr::coop_spread_pos local.pos local.i
		if( local.gnd == NIL ){ waitframe; continue }
		local.role = "infantry"
		if( local.wave >= 3 && local.i == 0 && local.src == "counter" ){ local.role = "officer" }
		local.smodel = exec coop_mod/officer.scr::coop_model_for local.role
		local.s = spawn local.smodel
		if( local.s == NULL || local.s == NIL ){ waitframe; continue }
		local.s.coop_xpClass = "reinf"
		local.s.flags["coop_waveSrc"] = local.src
		local.s.origin = local.gnd
		local.s droptofloor
		local.s.health = 120
		local.s.flags["coop_actorStopPainHandler"] = 1
		local.s.accuracy = 65
		local.s.leash = 4096
		local.s.enableEnemy = 1
		local.k = local.i - ( int( local.i / 3 ) * 3 )
		if( local.k == 0 ){
			local.s waitthread coop_mod/aihandler.scr::coop_actorArm "mp40"
		} else if( local.k == 1 ){
			local.s waitthread coop_mod/aihandler.scr::coop_actorArm "mauser kar 98k"
		} else {
			local.s waitthread coop_mod/aihandler.scr::coop_actorArm "stg44"
		}
		exec coop_mod/officer.scr::coop_reinf_scale local.s
		local.s exec coop_mod/replace.scr::attackplayer
		local.s rendereffects "+coopboss"
		local.s.flags["coop_squadSlot"] = local.i
		waitthread coop_mod/officer.scr::coop_apply_personality local.s
		thread coop_mod/officer.scr::coop_wave_hunt local.s
		thread coop_mod/officer.scr::coop_wave_glow local.s
		if( level.coop_counterN == NIL ){ level.coop_counterN = 0 }
		level.coop_counterN++
		level.coop_counterActors[level.coop_counterN] = local.s
		local.made++
		waitframe
	}
}end local.made


// one wave: size by players, capped by what is still alive, from a planned entry
counter_wave local.wave:{
	local.pc = waitthread counter_players
	if( local.pc < 1 ){ end 0 }
	local.n = waitthread counter_wavesize local.pc
	local.cap = 14
	if( getcvar( "coop_counterCap" ) != "" ){ local.cap = int( getcvar( "coop_counterCap" ) ) }
	if( local.cap < 1 ){ local.cap = 14 }
	local.alive = waitthread counter_alive
	if( ( local.alive + local.n ) > local.cap ){ local.n = local.cap - local.alive }
	if( local.n < 1 ){
		waitthread counter_log ( "wave " + local.wave + " skipped: cap " + local.cap + " alive " + local.alive )
		end 0
	}
	local.pos = NIL
	if( getcvar( "coop_reinfSmart" ) != "0" && getcvar( "coop_reinfEntry" ) != "0" ){
		local.pos = waitthread coop_mod/reinf.scr::rnf_entry NIL
	}
	local.why = "entry"
	if( local.pos == NIL ){
		local.pos = waitthread counter_fallback
		local.why = "fallback"
	}
	if( local.pos == NIL ){
		waitthread counter_log ( "wave " + local.wave + " skipped: no entry" )
		end 0
	}
	local.made = waitthread counter_squad local.pos local.n local.wave "counter"
	waitthread counter_log ( "wave " + local.wave + " players=" + local.pc + " want=" + local.n + " made=" + local.made + " alive=" + ( waitthread counter_alive ) + " via=" + local.why + " at=" + local.pos )
}end local.made


//=========================================================================
// DEFEND ZONE (2026-10-18). The squad must HOLD a place for the whole window, not just survive anywhere.
//   zone      : the vetted zone nearest the squad when the objective completes (coop_counter_zones.scr, BSP-traced by
//               docs/tools/gen_counter_zones.py: walkable floor, room for 4, reachable pathnode body, no vent/ladder top);
//               a map with none near gets a runtime zone traced at the squad (counter_zone_fallback).
//   marker    : compass objective diamond (set_objective_pos, the KOTH/CTF mechanism) + a smoke column and ring on the ground
//               + a "Defend: <place>" feed line at the start.
//   clock     : counts down ONLY while a living, non-downed player is inside. Empty: it pauses; after coop_counterGrace s
//               (10) it winds BACK at 1 s per s; empty with enemies inside for coop_counterLoseTime s (30) = zone lost, the
//               defence restarts from full time (no mission fail). A player who leaves gets "Return to the defence zone".
//   The clock is driven by level.time deltas, never by counting wait 1 loops: the old loop added one second per
//   iteration while every wave spawn (a frame per man + the entry search) ate real time between ticks, so the native
//   stopwatch (real time) hit 0 before the loop finished.
//=========================================================================

// player counts as defending: alive, active, not spectating, not downed
counter_eligible local.p:{
	if( local.p == NULL || local.p == NIL ){ end 0 }
	if( local.p.flags["coop_isActive"] != 1 ){ end 0 }
	if( local.p.dmteam == "spectator" ){ end 0 }
	if( !isAlive local.p ){ end 0 }
	if( local.p.flags["coop_dbno_active"] == 1 ){ end 0 }
}end 1


// 1 when local.pos is inside the zone (xy radius, 110 u of height)
counter_inzone local.pos:{
	local.d = local.pos - level.coop_czSel
	local.h = local.d[2]
	local.d[2] = 0
	if( local.h < 0 ){ local.h = 0 - local.h }
	if( local.h > 110 ){ end 0 }
	if( ( vector_length local.d ) > level.coop_czSelR ){ end 0 }
}end 1


counter_inside:{
	local.n = 0
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( ( waitthread counter_eligible local.p ) != 1 ){ continue }
		if( ( waitthread counter_inzone local.p.origin ) == 1 ){ local.n++ }
	}
}end local.n


// wave men alive inside the zone
counter_foes_inzone:{
	local.n = 0
	if( level.coop_counterN == NIL ){ end 0 }
	for( local.i = 1; local.i <= level.coop_counterN; local.i++ ){
		local.a = level.coop_counterActors[local.i]
		if( local.a == NULL || local.a == NIL ){ continue }
		if( !( isAlive local.a ) ){ continue }
		if( ( waitthread counter_inzone local.a.origin ) == 1 ){ local.n++ }
	}
}end local.n


// no vetted zone near: trace one at the squad (walkable ground under the player nearest the squad's centre; radius from 12 chest rays)
counter_zone_fallback local.cen:{
	local.best = NIL
	local.bd = 999999
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( ( waitthread counter_eligible local.p ) != 1 ){ continue }
		local.d = vector_length ( local.p.origin - local.cen )
		if( local.d < local.bd ){ local.bd = local.d; local.best = local.p }
	}
	if( local.best == NIL ){ end NIL }
	local.g = waitthread coop_mod/officer.scr::coop_find_ground ( local.best.origin + ( 0 0 8 ) )
	if( local.g == NIL ){ local.g = local.best.origin }
	local.sum = 0
	for( local.k = 0; local.k < 12; local.k++ ){
		local.dir = angles_toforward ( 0 ( local.k * 30 ) 0 )
		local.tr = traced ( local.g + ( 0 0 48 ) ) ( local.g + ( 0 0 48 ) + ( vector_scale local.dir 600 ) )
		local.f = local.tr["fraction"]
		local.sum = local.sum + ( local.f * 600 )
	}
	local.rad = ( local.sum / 12 ) * 0.9
	if( local.rad < 260 ){ local.rad = 260 }
	if( local.rad > 520 ){ local.rad = 520 }
	level.coop_czSel = local.g
	level.coop_czSelR = local.rad
	level.coop_czSelName = "this position"
	local.up = traced ( local.g + ( 0 0 8 ) ) ( local.g + ( 0 0 600 ) )
	if( local.up["fraction"] >= 1.0 ){ level.coop_czSelName = "this open ground" }
}end 1


// choose the zone: vetted zone nearest the squad (within 1400 u and 128 of height), else the runtime one
counter_zone_pick:{
	local.cen = ( 0 0 0 )
	local.n = 0
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( ( waitthread counter_eligible local.p ) != 1 ){ continue }
		local.cen = local.cen + local.p.origin
		local.n++
	}
	if( local.n < 1 ){ end 0 }
	local.cen = vector_scale local.cen ( 1.0 / local.n )
	local.cnt = waitthread coop_mod/coop_counter_zones.scr::zones level.coop_mapname
	local.bi = 0
	local.bd = 1400
	for( local.i = 1; local.i <= local.cnt; local.i++ ){
		local.zp = level.coop_czPos[local.i]
		local.dz = local.zp[2] - local.cen[2]
		if( local.dz < 0 ){ local.dz = 0 - local.dz }
		if( local.dz > 128 ){ continue }
		local.d2 = local.zp - local.cen
		local.d2[2] = 0
		local.d = vector_length local.d2
		if( local.d < local.bd ){ local.bd = local.d; local.bi = local.i }
	}
	if( local.bi > 0 ){
		level.coop_czSel = level.coop_czPos[local.bi]
		level.coop_czSelR = level.coop_czRad[local.bi]
		level.coop_czSelName = level.coop_czName[local.bi]
		level.coop_czSrc = "vetted"
		end 1
	}
	level.coop_czSrc = "traced"
	waitthread counter_zone_fallback local.cen
}end 1


// smoke column at the centre + a ring of smaller columns on the zone edge, plus the compass diamond
counter_marker_start:{
	set_objective_pos level.coop_czSel
	level.coop_czMarkN = 0
	local.c = spawn script_model model "models/emitters/planesmokeplumeyellow.tik"
	if( local.c != NIL && local.c != NULL ){
		local.c.origin = level.coop_czSel + ( 0 0 6 )
		local.c notsolid
		local.c svflags "+broadcast"
		local.c anim start
		level.coop_czMarkN++
		level.coop_czMark[level.coop_czMarkN] = local.c
	}
	for( local.k = 0; local.k < 8; local.k++ ){
		local.dir = angles_toforward ( 0 ( local.k * 45 ) 0 )
		local.pos = level.coop_czSel + ( vector_scale local.dir ( level.coop_czSelR * 0.9 ) ) + ( 0 0 64 )
		local.g = waitthread coop_mod/officer.scr::coop_find_ground local.pos
		if( local.g == NIL ){ continue }
		local.e = spawn script_model model "models/emitters/planesmokeplumeyellow.tik"
		if( local.e == NIL || local.e == NULL ){ continue }
		local.e.origin = local.g + ( 0 0 6 )
		local.e notsolid
		local.e svflags "+broadcast"
		local.e anim start
		level.coop_czMarkN++
		level.coop_czMark[level.coop_czMarkN] = local.e
	}
}end


counter_marker_stop:{
	if( level.coop_czMarkN == NIL ){ end }
	for( local.i = 1; local.i <= level.coop_czMarkN; local.i++ ){
		local.e = level.coop_czMark[local.i]
		if( local.e != NULL && local.e != NIL ){ local.e remove }
	}
	level.coop_czMarkN = 0
}end


// the marker pulses (flickers) for ~3 s: players left the zone, or it was lost
counter_marker_pulse:{
	if( level.coop_czPulsing == 1 ){ end }
	level.coop_czPulsing = 1
	for( local.r = 0; local.r < 4; local.r++ ){
		for( local.i = 1; local.i <= level.coop_czMarkN; local.i++ ){
			local.e = level.coop_czMark[local.i]
			if( local.e != NULL && local.e != NIL ){ local.e hide }
		}
		wait 0.35
		for( local.i = 1; local.i <= level.coop_czMarkN; local.i++ ){
			local.e = level.coop_czMark[local.i]
			if( local.e != NULL && local.e != NIL ){ local.e show }
		}
		wait 0.35
	}
	level.coop_czPulsing = 0
}end


// "DEFEND  2:14" (top centre, slot 114) + a status line (slot 115). Strings only change when the text does.
counter_hud local.p local.t1 local.t2 local.r local.g local.b:{
	if( local.p == NULL || local.p == NIL ){ end }
	if( local.p.flags["coop_czHud"] != 1 ){
		local.p.flags["coop_czHud"] = 1
		waitthread coop_mod/hudresend.scr::claim local.p 114 115
		ihuddraw_virtualsize local.p 114 1
		ihuddraw_align local.p 114 center top
		ihuddraw_rect local.p 114 235 70 170 0
		ihuddraw_font local.p 114 "facfont-20"
		ihuddraw_virtualsize local.p 115 1
		ihuddraw_align local.p 115 center top
		ihuddraw_rect local.p 115 195 100 250 0
		ihuddraw_font local.p 115 "verdana-12"
	}
	if( local.p.flags["coop_czT1"] != local.t1 ){
		local.p.flags["coop_czT1"] = local.t1
		ihuddraw_string local.p 114 local.t1
	}
	if( local.p.flags["coop_czT2"] != local.t2 ){
		local.p.flags["coop_czT2"] = local.t2
		ihuddraw_string local.p 115 local.t2
	}
	ihuddraw_color local.p 114 local.r local.g local.b
	ihuddraw_color local.p 115 local.r local.g local.b
	ihuddraw_alpha local.p 114 1
	ihuddraw_alpha local.p 115 1
}end


counter_hud_off:{
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		if( local.p.flags["coop_czHud"] == 1 ){
			ihuddraw_alpha local.p 114 0
			ihuddraw_alpha local.p 115 0
			ihuddraw_string local.p 114 ""
			ihuddraw_string local.p 115 ""
			local.p.flags["coop_czHud"] = NIL
			local.p.flags["coop_czT1"] = NIL
			local.p.flags["coop_czT2"] = NIL
		}
	}
}end


// m:ss of a (float) number of seconds, rounded UP so the clock reads 0:00 only when it is really over
counter_clock local.sec:{
	local.s = int( local.sec + 0.999 )
	if( local.s < 0 ){ local.s = 0 }
	local.m = int( local.s / 60 )
	local.r = local.s - ( local.m * 60 )
	local.txt = "" + local.m + ":"
	if( local.r < 10 ){ local.txt = local.txt + "0" }
	local.txt = local.txt + local.r
}end local.txt


// the whole event. Returns when the window is over; the caller (missioncomplete.scr) carries on to the debrief.
counter_run local.nextlevel:{
	local.gate = waitthread counter_gate level.coop_mapname local.nextlevel
	if( local.gate != "ok" ){
		if( local.gate != "off" ){ waitthread counter_log ( "skip " + level.coop_mapname + ": " + local.gate ) }
		end
	}
	level.coop_counterDone = 1
	level.coop_counterActive = 1
	local.secs = 150
	if( getcvar( "coop_counterSecs" ) != "" ){ local.secs = int( getcvar( "coop_counterSecs" ) ) }
	if( local.secs < 10 ){ local.secs = 10 }
	local.gap = 30
	if( getcvar( "coop_counterWaveGap" ) != "" ){ local.gap = int( getcvar( "coop_counterWaveGap" ) ) }
	if( local.gap < 5 ){ local.gap = 5 }
	local.emptyGrace = 10
	if( getcvar( "coop_counterGrace" ) != "" ){ local.emptyGrace = int( getcvar( "coop_counterGrace" ) ) }
	if( local.emptyGrace < 1 ){ local.emptyGrace = 1 }
	local.loseTime = 30
	if( getcvar( "coop_counterLoseTime" ) != "" ){ local.loseTime = int( getcvar( "coop_counterLoseTime" ) ) }
	if( local.loseTime < 3 ){ local.loseTime = 3 }
	local.grace = 15
	println( "^~^~^ COUNTER start map=" + level.coop_mapname + " secs=" + local.secs + " gap=" + local.gap + " players=" + ( waitthread counter_players ) )

	// the defend zone + its marker
	waitthread counter_zone_pick
	if( level.coop_czSel == NIL ){
		println "^~^~^ COUNTER zone none (no eligible player) - ending"
		level.coop_counterActive = 0
		end
	}
	println( "^~^~^ COUNTER zone src=" + level.coop_czSrc + " name=" + level.coop_czSelName + " at=" + level.coop_czSel + " r=" + level.coop_czSelR )
	thread counter_marker_start
	waitthread coop_mod/feed.scr::feed_all 0 "counter" ( "Hold the position - counter-attack incoming. Defend: " + level.coop_czSelName )
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		local.p playsound coop_radio_on
	}
	wait 1.2
	local.rsnd = "coop_radio_german_reinf" + ( ( randomint 9 ) + 1 )
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p == NIL ){ continue }
		local.p playsound local.rsnd
	}

	// the clock: an accumulator driven by level.time deltas (see the header)
	local.total = local.secs + local.grace
	local.remaining = local.total
	local.t0 = level.time
	local.last = level.time
	local.nextwave = level.time + local.grace
	local.wave = 0
	local.emptyT = 0
	local.loseT = 0
	local.dead = 0
	local.nextlog = level.time
	local.state = "hold"
	local.lostN = 0
	while( local.remaining > 0 ){
		wait 0.25
		// waves run on the REAL clock (they keep coming while the zone is empty). The tick's dt is taken AFTER the wave, so the spawn
		// time is on the clock in the same tick.
		if( level.time >= local.nextwave && local.remaining > 10 ){
			local.wave++
			waitthread counter_wave local.wave
			local.nextwave = level.time + local.gap + ( randomint 11 )
		}
		local.now = level.time
		local.dt = local.now - local.last
		local.last = local.now

		local.inside = waitthread counter_inside
		local.prev = local.state
		if( local.inside > 0 ){
			local.emptyT = 0
			local.loseT = 0
			local.remaining = local.remaining - local.dt
			local.state = "hold"
		} else {
			local.emptyT = local.emptyT + local.dt
			if( local.emptyT < local.emptyGrace ){
				local.state = "paused"
			} else {
				local.state = "rewind"
				local.remaining = local.remaining + local.dt
				if( local.remaining > local.total ){ local.remaining = local.total }
			}
			if( ( waitthread counter_foes_inzone ) > 0 ){
				local.loseT = local.loseT + local.dt
			}
			if( local.loseT >= local.loseTime ){
				local.lostN++
				local.remaining = local.total
				local.emptyT = 0
				local.loseT = 0
				local.state = "lost"
				local.nextwave = level.time + 10
				waitthread coop_mod/feed.scr::feed_all 0 "cz_lost" "Defence zone lost - the enemy took the position. Retake it: the defence starts over"
				thread counter_marker_pulse
				println( "^~^~^ COUNTER zone LOST (#" + local.lostN + ") - restart from " + local.total + " t=" + level.time )
			}
		}
		if( local.state != local.prev ){
			println( "^~^~^ COUNTER state " + local.prev + " -> " + local.state + " remaining=" + local.remaining + " inside=" + local.inside + " empty=" + local.emptyT + " t=" + level.time )
		}

		// per-player warning + HUD
		local.txt = waitthread counter_clock local.remaining
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p == NULL || local.p == NIL ){ continue }
			if( local.p.dmteam == "spectator" ){ continue }
			local.mine = 1
			if( ( waitthread counter_eligible local.p ) == 1 ){
				if( ( waitthread counter_inzone local.p.origin ) != 1 ){ local.mine = 0 }
			}
			if( local.mine == 1 ){
				local.p.flags["coop_czOut"] = NIL
				if( local.state == "rewind" ){
					waitthread counter_hud local.p ( "DEFEND  " + local.txt ) "Zone empty - the clock is winding back" 1 0.45 0.2
				} else if( local.state == "paused" ){
					waitthread counter_hud local.p ( "DEFEND  " + local.txt ) "Zone empty - clock paused" 1 0.8 0.2
				} else {
					waitthread counter_hud local.p ( "DEFEND  " + local.txt ) ( "Hold: " + level.coop_czSelName ) 0.6 1 0.6
				}
			} else {
				waitthread counter_hud local.p ( "DEFEND  " + local.txt ) "RETURN TO THE DEFENCE ZONE" 1 0.3 0.2
				if( local.p.flags["coop_czOut"] == NIL || level.time >= local.p.flags["coop_czOut"] ){
					waitthread coop_mod/feed.scr::feed_player local.p 0 "cz_return" "Return to the defence zone"
					local.p.flags["coop_czOut"] = level.time + 8
					thread counter_marker_pulse
					println( "^~^~^ COUNTER warn " + local.p.netname + " outside t=" + level.time )
				}
			}
		}

		if( level.time >= local.nextlog ){
			println( "^~^~^ COUNTER tick t=" + level.time + " elapsed=" + ( level.time - local.t0 ) + " remaining=" + local.remaining + " state=" + local.state + " inside=" + local.inside + " empty=" + local.emptyT + " lose=" + local.loseT + " waves=" + local.wave )
			local.nextlog = level.time + 5
		}

		if( ( waitthread counter_players ) < 1 ){
			local.dead = local.dead + local.dt
			if( local.dead >= 5 ){
				waitthread counter_log "squad down, ending early"
				break
			}
		} else {
			local.dead = 0
		}
		// early finish: after wave 4, 80 percent of the men sent are dead
		if( local.wave >= 4 && level.coop_counterN > 0 ){
			local.al = waitthread counter_alive
			local.al5 = local.al * 5
			if( local.al5 <= level.coop_counterN ){
				waitthread counter_log ( "early finish: alive " + local.al + " of " + level.coop_counterN )
				local.remaining = 0
				break
			}
		}
	}
	if( local.remaining <= 0 ){
		println( "^~^~^ COUNTER clock 0:00 t=" + level.time + " elapsed=" + ( level.time - local.t0 ) )
	}
	waitthread counter_hud_off
	exec coop_mod/replace.scr::stopwatch 0
	waitthread counter_marker_stop
	// the squad is frozen for the debrief that follows: whoever is left stands down (alive, but no longer hunting)
	for( local.i = 1; local.i <= level.coop_counterN; local.i++ ){
		local.a = level.coop_counterActors[local.i]
		if( local.a == NULL || local.a == NIL ){ continue }
		if( isAlive local.a ){ local.a.enableEnemy = 0 }
	}
	println( "^~^~^ COUNTER end waves=" + local.wave + " sent=" + level.coop_counterN + " alive=" + ( waitthread counter_alive ) + " lost=" + local.lostN + " t=" + level.time )
	level.coop_counterActive = 0
}end
