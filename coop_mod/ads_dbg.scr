// HZM coop - ADS diagnostic. Called from the AIM state's entrycommands in
// coop_mod/player_Torso.st. Prints (only when cvar coop_ads_dbg 1) so we can
// confirm the statemap AIM state is actually being ENTERED on RMB-hold. This is
// independent of the FOV-zoom path in coop_mod/ads.scr, so the two prints
// together isolate statemap-vs-script. Safe no-op when coop_ads_dbg is 0.
main:
	local.player = self
	if( getcvar "coop_ads_dbg" == "1" ){
		local.player iprint "ADS: AIM state ENTERED (raise path)" 1
	}
end
