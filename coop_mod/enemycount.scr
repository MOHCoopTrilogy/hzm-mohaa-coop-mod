//=========================================================================
// enemycount.scr - "ENEMIES REMAINING: N", top right
//=========================================================================
// [user 2026-10-11, bug-3485] "an enemies remaining count that will appear at the top right of the
// screen for objectives like post-clearing the uboat, and after you exit the bunker on the omaha
// map as well as any other mission where enemy count determines an outcome of objective
// completion". ONE readout for every such objective, so they all look and behave the same.
//
// THE NUMBER IS THE MAP'S OWN. This file counts nothing: the map hands it the same number its own
// gate tests (m2l2b level.gatecount, m3l1b the coop_rear_headcount poll, ...), so the readout can
// never disagree with what completes the objective. A map that cannot hand over such a number
// does not get a readout.
//
//   thread coop_mod/enemycount.scr::show <count> [label]
//        start the readout, or change its number. count <= 0 takes it down.
//        Safe to call every poll of a gate loop - it only stores the number.
//   thread coop_mod/enemycount.scr::update <count> [label]
//        the same, but ONLY while the readout is already up. For a death thread that also runs
//        outside the objective's window (m1l1 bodycount, m2l2b countdeaths).
//   thread coop_mod/enemycount.scr::stop
//        take it down for everyone. Safe when it is not up.
//   label defaults to "ENEMIES REMAINING"; pass another only where the counted men are a named
//   few among other enemies ("SNIPERS REMAINING"), so killing an uncounted one is not a surprise.
//
// DRAWN BY CGAME, not the script HUD (cg_coopfeed.c CG_DrawCoopPinned): the server only sets the
// client cvar coop_ecLine. One loop keeps every player's copy current, which is also what makes it
// right for a late joiner or a respawn without a hook in player.scr. It stands down for a player
// who has the Service Record open (coop_chalMenuPage). No HUD slot is used.
// Position: the very top right. The retail Score readout that used to sit there is hidden in coop
// (ui/hud_score.urc is gated on coop_mp_session), since the scoreboard on Tab already shows it.
//=========================================================================


//=========================================================================
// show local.count local.label
//=========================================================================
show local.count local.label:{
	if( local.count == NIL ){ end }
	local.count = int( local.count )
	if( local.count <= 0 ){
		waitthread stop
		end
	}
	if( local.label == NIL ){ local.label = "ENEMIES REMAINING" }
	level.coop_ecCount = local.count
	level.coop_ecLabel = local.label
	//already up: ec_loop picks the new number up on its next tick
	if( level.coop_ecOn == 1 ){ end }
	level.coop_ecOn = 1
	//a generation, not just the flag: stop + show inside one tick must not leave two loops running
	if( level.coop_ecGen == NIL ){ level.coop_ecGen = 0 }
	level.coop_ecGen = level.coop_ecGen + 1
	thread ec_loop level.coop_ecGen
}end


//=========================================================================
// update local.count local.label
//=========================================================================
update local.count local.label:{
	if( level.coop_ecOn != 1 ){ end }
	waitthread show local.count local.label
}end


//=========================================================================
// stop
//=========================================================================
stop:{
	if( level.coop_ecOn != 1 ){ end }
	level.coop_ecOn = 0
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		local.i++
		if( local.p == NULL ){ continue }
		//Service Record open: it wiped 249 when it opened and the slot is its row now - leave it
		local.pg = local.p.flags["coop_chalMenuPage"]
		if( local.pg != NIL && local.pg != 0 ){
			local.p.flags["coop_ecSeen"] = NIL
			continue
		}
		waitthread ec_hide local.p
	}
}end


//=========================================================================
// ec_loop local.gen - the one drawing loop. Ends when the readout is stopped or restarted.
//=========================================================================
ec_loop local.gen:{
	local.tick = 0
	while( level.coop_ecOn == 1 && level.coop_ecGen == local.gen ){
		local.txt = level.coop_ecLabel + ": " + level.coop_ecCount
		local.i = 1
		while( local.i <= $player.size ){
			local.p = $player[local.i]
			local.i++
			if( local.p == NULL ){ continue }

			//Service Record open: it fills the top right. Stand down until it closes.
			local.pg = local.p.flags["coop_chalMenuPage"]
			if( local.pg != NIL && local.pg != 0 ){
				if( local.p.flags["coop_ecSeen"] != "-" ){
					local.p.flags["coop_ecSeen"] = "-"
					local.p stufftext "set coop_ecLine -"
				}
				continue
			}

			//[user 2026-10-11] "Make the enemies remaining text smaller". The script HUD's smallest font is
			//verdana-12 at virtual-480 scale, 1.5x to 2.25x its real size, so the line is drawn by cgame
			//instead (cg_coopfeed.c CG_DrawCoopPinned): the client cvar coop_ecLine, top right, in the event
			//feed's own small type. Sent on a change and again every 2 s - that is what reaches a player who
			//joined after the last change, and one whose cgame restarted (CG_Init clears the cvar).
			//NO QUOTES in the command (readygate.scr coop_gateSet, bug D): stufftext wraps the whole command
			//in quotes on the wire, so an inner quote cuts it short. `set` takes the rest of the line, spaces
			//and all; "-" is the agreed empty value.
			local.seen = local.p.flags["coop_ecSeen"]
			if( local.seen == NIL ){ local.seen = "" }
			if( local.seen != local.txt || local.tick == 0 ){
				local.p.flags["coop_ecSeen"] = local.txt
				local.p stufftext ( "set coop_ecLine " + local.txt )
			}
		}
		local.tick++
		if( local.tick >= 8 ){ local.tick = 0 }
		wait 0.25
	}
}end


//=========================================================================
// ec_hide local.p - take it off one player's screen
//=========================================================================
ec_hide local.p:{
	if( local.p == NULL ){ end }
	local.p.flags["coop_ecSeen"] = NIL
	local.p stufftext "set coop_ecLine -"
}end
