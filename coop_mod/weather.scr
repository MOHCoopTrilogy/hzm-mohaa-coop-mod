//=========================================================================
// HZM coop - WEATHER (v2): coop now drives the NATIVE SP trilogy weather system (global/weather.scr) so
// rain / thunderstorms / lightning / snow look exactly like single-player. This file is the COOP CONTROLLER:
// it picks the per-map theme, seeds the SP precip "look", and hands off to the native renderer. BOTH rain and
// snow are FLUID and DYNAMIC - a coop random-walk driver drifts the intensity so light rain builds into
// thunderstorms and light snow into blizzards, then eases back, unpredictably; the native weather.scr smooths
// every transition and (for rain) fires thunder + lightning whose frequency scales with intensity. The rain
// visual is networked to EVERY coop client by the cgame; our coop_weather_flash hook (called from the native
// singlethunder) adds a per-client sky flash so all players see the lightning (the native r_fastsky / farplane
// flash only reaches the host over the network).
//
//   coop_dynWeather 1/0                = master on/off (threaded once per map from main.scr::main)
//   coop_weatherForce ""/rain/snow/off = OVERRIDE the per-map theme (set BEFORE the map loads to test)
//   coop_weatherPin ""/cycle/0..3      = "" fluid random storms (default) | "cycle" native fixed cycle |
//                                        0..3 hold a fixed intensity (0 calm .. 3 storm/blizzard)
//   coop_rainVolume 0.85               = peak rain-ambience loudness
//   coop_dynWeatherLightning 1         = per-client lightning flash on thunder (0 = thunder sound only)
//
// Theme is (1) coop_weatherForce override, else (2) level.coop_weatherTheme if the map set one, else "none".
// ~20 coop maps already declare level.coop_weatherTheme; snow maps get snow, rain maps get storms.
//=========================================================================

coop_weather_init:{
	if( int( getcvar "coop_dynWeather" ) != 1 ){ end }
	level.coop_rainSndEnt = NULL
	//[2026-09-26, bug-2963] DUST STORM: register the veil models and clear a stale forced storm HERE, in the
	//first frame - before the waitTillPrespawn below. A model registered mid-game hitches every client (the
	//bug-2710/2796 class). The theme is not known yet (the map sets it after main.scr::main), so the boot keys
	//on the nine sand map names; it ends at once on Omaha, and in MP unless mp_weather.scr allowed dust (level.coop_dustMp).
	waitthread coop_mod/duststorm.scr::coop_dust_boot

	// HZM coop - DEFER until the map's own main has set level.coop_weatherTheme. This thread is started from
	// inside main.scr::main, which runs BEFORE the map script's main reaches its 'level.coop_weatherTheme = ...'
	// line (that line sits AFTER 'waitthread coop_mod/main.scr::main'). Reading the theme immediately therefore
	// got NIL -> coop_weather_theme returned "none" -> weather silently never started on ANY map even with
	// coop_dynWeather 1. waitTillPrespawn is a 0.5s coop wait (well after the theme is set) and still long
	// before 'level waittill spawn', which is when global/weather.scr wants to be exec'd.
	//[bug-2968] The MP entry (mp_weather.scr) never routes through the coop shims: it set the theme BEFORE
	//threading this, and in any MP gametype waitTillPrespawn is a bare 0.5s wait - so wait that here instead.
	if( level.coop_mpRun == 1 ){
		wait 0.5
	} else {
		waitthread coop_mod/replace.scr::waitTillPrespawn
	}
	local.theme = waitthread coop_weather_theme
	if( local.theme == "none" ){ end }

	// RUN-ONCE (bug-2731 follow-up): coop_weather_init is threaded from BOTH main.scr::main (the coop-native
	// path) AND mp_weather.scr::mp_weather_init (the MP bridge). On a coop-integrated CAMPAIGN map forced into
	// an MP arena (m2l1 etc.) NEITHER coop_arenaMap nor coop_buildmap is set, so the coop-native theme gate
	// does not stand down - both paths resolve the same theme and BOTH ran a full native renderer + random
	// driver + thunder thread (verified headless: two "WEATHER coop=snow started" blocks on m2l1 Push). Guard
	// AFTER the theme resolve so a "none" resolver never consumes the latch; check-and-set are adjacent with no
	// yield between them, so the first caller to reach here wins and the second bails. Idempotent for pure coop
	// (only main.scr threads it there, so this is a no-op).
	if( level.coop_weatherStarted == 1 ){ end }
	level.coop_weatherStarted = 1

	// seed the SP precip LOOK for this theme; the native weather.scr then drives density + slant on top
	if( local.theme == "snow" ){
		waitthread coop_weather_snowLook
	} else if( local.theme == "sand" ){
		waitthread coop_weather_sandLook
		//[2026-09-26, bug-2973] a DEFAULT-ON dust map (duststorm.scr coop_dust_defaultOn - e1l1; never in MP) is a
		//constant full storm, so its streaks are held at full too, through the same map-authored hold the lines
		//below already honour (bug-1375). A map's own coop_weatherHold still wins; coop_dust 0 leaves it random.
		local.dustOn = waitthread coop_mod/duststorm.scr::coop_dust_defaultOn level.coop_mapname
		if( local.dustOn == 1 && getcvar( "coop_dust" ) != "0" && ( level.coop_weatherHold == NIL || level.coop_weatherHold == "" ) ){
			level.coop_weatherHold = 3
		}
	} else {
		waitthread coop_weather_rainLook
	}

	// [HZM coop 2026-08-02] bug-1280 - start at whatever intensity the MAP authored, not flat calm.
	// This used to hardcode 0, which silently overrode maps that script their own weather: t3l1 sets
	// 'level.rain_density = 5' (maps/t3l1.scr:22) for Berlin, yet the controller forced pattern 0 and the
	// random driver also opened at 0 with 180-420s dry spells - so a mission scripted to rain throughout
	// could sit under clear sky for minutes. Per the user's rule for t3l1, match what SP does.
	level.weatherpattern = waitthread coop_weather_seedPattern

	//[user 2026-08-04] bug-1375 - PER-MAP CONSTANT WEATHER. Some levels stormed CONTINUOUSLY in
	//retail; e3l4 Monte Battaglia is the clear case - its own outro explicitly switches the storm
	//off (Outro.scr level.thunder = 0 / level.rainvolume = 0), which only makes sense if it had been
	//on for the whole level. The fluid random driver is deliberately biased toward clearing (38%
	//build / 47% ease, plus 60-180s dry spells), so such a map spent most of a session dry - user:
	//'I think this specific map is supposed to always rain'. A map can now declare
	//level.coop_weatherHold = 0..3 to hold one intensity for the whole mission. Set BEFORE
	//'exec global/weather.scr' below, because the native renderer reads level.weatherpattern.
	if( level.coop_weatherHold != NIL && level.coop_weatherHold != "" ){
		level.weatherpattern = int( level.coop_weatherHold )
	}

	// [2026-08-02] SAFE PROBE - separate printlns, single values, NO concatenation.
	// Question: rain still not visible even though this thread now survives. Which link is dead -
	// the map's authored density (raw=), the band it seeds (pattern=), or the native renderer
	// downstream (density-after=)? raw=NIL means the map value is gone by the time we read it;
	// pattern=0 means the seed maths rejected it; both non-zero means the fault is past this point.
	println "^~^~^ WXSEED raw rain_density="
	if( level.rain_density != NIL ){ println level.rain_density }
	println "^~^~^ WXSEED pattern="
	println level.weatherpattern
	println "^~^~^ WXSEED raindensity(native src)="
	if( level.raindensity != NIL ){ println level.raindensity }

	// hand off to the native SP renderer: it draws the precip, SMOOTHS every intensity change (so transitions
	// are fluid), and for rain fires thunder + lightning whose frequency auto-scales with intensity. It
	// self-syncs via its own "level waittill spawn", so exec'ing here (pre-spawn) is the right moment.
	exec global/weather.scr
	if( getcvar( "coop_ltTestPoll" ) == "1" ){ thread coop_lt_testWatch }	//[2026-09-27] lightning A/B only (see coop_lt_testWatch)

	// FLUID RANDOM storms (default): random-walk the intensity up/down so light rain builds into
	// thunderstorms / light snow into blizzards and eases back, unpredictably. coop_weatherPin "cycle" (native
	// fixed cycle) or 0-3 (fixed intensity) disables this.
	if( level.coop_weatherHold != NIL && level.coop_weatherHold != "" ){
		println( "^~^~^ WEATHER HOLD at intensity " + level.weatherpattern + " - map-authored constant, random driver OFF" )
	} else {
		if( getcvar( "coop_weatherPin" ) == "" ){
			thread coop_weather_randomDriver
		}
	}

	if( local.theme == "rain" ){
		thread coop_weather_sound "coop_rain_ext"	// rain ambience (snow is silent for now)
		//[2026-09-28] STORM DARKNESS (coop_mod/stormlight.scr): each rain storm a kind, the sky and light follow it.
		//After the native exec above, because the director reads level.weatherpattern. On by default; coop_stormLight 0 = off.
		thread coop_mod/stormlight.scr::coop_storm_start
	}

	// second half of the WXSEED probe: what the NATIVE script left behind once it had run. If
	// pattern/raw looked right above but these are 0, global/weather.scr is overriding us.
	waitframe
	println "^~^~^ WXSEED post-exec pattern="
	println level.weatherpattern
	println "^~^~^ WXSEED post-exec rain_density="
	if( level.rain_density != NIL ){ println level.rain_density }
	if( local.theme == "sand" ){
		level.coop_dustWindScale = 1.0		//[bug-2963] seeded before its reader: the storm pulls it to 0.5 at full
		thread coop_weather_sound "coop_amb_wind"	//[user 07-16] sandstorm = driving wind bed tracking intensity
		//[2026-09-26, bug-2963] the DUST STORM ROLL-IN (coop_mod/duststorm.scr): a full storm (pattern 3) now
		//closes the fog and fades a per-player sand sheet + strong wind in; a medium one (2) is a haze.
		//Started here, after the pattern is seeded and the native renderer is up, because it reads both.
		thread coop_mod/duststorm.scr::coop_dust_start
	}
	println( "^~^~^ WEATHER coop=" + local.theme + " (native SP, fluid random)" )
}end

//=========================================================================
// Theme resolution: coop_weatherForce override wins, else the map's level.coop_weatherTheme, else none.
coop_weather_theme:{
	//[user 2026-08-04] bug-1383 - ARENA MODE HAS NO WEATHER. Rain leaks through the roofs of the
	//buildings a holdout arena gets built in, because cg_nature's per-drop SURF_SKY gate only
	//sees sky above them - those interiors were never meant to be stood in. Rather than chase
	//occlusion per building, an arena session simply has no precipitation. coop_buildmap is the
	//arena switch (it is what halts the campaign), so it doubles as the weather gate.
	if( level.coop_arenaMap == 1 || level.coop_buildmap == 1 ){ end "none" }

	local.f = getcvar "coop_weatherForce"
	if( local.f == "rain" ){ end "rain" }
	if( local.f == "snow" ){ end "snow" }
	if( local.f == "sand" ){ end "sand" }
	if( local.f == "off" ){ end "none" }

	if( level.coop_weatherTheme == "rain" ){ end "rain" }
	if( level.coop_weatherTheme == "snow" ){ end "snow" }
	if( level.coop_weatherTheme == "sand" ){ end "sand" }
	end "none"
}end

//=========================================================================
// Read a cvar as a float, falling back to local.def when it is missing / empty / <= 0.
coop_weather_cvar local.name local.def:{
	local.v = getcvar local.name
	if( local.v == "" ){ end local.def }
	local.v = float( local.v )
	if( local.v <= 0 ){ end local.def }
	end local.v
}end

//=========================================================================
// SP SNOW look - m6l1a config: slow, short, drifting flakes via textures/snow0 x12. No thunder / lightning.
// The native weather.scr drives the DENSITY dynamically (via level.weatherpattern), so light snow builds
// into a blizzard and eases back; level.rain_density is networked to every coop client so all players see it.
coop_weather_snowLook:{
	level.rain_numshaders = 12
	level.rain_shader     = "textures/snow"		// [user 07-09] BASE only: engine builds names "%s%i" -> snow0..snow11 (12 real shaders). The old "textures/snow0" produced snow00..snow011 (nonexistent) = default WHITE-SQUARE shader (bug-430).
	level.rain_speed      = 32
	level.rain_speed_vary = 16
	level.rain_length     = 2
	level.rain_width      = 1
	level.rain_slant      = 250
	level.rain_min_dist   = 1800
	level.thundertime     = 0		// snow: no thunder/lightning (native gates the thunder thread on this)
	//[bug-1206] the old `setcvar "r_ppRainDrops" "0"` guard is GONE. It was a server-side setcvar, so it
	//only ever reached a listen HOST - every remote coop client kept its beads - and because
	//r_ppRainDrops is CVAR_ARCHIVE it also stomped the player's own Advanced Graphics setting for the
	//rest of the session. The cgame now decides per weather TYPE (cg_view.c CG_CoopPrecipType, keyed on
	//the networked rain shader name), so snow leaves the lens dry on EVERY client with no cvar poking.
}end

//=========================================================================
//[user 07-16] SANDSTORM look - desert maps (Kasserine e1*, N.Africa m1*) get driving dust
// instead of rain ("desert maps shouldnt have rain - rather they could have sandstorms").
// Reuses the native precip renderer with our own tan dust streaks (scripts/coop_sandstorm.shader,
// textures/coop_sand0..3): fast, near-horizontal, no thunder, no wet lens. The random driver
// still builds it from haze into a full blow and back; the wind bed tracks intensity.
coop_weather_sandLook:{
	level.rain_numshaders = 4
	level.rain_shader     = "textures/coop_sand"	// engine builds "%s%i" -> coop_sand0..3
	level.rain_speed      = 900
	level.rain_speed_vary = 300
	level.rain_length     = 14
	level.rain_width      = 2
	level.rain_slant      = 600		// near-horizontal driving dust
	level.rain_min_dist   = 1024
	level.thundertime     = 0		// no thunder/lightning in a sandstorm
	//[bug-1206] no wet-lens during a dust storm. This is now enforced CLIENT-side off the networked
	//rain shader name ("textures/coop_sand" -> PRECIP_DUST in cg_view.c CG_CoopPrecipType) instead of
	//the old server-side `setcvar "r_ppRainDrops" "0"`, which never reached remote clients - THAT is
	//why dust storms showed rain-on-lens for everyone but the listen host.
}end

//=========================================================================
// SP RAIN look - the static shape only; the native weather.scr drives density + slant dynamically on top of
// this. Uses the real SP textures/rain x12 art (fast driving streaks) - the fix for the old single-streak
// "white lines". rain_width + rain_min_dist are (re)defaulted inside global/weather.scr (0.4 / 512), which
// is correct for rain, so we do not set them here.
coop_weather_rainLook:{
	level.rain_numshaders = 12
	level.rain_shader     = "textures/rain"
	level.rain_speed      = 2048
	level.rain_speed_vary = 400
	level.rain_length     = 90
	level.rain_slant      = 250
	level.thundertime     = 20		// rain: thunder + lightning on (native scales frequency with intensity)
	//[bug-1206] the old `setcvar "r_ppRainDrops" "1"` re-arm is GONE too: it existed only to undo the
	//snow/sand stomps above, and as a side effect it overrode a player who had deliberately turned
	//rain-on-lens OFF in Advanced Graphics. r_ppRainDrops is now purely the user's master toggle; the
	//cgame supplies the per-weather gate.
}end

//=========================================================================
// FLUID RANDOM intensity (the default driver): random-walk level.weatherpattern between 0 (clear) and
// 3 (storm / blizzard), holding each level a random while. The native weather.scr SMOOTHS the actual
// density + slant toward each new target, so storms build and ease naturally - light rain -> thunderstorm
// -> back, light snow -> blizzard -> back - on no fixed schedule. Slight upward bias so weather tends to
// build before it clears; and when it fully clears (level 0) it holds a random DRY SPELL (coop_weatherDryMin/
// Max, default 1-3 min) before the next storm can build - so there are real dry periods, not just brief lulls.
// (For rain, native thunder frequency auto-scales with the intensity this sets.)
//[HZM coop 2026-08-02] bug-1280 - translate a map's authored rain_density into the native
//weatherpattern band, so the random walk STARTS where the map wanted rather than at calm.
//Bands mirror global/weather.scr's own pattern table (1 -> 0.8, 2 -> 3, 3 -> 10 density);
//a map that authored nothing still starts calm, which is the old behaviour.
//=========================================================================
coop_weather_seedPattern:{
//=========================================================================
	if( level.rain_density == NIL ){ end 0 }

	//[2026-08-02] bug-1281 - float() FIRST. level.rain_density arrives as a STRING here (a map can
	//seed it from a cvar, and getcvar always returns a string), so comparing it to an int threw
	//"binary '>=' applied to incompatible types 'string' and 'int'" - which killed this thread and
	//with it the 'exec global/weather.scr' handoff below, so the fix for the missing rain removed
	//the rain entirely. Coerce before comparing, never compare a level var to a literal on trust.
	local.d = float( level.rain_density )

	if( local.d >= 7 ){ end 3 }
	if( local.d >= 2 ){ end 2 }
	if( local.d > 0 ){ end 1 }
	end 0
}end 0

coop_weather_randomDriver:{
	//seed the walk from the map's authored intensity (bug-1280) instead of forcing calm
	local.cur = waitthread coop_weather_seedPattern
	level.weatherpattern = local.cur
	while( 1 ){
		local.r = randomfloat( 1 )
		//[2026-09-28] STORM DARKNESS (coop_mod/stormlight.scr, only while it runs): the storm's kind shapes the walk -
		//a LIGHT storm never builds past 2 (no downpour), a DARK one builds sooner (0.55) until it reaches 3. A storm
		//that reads dark is also the wetter one. Moderate, and every map with the feature off: today's 0.38.
		local.pb = 0.38
		if( level.coop_stormOn == 1 ){
			if( level.coop_stormKind == "light" && local.cur >= 2 ){ local.pb = 0 }
			if( level.coop_stormKind == "dark" && local.cur < 3 ){ local.pb = 0.55 }
			local.pb = waitthread coop_mod/stormlight.scr::coop_storm_holdPb local.cur local.pb	//[2026-09-28] variable storm length
		}
		//[2026-09-28 dust frequency] SAND maps (coop_mod/duststorm.scr coop_dust_walkBias, once its driver is armed):
		//each dust storm a kind - a FULL one builds straight to 3, a HAZE one never past 2. Rain and snow: untouched.
		if( level.coop_dustWalk == 1 ){ local.pb = waitthread coop_mod/duststorm.scr::coop_dust_walkBias local.cur local.pb }
		if( local.r < local.pb ){				// HZM coop - build 38% / ease 47% / hold 15% = slight DOWNWARD bias so
			local.cur = local.cur + 1		// storms clear more readily and dry spells come around more often (per
		} else {						// user "more dry spells"). Was 45/40/15 (upward-biased = leaned stormy).
			if( local.r < 0.85 ){
				local.cur = local.cur - 1	// ease
			}
			// else: hold this level
		}
		if( local.cur < 0 ){ local.cur = 0 }
		if( local.cur > 3 ){ local.cur = 3 }
		if( level.coop_stormOn == 1 ){ local.cur = waitthread coop_mod/stormlight.scr::coop_storm_holdFloor local.cur }	//[2026-09-28] variable storm length
		//[2026-09-28] STORM DARKNESS: CLOUDS BEFORE RAIN. Leaving a dry spell, the storm's kind is picked and its
		//clouds start rolling in 15-25 s before the rain pattern rises (stormlight.scr coop_storm_preroll).
		if( local.cur > 0 && level.weatherpattern == 0 && level.coop_stormOn == 1 ){
			waitthread coop_mod/stormlight.scr::coop_storm_preroll
		}
		level.weatherpattern = local.cur

		if( local.cur == 0 ){
			// DRY SPELL: the rain/snow has fully cleared - hold it clear for a good stretch (1-3 min)
			// before the next storm is allowed to build, so there are REAL dry periods, not just brief
			// lulls. (Live-tunable: coop_weatherDryMin/Max seconds.)
			local.dmin = waitthread coop_weather_cvar "coop_weatherDryMin" 60
			local.dmax = waitthread coop_weather_cvar "coop_weatherDryMax" 180
			if( level.coop_stormOn == 1 ){ local.dmin = waitthread coop_mod/stormlight.scr::coop_storm_respite local.dmin }	//[2026-09-28] a respite after a storm
			if( local.dmax < local.dmin ){ local.dmax = local.dmin }
			//[2026-09-28 dust frequency] sand maps hold shorter dry spells (coop_dustDry, AUTO 0.5) and note a full storm's
			//end for its cooldown (duststorm.scr coop_dust_dryScale)
			if( level.coop_dustWalk == 1 ){
				local.dsc = waitthread coop_mod/duststorm.scr::coop_dust_dryScale
				local.dmin = local.dmin * local.dsc
				local.dmax = local.dmax * local.dsc
			}
			wait ( local.dmin + randomfloat( local.dmax - local.dmin ) )
		} else {
			local.sw = 15 + randomfloat( 35 )		// hold 15-50s before the next shift
			if( level.coop_stormOn == 1 ){ local.sw = waitthread coop_mod/stormlight.scr::coop_storm_stepWait local.sw }	//[2026-09-28] variable storm length
			wait local.sw
		}
	}
}end

//=========================================================================
// COOP RAIN AMBIENCE - one level-wide looping rain hiss whose volume tracks storm intensity. The native
// weather.scr's own positional rain loops are gated SP-only (gametype 0), so coop gets this single
// position-independent emitter instead ("levelwide" loops ignore the emitter origin). We read the native's
// readable pattern value level.raindensity (0 calm .. ~10 downpour), NOT the write-only level.rain_density.
coop_weather_sound local.alias:{
	if( local.alias == NIL ){ local.alias = "coop_rain_ext" }
	if( level.coop_rainSndEnt == NULL ){
		level.coop_rainSndEnt = spawn script_model
		level.coop_rainSndEnt model "fx/dummy.tik"
		level.coop_rainSndEnt notsolid
	}
	local.maxvol = waitthread coop_weather_cvar "coop_rainVolume" 0.85

	//[user 2026-08-17] "when our weather system starts rain you still dont hear the rain drops".
	//Everything downstream checked out - coop_rain_loop.wav is a valid 22050/16-bit mono, it ships in
	//_assets_snd, the alias is registered, its maps list prefix-matches (bLoadForMap compares only
	//strlen(token) chars, so "m3" matches m3l3), and loopsound's third arg really does accept the
	//"levelwide" token. The one link that could not be observed live was level.raindensity, and the
	//WXSEED probe caught it NIL at the moment this thread starts.
	//
	//So stop GATING audio on it. level.weatherpattern is proven readable (WXSEED post-exec = 1) and
	//the theme already said "rain" or this thread would not be running. Density now only MODULATES
	//the volume; when it is missing we synthesise it from the pattern. A rain bed that goes silent
	//because a retail variable did not populate is a worse failure than one that is slightly loud.
	while( 1 ){
		//[MP, bug-2731 follow-up] Re-ensure the emitter each tick. In an MP arena the ent can be absent
		//(never spawned, or freed on a mode/round reset), and loopsound/stoploopsound on a NULL listener
		//throws a Script Error every 1.5s - which is what spammed the console on MP rain maps. Respawn if
		//gone, and GUARD every sound call so a NULL ent is a quiet no-op instead of an error.
		if( level.coop_rainSndEnt == NULL ){
			level.coop_rainSndEnt = spawn script_model
			level.coop_rainSndEnt model "fx/dummy.tik"
			level.coop_rainSndEnt notsolid
		}
		local.pat = level.weatherpattern
		if( local.pat == NIL ){ local.pat = 1 }
		local.rd = level.raindensity
		if( local.rd == NIL ){ local.rd = local.pat * 2.5 }
		if( local.rd < 0 ){ local.rd = 0 }
		local.dfrac = local.rd / 8.0
		if( local.dfrac > 1 ){ local.dfrac = 1 }
		//floor: while the rain pattern is up at all, the bed is audible. Only a pattern of 0 (dry)
		//silences it - not a density reading that never got driven.
		if( local.pat >= 1 && local.dfrac < 0.25 ){ local.dfrac = 0.25 }

		if( level.coop_rainSndEnt != NULL ){
			if( local.pat < 1 ){
				level.coop_rainSndEnt stoploopsound
			} else {
				local.vol = 0.4 + local.dfrac * local.maxvol	// HZM coop - higher floor so even light rain is clearly audible (was 0.1 = near-silent)
				if( local.vol > 1 ){ local.vol = 1 }
				//[2026-09-26, bug-2963] during a dust storm the storm's own wind (coop_snd_wind_strong, on each
				//player's sheet) leads: the map-wide sand bed drops to 50% at full strength. Seeded to 1.0 in
				//coop_weather_init before this thread starts; duststorm.scr drives it.
				if( local.alias == "coop_amb_wind" && level.coop_dustWindScale != NIL ){ local.vol = local.vol * level.coop_dustWindScale }
				// keep the levelwide emitter on a player so the loop is never stuck far away at world origin
				if( $player != NULL && $player[1] != NULL ){ level.coop_rainSndEnt.origin = $player[1].origin }
				level.coop_rainSndEnt loopsound local.alias local.vol "levelwide"
			}
		}
		wait 1.5
	}
}end

//=========================================================================
// LIGHTNING FLASH (per-client) - the coop-safe sky flash: a pale blue-white, top-weighted gradient drawn via
// ihuddraw (slot 60) for EVERY player, so remote clients see lightning too (the native r_fastsky / farplane
// flash only reaches the host over the network). Called once per strike from global/weather.scr::singlethunder.
// coop_dynWeatherLightning 0 = skip the flash (thunder sound only). Flicker: bright -> dim -> bright -> decay.
coop_weather_flash:{
	if( getcvar "coop_dynWeatherLightning" == "0" ){ end }
	//[2026-09-27 lightning QUICK FIX] coop_ltQuick 1: no screen-space sheet at all. It covered the top of the
	//screen for every player wherever they stood - indoors, under a roof, looking at the floor - which is the
	//user's 'lightning flashes on my screen inside buildings'. The fog lift (coop_lt_quickFog) is a configstring,
	//so every client already gets it; this overlay was never needed to reach remote players.
	local.lt = waitthread coop_lt_level
	if( local.lt >= 1 ){ end }
	local.slot = 60
	waitthread coop_weather_flash_setup local.slot
	waitthread coop_weather_flash_set   local.slot 0.75
	wait 0.04
	waitthread coop_weather_flash_set   local.slot 0.15
	wait 0.05
	waitthread coop_weather_flash_set   local.slot 0.65
	wait 0.04
	waitthread coop_weather_flash_set   local.slot 0.35
	wait 0.06
	waitthread coop_weather_flash_set   local.slot 0.12
	wait 0.07
	waitthread coop_weather_flash_set   local.slot 0
	//[2026-09-25, bug-2906] re-send that final 0: it is one snapshot, and a remote client that loses it
	//keeps a pale sky tint until the next strike. The next strike's setup claims the slot first, so a
	//late copy cannot cut a new flash short (coop_mod/hudresend.scr, TRAPS T8).
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){
			thread coop_mod/hudresend.scr::resend $player[local.i] local.slot local.slot 0
		}
		local.i++
	}
}end

//=========================================================================
// LIGHTNING QUICK FIX [2026-09-27] (docs/proposals/lightning_2026-09-27/diagnosis.md, plan.md section 1).
// Called by global/weather.scr flash (local.on 1) / unflash (0) when coop_ltQuick is "1" (coop/MP only).
// A flash LIFTS the fog colour a fraction k toward a cool white (0.86 0.90 1.0) instead of stamping (0.9 0.9 0.9).
// On these maps the sky on screen IS the fog colour, so this is the whole sky-and-far-field pulse.
// PHOTOSENSITIVITY (vet V4): k is capped so the fog colour's luminance rises by at most 0.07, and to 0.08 on a bright
// fog (bloom knee, below). Through the gl2 grade and bloom that keeps the sky's relative-luminance step at or under
// ~0.07 on every rain map's fog (m3l2 .63 through t1l1 .02, lookdev/out/quickfix_fog_table.json) - below WCAG
// 2.3.1's 0.1, so no pattern of pulses counts as flashing.
// HEADLIGHTS (vet V7): a fog under the cgame 'dark' threshold (luminance 0.3, cg_view.c) is never lifted past 0.29,
// so beams and flares do not blink off on every pulse.
//   coop_ltQuickLift  0.4 = requested k (0..1, 0 = no lift); the caps above always apply
//   coop_dynWeatherLightning 0 = no visual flash here either
// These are SERVER cvars: on a listen server they are the host's choice; a remote player cannot opt out here
// (plan.md: the per-player setting is v1's cg_hzmLightningMode).
// unflash restores level.farplane_color, which coop_mod/fogmode.scr keeps equal to a loaded fog profile (bug-1345).
coop_lt_quickFog local.on:{
	if( local.on != 1 ){
		if( level.farplane_color != NIL ){ $world farplane_color level.farplane_color }
		//a legacy flash (r_fastsky 1) caught by a mid-strike toggle of coop_ltQuick: clear it, and only then
		if( level.coop_ltLegacySky == 1 ){
			setcvar "r_fastsky" "0"
			level.coop_ltLegacySky = 0
		}
		end
	}
	if( getcvar( "coop_dynWeatherLightning" ) == "0" ){ end }
	local.c = level.farplane_color
	if( local.c == NIL ){ end }
	local.k = 0.4
	local.v = getcvar( "coop_ltQuickLift" )
	if( local.v != "" ){ local.k = float( local.v ) }
	if( local.k <= 0 ){ end }
	if( local.k > 1 ){ local.k = 1 }
	local.lf = 0.299 * local.c[0] + 0.587 * local.c[1] + 0.114 * local.c[2]
	local.span = 0.8994 - local.lf
	if( local.span <= 0.01 ){ end }
	local.kmax = 0.07 / local.span
	if( local.kmax < local.k ){ local.k = local.kmax }
	if( local.lf < 0.3 ){
		local.kdark = ( 0.29 - local.lf ) / local.span
		if( local.kdark < local.k ){ local.k = local.kdark }
	}
	//BLOOM KNEE: the shipped bloom ramps in over 0.52-0.72 on the brightest channel (r_ppBloomThreshold 0.62, knee
	//0.1), so a bright fog (m3l2 .63, m4l0, m5l3, t3l2) sits right in it and a small lift turns the whole sky's bloom
	//on - three times the step. Brightest channel over 0.40: k at most 0.08 (modelled worst sky step 0.069).
	local.mx = local.c[0]
	if( local.c[1] > local.mx ){ local.mx = local.c[1] }
	if( local.c[2] > local.mx ){ local.mx = local.c[2] }
	if( local.mx > 0.40 && local.k > 0.08 ){ local.k = 0.08 }
	if( local.k <= 0 ){ end }
	local.r = local.c[0] + local.k * ( 0.86 - local.c[0] )
	local.g = local.c[1] + local.k * ( 0.90 - local.c[1] )
	local.b = local.c[2] + local.k * ( 1.0 - local.c[2] )
	$world farplane_color ( local.r local.g local.b )
}end

//=========================================================================
// LIGHTNING LEVEL [2026-09-27] - the ONE place that decides how a strike is shown (plan.md section 10):
//   0 = today (retail fog stamp + r_fastsky + the slot-60 sheet)           SP always; coop/MP while nothing is set
//   1 = quick fix (no sheet, capped fog pulse)                              coop_ltQuick 1
//   2 = realistic (strike published for the lightning cgame + the quick-fix pulses as the fallback for clients that
//       cannot render it; they hide them)                                   coop_ltMode 2
// Server cvars, read per strike, never archived. Flipping the DEFAULT later is a change here only.
coop_lt_level:{
	if( level.gametype == NIL || level.gametype == 0 ){ end 0 }
	//[default flip] realistic is the default: an EMPTY coop_ltMode means 2. "0" forces today, "1" the quick fix.
	local.m = getcvar( "coop_ltMode" )
	if( local.m == "2" || local.m == "" ){ end 2 }
	if( local.m == "1" || getcvar( "coop_ltQuick" ) == "1" ){ end 1 }
	end 0
}end 0

//=========================================================================
// REALISTIC LIGHTNING v1 [2026-09-27] (docs/proposals/lightning_2026-09-27/plan.md 2.2). Called by global/weather.scr
// singlethunder under coop_ltMode 2. Picks ONE strike and hands it to game.dll through coop_ltStrike, which validates
// it and publishes it on configstring 28 for every client (fgame/g_main.cpp G_HzmLtPublish):
//   kind   70% intra-cloud 'i' (sheet lightning, no bolt), 30% cloud-to-ground 'c'
//   yaw    a storm cell that drifts 4 degrees a strike, strikes scattered 35 degrees either side of it
//   dist   1500-12000 m, as likely at every distance ACROSS THE AREA (max of two uniforms: p ~ d), user decision D4
//   n      strokes: 1-4 ('c') or broad pulses 1-3 ('i'); the client expands them from the seed
coop_lt_strike:{
	if( level.coop_ltCell == NIL ){ level.coop_ltCell = randomfloat( 360 ) }
	level.coop_ltCell = level.coop_ltCell + randomfloat( 8 ) - 4
	local.yaw = level.coop_ltCell + randomfloat( 70 ) - 35
	local.kind = "i"
	if( randomfloat( 1 ) < 0.3 ){ local.kind = "c" }
	local.u = randomfloat( 1 )
	local.u2 = randomfloat( 1 )
	if( local.u2 > local.u ){ local.u = local.u2 }
	local.dist = int( 1500 + 10500 * local.u )
	//TEST ONLY (coop_lt_testWatch below): a forced kind / yaw / distance for the next strike, then forgotten
	if( level.coop_ltTestKind != NIL ){
		local.kind = level.coop_ltTestKind
		level.coop_ltTestKind = NIL
		local.v = getcvar( "coop_ltTestYaw" )
		if( local.v != "" ){ local.yaw = float( local.v ) }
		local.v = getcvar( "coop_ltTestDist" )
		if( local.v != "" ){ local.dist = int( local.v ) }
	}
	if( local.kind == "c" ){
		local.n = randomint( 4 ) + 1
	} else {
		local.n = randomint( 3 ) + 1
	}
	local.seed = randomint( 999999 ) + 1
	local.s = local.kind + " " + int( local.yaw ) + " " + local.dist + " " + local.n + " " + local.seed
	setcvar "coop_ltStrike" local.s
}end

//=========================================================================
// LIGHTNING TEST HOOK [2026-09-27] (docs/proposals/lightning_2026-09-27/ab/lt_ab.py, the in-engine A/B). Started by
// coop_weather_init ONLY when coop_ltTestPoll is "1" when the map loads - never in a normal session. It switches the
// natural strikes off (level.thunder 0) so every strike in a capture is a requested one, then polls coop_ltTest every
// 0.1 s: "c" or "i" (a forced kind, with coop_ltTestYaw / coop_ltTestDist) or "1" (a random strike) starts one strike
// through the normal path (global/weather.scr singlethunder, the level selector, the latch) and clears the cvar.
coop_lt_testWatch:{
	while( 1 ){
		level.thunder = 0
		local.t = getcvar( "coop_ltTest" )
		if( local.t != "" ){
			setcvar "coop_ltTest" ""
			if( local.t == "c" || local.t == "i" ){ level.coop_ltTestKind = local.t }
			println( "^~^~^ LTTEST strike requested kind=" + local.t )
			thread global/weather.scr::singlethunder
		}
		wait 0.1
	}
}end

coop_weather_flash_setup local.slot:{
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){
			waitthread coop_mod/hudresend.scr::claim $player[local.i] local.slot local.slot
			// top-weighted SKY gradient over the upper ~2/3 of the screen, so it reads as the sky flashing.
			ihuddraw_shader $player[local.i] local.slot "textures/coop_skyflash.tga"
			ihuddraw_virtualsize $player[local.i] local.slot 1
			ihuddraw_rect $player[local.i] local.slot 0 0 640 360
			ihuddraw_color $player[local.i] local.slot 0.92 0.95 1.0	// pale blue-white
		}
		local.i++
	}
}end

coop_weather_flash_set local.slot local.a:{
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL ){
			ihuddraw_alpha $player[local.i] local.slot local.a
		}
		local.i++
	}
}end
