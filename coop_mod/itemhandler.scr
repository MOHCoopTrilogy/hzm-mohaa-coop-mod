//disable weapons on the weapon select menu
//=========================================================================
disableAllWeaponsOnMenu:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/disableAllWeaponsOnMenu->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	/*
	4194304 //rifle (1 << 22) 
	8388608 //sniper (1 << 23)
	16777216 //smg (1 << 24)
	33554432 //mg (1 << 25)
	67108864 //rocket (1 << 26)
	134217728 //shotgun (1 << 27)
	268435456 //landmine (1 << 28)
	*/
	setcvar dmflags 532676608
}end

//remove any start ammo that is added by the default tiki
//=========================================================================
removeAdditionalStartAmmo:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeAdditionalStartAmmo->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (self.classname != "Weapon" || !waitthread notStartGrenade self.model){ end }
	//the coop signal smoke is a one-off reward weapon, not a loadout pickup. Its pickup
	//must NOT run the start-ammo juggle below: that juggle touches the "grenade" ammo
	//pool and was stripping the player's German grenades (ammotype "grenade") the moment
	//they walked over the smoke.
	if (self.model == "models/weapons/coop_smoke_grenade.tik"){ end }
	if (self.flags["coop_removedStartAmmo"]){ end }

	self.flags["coop_removedStartAmmo"] = game.true
	
	self additionalstartammo "grenade" 6
	self additionalstartammo "smokegrenade" 6
	self additionalstartammo "grenade" (0 - 6)
	self additionalstartammo "smokegrenade" (0 - 6)
}end

//=========================================================================
// coop_ammoSnapshotLoop [user 07-09] - EXACT-AMMO RESPAWN (self = player)
// While the player is alive and NOT downed, continuously record the exact
// reserve ammo of every COMBAT ammo type so we can hand it straight back on
// respawn. Reward-item pools (binocstrike / smokegrenade) are deliberately
// left OUT - those items drop on death and must not respawn.
// Requires the HZM engine "getammo" event (game.dll 07-09+).
//=========================================================================
coop_ammoSnapshotLoop:{
//=========================================================================
	if( getcvar( "coop_exactAmmo" ) == "0" ){
		self.flags["coop_ammoSnapshotRunning"] = NIL
		end
	}

	local.types[1] = "pistol"
	local.types[2] = "rifle"
	local.types[3] = "smg"
	local.types[4] = "mg"
	local.types[5] = "heavy"
	local.types[6] = "grenade"
	local.types[7] = "shotgun"
	local.types[8] = "agrenade"
	local.types[9] = "landmine"

	while( self ){
		//only snapshot while upright and holding their own kit; while dead
		//(health<=0) or downed (dbno_pistol) the pools are not representative
		if( self.health > 0 && self.flags["coop_dbno_active"] != 1 && self.flags["coop_ammoRestorePending"] != 1 ){	//[user 07-19] bug-913: pending gate - a revive/respawn hands out DEFAULT ammo, and a snapshot tick in that window would clobber the down-moment values before coop_ammoRestore applies them
			local.i = 1
			while( local.i <= 9 ){
				local.type = local.types[local.i]
				local.key = "coop_ammoSaved_" + local.type
				self.flags[local.key] = self getammo local.type
				local.i++
			}
			//[user 08-02] IDLE-SPECTATE RESTORE: also snapshot the non-ammo state, because
			//Player::Spectator() destroys ALL of it in the engine before any script sees the
			//transition (it sets health = max_health and calls FreeInventory()). Snapshotting
			//here is the only way to have the values later.
			self.flags["coop_hpSaved"]      = self.health
			self.flags["coop_medkitsSaved"] = self.flags["coop_medkits"]
			self.flags["coop_coverSaved"]   = self.flags["coop_cover_placements"]
			self.flags["coop_ammoSaved_valid"] = 1
		}
		wait 0.5
	}
}end

//=========================================================================
// coop_ammoRestore [user 07-09] - EXACT-AMMO RESPAWN (self = player)
// Called on a RESPAWN after the inventory has been rebuilt. Waits for the
// async loadout-give (giveWeaponLoadout -> giveInventory) to finish handing
// out DEFAULT ammo, then overwrites each combat ammo pool with the exact
// amount the player was carrying when they went down. Uses the HZM engine
// "setammo" event (exact set; the stock "ammo" event only ADDs).
//=========================================================================
coop_ammoRestore:{
//=========================================================================
	//[user 2026-08-02] bug-1293 - CLEAR THE GUARD ON EVERY EXIT. The revive paths now raise
	//coop_ammoRestorePending BEFORE their takeall (so a snapshot tick cannot save the zeroed pools),
	//which means this function no longer owns the only place it is set - and both early exits below
	//used to return WITHOUT clearing it. Left set, the snapshot loop in coop_ammoSnapshot is gated
	//off permanently and the player's ammo is never saved again for the rest of the map. Clear first,
	//then re-raise for the duration of the restore itself.
	if( getcvar( "coop_exactAmmo" ) == "0" ){ self.flags["coop_ammoRestorePending"] = NIL; end }
	if( self.flags["coop_ammoSaved_valid"] != 1 ){ self.flags["coop_ammoRestorePending"] = NIL; end }
	self.flags["coop_ammoRestorePending"] = 1	//[user 07-19] bug-913: block snapshot ticks until the restore lands

	//let the async loadout-give finish setting default ammo first
	wait 0.5
	if( !self ){ end }
	if( self.health <= 0 ){ self.flags["coop_ammoRestorePending"] = NIL; end }

	local.types[1] = "pistol"
	local.types[2] = "rifle"
	local.types[3] = "smg"
	local.types[4] = "mg"
	local.types[5] = "heavy"
	local.types[6] = "grenade"
	local.types[7] = "shotgun"
	local.types[8] = "agrenade"
	local.types[9] = "landmine"

	local.i = 1
	while( local.i <= 9 ){
		local.type = local.types[local.i]
		local.key = "coop_ammoSaved_" + local.type
		if( self.flags[local.key] != NIL ){
			local.amount = self.flags[local.key]
			self setammo local.type local.amount
		}
		local.i++
	}
	self.flags["coop_ammoRestorePending"] = NIL	//[user 07-19] bug-913: restore applied - snapshotting may resume
}end

