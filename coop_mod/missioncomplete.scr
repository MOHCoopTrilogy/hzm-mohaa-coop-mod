//[200] chrissstrahl - 2020.06.14
//this is a coop specific mission complete file

//=========================================================================
main local.nextlevel local.bsp local.skipFade:{
//=========================================================================
if(level.cMTE_coop_missioncomplete){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread missioncomplete/main->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	//[user 2026-08-05] bug-1452 - COVERAGE SWEEP GUARD. The sweep force-fires every trigger in the
	//level, which inevitably includes the mission-end trigger: clients were being thrown to the
	//MISSION COMPLETE screen and the main menu mid-rotation (user-reported). Suppress the whole
	//end sequence while coop_maptest 3 is running - and log it, because "this map CAN reach
	//missioncomplete" is itself a completability datapoint worth having in the report.
	if( getcvar( "coop_maptest" ) == "3" ){
		println( "^~^~^ COV MISSIONCOMPLETE_SUPPRESSED " + level.coop_mapname + " -> " + local.nextlevel )
		end
	}

	//[200] Smithy - store the thread name
	local.threadName = "coop_mod/missioncomplete.scr::main"

	//[user 07-18 bug-818] IDEMPOTENT per map. This path is not re-entrant, but an end trigger touched by
	//two players the same frame (or a mission-end threaded twice) fires main() twice. Before bug-804 both
	//invocations ran the full ~coop_xpSummaryTime xp_summary, so the transition waited for the debrief.
	//After bug-804's xp_summary singleton (level.coop_xp_summaryRun) the SECOND main() finds the debrief
	//already running, xp_summary returns in the same frame, and this call races straight to bsptransition -
	//tearing the level down mid-debrief (user: "the rank up post level moves on too fast"). Guard so only the
	//FIRST completion runs the debrief AND the single transition; duplicates end here. level.* is wiped on
	//every map (game.dll reload on transition), so this flag can never leak into the next mission.
	if( level.coop_missionCompleteRan == 1 ){ end }
	level.coop_missionCompleteRan = 1
	//[dev] objectives selftest MCIDEM probe: only invocations that CLEAR the guard reach here,
	//so this prints exactly once for a legit double-fire. Inert unless coop_st_obj_mc==1.
	if( getcvar( "coop_st_obj_mc" ) == "1" ){ println( "^~^~^ ST_OBJECTIVES_MCIDEM pass=1" ) }

	//[200] chrissstrahl - set next map to be active map for dedicated server reboot
	if(level.coop_dedicated != 0){
		setcvar "ui_startmap" local.nextlevel
	}
	
	//chrissstrahl - stop watch for all players
	exec coop_mod/replace.scr::stopwatch 0

	//[200] Smithy - used to reload sv_maplist on next load
	//[200] Smithy - so our coop mission transition works
	setcvar "coop_prevMapList" (getcvar sv_maplist) 
	setcvar "sv_maplist" ""				
	
	//[200] Smithy - stop any further changes via main.scr::changeGameType if there are any
	level.coop_preventGameTypeChanges = game.true
	
	//[200] Smithy - stop the thread if one is running
	if (level.coop_changeGameTypeThread){  										
		thread coop_mod/main.scr::changeGameTypeDebug ("(" + local.threadName + "): Terminating " + level.coop_changeGameTypeThread.threadName + " thread for level change, and stopping any future calls.")
		level.coop_changeGameTypeThread end
	}

	//[303] HZM CHALLENGES - award per-map + total-missions (chapter/campaign) challenges to the team.
	//Threaded before the XP debrief so it runs during the debrief's blocking waits and persists to
	//the write-through cvar/save files BEFORE the level transition wipes state.
	thread coop_mod/challenges.scr::chal_mission_complete level.coop_mapname

	//[302] HZM XP - end-of-map debrief (awards mission/no-death/paratrooper bonuses, then the
	//animated XP card for ~coop_xpSummaryTime sec), then persist everyone. Card skipped for the
	//automated map tester; awards+flush always run.
	//[user 07-18 bug-788] BRIEFINGS + LOBBIES are not missions (bug-722 pattern): briefing1-6
	//route through missioncomplete to launch the NEXT map, so after the readygate all-ready skip
	//the full ~coop_xpSummaryTime (28s) rank-up card ran ON TOP of the briefing with the squad
	//frozen - and paid the mission/deathless/made-it awards (+225 XP for watching slides, log
	//07-18 12:00). All-ready on a briefing must advance with no debrief; the debrief still runs
	//at real mission end. xp_flush always runs.
	local.coop_skipDebrief = 0
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "briefing" 0 ){ local.coop_skipDebrief = 1 }
	if( level.coop_lobbyMap == 1 ){ local.coop_skipDebrief = 1 }
	if( (getcvar "coop_maptest") != "0" && (getcvar "coop_maptest") != "" ){ local.coop_skipDebrief = 1 }
	if( local.coop_skipDebrief == 0 ){
		waitthread coop_mod/xp.scr::xp_summary
	}
	waitthread coop_mod/xp.scr::xp_flush

	local.gametype = getcvar( "g_gametype" )
	setcvar "g_gametype" "0"
	
	game.loadout = false	
	bsptransition local.nextlevel local.skipFade
	
	setcvar "g_gametype" local.gametype
}end