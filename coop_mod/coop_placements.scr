	// Phase B: one shared waitframe so getmins/getmaxs become valid
	waitframe

	// Phase C: solidify with captured true bounds (race-proof; no hardcoded dims)
	local.i = 0
	while( local.i < local.bn ){
		local.e = local.bm[local.i]
		if( local.bsol[local.i] == 1 ){
			local.mn = local.e.getmins	//[user 07-19] bug-910: getmins is an EV_GETTER - property syntax required; command syntax parse-killed this WHOLE file (unknown command) on every map
			local.mx = local.e.getmaxs
			local.mn = local.mn * local.bscl[local.i]
			local.mx = local.mx * local.bscl[local.i]
			local.e solid
			if( local.mx[2] - local.mn[2] > 0 ){ local.e setsize local.mn local.mx }
		}
		else{ local.e notsolid }
		local.i++
	}
}end

