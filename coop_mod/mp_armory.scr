//=========================================================================
// MP_ARMORY.SCR - the shared MP armory dispatcher (slice 2, LIVE).
//
// [2026-09-13] Slice 1 shipped the two MP armory SCREENS, their cfg trees and the side rosters
// (coop_mod/mpa_roster.scr, coop_mod/mpx_roster.scr), all generated by docs/tools/gen_mp_armory.py.
// Slice 2 (this file) is the LIVE dispatcher: the name-bus poll, unlock/ban validation, the
// spawn-edge kit give, the 25s auto-deploy timer and the bot branch. It is driven by coop_mod/mp.scr,
// which owns the per-player poll and the team/alive edges (see mp.scr header).
//
// Isolation: this is an MP file (coop_mod/mp*.scr is in MP_MANIFEST). It calls only the allowlisted
// coop helper coop_mod/player.scr::playerCleanName (clause 10), never sets flags["coop_isHost"]
// (clause 9), and names no coop armory cvar or tree. Every server->client shape it emits is admitted
// by the SHIPPED stufftext filter with no new grammar entry: `set coop_mp*` (cmd_filter.c coop_ set
// prefix) and the E5 `exec ui/coop_mp*` open (cmd_filter.c ui/coop_ exec prefix). The ,q name-bus
// markers are CLIENT-origin (the tile-click cfgs append them); the server never appends a ,q marker.
//
// Guarded on level.coop_mpRun, which ONLY coop_mod/mp.scr sets (mp.scr) and which a level load wipes,
// so nothing here can run on a coop map. mp.scr also probes ::alive first and falls back to the stock
// rifle deploy if this file parse-kills (TRAPS T1), so a bad token here strands nobody in spectate.
//=========================================================================

//Inert entry. mp.scr calls the specific labels below, not main. Kept so an accidental exec is a no-op.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end

//The dispatcher liveness probe. A parse killer in this file makes ::alive unreachable and mp.scr's
//liveness check falls back to the stock rifle deploy instead of stranding players in spectate. Returns
//literal 1 today.
alive:{
	end 1
}end

//MP NAME-BUS TOKEN FAMILIES. Grammar ,q<side><field><data>: side a|x, field 1 primary / 2 sidearm /
//3 grenade / d deploy (no data). These string literals are the registry docs/tools/ui_wiring_audit.py
//reads to prove that every ,q marker the armory cfgs append is accounted for HERE, not in
//variables.scr / player.scr (isolation clause 7 keeps MP tokens out of coop). Not called at runtime -
//it is a data table the audit parses; the live scanner in ::readMarkers implements the same grammar.
mp_bus_families:{
	local.f[0] = ",qa1"
	local.f[1] = ",qa2"
	local.f[2] = ",qa3"
	local.f[3] = ",qad"
	local.f[4] = ",qx1"
	local.f[5] = ",qx2"
	local.f[6] = ",qx3"
	local.f[7] = ",qxd"
	//[MP cosmetics] k = skin, h = helmet, v = glove (per side). data = the roster id (glove 0-6).
	local.f[8] = ",qak"
	local.f[9] = ",qah"
	local.f[10] = ",qav"
	local.f[11] = ",qxk"
	local.f[12] = ",qxh"
	local.f[13] = ",qxv"
	//[MP challenges] f = weapon finish (per side). data = the finish index 0-7 (0 clears; 1-7 map to
	//gold/chrome/blued/bloody/camo_woodland/camo_winter/camo_desert), validated against the fin:<finish>
	//challenge unlock and applied at spawn by mp_finish_map.scr.
	local.f[14] = ",qaf"
	local.f[15] = ",qxf"
}end local.f


//=========================================================================
// TEAM FLIP - a spectator just joined a side. The E5 engine redirect has already opened the side
// armory on the client (UserSelectWeapon -> exec ui/coop_mp<side>_armory/open.cfg). Here we just mark
// the fresh life as owing a kit choice, clear last life's picks, and arm the 25s auto-deploy timer.
// Bots never see a screen or a timer - their kit is rolled fresh on the spawn edge (::giveKit).
//=========================================================================
onTeamFlip local.p:{
	if( local.p == NULL ){ end }

	//[slice 5] load this player's persisted progression so their armory unlocks (coop_mpUnlockC_*) are
	//current BEFORE they pick - ensureLoaded is idempotent (once per session), so this is a no-op after
	//the first join. A returning player thus sees earned weapons unlocked on their very first armory open.
	waitthread coop_mod/mp_progression.scr::ensureLoaded local.p
	if( local.p == NULL ){ end }

	local.p.flags["coop_mp_K1"] = NIL
	local.p.flags["coop_mp_K2"] = NIL
	local.p.flags["coop_mp_K3"] = NIL
	local.p.flags["coop_mp_deploy"] = NIL

	//[bug-2767] DISARM the userinfo DEPLOY flag for this fresh life, so a "1" left over from last life's DONE
	//(if the consume-clear was dropped) cannot instant-deploy the player before they get to pick. Stamp the
	//hold-start time; tickPlayer ignores the userinfo flag for the first ~0.6s so this clear has time to land.
	local.sideF = waitthread sideOf local.p
	local.p stufftext ( "seta coop_mp" + local.sideF + "_K6 0\n" )
	//[user 2026-09-21] HOST: clear the shared server-side cvar DIRECTLY too. open.cfg no longer clears K6 on
	//re-open (it was eating just-pressed DONEs), so this per-life clear is now the authoritative one for the
	//host - and a direct setcvar has zero propagation lag, unlike the stufftext above, so no stale K6=1 from
	//last life can leak past the holdSince guard on the listen host.
	if( local.p.entnum == 0 && getcvar( "dedicated" ) == "0" ){ setcvar ( "coop_mp" + local.sideF + "_K6" ) "0" }
	local.p.flags["coop_mp_holdSince"] = level.time

	local.bot = isBot( local.p )
	if( local.bot == 1 ){
		local.p.flags["coop_mp_hold"] = 0
		end
	}

	local.p.flags["coop_mp_hold"] = 1
	local.p.flags["coop_mp_cause"] = "idle"
	local.p.flags["coop_mp_deadline"] = ( level.time + 8 )
}end


//=========================================================================
// PER-TICK (called every 0.5s poll from mp.scr::mp_tickPlayer while this file is live). Reads every ,q
// marker in the player's name in order, validates + commits them, cleans the name, and - only while the
// player is HOLDING in the armory - re-arms the timer on activity and deploys on the DEPLOY marker or
// on the 25s timeout.
//=========================================================================
tickPlayer local.p:{
	if( local.p == NULL ){ end }

	local.had = waitthread readMarkers local.p
	if( local.p == NULL ){ end }

	if( local.p.flags["coop_mp_hold"] != 1 ){ end }

	//[bug-2767] DEPLOY via the USERINFO flag (coop_mp<side>_k6), the reliable path. The DONE button setas it
	//to 1; the name-bus ,q<side>d marker it also appends is lost to truncation when the name is full (bug-2759)
	//and the host name cannot be cleaned, so this userinfo read is what actually lets a player spawn. Ignore it
	//for the first ~0.6s of the hold so a not-yet-cleared stale 1 from last life (onTeamFlip's disarm) cannot
	//instant-deploy. On the edge, set the same coop_mp_deploy flag the name-bus path sets and consume (clear) it.
	local.hs = local.p.flags["coop_mp_holdSince"]
	if( local.hs != NIL && ( level.time - local.hs ) > 0.3 ){
		local.sideG = waitthread sideOf local.p
		local.go = info_valueforkey local.p.userinfo ( "coop_mp" + local.sideG + "_k6" )
		//[bug-2808] LISTEN-HOST DONE FIX. THE ACTUAL ROOT CAUSE of "hit Done 5 times": on a listen server the
		//HOST's userinfo (where K6 lives) reaches the server LATE, so most DONE presses were invisible to this
		//poll (the log showed one k6seen for five presses). The host client shares the server PROCESS, so its
		//K6 cvar is directly readable here with getcvar - instant, no userinfo round-trip. Do that for the
		//listen host only (entnum 0 on a non-dedicated server); a REMOTE client's cvar is not in the server's
		//cvar space, so it must keep the userinfo path.
		if( local.go != "1" && local.p.entnum == 0 && getcvar( "dedicated" ) == "0" ){
			local.go = getcvar( "coop_mp" + local.sideG + "_K6" )
		}
		//[user 2026-09-21] per-tick DEPLOY-PATH TRACE (set coop_mpDeployDebug 1 to enable). Prints, every 0.5s
		//poll while a player holds in the armory, the hold state and BOTH deploy reads (userinfo k6 + the host's
		//direct getcvar K6), so a playtest log shows exactly whether a DONE press was seen and by which path -
		//rather than inferring it from the single k6seen edge line. Off by default (empty getcvar != "1").
		if( getcvar( "coop_mpDeployDebug" ) == "1" ){
			local.uiK6 = info_valueforkey local.p.userinfo ( "coop_mp" + local.sideG + "_k6" )
			local.cvK6 = ""
			if( local.p.entnum == 0 && getcvar( "dedicated" ) == "0" ){ local.cvK6 = getcvar( "coop_mp" + local.sideG + "_K6" ) }
			local.hld = local.p.flags["coop_mp_hold"]
			local.held = ( level.time - local.hs )
			println( "^~^~^ MPHOLD e" + local.p.entnum + " side=" + local.sideG + " hold=" + local.hld + " held=" + local.held + " uiK6=" + local.uiK6 + " cvK6=" + local.cvK6 + " go=" + local.go )
		}
		if( local.go == "1" ){
			local.p.flags["coop_mp_deploy"] = 1
			local.p stufftext ( "seta coop_mp" + local.sideG + "_K6 0\n" )
			//host: clear the shared server-side cvar directly too, so a lagged userinfo can't re-trigger.
			if( local.p.entnum == 0 && getcvar( "dedicated" ) == "0" ){ setcvar ( "coop_mp" + local.sideG + "_K6" ) "0" }
			println( "^~^~^ MPDEPLOY k6seen e" + local.p.entnum + " side=" + local.sideG )
		}
	}

	//EXPLICIT DEPLOY (the DONE button). This is THE intended trigger - you take all the time you need in
	//the armory and spawn the instant you hit DONE. It is now reliable: readMarkers resets the client name
	//to a clean base each tick, so the appended DONE marker (,q<side>d) can no longer be truncated off a
	//name that had silently accumulated markers (the old "spam Done" bug). No auto-deploy races you.
	if( local.p.flags["coop_mp_deploy"] == 1 ){
		waitthread deploy local.p "done"
		end
	}

	//[user 2026-09-18] NO auto-deploy by default. The armory must give unlimited time; DONE is the only
	//trigger. A host MAY set coop_mpArmoryIdleSecs > 0 (seconds of inactivity) as a safety to free an AFK
	//spectator slot on a busy server; default 0 = disabled, so nothing ever deploys you before you ask.
	local.idle = int( getcvar( "coop_mpArmoryIdleSecs" ) )
	if( local.idle <= 0 ){ end }
	if( local.had == 1 ){
		local.p.flags["coop_mp_deadline"] = ( level.time + local.idle )
	}
	local.dl = local.p.flags["coop_mp_deadline"]
	if( local.dl != NIL && level.time > local.dl ){
		waitthread deploy local.p "idle"
	}
}end


//=========================================================================
// Read every ,q<side><field><data> marker in the name, in order (never coop's lowest-index-wins rule),
// validate and commit each, then clean the name so it is not reprocessed and the scoreboard stays clean.
// Returns 1 if any ,q marker was present.
//=========================================================================
readMarkers local.p:{
	if( local.p == NULL ){ end 0 }
	local.name = local.p.netname
	if( local.name == NIL ){ end 0 }
	local.n = local.name.size
	if( local.n < 4 ){ end 0 }

	//[bug-2767] process each DISTINCT name once. If the host name cannot be cleaned (the set-name reset does
	//not take on a listen host), the same stale markers would be re-parsed and re-logged every 0.5s tick -
	//the MPTOK console spam the user saw. Deploy no longer rides the name bus (it is a userinfo flag now), so
	//skipping an unchanged name is safe; a fresh pick changes the name and is processed on the next tick.
	if( local.name == local.p.flags["coop_mp_nameSeen"] ){ end 0 }

	local.found = 0
	local.firstMarker = 0 - 1
	local.i = 0
	while( local.i < ( local.n - 1 ) ){
		//[bug-2759b] a ",q" is only a marker when the NEXT char is a real side letter (a/x). Without this a
		//player whose name legitimately contains ",q" (e.g. "Jack,quimby", "Sgt,quik") had everything from that
		//point stripped and was permanently renamed to the prefix. Requiring the side letter makes a false match
		//impossible for any real marker (which is always ,qa.. or ,qx..).
		if( local.name[local.i] == "," && local.name[local.i + 1] == "q" && ( local.i + 2 ) < local.n && ( local.name[local.i + 2] == "a" || local.name[local.i + 2] == "x" ) ){
			local.found = 1
			if( local.firstMarker < 0 ){ local.firstMarker = local.i }
			local.side = ""
			if( ( local.i + 2 ) < local.n ){ local.side = local.name[local.i + 2] }
			local.field = ""
			if( ( local.i + 3 ) < local.n ){ local.field = local.name[local.i + 3] }
			local.data = ""
			local.j = ( local.i + 4 )
			while( local.j < local.n ){
				local.ch = local.name[local.j]
				local.dig = waitthread isDigit local.ch
				if( local.dig == 1 ){
					local.data = ( local.data + local.ch )
					local.j++
				} else {
					local.j = local.n
				}
			}
			waitthread applyMarker local.p local.side local.field local.data
			if( local.p == NULL ){ end local.found }
			local.i = ( local.i + 4 )
		} else {
			local.i++
		}
	}

	//[user 2026-09-18] RESET THE CLIENT NAME to the base name (everything before the first ,q) so the
	//appended armory markers cannot ACCUMULATE on the client. The old path used playerCleanName, which only
	//strips coop's " ," (space-comma) markers - NOT the MP ",q" markers - so it returned the name unchanged,
	//the reset never fired, and every armory click grew the client name until it hit the length cap and
	//TRUNCATED the tail. The last-appended marker (DONE, ,q<side>d) fell off the end, which is exactly why
	//players had to "spam Done and re-equip several times". Quoted set (player names may contain spaces).
	//[bug-2759] ALWAYS reset the client name to its clean base whenever ANY marker is present, and REMEMBER
	//that base. Old guard (firstMarker > 0) skipped the reset when the name STARTED with a marker or the base
	//was empty, so stale/cross-side markers (e.g. a leftover ,qad after switching to axis) ACCUMULATED and
	//pushed the newest marker - the DONE ,q<side>d - past the 32-char name cap, where it truncated. That is
	//THE axis-can't-spawn root cause (deploy marker lost -> coop_mp_deploy never set -> no giveKit -> armory
	//re-opens). Now: capture the base while marker-free; when markers appear, strip to the base every tick and
	//fall back to the remembered base (or "Soldier") if the whole name was markers, so the name can never grow.
	if( local.found == 0 ){
		if( local.name != "" ){ local.p.flags["coop_mpBaseName"] = local.name }
	} else {
		local.clean = ""
		local.k = 0
		while( local.k < local.firstMarker ){
			local.clean = ( local.clean + local.name[local.k] )
			local.k++
		}
		//trim one trailing space that 'append name' inserted ahead of the first marker
		local.cn = local.clean.size
		if( local.cn > 0 && local.clean[local.cn - 1] == " " ){
			local.trim = ""
			local.k = 0
			while( local.k < ( local.cn - 1 ) ){
				local.trim = ( local.trim + local.clean[local.k] )
				local.k++
			}
			local.clean = local.trim
		}
		if( local.clean == "" ){
			//name was all-markers (or truncated to nothing) - restore the remembered base so we never strand
			//a bare/marker-only name (which the old code left alone, letting markers pile up forever).
			local.clean = local.p.flags["coop_mpBaseName"]
			if( local.clean == NIL || local.clean == "" ){ local.clean = "Soldier" }
		} else {
			local.p.flags["coop_mpBaseName"] = local.clean
		}
		if( local.p != NULL ){
			local.p stufftext ( "set name \"" + local.clean + "\"\n" )
		}
	}
	//[bug-2767] remember the name we just processed so an unchanged name (reset didn't take, or no markers) is
	//skipped next tick - no re-parse, no MPTOK spam. A real pick changes the name and re-arms processing.
	if( local.p != NULL ){ local.p.flags["coop_mp_nameSeen"] = local.name }
}end local.found


//=========================================================================
// Validate and commit ONE marker. Server-authoritative: the side must match the player's team, the mpid
// must be in that side's roster and slot-legal for the field, and (interim, this slice) only P1 free
// STARTERS are unlocked; everything else is denied.
//=========================================================================
applyMarker local.p local.side local.field local.data:{
	if( local.p == NULL ){ end }

	local.myside = waitthread sideOf local.p
	if( local.side != local.myside ){ end }

	//DEPLOY marker (,q<s>d): no data
	if( local.field == "d" ){
		local.p.flags["coop_mp_deploy"] = 1
		end
	}

	if( local.data == "" ){ end }

	//[MP cosmetics] k=skin, h=helmet, v=glove. Validated against the side roster; stored as the tik/stem
	//in coop_mp_SKIN/HELM/GLOVE, applied at spawn by mp_cosmetics.scr::apply. Cosmetics are free in this
	//slice (challenge-gating is the later step); the chip name is refreshed so the player sees the pick.
	//cosmetics are EARNED: the server refuses a pick the player has not unlocked (cosUnlocked reads the
	//carried progression total). A locked pick simply does not commit; the appearance panel still lets
	//them preview it. Free (need 0) options always pass.
	if( local.field == "k" || local.field == "h" || local.field == "v" ){
		local.cu = waitthread coop_mod/mp_cosmetics.scr::cosUnlocked local.p local.field local.data
		if( local.cu != 1 ){
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + local.field + local.data + " deny locked cosmetic" )
			end
		}
	}
	if( local.field == "k" ){
		local.rs = waitthread coop_mod/mp_cosmetics.scr::skinGet local.side local.data
		if( local.rs != NIL && local.rs["stem"] != "" ){
			local.p.flags["coop_mp_SKIN"] = local.rs["stem"]
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + "k" + local.data + " skin=" + local.rs["stem"] )
		}
		end
	}
	if( local.field == "h" ){
		local.rh = waitthread coop_mod/mp_cosmetics.scr::helmGet local.side local.data   // [bug-2761] helmGet is side-split (side,id); the missing side made every name-bus helmet pick resolve to "" (dropped)
		if( local.rh != NIL ){
			local.p.flags["coop_mp_HELM"] = local.rh["tik"]
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + "h" + local.data + " helm=" + local.rh["tik"] )
		}
		end
	}
	if( local.field == "v" ){
		local.gi = int( local.data )
		if( local.gi >= 0 && local.gi <= 6 ){
			local.p.flags["coop_mp_GLOVE"] = local.gi
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + "v" + local.data + " glove=" + local.gi )
		}
		end
	}
	//[MP CHALLENGES] WEAPON FINISH pick (field "f", data = finish name, "none" clears). Server-authoritative:
	//a finish is accepted only if its fin:<finish> challenge is complete. Stored in coop_mpFinSel; applied at
	//spawn by mp_finish_map.scr::resolve (base -> variant model).
	if( local.field == "f" ){
		local.fi = int( local.data )
		if( local.fi == 0 ){
			local.p.flags["coop_mpFinSel"] = ""
			println( "^~^~^ MPTOK e" + local.p.entnum + " finish=none" )
			end
		}
		local.fn = ""
		switch( local.fi ){
			case 1: local.fn = "gold"; break
			case 2: local.fn = "chrome"; break
			case 3: local.fn = "blued"; break
			case 4: local.fn = "bloody"; break
			case 5: local.fn = "camo_woodland"; break
			case 6: local.fn = "camo_winter"; break
			case 7: local.fn = "camo_desert"; break
		}
		if( local.fn == "" ){ end }
		local.fu = waitthread coop_mod/mp_challenges.scr::finUnlocked local.p local.fn   // [bug-2765] challenge OR career-kill fallback
		if( local.fu != 1 ){
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + "f" + local.data + " deny locked finish" )
			end
		}
		local.p.flags["coop_mpFinSel"] = local.fn
		println( "^~^~^ MPTOK e" + local.p.entnum + " finish=" + local.fn )
		end
	}

	if( local.field != "1" && local.field != "2" && local.field != "3" ){ end }

	local.r = waitthread rosterGet local.side local.data
	if( local.r == NIL ){ end }
	local.give = local.r["give"]
	if( local.give == NIL || local.give == "" ){ end }

	local.wantSlot = "p"
	if( local.field == "2" ){ local.wantSlot = "s" }
	if( local.field == "3" ){ local.wantSlot = "g" }
	if( local.r["slot"] != local.wantSlot ){ end }

	//[preset slice 2, M3/M5] a PRIMARY whose weapon class the active preset masks out is refused at pick
	//time too. The deploy path (resolvePrimary -> classBanned) would degrade it to an allowed starter
	//anyway, but denying here keeps the committed chip honest and never shows a banned gun as selected.
	//Sidearms (field 2) and grenades (field 3) are NEVER preset-masked (M4), so only field "1" is checked.
	if( local.field == "1" ){
		local.pmb = waitthread presetBansClass local.r["dmclass"]
		if( local.pmb == 1 ){
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + local.field + local.data + " deny preset" )
			end
		}
	}

	//UNLOCK (slice 5): a free STARTER is always allowed; a non-starter needs its weapon CLASS unlocked by
	//progression. mp_progression.scr::applyUnlocks sets coop_mpUnlockC_<class> on the player from their
	//persisted counters; the server is authoritative, so a client that faked the UI cvar still lands here
	//and is denied. ensureLoaded ran on the team-flip edge, so the flags are current.
	if( local.r["starter"] != 1 ){
		//[MP CHALLENGES] a non-starter weapon is unlocked by its own per-class-tier CHALLENGE
		//(wt:<class>:<tier>), not the whole class at once. mp_challenges.scr::isUnlocked reads the
		//player's derived challenge unlock store (self.flags["coop_mpUnlocks"], set by mp_progression's
		//applyUnlocks->derive). Server is authoritative - a faked UI cvar still lands here and is denied.
		local.cls = local.r["class"]
		local.tok = ( "wt:" + local.cls + ":" + local.r["tier"] )
		local.unlocked = waitthread coop_mod/mp_challenges.scr::isUnlocked local.p local.tok
		if( local.unlocked != 1 ){
			println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + local.field + local.data + " deny locked " + local.tok )
			end
		}
	}

	if( local.field == "1" ){ local.p.flags["coop_mp_K1"] = local.data }
	if( local.field == "2" ){ local.p.flags["coop_mp_K2"] = local.data }
	if( local.field == "3" ){ local.p.flags["coop_mp_K3"] = local.data }
	println( "^~^~^ MPTOK e" + local.p.entnum + " ,q" + local.side + local.field + local.data + " ok" )

	//refresh the chip name for the picked slot (set coop_mp<side>_N<field> - shipped-filter admitted)
	waitthread pushChipName local.p local.side local.field local.r["name"]
}end


//=========================================================================
// DEPLOY - resolve the primary's class (degraded to a legal class against dmflags), set it, and let the
// engine self-deploy (EndSpectator + Respawn, player.cpp EventPrimaryDMWeapon). The spawn edge that
// follows fires mp.scr::mp_onSpawn -> ::giveKit, which hands out the actual tiks and health 100.
//=========================================================================
deploy local.p local.cause:{
	if( local.p == NULL ){ end }

	local.p.flags["coop_mp_hold"] = 0
	local.p.flags["coop_mp_deploy"] = NIL
	local.p.flags["coop_mp_cause"] = local.cause

	//[bug-2767 vet-F2] CONSUME the userinfo deploy flag on EVERY deploy path (name-bus or userinfo), so an
	//archived coop_mp<side>_K6 == 1 can never survive to auto-deploy the next life. Cleared client-side in
	//open.cfg too (belt+braces against the propagation lag onTeamFlip's clear has on a remote client).
	local.sideD = waitthread sideOf local.p
	if( local.p == NULL ){ end }
	local.p stufftext ( "seta coop_mp" + local.sideD + "_K6 0\n" )

	//[bug-2784] SEED the SAVED kit from userinfo BEFORE resolving the primary, so hitting DONE deploys your
	//saved loadout even with NO fresh pick this life. Without this, resolvePrimary read the kit flags that
	//manageSetup reset to NIL at armory entry - so DONE alone could not resolve a class and you could not spawn
	//until you re-picked a weapon (which seeded K1 via the name-bus). giveKit re-seeds at the spawn edge too;
	//this makes the deploy-time primarydmweapon class resolve from your saved default.
	waitthread seedKitFromUserinfo local.p
	if( local.p == NULL ){ end }

	local.res = waitthread resolvePrimary local.p
	local.cls = local.res[1]

	println( "^~^~^ MPDEPLOY e" + local.p.entnum + " cause=" + local.cause + " class=" + local.cls )

	//[bug-2789/2804] RETRY the spawn. The FIRST primarydmweapon right after join_team is frequently IGNORED
	//(the client is not yet in a spawnable state), which dropped the player back to SPECTATOR and forced a
	//SECOND (and sometimes third) DONE. [user 2026-09-21] The old loop gave up after 6 tries / ~3s and set
	//coop_mp_hold=0, stranding a client that needed longer to become spawnable - so the player had to reopen
	//the armory and hit DONE again. Now it is PERSISTENT: keep re-issuing over ~10s, escalate to "auto" (a
	//random ALLOWED class that self-deploys and can never be refused) after just 2 tries, and STOP the instant
	//the player is alive - so ONE DONE reliably spawns you. Only a genuine spectator/gametype/disconnect ends it.
	local.tries = 0
	while( local.tries < 20 ){
		if( local.p == NULL ){ end }
		if( local.p.dmteam == "spectator" ){ end }   // genuine spectator choice - do not force-spawn
		if( level.gametype != 2 ){ end }
		if( local.p.isSpectator == 0 ){ end }         // spawned OK - done
		//[user 2026-09-21] per-try TRACE (set coop_mpDeployDebug 1). Shows whether the FIRST DONE reached deploy
		//and how many primarydmweapon tries it took to actually leave spectate - so a "had to hit Done twice"
		//report resolves to either "first press was never seen" (no MPDEPLOY at all) or "seen but slow to spawn".
		if( getcvar( "coop_mpDeployDebug" ) == "1" ){
			println( "^~^~^ MPDEPLOYTRY e" + local.p.entnum + " try=" + local.tries + " spec=" + local.p.isSpectator + " cls=" + local.cls )
		}
		if( local.tries < 2 ){ local.p primarydmweapon local.cls }
		else{ local.p primarydmweapon "auto" }
		local.tries = ( local.tries + 1 )
		wait 0.5
	}
	//if we fell out of the loop still un-spawned, say so (the client never became spawnable in 10s) - a rare
	//tail the user can report with this line, rather than silently stranding them.
	if( local.p != NULL && local.p.isSpectator != 0 ){
		println( "^~^~^ MPDEPLOY GAVEUP e" + local.p.entnum + " still spectator after 20 tries cause=" + local.cause )
	}
}end


//=========================================================================
// SPAWN EDGE - the give. Called from mp.scr::mp_onSpawn for a freshly-alive MP player. Humans get the
// committed kit (gaps filled with the free starters); bots get a random free-tier primary. Never
// giveInventory / changeGameType (mp.scr header) and never the coop_health cvar (clause 4).
//=========================================================================
giveKit local.p:{
	if( local.p == NULL ){ end }

	local.side = waitthread sideOf local.p
	local.bot = isBot( local.p )

	if( local.bot == 1 ){
		local.cause = "bot"
		local.cls = waitthread botRollClass
		//[user 2026-09-18] per-server BOT weapon lock (host cvar coop_mpBotWeapon). Empty = today's random
		//botRollClass. A class name ("rifle" = bolt-action, "sniper", "smg"...) forces that class; the special
		//value "riflesniper" alternates bolt-action rifle and sniper so a marksman server (the Stalingrad
		//Rifle-Only server) fields a bolt/sniper bot mix instead of random SMGs/MGs. Humans are unaffected
		//(their loadout comes from the armory preset); this only rewrites the bot's rolled class.
		local.bw = getcvar( "coop_mpBotWeapon" )
		if( local.bw != "" ){
			if( local.bw == "riflesniper" ){
				local.cls = "rifle"
				if( level.coop_mpBotWpnAlt == 1 ){ local.cls = "sniper"; level.coop_mpBotWpnAlt = 0 }
				else{ level.coop_mpBotWpnAlt = 1 }
			}
			else{ local.cls = local.bw }
		}
		local.pid = waitthread starterFor local.side local.cls
		local.sid = waitthread starterFor local.side "pistol"
		local.gid = waitthread starterFor local.side "nades"
	} else {
		local.cause = local.p.flags["coop_mp_cause"]
		if( local.cause == NIL ){ local.cause = "done" }
		//[bug-2767 / kit persistence] fill any kit slot the name-bus did not set this life from the carried
		//USERINFO kit (the reliable, truncation-proof source the armory + defaults screen both seta). Fresh
		//in-match picks still win; this only supplies empties (defaults-screen picks, cross-server memory, or
		//a marker that truncated off a full name). Legality is still enforced below by rosterGet/resolvePrimary.
		waitthread seedKitFromUserinfo local.p
		if( local.p == NULL ){ end }
		waitthread seedFinishFromUserinfo local.p   // [bug-2775] persist the picked weapon finish across sessions
		if( local.p == NULL ){ end }
		local.res = waitthread resolvePrimary local.p
		local.pid = local.res[0]
		local.sid = local.p.flags["coop_mp_K2"]
		if( local.sid == NIL || local.sid == "" ){ local.sid = waitthread starterFor local.side "pistol" }
		local.gid = local.p.flags["coop_mp_K3"]
		if( local.gid == NIL || local.gid == "" ){ local.gid = waitthread starterFor local.side "nades" }
	}

	local.rp = waitthread rosterGet local.side local.pid
	local.rs = waitthread rosterGet local.side local.sid
	local.rg = waitthread rosterGet local.side local.gid

	local.pgive = ""
	if( local.rp != NIL && local.rp["give"] != NIL ){ local.pgive = local.rp["give"] }
	//[user 2026-09-18] BOLT-ONLY server (coop_mpBoltOnly 1): degrade any semi-auto / semi-auto-scoped primary
	//to the side's bolt-action equivalent. The rifle/sniper dmclasses still contain the Garand, Carbine, SVT,
	//G43 and the scoped Garand / G43 sniper - all self-loading - so a class-level (dmflags) gate cannot exclude
	//them; this per-weapon degrade at the single give chokepoint does, for humans AND bots.
	if( getcvar( "coop_mpBoltOnly" ) == "1" && local.pgive != "" ){ local.pgive = waitthread boltize local.pgive }
	local.sgive = ""
	if( local.rs != NIL && local.rs["give"] != NIL ){ local.sgive = local.rs["give"] }
	local.ggive = ""
	if( local.rg != NIL && local.rg["give"] != NIL ){ local.ggive = local.rg["give"] }

	//[MP CHALLENGES] apply an earned + picked weapon FINISH: swap the primary/sidearm base tik for its
	//variant model when the player has completed the fin:<finish> challenge and picked it (userinfo
	//coop_mpFinPick). resolve() returns the base unchanged otherwise, so this is a no-op without a finish.
	if( local.pgive != "" ){ local.pgive = waitthread coop_mod/mp_finish_map.scr::resolve local.p local.pgive }
	if( local.p == NULL ){ end }
	if( local.sgive != "" ){ local.sgive = waitthread coop_mod/mp_finish_map.scr::resolve local.p local.sgive }
	if( local.p == NULL ){ end }

	//the give: plain takeall + item (never giveInventory / changeGameType - see mp.scr header)
	local.p takeall
	if( local.pgive != "" ){ local.p item local.pgive }
	if( local.sgive != "" ){ local.p item local.sgive }
	if( local.ggive != "" ){ local.p item local.ggive }

	//explicit ammo pools - `item` alone does not always fill the grenade / heavy pools
	if( local.rp != NIL && local.rp["ammo"] != NIL && local.rp["ammo"] != "" ){
		local.at = local.rp["ammo"]
		local.an = local.rp["ammoN"]
		local.p ammo local.at local.an
	}
	if( local.rs != NIL && local.rs["ammo"] != NIL && local.rs["ammo"] != "" ){
		local.at = local.rs["ammo"]
		local.an = local.rs["ammoN"]
		local.p ammo local.at local.an
	}
	if( local.rg != NIL && local.rg["ammo"] != NIL && local.rg["ammo"] != "" ){
		local.at = local.rg["ammo"]
		local.an = local.rg["ammoN"]
		local.p ammo local.at local.an
	}

	//MP health is 100 per player (never the coop_health cvar - it would follow him into coop, clause 4)
	local.p health 100

	//switch to the primary past the engine's +0.3s useitem (mirrors EquipWeapons' PostEvent "use")
	if( local.pgive != "" ){ thread useAfter local.p local.pgive }

	//[MP cosmetics step 1] apply the player's chosen body skin + gloves (helmet in step 2). MP-owned,
	//no coop call; a bad token there is a Script Error that skips only its statement, so the kit above
	//is never at risk. Threaded so a waitframe inside it never stalls the spawn edge.
	thread coop_mod/mp_cosmetics.scr::apply local.p

	println( "^~^~^ MPKIT e" + local.p.entnum + " side=" + local.side + " p=" + local.pgive + " s=" + local.sgive + " g=" + local.ggive + " hp=100 cause=" + local.cause )
}end


//re-assert the held weapon after the engine's own +0.3s useitem has landed
useAfter local.p local.give:{
	wait 0.4
	if( local.p == NULL ){ end }
	local.p use local.give
}end


//=========================================================================
// Helpers
//=========================================================================

//"a" for allies (and anything that is not axis), "x" for axis. Keys the dispatcher on dmteam (plan 7).
sideOf local.p:{
	local.s = "a"
	if( local.p != NULL && local.p.dmteam == "axis" ){ local.s = "x" }
}end local.s

//side-specific roster lookup. Both rosters are MP files (coop_mod/mp*_roster.scr in MP_MANIFEST).
rosterGet local.side local.id:{
	local.r = NIL
	if( local.side == "x" ){
		local.r = waitthread coop_mod/mpx_roster.scr::roster_get local.id
	} else {
		local.r = waitthread coop_mod/mpa_roster.scr::roster_get local.id
	}
}end local.r

//is this character a decimal digit 0-9?
isDigit local.c:{
	switch( local.c ){
		case "0":
		case "1":
		case "2":
		case "3":
		case "4":
		case "5":
		case "6":
		case "7":
		case "8":
		case "9":
			end 1
	}
}end 0

//the free starter mpid for a side and a class (P1: one free starter per class; U3 for the Axis picks).
starterFor local.side local.class:{
	local.id = ""
	if( local.side == "x" ){
		switch( local.class ){
			case "rifle":	local.id = "03"; break
			case "sniper":	local.id = "13"; break
			case "smg":	local.id = "26"; break
			case "mg":	local.id = "37"; break
			case "shotgun":	local.id = "44"; break
			case "rocket":	local.id = "46"; break
			case "heavy":	local.id = "46"; break
			case "pistol":	local.id = "50"; break
			case "nades":	local.id = "65"; break
			case "grenade":	local.id = "65"; break
		}
	} else {
		switch( local.class ){
			case "rifle":	local.id = "01"; break
			case "sniper":	local.id = "12"; break
			case "smg":	local.id = "24"; break
			case "mg":	local.id = "36"; break
			case "shotgun":	local.id = "44"; break
			case "rocket":	local.id = "45"; break
			case "heavy":	local.id = "45"; break
			case "pistol":	local.id = "48"; break
			case "nades":	local.id = "64"; break
			case "grenade":	local.id = "64"; break
		}
	}
}end local.id

//[preset slice 2, M3/M4/M5] does the ACTIVE weapon preset mask this primary dmclass out? Reads the
//MP-owned level.coop_mpPreset (seeded once in mp.scr::main from the coop_mpPreset host cvar). Pistols and
//grenades ALWAYS pass (M4). "" / "none" / NIL / an unknown value -> nothing masked (fail-open to today's
//behaviour). P3: the Sniper class is the roster's dmclass "sniper" tag, which already covers scoped
//bolt-action and scoped semi-auto rifles while a scoped fully-auto is tagged to its base class - so this
//reuses the shipped tags and reclassifies nothing.
presetBansClass local.cls:{
	local.pre = level.coop_mpPreset
	if( local.pre == NIL || local.pre == "" || local.pre == "none" ){ end 0 }
	//pistols and grenades stay under every preset (M4)
	if( local.cls == "pistol" || local.cls == "grenade" ){ end 0 }
	if( local.pre == "rifles" ){
		if( local.cls == "rifle" ){ end 0 }
		end 1
	}
	if( local.pre == "snipers" ){
		if( local.cls == "sniper" ){ end 0 }
		end 1
	}
	if( local.pre == "riflesnipers" ){
		if( local.cls == "rifle" || local.cls == "sniper" ){ end 0 }
		end 1
	}
}end 0

//is a dmclass banned by the server's dmflags? (DF_WEAPON_NO_* bits, bg_public.h)
classBanned local.cls:{
	//[preset slice 2, M5] the active weapon preset masks primary classes FIRST, composed HERE so every
	//path that asks "is this class legal" - resolvePrimary's degrade, firstAllowedClass and botRollClass -
	//honours the preset through the one gate, never a fork. Pistols/grenades are never masked (M4, handled
	//inside presetBansClass).
	local.pb = waitthread presetBansClass local.cls
	if( local.pb == 1 ){ end 1 }
	local.f = int( getcvar( "dmflags" ) )
	local.bit = 0
	switch( local.cls ){
		case "rifle":	local.bit = 4194304; break
		case "sniper":	local.bit = 8388608; break
		case "smg":	local.bit = 16777216; break
		case "mg":	local.bit = 33554432; break
		case "heavy":	local.bit = 67108864; break
		case "rocket":	local.bit = 67108864; break
		case "shotgun":	local.bit = 134217728; break
	}
	if( local.bit == 0 ){ end 0 }
	if( ( local.f & local.bit ) != 0 ){ end 1 }
}end 0

//the first primary class the server's dmflags allow, in a fixed order. "rifle" if all are banned - the
//engine re-allows the rifle in that case (player.cpp UserSelectWeapon).
firstAllowedClass:{
	local.order[0] = "rifle"
	local.order[1] = "sniper"
	local.order[2] = "smg"
	local.order[3] = "mg"
	local.order[4] = "shotgun"
	local.order[5] = "heavy"
	local.res = "rifle"
	for( local.i = 0; local.i <= 5; local.i++ ){
		local.b = waitthread classBanned local.order[local.i]
		if( local.b == 0 ){
			local.res = local.order[local.i]
			local.i = 6
		}
	}
}end local.res

//resolve the player's committed primary to a legal (mpid, dmclass). Degrades a dmflags-banned primary
//to the free starter of the first allowed class. Returns [ mpid, dmclass ].
//[bug-2767 / kit persistence] Seed the committed kit flags (coop_mp_K1..K3) from the player's USERINFO
//(coop_mp<side>_k1..k3) when the name-bus did not set them this life. The armory setas the kit to these
//userinfo cvars on every pick AND on the disconnected DEFAULTS screen, but nothing read them back - so
//defaults / cross-server kit memory never applied, and a name-bus weapon marker truncated off a full name
//(bug-2759) silently fell back to the class starter. This is the same reliable carry cosmetics already use
//(mp_cosmetics.scr::apply). Only EMPTY flags are filled, so a fresh in-match pick still wins.
seedKitFromUserinfo local.p:{
	if( local.p == NULL ){ end }
	local.u = local.p.userinfo
	if( local.u == NIL ){ end }
	local.side = waitthread sideOf local.p
	waitthread seedOneKit local.p local.side local.u "coop_mp_K1" "p" ( "coop_mp" + local.side + "_k1" )
	if( local.p == NULL ){ end }
	waitthread seedOneKit local.p local.side local.u "coop_mp_K2" "s" ( "coop_mp" + local.side + "_k2" )
	if( local.p == NULL ){ end }
	waitthread seedOneKit local.p local.side local.u "coop_mp_K3" "g" ( "coop_mp" + local.side + "_k3" )
}end


//[bug-2767 vet-F1] Seed ONE kit slot from userinfo, validated EXACTLY as the name-bus path (applyMarker):
//roster hit, give non-empty, slot-legal, and starter-OR-challenge-unlocked. Without this a defaults-screen
//pick of a locked weapon, or a console-edited off-slot id, would spawn ungated (resolvePrimary only checks
//classBanned, never isUnlocked; giveKit reads K2/K3 raw). Only an EMPTY flag is filled, so a fresh in-match
//pick still wins; an illegal/locked id is refused and left empty -> giveKit falls back to the class starter.
seedOneKit local.p local.side local.u local.flagKey local.wantSlot local.uiKey:{
	if( local.p == NULL ){ end }
	if( local.p.flags[local.flagKey] != NIL && local.p.flags[local.flagKey] != "" ){ end }
	local.id = info_valueforkey local.u local.uiKey
	if( local.id == NIL || local.id == "" ){ end }
	local.r = waitthread rosterGet local.side local.id
	if( local.r == NIL ){ end }
	if( local.r["give"] == NIL || local.r["give"] == "" ){ end }
	if( local.r["slot"] != local.wantSlot ){ end }
	if( local.r["starter"] != 1 ){
		local.tok = ( "wt:" + local.r["class"] + ":" + local.r["tier"] )
		local.un = waitthread coop_mod/mp_challenges.scr::isUnlocked local.p local.tok
		if( local.p == NULL ){ end }
		if( local.un != 1 ){ end }
	}
	local.p.flags[local.flagKey] = local.id
}end


//[bug-2775] Seed the picked weapon FINISH from the carried userinfo (coop_mp<side>_k5 = the finish index)
//when the name-bus did not set it this life, so a finish choice persists across sessions/servers like the
//kit and cosmetics. Server-authoritative: finUnlocked still gates it, so a carried/edited finish the player
//has not earned is refused (coop_mpFinSel left empty -> base weapon). Only fills an empty selection.
seedFinishFromUserinfo local.p:{
	if( local.p == NULL ){ end }
	if( local.p.flags["coop_mpFinSel"] != NIL && local.p.flags["coop_mpFinSel"] != "" ){ end }
	local.u = local.p.userinfo
	if( local.u == NIL ){ end }
	local.side = waitthread sideOf local.p
	local.fi = int( info_valueforkey local.u ( "coop_mp" + local.side + "_k5" ) )
	if( local.fi <= 0 ){ end }
	local.fn = ""
	switch( local.fi ){
		case 1: local.fn = "gold"; break
		case 2: local.fn = "chrome"; break
		case 3: local.fn = "blued"; break
		case 4: local.fn = "bloody"; break
		case 5: local.fn = "camo_woodland"; break
		case 6: local.fn = "camo_winter"; break
		case 7: local.fn = "camo_desert"; break
	}
	if( local.fn == "" ){ end }
	local.fu = waitthread coop_mod/mp_challenges.scr::finUnlocked local.p local.fn
	if( local.p == NULL ){ end }
	if( local.fu != 1 ){ end }
	local.p.flags["coop_mpFinSel"] = local.fn
}end


resolvePrimary local.p:{
	local.out[0] = ""
	local.out[1] = "rifle"
	if( local.p == NULL ){ end local.out }

	local.side = waitthread sideOf local.p
	local.pid = local.p.flags["coop_mp_K1"]
	if( local.pid == NIL || local.pid == "" ){ local.pid = waitthread starterFor local.side "rifle" }

	local.r = waitthread rosterGet local.side local.pid
	local.cls = "rifle"
	if( local.r != NIL && local.r["dmclass"] != NIL && local.r["dmclass"] != "" ){ local.cls = local.r["dmclass"] }

	local.ban = waitthread classBanned local.cls
	if( local.ban == 1 ){
		local.cls = waitthread firstAllowedClass
		local.pid = waitthread starterFor local.side local.cls
	}

	local.out[0] = local.pid
	local.out[1] = local.cls
}end local.out

//a bot's primary class: a random one of the side's ALLOWED primary classes (F4 - random free-tier gun).
//[user 2026-09-18] Map every self-loading rifle/sniper to the side's bolt-action equivalent. Bolt weapons
//(Kar98, Gewehr 98, Springfield, Enfield, Mosin, Carcano, Arisaka + their bolt snipers) pass through
//unchanged. Used by giveKit when coop_mpBoltOnly is 1. Weapon tiks verified against mpa_roster / mpx_roster.
boltize local.give:{
	local.out = local.give
	//allied self-loading rifles -> Springfield M1903 (bolt)
	if( local.give == "models/weapons/m1_garand.tik" ){ local.out = "models/weapons/springfield_unscoped.tik" }
	if( local.give == "models/weapons/carbine.tik" ){ local.out = "models/weapons/springfield_unscoped.tik" }
	if( local.give == "models/weapons/svt_rifle.tik" ){ local.out = "models/weapons/springfield_unscoped.tik" }
	if( local.give == "models/weapons/garand_silenced.tik" ){ local.out = "models/weapons/springfield_unscoped.tik" }
	//allied self-loading scoped -> Springfield Sniper (bolt)
	if( local.give == "models/weapons/garand_scoped.tik" ){ local.out = "models/weapons/springfield.tik" }
	//axis self-loading rifle -> KAR98K (bolt)
	if( local.give == "models/weapons/g43.tik" ){ local.out = "models/weapons/kar98.tik" }
	//axis self-loading scoped -> KAR98K Sniper (bolt)
	if( local.give == "models/weapons/g43sniper.tik" ){ local.out = "models/weapons/kar98sniper.tik" }
}end local.out

botRollClass:{
	local.all[0] = "rifle"
	local.all[1] = "sniper"
	local.all[2] = "smg"
	local.all[3] = "mg"
	local.all[4] = "shotgun"
	local.all[5] = "heavy"
	local.cnt = 0
	for( local.i = 0; local.i <= 5; local.i++ ){
		local.b = waitthread classBanned local.all[local.i]
		if( local.b == 0 ){
			local.ok[local.cnt] = local.all[local.i]
			local.cnt++
		}
	}
	local.res = "rifle"
	if( local.cnt > 0 ){
		local.pick = int( randomint( local.cnt ) )
		local.res = local.ok[local.pick]
	}
	//[bug-2795] ROCKET (the "heavy" class) is RARE. A uniform roll gave bots rockets ~1-in-6 - way too often.
	//If the roll lands on heavy, re-roll to a NON-heavy allowed class 85% of the time, so bots field rockets
	//only occasionally (like real players) instead of constantly.
	if( local.res == "heavy" ){
		if( int( randomint( 100 ) ) >= 15 ){
			local.cnt2 = 0
			for( local.i = 0; local.i < local.cnt; local.i++ ){
				if( local.ok[local.i] != "heavy" ){
					local.ok2[local.cnt2] = local.ok[local.i]
					local.cnt2++
				}
			}
			if( local.cnt2 > 0 ){ local.res = local.ok2[ int( randomint( local.cnt2 ) ) ] }
		}
	}
}end local.res

//push a picked slot's display name to its chip cvar (set coop_mp<side>_N<field>). Assembling a coop_mp*
//name at runtime is legal for an MP file (isolation clause 12c steers into MP space). Sent UNQUOTED,
//one statement per stufftext (TRAPS T8).
pushChipName local.p local.side local.field local.name:{
	if( local.p == NULL ){ end }
	if( local.name == NIL || local.name == "" ){ end }
	local.pre = "coop_mpa_N"
	if( local.side == "x" ){ local.pre = "coop_mpx_N" }
	local.p stufftext ( "set " + local.pre + local.field + " " + local.name )
}end
