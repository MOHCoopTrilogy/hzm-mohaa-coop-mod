//=========================================================================
// MP_ARMORY.SCR - the shared MP armory dispatcher. INERT STUB (slice 1, mod-only pass).
//
// [2026-09-13] Slice 1 ships the two MP armory SCREENS, their cfg trees and the side rosters
// (coop_mod/mpa_roster.scr, coop_mod/mpx_roster.scr), all generated by docs/tools/gen_mp_armory.py.
// The LIVE dispatcher - name-bus poll, unlock/ban validation, the spawn-edge give, the 25s deploy
// timer and the bot branch - is step 2 of _research/mp_armories_slice1_plan.md and needs the game.dll
// MP hook. Until then this file is a NO-OP: mp.scr does not call it yet, and it does nothing if it is.
//
// Isolation: this is an MP file (coop_mod/mp*.scr is in MP_MANIFEST). It calls no coop helper
// (clause 10), never sets flags["coop_isHost"] (clause 9), and names no coop armory cvar or tree.
//=========================================================================

//Entry. Guarded on level.coop_mpRun, which ONLY coop_mod/mp.scr ever sets (mp.scr:57-58) and which a
//level load wipes - so this can never run on a coop map. Inert regardless in slice 1: no side effects.
main:{
	if( level.coop_mpRun != 1 ){ end }
	end
}end

//The dispatcher liveness probe. A parse killer in this file (TRAPS T1) makes ::alive unreachable, and
//mp.scr's future liveness check falls back to the stock rifle deploy instead of stranding players in
//spectate. Returns literal 1 today.
alive:{
	end 1
}end

//MP NAME-BUS TOKEN FAMILIES. Grammar ,q<side><field><data>: side a|x, field 1 primary / 2 sidearm /
//3 grenade / d deploy (no data). These string literals are the registry docs/tools/ui_wiring_audit.py
//reads to prove that every ,q marker the armory cfgs append is accounted for HERE, not in
//variables.scr / player.scr (isolation clause 7 keeps MP tokens out of coop). Never called at runtime
//in slice 1 - it is a data table the audit parses and the live dispatcher will iterate.
mp_bus_families:{
	local.f[0] = ",qa1"
	local.f[1] = ",qa2"
	local.f[2] = ",qa3"
	local.f[3] = ",qad"
	local.f[4] = ",qx1"
	local.f[5] = ",qx2"
	local.f[6] = ",qx3"
	local.f[7] = ",qxd"
}end local.f
