				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0   //heavy
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0   //shotgun
				level.coop_weaponUse = "rifle"
				break

			//===================================================================================
			// HZM coop [user 08-02]: SH + BT map loadouts. These were the "//TODO: add SH and BT
			// levels here" line at the bottom of this file - every e2/e3/t map fell through to
			// the default Colt45 + M1 Garand kit.
			// That was not just a wrong-looking kit, it SOFT LOCKED e3l2: the PIAT is the only
			// thing that can kill $tank2 (health 300), and without it waitTillDeath never
			// returns, so killModellos is never revealed, $OpenDoorSection never opens and the
			// Barney actors never follow. Retail handed these out in global/loadout.scr, but
			// every block there is wrapped in "if( level.gametype == 0 )" so none of it runs in
			// coop. Ported from global/loadout.scr (BT) and
			// original-scripts/spearhead/global/loadout.scr (SH).
			// This table is the single source consumed by fresh spawn, respawn, DBNO revive
			// (dbno.scr) and medkit revive (medkit.scr), so it fixes the after-death /
			// after-DBNO / after-spectate cases at the same time.
			// Ammo slots: 1 smg, 2 pistol, 3 rifle, 4 agrenade, 5 mg, 6 heavy, 7 shotgun,
			// 8 grenade(axis). NOTE retail wrote "ammo bazooka 2" for the PIAT, but
			// Uk_W_Piat.tik declares ammotype "heavy" - verified - so heavy is the correct slot.
			// Counts are raised over SP where SP relied on a one-time mission handout.
			//===================================================================================
			case "maps/e2l2.scr":
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0     //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 48    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 100   //rifle
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 2     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/It_W_Beretta.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/m1_garand.tik"
				level.coop_weaponUse = "rifle"
				break
			case "maps/e2l3.scr":
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0     //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 48    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 60    //rifle
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 3     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 200   //mg (Vickers)
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/it_w_beretta.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/it_w_moschetto.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/uk_w_vickers.tik"
				level.coop_weaponUse = "mg"
				break
			case "maps/e3l1.scr":
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 120   //smg (Sten)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 40    //rifle (L42A1)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 5     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/it_w_beretta.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/sten.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/UK_W_L42A1.tik"
				level.coop_weaponUse = "smg"
				break
			case "maps/e3l2.scr":
				//[HZM coop] PIAT is MANDATORY here - it is the only weapon that can kill $tank2,
				//and the gate / follow / killModellos chain is all gated behind that tank's death.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 96    //smg (Sten)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 48    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 20    //rifle (L42A1)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 6     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 6     //heavy (PIAT) - SP gave 2 for one player
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/it_w_beretta.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/sten.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/UK_W_L42A1.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/UK_W_Piat.tik"
				level.coop_weaponUse = "smg"
				break
			case "maps/e3l3.scr":
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0     //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 60    //rifle (Carcano)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 4     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 200   //mg (BAR)
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/colt45.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/bar.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/it_w_carcano.tik"
				level.coop_weaponUse = "mg"
				break
			case "maps/e3l4.scr":
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0     //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 50    //rifle (L42A1)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 4     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 170   //mg (BAR)
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 50    //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/colt45.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/bar.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/UK_W_L42A1.tik"
				level.coop_weaponUse = "mg"
				break
			case "maps/t1l1.scr":
				//[HZM coop] retail awards t1l1 weapons in gags/t1l1_barn_crash.scr::cutharness
				//(a one-shot cutscene handout), so there was no loadout entry at all. Coop needs
				//one anyway or a respawn after the barn crash leaves you with the default kit.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0     //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 100   //rifle
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 4     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/colt45.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/m1_garand.tik"
				level.coop_weaponUse = "rifle"
				break
			case "maps/t2l1.scr":
				//[HZM coop] retail block is commented out (SP relied on carry-over from t1l3).
				//Coop has no carry-over on respawn, so the commented kit is restored here.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 200   //smg (Thompson)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 120   //rifle
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 4     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/colt45.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/m1_garand.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/thompsonsmg.tik"
				level.coop_weaponUse = "smg"
				break
			case "maps/t2l3.scr":
				//[HZM coop] disguised-as-German mission - retail issues captured Axis small arms.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 200   //smg (MP40)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol (P38)
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 120   //rifle (Kar98)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 0     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 4     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/p38.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/KAR98.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/mp40.tik"
				level.coop_weaponUse = "smg"
				break
			case "maps/t2l4.scr":
				//[HZM coop] retail block is commented out ("we do this in the script now" - the
				//mini-save path). Restored from that commented block, incl. the panzerschreck.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 200   //smg (MP40)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 32    //pistol (P38)
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 0     //rifle - SP withholds it so the sniper pickup matters
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 0     //allied grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 4     //heavy (panzerschreck) - SP gave 2 for one player
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 2     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/p38.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/mp40.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/panzerschreck.tik"
				level.coop_weaponUse = "smg"
				break
			case "maps/t3l1.scr":
			case "maps/t3l2.scr":
				//[HZM coop] Berlin - Soviet kit. t3l2 has no retail loadout entry at all (it is
				//the tank mission and SP carried over from t3l1), so it shares t3l1's.
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 200   //smg (PPSh)
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 60    //pistol (Nagant)
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 120   //rifle (Mosin / SVT)
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 4     //allied grenade (F1)
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0     //mg
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0     //heavy
				level.coop_ammoLoadout[level.coop_ammoType[7]] 	= 0     //shotgun
				level.coop_ammoLoadout[level.coop_ammoType[8]] 	= 0     //axis grenade
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/Nagant_revolver.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/Mosin_Nagant_Rifle.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/ppsh_smg.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/svt_rifle.tik"
				level.coop_weaponUse = "smg"
				break
			default:
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/colt45.tik"
				level.coop_weaponLoadout[level.coop_weaponLoadout.size+1] = "models/weapons/m1_garand.tik"
				level.coop_ammoLoadout[level.coop_ammoType[1]] 	= 0   //smg
				level.coop_ammoLoadout[level.coop_ammoType[2]] 	= 40  //pistol
				level.coop_ammoLoadout[level.coop_ammoType[3]] 	= 60  //rifle
				level.coop_ammoLoadout[level.coop_ammoType[4]] 	= 1   //grenade
				level.coop_ammoLoadout[level.coop_ammoType[5]] 	= 0   //heavy
				level.coop_ammoLoadout[level.coop_ammoType[6]] 	= 0   //shotgun
				level.coop_weaponUse = "rifle"
				break
		}
		//[HZM coop 08-02] SH + BT levels are now covered in the switch above.
end