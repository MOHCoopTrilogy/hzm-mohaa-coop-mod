//=========================================================================
// dbno_bleed.scr - [user 2026-10-05] the ONLY place the bleed-out ring's engine commands are written.
//=========================================================================
// coop_setbleed / coop_bleedflare exist only in the 2026-10-05 game.dll (fgame/player.cpp). Morpheus resolves
// command names at COMPILE time, and an unknown one fails the WHOLE file - so written inside dbno.scr they took
// all of DBNO down on any older game.dll ("Couldn't compile 'coop_mod/dbno.scr'"). Isolated here, an old
// game.dll fails only THIS file: dbno.scr's waitthread into it is a runtime Script Error, which skips that one
// statement (TRAPS: a Script Error skips the statement), and DBNO runs as before without the ring.
// Keep anything else out of this file for exactly that reason.
//=========================================================================

publish local.player local.rem local.total local.paused:{
	if( local.player == NIL ){ end }
	if( local.player == NULL ){ end }
	local.player coop_setbleed local.rem local.total local.paused
}end

flare local.player:{
	if( local.player == NIL ){ end }
	if( local.player == NULL ){ end }
	local.player coop_bleedflare
}end
