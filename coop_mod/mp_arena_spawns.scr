// GENERATED by docs/tools/gen_arena_spawns.py. Do NOT hand-edit.
// Shared MP team spawns for the SP campaign maps run as script-less arenas (sv_mpForceArena),
// whose bsps carry no MP spawns. Coordinates are REUSED from the authored Base Assault + Push
// layouts (info_player_allied + info_player_axis), so Build-A-Base / Cyber Attack / Search &
// Destroy can run on the same 11 campaign maps without new spawn authoring. The three loaders
// call ensureSpawns(map) before the mode starts; on the mohdm* deathmatch maps (which already
// carry bsp spawns) the map is simply absent from the switch and this is a no-op.
// MP-only (coop_mod/mp*.scr, guarded by level.coop_mpRun); never touches coop.

//canary
alive:{
	end 1
}end

//spawn this map's reused MP team spawns, if it is one of the authored campaign maps (else no-op).
ensureSpawns local.map:{
	if( level.coop_mpRun != 1 ){ end }
	switch( local.map ){
	case "m1l2b":
		waitthread spawn_m1l2b
		println( "^~^~^ MP arena spawns injected map=m1l2b n=39" )
		break
	case "m1l3a":
		waitthread spawn_m1l3a
		println( "^~^~^ MP arena spawns injected map=m1l3a n=40" )
		break
	case "m1l3b":
		waitthread spawn_m1l3b
		println( "^~^~^ MP arena spawns injected map=m1l3b n=40" )
		break
	case "m2l1":
		waitthread spawn_m2l1
		println( "^~^~^ MP arena spawns injected map=m2l1 n=40" )
		break
	case "m3l3":
		waitthread spawn_m3l3
		println( "^~^~^ MP arena spawns injected map=m3l3 n=40" )
		break
	case "m4l1":
		waitthread spawn_m4l1
		println( "^~^~^ MP arena spawns injected map=m4l1 n=40" )
		break
	case "m4l2":
		waitthread spawn_m4l2
		println( "^~^~^ MP arena spawns injected map=m4l2 n=38" )
		break
	case "m5l1a":
		waitthread spawn_m5l1a
		println( "^~^~^ MP arena spawns injected map=m5l1a n=38" )
		break
	case "m5l1b":
		waitthread spawn_m5l1b
		println( "^~^~^ MP arena spawns injected map=m5l1b n=40" )
		break
	case "m5l2a":
		waitthread spawn_m5l2a
		println( "^~^~^ MP arena spawns injected map=m5l2a n=40" )
		break
	case "m5l3":
		waitthread spawn_m5l3
		println( "^~^~^ MP arena spawns injected map=m5l3 n=40" )
		break
	}
}end


