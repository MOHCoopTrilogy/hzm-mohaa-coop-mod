	level.coop_xp_rankAbbr[3]  = "Cpl"
	level.coop_xp_rankAbbr[4]  = "T/4"
	level.coop_xp_rankAbbr[5]  = "Sgt"
	level.coop_xp_rankAbbr[6]  = "T/3"
	level.coop_xp_rankAbbr[7]  = "SSgt"
	level.coop_xp_rankAbbr[8]  = "TSgt"
	level.coop_xp_rankAbbr[9]  = "1Sgt"
	level.coop_xp_rankAbbr[10] = "MSgt"
	level.coop_xp_rankAbbr[11] = "2Lt"
	level.coop_xp_rankAbbr[12] = "1Lt"
	level.coop_xp_rankAbbr[13] = "Cpt"
	level.coop_xp_rankAbbr[14] = "Maj"
	level.coop_xp_rankAbbr[15] = "LtCol"
	level.coop_xp_rankAbbr[16] = "Col"
	level.coop_xp_rankAbbr[17] = "BGen"
	level.coop_xp_rankAbbr[18] = "MGen"
	level.coop_xp_rankAbbr[19] = "LtGen"
	level.coop_xp_rankAbbr[20] = "Gen"
	level.coop_xp_rankAbbr[21] = "GA"

	// kill-XP soft cap counter (anti farm, design doc 6): after 40 x players team kills the
	// kill-derived XP halves, after 80 x players it quarters. Objectives/support unaffected.
	level.coop_xp_teamkills = 0
	// paratrooper survival roster
	level.coop_xp_paraN = 0

	thread xp_autosave_loop
}end


//=========================================================================
// 60s autosave (plus flushes on rank-up, mission complete and maptest transitions).
//=========================================================================
xp_autosave_loop:{
	if( level.coop_xp_autosave == 1 ){ end }
	level.coop_xp_autosave = 1
	while( 1 ){
		wait 60
		waitthread xp_flush
	}
}end


//=========================================================================
// Identity + restore. Called from player.scr::manageSetup for every new player.
//=========================================================================
xp_identify local.player:{
	if( level.coop_xp_init != 1 ){ waitthread xp_init }
	if( level.coop_xp_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_xp_id"] != NIL ){ end }
	// singleton: a kill can race the connect-time identify (both call here). Second caller
	// just waits for the first to finish so awards never see half-initialized totals (NIL HUD bug).
	if( local.player.flags["coop_xp_identifying"] == 1 ){
		while( local.player != NULL && local.player.flags["coop_xp_identifying"] == 1 ){
			wait 0.25
		}
		end
	}
	local.player.flags["coop_xp_identifying"] = 1

	// cl_guid is pushed onto the player entity by the ENGINE (g_client.cpp
	// G_ClientUserinfoChanged -> self.coop_guid); there is NO script userinfo getter.
	// It can land a moment after connect, so wait briefly before falling back.
	local.tries = 0
	while( (local.player.coop_guid == NIL || local.player.coop_guid == "") && local.tries < 10 ){
		wait 0.5
		if( local.player == NULL ){ end }
		local.tries++
	}
	local.id = local.player.coop_guid
	if( local.id == NIL || local.id == "" ){
		// no guid (vanilla client / missing qkey) - spoofable, LAN-grade netname identity
		local.id = "n_" + local.player.netname
	}

	local.total = 0
	// 1) session cache (survives map transitions instantly)
	local.cv = getcvar( "coop_xp_" + local.id )
	if( local.cv != "" ){
		local.total = int( local.cv )
	} else {
		// 2) file (survives server restarts). Content = plain number.
		local.data = fs_read_content ( "coop_mod/save/xp_" + local.id + ".dat" )
		if( local.data != NIL && local.data != "" ){
			local.total = int( local.data )
		}
	}
	if( local.total == NIL ){ local.total = 0 }
	if( local.total < 0 ){ local.total = 0 }

	local.player.flags["coop_xp_id"]    = local.id
	local.player.flags["coop_xp_total"] = local.total
	local.player.flags["coop_xp_map"]   = 0
	local.player.flags["coop_xp_join"]  = level.time
	local.rank = waitthread xp_rankForTotal local.total
	local.player.flags["coop_xp_rank"]  = local.rank
	local.player.flags["coop_xp_rankmapstart"] = local.rank
	//[user 07-16] rank is re-derived from total on connect (never stored) - re-apply all rank unlocks
	//so they survive reconnects. Idempotent (chal_add_unlock dedups).
	thread xp_rank_unlock local.player 0 local.rank

	setcvar ( "coop_xp_" + local.id ) ( "" + local.total )
	local.player.flags["coop_xp_identifying"] = NIL

	local.player iprint ( "Service record: " + level.coop_xp_rankAbbr[local.rank] + " - " + local.total + " XP" ) 1
}end


//=========================================================================
// Rank index (0-12) for a cumulative total.
//=========================================================================
xp_rankForTotal local.total:{
	if( level.coop_xp_rankMax == NIL ){ level.coop_xp_rankMax = 21 }		// defensive: an unset max makes the loop return rank 0 -> bar reads full
	local.r = 0
	local.i = 1
	while( local.i <= level.coop_xp_rankMax ){
		if( local.total >= level.coop_xp_rankXP[local.i] ){ local.r = local.i }
		local.i++
	}
}end(local.r)


//=========================================================================
// THE award entry point. reason buckets: kills valor objective support revive mission
//=========================================================================
// [user 07-12] RANK-UP FOCUS DUCK: while the cinematic M1 ping rings, this client's world audio dips
// hard and then eases back up - the ping owns the moment. Same per-client s_volume recipe as the
// tinnitus duck; restores to the shared coop_tinnitusBaseVol baseline.
//=========================================================================
xp_ping_duck local.p:{
	if( local.p == NULL ){ end }
	local.p stufftext "s_volume 0.20"
	wait 1.4
	if( local.p == NULL ){ end }
	local.p stufftext "s_volume 0.45"
	wait 0.5
	if( local.p == NULL ){ end }
	local.p stufftext "s_volume 0.70"
	wait 0.5
	if( local.p == NULL ){ end }
	local.p stufftext ( "s_volume " + getcvar( "coop_tinnitusBaseVol" ) )
}end

//=========================================================================
xp_award local.player local.amount local.reason local.label:{
	if( level.coop_xp_init != 1 ){ waitthread xp_init }
	if( level.coop_xp_enabled != 1 ){ end }
	// guard BOTH NULL (freed entity) and NIL (unset var, e.g. an early DBNO team-revive when
	// level.coop_smoke_player was never set) - either would cast 'none' on the .classname deref.
	if( local.player == NULL || local.player == NIL ){ end }
	if( local.player.classname != "Player" ){ end }
	if( local.player.flags["coop_xp_id"] == NIL ){
		waitthread xp_identify local.player
		if( local.player == NULL || local.player.flags["coop_xp_id"] == NIL ){ end }
	}
	if( local.amount == NIL ){ end }

	local.amount = int( local.amount * level.coop_xp_scale )
	if( local.amount <= 0 ){ end }

	if( local.player.flags["coop_xp_total"] == NIL ){ end }

	local.player.flags["coop_xp_total"] = local.player.flags["coop_xp_total"] + local.amount
	local.player.flags["coop_xp_map"]   = local.player.flags["coop_xp_map"] + local.amount

	// [235] tiny "+N <label>" by the crosshair on EVERY gain (coop_xpKillPopup 0 disables)
	// [239] local.label carries the SPECIFIC name ("Headshot", "Blindfire", ...) per award
	thread xp_micro_popup local.player local.amount local.reason local.label

	// [235] the PROGRESS BAR now pops only when a 100-XP boundary is crossed (user: "after you
	// get 100 points, the progress bar will pop up" - was: on every gain)
	local.mark = int( local.player.flags["coop_xp_total"] / 100 )
	if( local.player.flags["coop_xp_barMark"] == NIL ){ local.player.flags["coop_xp_barMark"] = local.mark }
	if( local.mark > local.player.flags["coop_xp_barMark"] ){
		local.player.flags["coop_xp_barMark"] = local.mark
		if( local.player.flags["coop_xp_popupGain"] == NIL ){ local.player.flags["coop_xp_popupGain"] = 0 }
		local.player.flags["coop_xp_popupGain"]  = local.player.flags["coop_xp_popupGain"] + local.amount
		local.player.flags["coop_xp_popupUntil"] = level.time + 3
		thread xp_hud_popup local.player
	}
	if( local.reason == NIL ){ local.reason = "kills" }
	local.bkey = "coop_xp_b_" + local.reason
	if( local.player.flags[local.bkey] == NIL ){ local.player.flags[local.bkey] = 0 }
	local.player.flags[local.bkey] = local.player.flags[local.bkey] + local.amount

	// write-through cache: there is NO per-player disconnect hook, so the cvar must always be hot
	setcvar ( "coop_xp_" + local.player.flags["coop_xp_id"] ) ( "" + local.player.flags["coop_xp_total"] )

	// promotion? [235] NO chat spam (user) - the on-screen ceremony is the announcement
	local.newrank = waitthread xp_rankForTotal local.player.flags["coop_xp_total"]
	if( local.newrank > local.player.flags["coop_xp_rank"] ){
		local.prevrank = local.player.flags["coop_xp_rank"]		//[user 07-16] capture before overwrite
		local.player.flags["coop_xp_rank"] = local.newrank
		thread xp_promo_ceremony local.player local.newrank
		//[user 07-16] unlock the weapons for every rank crossed (covers multi-rank lump jumps)
		thread xp_rank_unlock local.player ( local.prevrank + 1 ) local.newrank
		waitthread xp_flush
	}
}end


//=========================================================================
// [239] micro gain popup: tiny "+N <specific label>" beside the crosshair, one
// line PER award (Headshot / Blindfire / Long Shot... never lumped), stacked up
// to three lines (slots 73-75). Crosshair-sized (verdana-12) so it is never
// obnoxious; a fourth simultaneous award is dropped rather than spamming.
// coop_xpKillPopup 0 disables (coop settings).
//=========================================================================
xp_micro_popup local.player local.amount local.reason local.label:{
	if( local.player == NULL ){ end }
	if( getcvar "coop_xpKillPopup" == "0" ){ end }
	if( level.coop_xp_summaryActive == 1 ){ end }		// [fix] no crosshair micro-popups while the debrief card is up
	if( local.label == NIL ){
		if( local.reason == NIL ){ local.reason = "kills" }
		local.label = "XP"
		if( local.reason == "kills" ){ local.label = "Kill" }
		else if( local.reason == "valor" ){ local.label = "Valor" }
		else if( local.reason == "objective" ){ local.label = "Objective" }
		else if( local.reason == "support" ){ local.label = "Support" }
		else if( local.reason == "revive" ){ local.label = "Revive" }
		else if( local.reason == "mission" ){ local.label = "Mission" }
	}

	local.slot = 0
	if( local.player.flags["coop_xp_mp73"] != 1 ){ local.slot = 73 }
	else if( local.player.flags["coop_xp_mp74"] != 1 ){ local.slot = 74 }
	else if( local.player.flags["coop_xp_mp75"] != 1 ){ local.slot = 75 }
	if( local.slot == 0 ){ end }
	local.player.flags["coop_xp_mp" + local.slot] = 1
	local.ly = 254 + ((local.slot - 73) * 13)

	ihuddraw_virtualsize local.player local.slot 1
	ihuddraw_align       local.player local.slot center top
	ihuddraw_font        local.player local.slot "verdana-12"
	ihuddraw_color       local.player local.slot 0.95 0.85 0.45
	ihuddraw_rect        local.player local.slot 16 local.ly 0 0
	ihuddraw_string      local.player local.slot ( "+" + local.amount + " " + local.label )
	ihuddraw_alpha       local.player local.slot 0.9

	wait 1
	local.a = 6
	while( local.a > 0 && local.player != NULL ){
		ihuddraw_alpha local.player local.slot (local.a * 0.13)
		local.a--
		wait 0.05
	}
	if( local.player != NULL ){
		ihuddraw_alpha  local.player local.slot 0
		ihuddraw_string local.player local.slot ""
		local.player.flags["coop_xp_mp" + local.slot] = NIL
	}
}end


//=========================================================================
// Soft-cap factor for kill-derived income (kills, kill bonuses, assists).
//=========================================================================
xp_killcap_factor:{
	local.f = 1
	local.np = 0
	local.i = 1
	while( local.i <= $player.size ){
		if( $player[local.i] != NULL && $player[local.i].flags["coop_isActive"] == 1 ){ local.np++ }
		local.i++
	}
	if( local.np < 1 ){ local.np = 1 }
	// [307] softened anti-farm cap: full-value kills for much longer (was 40/80 per player, which
	// crushed a normal map to 1 XP/kill). Now you keep full value until ~90 kills/player, half after,
	// quarter only past ~180/player (true reinforcement farming).
	if( level.coop_xp_teamkills > (180 * local.np) ){
		local.f = 0.25
	} else if( level.coop_xp_teamkills > (90 * local.np) ){
		local.f = 0.5
	}
}end(local.f)


// [307] behind-cover check for the Cover Kill XP bonus. True if the killer is standing at one of
// their OWN deployed sandbags (cover.scr level.coop_cover_visual), so a kill made from behind a
// placed sandbag also earns the bonus - not just the take-cover peek system (coop_incover).
xp_nearDeployedCover local.player:{
	local.r = 0
	if( local.player == NULL ){ end local.r }
	if( level.coop_cover_count == NIL ){ end local.r }
	local.i = 1
	while( local.i <= level.coop_cover_count ){
		local.vis = level.coop_cover_visual[local.i]
		if( local.vis != NIL && local.vis != NULL ){
			if( vector_length( local.player.origin - local.vis.origin ) < 96 ){ local.r = 1; end local.r }
		}
		local.i++
	}
	end local.r
}end


//=========================================================================
// AI kill award. Threaded from aihandler.scr::addKillToPlayer (attacker verified Player).
// Reads the victim's pain facts (fact.location/meansofdeath/enemyAtPain), the assist ledger
// (coop_xp_dmg/coop_xp_dmgT per attacker entnum, coop_xp_hp0) and the class tag (coop_xpClass).
//=========================================================================
xp_ai_killed local.victim local.killer:{
	if( level.coop_xp_enabled != 1 ){ end }
	if( local.killer == NULL || local.killer == NIL || local.killer.classname != "Player" ){ end }
	if( local.victim == NULL ){ end }

	if( level.coop_xp_teamkills == NIL ){ level.coop_xp_teamkills = 0 }
	level.coop_xp_teamkills = level.coop_xp_teamkills + 1
	local.factor = waitthread xp_killcap_factor

	// [239] ITEMIZED awards - every component fires its own xp_award with a SPECIFIC label so
	// the crosshair popup reads "+5 Headshot" / "+5 Blindfire", never a lumped "+12 Kill" (user).
	// Buckets stay coarse (kills/valor) for the debrief categories. Each component is soft-capped
	// by local.factor individually.
	local.saviorPaid = 0
	local.killPaid = 0		// [user 07-08] the base "Kill" pays ONLY for a plain kill; a headshot / reinforcement /
							// wallbang / etc. REPLACES it (you get the specific bonus, NEVER bonus + base kill).

	if( local.victim.fact != NIL && local.victim.fact != NULL ){
		// headshot: location 0/1/2 = head/helmet/neck (dbno.scr classification precedent)
		if( local.victim.fact.location != NIL && local.victim.fact.location >= 0 && local.victim.fact.location <= 2 ){
			local.b = int( 5 * local.factor )
			if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Headshot"; local.killPaid = 1 }
		}
		// [user 07-08] WALLBANG: the killing round reached the victim THROUGH a solid (engine sets
		// coop_wallbang in weaputils.cpp BulletAttack). Same value as a headshot.
		if( local.victim.coop_wallbang == 1 ){
			local.b = int( 5 * local.factor )
			if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Wallbang"; local.killPaid = 1 }
		}
		// melee / bash
		if( local.victim.fact.meansofdeath == 26 ){
			local.b = int( 5 * local.factor )		// [user 07-09] 20 -> 5 (a melee kill isn't worth that much)
			if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Melee Kill"; local.killPaid = 1 }
		}
		// savior (a): the AI was actively engaging a DIFFERENT player when it died
		if( local.victim.fact.enemyAtPain != NIL && local.victim.fact.enemyAtPain != NULL ){
			if( local.victim.fact.enemyAtPain != local.killer && local.victim.fact.enemyAtPain.classname == "Player" ){
				local.b = int( 15 * local.factor )
				if( local.b > 0 ){ thread xp_award local.killer local.b "valor" "Savior"; local.killPaid = 1 }
				local.saviorPaid = 1
			}
		}
	}

	// long-range kill
	if( vector_length( local.killer.origin - local.victim.origin ) > 2000 ){
		local.b = int( 5 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Long Shot"; local.killPaid = 1 }
	}

	// class bonuses (tagged at spawn in officer.scr / paradrop counts as reinf)
	if( local.victim.coop_xpClass == "reinf" ){
		local.b = int( 5 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Reinforcement"; local.killPaid = 1 }
	}
	if( local.victim.coop_xpClass == "guard" ){
		local.b = int( 10 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Bodyguard"; local.killPaid = 1 }
	}

	// [235/307] cover-system kills: blindfire +5, killing FROM cover +5. Blindfire wins; never both.
	// "From cover" = the take-cover peek pose (coop_incover) OR standing at a deployed sandbag.
	local.nearCover = 0
	if( local.killer.coop_incover == 1 ){ local.nearCover = 1 }
	else { local.nearCover = waitthread xp_nearDeployedCover local.killer }
	if( local.killer.coop_bf_t != NIL && (level.time - local.killer.coop_bf_t) < 0.75 ){
		local.b = int( 5 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Blindfire"; local.killPaid = 1 }
	} else if( local.nearCover == 1 ){
		local.b = int( 5 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Cover Kill"; local.killPaid = 1 }
	}

	// fighting from the ground: killer is DBNO
	if( local.killer.flags["coop_dbno_active"] == 1 ){
		local.b = int( 15 * local.factor )
		if( local.b > 0 ){ thread xp_award local.killer local.b "valor" "Downed Fight"; local.killPaid = 1 }
	}

	// savior (b): guarding a downed teammate - only if (a) did not already pay
	if( local.saviorPaid != 1 ){
		local.i = 1
		while( local.i <= $player.size ){
			local.p = $player[local.i]
			if( local.p != NULL && local.p != local.killer && local.p.flags["coop_dbno_active"] == 1 ){
				if( vector_length( local.p.origin - local.victim.origin ) < 512 ){
					local.b = int( 15 * local.factor )
					if( local.b > 0 ){ thread xp_award local.killer local.b "valor" "Guardian"; local.killPaid = 1 }
					break
				}
			}
			local.i++
		}
	}

	// [user 07-08] BASE kill: pays ONLY when nothing special above fired (a plain kill = +2). Headshot,
	// wallbang, reinforcement, savior, etc. already paid + set killPaid, so the base kill never stacks on top.
	if( local.killPaid != 1 ){
		local.b = int( 3 * local.factor )		// [307] plain kill 2 -> 3 (with the softer cap, a normal kill now reliably pays 3, not the old capped 1)
		if( local.b > 0 ){ thread xp_award local.killer local.b "kills" "Kill" }
	}

	// assists: any OTHER player who dealt >=25% of the victim's starting health within the
	// last 10 seconds (accumulated at the pain-fact sites; gaps over 10s reset the ledger)
	local.hp0 = local.victim.coop_xp_hp0
	if( local.hp0 == NIL || local.hp0 <= 0 ){ end }
	local.need = local.hp0 * 0.25
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p != local.killer ){
			local.dmg = local.victim.coop_xp_dmg[local.p.entnum]
			local.dt  = local.victim.coop_xp_dmgT[local.p.entnum]
			if( local.dmg != NIL && local.dt != NIL ){
				if( local.dmg >= local.need && (level.time - local.dt) <= 10 ){
					local.as = int( 2 * local.factor )		// [user 07-10] assist 5 -> 2
					if( local.as > 0 ){ thread xp_award local.p local.as "kills" "Assist" }
				}
			}
		}
		local.i++
	}
}end


//=========================================================================
// Officer death: killer award + share for the squad + heal-denied bonus.
// Threaded from officer.scr::coop_officer_death_monitor.
//=========================================================================
xp_officer_killed local.officer:{
	if( level.coop_xp_enabled != 1 ){ end }
	local.killer = NULL
	if( local.officer != NULL && local.officer.fact != NIL && local.officer.fact != NULL ){
		if( local.officer.fact.attacker != NULL && local.officer.fact.attacker.classname == "Player" ){
			local.killer = local.officer.fact.attacker
		}
	}

	if( local.killer != NULL ){
		thread xp_award local.killer 75 "valor" "Officer Down"		// [user 07-10] 150 -> 75
		// denied the heal retreat ("stop him before he heals!" paid off)
		if( level.coop_xp_heal_pending == 1 ){
			thread xp_award local.killer 25 "valor" "Heal Denied"
		}
	}
	level.coop_xp_heal_pending = 0

	// every other active player shares the wave relief
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p != local.killer && local.p.flags["coop_isActive"] == 1 ){
			thread xp_award local.p 50 "kills" "Officer Assist"
		}
		local.i++
	}
}end


//=========================================================================
// [303] HZM XP - a drivable vehicle (tank/halftrack/armored car) was destroyed by a player.
// Threaded per kill from challenges.scr::coop_vehKill_monitor. Team award (individual
// attribution isn't tracked for vehicle kills).
//=========================================================================
xp_vehicle_killed:{
	if( level.coop_xp_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 ){
			thread xp_award local.p 40 "kills" "Vehicle Destroyed"
		}
		local.i++
	}
}end


//=========================================================================
// Support calls: +15 to the caller (binoc bombing run / signal-smoke paradrop).
//=========================================================================
xp_support_call local.player local.kind:{
	if( level.coop_xp_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	local.label = "Support Call"
	if( local.kind == "bombing" ){ local.label = "Air Strike" }
	else if( local.kind == "paradrop" ){ local.label = "Paradrop" }
	thread xp_award local.player 15 "support" local.label
}end


//=========================================================================
// Paratrooper roster: register at spawn; each one still alive at mission end
// pays its caller +10 (escort the squad instead of spending it).
//=========================================================================
xp_para_register local.actor local.owner:{
	if( level.coop_xp_enabled != 1 ){ end }
	if( local.actor == NULL || local.owner == NULL ){ end }
	local.n = level.coop_xp_paraN
	level.coop_xp_para[local.n]    = local.actor
	level.coop_xp_paraOwn[local.n] = local.owner
	level.coop_xp_paraN = local.n + 1
}end


//=========================================================================
// Team-wide objective awards. Gate: active for >=50% of elapsed map time
// (stops join-at-the-end freeloading without punishing mid-map joiners hard).
//=========================================================================
xp_team_award local.amount local.reason local.label:{
	if( level.coop_xp_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && local.p.flags["coop_xp_join"] != NIL ){
			if( local.p.flags["coop_xp_join"] <= (level.time * 0.5) ){
				thread xp_award local.p local.amount local.reason local.label
			}
		}
		local.i++
	}
}end

// radio side objective destroyed
xp_radio_done:{
	if( level.coop_xp_radioPaid == 1 ){ end }
	level.coop_xp_radioPaid = 1
	waitthread xp_team_award 20 "objective" "Radio Destroyed"		// [user 07-08] objectives are worth 20 XP
}end

// a primary map objective flipped to completed (global/objectives.scr status==3).
// level.coop_xp_sideObjPush guards out the coop side-objective pushes (they pay separately).
xp_primary_done local.index:{
	if( level.coop_xp_enabled != 1 ){ end }
	if( level.coop_xp_sideObjPush == 1 ){ end }
	if( local.index == NIL ){ local.index = 0 }
	if( level.coop_xp_objPaid[local.index] == 1 ){ end }
	level.coop_xp_objPaid[local.index] = 1
	waitthread xp_team_award 20 "objective" "Objective"		// [user 07-08] objectives are worth 20 XP
}end


//=========================================================================
// XP GAIN POPUP (slots 62 emblem, 63 gain text, 64 bar bg, 65 bar fill).
// Top-center, appears ONLY when XP lands (xp_award pokes popupGain/popupUntil
// and threads this; singleton per player). The bar shows progress INTO the
// current rank bracket and eases toward the new value; more XP while visible
// extends the hold and accumulates the "+N XP" readout. Fades out after 2.5s.
//=========================================================================
xp_hud_popup local.player:{
	if( level.coop_xp_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( level.coop_xp_summaryActive == 1 ){ end }		// [fix] the debrief card owns slots 62-69 at mission end - no top gain popup on top of it
	if( local.player.flags["coop_xp_popupOn"] == 1 ){ end }
	if( local.player.flags["coop_xp_rank"] == NIL ){ end }
	if( level.coop_xp_rankMax == NIL ){ level.coop_xp_rankMax = 21 }		// defensive: unset max -> ceil=floor+1 -> bar reads full
	local.player.flags["coop_xp_popupOn"] = 1

	local.rank = local.player.flags["coop_xp_rank"]
	local.rn = local.rank
	if( local.rn < 10 ){ local.rn = "0" + local.rn }

	// [217] modern brass-on-steel layered bar (design + assets: _research/ui_modernization.md 1.2-1.4)
	// slots: 62 base plate, 63 fill, 64 shine sweep, 65 head glint, 66 rank-up halo,
	//        67 emblem plate, 68 emblem, 69 gain text. Higher slot = drawn on top.
	ihuddraw_virtualsize local.player 62 1
	ihuddraw_align       local.player 62 left top
	ihuddraw_shader      local.player 62 "textures/hud/xpbar/xpbar_base"
	ihuddraw_rect        local.player 62 253 30 134 12
	ihuddraw_alpha       local.player 62 0.92

	ihuddraw_virtualsize local.player 63 1
	ihuddraw_align       local.player 63 left top
	ihuddraw_shader      local.player 63 "textures/hud/xpbar/xpbar_fill"
	ihuddraw_rect        local.player 63 263 33 0 5
	ihuddraw_alpha       local.player 63 1

	ihuddraw_virtualsize local.player 64 1
	ihuddraw_align       local.player 64 left top
	ihuddraw_shader      local.player 64 "textures/hud/xpbar/xpbar_shine"
	ihuddraw_rect        local.player 64 263 33 0 5
	ihuddraw_alpha       local.player 64 0.85

	ihuddraw_virtualsize local.player 65 1
	ihuddraw_align       local.player 65 left top
	ihuddraw_shader      local.player 65 "textures/hud/xpbar/xpbar_head"
	ihuddraw_rect        local.player 65 263 33 8 5		// [user 07-18 bug-819] y32 h7 -> y33 h5: the glint was TALLER than the ~6px groove (tex y21..96 vs channel y27..94), poking out top AND bottom of the frame; seat it in the channel like the fill (263 33 w 5)
	ihuddraw_alpha       local.player 65 0

	ihuddraw_virtualsize local.player 66 1
	ihuddraw_align       local.player 66 left top
	ihuddraw_shader      local.player 66 "textures/hud/xpbar/xpbar_glow"
	ihuddraw_rect        local.player 66 236 21 32 32
	ihuddraw_alpha       local.player 66 0

	ihuddraw_virtualsize local.player 67 1
	ihuddraw_align       local.player 67 left top
	ihuddraw_shader      local.player 67 "textures/hud/xpbar/xpbar_plate"
	ihuddraw_rect        local.player 67 244 28 17 17
	ihuddraw_alpha       local.player 67 0.95

	ihuddraw_virtualsize local.player 68 1
	ihuddraw_align       local.player 68 left top
	ihuddraw_shader      local.player 68 ( "textures/hud/coop_rank_" + local.rn )
	ihuddraw_rect        local.player 68 246 30 13 13
	ihuddraw_alpha       local.player 68 1

	ihuddraw_virtualsize local.player 69 1
	ihuddraw_align       local.player 69 left top
	ihuddraw_font        local.player 69 "verdana-12"
	ihuddraw_color       local.player 69 0.95 0.85 0.45
	ihuddraw_rect        local.player 69 392 31 0 0
	ihuddraw_alpha       local.player 69 1

	local.shownW = -1
	local.shownGain = -1
	local.glowA = 0

	while( local.player != NULL && level.time < local.player.flags["coop_xp_popupUntil"] && level.coop_xp_summaryActive != 1 ){
		local.total = local.player.flags["coop_xp_total"]
		if( local.total == NIL ){ break }

		// rank-up while visible: swap emblem, restart the bar in the new bracket, pulse the halo
		if( local.player.flags["coop_xp_rank"] != local.rank ){
			local.rank = local.player.flags["coop_xp_rank"]
			local.rn = local.rank
			if( local.rn < 10 ){ local.rn = "0" + local.rn }
			ihuddraw_shader local.player 68 ( "textures/hud/coop_rank_" + local.rn )
			local.shownW = 0
			local.glowA = 0.9
		}

		local.floor = level.coop_xp_rankXP[local.rank]
		local.ceil  = local.floor + 1
		if( local.rank < level.coop_xp_rankMax ){ local.ceil = level.coop_xp_rankXP[local.rank + 1] }
		local.target = 120 * (local.total - local.floor) / (local.ceil - local.floor)
		if( local.target > 120 ){ local.target = 120 }
		if( local.target < 0 ){ local.target = 0 }

		if( local.shownW < 0 ){
			local.shownW = local.target - 15
			if( local.shownW < 0 ){ local.shownW = 0 }
		}
		local.shownW = local.shownW + ((local.target - local.shownW) * 0.25)
		local.w = int( local.shownW )
		// [user 07-18 bug-805] hard integer clamp to the plate groove (channel = x263..x383, w 120):
		// the fill and its glint must NEVER paint the frame bevel
		if( local.w < 0 ){ local.w = 0 }
		if( local.w > 120 ){ local.w = 120 }
		ihuddraw_rect local.player 63 263 33 local.w 5
		ihuddraw_rect local.player 64 263 33 local.w 5
		// head glint rides the fill edge (x = 263 + w - 4, precomputed: parse rules)
		local.hx = local.w + 259
		// [user 07-18 bug-805] cap the glint at the groove right edge: at full bar (w 120) it sat at
		// x379..387 = brass painted over the bevel out to the plate edge (387); channel ends x383
		if( local.hx > 375 ){ local.hx = 375 }
		ihuddraw_rect local.player 65 local.hx 33 8 5		// [user 07-18 bug-819] y32 h7 -> y33 h5: seat the leading-edge glint INSIDE the channel (was taller than the groove, bulging out top/bottom of the frame)
		if( local.w < 4 ){
			ihuddraw_alpha local.player 65 0
		} else {
			ihuddraw_alpha local.player 65 0.9
		}

		// rank-up halo decay
		if( local.glowA > 0.02 ){
			ihuddraw_alpha local.player 66 local.glowA
			local.glowA = local.glowA * 0.90
		} else if( local.glowA != 0 ){
			local.glowA = 0
			ihuddraw_alpha local.player 66 0
		}

		local.gain = local.player.flags["coop_xp_popupGain"]
		if( local.gain != NIL && local.gain != local.shownGain ){
			local.shownGain = local.gain
			ihuddraw_string local.player 69 ( "+" + local.gain + " XP" )
		}
		waitframe
	}

	// fade out (scale every layer toward 0)
	// [user 07-18 bug-804] snap out INSTANTLY when the debrief card takes the slots: the timed fade
	// tail (9 x 0.04 frame-quantized to ~0.5s) ended only ONE frame before the card's first draw, so
	// any mission-end hitch (xp_flush file writes / challenge award loops) landed these alpha writes
	// and the slot-69 string-clear ON TOP of the card - the debrief bar dimmed/blanked while filling.
	local.a = 9
	while( local.a > 0 && local.player != NULL && level.coop_xp_summaryActive != 1 ){
		local.f = local.a * 0.1
		local.s = 62
		while( local.s <= 69 ){
			ihuddraw_alpha local.player local.s local.f
			local.s++
		}
		local.a--
		wait 0.04
	}
	if( local.player != NULL ){
		local.s = 62
		while( local.s <= 69 ){
			ihuddraw_alpha local.player local.s 0
			local.s++
		}
		ihuddraw_string local.player 69 ""
		local.player.flags["coop_xp_popupOn"]   = NIL
		local.player.flags["coop_xp_popupGain"] = NIL
	}
}end


//=========================================================================
// End-of-map debrief card (slots 62-69). Called with waitthread from
// missioncomplete.scr BEFORE the transition; blocks ~coop_xpSummaryTime sec.
// Also pays the mission / no-death / paratrooper-survival awards first.
//=========================================================================
xp_summary:{
	if( level.coop_xp_enabled != 1 ){ end }
	// [user 07-18 bug-804] singleton: a double mission-complete fire (end trigger touched by two
	// players the same frame) ran TWO debrief sequences interleaved on the SAME slots - the fill
	// width flip-flopped between both animations every tick. One debrief per map, period.
	if( level.coop_xp_summaryRun == 1 ){ end }
	level.coop_xp_summaryRun = 1
	local.t = getcvar "coop_xpSummaryTime"
	if( local.t == "" ){ local.t = 28 }		// [user 07-11] even longer - the bar should linger well after it fills to this map's XP (was 16/18)
	local.t = int( local.t )
	if( local.t > 0 ){ level.coop_xp_summaryActive = 1 }		// [fix] the card owns the mission-end HUD: suppress the top gain popup / micro popup / promo ceremony that share its slots (62-73). Only when the card actually shows.

	// mission complete + no-death bonuses (awarded even when the card is disabled)
	waitthread xp_team_award 100 "mission" "Mission Complete"		// [user 07-10] 200 -> 100
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 ){
			if( local.p.flags["coop_deaths"] == NIL || local.p.flags["coop_deaths"] == 0 ){
				thread xp_award local.p 50 "mission" "Deathless"
			}
		}
		local.i++
	}
	// [user 07-12] "MADE IT" bonus: reward players who are ALIVE AT THE END POINT when the mission
	// completes - pays off sticking together and pushing to the exit instead of lagging behind.
	// Anchor = level.coop_xp_endPoint (captured in global/missioncomplete.scr from the end trigger's
	// inherited self). If no anchor was recorded (mission ended without a positional trigger), every
	// alive active player counts as having made it. Tunables: coop_xpEndBonus / coop_xpEndRadius.
	local.bXP = getcvar "coop_xpEndBonus"
	if( local.bXP == "" ){ local.bXP = 75 }
	local.bXP = int( local.bXP )
	local.bR = getcvar "coop_xpEndRadius"
	if( local.bR == "" ){ local.bR = 2500 }
	local.bR = int( local.bR )
	if( local.bXP > 0 ){
		local.i = 1
		while( local.i <= $player.size ){
			local.p = $player[local.i]
			if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && isAlive local.p && local.p.dmteam != "spectator" ){
				if( level.coop_xp_endPoint == NIL || vector_length( local.p.origin - level.coop_xp_endPoint ) < local.bR ){
					thread xp_award local.p local.bXP "mission" "Made It To The End"
				}
			}
			local.i++
		}
	}

	// paratrooper survival: +10 to the caller per trooper still standing
	local.n = 0
	while( local.n < level.coop_xp_paraN ){
		local.a = level.coop_xp_para[local.n]
		local.o = level.coop_xp_paraOwn[local.n]
		if( local.a != NULL && local.o != NULL ){
			if( isAlive local.a ){
				thread xp_award local.o 10 "support" "Paratrooper Alive"
			}
		}
		local.n++
	}
	waitframe

	if( local.t <= 0 ){ end }

	wait 0.5		// [fix] let any in-flight gain popup from a pre-mission-end kill finish fading + clear slots 62-69 before the card draws over them

	// ---- the card ----
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && local.p.flags["coop_xp_id"] != NIL ){
			thread xp_summary_card local.p
		}
		local.i++
	}
	// [user 07-12] FREEZE the squad for the whole debrief - no running around during the rank/score
	// ceremony. freezecontrols is re-asserted in the 2s loop below (m_bFrozen can reset on player
	// churn - the bug-367 lobby lesson) and released the moment the card ends.
	local.pj = 1
	while( local.pj <= $player.size ){
		local.pk = $player[local.pj]
		if( local.pk != NULL && local.pk.flags["coop_isActive"] == 1 ){ local.pk freezecontrols 1 }
		local.pj++
	}

	// [user 07-11] keep the HUD AWAKE for the whole debrief. The HUD-fade multiplies EVERY huddraw slot < 100
	// (the debrief card is 62-73), so after ~5 quiet seconds it faded the card + rank bar off. Poke
	// coop_hudPoke on each player every 2s so s_hudFadeAlpha stays 1 while the card is up (cgame watches the
	// cvar for a change - cg_drawtools.cpp CG_UpdateHudFade).
	local.held = 0
	while( local.held < local.t ){
		local.pj = 1
		while( local.pj <= $player.size ){
			local.pk = $player[local.pj]
			if( local.pk != NULL ){
				local.pk stufftext ( "seta coop_hudPoke " + level.time )
				if( local.pk.flags["coop_isActive"] == 1 ){ local.pk freezecontrols 1 }	// re-assert the debrief freeze
			}
			local.pj++
		}
		wait 2
		local.held = local.held + 2
	}

	// [user 07-12] release the debrief freeze (unfreeze EVERYONE, not just actives - safe either way;
	// the map transition follows right after)
	local.pj = 1
	while( local.pj <= $player.size ){
		local.pk = $player[local.pj]
		if( local.pk != NULL ){ local.pk freezecontrols 0 }
		local.pj++
	}
	level.coop_xp_summaryActive = 0		// [fix] restore normal gain/micro popups + promo ceremony after the card
}end

// [235] per-player ANIMATED debrief (user design): enlarged insignia centered above a
// center-screen bar; the bar fills from where the match STARTED to where it ENDED, rolling
// through every rank crossed (cinematic M1 ping + insignia swap per rank-up); category
// totals reveal one at a time under the bar with a click, synced to the fill.
xp_summary_card local.p:{
	if( local.p == NULL ){ end }
	if( local.p.flags["coop_xp_cardOn"] == 1 ){ end }		// [user 07-18 bug-804] one card per player - a second thread on the same slots is the glitch machine
	local.p.flags["coop_xp_cardOn"] = 1
	if( level.coop_xp_rankMax == NIL ){ level.coop_xp_rankMax = 21 }		// defensive: unset max -> ceil=floor+1 -> fill reads full (matches xp_hud_popup / xp_rankForTotal)

	local.rank0 = local.p.flags["coop_xp_rankmapstart"]
	local.rank1 = local.p.flags["coop_xp_rank"]
	if( local.rank0 == NIL ){ local.rank0 = local.rank1 }
	local.total = local.p.flags["coop_xp_total"]
	local.map   = local.p.flags["coop_xp_map"]
	local.from  = local.total - local.map

	// title (top center)
	ihuddraw_virtualsize local.p 63 1
	ihuddraw_align       local.p 63 center top
	ihuddraw_font        local.p 63 "facfont-20"
	ihuddraw_color       local.p 63 0.95 0.9 0.7
	ihuddraw_rect        local.p 63 0 56 0 0
	ihuddraw_string      local.p 63 ( "SQUAD DEBRIEF  -  +" + local.map + " XP" )
	ihuddraw_alpha       local.p 63 1

	// enlarged insignia CENTERED above the bar (halo behind), starting at the MATCH-START rank
	local.rn = local.rank0
	if( local.rn < 10 ){ local.rn = "0" + local.rn }
	ihuddraw_virtualsize local.p 70 1
	ihuddraw_align       local.p 70 left top
	ihuddraw_shader      local.p 70 "textures/hud/xpbar/xpbar_glow"
	ihuddraw_rect        local.p 70 272 148 96 96
	ihuddraw_alpha       local.p 70 0.45

	ihuddraw_virtualsize local.p 71 1
	ihuddraw_align       local.p 71 left top
	ihuddraw_shader      local.p 71 ( "textures/hud/coop_rank_" + local.rn )
	ihuddraw_rect        local.p 71 292 168 56 56
	ihuddraw_alpha       local.p 71 1

	// [user 07-08] center-screen bar = the SAME clean brass-on-steel xpbar used at the top of the screen
	// (xpbar_base plate + xpbar_fill), not the old flat coop_bar_white. Fill is inset in the plate like the HUD bar.
	ihuddraw_virtualsize local.p 64 1
	ihuddraw_align       local.p 64 left top
	ihuddraw_shader      local.p 64 "textures/hud/xpbar/xpbar_base"
	ihuddraw_color       local.p 64 1 1 1
	ihuddraw_rect        local.p 64 212 234 216 14
	ihuddraw_alpha       local.p 64 0.92

	ihuddraw_virtualsize local.p 65 1
	ihuddraw_align       local.p 65 left top
	ihuddraw_shader      local.p 65 "textures/hud/xpbar/xpbar_fill"
	ihuddraw_color       local.p 65 1 1 1
	ihuddraw_rect        local.p 65 228 238 0 6
	ihuddraw_alpha       local.p 65 1

	// category totals reveal in parallel, clicks synced under the fill
	thread xp_card_categories local.p

	// [user 07-18 debrief-unlock-list] "UNLOCKED THIS MISSION" list under the card (slots 127-134,
	// fade-exempt free block). Draws nothing when this map unlocked nothing.
	thread xp_card_unlocks local.p

	// multi-bracket fill: from -> total, ping + insignia swap + bar reset per rank crossing
	local.r = local.rank0
	local.cur = local.from
	local.guard = 0
	while( local.p != NULL && local.guard < 24 ){
		local.floor = level.coop_xp_rankXP[local.r]
		local.ceil  = local.floor + 1
		if( local.r < level.coop_xp_rankMax ){ local.ceil = level.coop_xp_rankXP[local.r + 1] }
		if( local.cur < local.floor ){ local.cur = local.floor }
		local.segEnd = local.total
		if( local.segEnd > local.ceil ){ local.segEnd = local.ceil }

		// [user 07-18 bug-804] re-assert the card layers at each bracket: a straggler alpha write from
		// a retiring gain-popup fade would otherwise stick (invisible/dimmed bar) for the whole fill
		ihuddraw_alpha local.p 63 1
		ihuddraw_alpha local.p 64 0.92
		ihuddraw_alpha local.p 65 1

		local.steps = 70		// [user 07-08] slower fill so you can actually read it (was 40 @ waitframe = ~1s)
		local.s = 0
		while( local.s <= local.steps ){
			if( local.p == NULL ){ end }
			local.v = local.cur + ((local.segEnd - local.cur) * local.s / local.steps)
			local.w = int( 194 * (local.v - local.floor) / (local.ceil - local.floor) )	// [user 07-18] 184->194: match the base-plate groove (was under-reaching the channel)
			if( local.w < 0 ){ local.w = 0 }
			if( local.w > 194 ){ local.w = 194 }
			ihuddraw_rect local.p 65 228 238 local.w 6
			local.s++
			wait 0.035
		}
		local.cur = local.segEnd

		local.remain = local.total - local.cur
		if( local.remain <= 0 ){ break }

		// crossed a rank boundary with more to fill: THE moment (ping + swap + reset)
		if( local.r < level.coop_xp_rankMax ){
			local.r = local.r + 1
			local.rn = local.r
			if( local.rn < 10 ){ local.rn = "0" + local.rn }
			// [user 07-18] REMOVED xp_ping_duck: it dipped s_volume (the MASTER volume) to 0.20, which
			// lowered the M1 PING itself too (s_volume is not selective) - the ping sounded cut/quiet.
			// [user 08-02] same s_sfxduck treatment as the ceremony site - see the note there.
			local.p stufftext "s_sfxduck 0.25"
			local.p playsound coop_rankup_cine volume 3
			thread xp_ping_unduck local.p
			ihuddraw_alpha  local.p 70 0.95
			ihuddraw_shader local.p 71 ( "textures/hud/coop_rank_" + local.rn )
			ihuddraw_rect   local.p 65 228 238 0 6
			wait 0.8
			ihuddraw_alpha  local.p 70 0.45
		} else {
			break
		}
		local.guard++
	}

	// promotion toast (no chat - on-card only)
	if( local.p != NULL && local.rank1 > local.rank0 ){
		ihuddraw_virtualsize local.p 69 1
		ihuddraw_align       local.p 69 center top
		ihuddraw_font        local.p 69 "facfont-20"		// [user 07-10] smaller than handle-23 so long rank names don't run off screen
		ihuddraw_color       local.p 69 1 0.85 0.3
		ihuddraw_rect        local.p 69 0 316 0 0
		ihuddraw_string      local.p 69 ( "PROMOTED TO " + level.coop_xp_rankName[local.rank1] )
		ihuddraw_alpha       local.p 69 1
	}
	if( local.p != NULL ){ local.p.flags["coop_xp_cardOn"] = NIL }		// [user 07-18 bug-804]
}end

// [235] category totals under the debrief bar, one at a time, each with a click
xp_card_categories local.p:{
	if( local.p == NULL ){ end }
	local.keys[0] = "kills"
	local.keys[1] = "valor"
	local.keys[2] = "objective"
	local.keys[3] = "support"
	local.keys[4] = "revive"
	local.keys[5] = "mission"
	local.names[0] = "Kills"
	local.names[1] = "Valor"
	local.names[2] = "Objectives"
	local.names[3] = "Support"
	local.names[4] = "Revives"
	local.names[5] = "Mission"
	local.slots[0] = 62
	local.slots[1] = 66
	local.slots[2] = 67
	local.slots[3] = 68
	local.line = 0
	local.k = 0
	wait 1.2		// [user 07-08] let the bar start filling before the tally reveals
	while( local.k < 6 && local.line < 4 ){
		if( local.p == NULL ){ end }
		local.v = local.p.flags["coop_xp_b_" + local.keys[local.k]]
		if( local.v != NIL && local.v > 0 ){
			local.slot = local.slots[local.line]
			local.ly = (local.line * 14) + 254
			ihuddraw_virtualsize local.p local.slot 1
			ihuddraw_align       local.p local.slot center top
			ihuddraw_font        local.p local.slot "verdana-12"
			ihuddraw_color       local.p local.slot 0.85 0.85 0.85
			ihuddraw_rect        local.p local.slot 0 local.ly 0 0
			ihuddraw_string      local.p local.slot ( local.names[local.k] + "     " + local.v + " XP" )
			ihuddraw_alpha       local.p local.slot 0.9
			local.p playsound coop_ui_click
			local.line++
			wait 1.4		// [user 07-08] one category at a time, slow enough to read
		}
		local.k++
	}
}end

//=========================================================================
// [user 07-18 debrief-unlock-list] "UNLOCKED THIS MISSION:" list under the debrief card.
// Fed by the PER-MAP, PER-PLAYER accumulator in challenges.scr::chal_add_unlock
// (player.flags["coop_mapUnlockList"], a "~"-joined display-name string, stamped with the map
// name so a stale carry-over from a prior map reads as empty). Slots 127-134 sit in the free,
// fade-exempt (>=100) block - clear of the card's 62-73 and the lobby list's 117-126, and they
// never co-display (lobby vs mission-end). Empty list => draws nothing (no header). Centered
// below the category tally / promotion toast so it can't overlap the rank bar or insignia.
//=========================================================================
xp_card_unlocks local.p:{
	if( local.p == NULL ){ end }

	// only THIS map's unlocks: a stale stamp means the list is left over from a prior map -> treat empty
	local.pd = ""
	if( local.p.flags["coop_mapUnlockStamp"] == level.coop_mapname ){
		local.pd = local.p.flags["coop_mapUnlockList"]
	}
	if( local.pd == NIL ){ local.pd = "" }

	// split the "~"-separated names into up to 6 lines + an overflow count
	// (lobby.scr::lobbyUnlockList parse pattern - no engine split helper exists)
	local.n = 0
	local.extra = 0
	local.field = ""
	local.i = 0
	while( local.i <= local.pd.size ){
		local.done = 0
		if( local.i == local.pd.size ){ local.done = 1 }
		else if( local.pd[local.i] == "~" ){ local.done = 1 }
		if( local.done == 1 ){
			if( local.field != "" ){
				if( local.n < 6 ){ local.line[local.n] = local.field; local.n++ }
				else { local.extra++ }
			}
			local.field = ""
		} else {
			local.field += local.pd[local.i]
		}
		local.i++
	}

	// nothing unlocked this map -> draw NOTHING (no header) and make sure the block is clear
	if( local.n <= 0 ){
		for( local.s = 127; local.s <= 134; local.s++ ){ ihuddraw_alpha local.p local.s 0 }
		end
	}

	// header (center, tucked below the category tally y254-296 and promotion toast y316)
	ihuddraw_virtualsize local.p 127 1
	ihuddraw_align       local.p 127 center top
	ihuddraw_rect        local.p 127 0 340 0 0
	ihuddraw_font        local.p 127 "verdana-12"
	ihuddraw_string      local.p 127 "UNLOCKED THIS MISSION:"
	ihuddraw_color       local.p 127 1 0.85 0.4
	ihuddraw_alpha       local.p 127 0.95

	for( local.j = 0; local.j < 6; local.j++ ){
		local.s = 128 + local.j
		if( local.j < local.n ){
			local.ly = 356 + ( local.j * 14 )
			ihuddraw_virtualsize local.p local.s 1
			ihuddraw_align       local.p local.s center top
			ihuddraw_rect        local.p local.s 0 local.ly 0 0
			ihuddraw_font        local.p local.s "verdana-12"
			ihuddraw_string      local.p local.s local.line[local.j]
			ihuddraw_color       local.p local.s 0.85 0.95 0.85
			ihuddraw_alpha       local.p local.s 0.95
		} else {
			ihuddraw_alpha local.p local.s 0
		}
	}

	if( local.extra > 0 ){
		ihuddraw_virtualsize local.p 134 1
		ihuddraw_align       local.p 134 center top
		ihuddraw_rect        local.p 134 0 440 0 0
		ihuddraw_font        local.p 134 "verdana-12"
		ihuddraw_string      local.p 134 ( "+" + local.extra + " more" )
		ihuddraw_color       local.p 134 0.7 0.8 0.7
		ihuddraw_alpha       local.p 134 0.9
	} else {
		ihuddraw_alpha local.p 134 0
	}

	// hold for the debrief, then wipe the block. Slots >=100 are fade-exempt (never faded by the
	// HUD-fade), so unlike the card's 62-73 they MUST be cleared explicitly when the card ends.
	while( level.coop_xp_summaryActive == 1 && local.p != NULL ){ wait 1 }
	for( local.s = 127; local.s <= 134; local.s++ ){
		if( local.p != NULL ){ ihuddraw_alpha local.p local.s 0 }
	}
}end


//=========================================================================
// PROMOTION CEREMONY [222] - COD-style rank-up moment (slots 70-72, clear of
// the gain popup's 62-69): gold halo + the NEW emblem front and center + rank
// title, scored with the M1 Garand ping (snd_ping - the most satisfying sound
// this war produced). ~3s, then fades.
//=========================================================================
xp_promo_ceremony local.player local.rank:{
	if( local.player == NULL ){ end }
	if( level.coop_xp_summaryActive == 1 ){ end }		// [fix] at mission end the debrief card rolls the rank-up itself (insignia swap + ping + promo toast) - don't also fire the standalone ceremony over it
	if( local.player.flags["coop_xp_ceremony"] == 1 ){ end }
	local.player.flags["coop_xp_ceremony"] = 1

	local.rn = local.rank
	if( local.rn < 10 ){ local.rn = "0" + local.rn }

	// [235] CINEMATIC ping: M1 Garand ping with a reverb tail, then played in REVERSE (user
	// design). Generated asset sound/coop/coop_rankup_cine.wav, aliased in ubersound.
	// [user 07-18] REMOVED xp_ping_duck (s_volume master duck lowered the ping itself - sounded cut/quiet).
	// [user 08-02] Promotion audio, take two. The earlier attempt (xp_ping_duck, removed 07-18)
	// dipped s_volume - the MASTER - which quieted the ping itself, so it was abandoned. The right
	// lever is s_sfxduck: applied per-channel in the engine's openal_channel::set_gain, with MUSIC
	// EXPLICITLY EXEMPT, so the bed drops while the ceremony music does not. It is on the client
	// server-command whitelist, so a per-player stufftext is not dropped.
	// Ducked to 0.25 and the ping given "volume 3" on top (parse path: entity.cpp argstype=1
	// MULTIPLIES the alias volume; AL_MAX_GAIN is 8.0, so 1.4 * 3 is in range) - net effect the
	// ping sits far above the ducked bed instead of fighting it.
	// Per-player, NOT coop_setClientCvar/coop_cvarFade: those broadcast to every $player.
	local.player stufftext "s_sfxduck 0.25"
	local.player playsound coop_rankup_cine volume 3
	thread xp_ping_unduck local.player

	ihuddraw_virtualsize local.player 70 1
	ihuddraw_align       local.player 70 left top
	ihuddraw_shader      local.player 70 "textures/hud/xpbar/xpbar_glow"
	ihuddraw_rect        local.player 70 256 60 128 128
	ihuddraw_alpha       local.player 70 0.9

	ihuddraw_virtualsize local.player 71 1
	ihuddraw_align       local.player 71 left top
	ihuddraw_shader      local.player 71 ( "textures/hud/coop_rank_" + local.rn )
	ihuddraw_rect        local.player 71 288 92 64 64
	ihuddraw_alpha       local.player 71 1

	ihuddraw_virtualsize local.player 72 1
	ihuddraw_align       local.player 72 center top
	ihuddraw_font        local.player 72 "handle-23"
	ihuddraw_color       local.player 72 1 0.87 0.35
	ihuddraw_rect        local.player 72 0 162 0 0
	ihuddraw_string      local.player 72 "PROMOTED"
	ihuddraw_alpha       local.player 72 1

	// [user 07-10] rank name on its OWN line in a smaller font so long names (e.g. "General of the
	// Army", "Technician Fifth Grade") don't run off the screen when appended after "PROMOTED".
	ihuddraw_virtualsize local.player 73 1
	ihuddraw_align       local.player 73 center top
	ihuddraw_font        local.player 73 "facfont-20"
	ihuddraw_color       local.player 73 1 0.87 0.35
	ihuddraw_rect        local.player 73 0 190 0 0
	ihuddraw_string      local.player 73 level.coop_xp_rankName[local.rank]
	ihuddraw_alpha       local.player 73 1

	// halo breathes while the emblem holds (no modulo - unverified operator, bug-302 lesson)
	local.t = 0
	local.pulse = 0
	while( local.t < 22 && local.player != NULL ){
		local.a = 0.55 + (local.pulse * 0.07)
		ihuddraw_alpha local.player 70 local.a
		local.pulse++
		if( local.pulse > 5 ){ local.pulse = 0 }
		wait 0.12
		local.t++
	}

	local.a = 9
	while( local.a > 0 && local.player != NULL ){
		local.f = local.a * 0.1
		ihuddraw_alpha local.player 70 local.f
		ihuddraw_alpha local.player 71 local.f
		ihuddraw_alpha local.player 72 local.f
		ihuddraw_alpha local.player 73 local.f
		local.a--
		wait 0.05
	}
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 70 0
		ihuddraw_alpha  local.player 71 0
		ihuddraw_alpha  local.player 72 0
		ihuddraw_alpha  local.player 73 0
		ihuddraw_string local.player 72 ""
		ihuddraw_string local.player 73 ""
		local.player.flags["coop_xp_ceremony"] = NIL
	}
}end


//=========================================================================
// Persist every known player's total to file. Called on rank-ups, mission
// complete, maptest transitions and the 60s autosave.
//=========================================================================
xp_flush:{
	if( level.coop_xp_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_xp_id"] != NIL ){
			fs_write_content ( "coop_mod/save/xp_" + local.p.flags["coop_xp_id"] + ".dat" ) ( "" + local.p.flags["coop_xp_total"] )
		}
		local.i++
	}
}end


//=========================================================================
//[user 07-16] Grant the weapon unlocks for ranks fromRank..toRank (inclusive).
//Funnels through challenges.scr::chal_add_unlock (dedups + persists), then refreshes the armory UI.
//=========================================================================
xp_rank_unlock local.player local.fromRank local.toRank:{
	if( local.player == NULL ){ end }
	if( local.fromRank < 1 ){ local.fromRank = 1 }
	if( local.toRank > level.coop_xp_rankMax ){ local.toRank = level.coop_xp_rankMax }
	local.r = local.fromRank
	while( local.r <= local.toRank ){
		local.k = level.coop_xp_rankUnlockCnt[local.r]
		if( local.k != NIL && local.k > 0 ){
			local.j = 0
			while( local.j < local.k ){
				waitthread coop_mod/challenges.scr::chal_add_unlock local.player level.coop_xp_rankUnlock[local.r][local.j]
				local.j++
			}
		}
		local.r++
	}
	thread coop_mod/loadoutpick.scr::loadout_ui_exportUnlocks local.player
}end

//=========================================================================
// [user 08-02] Restore s_sfxduck in steps after a promotion ping.
// MUST be guarded against disconnect at every wait: s_sfxduck is CVAR_ARCHIVE, so a player who
// leaves mid-ceremony would otherwise keep a permanently ducked mix in their SAVED config.
//=========================================================================
xp_ping_unduck local.player:{
//=========================================================================
	wait 1.6
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 0.55"
	wait 0.35
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 0.8"
	wait 0.35
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 1"
}end
