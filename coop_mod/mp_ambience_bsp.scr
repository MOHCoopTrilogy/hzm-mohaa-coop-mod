//GENERATED by docs/tools/gen_mp_ambience.py -- DO NOT HAND-EDIT (regenerate instead).
//MP environmental ambience for the BSP-derived Push maps. Harvested from global/ambience.scr
//(coord beds) + each map script's ambient loopsounds. Replayed via mp_ambience.scr::emit /
//::bedWind. Wired from mp_ambience.scr::start as the fallback for maps it does not list.
//coop_mpRun-guarded upstream; a compile canary on every MP boot.
alive:{
	end 1
}end

//Start the BSP-derived map's ambience (returns 1 if it handled the map, else 0).
startBsp local.map:{
	if( level.coop_mpRun != 1 ){ end 0 }
	switch( local.map ){
		case "t3l1":
			waitthread amb_t3l1
			break
		case "t2l1":
			waitthread amb_t2l1
			break
		case "t2l3":
			waitthread amb_t2l3
			break
		case "t2l4":
			waitthread amb_t2l4
			break
		case "m5l2a":
			waitthread amb_m5l2a
			break
		case "m5l2b":
			waitthread amb_m5l2b
			break
		case "m3l1b":
			waitthread amb_m3l1b
			break
		case "m2l3":
			waitthread amb_m2l3
			break
		case "m1l3a":
			waitthread amb_m1l3a
			break
		case "m1l3b":
			waitthread amb_m1l3b
			break
		case "e1l1":
			waitthread amb_e1l1
			break
		case "e3l1":
			waitthread amb_e3l1
			break
		case "e3l2":
			waitthread amb_e3l2
			break
		case "e3l3":
			waitthread amb_e3l3
			break
		case "t1l1":
			waitthread amb_t1l1
			break
		case "t1l2":
			waitthread amb_t1l2
			break
		case "t1l3":
			waitthread amb_t1l3
			break
		case "m5l3":
			waitthread amb_m5l3
			break
		default:
			waitthread coop_mod/mp_ambience.scr::bedWind
			break
	}
	end 1
}end 1

