//========================================================================================
// HZM Coop - MENU MIRROR: show every player the briefing slides and title cards the host sees (bug-3234).
//
// Player report: "Cant see the briefing that the hosts sees". Map scripts show briefing slides and the
// intro title cards ("June 6, 1944 / Omaha Beach", "Dec 24, 1944 / Ardennes", "THE END") with
// `showmenu <menu>` / `hidemenu <menu>`. The engine sends those to each client as
// `stufftext "showmenu ..."` (sv_game.c PF_UI_ShowMenu), and the client command filter admits
// showmenu, hidemenu and cinematic ONLY from a server the client itself is running
// (qcommon/cmd_filter.c whiteListedLocalServerCommands, gated on cgs.localServer). So the listen host
// saw them and every other player did not - on a dedicated server nobody did. The host's own path is
// left exactly as it was; this file only adds a per-player copy for everyone else.
//
// Who is "everyone else": every player except entnum 0 on a listen server (the player.scr coop_isHost
// rule). On a dedicated server that is every player.
//
// Two routes, because the two kinds of menu live in different conditions:
//
// SLIDES (maps/briefing/briefing1-6.scr, fullscreen multi-widget URCs with the ready-up overlay):
//   `ui_addhud <menu>` / `ui_removehud <menu>` per player - the jeep-prompt recipe (maps/M1L3a.scr
//   coop_jeepEnter), both on the everyone-whitelist. ui_addhud shows the same URC unfocused, so
//   [Use]/F still reaches the ready gate. A ui_addhud panel is hidden while PMF_NO_HUD is set, but the
//   coop briefing runs with drawhud 1 (readygate.scr coop_readyGateStart), and it is multiplied by the
//   HUD calm-fade, which is kept awake with the coop_hudPoke recipe (xp.scr debrief card).
//   Delivery: change-tracked per player plus a forced resend every 2 s (the readygate coop_gateSet
//   recipe), which also covers a stufftext dropped while the client was still loading (bug-595) and
//   a player who joins in the middle of the briefing. Slides have no motion, so a resend is invisible.
//
// TITLE CARDS (global/fadein.scr callers, m3l1a, m6l3e, t2l1, t2l3, t3l1): these are shown over a
//   black fade with `drawhud 0` in force, which hides every ui_addhud panel - so they are drawn as
//   per-player ihuddraw elements instead (the readygate/lobby recipe, cg_huddraw_force 1), which cgame
//   draws above the fade and the letterbox (cl_uiview3d.cpp View3D::Draw2D). Slots 236-239: the
//   fade-exempt band (>= 100) is full, so this is the documented never-concurrent reuse of the
//   menu/lobby-only challenge service-record counts (232-249, _research/hud_slot_map.md) - title
//   cards only exist during a mission's intro fade or its closing card. The shader and placement come from each card's
//   URC (table generated by docs/proposals/briefing_joiners_2026-09-28/tools/gen_card_table.py), and
//   the URC's `fadein 1` is reproduced as a one second alpha ramp from the moment the host's appeared.
//   ihuddraw rides one unreliable snapshot (TRAPS T8), so a card that is up is re-sent every second and
//   its teardown goes through coop_mod/hudresend.scr (claim on the shown edge, resend after the hide).
//
// USE:
//   slides:  waitthread coop_mod/menumirror.scr::coop_mirrorSlide "briefing1a"   (after the showmenu)
//            waitthread coop_mod/menumirror.scr::coop_mirrorSlideEnd              (in endbriefing)
//   cards:   waitthread coop_mod/menumirror.scr::coop_mirrorCard <menu>           (after the showmenu)
//            waitthread coop_mod/menumirror.scr::coop_mirrorCardHide <menu>       (after the hidemenu)
//   All of them return at once, are no-ops in single player, and accept NIL.
//========================================================================================

//=========================================================================
// 1 when local.p must get the per-player copy (everyone but the listen host)
//=========================================================================
coop_mirrorWants local.p:{
//=========================================================================
	if( local.p == NULL ){ end 0 }
	if( level.coop_dedicated != 1 && local.p.entnum == 0 ){ end 0 }
	end 1
}end

//=========================================================================
// coop_quietNotices - 1 on a briefing map (maps/briefing/*: the AA slide briefings and the SH/BT films), else 0.
// The armory/unlock toasts (loadoutpick.scr, helmet.scr, player.scr) are noise over a briefing; each print is
// wrapped in this test. The loadout itself still applies, and every real mission map shows them as before.
// The same test as the bug-722 / bug-788 briefing gate (challenges.scr, missioncomplete.scr). Not cached: the
// prints are rare, and a cache filled before level.coop_mapname is set would be wrong for the whole map.
//=========================================================================
coop_quietNotices:{
//=========================================================================
	if( level.coop_mapname == NIL ){ end 0 }
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "briefing" 0 ){ end 1 }
	end 0
}end

//=========================================================================
// SLIDES
//=========================================================================
coop_mirrorSlide local.menu:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( local.menu == NIL ){ end }
	// the main slide sequence keeps running after a ready-gate skip; never restart the sync then
	if( level.coop_briefingEnded == 1 ){ end }
	if( level.coop_slideSyncOn != 1 ){
		// seed at the reader (TRAPS: reading an unassigned level var creates it as type none)
		level.coop_slide = ""
		level.coop_slidePrev = ""
	}
	if( level.coop_slide != "" && level.coop_slide != local.menu ){
		level.coop_slidePrev = level.coop_slide
	}
	level.coop_slide = local.menu
	println ( "^~^~^ MENUMIRROR slide " + local.menu )
	if( level.coop_slideSyncOn != 1 ){
		level.coop_slideSyncOn = 1
		thread coop_mirrorSlideSync
	}
}end

//=========================================================================
coop_mirrorSlideSync:{
//=========================================================================
	local.tick = 0
	while( level.coop_slideSyncOn == 1 ){
		local.force = 0
		local.tick = local.tick + 1
		if( local.tick >= 4 ){
			local.tick = 0
			local.force = 1
		}
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			local.want = waitthread coop_mirrorWants local.p
			if( local.want != 1 ){ continue }
			waitthread coop_mirrorSlideSend local.p local.force
		}
		wait 0.5
	}
}end

//=========================================================================
// one player's slide state + the HUD-fade keep-awake. One statement per stufftext, unquoted (TRAPS T8).
//=========================================================================
coop_mirrorSlideSend local.p local.force:{
//=========================================================================
	if( local.p == NULL ){ end }
	local.cur = level.coop_slide
	local.sent = local.p.flags["coop_slideSent"]
	if( local.sent == NIL ){ local.sent = "" }

	local.go = 0
	if( local.force == 1 ){ local.go = 1 }
	if( local.sent != local.cur ){ local.go = 1 }
	if( local.go == 1 ){
		if( local.sent != "" && local.sent != local.cur ){
			local.p stufftext ( "ui_removehud " + local.sent )
		}
		// a dropped removal would leave the previous slide up: repeat it on the forced pass
		if( local.force == 1 && level.coop_slidePrev != "" && level.coop_slidePrev != local.cur ){
			local.p stufftext ( "ui_removehud " + level.coop_slidePrev )
		}
		if( local.cur != "" ){
			local.p stufftext ( "ui_addhud " + local.cur )
		}
		if( local.sent != local.cur ){
			println ( "^~^~^ MENUMIRROR slide " + local.cur + " -> entnum " + local.p.entnum )
		}
		local.p.flags["coop_slideSent"] = local.cur
	}

	// HUD-fade keep-awake: any change of coop_hudPoke counts as activity (cg_drawtools.cpp CG_UpdateHudFade).
	// Once a second, so even the 1 s minimum coop_hudFadeTime never starts the fade-out.
	local.next = local.p.flags["coop_slidePokeNext"]
	if( local.next == NIL ){ local.next = 0 }
	if( level.time >= local.next ){
		local.p.flags["coop_slidePokeNext"] = level.time + 0.9
		local.p stufftext ( "seta coop_hudPoke " + level.time )
	}
}end

//=========================================================================
// stop the slide sync and take the slide off every remote screen (sent twice, 1 s apart)
//=========================================================================
coop_mirrorSlideEnd:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( level.coop_slideSyncOn != 1 ){ end }
	level.coop_slideSyncOn = 0
	println "^~^~^ MENUMIRROR slides cleared"
	waitthread coop_mirrorSlideClear
	thread coop_mirrorSlideClearLate
}end

//=========================================================================
coop_mirrorSlideClearLate:{
//=========================================================================
	wait 1
	waitthread coop_mirrorSlideClear
}end

//=========================================================================
coop_mirrorSlideClear:{
//=========================================================================
	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		local.want = waitthread coop_mirrorWants local.p
		if( local.want != 1 ){ continue }
		if( level.coop_slide != "" ){
			local.p stufftext ( "ui_removehud " + level.coop_slide )
		}
		if( level.coop_slidePrev != "" && level.coop_slidePrev != level.coop_slide ){
			local.p stufftext ( "ui_removehud " + level.coop_slidePrev )
		}
		local.p.flags["coop_slideSent"] = NIL
	}
}end

//=========================================================================
// TITLE CARDS
//=========================================================================
coop_mirrorCard local.menu:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( local.menu == NIL ){ end }
	waitthread coop_cardInit
	if( level.coop_cardShader[local.menu] == NIL ){
		println ( "^~^~^ MENUMIRROR no card entry for " + local.menu )
		end
	}
	// already up: keep its slot. Otherwise the first free one of four.
	local.slot = 0 - 1
	for( local.k = 0; local.k < 4; local.k++ ){
		if( level.coop_cardOn[local.k] == local.menu ){ local.slot = local.k }
	}
	if( local.slot < 0 ){
		for( local.k = 0; local.k < 4; local.k++ ){
			if( local.slot < 0 && level.coop_cardOn[local.k] == "" ){ local.slot = local.k }
		}
	}
	if( local.slot < 0 ){ end }
	level.coop_cardOn[local.slot] = local.menu
	level.coop_cardT0[local.slot] = level.time
	level.coop_cardGen[local.slot] = level.coop_cardGen[local.slot] + 1
	println ( "^~^~^ MENUMIRROR card " + local.menu + " slot " + ( 236 + local.slot ) )
	if( level.coop_cardSyncOn != 1 ){
		level.coop_cardSyncOn = 1
		thread coop_cardSync
	}
}end

//=========================================================================
coop_mirrorCardHide local.menu:{
//=========================================================================
	if( level.gametype == 0 ){ end }
	if( local.menu == NIL ){ end }
	if( level.coop_cardInitDone != 1 ){ end }
	for( local.k = 0; local.k < 4; local.k++ ){
		if( level.coop_cardOn[local.k] == local.menu ){
			level.coop_cardOn[local.k] = ""
			println ( "^~^~^ MENUMIRROR card " + local.menu + " hidden" )
		}
	}
}end

//=========================================================================
// 0.1 s loop while any card is up (plus one last pass that takes them down), forced re-send each 1 s
//=========================================================================
coop_cardSync:{
//=========================================================================
	local.tick = 0
	local.run = 1
	while( local.run == 1 ){
		local.any = 0
		for( local.k = 0; local.k < 4; local.k++ ){
			if( level.coop_cardOn[local.k] != "" ){ local.any = 1 }
		}
		local.force = 0
		local.tick = local.tick + 1
		if( local.tick >= 10 ){
			local.tick = 0
			local.force = 1
		}
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			local.want = waitthread coop_mirrorWants local.p
			if( local.want != 1 ){ continue }
			for( local.k = 0; local.k < 4; local.k++ ){
				waitthread coop_cardSend local.p local.k local.force
			}
		}
		if( local.any == 0 ){
			local.run = 0
		} else {
			wait 0.1
		}
	}
	level.coop_cardSyncOn = 0
}end

//=========================================================================
coop_cardSend local.p local.k local.force:{
//=========================================================================
	if( local.p == NULL ){ end }
	local.slot = 236 + local.k
	local.fkey = "coop_card" + local.k
	local.akey = "coop_cardA" + local.k
	local.menu = level.coop_cardOn[local.k]
	if( local.menu == "" ){
		if( local.p.flags[local.fkey] != NIL ){
			// ihuddraw rides one unreliable snapshot (TRAPS T8): make the teardown stick (bug-2906 recipe)
			ihuddraw_alpha local.p local.slot 0
			thread coop_mod/hudresend.scr::resend local.p local.slot local.slot 0
			local.p.flags[local.fkey] = NIL
			local.p.flags[local.akey] = NIL
		}
		end
	}
	local.key = local.menu + "#" + level.coop_cardGen[local.k]
	local.go = 0
	if( local.force == 1 ){ local.go = 1 }
	// NIL checked explicitly: a raw NIL-vs-value != is not "changed" in GameScript (readygate coop_gateSet)
	local.fresh = 0
	local.have = local.p.flags[local.fkey]
	if( local.have == NIL ){
		local.fresh = 1
	} else {
		if( local.have != local.key ){ local.fresh = 1 }
	}
	if( local.fresh == 1 ){ local.go = 1 }
	if( local.go == 1 ){
		if( local.fresh == 1 ){
			// the hidden->shown edge claims the slot, so an older teardown's re-send cannot blank it
			waitthread coop_mod/hudresend.scr::claim local.p local.slot local.slot
		}
		if( local.p.flags["coop_cardForce"] != 1 ){
			// the readygate/lobby recipe: keep the ihuddraw layer drawn even if this client's cg_hud is off
			local.p.flags["coop_cardForce"] = 1
			local.p stufftext "set cg_huddraw_force 1"
		}
		ihuddraw_virtualsize local.p local.slot 0
		ihuddraw_align local.p local.slot center center
		ihuddraw_rect local.p local.slot level.coop_cardX[local.menu] level.coop_cardY[local.menu] level.coop_cardW[local.menu] level.coop_cardH[local.menu]
		ihuddraw_shader local.p local.slot level.coop_cardShader[local.menu]
		ihuddraw_color local.p local.slot 1 1 1
		if( local.fresh == 1 ){
			println ( "^~^~^ MENUMIRROR card " + local.menu + " -> entnum " + local.p.entnum )
		}
		local.p.flags[local.fkey] = local.key
		local.p.flags[local.akey] = NIL
	}
	// the URC's `fadein 1`: a one second ramp from when the host's card appeared, in fifths
	local.q = int( ( level.time - level.coop_cardT0[local.k] ) * 5 )
	if( local.q > 5 ){ local.q = 5 }
	if( local.q < 0 ){ local.q = 0 }
	local.go = 0
	if( local.force == 1 ){ local.go = 1 }
	local.have = local.p.flags[local.akey]
	if( local.have == NIL ){
		local.go = 1
	} else {
		if( local.have != local.q ){ local.go = 1 }
	}
	if( local.go == 1 ){
		ihuddraw_alpha local.p local.slot ( local.q * 0.2 )
		local.p.flags[local.akey] = local.q
	}
}end

//=========================================================================
coop_cardInit:{
//=========================================================================
	if( level.coop_cardInitDone == 1 ){ end }
	level.coop_cardInitDone = 1
	for( local.k = 0; local.k < 4; local.k++ ){
		level.coop_cardOn[local.k] = ""
		level.coop_cardT0[local.k] = 0
		level.coop_cardGen[local.k] = 0
	}
	// GENERATED by docs/proposals/briefing_joiners_2026-09-28/tools/gen_card_table.py - do not edit by hand
	level.coop_cardShader["e1l1_1"] = "textures/gametext/e1l1_ScreenText1"
	level.coop_cardX["e1l1_1"] = 0
	level.coop_cardY["e1l1_1"] = 64
