cover_place local.player:{
	if( level.coop_noDeployables == 1 ){ end }		//HZM coop: map disabled deployables (e.g. t2l2 ride)
	local.curr_placements = local.player.flags["coop_cover_placements"]
	if( local.curr_placements == NIL ){ local.curr_placements = 0 }
	if( local.curr_placements < 1 ){
		local.player iprint "No sandbag placements remaining!" 1
		end
	}
	if( local.player.flags["coop_dbno_active"] == 1 ){ end }

	// Placement reach: trace along the view ray; if the ray lands on valid floor, place there.
	// If it does not (aiming at a wall or at the horizon), do NOT fail - fall back to a flat
	// forward point pulled back from whatever the ray hit and snap it DOWN to the floor below.
	// Recipe = ammobox.scr::ammobox_place wall-shorten + officer.scr::coop_find_ground down-trace.
	local.eyepos   = local.player.origin + (0 0 54)
	local.fwd      = angles_toforward local.player.viewangles
	local.scaled   = local.fwd * 350		// was 200 - longer placement reach
	local.traceend = local.eyepos + local.scaled
	local.result   = traced (local.eyepos) (local.traceend)
	local.hitpos   = local.result["endpos"]
	local.frac     = local.result["fraction"]

	local.floor_z = local.player.origin[2] + 48	// was 32 - forgiving on slopes/steps (keep below eye height 54)
	if( local.frac >= 1.0 || local.hitpos[2] > local.floor_z ){
		// View ray found no usable floor. Pick a flat forward distance: pulled back from the
		// wall the ray stopped at (never through/inside solid), or a default reach on no hit.
		local.dist = 160
		if( local.frac < 1.0 ){ local.dist = (local.frac * 350) - 40 }
		if( local.dist < 32 ){ local.dist = 32 }
		local.fwdflat = local.fwd
		local.fwdflat[2] = 0
		local.base = local.player.origin + (local.fwdflat * local.dist)
		local.down = traced (local.base + (0 0 54)) (local.base + (0 0 -512))
		if( local.down["fraction"] >= 1.0 ){
			local.player iprint "Cannot place here - no ground!" 1
			end
		}
		local.hitpos = local.down["endpos"]
		if( local.hitpos[2] > local.floor_z ){
			local.player iprint "Cannot place here - ground too high!" 1
			end
		}
	}

	local.slot = level.coop_cover_count
	if( local.slot == NIL ){ local.slot = 0 }
	local.slot++
	level.coop_cover_count = local.slot
	//[user 2026-08-08] who deployed this piece, for the "Dug In" challenge
	//(challenges.scr::chal_nearOwnCover). Entity ref, not entnum - a reconnecting client gets a new
	//entity, so it can never inherit a previous player's sandbags through a recycled slot number.
	level.coop_cover_owner[local.slot] = local.player

	local.yaw       = local.player.viewangles[1]
	local.bagangles = (0 0 0)
	local.bagangles[1] = local.yaw

	local.vis = spawn script_model
	local.vis model "models/static/sandbag_small_semicircle.tik"
	local.vis.origin = local.hitpos
	local.vis.angles = local.bagangles
	local.vis notsolid
	local.player playsound coop_sandbag_place

	// Segmented concave collision: small boxes traced along the semicircle's front arc, in world space.
	// SOLID_BBOX can't be concave or rotate, so a ring of small colliders approximates the curve at any yaw,
	// leaving the interior open so you can crouch inside. Tune the ox/oy arc offsets if collision drifts.
	local.afwd  = angles_toforward local.bagangles
	local.aleft = angles_toleft local.bagangles
	local.ox[1] = 4
	local.oy[1] = -76
	local.ox[2] = 24
	local.oy[2] = -70
	local.ox[3] = 41
	local.oy[3] = -53
	local.ox[4] = 52
	local.oy[4] = -27
	local.ox[5] = 56
	local.oy[5] = 4
	local.ox[6] = 52
	local.oy[6] = 35
	local.ox[7] = 41
	local.oy[7] = 61
	local.ox[8] = 24
	local.oy[8] = 78
	local.ox[9] = 4
	local.oy[9] = 84
	local.b = 1
	while( local.b <= 9 ){
		local.wp = local.hitpos + (local.afwd * local.ox[local.b]) + (local.aleft * local.oy[local.b])
		local.box = spawn script_object
		local.box.origin = local.wp
		local.box setsize ( -20 -20 0) (20 20 54)		// [user 07-10] 54u - reconciles TWO needs. The engine take-cover check (player.cpp TickCoopCover) only accepts LOW cover: solid at chest 36u AND CLEAR at head 58u (so you can peek over standing). 64u blocked the 58u head trace -> read as a wall -> "not crouch cover". 48u was recognized but left a crouched head exposed. 54u is < 58u (cover function works) AND >= a crouched body (protected WHILE in cover / crouched behind it). You pop up/blind-fire over the top to shoot (exposed then, by design).
		local.box safesolid
		level.coop_cover_box[local.slot][local.b] = local.box
		local.b++
	}
	level.coop_cover_boxcount[local.slot] = 9

	level.coop_cover_visual[local.slot] = local.vis
	level.coop_cover_owner_ent[local.slot] = local.player

	local.player.flags["coop_cover_placements"] = local.curr_placements - 1
}end


cover_hud_monitor local.player:{
	local.last_count = -1

	ihuddraw_virtualsize local.player 40 1
	ihuddraw_align       local.player 40 left bottom
	ihuddraw_shader      local.player 40 "textures/hud/coop_cover_icon"
	ihuddraw_rect        local.player 40 40 -62 16 16
	ihuddraw_alpha       local.player 40 1

	ihuddraw_virtualsize local.player 41 1
	ihuddraw_align       local.player 41 left bottom
	ihuddraw_font        local.player 41 "verdana-14"
	ihuddraw_color       local.player 41 1 1 1
	ihuddraw_rect        local.player 41 58 -60 0 0
	ihuddraw_alpha       local.player 41 1

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.count = local.player.flags["coop_cover_placements"]
		if( local.count == NIL ){ local.count = 0 }
		if( local.count != local.last_count ){
			ihuddraw_string local.player 41 ("" + local.count)
			local.last_count = local.count
		}
		wait 0.1
	}

	//[user 2026-08-10] NULL guard: this teardown runs AFTER the display loop above, and that
	//loop exits precisely BECAUSE the player went away (disconnect / spectate / map change).
	//Measured in the 2-player test as "Script Error : Player entity is NULL for ihuddraw_*".
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 40 0
		ihuddraw_alpha  local.player 41 0
		ihuddraw_string local.player 41 ""
	}
}end


cover_proximity_monitor local.player:{
	//[user 2026-08-10] "only the owner can remove the cover, not the other player". There is NO
	//ownership check anywhere in this file - not here, not in the scan below, not in cover_remove -
	//so a non-owner is ALREADY permitted to remove. The asymmetry is the HUD fade: the prompt and its
	//progress bar drew on slots 42-44, and the engine multiplies alpha by s_hudFadeAlpha for every
	//slot BELOW 100 when the player is calm (cg_drawtools.cpp:651-653). The OWNER just placed the
	//sandbag, so their HUD is awake and they see the prompt; the other player walks up, stands still,
	//and the prompt fades to nothing - owner-only behaviour with no owner logic. Moved to 145-147.
	//FOURTH sighting in one day: revive HUD 21-26, blueprint ack, XP micro popup, this.
	local.hint_showing = 0
	local.bar_showing  = 0

	ihuddraw_virtualsize local.player 145 1
	ihuddraw_align       local.player 145 center bottom
	ihuddraw_font        local.player 145 "verdana-14"
	ihuddraw_color       local.player 145 1 1 1
	ihuddraw_rect        local.player 145 0 -20 0 0
	ihuddraw_alpha       local.player 145 0

	ihuddraw_virtualsize local.player 146 1
	ihuddraw_align       local.player 146 center bottom
	ihuddraw_shader      local.player 146 "textures/hud/coop_bar_white.tga"
	ihuddraw_color       local.player 146 0.12 0.12 0.12
	ihuddraw_rect        local.player 146 -60 -38 120 8
	ihuddraw_alpha       local.player 146 0

	ihuddraw_virtualsize local.player 147 1
	ihuddraw_align       local.player 147 center bottom
	ihuddraw_shader      local.player 147 "textures/hud/coop_bar_white.tga"
	ihuddraw_color       local.player 147 0.1 0.9 0.1
	ihuddraw_rect        local.player 147 -60 -38 0 8
	ihuddraw_alpha       local.player 147 0

	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		local.f = 0
		while( local.f < 5 ){
			waitframe
			local.f++
		}
		if( local.player == NULL || local.player.flags["coop_isActive"] != 1 ){ end }

		if( local.player.flags["coop_dbno_active"] == 1 ){
			if( local.hint_showing ){
				ihuddraw_alpha local.player 145 0
				local.hint_showing = 0
			}
			if( local.bar_showing ){
				ihuddraw_alpha local.player 146 0
				ihuddraw_alpha local.player 147 0
				ihuddraw_rect  local.player 147 -60 -38 0 8
				local.bar_showing = 0
			}
			continue
		}

		local.nearslot = NIL
		local.neardist = 80
		if( level.coop_cover_count != NIL ){
			local.i = 1
			while( local.i <= level.coop_cover_count ){
				if( level.coop_cover_visual[local.i] != NIL ){
					local.chkvis = level.coop_cover_visual[local.i]
					if( local.chkvis != NULL ){
						local.dist = vector_length( local.chkvis.origin - local.player.origin )
						if( local.dist < local.neardist ){
							local.neardist = local.dist
							local.nearslot = local.i
						}
					}
				}
				local.i++
			}
		}

		if( local.nearslot != NIL ){
			if( !local.hint_showing ){
				ihuddraw_string local.player 145 "Hold [USE] to remove cover"
				ihuddraw_alpha  local.player 145 0.7
				local.hint_showing = 1
			}

			//[user 2026-08-10] PROBE. The fade explains an invisible prompt, NOT a blocked action, and
			//assuming has been wrong repeatedly today. Report who is near, whether they own it, and
			//whether useheld actually arrives for a non-owner. Rate-limited to 1 line / 2s.
			if( getcvar( "coop_aggroDebug" ) == "1" ){
				if( level.coop_coverDbgNext == NIL ){ level.coop_coverDbgNext = 0 }
				if( level.time > level.coop_coverDbgNext ){
					level.coop_coverDbgNext = level.time + 2
					local.dOwn = 0
					local.dOe = level.coop_cover_owner_ent[local.nearslot]
					if( local.dOe != NULL && local.dOe != NIL ){
						if( local.dOe.entnum == local.player.entnum ){ local.dOwn = 1 }
					}
					local.dUh = local.player.useheld
					if( local.dUh == NIL ){ local.dUh = -1 }
					println( "^~^~^ COVER near slot=" + local.nearslot + " byE" + local.player.entnum + " isOwner=" + local.dOwn + " useheld=" + local.dUh )
				}
			}
			if( local.player.useheld == 1 && local.player.flags["coop_medkit_in_use"] != 1 ){
				ihuddraw_alpha local.player 146 0.8
				ihuddraw_alpha local.player 147 0.9
				local.bar_showing   = 1
				local.remove_frames = 0

				while( local.remove_frames < 100 ){
					waitframe
					if( local.player == NULL ){ end }
					if( local.player.flags["coop_isActive"] != 1 ){ end }
					if( local.player.flags["coop_dbno_active"] == 1 ){ break }
					if( local.player.useheld != 1 ){ break }
					if( level.coop_cover_visual[local.nearslot] == NIL ){ break }
					local.chk = level.coop_cover_visual[local.nearslot]
					if( local.chk == NULL ){ break }
					if( vector_length(local.chk.origin - local.player.origin) > 80 ){ break }
					local.fill_w = local.remove_frames * 1.2
					ihuddraw_rect local.player 147 -60 -38 local.fill_w 8
					local.remove_frames++
				}

				if( getcvar( "coop_aggroDebug" ) == "1" ){
					println( "^~^~^ COVER holddone frames=" + local.remove_frames + " slot=" + local.nearslot + " byE" + local.player.entnum )
				}
				if( local.remove_frames >= 100 ){
					if( level.coop_cover_visual[local.nearslot] != NIL ){
						thread cover_remove local.player local.nearslot
						local.hint_showing = 0
						ihuddraw_alpha local.player 145 0
					}
				}
				ihuddraw_alpha local.player 146 0
				ihuddraw_alpha local.player 147 0
				ihuddraw_rect  local.player 147 -60 -38 0 8
				local.bar_showing = 0
			}
		} else {
			if( local.hint_showing ){
				ihuddraw_alpha  local.player 145 0
				local.hint_showing = 0
			}
			if( local.bar_showing ){
				ihuddraw_alpha  local.player 146 0
				ihuddraw_alpha  local.player 147 0
				ihuddraw_rect   local.player 147 -60 -38 0 8
				local.bar_showing = 0
			}
		}
	}

	//[user 2026-08-10] NULL guard: this teardown runs AFTER the display loop above, and that
	//loop exits precisely BECAUSE the player went away (disconnect / spectate / map change).
	//Measured in the 2-player test as "Script Error : Player entity is NULL for ihuddraw_*".
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 145 0
		ihuddraw_alpha  local.player 146 0
		ihuddraw_alpha  local.player 147 0
	}
}end


cover_remove local.player local.slot:{
	local.vis = level.coop_cover_visual[local.slot]
	local.bc  = level.coop_cover_boxcount[local.slot]
	if( local.bc == NIL ){ local.bc = 0 }
	local.b = 1
	while( local.b <= local.bc ){
		local.bx = level.coop_cover_box[local.slot][local.b]
		if( local.bx != NULL ){ local.bx delete }
		local.b++
	}
	if( local.vis != NULL ){ local.vis delete }
	level.coop_cover_visual[local.slot] = NIL
	level.coop_cover_boxcount[local.slot] = NIL

	local.owner_ent = level.coop_cover_owner_ent[local.slot]
	level.coop_cover_owner_ent[local.slot] = NIL
	if( local.owner_ent != NULL ){
		local.curr = local.owner_ent.flags["coop_cover_placements"]
		if( local.curr == NIL ){ local.curr = 0 }
		if( local.curr < 2 ){
			local.owner_ent.flags["coop_cover_placements"] = local.curr + 1
			local.owner_ent iprint "Sandbag refunded!" 1
		}
	}
}end
